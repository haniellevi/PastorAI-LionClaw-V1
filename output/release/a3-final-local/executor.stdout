{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0179J8hzy1EsWsr5xX2ssMLs","type":"tool_result","content":"# ============================================================================\n# PastorAI — stack de produção (VPS Hostinger · Docker Compose puro)\n# ----------------------------------------------------------------------------\n# Sobe 7 serviços por padrão:\n#   redis              cache da Evolution (db 1) + fila do worker do app (db 0)\n#   evolution-postgres banco INTERNO da Evolution (NÃO é o banco do app)\n#   evolution-api      WhatsApp (Evolution API v2)\n#   backend            FastAPI (usa o Supabase via DATABASE_URL, externo)\n#   queue-worker       processa webhooks do WhatsApp → banco + agente\n#   cron-worker        motor de SLA + crons\n#   broadcast-worker   sempre ativo; fica ocioso enquanto as flags estão false\n#\n# O banco do APP é o Supabase (gerenciado, externo). O frontend vai na Vercel.\n# O modelo único é /.env.example: na primeira configuração autorizada, copie as\n# seções Comum/servidor e Produção/deploy para deploy/.env. PASTORAI_ENV_FILE\n# permite validar a sintaxe sem criar/copiar credenciais; em operação normal o\n# padrão continua sendo deploy/.env.\n#\n# >>> 1º teste (só conectar a Evolution / QR):\n#       docker compose up -d redis evolution-postgres evolution-api\n# >>> stack completa:\n#       docker compose up -d --build\n# ============================================================================\n\nname: pastorai\n\nx-logging: &default-logging\n  driver: json-file\n  options:\n    max-size: \"10m\"\n    max-file: \"5\"\n\nservices:\n  # --------------------------------------------------------------------------\n  # Redis — compartilhado: Evolution usa db 1, worker do app usa db 0\n  # --------------------------------------------------------------------------\n  redis:\n    logging: *default-logging\n    image: redis:7-alpine\n    container_name: pastorai_redis\n    restart: always\n    command: [\"redis-server\", \"--appendonly\", \"yes\"]\n    volumes:\n      - redis_data:/data\n    healthcheck:\n      test: [\"CMD\", \"redis-cli\", \"ping\"]\n      interval: 10s\n      timeout: 3s\n      retries: 5\n\n  # --------------------------------------------------------------------------\n  # Postgres INTERNO da Evolution (instâncias/sessões do WhatsApp).\n  # Atenção: NÃO é o banco do PastorAI — esse é o Supabase (DATABASE_URL).\n  # --------------------------------------------------------------------------\n  evolution-postgres:\n    logging: *default-logging\n    image: postgres:16-alpine\n    container_name: pastorai_evo_postgres\n    restart: always\n    environment:\n      POSTGRES_USER: evolution\n      POSTGRES_PASSWORD: ${EVOLUTION_POSTGRES_PASSWORD}\n      POSTGRES_DB: evolution\n    volumes:\n      - evolution_pg_data:/var/lib/postgresql/data\n    healthcheck:\n      test: [\"CMD-SHELL\", \"pg_isready -U evolution -d evolution\"]\n      interval: 10s\n      timeout: 3s\n      retries: 5\n\n  # --------------------------------------------------------------------------\n  # Evolution API v2 (canal WhatsApp oficial da igreja)\n  # --------------------------------------------------------------------------\n  evolution-api:\n    logging: *default-logging\n    image: evoapicloud/evolution-api:v2.3.7\n    container_name: pastorai_evolution\n    restart: always\n    ports:\n      - \"127.0.0.1:8080:8080\"\n    depends_on:\n      evolution-postgres:\n        condition: service_healthy\n      redis:\n        condition: service_healthy\n    environment:\n      SERVER_URL: ${EVOLUTION_SERVER_URL}\n      AUTHENTICATION_API_KEY: ${EVOLUTION_API_KEY}\n      DEL_INSTANCE: \"false\"\n      # Banco interno da Evolution\n      DATABASE_ENABLED: \"true\"\n      DATABASE_PROVIDER: postgresql\n      DATABASE_CONNECTION_URI: postgresql://evolution:${EVOLUTION_POSTGRES_PASSWORD}@evolution-postgres:5432/evolution\n      DATABASE_CONNECTION_CLIENT_NAME: evolution_pastorai\n      DATABASE_SAVE_DATA_INSTANCE: \"true\"\n      DATABASE_SAVE_DATA_NEW_MESSAGE: \"true\"\n      DATABASE_SAVE_MESSAGE_UPDATE: \"true\"\n      DATABASE_SAVE_DATA_CONTACTS: \"true\"\n      DATABASE_SAVE_DATA_CHATS: \"true\"\n      # Cache no Redis (db 1)\n      CACHE_REDIS_ENABLED: \"true\"\n      CACHE_REDIS_URI: redis://redis:6379/1\n      CACHE_REDIS_PREFIX_KEY: evolution_pastorai\n      CACHE_REDIS_SAVE_INSTANCES: \"false\"\n      CACHE_LOCAL_ENABLED: \"false\"\n      RABBITMQ_ENABLED: \"false\"\n      # Webhook global → backend do PastorAI (ativa quando o backend estiver no ar).\n      # Toda mensagem recebida cai em POST /whatsapp/webhook.\n      # Autenticação: a Evolution v2 self-hosted NÃO assina HMAC nem envia headers\n      # customizados (só a edição Cloud), mas preserva a query string da URL — por\n      # isso o segredo viaja como ?token=... e o backend valida em tempo constante.\n      WEBHOOK_GLOBAL_ENABLED: \"true\"\n      WEBHOOK_GLOBAL_URL: http://backend:8000/whatsapp/webhook?token=${EVOLUTION_WEBHOOK_SECRET}\n      WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS: \"false\"\n    volumes:\n      - evolution_instances:/evolution/instances\n\n  # --------------------------------------------------------------------------\n  # Backend FastAPI — usa o Supabase (DATABASE_URL no .env), Redis e a Evolution\n  # --------------------------------------------------------------------------\n  backend:\n    logging: *default-logging\n    build:\n      context: ../backend\n    image: pastorai-backend:latest\n    container_name: pastorai_backend\n    restart: always\n    ports:\n      - \"127.0.0.1:8000:8000\"\n    depends_on:\n      redis:\n        condition: service_healthy\n    env_file:\n      - ${PASTORAI_ENV_FILE:-.env}\n    environment:\n      # Sobrescreve os hosts p/ a rede interna do compose\n      REDIS_URL: redis://redis:6379/0\n      EVOLUTION_API_URL: http://evolution-api:8080\n      # URL que a Evolution chama de volta para entregar mensagens. O backend\n      # registra esse webhook na instância ao conectar (com ?token=). Use o\n      # endereço interno em que a Evolution alcança o backend nesta rede.\n      EVOLUTION_WEBHOOK_CALLBACK_URL: http://backend:8000/whatsapp/webhook\n    command: [\"uvicorn\", \"app.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8000\"]\n    healthcheck:\n      test:\n        [\n          \"CMD\",\n          \"python\",\n          \"-c\",\n          \"import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=3).status==200 else 1)\",\n        ]\n      interval: 30s\n      timeout: 5s\n      start_period: 20s\n      retries: 3\n\n  # --------------------------------------------------------------------------\n  # Worker de fila — drena webhooks do WhatsApp (Redis) → Postgres + agente\n  # --------------------------------------------------------------------------\n  queue-worker:\n    logging: *default-logging\n    build:\n      context: ../backend\n    image: pastorai-backend:latest\n    container_name: pastorai_queue_worker\n    restart: always\n    depends_on:\n      redis:\n        condition: service_healthy\n    env_file:\n      - ${PASTORAI_ENV_FILE:-.env}\n    environment:\n      REDIS_URL: redis://redis:6379/0\n      EVOLUTION_API_URL: http://evolution-api:8080\n      # MVP Fase 1: o agente roda na sessão principal com RLS, só para as\n      # igrejas em WHATSAPP_PILOTO_IGREJA_IDS (env_file). Vazio = só ingestão.\n      # Envio real ainda exige ALLOW_REAL_SENDS=true. AGENT_RUNTIME_DATABASE_URL\n      # (sessão dedicada D2A) está pausada e é ignorada pelo worker.\n    command: [\"python\", \"-m\", \"app.workers.queue_worker\"]\n    healthcheck:\n      test:\n        [\n          \"CMD\",\n          \"python\",\n          \"-c\",\n          \"from app.config import get_settings; from app.services.worker_health import worker_heartbeat_alive; raise SystemExit(0 if worker_heartbeat_alive(get_settings().redis_url, 'queue-worker') else 1)\",\n        ]\n      interval: 30s\n      timeout: 5s\n      start_period: 30s\n      retries: 3\n\n  # --------------------------------------------------------------------------\n  # Worker de cron — motor de SLA + execução de crons (tick configurável)\n  # --------------------------------------------------------------------------\n  cron-worker:\n    logging: *default-logging\n    build:\n      context: ../backend","is_error":false}]},"parent_tool_use_id":null,"session_id":"6f5f5b47-c66e-4591-b756-d99024a874c5","uuid":"feb21cde-b68d-426e-a0b9-1e5b67fc61c5","timestamp":"2026-10-30T15:05:18.425Z","tool_use_result":{"stdout":"# ============================================================================\n# PastorAI — stack de produção (VPS Hostinger · Docker Compose puro)\n# ----------------------------------------------------------------------------\n# Sobe 7 serviços por padrão:\n#   redis              cache da Evolution (db 1) + fila do worker do app (db 0)\n#   evolution-postgres banco INTERNO da Evolution (NÃO é o banco do app)\n#   evolution-api      WhatsApp (Evolution API v2)\n#   backend            FastAPI (usa o Supabase via DATABASE_URL, externo)\n#   queue-worker       processa webhooks do WhatsApp → banco + agente\n#   cron-worker        motor de SLA + crons\n#   broadcast-worker   sempre ativo; fica ocioso enquanto as flags estão false\n#\n# O banco do APP é o Supabase (gerenciado, externo). O frontend vai na Vercel.\n# O modelo único é /.env.example: na primeira configuração autorizada, copie as\n# seções Comum/servidor e Produção/deploy para deploy/.env. PASTORAI_ENV_FILE\n# permite validar a sintaxe sem criar/copiar credenciais; em operação normal o\n# padrão continua sendo deploy/.env.\n#\n# >>> 1º teste (só conectar a Evolution / QR):\n#       docker compose up -d redis evolution-postgres evolution-api\n# >>> stack completa:\n#       docker compose up -d --build\n# ============================================================================\n\nname: pastorai\n\nx-logging: &default-logging\n  driver: json-file\n  options:\n    max-size: \"10m\"\n    max-file: \"5\"\n\nservices:\n  # --------------------------------------------------------------------------\n  # Redis — compartilhado: Evolution usa db 1, worker do app usa db 0\n  # --------------------------------------------------------------------------\n  redis:\n    logging: *default-logging\n    image: redis:7-alpine\n    container_name: pastorai_redis\n    restart: always\n    command: [\"redis-server\", \"--appendonly\", \"yes\"]\n    volumes:\n      - redis_data:/data\n    healthcheck:\n      test: [\"CMD\", \"redis-cli\", \"ping\"]\n      interval: 10s\n      timeout: 3s\n      retries: 5\n\n  # --------------------------------------------------------------------------\n  # Postgres INTERNO da Evolution (instâncias/sessões do WhatsApp).\n  # Atenção: NÃO é o banco do PastorAI — esse é o Supabase (DATABASE_URL).\n  # --------------------------------------------------------------------------\n  evolution-postgres:\n    logging: *default-logging\n    image: postgres:16-alpine\n    container_name: pastorai_evo_postgres\n    restart: always\n    environment:\n      POSTGRES_USER: evolution\n      POSTGRES_PASSWORD: ${EVOLUTION_POSTGRES_PASSWORD}\n      POSTGRES_DB: evolution\n    volumes:\n      - evolution_pg_data:/var/lib/postgresql/data\n    healthcheck:\n      test: [\"CMD-SHELL\", \"pg_isready -U evolution -d evolution\"]\n      interval: 10s\n      timeout: 3s\n      retries: 5\n\n  # --------------------------------------------------------------------------\n  # Evolution API v2 (canal WhatsApp oficial da igreja)\n  # --------------------------------------------------------------------------\n  evolution-api:\n    logging: *default-logging\n    image: evoapicloud/evolution-api:v2.3.7\n    container_name: pastorai_evolution\n    restart: always\n    ports:\n      - \"127.0.0.1:8080:8080\"\n    depends_on:\n      evolution-postgres:\n        condition: service_healthy\n      redis:\n        condition: service_healthy\n    environment:\n      SERVER_URL: ${EVOLUTION_SERVER_URL}\n      AUTHENTICATION_API_KEY: ${EVOLUTION_API_KEY}\n      DEL_INSTANCE: \"false\"\n      # Banco interno da Evolution\n      DATABASE_ENABLED: \"true\"\n      DATABASE_PROVIDER: postgresql\n      DATABASE_CONNECTION_URI: postgresql://evolution:${EVOLUTION_POSTGRES_PASSWORD}@evolution-postgres:5432/evolution\n      DATABASE_CONNECTION_CLIENT_NAME: evolution_pastorai\n      DATABASE_SAVE_DATA_INSTANCE: \"true\"\n      DATABASE_SAVE_DATA_NEW_MESSAGE: \"true\"\n      DATABASE_SAVE_MESSAGE_UPDATE: \"true\"\n      DATABASE_SAVE_DATA_CONTACTS: \"true\"\n      DATABASE_SAVE_DATA_CHATS: \"true\"\n      # Cache no Redis (db 1)\n      CACHE_REDIS_ENABLED: \"true\"\n      CACHE_REDIS_URI: redis://redis:6379/1\n      CACHE_REDIS_PREFIX_KEY: evolution_pastorai\n      CACHE_REDIS_SAVE_INSTANCES: \"false\"\n      CACHE_LOCAL_ENABLED: \"false\"\n      RABBITMQ_ENABLED: \"false\"\n      # Webhook global → backend do PastorAI (ativa quando o backend estiver no ar).\n      # Toda mensagem recebida cai em POST /whatsapp/webhook.\n      # Autenticação: a Evolution v2 self-hosted NÃO assina HMAC nem envia headers\n      # customizados (só a edição Cloud), mas preserva a query string da URL — por\n      # isso o segredo viaja como ?token=... e o backend valida em tempo constante.\n      WEBHOOK_GLOBAL_ENABLED: \"true\"\n      WEBHOOK_GLOBAL_URL: http://backend:8000/whatsapp/webhook?token=${EVOLUTION_WEBHOOK_SECRET}\n      WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS: \"false\"\n    volumes:\n      - evolution_instances:/evolution/instances\n\n  # --------------------------------------------------------------------------\n  # Backend FastAPI — usa o Supabase (DATABASE_URL no .env), Redis e a Evolution\n  # --------------------------------------------------------------------------\n  backend:\n    logging: *default-logging\n    build:\n      context: ../backend\n    image: pastorai-backend:latest\n    container_name: pastorai_backend\n    restart: always\n    ports:\n      - \"127.0.0.1:8000:8000\"\n    depends_on:\n      redis:\n        condition: service_healthy\n    env_file:\n      - ${PASTORAI_ENV_FILE:-.env}\n    environment:\n      # Sobrescreve os hosts p/ a rede interna do compose\n      REDIS_URL: redis://redis:6379/0\n      EVOLUTION_API_URL: http://evolution-api:8080\n      # URL que a Evolution chama de volta para entregar mensagens. O backend\n      # registra esse webhook na instância ao conectar (com ?token=). Use o\n      # endereço interno em que a Evolution alcança o backend nesta rede.\n      EVOLUTION_WEBHOOK_CALLBACK_URL: http://backend:8000/whatsapp/webhook\n    command: [\"uvicorn\", \"app.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8000\"]\n    healthcheck:\n      test:\n        [\n          \"CMD\",\n          \"python\",\n          \"-c\",\n          \"import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=3).status==200 else 1)\",\n        ]\n      interval: 30s\n      timeout: 5s\n      start_period: 20s\n      retries: 3\n\n  # --------------------------------------------------------------------------\n  # Worker de fila — drena webhooks do WhatsApp (Redis) → Postgres + agente\n  # --------------------------------------------------------------------------\n  queue-worker:\n    logging: *default-logging\n    build:\n      context: ../backend\n    image: pastorai-backend:latest\n    container_name: pastorai_queue_worker\n    restart: always\n    depends_on:\n      redis:\n        condition: service_healthy\n    env_file:\n      - ${PASTORAI_ENV_FILE:-.env}\n    environment:\n      REDIS_URL: redis://redis:6379/0\n      EVOLUTION_API_URL: http://evolution-api:8080\n      # MVP Fase 1: o agente roda na sessão principal com RLS, só para as\n      # igrejas em WHATSAPP_PILOTO_IGREJA_IDS (env_file). Vazio = só ingestão.\n      # Envio real ainda exige ALLOW_REAL_SENDS=true. AGENT_RUNTIME_DATABASE_URL\n      # (sessão dedicada D2A) está pausada e é ignorada pelo worker.\n    command: [\"python\", \"-m\", \"app.workers.queue_worker\"]\n    healthcheck:\n      test:\n        [\n          \"CMD\",\n          \"python\",\n          \"-c\",\n          \"from app.config import get_settings; from app.services.worker_health import worker_heartbeat_alive; raise SystemExit(0 if worker_heartbeat_alive(get_settings().redis_url, 'queue-worker') else 1)\",\n        ]\n      interval: 30s\n      timeout: 5s\n      start_period: 30s\n      retries: 3\n\n  # --------------------------------------------------------------------------\n  # Worker de cron — motor de SLA + execução de crons (tick configurável)\n  # --------------------------------------------------------------------------\n  cron-worker:\n    logging: *default-logging\n    build:\n      context: ../backend","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0179J8hzy1EsWsr5xX2ssMLs","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
