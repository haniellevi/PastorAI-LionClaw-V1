{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Foi2H7Vvx9FeWjyCexZvam","type":"tool_result","content":"diff --git a/deploy/first_transition_adapter.py b/deploy/first_transition_adapter.py\nindex b6fad958..efd6ad11 100644\n--- a/deploy/first_transition_adapter.py\n+++ b/deploy/first_transition_adapter.py\n@@ -46,7 +46,8 @@ def adapter_sources():\n     root = Path(__file__).resolve().parent\n     return tuple((name, hashlib.sha256(read_regular(root / name)).hexdigest()) for name in (\n         'first_transition_adapter.py', 'first_transition_local_backup.py',\n-        'first_transition_host_contract.py', 'first_transition_host_transport.py', 'initial_transition_files.py',\n+        'first_transition_host_contract.py', 'first_transition_host_transport.py', 'first_transition_host_driver.py',\n+        'initial_transition_files.py',\n         'initial_transition_ops.py', 'release_topology.py'))\n \n \ndiff --git a/deploy/first_transition_host_transport.py b/deploy/first_transition_host_transport.py\nindex ed715c86..3b9faa2e 100644\n--- a/deploy/first_transition_host_transport.py\n+++ b/deploy/first_transition_host_transport.py\n@@ -116,6 +116,11 @@ class ObservedHostTransport:\n         self.identities, self.support_ids = dict(service_ids), dict(support_ids)\n         self.processing_keys = processing_keys  # validated by queue_metadata on every snapshot\n         self.support_digest = None\n+        self.scope_digest = None\n+\n+    @property\n+    def supports_resume(self):\n+        return getattr(self.driver, 'supports_resume', False) is True\n \n     def _request(self, argv, timeout):\n         require(getattr(self.driver, 'mode', None) == 'observed-host', 'transport-observed-required')\n@@ -127,9 +132,19 @@ class ObservedHostTransport:\n             raise Refused('observed-transport-failed') from None\n \n     def snapshot(self):\n+        declared = getattr(self.driver, 'transport_scope', None)\n+        if callable(declared):\n+            require(declared() == dict(legacy_project=self.legacy_project, network_id=self.network_id,\n+                                      service_ids=self.identities, support_ids=self.support_ids,\n+                                      processing_keys=self.processing_keys), 'transport-driver-scope')\n         raw = self._request(('inspect-host',), 10)\n         require(isinstance(raw, dict) and set(raw) == {\n-            'ingress_blocked', 'unknown_writers', 'network_id', 'services', 'support'}, 'transport-snapshot')\n+            'scope_digest', 'ingress_blocked', 'unknown_writers', 'network_id', 'services', 'support'}, 'transport-snapshot')\n+        require(isinstance(raw['scope_digest'], str) and re.fullmatch('[0-9a-f]{64}', raw['scope_digest']),\n+                'transport-scope-digest')\n+        if self.scope_digest is None:\n+            self.scope_digest = raw['scope_digest']\n+        require(raw['scope_digest'] == self.scope_digest, 'transport-scope-changed')\n         require(raw['network_id'] == self.network_id, 'transport-network-mismatch')\n         require(type(raw['ingress_blocked']) is bool and type(raw['unknown_writers']) is int\n                 and raw['unknown_writers'] >= 0, 'transport-snapshot')\n@@ -163,7 +178,7 @@ class ObservedHostTransport:\n                                processing_keys=self.processing_keys)\n         # Field types/topology/gates validation remains in ObservedHostContract;\n         # only the declared keys leave the transport, never extra driver data.\n-        return dict(mode='observed-host', ingress_blocked=raw['ingress_blocked'], support_digest=support_digest,\n+        return dict(mode='observed-host', scope_digest=raw['scope_digest'], ingress_blocked=raw['ingress_blocked'], support_digest=support_digest,\n                     unknown_writers=raw['unknown_writers'], queue_digest=queue['metadata_digest'],\n                     queue_counts=queue['counts'],\n                     services=deepcopy({role: {key: services[role][key] for key in SERVICE_FIELDS}\n@@ -180,16 +195,16 @@ class ObservedHostTransport:\n         # This final observation, not an earlier one, is what the guard judges.\n         guard(self.snapshot())\n \n-    def block_ingress(self):\n-        self.snapshot()\n+    def block_ingress(self, guard=None):\n+        self._guarded(guard)\n         require(self._request(('block-ingress',), 5) is True, 'transport-ingress-receipt')\n \n     def open_ingress(self, guard=None):\n         self._guarded(guard)\n         require(self._request(('open-ingress',), 5) is True, 'transport-ingress-receipt')\n \n-    def disable_restart(self, identifier):\n-        self._target(identifier)\n+    def disable_restart(self, identifier, guard=None):\n+        self._guarded(guard, identifier)\n         require(self._request(host_command('restart-no', identifier), 5) is True,\n                 'transport-restart-receipt')\n \n@@ -198,8 +213,8 @@ class ObservedHostTransport:\n         require(self._request(host_command('restart-always', identifier), 5) is True,\n                 'transport-restart-receipt')\n \n-    def signal_term(self, identifier):\n-        self._target(identifier)\n+    def signal_term(self, identifier, guard=None):\n+        self._guarded(guard, identifier)\n         require(self._request(host_command('term', identifier), 5) is True,\n                 'transport-signal-receipt')\n \ndiff --git a/docs/ops/RELEASE-LOTE-2026-10.md b/docs/ops/RELEASE-LOTE-2026-10.md\nindex f541e8d1..adbd1608 100644\n--- a/docs/ops/RELEASE-LOTE-2026-10.md\n+++ b/docs/ops/RELEASE-LOTE-2026-10.md\n@@ -1,5 +1,9 @@\n # Release em lote, outubro de 2026\n \n+## Decisão vigente A9 para a primeira transição (30/10/2026)\n+\n+O dono aprovou preparar quatro candidatos e iniciar somente backend para smoke, com ingresso externo/interno comprovadamente bloqueado. Queue/cron/broadcast permanecem `created`, com StartedAt inicial e restart=no, até a retomada nominal A10. Não chamar `create_and_start` atual nem iniciar consumidores por dependência/Compose. O cron novo com gates fechados também poderia cancelar pendências; parar somente o cron legado não prova preservação na subida. Backend deve ser verificado contra manutenção/agendador no startup. A aprovação atual cobre implementação local em dois blocos e testes exclusivamente simulados, não execução desses comandos ou inventário em ambiente real. Nenhum novo gate é criado nem os existentes são abertos para passar testes.\n+\n ## Fase 1 — transporte observado e consolidação enxuta (29/10/2026)\n \n Sobre a `main` `64853268a4c1623f5b9d4906457335fcb7849931`, o plano de release passa a seguir os 5 pacotes de fase consolidados no `ROADMAP.md`, encerrando a construção de VM QEMU offline artesanal (A1/I0). O arquivamento dos artefatos temporários de `/tmp/igreja12-*-20261029/` fora do repositório é registro do operador e não foi reverificado nesta fatia.\noutput:\ntotal 12\ndrwxrwxr-x  3 raniel-linux raniel-linux 4096 Oct 30 12:03 .\ndrwxrwxr-x 13 raniel-linux raniel-linux 4096 Oct 30 12:03 ..\ndrwxrwxr-x  3 raniel-linux raniel-linux 4096 Oct 30 12:03 release\n\noutput/release:\ntotal 12\ndrwxrwxr-x 3 raniel-linux raniel-linux 4096 Oct 30 12:03 .\ndrwxrwxr-x 3 raniel-linux raniel-linux 4096 Oct 30 12:03 ..\ndrwxrwxr-x 2 raniel-linux raniel-linux 4096 Oct 30 12:03 a3-final-local\n\noutput/release/a3-final-local:\ntotal 104\ndrwxrwxr-x 2 raniel-linux raniel-linux  4096 Oct 30 12:03 .\ndrwxrwxr-x 3 raniel-linux raniel-linux  4096 Oct 30 12:03 ..\n-rw-rw-r-- 1 raniel-linux raniel-linux  5325 Oct 30 12:03 executor-instructions.txt\n-rw-rw-r-- 1 raniel-linux raniel-linux   112 Oct 30 12:03 executor-state.json\n-rw-rw-r-- 1 raniel-linux raniel-linux     0 Oct 30 12:03 executor.stderr\n-rw-rw-r-- 1 raniel-linux raniel-linux 84250 Oct 30 12:03 executor.stdout","is_error":false}]},"parent_tool_use_id":null,"session_id":"6f5f5b47-c66e-4591-b756-d99024a874c5","uuid":"6cae87cb-9ef5-4364-8dbf-7ab97faf4b0a","timestamp":"2026-10-