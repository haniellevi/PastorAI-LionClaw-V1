{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgYdGCTdzFhrqFJsAwJ96","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01TTHa5ecNdz1qLcKwRBApuc","name":"Read","input":{"file_path":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/initial_transition_files.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14710,"cache_read_input_tokens":64082,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14710},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6f5f5b47-c66e-4591-b756-d99024a874c5","uuid":"6a479714-d26d-48a2-8831-baee381aea68","timestamp":"2026-10-30T15:03:52.797Z","request_id":"req_011CgYdGC1rVGPVfwZJWxf7r","wire_tool_inputs":{"toolu_01TTHa5ecNdz1qLcKwRBApuc":{"file_path":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/initial_transition_files.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TTHa5ecNdz1qLcKwRBApuc","type":"tool_result","content":"1\t\"\"\"Durable journal, exact Git blobs and release layout of the initial transition.\n2\t\n3\tEvery local path (spec, state/journal, compose, release layout) is refused\n4\twhen any component is protected (``.env*``, ``secrets``, keys, dumps, ...)\n5\tbefore it is opened, created or even ``lstat``-ed; then symlinks are refused\n6\tfor the path and every existing ancestor and files are opened ``O_NOFOLLOW``.\n7\tGit paths with a protected component are refused before any blob is read,\n8\teven when they would match the allowlist.\n9\t\"\"\"\n10\tfrom __future__ import annotations\n11\t\n12\timport fcntl\n13\timport hashlib\n14\timport json\n15\timport os\n16\timport re\n17\timport runpy\n18\timport stat\n19\timport subprocess\n20\timport tempfile\n21\timport time\n22\tfrom pathlib import Path\n23\t\n24\tfrom initial_transition_ops import MIGRATION, SHA, Refused, require\n25\timport release_topology\n26\t\n27\tPROTECTED = re.compile(r'(?:\\.env.*|secrets?|.*\\.pem|.*\\.key|id_rsa.*|id_ed25519.*|target_users.*|.*\\.dump'\n28\t                       r'|dumps?|backups?|exports?|media|migrate_clerk_production.*|clerk_.*)', re.IGNORECASE)\n29\tCLERK = re.compile(r'.*clerk.*', re.IGNORECASE)\n30\t\n31\t\n32\tdef is_protected(parts):\n33\t    \"\"\"Protected component, or any clerk-named entry under a ``scripts`` directory (admin tooling).\n34\t\n35\t    Pure string check: callers apply it before any lstat/open/cat-file.\n36\t    \"\"\"\n37\t    parts = [p for p in parts if p not in ('', os.sep)]\n38\t    return any(PROTECTED.fullmatch(p) for p in parts) or any(\n39\t        CLERK.fullmatch(p) for i, p in enumerate(parts) if 'scripts' in (q.lower() for q in parts[:i]))\n40\tLAYOUT_DEPLOY = ('backend-release.sh', 'check_backend_schema.py', 'emit_schema_check.py',\n41\t                 'schema_compatibility.py', 'docker-compose.yml')\n42\tLAYOUT_SQL = re.compile(r'backend/migrations/(?:[A-Za-z0-9_]+/)?[A-Za-z0-9_.-]+\\.sql')\n43\tMAX_FILE = 4 * 1024 * 1024\n44\t\n45\t\n46\tdef no_symlink(path):\n47\t    \"\"\"Refuse a protected component anywhere in ``path`` (checked on the string, before any\n48\t    filesystem access), then a symlink in ``path`` or any existing ancestor (no TOCTOU-free claim).\"\"\"\n49\t    path = Path(os.path.abspath(path))\n50\t    require(not is_protected(path.parts), 'protected-path')\n51\t    for candidate in (path, *path.parents):\n52\t        try:\n53\t            if stat.S_ISLNK(os.lstat(candidate).st_mode):\n54\t                raise Refused('symlink-refused')\n55\t        except FileNotFoundError:\n56\t            continue\n57\t    return path\n58\t\n59\t\n60\tdef read_regular(path, limit=MAX_FILE):\n61\t    path = no_symlink(path)\n62\t    try:\n63\t        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)\n64\t    except OSError:\n65\t        raise Refused('file-unreadable') from None\n66\t    with os.fdopen(fd, 'rb') as handle:\n67\t        require(stat.S_ISREG(os.fstat(handle.fileno()).st_mode), 'file-not-regular')\n68\t        data = handle.read(limit + 1)\n69\t    require(len(data) <= limit, 'file-too-large')\n70\t    return data\n71\t\n72\t\n73\tdef sha256(data):\n74\t    return hashlib.sha256(data).hexdigest()\n75\t\n76\t\n77\t# -- journal --------------------------------------------------------------\n78\tclass Journal:\n79\t    \"\"\"Append-only JSON lines, one writer (``flock``), full write + ``fsync`` per record.\n80\t\n81\t    Opening validates every record (JSON object, consecutive ``seq``, ``kind``)\n82\t    and refuses a torn tail instead of guessing what the crashed writer meant.\n83\t    \"\"\"\n84\t\n85\t    def __init__(self, directory, *, writer=os.write):\n86\t        self.dir = Path(directory)\n87\t        self.path = self.dir / 'journal.jsonl'\n88\t        self.lock_fd = None\n89\t        self.events = []\n90\t        self.writer = writer\n91\t\n92\t    def __enter__(self):\n93\t        return self.open()\n94\t\n95\t    def __exit__(self, *_):\n96\t        self.close()\n97\t\n98\t    def open(self):\n99\t        no_symlink(self.dir)\n100\t        self.dir.mkdir(mode=0o700, parents=True, exist_ok=True)\n101\t        require(stat.S_ISDIR(os.lstat(self.dir).st_mode), 'state-not-directory')\n102\t        no_symlink(self.dir / 'journal.lock')\n103\t        no_symlink(self.path)\n104\t        self.lock_fd = os.open(self.dir / 'journal.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)\n105\t        try:\n106\t            fcntl.flock(self.lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)\n107\t        except BlockingIOError:\n108\t            self.close()\n109\t            raise Refused('controller-busy') from None\n110\t        created = not os.path.lexists(self.path)\n111\t        self.events = []\n112\t        if not created:\n113\t            raw = read_regular(self.path, 64 * 1024 * 1024)\n114\t            lines = raw.split(b'\\n')\n115\t            require(lines[-1] == b'', 'journal-torn')\n116\t            for index, line in enumerate(lines[:-1], 1):\n117\t                try:\n118\t                    event = json.loads(line)\n119\t                except ValueError:\n120\t                    raise Refused('journal-torn') from None\n121\t                require(isinstance(event, dict) and event.get('seq') == index\n122\t                        and isinstance(event.get('kind'), str), 'journal-invalid')\n123\t                self.events.append(event)\n124\t        fd = os.open(self.path, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o600)\n125\t        os.close(fd)\n126\t        if created:\n127\t            dir_fd = os.open(self.dir, os.O_RDONLY)\n128\t            try:\n129\t                os.fsync(dir_fd)\n130\t            finally:\n131\t                os.close(dir_fd)\n132\t        return self\n133\t\n134\t    def close(self):\n135\t        if self.lock_fd is not None:\n136\t            os.close(self.lock_fd)  # releases the flock\n137\t            self.lock_fd = None\n138\t\n139\t    def digest(self):\n140\t        return sha256(read_regular(self.path, 64 * 1024 * 1024) if os.path.lexists(self.path) else b'')\n141\t\n142\t    def append(self, kind, **fields):\n143\t        require(self.lock_fd is not None, 'journal-not-locked')\n144\t        event = dict(seq=len(self.events) + 1, at=time.time(), kind=kind, **fields)\n145\t        line = memoryview((json.dumps(event, sort_keys=True, separators=(',', ':')) + '\\n').encode())\n146\t        fd = os.open(self.path, os.O_WRONLY | os.O_APPEND | os.O_NOFOLLOW)\n147\t        try:\n148\t            while line:  # a short write is completed, never left as a torn record\n149\t                written = self.writer(fd, line)\n150\t                require(written > 0, 'journal-write')\n151\t                line = line[written:]\n152\t            os.fsync(fd)\n153\t        finally:\n154\t            os.close(fd)\n155\t        self.events.append(event)\n156\t        return event\n157\t\n158\t    def find(self, kind, step=None, since=0):\n159\t        return [e for e in self.events if e['kind'] == kind and e['seq'] > since\n160\t                and (step is None or e.get('step') == step)]\n161\t\n162\t    def last(self, kind, step=None, since=0):\n163\t        found = self.find(kind, step, since)\n164\t        return found[-1] if found else None\n165\t\n166\t\n167\t# -- Git ------------------------------------------------------------------\n168\tdef git_tree(repo, sha, pathspecs, pattern, git=None, excluded=None):\n169\t    \"\"\"``{path: bytes}`` of tracked blobs matching ``pattern``; blob hashes re-verified.\n170\t\n171\t    Any listed path with a protected component refuses the whole read before\n172\t    the first ``cat-file``. With ``excluded`` set, unexpected paths refuse;\n173\t    only exact excluded names may be skipped without reading their blobs.\n174\t    \"\"\"\n175\t    def call(*args):\n176\t        if git is not None:\n177\t            return git(list(args))\n178\t        try:\n179\t            done = subprocess.run(['git', '-C', str(repo), *args], capture_output=True, timeout=60)\n180\t        except subprocess.TimeoutExpired:\n181\t            raise Refused('git-step') from None\n182\t        require(done.returncode == 0, 'git-step')\n183\t        return done.stdout\n184\t\n185\t    require(SHA.fullmatch(sha or ''), 'sha')\n186\t    require(call('rev-parse', '--verify', '--quiet', '--end-of-options', sha + '^{commit}').decode().strip() == sha,\n187\t            'sha')\n188\t    entries = []\n189\t    for entry in filter(None, call('ls-tree', '-r', '-z', '--full-tree', sha, '--', *pathspecs).split(b'\\0')):\n190\t        meta, _, raw = entry.partition(b'\\t')\n191\t        mode, kind, oid = meta.decode('ascii').split(' ')\n192\t        path = raw.decode('utf-8')\n193\t        require(not is_protected(path.split('/')), 'source-protected-path')\n194\t        entries.append((mode, kind, oid, path))\n195\t    files = {}\n196\t    for mode, kind, oid, path in entries:\n197\t        if not pattern.fullmatch(path):\n198\t            require(excluded is None or path in excluded, 'source-unexpected-file')\n199\t            continue\n200\t        require(kind == 'blob' and mode in ('100644', '100755'), 'source-entry-type')\n201\t        data = call('cat-file', 'blob', oid)\n202\t        require(hashlib.sha1(b'blob %d\\0' % len(data) + data).hexdigest() == oid, 'source-blob-hash')\n203\t        files[path] = data\n204\t    return files\n205\t\n206\t\n207\tdef migration_manifest(migrate_source, sql):\n208\t    \"\"\"The candidate's own selection rule over its exact SQL blobs, in a private temp tree.\"\"\"\n209\t    with tempfile.TemporaryDirectory(prefix='pastorai-transition-manifest-') as directory:\n210\t        root = Path(directory)\n211\t        (root / 'scripts').mkdir()\n212\t        (root / 'migrations').mkdir()\n213\t        (root / 'scripts' / 'migrate.py').write_bytes(migrate_source)\n214\t        for name, body in sql.items():\n215\t            (root / 'migrations' / name).write_bytes(body)\n216\t        files = runpy.run_path(str(root / 'scripts' / 'migrate.py'))['migration_files'](root / 'migrations')\n217\t    require(files and all(MIGRATION.fullmatch(n) for n in files) and len(files) == len(set(files)), 'manifest')\n218\t    return files\n219\t\n220\t\n221\t# -- release layout -----------------------------------------------------------\n222\tdef layout_files(files, topology, image, sha):\n223\t    \"\"\"Exact blobs plus the public topology contract and maintenance override.\n224\t\n225\t    The helper the runner needs travels with it as an exact blob. The override\n226\t    pins the candidate's verified local image ID (no registry digest invented),\n227\t    so ordinary Compose maintenance never falls back to a mutable tag. The\n228\t    layout holds no build source: recovery to it reuses that image ID.\n229\t    \"\"\"\n230\t    wanted = {f'deploy/{name}': files[f'deploy/{name}'] for name in LAYOUT_DEPLOY}\n231\t    helper = 'deploy/release_topology.py'\n232\t    if helper in files:\n233\t        wanted[helper] = files[helper]\n234\t    require(helper in files or b'release_topology.py' not in files['deploy/backend-release.sh'], 'layout-helper-missing')\n235\t    wanted['backend/scripts/migrate.py'] = files['backend/scripts/migrate.py']\n236\t    wanted.update({p: b for p, b in files.items() if LAYOUT_SQL.fullmatch(p)})\n237\t    try:\n238\t        wanted['deploy/release-topology.json'] = release_topology.canonical(topology).encode()\n239\t        wanted['deploy/docker-compose.override.yml'] = release_topology.overlay(topology, image, sha).encode()\n240\t    except release_topology.Refused as exc:\n241\t        raise Refused('layout-topology') from exc\n242\t    return wanted\n243\t\n244\t\n245\tdef inventory(root):\n246\t    \"\"\"Relative regular files under ``root`` by ``lstat`` only; links/specials/protected refused unread.\"\"\"\n247\t    found = []\n248\t    for top, dirs, names in os.walk(root, followlinks=False):\n249\t        for name in [*dirs, *names]:\n250\t            full = os.path.join(top, name)\n251\t            rel = os.path.relpath(full, root)\n252\t            require(not is_protected(rel.split(os.sep)), 'layout-unsafe-entry')  # before lstat\n253\t            mode = os.lstat(full).st_mode\n254\t            require(not stat.S_ISLNK(mode), 'layout-unsafe-entry')\n255\t            if name in names:\n256\t                require(stat.S_ISREG(mode), 'layout-unsafe-entry')\n257\t                found.append(rel)\n258\t    return sorted(found)\n259\t\n260\t\n261\tdef write_layout(root, sha, files, topology, manifest, image):\n262\t    \"\"\"``releases/<sha>`` from exact blobs (tooling, runner, SQL), the topology contract and\n263\t    the maintenance override pinned to ``image`` (verified ID); no private config. Idempotent.\"\"\"\n264\t    releases = no_symlink(Path(root) / 'releases')\n265\t    releases.mkdir(mode=0o755, parents=True, exist_ok=True)\n266\t    require(release_topology.IMAGE_ID.fullmatch(image or ''), 'layout-topology')\n267\t    wanted = layout_files(files, topology, image, sha)\n268\t    target = releases / sha\n269\t    if os.path.lexists(target):\n270\t        require(stat.S_ISDIR(os.lstat(target).st_mode), 'layout-mismatch')\n271\t        if inventory(target) != sorted(wanted):  # decided before reading any content\n272\t            raise Refused('layout-mismatch')\n273\t        if any(read_regular(target / p) != wanted[p] for p in sorted(wanted)):\n274\t            raise Refused('layout-mismatch')\n275\t        return len(wanted)\n276\t    staging = Path(tempfile.mkdtemp(prefix=f'.{sha}.staging-', dir=releases))\n277\t    for path, data in sorted(wanted.items()):\n278\t        out = staging / path\n279\t        out.parent.mkdir(parents=True, exist_ok=True)\n280\t        fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o755 if path.endswith('.sh') else 0o644)\n281\t        with os.fdopen(fd, 'wb') as handle:\n282\t            handle.write(data)\n283\t    staging.chmod(0o755)\n284\t    found = runpy.run_path(str(staging / 'backend/scripts/migrate.py'))['migration_files'](staging / 'backend/migrations')\n285\t    require(found == manifest, 'layout-manifest')\n286\t    os.rename(staging, target)\n287\t    return len(wanted)\n288\t\n289\t\n290\tdef activate(root, sha):\n291\t    root = no_symlink(Path(root))\n292\t    link, target = root / 'current', root / 'releases' / sha\n293\t    require(os.path.isdir(target) and not os.path.islink(target), 'layout-missing')\n294\t    if os.path.islink(link):\n295\t        require(os.readlink(link) == str(target), 'current-exists')\n296\t        return\n297\t    require(not os.path.lexists(link), 'current-exists')\n298\t    staging = root / f'current.next.{os.getpid()}'\n299\t    if os.path.lexists(staging):\n300\t        os.unlink(staging)\n301\t    os.symlink(target, staging)\n302\t    os.replace(staging, link)\n303\t"}]},"parent_tool_use_id":null,"session_id":"6f5f5b47-c66e-4591-b756-d99024a874c5","uuid":"501eafec-415b-462f-a8ab-98bee0e04354","timestamp":"2026-10-30T15:03:52.810Z","tool_use_result":{"type":"text","file":{"filePath":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/initial_transition_files.py","content":"\"\"\"Durable journal, exact Git blobs and release layout of the initial transition.\n\nEvery local path (spec, state/journal, compose, release layout) is refused\nwhen any component is protected (``.env*``, ``secrets``, keys, dumps, ...)\nbefore it is opened, created or even ``lstat``-ed; then symlinks are refused\nfor the path and every existing ancestor and files are opened ``O_NOFOLLOW``.\nGit paths with a protected component are refused before any blob is read,\neven when they would match the allowlist.\n\"\"\"\nfrom __future__ import annotations\n\nimport fcntl\nimport hashlib\nimport json\nimport os\nimport re\nimport runpy\nimport stat\nimport subprocess\nimport tempfile\nimport time\nfrom pathlib import Path\n\nfrom initial_transition_ops import MIGRATION, SHA, Refused, require\nimport release_topology\n\nPROTECTED = re.compile(r'(?:\\.env.*|secrets?|.*\\.pem|.*\\.key|id_rsa.*|id_ed25519.*|target_users.*|.*\\.dump'\n                       r'|dumps?|backups?|exports?|media|migrate_clerk_production.*|clerk_.*)', re.IGNORECASE)\nCLERK = re.compile(r'.*clerk.*', re.IGNORECASE)\n\n\ndef is_protected(parts):\n    \"\"\"Protected component, or any clerk-named entry under a ``scripts`` directory (admin tooling).\n\n    Pure string check: callers apply it before any lstat/open/cat-file.\n    \"\"\"\n    parts = [p for p in parts if p not in ('', os.sep)]\n    return any(PROTECTED.fullmatch(p) for p in parts) or any(\n        CLERK.fullmatch(p) for i, p in enumerate(parts) if 'scripts' in (q.lower() for q in parts[:i]))\nLAYOUT_DEPLOY = ('backend-release.sh', 'check_backend_schema.py', 'emit_schema_check.py',\n                 'schema_compatibility.py', 'docker-compose.yml')\nLAYOUT_SQL = re.compile(r'backend/migrations/(?:[A-Za-z0-9_]+/)?[A-Za-z0-9_.-]+\\.sql')\nMAX_FILE = 4 * 1024 * 1024\n\n\ndef no_symlink(path):\n    \"\"\"Refuse a protected component anywhere in ``path`` (checked on the string, before any\n    filesystem access), then a symlink in ``path`` or any existing ancestor (no TOCTOU-free claim).\"\"\"\n    path = Path(os.path.abspath(path))\n    require(not is_protected(path.parts), 'protected-path')\n    for candidate in (path, *path.parents):\n        try:\n            if stat.S_ISLNK(os.lstat(candidate).st_mode):\n                raise Refused('symlink-refused')\n        except FileNotFoundError:\n            continue\n    return path\n\n\ndef read_regular(path, limit=MAX_FILE):\n    path = no_symlink(path)\n    try:\n        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)\n    except OSError:\n        raise Refused('file-unreadable') from None\n    with os.fdopen(fd, 'rb') as handle:\n        require(stat.S_ISREG(os.fstat(handle.fileno()).st_mode), 'file-not-regular')\n        data = handle.read(limit + 1)\n    require(len(data) <= limit, 'file-too-large')\n    return data\n\n\ndef sha256(data):\n    return hashlib.sha256(data).hexdigest()\n\n\n# -- journal --------------------------------------------------------------\nclass Journal:\n    \"\"\"Append-only JSON lines, one writer (``flock``), full write + ``fsync`` per record.\n\n    Opening validates every record (JSON object, consecutive ``seq``, ``kind``)\n    and refuses a torn tail instead of guessing what the crashed writer meant.\n    \"\"\"\n\n    def __init__(self, directory, *, writer=os.write):\n        self.dir = Path(directory)\n        self.path = self.dir / 'journal.jsonl'\n        self.lock_fd = None\n        self.events = []\n        self.writer = writer\n\n    def __enter__(self):\n        return self.open()\n\n    def __exit__(self, *_):\n        self.close()\n\n    def open(self):\n        no_symlink(self.dir)\n        self.dir.mkdir(mode=0o700, parents=True, exist_ok=True)\n        require(stat.S_ISDIR(os.lstat(self.dir).st_mode), 'state-not-directory')\n        no_symlink(self.dir / 'journal.lock')\n        no_symlink(self.path)\n        self.lock_fd = os.open(self.dir / 'journal.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)\n        try:\n            fcntl.flock(self.lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)\n        except BlockingIOError:\n            self.close()\n            raise Refused('controller-busy') from None\n        created = not os.path.lexists(self.path)\n        self.events = []\n        if not created:\n            raw = read_regular(self.path, 64 * 1024 * 1024)\n            lines = raw.split(b'\\n')\n            require(lines[-1] == b'', 'journal-torn')\n            for index, line in enumerate(lines[:-1], 1):\n                try:\n                    event = json.loads(line)\n                except ValueError:\n                    raise Refused('journal-torn') from None\n                require(isinstance(event, dict) and event.get('seq') == index\n                        and isinstance(event.get('kind'), str), 'journal-invalid')\n                self.events.append(event)\n        fd = os.open(self.path, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o600)\n        os.close(fd)\n        if created:\n            dir_fd = os.open(self.dir, os.O_RDONLY)\n            try:\n                os.fsync(dir_fd)\n            finally:\n                os.close(dir_fd)\n        return self\n\n    def close(self):\n        if self.lock_fd is not None:\n            os.close(self.lock_fd)  # releases the flock\n            self.lock_fd = None\n\n    def digest(self):\n        return sha256(read_regular(self.path, 64 * 1024 * 1024) if os.path.lexists(self.path) else b'')\n\n    def append(self, kind, **fields):\n        require(self.lock_fd is not None, 'journal-not-locked')\n        event = dict(seq=len(self.events) + 1, at=time.time(), kind=kind, **fields)\n        line = memoryview((json.dumps(event, sort_keys=True, separators=(',', ':')) + '\\n').encode())\n        fd = os.open(self.path, os.O_WRONLY | os.O_APPEND | os.O_NOFOLLOW)\n        try:\n            while line:  # a short write is completed, never left as a torn record\n                written = self.writer(fd, line)\n                require(written > 0, 'journal-write')\n                line = line[written:]\n            os.fsync(fd)\n        finally:\n            os.close(fd)\n        self.events.append(event)\n        return event\n\n    def find(self, kind, step=None, since=0):\n        return [e for e in self.events if e['kind'] == kind and e['seq'] > since\n                and (step is None or e.get('step') == step)]\n\n    def last(self, kind, step=None, since=0):\n        found = self.find(kind, step, since)\n        return found[-1] if found else None\n\n\n# -- Git ------------------------------------------------------------------\ndef git_tree(repo, sha, pathspecs, pattern, git=None, excluded=None):\n    \"\"\"``{path: bytes}`` of tracked blobs matching ``pattern``; blob hashes re-verified.\n\n    Any listed path with a protected component refuses the whole read before\n    the first ``cat-file``. With ``excluded`` set, unexpected paths refuse;\n    only exact excluded names may be skipped without reading their blobs.\n    \"\"\"\n    def call(*args):\n        if git is not None:\n            return git(list(args))\n        try:\n            done = subprocess.run(['git', '-C', str(repo), *args], capture_output=True, timeout=60)\n        except subprocess.TimeoutExpired:\n            raise Refused('git-step') from None\n        require(done.returncode == 0, 'git-step')\n        return done.stdout\n\n    require(SHA.fullmatch(sha or ''), 'sha')\n    require(call('rev-parse', '--verify', '--quiet', '--end-of-options', sha + '^{commit}').decode().strip() == sha,\n            'sha')\n    entries = []\n    for entry in filter(None, call('ls-tree', '-r', '-z', '--full-tree', sha, '--', *pathspecs).split(b'\\0')):\n        meta, _, raw = entry.partition(b'\\t')\n        mode, kind, oid = meta.decode('ascii').split(' ')\n        path = raw.decode('utf-8')\n        require(not is_protected(path.split('/')), 'source-protected-path')\n        entries.append((mode, kind, oid, path))\n    files = {}\n    for mode, kind, oid, path in entries:\n        if not pattern.fullmatch(path):\n            require(excluded is None or path in excluded, 'source-unexpected-file')\n            continue\n        require(kind == 'blob' and mode in ('100644', '100755'), 'source-entry-type')\n        data = call('cat-file', 'blob', oid)\n        require(hashlib.sha1(b'blob %d\\0' % len(data) + data).hexdigest() == oid, 'source-blob-hash')\n        files[path] = data\n    return files\n\n\ndef migration_manifest(migrate_source, sql):\n    \"\"\"The candidate's own selection rule over its exact SQL blobs, in a private temp tree.\"\"\"\n    with tempfile.TemporaryDirectory(prefix='pastorai-transition-manifest-') as directory:\n        root = Path(directory)\n        (root / 'scripts').mkdir()\n        (root / 'migrations').mkdir()\n        (root / 'scripts' / 'migrate.py').write_bytes(migrate_source)\n        for name, body in sql.items():\n            (root / 'migrations' / name).write_bytes(body)\n        files = runpy.run_path(str(root / 'scripts' / 'migrate.py'))['migration_files'](root / 'migrations')\n    require(files and all(MIGRATION.fullmatch(n) for n in files) and len(files) == len(set(files)), 'manifest')\n    return files\n\n\n# -- release layout -----------------------------------------------------------\ndef layout_files(files, topology, image, sha):\n    \"\"\"Exact blobs plus the public topology contract and maintenance override.\n\n    The helper the runner needs travels with it as an exact blob. The override\n    pins the candidate's verified local image ID (no registry digest invented),\n    so ordinary Compose maintenance never falls back to a mutable tag. The\n    layout holds no build source: recovery to it reuses that image ID.\n    \"\"\"\n    wanted = {f'deploy/{name}': files[f'deploy/{name}'] for name in LAYOUT_DEPLOY}\n    helper = 'deploy/release_topology.py'\n    if helper in files:\n        wanted[helper] = files[helper]\n    require(helper in files or b'release_topology.py' not in files['deploy/backend-release.sh'], 'layout-helper-missing')\n    wanted['backend/scripts/migrate.py'] = files['backend/scripts/migrate.py']\n    wanted.update({p: b for p, b in files.items() if LAYOUT_SQL.fullmatch(p)})\n    try:\n        wanted['deploy/release-topology.json'] = release_topology.canonical(topology).encode()\n        wanted['deploy/docker-compose.override.yml'] = release_topology.overlay(topology, image, sha).encode()\n    except release_topology.Refused as exc:\n        raise Refused('layout-topology') from exc\n    return wanted\n\n\ndef inventory(root):\n    \"\"\"Relative regular files under ``root`` by ``lstat`` only; links/specials/protected refused unread.\"\"\"\n    found = []\n    for top, dirs, names in os.walk(root, followlinks=False):\n        for name in [*dirs, *names]:\n            full = os.path.join(top, name)\n            rel = os.path.relpath(full, root)\n            require(not is_protected(rel.split(os.sep)), 'layout-unsafe-entry')  # before lstat\n            mode = os.lstat(full).st_mode\n            require(not stat.S_ISLNK(mode), 'layout-unsafe-entry')\n            if name in names:\n                require(stat.S_ISREG(mode), 'layout-unsafe-entry')\n                found.append(rel)\n    return sorted(found)\n\n\ndef write_layout(root, sha, files, topology, manifest, image):\n    \"\"\"``releases/<sha>`` from exact blobs (tooling, runner, SQL), the topology contract and\n    the maintenance override pinned to ``image`` (verified ID); no private config. Idempotent.\"\"\"\n    releases = no_symlink(Path(root) / 'releases')\n    releases.mkdir(mode=0o755, parents=True, exist_ok=True)\n    require(release_topology.IMAGE_ID.fullmatch(image or ''), 'layout-topology')\n    wanted = layout_files(files, topology, image, sha)\n    target = releases / sha\n    if os.path.lexists(target):\n        require(stat.S_ISDIR(os.lstat(target).st_mode), 'layout-mismatch')\n        if inventory(target) != sorted(wanted):  # decided before reading any content\n            raise Refused('layout-mismatch')\n        if any(read_regular(target / p) != wanted[p] for p in sorted(wanted)):\n            raise Refused('layout-mismatch')\n        return len(wanted)\n    staging = Path(tempfile.mkdtemp(prefix=f'.{sha}.staging-', dir=releases))\n    for path, data in sorted(wanted.items()):\n        out = staging / path\n        out.parent.mkdir(parents=True, exist_ok=True)\n        fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o755 if path.endswith('.sh') else 0o644)\n        with os.fdopen(fd, 'wb') as handle:\n            handle.write(data)\n    staging.chmod(0o755)\n    found = runpy.run_path(str(staging / 'backend/scripts/migrate.py'))['migration_files'](staging / 'backend/migrations')\n    require(found == manifest, 'layout-manifest')\n    os.rename(staging, target)\n    return len(wanted)\n\n\ndef activate(root, sha):\n    root = no_symlink(Path(root))\n    link, target = root / 'current', root / 'releases' / sha\n    require(os.path.isdir(target) and not os.path.islink(target), 'layout-missing')\n    if os.path.islink(link):\n        require(os.readlink(link) == str(target), 'current-exists')\n        return\n    require(not os.path.lexists(link), 'current-exists')\n    staging = root / f'current.next.{os.getpid()}'\n    if os.path.lexists(staging):\n        os.unlink(staging)\n    os.symlink(target, staging)\n    os.replace(staging, link)\n","numLines":303,"startLine":1,"totalLines":303}},"tool_result_meta":[{"id":"toolu_01TTHa5ecNdz1qLcKwRBApuc","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgYdGCTdzFhrqFJsAwJ96","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01YSdZAHogiw6TxCgqkLM4UW","name":"Read","input":{"file_path":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/initial_transition.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14710,"cache_read_input_tokens":64082,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14710},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6f5f5b47-c66e-4591-b756-d99024a874c5","uuid":"a4284636-ac6b-4270-9a6a-847aaf65d8d9","timestamp":"2026-10-30T15:03:53.379Z","request_id":"req_011CgYdGC1rVGPVfwZJWxf7r","wire_tool_inputs":{"toolu_01YSdZAHogiw6TxCgqkLM4UW":{"file_path":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/initial_transition.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YSdZAHogiw6TxCgqkLM4UW","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Controller of the FIRST transition from the unversioned legacy install to the candidate.\n3\t\n4\t``run --spec S --state D [--until PHASE] [--allow-probe ID]... [--decision D] [--pause-at CP]``\n5\t``status --spec S --state D`` / ``resume-legacy --spec S --state D --confirm TOKEN``\n6\t\n7\t``backend-release.sh`` refuses the legacy install (no release tree, no checker,\n8\tno revision label); this controller performs only that first turn and leaves a\n9\trelease layout behind. It runs on owned synthetic Docker resources only\n10\t(``rehearse_initial_transition.py``): ``production_ready`` is false, there is\n11\tno production adapter. The layout carries the public topology contract that\n12\t``backend-release.sh`` adopts for the next release (``release_topology.py``).\n13\t\n14\tEvery invocation re-validates the local Docker endpoint, owned networks and\n15\tsupport containers (before any SQL), legacy identity/policy/state, gates and\n16\tscope, whatever phase the journal records. Every effect is preceded by a\n17\tdurable intent; replay inspects real state and refuses when the outcome is\n18\tambiguous. The ``ddl-marker`` is irrevocable: afterwards the legacy is never\n19\trestarted, and any failure before promotion contains the candidate (restart\n20\t``no`` persisted, SIGTERM, exit observed) until a human ``retry-candidate``.\n21\tGates are never changed: the candidate must carry exactly the legacy values.\n22\t\n23\tPhases: observed -> contained -> settled -> reconciled -> preflighted ->\n24\tddl-started -> migrated -> schema-verified -> candidate-ready -> promoted.\n25\t\"\"\"\n26\tfrom __future__ import annotations\n27\t\n28\timport argparse\n29\timport base64\n30\timport json\n31\timport re\n32\timport sys\n33\timport time\n34\timport zlib\n35\tfrom pathlib import Path\n36\t\n37\tfrom initial_transition_files import (\n38\t    Journal, git_tree, migration_manifest, no_symlink, read_regular, sha256,\n39\t)\n40\tfrom initial_transition_ops import (\n41\t    COMPOSE_PROJECT, COMPOSE_SERVICE, DSN, IMAGE_ID, OBSERVER_APPS, OWNER_LABEL, RESOURCE_ID,\n42\t    REVISION_LABEL, SHA, DockerOps, Refused, gates_of, host_exposed, ip_of, require,\n43\t)\n44\t\n45\tPHASES = ('observed', 'contained', 'settled', 'reconciled', 'preflighted', 'ddl-started', 'migrated',\n46\t          'schema-verified', 'candidate-ready', 'promoted')\n47\tCANDIDATE_PHASES = frozenset({'candidate-ready', 'promoted'})\n48\tTERMINAL = 'legacy-resumed'\n49\tROLES = ('backend', 'queue-worker', 'cron-worker', 'broadcast-worker')\n50\tCONTAIN_ORDER = ('backend', 'cron-worker', 'broadcast-worker', 'queue-worker')\n51\tSTART_ORDER = ('backend', 'queue-worker', 'broadcast-worker', 'cron-worker')\n52\tEXIT_REFUSED, EXIT_WAIT, EXIT_USAGE, EXIT_BUSY = 3, 4, 2, 5\n53\tRETRIABLE = frozenset({'migration-failed', 'concurrent-index-invalid', 'concurrent-failed-decision',\n54\t                       'concurrent-index-present-ledger-absent'})\n55\tWAIT_CODES = frozenset({'job-active', 'migration-job-active', 'migration-session-active'})\n56\tCANDIDATE_TREE = re.compile(r'backend/(?:app/(?:[A-Za-z_][A-Za-z0-9_]*/)*[A-Za-z_][A-Za-z0-9_]*\\.py'\n57\t                            r'|migrations/(?:[A-Za-z0-9_]+/)?[A-Za-z0-9_.-]+\\.sql|requirements\\.lock'\n58\t                            r'|scripts/migrate\\.py)')\n59\t# Exact allowlist of candidate blobs ever read (image tree + reviewed tools).\n60\tTOOLS = ('backend/scripts/reconcile_team_pessoa.py', 'backend/scripts/release_preflight.py',\n61\t         *(f'deploy/{name}' for name in ('backend-release.sh', 'check_backend_schema.py', 'emit_schema_check.py',\n62\t                                         'schema_compatibility.py', 'docker-compose.yml', 'release_topology.py')))\n63\tCANDIDATE_PATHSPECS = ('backend/app', 'backend/migrations', 'backend/requirements.lock',\n64\t                       'backend/scripts/migrate.py', *TOOLS)\n65\tCANDIDATE_BLOBS = re.compile(CANDIDATE_TREE.pattern + '|' + '|'.join(re.escape(p) for p in TOOLS))\n66\tCONCURRENT_INDEX = re.compile(r'create\\s+(?:unique\\s+)?index\\s+concurrently\\s+(?:if\\s+not\\s+exists\\s+)?'\n67\t                              r'(?:public\\.)?\"?([a-z0-9_]+)\"?', re.IGNORECASE)\n68\tDEFAULT_TIMEOUTS = dict(grace_s=30, settle_s=4, migration_s=300, job_s=180, ready_s=120, active_wait_s=5)\n69\t\n70\tCATALOG_PROBE = r'''\n71\timport base64, hashlib, json, sys, types, zlib\n72\tfrom sqlalchemy import create_engine\n73\tsource = zlib.decompress(base64.b64decode(sys.argv[2])).decode('utf-8')\n74\tmodule = types.ModuleType('schema_compatibility')\n75\texec(compile(source, 'schema_compatibility.py', 'exec'), module.__dict__)\n76\tengine = create_engine(sys.argv[1])\n77\twith engine.connect() as connection:\n78\t    connection.exec_driver_sql('SET TRANSACTION READ ONLY')\n79\t    catalog = module.capture_catalog(connection)\n80\tengine.dispose()\n81\tdigest = lambda value: hashlib.sha256(json.dumps(value, sort_keys=True, default=str).encode()).hexdigest()\n82\tprint(json.dumps({kind: digest(value) for kind, value in catalog.items()}, sort_keys=True))\n83\t'''\n84\t\n85\t\n86\tdef canonical(value):\n87\t    return sha256(json.dumps(value, sort_keys=True, separators=(',', ':')).encode())\n88\t\n89\t\n90\tdef code_lines(body):\n91\t    return [line for line in body.decode('utf-8').splitlines() if not line.lstrip().startswith('--')]\n92\t\n93\t\n94\tdef concurrent_indexes(body):\n95\t    \"\"\"Index names a CONCURRENTLY migration creates (non-comment lines); empty if transactional.\"\"\"\n96\t    return sorted({m.lower() for line in code_lines(body) for m in CONCURRENT_INDEX.findall(line)})\n97\t\n98\t\n99\tdef verify_contained_exit(observed, data):\n100\t    \"\"\"Refusal code for a container that did not stay stopped after SIGTERM, else ``None``.\"\"\"\n101\t    state, host = data.get('State') or {}, data.get('HostConfig') or {}\n102\t    if data.get('RestartCount', 0) != observed['restart_count'] or state.get('StartedAt') != observed['started']:\n103\t        return 'restarted-after-signal'\n104\t    if (host.get('RestartPolicy') or {}).get('Name') != 'no':\n105\t        return 'restart-policy-not-persisted'\n106\t    if state.get('Running'):\n107\t        return 'still-running'\n108\t    if state.get('ExitCode') != 0:\n109\t        return 'ungraceful-exit'\n110\t    return None\n111\t\n112\t\n113\tdef check_expect(ops, expect):\n114\t    \"\"\"Names (never values) of every expected effect that does not hold exactly.\"\"\"\n115\t    problems = []\n116\t    if expect.get('messages'):\n117\t        counts = ops.message_counts(sorted(expect['messages']))\n118\t        problems += ['messages' for k, n in expect['messages'].items() if counts.get(k) != n][:1]\n119\t    # Critical queues (list or zset) must be persistent (no TTL): the stability\n120\t    # snapshot excludes TTL keys, so a TTL would hide their loss. Absent = empty.\n121\t    for kind, read in (('redis_lists', ops.redis_list), ('redis_zsets', ops.redis_zset)):\n122\t        for key, expected in sorted((expect.get(kind) or {}).items()):\n123\t            ttl = ops.redis_pttl(key)\n124\t            if ttl != -1 and not (ttl == -2 and not expected):\n125\t                problems.append('redis-volatile-or-missing:' + key)\n126\t            elif read(key) != expected:\n127\t                problems.append(kind.removesuffix('s').replace('_', '-') + ':' + key)\n128\t    for prefix in expect.get('redis_absent_prefixes') or []:\n129\t        if ops.redis_keys(prefix):\n130\t            problems.append('redis-present:' + prefix)\n131\t    if expect.get('deliveries'):\n132\t        states = ops.delivery_states(sorted(expect['deliveries']))\n133\t        problems += ['deliveries' for k, v in expect['deliveries'].items() if states.get(k) != v][:1]\n134\t    return problems\n135\t\n136\t\n137\tclass Transition:\n138\t    def __init__(self, spec, journal, ops, *, probes=(), decision=None, pause_at=None, clock=time.monotonic,\n139\t                 sleep=time.sleep, git=None):\n140\t        self.spec, self.j, self.ops = spec, journal, ops\n141\t        self.probes, self.decision, self.pause_at = list(probes), decision, pause_at\n142\t        self.clock, self.sleep, self.git = clock, sleep, git\n143\t        self.t = {**DEFAULT_TIMEOUTS, **(spec.get('timeouts') or {})}\n144\t        self.run12, self.prefix = spec['run_id'][:12], spec['prefix']\n145\t        self._files, self.inv, self.probe_count = None, 0, 0\n146\t\n147\t    # -- journal views ------------------------------------------------------\n148\t    def checkpoint(self, name):\n149\t        if self.pause_at == name:\n150\t            self.j.append('paused', checkpoint=name)\n151\t            (self.j.dir / 'paused').write_text(name + '\\n')\n152\t            while True:  # synthetic test hook: the rehearsal SIGKILLs this process here\n153\t                self.sleep(1)\n154\t\n155\t    def epoch(self):\n156\t        \"\"\"Seq of the last candidate containment: candidate steps before it no longer count.\"\"\"\n157\t        last = self.j.last('candidate-contained')\n158\t        return last['seq'] if last else 0\n159\t\n160\t    def done(self, step, since=0):\n161\t        return self.j.last('done', step, since) is not None\n162\t\n163\t    def cdone(self, step):\n164\t        return self.done(step, self.epoch())\n165\t\n166\t    def reached(self, name):\n167\t        since = self.epoch() if name in CANDIDATE_PHASES else 0\n168\t        return any(e.get('name') == name for e in self.j.find('phase', since=since))\n169\t\n170\t    def phase(self, name):\n171\t        if not self.reached(name):\n172\t            self.j.append('phase', name=name)\n173\t\n174\t    def refuse(self, code, step=None, **fields):\n175\t        self.j.append('refused', code=code, step=step, **fields)\n176\t        raise Refused(code)\n177\t\n178\t    def wait(self, code, step, **fields):\n179\t        \"\"\"Transient (active job/session): journaled, never sticky, exit code 4.\"\"\"\n180\t        self.j.append('waiting', code=code, step=step, **fields)\n181\t        raise Refused(code)\n182\t\n183\t    def observed(self):\n184\t        event = self.j.last('done', 'observe')\n185\t        require(event is not None, 'not-observed')\n186\t        return event\n187\t\n188\t    def legacy(self):\n189\t        return self.observed()['legacy']\n190\t\n191\t    def candidate_ids(self):\n192\t        event = self.j.last('done', 'candidate:create')\n193\t        return event['ids'] if event else {}\n194\t\n195\t    def job_ids(self):\n196\t        return {e['id'] for e in self.j.find('job')}\n197\t\n198\t    def files(self):\n199\t        if self._files is None:\n200\t            self._files = git_tree(self.spec['repo'], self.spec['candidate']['sha'], CANDIDATE_PATHSPECS,\n201\t                                   CANDIDATE_BLOBS, self.git)\n202\t        return self._files\n203\t\n204\t    def manifest(self):\n205\t        files = self.files()\n206\t        sql = {p.split('/', 2)[2]: b for p, b in files.items() if re.fullmatch(r'backend/migrations/[^/]+\\.sql', p)}\n207\t        return migration_manifest(files['backend/scripts/migrate.py'], sql)\n208\t\n209\t    def dsn(self):\n210\t        return self.spec['database']['dsn']\n211\t\n212\t    # -- validation on EVERY invocation ---------------------------------------\n213\t    def base_checks(self):\n214\t        \"\"\"Local endpoint and owned topology, before any SQL or effect (every invocation).\"\"\"\n215\t        self.ops.guard_local()\n216\t        self.ops.verify_topology()\n217\t\n218\t    def check_expectations(self, key):\n219\t        return check_expect(self.ops, self.spec[key])\n220\t\n221\t    def revalidate(self):\n222\t        \"\"\"Legacy and candidate identity/state/gates, every invocation, whatever the journal says.\"\"\"\n223\t        if not self.done('observe'):\n224\t            return\n225\t        observed = self.observed()\n226\t        for role, item in self.legacy().items():\n227\t            data = self.ops.inspect(item['id']) or {}\n228\t            labels = (data.get('Config') or {}).get('Labels') or {}\n229\t            if (data.get('Id') != item['id'] or data.get('Image') != self.spec['legacy']['image']\n230\t                    or labels.get(OWNER_LABEL) != self.spec['run_id'] or (COMPOSE_PROJECT in labels) != item['compose']\n231\t                    or (item['compose'] and labels.get(COMPOSE_PROJECT) != self.spec['legacy']['project'])\n232\t                    or gates_of(data) != item['gates'] or host_exposed(data)):\n233\t                self.refuse('legacy-identity-changed', 'revalidate', role=role)\n234\t            resumed = self.j.last('done', f'legacy-resume:{role}')\n235\t            if resumed:\n236\t                # Back on purpose: same execution, original policy, no restart since.\n237\t                if (not (data.get('State') or {}).get('Running')\n238\t                        or (data.get('State') or {}).get('StartedAt') != resumed['started']\n239\t                        or data.get('RestartCount', 0) != resumed.get('restart_count', 0)\n240\t                        or ((data.get('HostConfig') or {}).get('RestartPolicy') or {}).get('Name') != item['policy']):\n241\t                    self.refuse('legacy-resumed-state-changed', 'revalidate', role=role)\n242\t            elif self.j.last('intent', f'legacy-resume:{role}'):\n243\t                pass  # start intended before a crash: running or not, identity/gates checked above\n244\t            elif self.done(f'exit:{role}'):\n245\t                code = verify_contained_exit(item, data)\n246\t                if code:\n247\t                    self.refuse('legacy-' + code, 'revalidate', role=role)\n248\t            else:\n249\t                # Not yet exited: same execution; policy original, or ``no`` once its change is intended.\n250\t                allowed = {item['policy']} if not self.j.last('intent', f'policy:{role}') else {item['policy'], 'no'}\n251\t                if self.done(f'policy:{role}'):\n252\t                    allowed = {'no'}\n253\t                if (data.get('RestartCount', 0) != item['restart_count']\n254\t                        or (data.get('State') or {}).get('StartedAt') != item['started']\n255\t                        or ((data.get('HostConfig') or {}).get('RestartPolicy') or {}).get('Name') not in allowed):\n256\t                    self.refuse('legacy-state-changed', 'revalidate', role=role)\n257\t        if observed.get('ledger_count') is None:\n258\t            self.refuse('observe-incomplete', 'revalidate')\n259\t        for role, identifier in self.candidate_ids().items():\n260\t            data = self.ops.inspect(identifier) or {}\n261\t            labels = (data.get('Config') or {}).get('Labels') or {}\n262\t            if (data.get('Id') != identifier or data.get('Image') != self.spec['candidate']['image']\n263\t                    or labels.get(COMPOSE_PROJECT) != self.spec['candidate']['project']\n264\t                    or labels.get(OWNER_LABEL) != self.spec['run_id'] or host_exposed(data)\n265\t                    or gates_of(data) != self.legacy()[role]['gates']):\n266\t                self.refuse('candidate-identity-changed', 'revalidate', role=role)\n267\t\n268\t    def ip_map(self, ids):\n269\t        found = {}\n270\t        for identifier in ids:\n271\t            data = self.ops.inspect(identifier)\n272\t            address = data and ip_of(data, self.spec['network']['app'])\n273\t            if address:\n274\t                found[address] = identifier\n275\t        return found\n276\t\n277\t    def check_scope(self, *, legacy_running, candidate_running=()):\n278\t        \"\"\"Every owned container is known; only expected processes on networks, DB and Redis.\"\"\"\n279\t        legacy = self.legacy()\n280\t        known = ({v['id'] for v in legacy.values()} | set(self.spec['support'].values())\n281\t                 | set(self.candidate_ids().values()) | self.job_ids() | set(self.probes))\n282\t        if self.ops.owned_containers(self.spec['run_id']) - known:\n283\t            self.refuse('orphan-owned-container')\n284\t        writers = ({legacy[r]['id'] for r in legacy_running} | set(self.probes)\n285\t                   | {self.candidate_ids()[r] for r in candidate_running})\n286\t        support = set(self.spec['support'].values())\n287\t        for name in ('app', 'edge'):\n288\t            _, members = self.ops.network_members(self.spec['network'][name])\n289\t            if members - (writers | (support if name == 'app' else set())):\n290\t                self.refuse('fifth-writer-network')\n291\t        ips = self.ip_map(writers)\n292\t        evolution_ip = next(iter(self.ip_map([self.spec['support']['evolution']])), None)\n293\t        for session in self.ops.pg_sessions():\n294\t            if session.get('addr') is None and session.get('app') in OBSERVER_APPS:\n295\t                continue  # read-only observer inside the owned Postgres container\n296\t            if session.get('addr') not in ips:\n297\t                self.refuse('fifth-writer-database')\n298\t        for client in self.ops.redis_clients():\n299\t            if client['addr'] == '127.0.0.1':\n300\t                continue  # ``docker exec redis-cli`` observers inside the owned Redis container\n301\t            if client['addr'] == evolution_ip and client.get('db') != '0':\n302\t                continue  # fake provider bookkeeping, never db0\n303\t            if client['addr'] not in ips:\n304\t                self.refuse('fifth-writer-redis')\n305\t\n306\t    # -- jobs -------------------------------------------------------------------\n307\t    def job(self, step, name, *, image, args, env=None, network='app', stdin=None, wait=None):\n308\t        \"\"\"Create (intent first) and run one owned job; replay adopts only the identical container.\n309\t\n310\t        A job already running (left by a killed controller) is never signalled\n311\t        or restarted: awaited briefly, then reported active (exit 4).\n312\t        \"\"\"\n313\t        network, env = self.spec['network'].get(network, network), env or {}\n314\t        ids = self.ops.job_find(name)\n315\t        recorded = [e['id'] for e in self.j.find('job', step) if e.get('name') == name]\n316\t        if len(ids) > 1 or (recorded and ids != recorded[-1:]):\n317\t            self.refuse('job-ambiguous', step)\n318\t        if ids:\n319\t            identifier = ids[0]\n320\t            data = self.ops.inspect(identifier) or {}\n321\t            labels = (data.get('Config') or {}).get('Labels') or {}\n322\t            if (labels.get(OWNER_LABEL) != self.spec['run_id'] or labels.get('pastorai.transition.job') != name\n323\t                    or not self.ops.job_matches(data, image=image, args=args, env=env, network=network)):\n324\t                self.refuse('job-mismatch', step)\n325\t            if not recorded:\n326\t                if not [e for e in self.j.find('intent', step) if e.get('name') == name]:\n327\t                    self.refuse('job-without-intent', step)\n328\t                self.j.append('job', step=step, name=name, id=identifier, adopted=True)\n329\t        else:\n330\t            self.j.append('intent', step=step, name=name)\n331\t            identifier = self.ops.job_create(name=name, kind=step.split(':', 1)[0], image=image, args=args,\n332\t                                             env=env, stdin=stdin is not None, network=network)\n333\t            self.j.append('job', step=step, name=name, id=identifier)\n334\t        state = (self.ops.inspect(identifier) or {}).get('State') or {}\n335\t        budget = wait if wait is not None else self.t['job_s']\n336\t        if state.get('Running'):\n337\t            budget = self.t['active_wait_s']  # adopted live job: observe, never take over\n338\t        elif state.get('Status') == 'created':\n339\t            self.checkpoint(f'job:{name}:before-start')\n340\t            if stdin is not None:\n341\t                self.ops.job_start(identifier, input=stdin, timeout=self.t['job_s'])\n342\t            else:\n343\t                self.ops.job_start(identifier)\n344\t        limit = self.clock() + budget\n345\t        while (state := (self.ops.inspect(identifier) or {}).get('State') or {}).get('Running'):\n346\t            if self.clock() >= limit:\n347\t                self.wait('job-active', step, job=identifier)\n348\t            self.sleep(0.5)\n349\t        return identifier, state.get('ExitCode'), self.ops.job_logs(identifier)\n350\t\n351\t    def probe_name(self, kind):\n352\t        \"\"\"Read-only probes are fresh per invocation: a stale exit/log is never reused.\"\"\"\n353\t        self.probe_count += 1\n354\t        return f'{self.prefix}-job-{kind}-i{self.inv}-{self.probe_count}'\n355\t\n356\t    def script(self, step, name, target, path, extra=(), env=None, stdin=None):\n357\t        args = self.ops.script_args(target, self.files()[path], extra)\n358\t        return self.job(step, name, image=self.spec['candidate']['image'], args=args, env=env, stdin=stdin)\n359\t\n360\t    def source_probe(self, step, image, root, files):\n361\t        from rehearse_legacy_queue import RUNTIME_PROBE, lock_entries, runtime_mismatch\n362\t        expected = {path: sha256(data) for path, data in files.items()}\n363\t        lock = files['requirements.lock'].decode('utf-8')\n364\t        markers = sorted({m for _, _, m in lock_entries(lock) if m})\n365\t        _, code, out = self.job(step, self.probe_name(step.replace(':', '-')), image=image, network='none',\n366\t                                args=['-I', '-c', RUNTIME_PROBE, root, json.dumps(markers), json.dumps(sorted(expected))])\n367\t        if code != 0 or not out.strip():\n368\t            self.refuse('source-probe', step)\n369\t        observed = json.loads(out.strip().splitlines()[-1])\n370\t        if observed.get('rejected') or observed.get('missing') or observed.get('files') != expected:\n371\t            self.refuse('source-mismatch', step)\n372\t        if runtime_mismatch(lock, observed):\n373\t            self.refuse('runtime-mismatch', step)\n374\t        return canonical(expected)\n375\t\n376\t    # -- legacy side ------------------------------------------------------------\n377\t    def observe(self):\n378\t        if not self.done('observe'):\n379\t            self.identify()\n380\t        if not self.reached('observed'):\n381\t            self.check_scope(legacy_running=ROLES)\n382\t            self.phase('observed')\n383\t\n384\t    def identify(self):\n385\t        spec, ops = self.spec, self.ops\n386\t        legacy_image, candidate = spec['legacy']['image'], spec['candidate']\n387\t        ops.image(legacy_image)\n388\t        if (ops.image(candidate['image']).get('Config', {}).get('Labels') or {}).get(REVISION_LABEL) != candidate['sha']:\n389\t            self.refuse('candidate-revision-label')\n390\t        identities = {}\n391\t        for role in ROLES:\n392\t            identifier = spec['legacy']['containers'][role]\n393\t            data = ops.inspect(identifier)\n394\t            if not data or data.get('Id') != identifier or not RESOURCE_ID.fullmatch(identifier):\n395\t                self.refuse('legacy-identity')\n396\t            labels, host = (data.get('Config') or {}).get('Labels') or {}, data.get('HostConfig') or {}\n397\t            compose = role not in spec['legacy']['standalone']\n398\t            if (labels.get(OWNER_LABEL) != spec['run_id'] or data.get('Image') != legacy_image\n399\t                    or compose != (COMPOSE_PROJECT in labels)\n400\t                    or (compose and (labels.get(COMPOSE_PROJECT) != spec['legacy']['project']\n401\t                                     or labels.get(COMPOSE_SERVICE) != role))):\n402\t                self.refuse('legacy-topology')\n403\t            policy = (host.get('RestartPolicy') or {}).get('Name')\n404\t            if policy != 'always':\n405\t                self.refuse('legacy-restart-policy-unexpected')\n406\t            if host_exposed(data) or not (data.get('State') or {}).get('Running'):\n407\t                self.refuse('legacy-state')\n408\t            identities[role] = dict(id=identifier, name=data.get('Name', '').lstrip('/'), policy=policy,\n409\t                                    started=data['State']['StartedAt'], restart_count=data.get('RestartCount', 0),\n410\t                                    gates=gates_of(data), compose=compose)\n411\t        if ({identities[r]['name'] for r in ROLES} & set(candidate['names'].values())\n412\t                or ops.compose_ids(candidate['project']) or candidate['project'] == spec['legacy']['project']):\n413\t            self.refuse('candidate-name-or-project-conflict')\n414\t        from rehearse_legacy_queue import legacy_sources\n415\t        legacy_files = legacy_sources(spec['repo'])\n416\t        legacy_digest = self.source_probe('source:legacy', legacy_image, spec['legacy']['source_root'], legacy_files)\n417\t        tree = {p.removeprefix('backend/'): b for p, b in self.files().items() if CANDIDATE_TREE.fullmatch(p)}\n418\t        candidate_digest = self.source_probe('source:candidate', candidate['image'], '/app', tree)\n419\t        ledger = self.ops.ledger()\n420\t        self.j.append('done', step='observe', legacy=identities, ledger_count=len(ledger),\n421\t                      ledger_digest=canonical(ledger),\n422\t                      legacy_source=dict(sha=spec['legacy']['sha'], files=len(legacy_files), digest=legacy_digest),\n423\t                      candidate_source=dict(sha=candidate['sha'], files=len(tree), digest=candidate_digest))\n424\t\n425\t    def contain(self):\n426\t        if self.reached('contained'):\n427\t            return\n428\t        for role in CONTAIN_ORDER:\n429\t            if self.done(f'exit:{role}'):\n430\t                continue\n431\t            item = self.legacy()[role]\n432\t            if not self.done(f'policy:{role}'):\n433\t                self.j.append('intent', step=f'policy:{role}')\n434\t                self.checkpoint(f'contain:{role}:before-policy')\n435\t                self.ops.update_restart(item['id'], 'no')\n436\t                self.checkpoint(f'contain:{role}:after-policy')\n437\t                policy = ((self.ops.inspect(item['id']) or {}).get('HostConfig') or {}).get('RestartPolicy') or {}\n438\t                if policy.get('Name') != 'no':\n439\t                    self.refuse('restart-policy-not-persisted', f'policy:{role}')\n440\t                self.j.append('done', step=f'policy:{role}', persisted='no')\n441\t            if not self.done(f'signal:{role}'):\n442\t                running = ((self.ops.inspect(item['id']) or {}).get('State') or {}).get('Running')\n443\t                if self.j.last('intent', f'signal:{role}') is None:\n444\t                    self.j.append('intent', step=f'signal:{role}')\n445\t                    self.ops.signal(item['id'])\n446\t                    self.checkpoint(f'contain:{role}:after-signal')\n447\t                elif running and self.decision == f'resignal:{role}':\n448\t                    self.j.append('decision', value=self.decision)\n449\t                    self.ops.signal(item['id'])\n450\t                elif running and not self.await_exit(role, item, self.t['grace_s']):\n451\t                    # Delivery unknown after a crash: never resend blindly (a second\n452\t                    # SIGTERM force-quits Uvicorn). Human ``resignal:<role>``.\n453\t                    self.refuse('signal-ambiguous', f'signal:{role}')\n454\t                self.j.append('done', step=f'signal:{role}')\n455\t            if not self.await_exit(role, item, self.t['grace_s']):\n456\t                self.refuse('graceful-timeout', f'exit:{role}')  # no SIGKILL: human decision\n457\t            data = self.ops.inspect(item['id']) or {}\n458\t            code = verify_contained_exit(item, data)\n459\t            if code:\n460\t                self.refuse(code, f'exit:{role}')\n461\t            self.j.append('done', step=f'exit:{role}', finished=data['State'].get('FinishedAt'))\n462\t        self.check_scope(legacy_running=())\n463\t        self.phase('contained')\n464\t\n465\t    def await_exit(self, role, item, timeout):\n466\t        limit = self.clock() + timeout\n467\t        while True:\n468\t            data = self.ops.inspect(item['id']) or {}\n469\t            state = data.get('State') or {}\n470\t            if data.get('RestartCount', 0) != item['restart_count'] or state.get('StartedAt') != item['started']:\n471\t                self.refuse('restarted-after-signal', f'exit:{role}')\n472\t            if not state.get('Running'):\n473\t                return True\n474\t            if self.clock() >= limit:\n475\t                return False\n476\t            self.sleep(0.2)\n477\t\n478\t    def snapshot(self):\n479\t        \"\"\"Domain rows + PERSISTENT Redis db0 keys. TTL keys (heartbeats, dedup markers) are not\n480\t        compared; critical queues are separately required to be persistent by the expectations.\"\"\"\n481\t        return dict(db=canonical(self.ops.db_snapshot()), redis=canonical(self.ops.redis_snapshot()))\n482\t\n483\t    def baseline_snapshot(self):\n484\t        event = self.j.last('snapshot')\n485\t        return {k: event[k] for k in ('db', 'redis')} if event else None\n486\t\n487\t    def settle(self):\n488\t        \"\"\"Expected effects of the drain first (exactly once per item), only then stability.\"\"\"\n489\t        if self.reached('settled'):\n490\t            return\n491\t        problems = self.check_expectations('expect_settled')\n492\t        if problems:\n493\t            self.refuse('expectation-mismatch', 'settle', problems=problems)\n494\t        first = self.snapshot()\n495\t        self.sleep(self.t['settle_s'])\n496\t        if self.snapshot() != first:\n497\t            self.refuse('unstable-after-drain', 'settle')\n498\t        self.check_scope(legacy_running=())\n499\t        self.j.append('done', step='settle')\n500\t        self.j.append('snapshot', reason='settled', redis_volatile_excluded=self.ops.redis_volatile_count(), **first)\n501\t        self.phase('settled')\n502\t\n503\t    def critical_state(self, step):\n504\t        \"\"\"Re-run the settled expectations (critical queues incl. TTL guard) at an effect boundary.\"\"\"\n505\t        problems = self.check_expectations('expect_settled')\n506\t        if problems:\n507\t            self.refuse('expectation-mismatch', step, problems=problems)\n508\t\n509\t    # -- reconciliation (initial_transition_reconcile) ---------------------------\n510\t    def reconcile(self):\n511\t        from initial_transition_reconcile import reconcile\n512\t        reconcile(self)\n513\t\n514\t    def recover_reconciliation(self):\n515\t        from initial_transition_reconcile import recover_reconciliation\n516\t        recover_reconciliation(self)\n517\t\n518\t    def preflight(self):\n519\t        if self.reached('preflighted'):\n520\t            return\n521\t        counts = self.ops.backfill_candidates()\n522\t        if counts != {'membro_por_vinculo': 0, 'numero_atendimento': 0}:\n523\t            self.refuse('backfill-candidates', 'preflight', counts=counts)\n524\t        _, code, _ = self.script('preflight', self.probe_name('release-preflight'), '/app/scripts/release_preflight.py',\n525\t                                 'backend/scripts/release_preflight.py', env={'MIGRATION_DATABASE_URL': self.dsn()})\n526\t        if code != 0:\n527\t            self.refuse('release-preflight', 'preflight', exit_code=code)\n528\t        self.pre_ddl_state('preflight')\n529\t        self.j.append('done', step='preflight')\n530\t        self.phase('preflighted')\n531\t\n532\t    def pre_ddl_state(self, step):\n533\t        \"\"\"Fresh: baseline ledger, exact pending set, last snapshot, no DDL trace, legacy contained, scope.\"\"\"\n534\t        manifest, ledger = self.manifest(), self.ops.ledger()\n535\t        if (len(ledger) != self.observed()['ledger_count'] or canonical(ledger) != self.observed()['ledger_digest']\n536\t                or set(ledger) - set(manifest)):\n537\t            self.refuse('ledger-not-baseline', step)\n538\t        if [n for n in manifest if n not in set(ledger)] != self.spec['expected_pending']:\n539\t            self.refuse('pending-set-mismatch', step)\n540\t        if self.ops.invalid_indexes() or self.ops.index_builds() or self.migration_sessions():\n541\t            self.refuse('ddl-trace-before-marker', step)\n542\t        if [e for e in self.j.find('job') if e.get('step', '').startswith('migration:')] or self.candidate_ids():\n543\t            self.refuse('ddl-trace-before-marker', step)\n544\t        if self.baseline_snapshot() != self.snapshot():\n545\t            self.refuse('writer-after-settle', step)\n546\t        self.critical_state(step)\n547\t        for role, item in self.legacy().items():\n548\t            if verify_contained_exit(item, self.ops.inspect(item['id']) or {}):\n549\t                self.refuse('legacy-not-contained', step, role=role)\n550\t        self.check_scope(legacy_running=())\n551\t\n552\t    def migration_sessions(self):\n553\t        return [s for s in self.ops.pg_sessions() if (s.get('app') or '').startswith('pastorai-mig-')]\n554\t\n555\t    # -- DDL ----------------------------------------------------------------------\n556\t    def migrate(self):\n557\t        if self.reached('migrated'):\n558\t            return\n559\t        manifest = self.manifest()\n560\t        if not self.j.find('ddl-marker'):\n561\t            self.pre_ddl_state('ddl-marker')  # immediately before the irrevocable marker\n562\t            ledger = set(self.ops.ledger())\n563\t            self.j.append('ddl-marker', pending=[n for n in manifest if n not in ledger], irrevocable=True)\n564\t            self.phase('ddl-started')\n565\t        pending = self.j.last('ddl-marker')['pending']\n566\t        for index, name in enumerate(pending, 1):\n567\t            if not self.done(f'migration:{name}'):\n568\t                self.migration(index, name)\n569\t        if self.ops.ledger() != sorted(manifest):\n570\t            self.refuse('ledger-not-manifest', 'migrate')\n571\t        self.phase('migrated')\n572\t\n573\t    def migration(self, index, name):\n574\t        \"\"\"One ``migrate.py apply`` per job; any doubt about the outcome is a sticky refusal.\n575\t\n576\t        Retry only by human ``retry-migration:<name>`` and only when nothing of\n577\t        the failed attempt remains: no invalid index, none of its CONCURRENTLY\n578\t        indexes exists at all (a valid index without ledger row is NOT proof of\n579\t        application), no build, no session, no running job, ledger still absent.\n580\t        \"\"\"\n581\t        step = f'migration:{name}'\n582\t        body = self.files()['backend/migrations/' + name]\n583\t        indexes = concurrent_indexes(body)\n584\t        is_concurrent = any('index concurrently' in line.lower() for line in code_lines(body))\n585\t        attempt = 1 + len([e for e in self.j.find('decision') if e.get('value') == f'retry-migration:{name}'])\n586\t        last = next((e for e in reversed(self.j.find('refused', step)) if e['code'] != 'retry-precondition'), None)\n587\t        if last and last.get('attempt') == attempt:\n588\t            if self.decision != f'retry-migration:{name}' or last['code'] not in RETRIABLE:\n589\t                self.refuse(last['code'], step, attempt=attempt)\n590\t            if (self.ops.invalid_indexes() or self.ops.index_exists(indexes) or name in self.ops.ledger()\n591\t                    or self.ops.index_builds() or self.migration_sessions() or self.running_migration_jobs()):\n592\t                self.refuse('retry-precondition', step, attempt=attempt)\n593\t            self.j.append('decision', value=self.decision, step=step, previous_attempt=attempt)\n594\t            attempt += 1\n595\t        job = f'{self.prefix}-mig-{index:02d}-a{attempt}'\n596\t        app = f'pastorai-mig-{self.run12}-{index:02d}-a{attempt}'\n597\t        if not self.ops.job_find(job) and not [e for e in self.j.find('job', step) if e['name'] == job]:\n598\t            if name in self.ops.ledger():\n599\t                self.refuse('ledger-ahead-of-journal', step, attempt=attempt)\n600\t            if self.migration_sessions() or self.running_migration_jobs():\n601\t                self.wait('migration-session-active', step, attempt=attempt)\n602\t            self.check_scope(legacy_running=())\n603\t            self.j.append('migration', step=step, attempt=attempt, job=job, app=app, concurrent=is_concurrent)\n604\t        args = ['scripts/migrate.py', 'apply', name, '--yes', *(['--no-transaction'] if is_concurrent else [])]\n605\t        identifier, code, _ = self.job(step, job, image=self.spec['candidate']['image'], args=args,\n606\t                                       env={'MIGRATION_DATABASE_URL': self.dsn(), 'PGAPPNAME': app},\n607\t                                       wait=self.t['migration_s'])\n608\t        if [s for s in self.ops.pg_sessions() if s.get('app') == app] or app in self.ops.index_builds():\n609\t            self.wait('migration-session-active', step, attempt=attempt)\n610\t        applied = name in self.ops.ledger()\n611\t        if code == 0 and applied:\n612\t            self.j.append('done', step=step, attempt=attempt, job=identifier)\n613\t            return\n614\t        if applied:\n615\t            self.refuse('migration-ambiguous-ledger-without-success', step, attempt=attempt)\n616\t        if is_concurrent:\n617\t            if self.ops.invalid_indexes():\n618\t                self.refuse('concurrent-index-invalid', step, attempt=attempt, exit_code=code)\n619\t            if self.ops.index_exists(indexes):\n620\t                self.refuse('concurrent-index-present-ledger-absent', step, attempt=attempt, exit_code=code)\n621\t            self.refuse('concurrent-failed-decision', step, attempt=attempt, exit_code=code)\n622\t        self.refuse('migration-ambiguous-exit0-no-ledger' if code == 0 else 'migration-failed', step,\n623\t                    attempt=attempt, exit_code=code)\n624\t\n625\t    def running_migration_jobs(self):\n626\t        return [e['id'] for e in self.j.find('job') if e.get('step', '').startswith('migration:')\n627\t                and ((self.ops.inspect(e['id']) or {}).get('State') or {}).get('Running')]\n628\t\n629\t    def verify_schema(self):\n630\t        \"\"\"Candidate checker + catalogue vs the independent reference, fresh on every invocation.\"\"\"\n631\t        manifest = self.manifest()\n632\t        _, code, _ = self.script('checker', self.probe_name('schema-checker'), '/tmp/check_backend_schema.py',\n633\t                                 'deploy/check_backend_schema.py',\n634\t                                 env={'DATABASE_URL': self.dsn(), 'EXPECTED_MIGRATIONS': json.dumps(manifest)})\n635\t        if code != 0:\n636\t            self.refuse('candidate-checker', 'checker', exit_code=code)\n637\t        module = base64.b64encode(zlib.compress(self.files()['deploy/schema_compatibility.py'], 9)).decode()\n638\t        _, code, out = self.job('catalog', self.probe_name('catalog'), image=self.spec['candidate']['image'],\n639\t                                args=['-I', '-c', CATALOG_PROBE, self.dsn(), module])\n640\t        if code != 0 or not out.strip():\n641\t            self.refuse('catalog-probe', 'catalog')\n642\t        live, expected = json.loads(out.strip().splitlines()[-1]), self.spec['expected_catalog']\n643\t        if live != expected:\n644\t            self.refuse('catalog-drift', 'catalog', kinds=sorted(k for k in expected if live.get(k) != expected[k]))\n645\t        self.j.append('done', step='schema', digest=canonical(live), invocation=self.inv)\n646\t        self.phase('schema-verified')\n647\t\n648\t    # -- candidate side -------------------------------------------------------------\n649\t    def candidate(self):\n650\t        from initial_transition_candidate import run_candidate\n651\t        run_candidate(self)\n652\t\n653\t    def promote(self):\n654\t        from initial_transition_candidate import run_promote\n655\t        run_promote(self)\n656\t\n657\t    def contain_candidate(self, reason):\n658\t        from initial_transition_candidate import contain_candidate\n659\t        contain_candidate(self, reason)\n660\t\n661\t    # -- entry points -----------------------------------------------------------------\n662\t    def run(self, until=None):\n663\t        if self.reached(TERMINAL):\n664\t            self.refuse('legacy-resumed-terminal', 'run')\n665\t        if self.j.find('intent', 'legacy-resume'):\n666\t            # The decision to resume the legacy is exclusive and durable: only\n667\t            # ``resume-legacy`` may continue; nothing here may move towards DDL.\n668\t            self.refuse('legacy-resume-in-progress', 'run')\n669\t        self.base_checks()  # a refusal here performs no containment either: the endpoint is untrusted\n670\t        steps = (('observed', self.observe), ('contained', self.contain), ('settled', self.settle),\n671\t                 ('reconciled', self.reconcile), ('preflighted', self.preflight), ('migrated', self.migrate),\n672\t                 ('schema-verified', self.verify_schema), ('candidate-ready', self.candidate),\n673\t                 ('promoted', self.promote))\n674\t        try:\n675\t            self.revalidate()\n676\t            for name, function in steps:\n677\t                if name == 'schema-verified' and self.reached('promoted'):\n678\t                    continue\n679\t                function()\n680\t                if name == until:\n681\t                    return name\n682\t        except Refused as exc:\n683\t            if (str(exc) not in WAIT_CODES | {'candidate-contained-decision-required'} and self.j.find('ddl-marker')\n684\t                    and not self.reached('promoted') and self.candidate_ids()):\n685\t                self.contain_candidate(str(exc))  # post-DDL: candidate stopped, never the legacy back\n686\t            raise\n687\t        return 'promoted'\n688\t\n689\t    def resume_token(self):\n690\t        return f'RETOMAR-LEGADO-PRE-DDL:{self.spec[\"run_id\"]}:{self.j.digest()}'\n691\t\n692\t    def resume_legacy(self, confirmation, expected_token):\n693\t        from initial_transition_resume import resume_legacy\n694\t        resume_legacy(self, confirmation, expected_token)\n695\t\n696\t    def resume_preconditions(self):\n697\t        from initial_transition_resume import resume_preconditions\n698\t        resume_preconditions(self)\n699\t\n700\t\n701\t# -- CLI ----------------------------------------------------------------------\n702\tdef load_spec(path):\n703\t    spec = json.loads(read_regular(path))\n704\t    require(isinstance(spec, dict) and spec.get('version') == 1 and spec.get('synthetic') is True, 'spec')\n705\t    require(re.fullmatch(r'[0-9a-f]{32}', spec.get('run_id', '')), 'spec')\n706\t    require(spec.get('prefix') == 'pastorai-synthetic-transition-' + spec['run_id'][:12], 'spec-prefix')\n707\t    require(SHA.fullmatch(spec['candidate']['sha']) and SHA.fullmatch(spec['legacy']['sha']), 'spec')\n708\t    require(IMAGE_ID.fullmatch(spec['legacy']['image']) and IMAGE_ID.fullmatch(spec['candidate']['image']), 'spec')\n709\t    require(DSN.fullmatch(spec['database']['dsn']), 'dsn-not-owned-alias')\n710\t    require(all(RESOURCE_ID.fullmatch(i) for i in (*spec['support'].values(), *spec['network'].values(),\n711\t                                                   *spec['legacy']['containers'].values())), 'spec-ids')\n712\t    for key in ('release_root', 'repo'):\n713\t        no_symlink(spec[key])\n714\t    spec['_compose_bytes'] = read_regular(spec['candidate']['compose_file'])\n715\t    require(sha256(spec['_compose_bytes']) == spec['candidate']['compose_sha256'], 'candidate-compose-changed')\n716\t    return spec\n717\t\n718\t\n719\tdef main(argv=None):\n720\t    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])\n721\t    sub = parser.add_subparsers(dest='command', required=True)\n722\t    for name in ('run', 'status', 'resume-legacy'):\n723\t        command = sub.add_parser(name)\n724\t        command.add_argument('--spec', type=Path, required=True)\n725\t        command.add_argument('--state', type=Path, required=True)\n726\t        command.add_argument('--allow-probe', action='append', default=[])\n727\t        if name == 'run':\n728\t            command.add_argument('--until', choices=PHASES)\n729\t            command.add_argument('--decision')\n730\t            command.add_argument('--pause-at')\n731\t        if name == 'resume-legacy':\n732\t            command.add_argument('--confirm', required=True)\n733\t            command.add_argument('--pause-at')\n734\t    args = parser.parse_args(argv)\n735\t    try:\n736\t        spec = load_spec(args.spec)\n737\t        journal = Journal(args.state).open()\n738\t    except Refused as exc:\n739\t        print(json.dumps({'status': 'refused', 'code': str(exc)}))\n740\t        return EXIT_BUSY if str(exc) == 'controller-busy' else EXIT_USAGE\n741\t    try:\n742\t        return dispatch(args, spec, journal)\n743\t    finally:\n744\t        journal.close()\n745\t\n746\t\n747\tdef dispatch(args, spec, journal):\n748\t    digest = canonical({k: v for k, v in spec.items() if k != '_compose_bytes'})\n749\t    init = journal.last('init')\n750\t    if init is None:\n751\t        journal.append('init', spec_sha256=digest, run_id=spec['run_id'])\n752\t    elif init['spec_sha256'] != digest:\n753\t        print(json.dumps({'status': 'refused', 'code': 'spec-changed'}))\n754\t        return EXIT_USAGE\n755\t    transition = Transition(spec, journal, DockerOps(spec), probes=args.allow_probe,\n756\t                            decision=getattr(args, 'decision', None), pause_at=getattr(args, 'pause_at', None))\n757\t    phases = lambda: [e['name'] for e in journal.find('phase')]\n758\t    if args.command == 'status':\n759\t        pre_ddl = not journal.find('ddl-marker') and transition.reached('contained')\n760\t        print(json.dumps({'status': 'ok', 'phases': phases(), 'epoch': transition.epoch(),\n761\t                          'last_refusal': (journal.last('refused') or {}).get('code'),\n762\t                          'resume_token': transition.resume_token() if pre_ddl else None}, sort_keys=True))\n763\t        return 0\n764\t    expected_token = transition.resume_token()  # before this invocation is journaled\n765\t    transition.inv = journal.append('invocation', command=args.command, probes=args.allow_probe,\n766\t                                    decision=getattr(args, 'decision', None),\n767\t                                    pause_at=getattr(args, 'pause_at', None))['seq']\n768\t    try:\n769\t        if args.command == 'run':\n770\t            reached = transition.run(getattr(args, 'until', None))\n771\t        else:\n772\t            transition.resume_legacy(args.confirm, expected_token)\n773\t            reached = TERMINAL\n774\t    except Refused as exc:\n775\t        code = str(exc)\n776\t        print(json.dumps({'status': 'waiting' if code in WAIT_CODES else 'refused', 'code': code,\n777\t                          'phases': phases(), 'epoch': transition.epoch()}))\n778\t        return EXIT_WAIT if code in WAIT_CODES else EXIT_REFUSED\n779\t    print(json.dumps({'status': 'ok', 'reached': reached, 'phases': phases()}))\n780\t    return 0\n781\t\n782\t\n783\tif __name__ == '__main__':\n784\t    sys.path.insert(0, str(Path(__file__).resolve().parent))\n785\t    sys.exit(main())\n786\t"}]},"parent_tool_use_id":null,"session_id":"6f5f5b47-c66e-4591-b756-d99024a874c5","uuid":"4d5b278b-2773-4255-a4dc-b527e977d139","timestamp":"2026-10-30T15:03:53.681Z","tool_use_result":{"type":"text","file":{"filePath":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/initial_transition.py","content":"#!/usr/bin/env python3\n\"\"\"Controller of the FIRST transition from the unversioned legacy install to the candidate.\n\n``run --spec S --state D [--until PHASE] [--allow-probe ID]... [--decision D] [--pause-at CP]``\n``status --spec S --state D`` / ``resume-legacy --spec S --state D --confirm TOKEN``\n\n``backend-release.sh`` refuses the legacy install (no release tree, no checker,\nno revision label); this controller performs only that first turn and leaves a\nrelease layout behind. It runs on owned synthetic Docker resources only\n(``rehearse_initial_transition.py``): ``production_ready`` is false, there is\nno production adapter. The layout carries the public topology contract that\n``backend-release.sh`` adopts for the next release (``release_topology.py``).\n\nEvery invocation re-validates the local Docker endpoint, owned networks and\nsupport containers (before any SQL), legacy identity/policy/state, gates and\nscope, whatever phase the journal records. Every effect is preceded by a\ndurable intent; replay inspects real state and refuses when the outcome is\nambiguous. The ``ddl-marker`` is irrevocable: afterwards the legacy is never\nrestarted, and any failure before promotion contains the candidate (restart\n``no`` persisted, SIGTERM, exit observed) until a human ``retry-candidate``.\nGates are never changed: the candidate must carry exactly the legacy values.\n\nPhases: observed -> contained -> settled -> reconciled -> preflighted ->\nddl-started -> migrated -> schema-verified -> candidate-ready -> promoted.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport base64\nimport json\nimport re\nimport sys\nimport time\nimport zlib\nfrom pathlib import Path\n\nfrom initial_transition_files import (\n    Journal, git_tree, migration_manifest, no_symlink, read_regular, sha256,\n)\nfrom initial_transition_ops import (\n    COMPOSE_PROJECT, COMPOSE_SERVICE, DSN, IMAGE_ID, OBSERVER_APPS, OWNER_LABEL, RESOURCE_ID,\n    REVISION_LABEL, SHA, DockerOps, Refused, gates_of, host_exposed, ip_of, require,\n)\n\nPHASES = ('observed', 'contained', 'settled', 'reconciled', 'preflighted', 'ddl-started', 'migrated',\n          'schema-verified', 'candidate-ready', 'promoted')\nCANDIDATE_PHASES = frozenset({'candidate-ready', 'promoted'})\nTERMINAL = 'legacy-resumed'\nROLES = ('backend', 'queue-worker', 'cron-worker', 'broadcast-worker')\nCONTAIN_ORDER = ('backend', 'cron-worker', 'broadcast-worker', 'queue-worker')\nSTART_ORDER = ('backend', 'queue-worker', 'broadcast-worker', 'cron-worker')\nEXIT_REFUSED, EXIT_WAIT, EXIT_USAGE, EXIT_BUSY = 3, 4, 2, 5\nRETRIABLE = frozenset({'migration-failed', 'concurrent-index-invalid', 'concurrent-failed-decision',\n                       'concurrent-index-present-ledger-absent'})\nWAIT_CODES = frozenset({'job-active', 'migration-job-active', 'migration-session-active'})\nCANDIDATE_TREE = re.compile(r'backend/(?:app/(?:[A-Za-z_][A-Za-z0-9_]*/)*[A-Za-z_][A-Za-z0-9_]*\\.py'\n                            r'|migrations/(?:[A-Za-z0-9_]+/)?[A-Za-z0-9_.-]+\\.sql|requirements\\.lock'\n                            r'|scripts/migrate\\.py)')\n# Exact allowlist of candidate blobs ever read (image tree + reviewed tools).\nTOOLS = ('backend/scripts/reconcile_team_pessoa.py', 'backend/scripts/release_preflight.py',\n         *(f'deploy/{name}' for name in ('backend-release.sh', 'check_backend_schema.py', 'emit_schema_check.py',\n                                         'schema_compatibility.py', 'docker-compose.yml', 'release_topology.py')))\nCANDIDATE_PATHSPECS = ('backend/app', 'backend/migrations', 'backend/requirements.lock',\n                       'backend/scripts/migrate.py', *TOOLS)\nCANDIDATE_BLOBS = re.compile(CANDIDATE_TREE.pattern + '|' + '|'.join(re.escape(p) for p in TOOLS))\nCONCURRENT_INDEX = re.compile(r'create\\s+(?:unique\\s+)?index\\s+concurrently\\s+(?:if\\s+not\\s+exists\\s+)?'\n                              r'(?:public\\.)?\"?([a-z0-9_]+)\"?', re.IGNORECASE)\nDEFAULT_TIMEOUTS = dict(grace_s=30, settle_s=4, migration_s=300, job_s=180, ready_s=120, active_wait_s=5)\n\nCATALOG_PROBE = r'''\nimport base64, hashlib, json, sys, types, zlib\nfrom sqlalchemy import create_engine\nsource = zlib.decompress(base64.b64decode(sys.argv[2])).decode('utf-8')\nmodule = types.ModuleType('schema_compatibility')\nexec(compile(source, 'schema_compatibility.py', 'exec'), module.__dict__)\nengine = create_engine(sys.argv[1])\nwith engine.connect() as connection:\n    connection.exec_driver_sql('SET TRANSACTION READ ONLY')\n    catalog = module.capture_catalog(connection)\nengine.dispose()\ndigest = lambda value: hashlib.sha256(json.dumps(value, sort_keys=True, default=str).encode()).hexdigest()\nprint(json.dumps({kind: digest(value) for kind, value in catalog.items()}, sort_keys=True))\n'''\n\n\ndef canonical(value):\n    return sha256(json.dumps(value, sort_keys=True, separators=(',', ':')).encode())\n\n\ndef code_lines(body):\n    return [line for line in body.decode('utf-8').splitlines() if not line.lstrip().startswith('--')]\n\n\ndef concurrent_indexes(body):\n    \"\"\"Index names a CONCURRENTLY migration creates (non-comment lines); empty if transactional.\"\"\"\n    return sorted({m.lower() for line in code_lines(body) for m in CONCURRENT_INDEX.findall(line)})\n\n\ndef verify_contained_exit(observed, data):\n    \"\"\"Refusal code for a container that did not stay stopped after SIGTERM, else ``None``.\"\"\"\n    state, host = data.get('State') or {}, data.get('HostConfig') or {}\n    if data.get('RestartCount', 0) != observed['restart_count'] or state.get('StartedAt') != observed['started']:\n        return 'restarted-after-signal'\n    if (host.get('RestartPolicy') or {}).get('Name') != 'no':\n        return 'restart-policy-not-persisted'\n    if state.get('Running'):\n        return 'still-running'\n    if state.get('ExitCode') != 0:\n        return 'ungraceful-exit'\n    return None\n\n\ndef check_expect(ops, expect):\n    \"\"\"Names (never values) of every expected effect that does not hold exactly.\"\"\"\n    problems = []\n    if expect.get('messages'):\n        counts = ops.message_counts(sorted(expect['messages']))\n        problems += ['messages' for k, n in expect['messages'].items() if counts.get(k) != n][:1]\n    # Critical queues (list or zset) must be persistent (no TTL): the stability\n    # snapshot excludes TTL keys, so a TTL would hide their loss. Absent = empty.\n    for kind, read in (('redis_lists', ops.redis_list), ('redis_zsets', ops.redis_zset)):\n        for key, expected in sorted((expect.get(kind) or {}).items()):\n            ttl = ops.redis_pttl(key)\n            if ttl != -1 and not (ttl == -2 and not expected):\n                problems.append('redis-volatile-or-missing:' + key)\n            elif read(key) != expected:\n                problems.append(kind.removesuffix('s').replace('_', '-') + ':' + key)\n    for prefix in expect.get('redis_absent_prefixes') or []:\n        if ops.redis_keys(prefix):\n            problems.append('redis-present:' + prefix)\n    if expect.get('deliveries'):\n        states = ops.delivery_states(sorted(expect['deliveries']))\n        problems += ['deliveries' for k, v in expect['deliveries'].items() if states.get(k) != v][:1]\n    return problems\n\n\nclass Transition:\n    def __init__(self, spec, journal, ops, *, probes=(), decision=None, pause_at=None, clock=time.monotonic,\n                 sleep=time.sleep, git=None):\n        self.spec, self.j, self.ops = spec, journal, ops\n        self.probes, self.decision, self.pause_at = list(probes), decision, pause_at\n        self.clock, self.sleep, self.git = clock, sleep, git\n        self.t = {**DEFAULT_TIMEOUTS, **(spec.get('timeouts') or {})}\n        self.run12, self.prefix = spec['run_id'][:12], spec['prefix']\n        self._files, self.inv, self.probe_count = None, 0, 0\n\n    # -- journal views ------------------------------------------------------\n    def checkpoint(self, name):\n        if self.pause_at == name:\n            self.j.append('paused', checkpoint=name)\n            (self.j.dir / 'paused').write_text(name + '\\n')\n            while True:  # synthetic test hook: the rehearsal SIGKILLs this process here\n                self.sleep(1)\n\n    def epoch(self):\n        \"\"\"Seq of the last candidate containment: candidate steps before it no longer count.\"\"\"\n        last = self.j.last('candidate-contained')\n        return last['seq'] if last else 0\n\n    def done(self, step, since=0):\n        return self.j.last('done', step, since) is not None\n\n    def cdone(self, step):\n        return self.done(step, self.epoch())\n\n    def reached(self, name):\n        since = self.epoch() if name in CANDIDATE_PHASES else 0\n        return any(e.get('name') == name for e in self.j.find('phase', since=since))\n\n    def phase(self, name):\n        if not self.reached(name):\n            self.j.append('phase', name=name)\n\n    def refuse(self, code, step=None, **fields):\n        self.j.append('refused', code=code, step=step, **fields)\n        raise Refused(code)\n\n    def wait(self, code, step, **fields):\n        \"\"\"Transient (active job/session): journaled, never sticky, exit code 4.\"\"\"\n        self.j.append('waiting', code=code, step=step, **fields)\n        raise Refused(code)\n\n    def observed(self):\n        event = self.j.last('done', 'observe')\n        require(event is not None, 'not-observed')\n        return event\n\n    def legacy(self):\n        return self.observed()['legacy']\n\n    def candidate_ids(self):\n        event = self.j.last('done', 'candidate:create')\n        return event['ids'] if event else {}\n\n    def job_ids(self):\n        return {e['id'] for e in self.j.find('job')}\n\n    def files(self):\n        if self._files is None:\n            self._files = git_tree(self.spec['repo'], self.spec['candidate']['sha'], CANDIDATE_PATHSPECS,\n                                   CANDIDATE_BLOBS, self.git)\n        return self._files\n\n    def manifest(self):\n        files = self.files()\n        sql = {p.split('/', 2)[2]: b for p, b in files.items() if re.fullmatch(r'backend/migrations/[^/]+\\.sql', p)}\n        return migration_manifest(files['backend/scripts/migrate.py'], sql)\n\n    def dsn(self):\n        return self.spec['database']['dsn']\n\n    # -- validation on EVERY invocation ---------------------------------------\n    def base_checks(self):\n        \"\"\"Local endpoint and owned topology, before any SQL or effect (every invocation).\"\"\"\n        self.ops.guard_local()\n        self.ops.verify_topology()\n\n    def check_expectations(self, key):\n        return check_expect(self.ops, self.spec[key])\n\n    def revalidate(self):\n        \"\"\"Legacy and candidate identity/state/gates, every invocation, whatever the journal says.\"\"\"\n        if not self.done('observe'):\n            return\n        observed = self.observed()\n        for role, item in self.legacy().items():\n            data = self.ops.inspect(item['id']) or {}\n            labels = (data.get('Config') or {}).get('Labels') or {}\n            if (data.get('Id') != item['id'] or data.get('Image') != self.spec['legacy']['image']\n                    or labels.get(OWNER_LABEL) != self.spec['run_id'] or (COMPOSE_PROJECT in labels) != item['compose']\n                    or (item['compose'] and labels.get(COMPOSE_PROJECT) != self.spec['legacy']['project'])\n                    or gates_of(data) != item['gates'] or host_exposed(data)):\n                self.refuse('legacy-identity-changed', 'revalidate', role=role)\n            resumed = self.j.last('done', f'legacy-resume:{role}')\n            if resumed:\n                # Back on purpose: same execution, original policy, no restart since.\n                if (not (data.get('State') or {}).get('Running')\n                        or (data.get('State') or {}).get('StartedAt') != resumed['started']\n                        or data.get('RestartCount', 0) != resumed.get('restart_count', 0)\n                        or ((data.get('HostConfig') or {}).get('RestartPolicy') or {}).get('Name') != item['policy']):\n                    self.refuse('legacy-resumed-state-changed', 'revalidate', role=role)\n            elif self.j.last('intent', f'legacy-resume:{role}'):\n                pass  # start intended before a crash: running or not, identity/gates checked above\n            elif self.done(f'exit:{role}'):\n                code = verify_contained_exit(item, data)\n                if code:\n                    self.refuse('legacy-' + code, 'revalidate', role=role)\n            else:\n                # Not yet exited: same execution; policy original, or ``no`` once its change is intended.\n                allowed = {item['policy']} if not self.j.last('intent', f'policy:{role}') else {item['policy'], 'no'}\n                if self.done(f'policy:{role}'):\n                    allowed = {'no'}\n                if (data.get('RestartCount', 0) != item['restart_count']\n                        or (data.get('State') or {}).get('StartedAt') != item['started']\n                        or ((data.get('HostConfig') or {}).get('RestartPolicy') or {}).get('Name') not in allowed):\n                    self.refuse('legacy-state-changed', 'revalidate', role=role)\n        if observed.get('ledger_count') is None:\n            self.refuse('observe-incomplete', 'revalidate')\n        for role, identifier in self.candidate_ids().items():\n            data = self.ops.inspect(identifier) or {}\n            labels = (data.get('Config') or {}).get('Labels') or {}\n            if (data.get('Id') != identifier or data.get('Image') != self.spec['candidate']['image']\n                    or labels.get(COMPOSE_PROJECT) != self.spec['candidate']['project']\n                    or labels.get(OWNER_LABEL) != self.spec['run_id'] or host_exposed(data)\n                    or gates_of(data) != self.legacy()[role]['gates']):\n                self.refuse('candidate-identity-changed', 'revalidate', role=role)\n\n    def ip_map(self, ids):\n        found = {}\n        for identifier in ids:\n            data = self.ops.inspect(identifier)\n            address = data and ip_of(data, self.spec['network']['app'])\n            if address:\n                found[address] = identifier\n        return found\n\n    def check_scope(self, *, legacy_running, candidate_running=()):\n        \"\"\"Every owned container is known; only expected processes on networks, DB and Redis.\"\"\"\n        legacy = self.legacy()\n        known = ({v['id'] for v in legacy.values()} | set(self.spec['support'].values())\n                 | set(self.candidate_ids().values()) | self.job_ids() | set(self.probes))\n        if self.ops.owned_containers(self.spec['run_id']) - known:\n            self.refuse('orphan-owned-container')\n        writers = ({legacy[r]['id'] for r in legacy_running} | set(self.probes)\n                   | {self.candidate_ids()[r] for r in candidate_running})\n        support = set(self.spec['support'].values())\n        for name in ('app', 'edge'):\n            _, members = self.ops.network_members(self.spec['network'][name])\n            if members - (writers | (support if name == 'app' else set())):\n                self.refuse('fifth-writer-network')\n        ips = self.ip_map(writers)\n        evolution_ip = next(iter(self.ip_map([self.spec['support']['evolution']])), None)\n        for session in self.ops.pg_sessions():\n            if session.get('addr') is None and session.get('app') in OBSERVER_APPS:\n                continue  # read-only observer inside the owned Postgres container\n            if session.get('addr') not in ips:\n                self.refuse('fifth-writer-database')\n        for client in self.ops.redis_clients():\n            if client['addr'] == '127.0.0.1':\n                continue  # ``docker exec redis-cli`` observers inside the owned Redis container\n            if client['addr'] == evolution_ip and client.get('db') != '0':\n                continue  # fake provider bookkeeping, never db0\n            if client['addr'] not in ips:\n                self.refuse('fifth-writer-redis')\n\n    # -- jobs -------------------------------------------------------------------\n    def job(self, step, name, *, image, args, env=None, network='app', stdin=None, wait=None):\n        \"\"\"Create (intent first) and run one owned job; replay adopts only the identical container.\n\n        A job already running (left by a killed controller) is never signalled\n        or restarted: awaited briefly, then reported active (exit 4).\n        \"\"\"\n        network, env = self.spec['network'].get(network, network), env or {}\n        ids = self.ops.job_find(name)\n        recorded = [e['id'] for e in self.j.find('job', step) if e.get('name') == name]\n        if len(ids) > 1 or (recorded and ids != recorded[-1:]):\n            self.refuse('job-ambiguous', step)\n        if ids:\n            identifier = ids[0]\n            data = self.ops.inspect(identifier) or {}\n            labels = (data.get('Config') or {}).get('Labels') or {}\n            if (labels.get(OWNER_LABEL) != self.spec['run_id'] or labels.get('pastorai.transition.job') != name\n                    or not self.ops.job_matches(data, image=image, args=args, env=env, network=network)):\n                self.refuse('job-mismatch', step)\n            if not recorded:\n                if not [e for e in self.j.find('intent', step) if e.get('name') == name]:\n                    self.refuse('job-without-intent', step)\n                self.j.append('job', step=step, name=name, id=identifier, adopted=True)\n        else:\n            self.j.append('intent', step=step, name=name)\n            identifier = self.ops.job_create(name=name, kind=step.split(':', 1)[0], image=image, args=args,\n                                             env=env, stdin=stdin is not None, network=network)\n            self.j.append('job', step=step, name=name, id=identifier)\n        state = (self.ops.inspect(identifier) or {}).get('State') or {}\n        budget = wait if wait is not None else self.t['job_s']\n        if state.get('Running'):\n            budget = self.t['active_wait_s']  # adopted live job: observe, never take over\n        elif state.get('Status') == 'created':\n            self.checkpoint(f'job:{name}:before-start')\n            if stdin is not None:\n                self.ops.job_start(identifier, input=stdin, timeout=self.t['job_s'])\n            else:\n                self.ops.job_start(identifier)\n        limit = self.clock() + budget\n        while (state := (self.ops.inspect(identifier) or {}).get('State') or {}).get('Running'):\n            if self.clock() >= limit:\n                self.wait('job-active', step, job=identifier)\n            self.sleep(0.5)\n        return identifier, state.get('ExitCode'), self.ops.job_logs(identifier)\n\n    def probe_name(self, kind):\n        \"\"\"Read-only probes are fresh per invocation: a stale exit/log is never reused.\"\"\"\n        self.probe_count += 1\n        return f'{self.prefix}-job-{kind}-i{self.inv}-{self.probe_count}'\n\n    def script(self, step, name, target, path, extra=(), env=None, stdin=None):\n        args = self.ops.script_args(target, self.files()[path], extra)\n        return self.job(step, name, image=self.spec['candidate']['image'], args=args, env=env, stdin=stdin)\n\n    def source_probe(self, step, image, root, files):\n        from rehearse_legacy_queue import RUNTIME_PROBE, lock_entries, runtime_mismatch\n        expected = {path: sha256(data) for path, data in files.items()}\n        lock = files['requirements.lock'].decode('utf-8')\n        markers = sorted({m for _, _, m in lock_entries(lock) if m})\n        _, code, out = self.job(step, self.probe_name(step.replace(':', '-')), image=image, network='none',\n                                args=['-I', '-c', RUNTIME_PROBE, root, json.dumps(markers), json.dumps(sorted(expected))])\n        if code != 0 or not out.strip():\n            self.refuse('source-probe', step)\n        observed = json.loads(out.strip().splitlines()[-1])\n        if observed.get('rejected') or observed.get('missing') or observed.get('files') != expected:\n            self.refuse('source-mismatch', step)\n        if runtime_mismatch(lock, observed):\n            self.refuse('runtime-mismatch', step)\n        return canonical(expected)\n\n    # -- legacy side ------------------------------------------------------------\n    def observe(self):\n        if not self.done('observe'):\n            self.identify()\n        if not self.reached('observed'):\n            self.check_scope(legacy_running=ROLES)\n            self.phase('observed')\n\n    def identify(self):\n        spec, ops = self.spec, self.ops\n        legacy_image, candidate = spec['legacy']['image'], spec['candidate']\n        ops.image(legacy_image)\n        if (ops.image(candidate['image']).get('Config', {}).get('Labels') or {}).get(REVISION_LABEL) != candidate['sha']:\n            self.refuse('candidate-revision-label')\n        identities = {}\n        for role in ROLES:\n            identifier = spec['legacy']['containers'][role]\n            data = ops.inspect(identifier)\n            if not data or data.get('Id') != identifier or not RESOURCE_ID.fullmatch(identifier):\n                self.refuse('legacy-identity')\n            labels, host = (data.get('Config') or {}).get('Labels') or {}, data.get('HostConfig') or {}\n            compose = role not in spec['legacy']['standalone']\n            if (labels.get(OWNER_LABEL) != spec['run_id'] or data.get('Image') != legacy_image\n                    or compose != (COMPOSE_PROJECT in labels)\n                    or (compose and (labels.get(COMPOSE_PROJECT) != spec['legacy']['project']\n                                     or labels.get(COMPOSE_SERVICE) != role))):\n                self.refuse('legacy-topology')\n            policy = (host.get('RestartPolicy') or {}).get('Name')\n            if policy != 'always':\n                self.refuse('legacy-restart-policy-unexpected')\n            if host_exposed(data) or not (data.get('State') or {}).get('Running'):\n                self.refuse('legacy-state')\n            identities[role] = dict(id=identifier, name=data.get('Name', '').lstrip('/'), policy=policy,\n                                    started=data['State']['StartedAt'], restart_count=data.get('RestartCount', 0),\n                                    gates=gates_of(data), compose=compose)\n        if ({identities[r]['name'] for r in ROLES} & set(candidate['names'].values())\n                or ops.compose_ids(candidate['project']) or candidate['project'] == spec['legacy']['project']):\n            self.refuse('candidate-name-or-project-conflict')\n        from rehearse_legacy_queue import legacy_sources\n        legacy_files = legacy_sources(spec['repo'])\n        legacy_digest = self.source_probe('source:legacy', legacy_image, spec['legacy']['source_root'], legacy_files)\n        tree = {p.removeprefix('backend/'): b for p, b in self.files().items() if CANDIDATE_TREE.fullmatch(p)}\n        candidate_digest = self.source_probe('source:candidate', candidate['image'], '/app', tree)\n        ledger = self.ops.ledger()\n        self.j.append('done', step='observe', legacy=identities, ledger_count=len(ledger),\n                      ledger_digest=canonical(ledger),\n                      legacy_source=dict(sha=spec['legacy']['sha'], files=len(legacy_files), digest=legacy_digest),\n                      candidate_source=dict(sha=candidate['sha'], files=len(tree), digest=candidate_digest))\n\n    def contain(self):\n        if self.reached('contained'):\n            return\n        for role in CONTAIN_ORDER:\n            if self.done(f'exit:{role}'):\n                continue\n            item = self.legacy()[role]\n            if not self.done(f'policy:{role}'):\n                self.j.append('intent', step=f'policy:{role}')\n                self.checkpoint(f'contain:{role}:before-policy')\n                self.ops.update_restart(item['id'], 'no')\n                self.checkpoint(f'contain:{role}:after-policy')\n                policy = ((self.ops.inspect(item['id']) or {}).get('HostConfig') or {}).get('RestartPolicy') or {}\n                if policy.get('Name') != 'no':\n                    self.refuse('restart-policy-not-persisted', f'policy:{role}')\n                self.j.append('done', step=f'policy:{role}', persisted='no')\n            if not self.done(f'signal:{role}'):\n                running = ((self.ops.inspect(item['id']) or {}).get('State') or {}).get('Running')\n                if self.j.last('intent', f'signal:{role}') is None:\n                    self.j.append('intent', step=f'signal:{role}')\n                    self.ops.signal(item['id'])\n                    self.checkpoint(f'contain:{role}:after-signal')\n                elif running and self.decision == f'resignal:{role}':\n                    self.j.append('decision', value=self.decision)\n                    self.ops.signal(item['id'])\n                elif running and not self.await_exit(role, item, self.t['grace_s']):\n                    # Delivery unknown after a crash: never resend blindly (a second\n                    # SIGTERM force-quits Uvicorn). Human ``resignal:<role>``.\n                    self.refuse('signal-ambiguous', f'signal:{role}')\n                self.j.append('done', step=f'signal:{role}')\n            if not self.await_exit(role, item, self.t['grace_s']):\n                self.refuse('graceful-timeout', f'exit:{role}')  # no SIGKILL: human decision\n            data = self.ops.inspect(item['id']) or {}\n            code = verify_contained_exit(item, data)\n            if code:\n                self.refuse(code, f'exit:{role}')\n            self.j.append('done', step=f'exit:{role}', finished=data['State'].get('FinishedAt'))\n        self.check_scope(legacy_running=())\n        self.phase('contained')\n\n    def await_exit(self, role, item, timeout):\n        limit = self.clock() + timeout\n        while True:\n            data = self.ops.inspect(item['id']) or {}\n            state = data.get('State') or {}\n            if data.get('RestartCount', 0) != item['restart_count'] or state.get('StartedAt') != item['started']:\n                self.refuse('restarted-after-signal', f'exit:{role}')\n            if not state.get('Running'):\n                return True\n            if self.clock() >= limit:\n                return False\n            self.sleep(0.2)\n\n    def snapshot(self):\n        \"\"\"Domain rows + PERSISTENT Redis db0 keys. TTL keys (heartbeats, dedup markers) are not\n        compared; critical queues are separately required to be persistent by the expectations.\"\"\"\n        return dict(db=canonical(self.ops.db_snapshot()), redis=canonical(self.ops.redis_snapshot()))\n\n    def baseline_snapshot(self):\n        event = self.j.last('snapshot')\n        return {k: event[k] for k in ('db', 'redis')} if event else None\n\n    def settle(self):\n        \"\"\"Expected effects of the drain first (exactly once per item), only then stability.\"\"\"\n        if self.reached('settled'):\n            return\n        problems = self.check_expectations('expect_settled')\n        if problems:\n            self.refuse('expectation-mismatch', 'settle', problems=problems)\n        first = self.snapshot()\n        self.sleep(self.t['settle_s'])\n        if self.snapshot() != first:\n            self.refuse('unstable-after-drain', 'settle')\n        self.check_scope(legacy_running=())\n        self.j.append('done', step='settle')\n        self.j.append('snapshot', reason='settled', redis_volatile_excluded=self.ops.redis_volatile_count(), **first)\n        self.phase('settled')\n\n    def critical_state(self, step):\n        \"\"\"Re-run the settled expectations (critical queues incl. TTL guard) at an effect boundary.\"\"\"\n        problems = self.check_expectations('expect_settled')\n        if problems:\n            self.refuse('expectation-mismatch', step, problems=problems)\n\n    # -- reconciliation (initial_transition_reconcile) ---------------------------\n    def reconcile(self):\n        from initial_transition_reconcile import reconcile\n        reconcile(self)\n\n    def recover_reconciliation(self):\n        from initial_transition_reconcile import recover_reconciliation\n        recover_reconciliation(self)\n\n    def preflight(self):\n        if self.reached('preflighted'):\n            return\n        counts = self.ops.backfill_candidates()\n        if counts != {'membro_por_vinculo': 0, 'numero_atendimento': 0}:\n            self.refuse('backfill-candidates', 'preflight', counts=counts)\n        _, code, _ = self.script('preflight', self.probe_name('release-preflight'), '/app/scripts/release_preflight.py',\n                                 'backend/scripts/release_preflight.py', env={'MIGRATION_DATABASE_URL': self.dsn()})\n        if code != 0:\n            self.refuse('release-preflight', 'preflight', exit_code=code)\n        self.pre_ddl_state('preflight')\n        self.j.append('done', step='preflight')\n        self.phase('preflighted')\n\n    def pre_ddl_state(self, step):\n        \"\"\"Fresh: baseline ledger, exact pending set, last snapshot, no DDL trace, legacy contained, scope.\"\"\"\n        manifest, ledger = self.manifest(), self.ops.ledger()\n        if (len(ledger) != self.observed()['ledger_count'] or canonical(ledger) != self.observed()['ledger_digest']\n                or set(ledger) - set(manifest)):\n            self.refuse('ledger-not-baseline', step)\n        if [n for n in manifest if n not in set(ledger)] != self.spec['expected_pending']:\n            self.refuse('pending-set-mismatch', step)\n        if self.ops.invalid_indexes() or self.ops.index_builds() or self.migration_sessions():\n            self.refuse('ddl-trace-before-marker', step)\n        if [e for e in self.j.find('job') if e.get('step', '').startswith('migration:')] or self.candidate_ids():\n            self.refuse('ddl-trace-before-marker', step)\n        if self.baseline_snapshot() != self.snapshot():\n            self.refuse('writer-after-settle', step)\n        self.critical_state(step)\n        for role, item in self.legacy().items():\n            if verify_contained_exit(item, self.ops.inspect(item['id']) or {}):\n                self.refuse('legacy-not-contained', step, role=role)\n        self.check_scope(legacy_running=())\n\n    def migration_sessions(self):\n        return [s for s in self.ops.pg_sessions() if (s.get('app') or '').startswith('pastorai-mig-')]\n\n    # -- DDL ----------------------------------------------------------------------\n    def migrate(self):\n        if self.reached('migrated'):\n            return\n        manifest = self.manifest()\n        if not self.j.find('ddl-marker'):\n            self.pre_ddl_state('ddl-marker')  # immediately before the irrevocable marker\n            ledger = set(self.ops.ledger())\n            self.j.append('ddl-marker', pending=[n for n in manifest if n not in ledger], irrevocable=True)\n            self.phase('ddl-started')\n        pending = self.j.last('ddl-marker')['pending']\n        for index, name in enumerate(pending, 1):\n            if not self.done(f'migration:{name}'):\n                self.migration(index, name)\n        if self.ops.ledger() != sorted(manifest):\n            self.refuse('ledger-not-manifest', 'migrate')\n        self.phase('migrated')\n\n    def migration(self, index, name):\n        \"\"\"One ``migrate.py apply`` per job; any doubt about the outcome is a sticky refusal.\n\n        Retry only by human ``retry-migration:<name>`` and only when nothing of\n        the failed attempt remains: no invalid index, none of its CONCURRENTLY\n        indexes exists at all (a valid index without ledger row is NOT proof of\n        application), no build, no session, no running job, ledger still absent.\n        \"\"\"\n        step = f'migration:{name}'\n        body = self.files()['backend/migrations/' + name]\n        indexes = concurrent_indexes(body)\n        is_concurrent = any('index concurrently' in line.lower() for line in code_lines(body))\n        attempt = 1 + len([e for e in self.j.find('decision') if e.get('value') == f'retry-migration:{name}'])\n        last = next((e for e in reversed(self.j.find('refused', step)) if e['code'] != 'retry-precondition'), None)\n        if last and last.get('attempt') == attempt:\n            if self.decision != f'retry-migration:{name}' or last['code'] not in RETRIABLE:\n                self.refuse(last['code'], step, attempt=attempt)\n            if (self.ops.invalid_indexes() or self.ops.index_exists(indexes) or name in self.ops.ledger()\n                    or self.ops.index_builds() or self.migration_sessions() or self.running_migration_jobs()):\n                self.refuse('retry-precondition', step, attempt=attempt)\n            self.j.append('decision', value=self.decision, step=step, previous_attempt=attempt)\n            attempt += 1\n        job = f'{self.prefix}-mig-{index:02d}-a{attempt}'\n        app = f'pastorai-mig-{self.run12}-{index:02d}-a{attempt}'\n        if not self.ops.job_find(job) and not [e for e in self.j.find('job', step) if e['name'] == job]:\n            if name in self.ops.ledger():\n                self.refuse('ledger-ahead-of-journal', step, attempt=attempt)\n            if self.migration_sessions() or self.running_migration_jobs():\n                self.wait('migration-session-active', step, attempt=attempt)\n            self.check_scope(legacy_running=())\n            self.j.append('migration', step=step, attempt=attempt, job=job, app=app, concurrent=is_concurrent)\n        args = ['scripts/migrate.py', 'apply', name, '--yes', *(['--no-transaction'] if is_concurrent else [])]\n        identifier, code, _ = self.job(step, job, image=self.spec['candidate']['image'], args=args,\n                                       env={'MIGRATION_DATABASE_URL': self.dsn(), 'PGAPPNAME': app},\n                                       wait=self.t['migration_s'])\n        if [s for s in self.ops.pg_sessions() if s.get('app') == app] or app in self.ops.index_builds():\n            self.wait('migration-session-active', step, attempt=attempt)\n        applied = name in self.ops.ledger()\n        if code == 0 and applied:\n            self.j.append('done', step=step, attempt=attempt, job=identifier)\n            return\n        if applied:\n            self.refuse('migration-ambiguous-ledger-without-success', step, attempt=attempt)\n        if is_concurrent:\n            if self.ops.invalid_indexes():\n                self.refuse('concurrent-index-invalid', step, attempt=attempt, exit_code=code)\n            if self.ops.index_exists(indexes):\n                self.refuse('concurrent-index-present-ledger-absent', step, attempt=attempt, exit_code=code)\n            self.refuse('concurrent-failed-decision', step, attempt=attempt, exit_code=code)\n        self.refuse('migration-ambiguous-exit0-no-ledger' if code == 0 else 'migration-failed', step,\n                    attempt=attempt, exit_code=code)\n\n    def running_migration_jobs(self):\n        return [e['id'] for e in self.j.find('job') if e.get('step', '').startswith('migration:')\n                and ((self.ops.inspect(e['id']) or {}).get('State') or {}).get('Running')]\n\n    def verify_schema(self):\n        \"\"\"Candidate checker + catalogue vs the independent reference, fresh on every invocation.\"\"\"\n        manifest = self.manifest()\n        _, code, _ = self.script('checker', self.probe_name('schema-checker'), '/tmp/check_backend_schema.py',\n                                 'deploy/check_backend_schema.py',\n                                 env={'DATABASE_URL': self.dsn(), 'EXPECTED_MIGRATIONS': json.dumps(manifest)})\n        if code != 0:\n            self.refuse('candidate-checker', 'checker', exit_code=code)\n        module = base64.b64encode(zlib.compress(self.files()['deploy/schema_compatibility.py'], 9)).decode()\n        _, code, out = self.job('catalog', self.probe_name('catalog'), image=self.spec['candidate']['image'],\n                                args=['-I', '-c', CATALOG_PROBE, self.dsn(), module])\n        if code != 0 or not out.strip():\n            self.refuse('catalog-probe', 'catalog')\n        live, expected = json.loads(out.strip().splitlines()[-1]), self.spec['expected_catalog']\n        if live != expected:\n            self.refuse('catalog-drift', 'catalog', kinds=sorted(k for k in expected if live.get(k) != expected[k]))\n        self.j.append('done', step='schema', digest=canonical(live), invocation=self.inv)\n        self.phase('schema-verified')\n\n    # -- candidate side -------------------------------------------------------------\n    def candidate(self):\n        from initial_transition_candidate import run_candidate\n        run_candidate(self)\n\n    def promote(self):\n        from initial_transition_candidate import run_promote\n        run_promote(self)\n\n    def contain_candidate(self, reason):\n        from initial_transition_candidate import contain_candidate\n        contain_candidate(self, reason)\n\n    # -- entry points -----------------------------------------------------------------\n    def run(self, until=None):\n        if self.reached(TERMINAL):\n            self.refuse('legacy-resumed-terminal', 'run')\n        if self.j.find('intent', 'legacy-resume'):\n            # The decision to resume the legacy is exclusive and durable: only\n            # ``resume-legacy`` may continue; nothing here may move towards DDL.\n            self.refuse('legacy-resume-in-progress', 'run')\n        self.base_checks()  # a refusal here performs no containment either: the endpoint is untrusted\n        steps = (('observed', self.observe), ('contained', self.contain), ('settled', self.settle),\n                 ('reconciled', self.reconcile), ('preflighted', self.preflight), ('migrated', self.migrate),\n                 ('schema-verified', self.verify_schema), ('candidate-ready', self.candidate),\n                 ('promoted', self.promote))\n        try:\n            self.revalidate()\n            for name, function in steps:\n                if name == 'schema-verified' and self.reached('promoted'):\n                    continue\n                function()\n                if name == until:\n                    return name\n        except Refused as exc:\n            if (str(exc) not in WAIT_CODES | {'candidate-contained-decision-required'} and self.j.find('ddl-marker')\n                    and not self.reached('promoted') and self.candidate_ids()):\n                self.contain_candidate(str(exc))  # post-DDL: candidate stopped, never the legacy back\n            raise\n        return 'promoted'\n\n    def resume_token(self):\n        return f'RETOMAR-LEGADO-PRE-DDL:{self.spec[\"run_id\"]}:{self.j.digest()}'\n\n    def resume_legacy(self, confirmation, expected_token):\n        from initial_transition_resume import resume_legacy\n        resume_legacy(self, confirmation, expected_token)\n\n    def resume_preconditions(self):\n        from initial_transition_resume import resume_preconditions\n        resume_preconditions(self)\n\n\n# -- CLI ----------------------------------------------------------------------\ndef load_spec(path):\n    spec = json.loads(read_regular(path))\n    require(isinstance(spec, dict) and spec.get('version') == 1 and spec.get('synthetic') is True, 'spec')\n    require(re.fullmatch(r'[0-9a-f]{32}', spec.get('run_id', '')), 'spec')\n    require(spec.get('prefix') == 'pastorai-synthetic-transition-' + spec['run_id'][:12], 'spec-prefix')\n    require(SHA.fullmatch(spec['candidate']['sha']) and SHA.fullmatch(spec['legacy']['sha']), 'spec')\n    require(IMAGE_ID.fullmatch(spec['legacy']['image']) and IMAGE_ID.fullmatch(spec['candidate']['image']), 'spec')\n    require(DSN.fullmatch(spec['database']['dsn']), 'dsn-not-owned-alias')\n    require(all(RESOURCE_ID.fullmatch(i) for i in (*spec['support'].values(), *spec['network'].values(),\n                                                   *spec['legacy']['containers'].values())), 'spec-ids')\n    for key in ('release_root', 'repo'):\n        no_symlink(spec[key])\n    spec['_compose_bytes'] = read_regular(spec['candidate']['compose_file'])\n    require(sha256(spec['_compose_bytes']) == spec['candidate']['compose_sha256'], 'candidate-compose-changed')\n    return spec\n\n\ndef main(argv=None):\n    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])\n    sub = parser.add_subparsers(dest='command', required=True)\n    for name in ('run', 'status', 'resume-legacy'):\n        command = sub.add_parser(name)\n        command.add_argument('--spec', type=Path, required=True)\n        command.add_argument('--state', type=Path, required=True)\n        command.add_argument('--allow-probe', action='append', default=[])\n        if name == 'run':\n            command.add_argument('--until', choices=PHASES)\n            command.add_argument('--decision')\n            command.add_argument('--pause-at')\n        if name == 'resume-legacy':\n            command.add_argument('--confirm', required=True)\n            command.add_argument('--pause-at')\n    args = parser.parse_args(argv)\n    try:\n        spec = load_spec(args.spec)\n        journal = Journal(args.state).open()\n    except Refused as exc:\n        print(json.dumps({'status': 'refused', 'code': str(exc)}))\n        return EXIT_BUSY if str(exc) == 'controller-busy' else EXIT_USAGE\n    try:\n        return dispatch(args, spec, journal)\n    finally:\n        journal.close()\n\n\ndef dispatch(args, spec, journal):\n    digest = canonical({k: v for k, v in spec.items() if k != '_compose_bytes'})\n    init = journal.last('init')\n    if init is None:\n        journal.append('init', spec_sha256=digest, run_id=spec['run_id'])\n    elif init['spec_sha256'] != digest:\n        print(json.dumps({'status': 'refused', 'code': 'spec-changed'}))\n        return EXIT_USAGE\n    transition = Transition(spec, journal, DockerOps(spec), probes=args.allow_probe,\n                            decision=getattr(args, 'decision', None), pause_at=getattr(args, 'pause_at', None))\n    phases = lambda: [e['name'] for e in journal.find('phase')]\n    if args.command == 'status':\n        pre_ddl = not journal.find('ddl-marker') and transition.reached('contained')\n        print(json.dumps({'status': 'ok', 'phases': phases(), 'epoch': transition.epoch(),\n                          'last_refusal': (journal.last('refused') or {}).get('code'),\n                          'resume_token': transition.resume_token() if pre_ddl else None}, sort_keys=True))\n        return 0\n    expected_token = transition.resume_token()  # before this invocation is journaled\n    transition.inv = journal.append('invocation', command=args.command, probes=args.allow_probe,\n                                    decision=getattr(args, 'decision', None),\n                                    pause_at=getattr(args, 'pause_at', None))['seq']\n    try:\n        if args.command == 'run':\n            reached = transition.run(getattr(args, 'until', None))\n        else:\n            transition.resume_legacy(args.confirm, expected_token)\n            reached = TERMINAL\n    except Refused as exc:\n        code = str(exc)\n        print(json.dumps({'status': 'waiting' if code in WAIT_CODES else 'refused', 'code': code,\n                          'phases': phases(), 'epoch': transition.epoch()}))\n        return EXIT_WAIT if code in WAIT_CODES else EXIT_REFUSED\n    print(json.dumps({'status': 'ok', 'reached': reached, 'phases': phases()}))\n    return 0\n\n\nif __name__ == '__main__':\n    sys.path.insert(0, str(Path(__file__).resolve().parent))\n    sys.exit(main())\n","numLines":786,"startLine":1,"totalLines":786}},"tool_result_meta":[{"id":"toolu_01YSdZAHogiw6TxCgqkLM4UW","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
