{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgYdFSopAR6zb63tF32x4","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01YBSjo5x784uJtQiSrm2DQ5","name":"Read","input":{"file_path":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_host_driver.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9621,"cache_read_input_tokens":24876,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9621},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6f5f5b47-c66e-4591-b756-d99024a874c5","uuid":"9de2971d-98be-49e0-bac6-46ffa5ddce11","timestamp":"2026-10-30T15:03:42.405Z","request_id":"req_011CgYdFSRkNPunui5jLJoP2","wire_tool_inputs":{"toolu_01YBSjo5x784uJtQiSrm2DQ5":{"file_path":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_host_driver.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YBSjo5x784uJtQiSrm2DQ5","type":"tool_result","content":"1\t\"\"\"Observation/containment driver behind ObservedHostTransport (block A only).\n2\t\n3\t``ObservedHostDriver.request(argv, *, timeout)`` answers the transport's\n4\tsemantic commands from an injected runner plus explicit callbacks:\n5\t\n6\t* inspect-host: pinned daemon, pinned network and the seven pinned containers\n7\t  through restricted ``--format`` stdout projections to Python, plus both ingress entries and the\n8\t  unknown-writer callback;\n9\t* redis-meta: TYPE/PTTL/LLEN/ZCARD on explicit keys via ``redis-cli`` inside the\n10\t  pinned, label-verified Redis container; no KEYS/SCAN/values/auth in argv, and\n11\t  an auth error is a refusal;\n12\t* block-ingress, ``docker update --restart=no``, ``docker kill --signal=TERM``\n13\t  and ``docker wait`` on the four legacy IDs only.\n14\t\n15\tStart, restart=always, open-ingress and every other operation refuse before\n16\tany runner call. Ingress/writer values are callback-reported scope-bound\n17\tanswers, not independent proof, and no token or boolean stands for a human\n18\tapproval. Docker values are CLI-reported for an operator-configured endpoint;\n19\tnothing here certifies the host or quiescence. The real ingress mechanism,\n20\twriter sources and manifest values are still pending the owner's answer.\n21\t\n22\tThe Docker CLI is a trusted child: it receives full Engine API metadata,\n23\tincluding Env/health fields, before applying --format CLIENT-SIDE. Only its\n24\trestricted stdout projection enters Python/journals. This is NOT a claim that\n25\tno process reads complete inspect metadata. Real operation needs explicit\n26\tapproval of that boundary or an approved projected-metadata source; currently\n27\tonly synthetic data is used and no Docker CLI is run.\n28\t\n29\tErrors carry fixed codes only; runner output never enters exceptions, logs or\n30\treceipts. No retry: a timeout or refusal is final for that request. Each\n31\trequest has a cooperative deadline, checked after injected calls return; per-command output caps are acceptance limits.\n32\tPopenRunner reads at most cap + 1 byte; joining buffers temporarily duplicates\n33\tthat bounded storage (plus Python overhead), so this is not a cap on process RSS; an\n34\tinjected runner's own buffering is its responsibility. Nothing runs at import\n35\tor construction; there is no command-line entry point.\n36\t\"\"\"\n37\tfrom __future__ import annotations\n38\t\n39\tfrom collections.abc import Mapping\n40\tfrom dataclasses import dataclass\n41\timport json\n42\timport os\n43\timport re\n44\timport select\n45\timport subprocess\n46\timport time\n47\t\n48\tfrom first_transition_adapter import ROLES, digest\n49\tfrom first_transition_host_transport import SUPPORT_ROLES, _ids, host_command\n50\tfrom initial_transition_ops import Refused, require\n51\t\n52\tSCHEMA = 'igreja12.first-transition-host-manifest/1'\n53\tMANIFEST_KEYS = frozenset({'schema', 'daemon_id', 'legacy_project', 'network_id', 'service_ids', 'support_ids',\n54\t                           'processing_keys', 'gate_names'})\n55\tENTRIES = ('external', 'evolution-backend')\n56\tQUEUE_KEYS = ('pastorai:webhooks', 'pastorai:webhooks:processing', 'pastorai:webhooks:dead',\n57\t              'pastorai:webhooks:retry-scheduled')\n58\tREDIS_COMMANDS = ('TYPE', 'PTTL', 'LLEN', 'ZCARD')\n59\tREDIS_TYPES = ('none', 'string', 'list', 'set', 'zset', 'hash', 'stream')\n60\tEFFECTS = ('restart-no', 'term', 'wait')\n61\t# Acceptance caps (bytes of stdout) per command; also PopenRunner's memory bound.\n62\tLIMITS = dict(info=256, network=1024, inspect=64 * 1024, redis=64, effect=256, wait=16)\n63\tMAX_OUTPUT = 1024 * 1024\n64\t\n65\tHEX64 = re.compile('[0-9a-f]{64}')\n66\tDAEMON = re.compile('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[A-Z0-9]{4}(?::[A-Z0-9]{4}){11}')\n67\tPROJECT = re.compile(r'[A-Za-z0-9_-]{1,63}')\n68\tPROCESSING = re.compile(r'pastorai:webhooks:processing:[A-Za-z0-9_-]{1,80}')\n69\tMANDATORY_GATES = ('ALLOW_REAL_SENDS', 'ASAAS_BILLING_ENABLED', 'BREVO_SEND_MODE', 'BROADCAST_ASYNC_ENABLED')\n70\tNETWORK_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,127}')\n71\tIMAGE = re.compile('sha256:[0-9a-f]{64}')\n72\tSTARTED = re.compile(r'[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})')\n73\tSTATUSES = ('created', 'running', 'exited')\n74\tHEALTH = ('starting', 'healthy', 'unhealthy')\n75\tRUNNER_CODES = frozenset({'runner-argv', 'runner-bounds', 'runner-spawn-failed', 'runner-output-oversize',\n76\t                          'runner-close-failed', 'runner-failed', 'runner-pending-cli'})\n77\tPROJECT_LABEL = 'com.docker.compose.project'\n78\tSERVICE_LABEL = 'com.docker.compose.service'\n79\tREVISION_LABEL = 'org.opencontainers.image.revision'\n80\tINFO_ARGV = ('docker', 'info', '--format', '{{json .ID}}')\n81\tNETWORK_TEMPLATE = '[{{json .Id}},{{json .Name}}]'\n82\t\n83\t\n84\tdef _gate_names(names):\n85\t    require(isinstance(names, (list, tuple)) and len(names) == len(MANDATORY_GATES)\n86\t            and all(isinstance(n, str) for n in names) and set(names) == set(MANDATORY_GATES),\n87\t            'manifest-gate-names')\n88\t    return tuple(sorted(names))\n89\t\n90\t\n91\tdef _label(key):\n92\t    # A nil label map prints null and a missing key prints \"\"; both normalize to None.\n93\t    return '{{with .Config.Labels}}{{json (index . \"' + key + '\")}}{{else}}null{{end}}'\n94\t\n95\t\n96\tdef inspect_template(gate_names):\n97\t    \"\"\"One JSON array per container; the trusted Docker CLI filters env by name before stdout.\"\"\"\n98\t    quoted = ' '.join('\"' + name + '\"' for name in _gate_names(gate_names))\n99\t    return ('[{{json .Id}},{{json .Image}},' + ','.join(_label(k) for k in (\n100\t            PROJECT_LABEL, SERVICE_LABEL, REVISION_LABEL)) + ','\n101\t            '{{json .State.Status}},{{json .State.Running}},{{json .State.Paused}},{{json .State.Restarting}},'\n102\t            '{{json .State.ExitCode}},{{json .State.StartedAt}},'\n103\t            '{{with .State.Health}}{{json .Status}}{{else}}null{{end}},'\n104\t            '{{json .RestartCount}},{{json .HostConfig.RestartPolicy.Name}},{{json .HostConfig.NetworkMode}},'\n105\t            '[{{range .Config.Env}}{{if eq (index (split . \"=\") 0) ' + quoted + '}}{{json .}},{{end}}{{end}}null],'\n106\t            '[{{range .Mounts}}[{{json .Type}},{{json .Name}},{{json .Source}},{{json .Destination}},'\n107\t            '{{json .RW}}],{{end}}null],'\n108\t            '[{{range $name, $net := .NetworkSettings.Networks}}[{{json $name}},{{json $net.Aliases}},'\n109\t            '{{json $net.NetworkID}}],{{end}}null]]')\n110\t\n111\t\n112\t@dataclass(frozen=True)\n113\tclass HostManifest:\n114\t    \"\"\"Sanitized, immutable scope; unknown keys (e.g. any secret) are refused.\"\"\"\n115\t    daemon_id: str\n116\t    legacy_project: str\n117\t    network_id: str\n118\t    service_ids: tuple\n119\t    support_ids: tuple\n120\t    processing_keys: tuple\n121\t    gate_names: tuple\n122\t    digest: str\n123\t\n124\t    @classmethod\n125\t    def from_dict(cls, data):\n126\t        require(isinstance(data, Mapping) and set(data) == MANIFEST_KEYS, 'manifest-keys')\n127\t        require(data['schema'] == SCHEMA, 'manifest-schema')\n128\t        require(isinstance(data['daemon_id'], str) and DAEMON.fullmatch(data['daemon_id']), 'manifest-daemon')\n129\t        require(isinstance(data['legacy_project'], str) and PROJECT.fullmatch(data['legacy_project']),\n130\t                'manifest-project')\n131\t        services, support = data['service_ids'], data['support_ids']\n132\t        require(_ids(services, ROLES) and _ids(support, SUPPORT_ROLES)\n133\t                and not set(services.values()) & set(support.values()), 'manifest-identities')\n134\t        require(isinstance(data['network_id'], str) and HEX64.fullmatch(data['network_id'])\n135\t                and data['network_id'] not in {*services.values(), *support.values()}, 'manifest-network')\n136\t        keys = data['processing_keys']\n137\t        require(isinstance(keys, (list, tuple)) and len(keys) <= 64 and all(isinstance(k, str) and PROCESSING.fullmatch(k) for k in keys)\n138\t                and len(set(keys)) == len(keys), 'manifest-processing-keys')\n139\t        values = dict(daemon_id=data['daemon_id'], legacy_project=data['legacy_project'],\n140\t                      network_id=data['network_id'], service_ids=tuple((r, services[r]) for r in ROLES),\n141\t                      support_ids=tuple((r, support[r]) for r in SUPPORT_ROLES), processing_keys=tuple(keys),\n142\t                      gate_names=_gate_names(data['gate_names']))\n143\t        return cls(**values, digest=digest([SCHEMA, values]))\n144\t\n145\t    def validated(self):\n146\t        require(all(type(v) is tuple for v in (\n147\t            self.service_ids, self.support_ids, self.processing_keys, self.gate_names)), 'manifest-values')\n148\t        ok, canonical = _attempt(type(self).from_dict, {\n149\t            'schema': SCHEMA, 'daemon_id': self.daemon_id, 'legacy_project': self.legacy_project,\n150\t            'network_id': self.network_id, 'service_ids': dict(self.service_ids),\n151\t            'support_ids': dict(self.support_ids), 'processing_keys': self.processing_keys,\n152\t            'gate_names': self.gate_names})\n153\t        require(ok and self == canonical, 'manifest-integrity')\n154\t        return canonical\n155\t\n156\t    def transport_scope(self):\n157\t        return dict(legacy_project=self.legacy_project, network_id=self.network_id,\n158\t                    service_ids=dict(self.service_ids), support_ids=dict(self.support_ids),\n159\t                    processing_keys=self.processing_keys)\n160\t\n161\t\n162\tdef _strict_json(text):\n163\t    def constant(_):\n164\t        raise ValueError('constant')\n165\t    return json.loads(text, parse_constant=constant)\n166\t\n167\t\n168\tdef _lines(out):\n169\t    text = out.decode('utf-8')\n170\t    if not text.endswith('\\n'):\n171\t        raise ValueError('unterminated')\n172\t    return [_strict_json(line) for line in text[:-1].split('\\n')]\n173\t\n174\t\n175\tdef _attempt(function, *args):\n176\t    # The failure is reported after the except block: no exception context can\n177\t    # carry runner output into a later traceback.\n178\t    try:\n179\t        return True, function(*args)\n180\t    except (ValueError, UnicodeDecodeError, RecursionError, TypeError):\n181\t        return False, None\n182\t\n183\t\n184\tdef _tail(value, code):\n185\t    require(isinstance(value, list) and value and value[-1] is None, code)\n186\t    return value[:-1]\n187\t\n188\t\n189\tclass ObservedHostDriver:\n190\t    mode = 'observed-host'\n191\t    supports_resume = False\n192\t\n193\t    def __init__(self, manifest, *, runner, ingress, writers):\n194\t        require(isinstance(manifest, HostManifest), 'driver-manifest')\n195\t        manifest = manifest.validated()\n196\t        require(callable(runner), 'driver-runner')\n197\t        require(isinstance(ingress, Mapping) and set(ingress) == set(ENTRIES)\n198\t                and ingress['external'] is not ingress['evolution-backend']\n199\t                and all(self._bound(ingress[e], manifest, e, 'observe', 'block') for e in ENTRIES),\n200\t                'driver-ingress-binding')\n201\t        require(self._bound(writers, manifest, None, 'observe'), 'driver-writer-binding')\n202\t        self.manifest, self.runner = manifest, runner\n203\t        self.ingress, self.writers = dict(ingress), writers\n204\t        self.template = inspect_template(manifest.gate_names)\n205\t        self.roles = {ident: role for role, ident in (*manifest.service_ids, *manifest.support_ids)}\n206\t        self.legacy = tuple(ident for _, ident in manifest.service_ids)\n207\t        self.redis_id = dict(manifest.support_ids)['redis']\n208\t        self.redis_verified = False\n209\t        self.refusals = []  # fixed codes only, for diagnosis; never output\n210\t        self._bindings_fixed = (self.ingress['external'], self.ingress['evolution-backend'], self.writers)\n211\t\n212\t    @staticmethod\n213\t    def _bound(binding, manifest, entry, *methods):\n214\t        return (binding is not None and getattr(binding, 'scope', None) == manifest.digest\n215\t                and (entry is None or getattr(binding, 'entry', None) == entry)\n216\t                and all(callable(getattr(binding, method, None)) for method in methods))\n217\t\n218\t    def transport_scope(self):\n219\t        return self.manifest.transport_scope()\n220\t\n221\t    def request(self, argv, *, timeout):\n222\t        try:\n223\t            self._assert_bindings()\n224\t            result = self._dispatch(argv, timeout)\n225\t            self._assert_bindings()\n226\t            return result\n227\t        except Refused as exc:\n228\t            self.refusals = [*self.refusals[-63:], str(exc)]\n229\t            raise\n230\t\n231\t    def _assert_bindings(self):\n232\t        require(isinstance(self.ingress, dict) and set(self.ingress) == set(ENTRIES), 'driver-ingress-binding')\n233\t        for index, entry in enumerate(ENTRIES):\n234\t            require(self.ingress[entry] is self._bindings_fixed[index]\n235\t                    and self._bound(self.ingress[entry], self.manifest, entry, 'observe', 'block'),\n236\t                    'driver-ingress-binding')\n237\t        require(self.writers is self._bindings_fixed[2]\n238\t                and self._bound(self.writers, self.manifest, None, 'observe'), 'driver-writer-binding')\n239\t\n240\t    def _dispatch(self, argv, timeout):\n241\t        require(type(timeout) in (int, float) and 0 < timeout <= 30, 'driver-timeout-bound')\n242\t        require(type(argv) is tuple and argv and all(type(a) is str for a in argv), 'driver-operation-forbidden')\n243\t        deadline = time.monotonic() + timeout\n244\t        if argv == ('inspect-host',):\n245\t            return self._inspect_host(deadline)\n246\t        if argv[0] == 'redis-meta':\n247\t            require(len(argv) == 3 and argv[1] in REDIS_COMMANDS\n248\t                    and argv[2] in QUEUE_KEYS + self.manifest.processing_keys, 'driver-redis-scope')\n249\t            return self._redis_meta(argv[1], argv[2], deadline)\n250\t        if argv == ('block-ingress',):\n251\t            return self._block_ingress(deadline)\n252\t        for kind in EFFECTS:\n253\t            for ident in self.legacy:\n254\t                if argv == host_command(kind, ident):\n255\t                    return self._effect(kind, ident, argv, deadline)\n256\t        raise Refused('driver-operation-forbidden')\n257\t\n258\t    @staticmethod\n259\t    def _remaining(deadline):\n260\t        remaining = deadline - time.monotonic()\n261\t        if remaining <= 0:\n262\t            raise TimeoutError('driver-timeout')\n263\t        return remaining\n264\t\n265\t    def _run(self, argv, deadline, limit):\n266\t        outcome = None\n267\t        try:\n268\t            result = self.runner(argv, timeout=self._remaining(deadline), max_output=limit)\n269\t        except TimeoutError:\n270\t            outcome = 'timeout'\n271\t        except Refused as exc:\n272\t            outcome = str(exc) if str(exc) in RUNNER_CODES else 'driver-runner-failed'\n273\t        except Exception:\n274\t            outcome = 'driver-runner-failed'\n275\t        if outcome == 'timeout':\n276\t            raise TimeoutError('driver-timeout')\n277\t        require(outcome is None, outcome)\n278\t        require(isinstance(result, tuple) and len(result) == 2 and type(result[0]) is int\n279\t                and type(result[1]) is bytes, 'driver-runner-failed')\n280\t        self._remaining(deadline)\n281\t        self._assert_bindings()\n282\t        require(len(result[1]) <= limit, 'driver-output-oversize')\n283\t        return result\n284\t\n285\t    def _callback(self, binding, method, deadline, entry, code):\n286\t        require(self._bound(binding, self.manifest, entry, method), code)\n287\t        outcome = None\n288\t        try:\n289\t            value = getattr(binding, method)(self.manifest.digest, timeout=self._remaining(deadline))\n290\t        except TimeoutError:\n291\t            outcome = 'timeout'\n292\t        except Exception:\n293\t            outcome = 'driver-binding-failed'\n294\t        if outcome == 'timeout':\n295\t            raise TimeoutError('driver-timeout')\n296\t        self._remaining(deadline)\n297\t        require(self._bound(binding, self.manifest, entry, method), code)\n298\t        self._assert_bindings()\n299\t        require(outcome is None, outcome)\n300\t        return value\n301\t\n302\t    def _daemon(self, deadline):\n303\t        rc, out = self._run(INFO_ARGV, deadline, LIMITS['info'])\n304\t        require(rc == 0, 'driver-daemon-failed')\n305\t        ok, value = _attempt(_lines, out)\n306\t        require(ok and len(value) == 1 and isinstance(value[0], str) and DAEMON.fullmatch(value[0]),\n307\t                'driver-daemon-malformed')\n308\t        require(value[0] == self.manifest.daemon_id, 'driver-daemon-mismatch')\n309\t\n310\t    def _network(self, deadline):\n311\t        rc, out = self._run(('docker', 'network', 'inspect', '--format', NETWORK_TEMPLATE, self.manifest.network_id),\n312\t                            deadline, LIMITS['network'])\n313\t        require(rc == 0, 'driver-network-failed')\n314\t        ok, value = _attempt(_lines, out)\n315\t        require(ok and len(value) == 1 and isinstance(value[0], list) and len(value[0]) == 2\n316\t                and all(isinstance(v, str) for v in value[0]) and HEX64.fullmatch(value[0][0])\n317\t                and NETWORK_NAME.fullmatch(value[0][1]), 'driver-network-malformed')\n318\t        require(value[0][0] == self.manifest.network_id, 'driver-network-mismatch')\n319\t        return value[0]\n320\t\n321\t    def _ingress(self, deadline):\n322\t        states = {}\n323\t        for entry in ENTRIES:\n324\t            value = self._callback(self.ingress[entry], 'observe', deadline, entry, 'driver-ingress-binding')\n325\t            require(type(value) is str and value in ('blocked', 'open'), 'driver-ingress-shape')\n326\t            states[entry] = value\n327\t        return states\n328\t\n329\t    def _row(self, row, network_name):\n330\t        (ident, image, project, service, revision, status, running, paused, restarting, exit_code, started,\n331\t         health, restarts, policy, mode, gates, mounts, networks) = row\n332\t        labels = [None if value in (None, '') else value for value in (project, service, revision)]\n333\t        require(all(v is None or isinstance(v, str) and len(v) <= 128 for v in labels), 'driver-inspect-labels')\n334\t        require(isinstance(image, str) and IMAGE.fullmatch(image) and type(running) is bool\n335\t                and isinstance(status, str) and status in STATUSES and running == (status == 'running')\n336\t                and paused is False and restarting is False\n337\t                and type(exit_code) is int and 0 <= exit_code <= 255\n338\t                and isinstance(started, str) and STARTED.fullmatch(started)\n339\t                and (health is None or isinstance(health, str) and health in HEALTH)\n340\t                and type(restarts) is int and 0 <= restarts <= 10**6\n341\t                and isinstance(policy, str) and policy in ('always', 'no', '')\n342\t                and isinstance(mode, str) and len(mode) <= 128, 'driver-inspect-state')\n343\t        gates = _tail(gates, 'driver-inspect-gates')\n344\t        names = [g.split('=', 1)[0] if isinstance(g, str) and '=' in g else None for g in gates]\n345\t        require(all(n in self.manifest.gate_names for n in names) and len(set(names)) == len(names)\n346\t                and all(len(g) <= 512 for g in gates), 'driver-inspect-gates')\n347\t        mounts = _tail(mounts, 'driver-inspect-mounts')\n348\t        require(len(mounts) <= 64 and all(\n349\t            isinstance(m, list) and len(m) == 5 and type(m[4]) is bool\n350\t            and all(v is None or isinstance(v, str) and len(v) <= 4096 for v in m[:4]) for m in mounts),\n351\t            'driver-inspect-mounts')\n352\t        networks = _tail(networks, 'driver-inspect-networks')\n353\t        require(len(networks) <= 16 and all(\n354\t            isinstance(n, list) and len(n) == 3 and isinstance(n[0], str) and NETWORK_NAME.fullmatch(n[0])\n355\t            and (n[1] is None or isinstance(n[1], list) and all(isinstance(a, str) for a in n[1]))\n356\t            and isinstance(n[2], str) and HEX64.fullmatch(n[2]) for n in networks)\n357\t            and len({n[0] for n in networks}) == len(networks), 'driver-inspect-networks')\n358\t        require(network_name in {n[0] for n in networks}, 'driver-network-detached')\n359\t        require(any(n[0] == network_name and n[2] == self.manifest.network_id for n in networks),\n360\t                'driver-network-mismatch')\n361\t        # Stable configuration only: attachments by name/ID with configured aliases; IPAM is operational on some engines,\n362\t        # never IP, endpoint, gateway or MAC, which Docker clears on stop.\n363\t        attachments = [[n[0], sorted(n[1] or []), n[2]] for n in sorted(networks, key=lambda n: n[0])]\n364\t        return dict(\n365\t            id=ident, image=image, compose_project=labels[0], compose_service=labels[1], revision=labels[2],\n366\t            started=started, restart_count=restarts, restart_policy=policy or 'no', running=running,\n367\t            exit_code=None if running else exit_code, health=health,\n368\t            gates_digest=digest(['gates', sorted(gates)]),\n369\t            mounts_digest=digest(['mounts', sorted(mounts, key=json.dumps)]),\n370\t            networks_digest=digest(['networks', mode, attachments]))\n371\t\n372\t    def _inspect_host(self, deadline):\n373\t        self.redis_verified = False\n374\t        self._daemon(deadline)\n375\t        network_id, network_name = self._network(deadline)\n376\t        ids = tuple(self.roles)\n377\t        rc, out = self._run(('docker', 'inspect', '--type', 'container', '--format', self.template, *ids),\n378\t                            deadline, LIMITS['inspect'])\n379\t        require(rc == 0, 'driver-inspect-failed')\n380\t        ok, rows = _attempt(_lines, out)\n381\t        require(ok and all(isinstance(r, list) and len(r) == 18 and isinstance(r[0], str) for r in rows),\n382\t                'driver-inspect-malformed')\n383\t        require(len(rows) == len(ids) and {r[0] for r in rows} == set(ids), 'driver-inspect-scope')\n384\t        services, support = {}, {}\n385\t        for row in rows:\n386\t            state, role = self._row(row, network_name), self.roles[row[0]]\n387\t            if role in ROLES:\n388\t                state.pop('health')\n389\t                services[role] = state\n390\t            else:\n391\t                support[role] = {key: state[key] for key in (\n392\t                    'id', 'image', 'compose_project', 'compose_service', 'running', 'restart_policy', 'health',\n393\t                    'networks_digest')}\n394\t        ingress = self._ingress(deadline)\n395\t        writers = self._callback(self.writers, 'observe', deadline, None, 'driver-writer-binding')\n396\t        require(type(writers) is int and 0 <= writers <= 10**6, 'driver-writer-shape')\n397\t        redis = support['redis']\n398\t        self.redis_verified = (redis['compose_project'] == self.manifest.legacy_project\n399\t                               and redis['compose_service'] == 'redis' and redis['running'] is True)\n400\t        return dict(scope_digest=self.manifest.digest,\n401\t                    ingress_blocked=all(v == 'blocked' for v in ingress.values()), unknown_writers=writers,\n402\t                    network_id=network_id, services=services, support=support)\n403\t\n404\t    def _redis_meta(self, command, key, deadline):\n405\t        # Only into the Redis container this driver just verified by label; no auth in argv.\n406\t        require(self.redis_verified, 'driver-redis-unverified')\n407\t        self._daemon(deadline)\n408\t        rc, out = self._run(('docker', 'exec', self.redis_id, 'redis-cli', '--raw', command, key),\n409\t                            deadline, LIMITS['redis'])\n410\t        ok, text = _attempt(bytes.decode, out, 'ascii')\n411\t        require(ok, 'driver-redis-output')\n412\t        require(not text.startswith(('NOAUTH', 'WRONGPASS', 'NOPERM')), 'driver-redis-auth-required')\n413\t        require(rc == 0, 'driver-redis-failed')\n414\t        require(text.endswith('\\n'), 'driver-redis-output')\n415\t        value = text[:-1]\n416\t        if command == 'TYPE':\n417\t            require(value in REDIS_TYPES, 'driver-redis-output')\n418\t            return value\n419\t        require(re.fullmatch('-?[0-9]{1,19}', value), 'driver-redis-output')\n420\t        return int(value)\n421\t\n422\t    def _block_ingress(self, deadline):\n423\t        # Both entries are checked; one blocked entry never stands for the other.\n424\t        for entry, state in self._ingress(deadline).items():\n425\t            if state == 'open':\n426\t                require(self._callback(self.ingress[entry], 'block', deadline, entry,\n427\t                                       'driver-ingress-binding') is True, 'driver-ingress-receipt')\n428\t        require(all(v == 'blocked' for v in self._ingress(deadline).values()), 'driver-ingress-still-open')\n429\t        return True\n430\t\n431\t    def _effect(self, kind, ident, argv, deadline):\n432\t        self._daemon(deadline)\n433\t        if kind == 'wait':\n434\t            rc, out = self._run(argv, deadline, LIMITS['wait'])\n435\t            ok, text = _attempt(bytes.decode, out, 'ascii')\n436\t            require(ok and rc == 0 and re.fullmatch('[0-9]{1,3}\\n', text), 'driver-wait-receipt')\n437\t            return int(text)\n438\t        rc, out = self._run(argv, deadline, LIMITS['effect'])\n439\t        require(rc == 0 and out == (ident + '\\n').encode(), 'driver-effect-receipt')\n440\t        return True\n441\t\n442\t\n443\tGLOBAL_FLAGS = frozenset({'-H', '--host', '--context', '-c', '--config', '--tls', '--tlsverify', '--tlscacert',\n444\t                          '--tlscert', '--tlskey', '-D', '--debug', '-l', '--log-level'})\n445\tENV = {'LC_ALL': 'C', 'LANG': 'C'}\n446\tABS_PATH = re.compile('/[A-Za-z0-9._/-]{1,255}')\n447\t\n448\t\n449\tdef _absolute(path):\n450\t    return (isinstance(path, str) and ABS_PATH.fullmatch(path) is not None\n451\t            and all(part not in ('', '.', '..') for part in path[1:].split('/')))\n452\t\n453\t\n454\tdef _runner_argv(argv):\n455\t    if not (type(argv) is tuple and 2 <= len(argv) <= 32 and argv[0] == 'docker'\n456\t            and all(type(a) is str and 0 < len(a) <= 16384 and '\\x00' not in a for a in argv)):\n457\t        return False\n458\t    if argv == INFO_ARGV:\n459\t        return True\n460\t    if len(argv) == 6 and argv[:5] == ('docker', 'network', 'inspect', '--format', NETWORK_TEMPLATE):\n461\t        return HEX64.fullmatch(argv[5]) is not None\n462\t    if 7 <= len(argv) <= 13 and argv[:6] == (\n463\t            'docker', 'inspect', '--type', 'container', '--format', inspect_template(MANDATORY_GATES)):\n464\t        return all(HEX64.fullmatch(i) for i in argv[6:]) and len(set(argv[6:])) == len(argv[6:])\n465\t    if len(argv) == 7 and argv[:2] == ('docker', 'exec'):\n466\t        return (HEX64.fullmatch(argv[2]) is not None and argv[3:5] == ('redis-cli', '--raw')\n467\t                and argv[5] in REDIS_COMMANDS and (argv[6] in QUEUE_KEYS or PROCESSING.fullmatch(argv[6])))\n468\t    if len(argv) == 4 and argv[:3] in (('docker', 'update', '--restart=no'),\n469\t                                     ('docker', 'kill', '--signal=TERM')):\n470\t        return HEX64.fullmatch(argv[3]) is not None\n471\t    return len(argv) == 3 and argv[:2] == ('docker', 'wait') and HEX64.fullmatch(argv[2]) is not None\n472\t\n473\t\n474\tclass PopenRunner:\n475\t    \"\"\"Bounded docker CLI runner for a future authorized operator; never used by tests unmocked.\n476\t\n477\t    The endpoint (``unix://`` socket), docker binary and an operator-provided\n478\t    config directory are explicit; the child gets a minimal environment, so no\n479\t    inherited DOCKER_HOST/DOCKER_CONTEXT/credentials/HOME apply. Only block-A\n480\t    read/containment subcommands are accepted. On timeout, oversize or error it\n481\t    ends only its own CLI process, waits at most ``cleanup_wait`` and never\n482\t    retries; an unreaped CLI is counted, not escalated. Killing the CLI does not\n483\t    undo a request the daemon already received. Compatibility with a real\n484\t    Docker CLI/daemon is unverified here.\n485\t    \"\"\"\n486\t\n487\t    def __init__(self, *, docker_binary, endpoint, config_dir, popen=None, cleanup_wait=2.0, chunk=4096):\n488\t        require(_absolute(docker_binary) and docker_binary.endswith('/docker')\n489\t                and isinstance(endpoint, str) and endpoint.startswith('unix://')\n490\t                and _absolute(endpoint[len('unix://'):]) and endpoint.endswith('.sock')\n491\t                and _absolute(config_dir) and (popen is None or callable(popen))\n492\t                and type(cleanup_wait) in (int, float) and 0 < cleanup_wait <= 10\n493\t                and type(chunk) is int and 0 < chunk <= 65536, 'runner-config')\n494\t        self.docker_binary, self.endpoint, self.config_dir = docker_binary, endpoint, config_dir\n495\t        self.popen, self.cleanup_wait, self.chunk = popen, cleanup_wait, chunk\n496\t        self.unreaped = 0\n497\t\n498\t    def __call__(self, argv, *, timeout, max_output):\n499\t        require(self.unreaped == 0, 'runner-pending-cli')\n500\t        require(_runner_argv(argv), 'runner-argv')\n501\t        require(type(timeout) in (int, float) and 0 < timeout <= 60\n502\t                and type(max_output) is int and 0 < max_output <= MAX_OUTPUT, 'runner-bounds')\n503\t        deadline = time.monotonic() + timeout\n504\t        popen = self.popen or subprocess.Popen  # resolved per call, never at import/construction\n505\t        command = [self.docker_binary, '--config', self.config_dir, '--host', self.endpoint, *argv[1:]]\n506\t        proc = None\n507\t        try:\n508\t            proc = popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,\n509\t                         env=dict(ENV), cwd='/', close_fds=True, shell=False, start_new_session=True)\n510\t        except Exception:\n511\t            pass\n512\t        require(proc is not None, 'runner-spawn-failed')\n513\t        outcome = 'runner-failed'\n514\t        try:\n515\t            out = self._read(proc, deadline, max_output)\n516\t            rc = proc.wait(timeout=max(deadline - time.monotonic(), 0))\n517\t            outcome = None\n518\t        except (TimeoutError, subprocess.TimeoutExpired):\n519\t            outcome = 'timeout'\n520\t        except Refused as exc:\n521\t            outcome = str(exc)\n522\t        except Exception:\n523\t            pass\n524\t        except BaseException:\n525\t            self._cleanup(proc)\n526\t            raise\n527\t        finally:\n528\t            try:\n529\t                proc.stdout.close()\n530\t            except Exception:\n531\t                if outcome is None:\n532\t                    outcome = 'runner-close-failed'\n533\t        if outcome is None and time.monotonic() > deadline:\n534\t            outcome = 'timeout'\n535\t        if outcome is not None:\n536\t            self._cleanup(proc)\n537\t            if outcome == 'timeout':\n538\t                raise TimeoutError('runner-timeout')\n539\t            raise Refused(outcome)\n540\t        return rc, out\n541\t\n542\t    def _read(self, proc, deadline, limit):\n543\t        fd, chunks, size = proc.stdout.fileno(), [], 0\n544\t        while True:\n545\t            remaining = deadline - time.monotonic()\n546\t            if remaining <= 0 or not select.select([fd], [], [], remaining)[0]:\n547\t                raise TimeoutError('runner-timeout')\n548\t            chunk = os.read(fd, min(self.chunk, limit + 1 - size))\n549\t            if not chunk:\n550\t                return b''.join(chunks)\n551\t            size += len(chunk)\n552\t            chunks.append(chunk)\n553\t            require(size <= limit, 'runner-output-oversize')\n554\t\n555\t    def _cleanup(self, proc):\n556\t        # Ends only this runner's own CLI child; never a container, never a retry.\n557\t        try:\n558\t            if proc.poll() is None:\n559\t                proc.kill()\n560\t            proc.wait(timeout=self.cleanup_wait)\n561\t        except Exception:\n562\t            self.unreaped += 1\n563\t"}]},"parent_tool_use_id":null,"session_id":"6f5f5b47-c66e-4591-b756-d99024a874c5","uuid":"2e2d17de-dafe-4897-a11a-920f45c0702c","timestamp":"2026-10-30T15:03:42.745Z","tool_use_result":{"type":"text","file":{"filePath":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_host_driver.py","content":"\"\"\"Observation/containment driver behind ObservedHostTransport (block A only).\n\n``ObservedHostDriver.request(argv, *, timeout)`` answers the transport's\nsemantic commands from an injected runner plus explicit callbacks:\n\n* inspect-host: pinned daemon, pinned network and the seven pinned containers\n  through restricted ``--format`` stdout projections to Python, plus both ingress entries and the\n  unknown-writer callback;\n* redis-meta: TYPE/PTTL/LLEN/ZCARD on explicit keys via ``redis-cli`` inside the\n  pinned, label-verified Redis container; no KEYS/SCAN/values/auth in argv, and\n  an auth error is a refusal;\n* block-ingress, ``docker update --restart=no``, ``docker kill --signal=TERM``\n  and ``docker wait`` on the four legacy IDs only.\n\nStart, restart=always, open-ingress and every other operation refuse before\nany runner call. Ingress/writer values are callback-reported scope-bound\nanswers, not independent proof, and no token or boolean stands for a human\napproval. Docker values are CLI-reported for an operator-configured endpoint;\nnothing here certifies the host or quiescence. The real ingress mechanism,\nwriter sources and manifest values are still pending the owner's answer.\n\nThe Docker CLI is a trusted child: it receives full Engine API metadata,\nincluding Env/health fields, before applying --format CLIENT-SIDE. Only its\nrestricted stdout projection enters Python/journals. This is NOT a claim that\nno process reads complete inspect metadata. Real operation needs explicit\napproval of that boundary or an approved projected-metadata source; currently\nonly synthetic data is used and no Docker CLI is run.\n\nErrors carry fixed codes only; runner output never enters exceptions, logs or\nreceipts. No retry: a timeout or refusal is final for that request. Each\nrequest has a cooperative deadline, checked after injected calls return; per-command output caps are acceptance limits.\nPopenRunner reads at most cap + 1 byte; joining buffers temporarily duplicates\nthat bounded storage (plus Python overhead), so this is not a cap on process RSS; an\ninjected runner's own buffering is its responsibility. Nothing runs at import\nor construction; there is no command-line entry point.\n\"\"\"\nfrom __future__ import annotations\n\nfrom collections.abc import Mapping\nfrom dataclasses import dataclass\nimport json\nimport os\nimport re\nimport select\nimport subprocess\nimport time\n\nfrom first_transition_adapter import ROLES, digest\nfrom first_transition_host_transport import SUPPORT_ROLES, _ids, host_command\nfrom initial_transition_ops import Refused, require\n\nSCHEMA = 'igreja12.first-transition-host-manifest/1'\nMANIFEST_KEYS = frozenset({'schema', 'daemon_id', 'legacy_project', 'network_id', 'service_ids', 'support_ids',\n                           'processing_keys', 'gate_names'})\nENTRIES = ('external', 'evolution-backend')\nQUEUE_KEYS = ('pastorai:webhooks', 'pastorai:webhooks:processing', 'pastorai:webhooks:dead',\n              'pastorai:webhooks:retry-scheduled')\nREDIS_COMMANDS = ('TYPE', 'PTTL', 'LLEN', 'ZCARD')\nREDIS_TYPES = ('none', 'string', 'list', 'set', 'zset', 'hash', 'stream')\nEFFECTS = ('restart-no', 'term', 'wait')\n# Acceptance caps (bytes of stdout) per command; also PopenRunner's memory bound.\nLIMITS = dict(info=256, network=1024, inspect=64 * 1024, redis=64, effect=256, wait=16)\nMAX_OUTPUT = 1024 * 1024\n\nHEX64 = re.compile('[0-9a-f]{64}')\nDAEMON = re.compile('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[A-Z0-9]{4}(?::[A-Z0-9]{4}){11}')\nPROJECT = re.compile(r'[A-Za-z0-9_-]{1,63}')\nPROCESSING = re.compile(r'pastorai:webhooks:processing:[A-Za-z0-9_-]{1,80}')\nMANDATORY_GATES = ('ALLOW_REAL_SENDS', 'ASAAS_BILLING_ENABLED', 'BREVO_SEND_MODE', 'BROADCAST_ASYNC_ENABLED')\nNETWORK_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,127}')\nIMAGE = re.compile('sha256:[0-9a-f]{64}')\nSTARTED = re.compile(r'[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})')\nSTATUSES = ('created', 'running', 'exited')\nHEALTH = ('starting', 'healthy', 'unhealthy')\nRUNNER_CODES = frozenset({'runner-argv', 'runner-bounds', 'runner-spawn-failed', 'runner-output-oversize',\n                          'runner-close-failed', 'runner-failed', 'runner-pending-cli'})\nPROJECT_LABEL = 'com.docker.compose.project'\nSERVICE_LABEL = 'com.docker.compose.service'\nREVISION_LABEL = 'org.opencontainers.image.revision'\nINFO_ARGV = ('docker', 'info', '--format', '{{json .ID}}')\nNETWORK_TEMPLATE = '[{{json .Id}},{{json .Name}}]'\n\n\ndef _gate_names(names):\n    require(isinstance(names, (list, tuple)) and len(names) == len(MANDATORY_GATES)\n            and all(isinstance(n, str) for n in names) and set(names) == set(MANDATORY_GATES),\n            'manifest-gate-names')\n    return tuple(sorted(names))\n\n\ndef _label(key):\n    # A nil label map prints null and a missing key prints \"\"; both normalize to None.\n    return '{{with .Config.Labels}}{{json (index . \"' + key + '\")}}{{else}}null{{end}}'\n\n\ndef inspect_template(gate_names):\n    \"\"\"One JSON array per container; the trusted Docker CLI filters env by name before stdout.\"\"\"\n    quoted = ' '.join('\"' + name + '\"' for name in _gate_names(gate_names))\n    return ('[{{json .Id}},{{json .Image}},' + ','.join(_label(k) for k in (\n            PROJECT_LABEL, SERVICE_LABEL, REVISION_LABEL)) + ','\n            '{{json .State.Status}},{{json .State.Running}},{{json .State.Paused}},{{json .State.Restarting}},'\n            '{{json .State.ExitCode}},{{json .State.StartedAt}},'\n            '{{with .State.Health}}{{json .Status}}{{else}}null{{end}},'\n            '{{json .RestartCount}},{{json .HostConfig.RestartPolicy.Name}},{{json .HostConfig.NetworkMode}},'\n            '[{{range .Config.Env}}{{if eq (index (split . \"=\") 0) ' + quoted + '}}{{json .}},{{end}}{{end}}null],'\n            '[{{range .Mounts}}[{{json .Type}},{{json .Name}},{{json .Source}},{{json .Destination}},'\n            '{{json .RW}}],{{end}}null],'\n            '[{{range $name, $net := .NetworkSettings.Networks}}[{{json $name}},{{json $net.Aliases}},'\n            '{{json $net.NetworkID}}],{{end}}null]]')\n\n\n@dataclass(frozen=True)\nclass HostManifest:\n    \"\"\"Sanitized, immutable scope; unknown keys (e.g. any secret) are refused.\"\"\"\n    daemon_id: str\n    legacy_project: str\n    network_id: str\n    service_ids: tuple\n    support_ids: tuple\n    processing_keys: tuple\n    gate_names: tuple\n    digest: str\n\n    @classmethod\n    def from_dict(cls, data):\n        require(isinstance(data, Mapping) and set(data) == MANIFEST_KEYS, 'manifest-keys')\n        require(data['schema'] == SCHEMA, 'manifest-schema')\n        require(isinstance(data['daemon_id'], str) and DAEMON.fullmatch(data['daemon_id']), 'manifest-daemon')\n        require(isinstance(data['legacy_project'], str) and PROJECT.fullmatch(data['legacy_project']),\n                'manifest-project')\n        services, support = data['service_ids'], data['support_ids']\n        require(_ids(services, ROLES) and _ids(support, SUPPORT_ROLES)\n                and not set(services.values()) & set(support.values()), 'manifest-identities')\n        require(isinstance(data['network_id'], str) and HEX64.fullmatch(data['network_id'])\n                and data['network_id'] not in {*services.values(), *support.values()}, 'manifest-network')\n        keys = data['processing_keys']\n        require(isinstance(keys, (list, tuple)) and len(keys) <= 64 and all(isinstance(k, str) and PROCESSING.fullmatch(k) for k in keys)\n                and len(set(keys)) == len(keys), 'manifest-processing-keys')\n        values = dict(daemon_id=data['daemon_id'], legacy_project=data['legacy_project'],\n                      network_id=data['network_id'], service_ids=tuple((r, services[r]) for r in ROLES),\n                      support_ids=tuple((r, support[r]) for r in SUPPORT_ROLES), processing_keys=tuple(keys),\n                      gate_names=_gate_names(data['gate_names']))\n        return cls(**values, digest=digest([SCHEMA, values]))\n\n    def validated(self):\n        require(all(type(v) is tuple for v in (\n            self.service_ids, self.support_ids, self.processing_keys, self.gate_names)), 'manifest-values')\n        ok, canonical = _attempt(type(self).from_dict, {\n            'schema': SCHEMA, 'daemon_id': self.daemon_id, 'legacy_project': self.legacy_project,\n            'network_id': self.network_id, 'service_ids': dict(self.service_ids),\n            'support_ids': dict(self.support_ids), 'processing_keys': self.processing_keys,\n            'gate_names': self.gate_names})\n        require(ok and self == canonical, 'manifest-integrity')\n        return canonical\n\n    def transport_scope(self):\n        return dict(legacy_project=self.legacy_project, network_id=self.network_id,\n                    service_ids=dict(self.service_ids), support_ids=dict(self.support_ids),\n                    processing_keys=self.processing_keys)\n\n\ndef _strict_json(text):\n    def constant(_):\n        raise ValueError('constant')\n    return json.loads(text, parse_constant=constant)\n\n\ndef _lines(out):\n    text = out.decode('utf-8')\n    if not text.endswith('\\n'):\n        raise ValueError('unterminated')\n    return [_strict_json(line) for line in text[:-1].split('\\n')]\n\n\ndef _attempt(function, *args):\n    # The failure is reported after the except block: no exception context can\n    # carry runner output into a later traceback.\n    try:\n        return True, function(*args)\n    except (ValueError, UnicodeDecodeError, RecursionError, TypeError):\n        return False, None\n\n\ndef _tail(value, code):\n    require(isinstance(value, list) and value and value[-1] is None, code)\n    return value[:-1]\n\n\nclass ObservedHostDriver:\n    mode = 'observed-host'\n    supports_resume = False\n\n    def __init__(self, manifest, *, runner, ingress, writers):\n        require(isinstance(manifest, HostManifest), 'driver-manifest')\n        manifest = manifest.validated()\n        require(callable(runner), 'driver-runner')\n        require(isinstance(ingress, Mapping) and set(ingress) == set(ENTRIES)\n                and ingress['external'] is not ingress['evolution-backend']\n                and all(self._bound(ingress[e], manifest, e, 'observe', 'block') for e in ENTRIES),\n                'driver-ingress-binding')\n        require(self._bound(writers, manifest, None, 'observe'), 'driver-writer-binding')\n        self.manifest, self.runner = manifest, runner\n        self.ingress, self.writers = dict(ingress), writers\n        self.template = inspect_template(manifest.gate_names)\n        self.roles = {ident: role for role, ident in (*manifest.service_ids, *manifest.support_ids)}\n        self.legacy = tuple(ident for _, ident in manifest.service_ids)\n        self.redis_id = dict(manifest.support_ids)['redis']\n        self.redis_verified = False\n        self.refusals = []  # fixed codes only, for diagnosis; never output\n        self._bindings_fixed = (self.ingress['external'], self.ingress['evolution-backend'], self.writers)\n\n    @staticmethod\n    def _bound(binding, manifest, entry, *methods):\n        return (binding is not None and getattr(binding, 'scope', None) == manifest.digest\n                and (entry is None or getattr(binding, 'entry', None) == entry)\n                and all(callable(getattr(binding, method, None)) for method in methods))\n\n    def transport_scope(self):\n        return self.manifest.transport_scope()\n\n    def request(self, argv, *, timeout):\n        try:\n            self._assert_bindings()\n            result = self._dispatch(argv, timeout)\n            self._assert_bindings()\n            return result\n        except Refused as exc:\n            self.refusals = [*self.refusals[-63:], str(exc)]\n            raise\n\n    def _assert_bindings(self):\n        require(isinstance(self.ingress, dict) and set(self.ingress) == set(ENTRIES), 'driver-ingress-binding')\n        for index, entry in enumerate(ENTRIES):\n            require(self.ingress[entry] is self._bindings_fixed[index]\n                    and self._bound(self.ingress[entry], self.manifest, entry, 'observe', 'block'),\n                    'driver-ingress-binding')\n        require(self.writers is self._bindings_fixed[2]\n                and self._bound(self.writers, self.manifest, None, 'observe'), 'driver-writer-binding')\n\n    def _dispatch(self, argv, timeout):\n        require(type(timeout) in (int, float) and 0 < timeout <= 30, 'driver-timeout-bound')\n        require(type(argv) is tuple and argv and all(type(a) is str for a in argv), 'driver-operation-forbidden')\n        deadline = time.monotonic() + timeout\n        if argv == ('inspect-host',):\n            return self._inspect_host(deadline)\n        if argv[0] == 'redis-meta':\n            require(len(argv) == 3 and argv[1] in REDIS_COMMANDS\n                    and argv[2] in QUEUE_KEYS + self.manifest.processing_keys, 'driver-redis-scope')\n            return self._redis_meta(argv[1], argv[2], deadline)\n        if argv == ('block-ingress',):\n            return self._block_ingress(deadline)\n        for kind in EFFECTS:\n            for ident in self.legacy:\n                if argv == host_command(kind, ident):\n                    return self._effect(kind, ident, argv, deadline)\n        raise Refused('driver-operation-forbidden')\n\n    @staticmethod\n    def _remaining(deadline):\n        remaining = deadline - time.monotonic()\n        if remaining <= 0:\n            raise TimeoutError('driver-timeout')\n        return remaining\n\n    def _run(self, argv, deadline, limit):\n        outcome = None\n        try:\n            result = self.runner(argv, timeout=self._remaining(deadline), max_output=limit)\n        except TimeoutError:\n            outcome = 'timeout'\n        except Refused as exc:\n            outcome = str(exc) if str(exc) in RUNNER_CODES else 'driver-runner-failed'\n        except Exception:\n            outcome = 'driver-runner-failed'\n        if outcome == 'timeout':\n            raise TimeoutError('driver-timeout')\n        require(outcome is None, outcome)\n        require(isinstance(result, tuple) and len(result) == 2 and type(result[0]) is int\n                and type(result[1]) is bytes, 'driver-runner-failed')\n        self._remaining(deadline)\n        self._assert_bindings()\n        require(len(result[1]) <= limit, 'driver-output-oversize')\n        return result\n\n    def _callback(self, binding, method, deadline, entry, code):\n        require(self._bound(binding, self.manifest, entry, method), code)\n        outcome = None\n        try:\n            value = getattr(binding, method)(self.manifest.digest, timeout=self._remaining(deadline))\n        except TimeoutError:\n            outcome = 'timeout'\n        except Exception:\n            outcome = 'driver-binding-failed'\n        if outcome == 'timeout':\n            raise TimeoutError('driver-timeout')\n        self._remaining(deadline)\n        require(self._bound(binding, self.manifest, entry, method), code)\n        self._assert_bindings()\n        require(outcome is None, outcome)\n        return value\n\n    def _daemon(self, deadline):\n        rc, out = self._run(INFO_ARGV, deadline, LIMITS['info'])\n        require(rc == 0, 'driver-daemon-failed')\n        ok, value = _attempt(_lines, out)\n        require(ok and len(value) == 1 and isinstance(value[0], str) and DAEMON.fullmatch(value[0]),\n                'driver-daemon-malformed')\n        require(value[0] == self.manifest.daemon_id, 'driver-daemon-mismatch')\n\n    def _network(self, deadline):\n        rc, out = self._run(('docker', 'network', 'inspect', '--format', NETWORK_TEMPLATE, self.manifest.network_id),\n                            deadline, LIMITS['network'])\n        require(rc == 0, 'driver-network-failed')\n        ok, value = _attempt(_lines, out)\n        require(ok and len(value) == 1 and isinstance(value[0], list) and len(value[0]) == 2\n                and all(isinstance(v, str) for v in value[0]) and HEX64.fullmatch(value[0][0])\n                and NETWORK_NAME.fullmatch(value[0][1]), 'driver-network-malformed')\n        require(value[0][0] == self.manifest.network_id, 'driver-network-mismatch')\n        return value[0]\n\n    def _ingress(self, deadline):\n        states = {}\n        for entry in ENTRIES:\n            value = self._callback(self.ingress[entry], 'observe', deadline, entry, 'driver-ingress-binding')\n            require(type(value) is str and value in ('blocked', 'open'), 'driver-ingress-shape')\n            states[entry] = value\n        return states\n\n    def _row(self, row, network_name):\n        (ident, image, project, service, revision, status, running, paused, restarting, exit_code, started,\n         health, restarts, policy, mode, gates, mounts, networks) = row\n        labels = [None if value in (None, '') else value for value in (project, service, revision)]\n        require(all(v is None or isinstance(v, str) and len(v) <= 128 for v in labels), 'driver-inspect-labels')\n        require(isinstance(image, str) and IMAGE.fullmatch(image) and type(running) is bool\n                and isinstance(status, str) and status in STATUSES and running == (status == 'running')\n                and paused is False and restarting is False\n                and type(exit_code) is int and 0 <= exit_code <= 255\n                and isinstance(started, str) and STARTED.fullmatch(started)\n                and (health is None or isinstance(health, str) and health in HEALTH)\n                and type(restarts) is int and 0 <= restarts <= 10**6\n                and isinstance(policy, str) and policy in ('always', 'no', '')\n                and isinstance(mode, str) and len(mode) <= 128, 'driver-inspect-state')\n        gates = _tail(gates, 'driver-inspect-gates')\n        names = [g.split('=', 1)[0] if isinstance(g, str) and '=' in g else None for g in gates]\n        require(all(n in self.manifest.gate_names for n in names) and len(set(names)) == len(names)\n                and all(len(g) <= 512 for g in gates), 'driver-inspect-gates')\n        mounts = _tail(mounts, 'driver-inspect-mounts')\n        require(len(mounts) <= 64 and all(\n            isinstance(m, list) and len(m) == 5 and type(m[4]) is bool\n            and all(v is None or isinstance(v, str) and len(v) <= 4096 for v in m[:4]) for m in mounts),\n            'driver-inspect-mounts')\n        networks = _tail(networks, 'driver-inspect-networks')\n        require(len(networks) <= 16 and all(\n            isinstance(n, list) and len(n) == 3 and isinstance(n[0], str) and NETWORK_NAME.fullmatch(n[0])\n            and (n[1] is None or isinstance(n[1], list) and all(isinstance(a, str) for a in n[1]))\n            and isinstance(n[2], str) and HEX64.fullmatch(n[2]) for n in networks)\n            and len({n[0] for n in networks}) == len(networks), 'driver-inspect-networks')\n        require(network_name in {n[0] for n in networks}, 'driver-network-detached')\n        require(any(n[0] == network_name and n[2] == self.manifest.network_id for n in networks),\n                'driver-network-mismatch')\n        # Stable configuration only: attachments by name/ID with configured aliases; IPAM is operational on some engines,\n        # never IP, endpoint, gateway or MAC, which Docker clears on stop.\n        attachments = [[n[0], sorted(n[1] or []), n[2]] for n in sorted(networks, key=lambda n: n[0])]\n        return dict(\n            id=ident, image=image, compose_project=labels[0], compose_service=labels[1], revision=labels[2],\n            started=started, restart_count=restarts, restart_policy=policy or 'no', running=running,\n            exit_code=None if running else exit_code, health=health,\n            gates_digest=digest(['gates', sorted(gates)]),\n            mounts_digest=digest(['mounts', sorted(mounts, key=json.dumps)]),\n            networks_digest=digest(['networks', mode, attachments]))\n\n    def _inspect_host(self, deadline):\n        self.redis_verified = False\n        self._daemon(deadline)\n        network_id, network_name = self._network(deadline)\n        ids = tuple(self.roles)\n        rc, out = self._run(('docker', 'inspect', '--type', 'container', '--format', self.template, *ids),\n                            deadline, LIMITS['inspect'])\n        require(rc == 0, 'driver-inspect-failed')\n        ok, rows = _attempt(_lines, out)\n        require(ok and all(isinstance(r, list) and len(r) == 18 and isinstance(r[0], str) for r in rows),\n                'driver-inspect-malformed')\n        require(len(rows) == len(ids) and {r[0] for r in rows} == set(ids), 'driver-inspect-scope')\n        services, support = {}, {}\n        for row in rows:\n            state, role = self._row(row, network_name), self.roles[row[0]]\n            if role in ROLES:\n                state.pop('health')\n                services[role] = state\n            else:\n                support[role] = {key: state[key] for key in (\n                    'id', 'image', 'compose_project', 'compose_service', 'running', 'restart_policy', 'health',\n                    'networks_digest')}\n        ingress = self._ingress(deadline)\n        writers = self._callback(self.writers, 'observe', deadline, None, 'driver-writer-binding')\n        require(type(writers) is int and 0 <= writers <= 10**6, 'driver-writer-shape')\n        redis = support['redis']\n        self.redis_verified = (redis['compose_project'] == self.manifest.legacy_project\n                               and redis['compose_service'] == 'redis' and redis['running'] is True)\n        return dict(scope_digest=self.manifest.digest,\n                    ingress_blocked=all(v == 'blocked' for v in ingress.values()), unknown_writers=writers,\n                    network_id=network_id, services=services, support=support)\n\n    def _redis_meta(self, command, key, deadline):\n        # Only into the Redis container this driver just verified by label; no auth in argv.\n        require(self.redis_verified, 'driver-redis-unverified')\n        self._daemon(deadline)\n        rc, out = self._run(('docker', 'exec', self.redis_id, 'redis-cli', '--raw', command, key),\n                            deadline, LIMITS['redis'])\n        ok, text = _attempt(bytes.decode, out, 'ascii')\n        require(ok, 'driver-redis-output')\n        require(not text.startswith(('NOAUTH', 'WRONGPASS', 'NOPERM')), 'driver-redis-auth-required')\n        require(rc == 0, 'driver-redis-failed')\n        require(text.endswith('\\n'), 'driver-redis-output')\n        value = text[:-1]\n        if command == 'TYPE':\n            require(value in REDIS_TYPES, 'driver-redis-output')\n            return value\n        require(re.fullmatch('-?[0-9]{1,19}', value), 'driver-redis-output')\n        return int(value)\n\n    def _block_ingress(self, deadline):\n        # Both entries are checked; one blocked entry never stands for the other.\n        for entry, state in self._ingress(deadline).items():\n            if state == 'open':\n                require(self._callback(self.ingress[entry], 'block', deadline, entry,\n                                       'driver-ingress-binding') is True, 'driver-ingress-receipt')\n        require(all(v == 'blocked' for v in self._ingress(deadline).values()), 'driver-ingress-still-open')\n        return True\n\n    def _effect(self, kind, ident, argv, deadline):\n        self._daemon(deadline)\n        if kind == 'wait':\n            rc, out = self._run(argv, deadline, LIMITS['wait'])\n            ok, text = _attempt(bytes.decode, out, 'ascii')\n            require(ok and rc == 0 and re.fullmatch('[0-9]{1,3}\\n', text), 'driver-wait-receipt')\n            return int(text)\n        rc, out = self._run(argv, deadline, LIMITS['effect'])\n        require(rc == 0 and out == (ident + '\\n').encode(), 'driver-effect-receipt')\n        return True\n\n\nGLOBAL_FLAGS = frozenset({'-H', '--host', '--context', '-c', '--config', '--tls', '--tlsverify', '--tlscacert',\n                          '--tlscert', '--tlskey', '-D', '--debug', '-l', '--log-level'})\nENV = {'LC_ALL': 'C', 'LANG': 'C'}\nABS_PATH = re.compile('/[A-Za-z0-9._/-]{1,255}')\n\n\ndef _absolute(path):\n    return (isinstance(path, str) and ABS_PATH.fullmatch(path) is not None\n            and all(part not in ('', '.', '..') for part in path[1:].split('/')))\n\n\ndef _runner_argv(argv):\n    if not (type(argv) is tuple and 2 <= len(argv) <= 32 and argv[0] == 'docker'\n            and all(type(a) is str and 0 < len(a) <= 16384 and '\\x00' not in a for a in argv)):\n        return False\n    if argv == INFO_ARGV:\n        return True\n    if len(argv) == 6 and argv[:5] == ('docker', 'network', 'inspect', '--format', NETWORK_TEMPLATE):\n        return HEX64.fullmatch(argv[5]) is not None\n    if 7 <= len(argv) <= 13 and argv[:6] == (\n            'docker', 'inspect', '--type', 'container', '--format', inspect_template(MANDATORY_GATES)):\n        return all(HEX64.fullmatch(i) for i in argv[6:]) and len(set(argv[6:])) == len(argv[6:])\n    if len(argv) == 7 and argv[:2] == ('docker', 'exec'):\n        return (HEX64.fullmatch(argv[2]) is not None and argv[3:5] == ('redis-cli', '--raw')\n                and argv[5] in REDIS_COMMANDS and (argv[6] in QUEUE_KEYS or PROCESSING.fullmatch(argv[6])))\n    if len(argv) == 4 and argv[:3] in (('docker', 'update', '--restart=no'),\n                                     ('docker', 'kill', '--signal=TERM')):\n        return HEX64.fullmatch(argv[3]) is not None\n    return len(argv) == 3 and argv[:2] == ('docker', 'wait') and HEX64.fullmatch(argv[2]) is not None\n\n\nclass PopenRunner:\n    \"\"\"Bounded docker CLI runner for a future authorized operator; never used by tests unmocked.\n\n    The endpoint (``unix://`` socket), docker binary and an operator-provided\n    config directory are explicit; the child gets a minimal environment, so no\n    inherited DOCKER_HOST/DOCKER_CONTEXT/credentials/HOME apply. Only block-A\n    read/containment subcommands are accepted. On timeout, oversize or error it\n    ends only its own CLI process, waits at most ``cleanup_wait`` and never\n    retries; an unreaped CLI is counted, not escalated. Killing the CLI does not\n    undo a request the daemon already received. Compatibility with a real\n    Docker CLI/daemon is unverified here.\n    \"\"\"\n\n    def __init__(self, *, docker_binary, endpoint, config_dir, popen=None, cleanup_wait=2.0, chunk=4096):\n        require(_absolute(docker_binary) and docker_binary.endswith('/docker')\n                and isinstance(endpoint, str) and endpoint.startswith('unix://')\n                and _absolute(endpoint[len('unix://'):]) and endpoint.endswith('.sock')\n                and _absolute(config_dir) and (popen is None or callable(popen))\n                and type(cleanup_wait) in (int, float) and 0 < cleanup_wait <= 10\n                and type(chunk) is int and 0 < chunk <= 65536, 'runner-config')\n        self.docker_binary, self.endpoint, self.config_dir = docker_binary, endpoint, config_dir\n        self.popen, self.cleanup_wait, self.chunk = popen, cleanup_wait, chunk\n        self.unreaped = 0\n\n    def __call__(self, argv, *, timeout, max_output):\n        require(self.unreaped == 0, 'runner-pending-cli')\n        require(_runner_argv(argv), 'runner-argv')\n        require(type(timeout) in (int, float) and 0 < timeout <= 60\n                and type(max_output) is int and 0 < max_output <= MAX_OUTPUT, 'runner-bounds')\n        deadline = time.monotonic() + timeout\n        popen = self.popen or subprocess.Popen  # resolved per call, never at import/construction\n        command = [self.docker_binary, '--config', self.config_dir, '--host', self.endpoint, *argv[1:]]\n        proc = None\n        try:\n            proc = popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,\n                         env=dict(ENV), cwd='/', close_fds=True, shell=False, start_new_session=True)\n        except Exception:\n            pass\n        require(proc is not None, 'runner-spawn-failed')\n        outcome = 'runner-failed'\n        try:\n            out = self._read(proc, deadline, max_output)\n            rc = proc.wait(timeout=max(deadline - time.monotonic(), 0))\n            outcome = None\n        except (TimeoutError, subprocess.TimeoutExpired):\n            outcome = 'timeout'\n        except Refused as exc:\n            outcome = str(exc)\n        except Exception:\n            pass\n        except BaseException:\n            self._cleanup(proc)\n            raise\n        finally:\n            try:\n                proc.stdout.close()\n            except Exception:\n                if outcome is None:\n                    outcome = 'runner-close-failed'\n        if outcome is None and time.monotonic() > deadline:\n            outcome = 'timeout'\n        if outcome is not None:\n            self._cleanup(proc)\n            if outcome == 'timeout':\n                raise TimeoutError('runner-timeout')\n            raise Refused(outcome)\n        return rc, out\n\n    def _read(self, proc, deadline, limit):\n        fd, chunks, size = proc.stdout.fileno(), [], 0\n        while True:\n            remaining = deadline - time.monotonic()\n            if remaining <= 0 or not select.select([fd], [], [], remaining)[0]:\n                raise TimeoutError('runner-timeout')\n            chunk = os.read(fd, min(self.chunk, limit + 1 - size))\n            if not chunk:\n                return b''.join(chunks)\n            size += len(chunk)\n            chunks.append(chunk)\n            require(size <= limit, 'runner-output-oversize')\n\n    def _cleanup(self, proc):\n        # Ends only this runner's own CLI child; never a container, never a retry.\n        try:\n            if proc.poll() is None:\n                proc.kill()\n            proc.wait(timeout=self.cleanup_wait)\n        except Exception:\n            self.unreaped += 1\n","numLines":563,"startLine":1,"totalLines":563}},"tool_result_meta":[{"id":"toolu_01YBSjo5x784uJtQiSrm2DQ5","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
