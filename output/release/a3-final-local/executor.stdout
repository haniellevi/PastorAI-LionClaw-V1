{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TN67s1n8kC2RTENQRkVZjy","type":"tool_result","content":"    app.include_router(responsabilidades_router)\n    from app.routers.private_summaries import router as private_summaries_router\n    app.include_router(private_summaries_router)\n    from app.prayer.router import router as prayer_router\n    app.include_router(prayer_router)\n    app.include_router(whatsapp.router)\n    from app.routers.private_content import router as private_content_router\n    app.include_router(private_content_router)\n    app.include_router(conversations.router)\n    app.include_router(operations.router)\n    app.include_router(dashboard.router)\n    app.include_router(agent.router)\n    app.include_router(agent_identity.router)\n    app.include_router(assistant.router)\n    app.include_router(reports.router)\n    app.include_router(broadcasts.router)\n    app.include_router(events.router)\n    app.include_router(calendar.router)\n    app.include_router(team.router)\n    app.include_router(roles.router)\n    app.include_router(setup.router)\n    app.include_router(subscription.router)\n    # Plano de plataforma (Super-Admin, cross-tenant). Gated por\n    # get_platform_admin — fora do RLS por tenant. Ver routers/platform_admin.py.\n    app.include_router(platform_admin.router)\n    # D2B2b3A: preparação DRAFT_ONLY pelo Console Master. A superfície\n    # nasce desligada e não autoriza aprovação, catálogo, writer ou runtime.\n    app.include_router(platform_consent_governance.router)\n    # Triagem Jev: status somente leitura + teste com mensagem sintética.\n    app.include_router(platform_jev.router)\n\n    @app.get(\"/health\", tags=[\"health\"])\n    def health() -> dict[str, str]:\n        \"\"\"Liveness probe — always 200 when the process is up.\"\"\"\n        return {\"status\": \"ok\"}\n\n    @app.get(\"/ready\", tags=[\"health\"])\n    async def readiness(request: Request) -> JSONResponse:\n        \"\"\"Dependency readiness, sanitized for public operational checks.\"\"\"\n        report = await collect_readiness()\n        logger.info(\n            \"readiness_check request_id=%s status=%s \"\n            \"required_failures=%d optional_failures=%d\",\n            request.state.request_id,\n            report.status,\n            report.required_failures,\n            report.optional_failures,\n        )\n        return JSONResponse(\n            status_code=report.http_status,\n            content=report.public_payload(),\n        )\n\n    return app\n\n\napp = create_app()","is_error":false}]},"parent_tool_use_id":null,"session_id":"6f5f5b47-c66e-4591-b756-d99024a874c5","uuid":"e4580e11-88e2-4fea-a1b3-bd7f1ad492df","timestamp":"2026-10-30T15:06:21.183Z","tool_use_result":{"stdout":"    app.include_router(responsabilidades_router)\n    from app.routers.private_summaries import router as private_summaries_router\n    app.include_router(private_summaries_router)\n    from app.prayer.router import router as prayer_router\n    app.include_router(prayer_router)\n    app.include_router(whatsapp.router)\n    from app.routers.private_content import router as private_content_router\n    app.include_router(private_content_router)\n    app.include_router(conversations.router)\n    app.include_router(operations.router)\n    app.include_router(dashboard.router)\n    app.include_router(agent.router)\n    app.include_router(agent_identity.router)\n    app.include_router(assistant.router)\n    app.include_router(reports.router)\n    app.include_router(broadcasts.router)\n    app.include_router(events.router)\n    app.include_router(calendar.router)\n    app.include_router(team.router)\n    app.include_router(roles.router)\n    app.include_router(setup.router)\n    app.include_router(subscription.router)\n    # Plano de plataforma (Super-Admin, cross-tenant). Gated por\n    # get_platform_admin — fora do RLS por tenant. Ver routers/platform_admin.py.\n    app.include_router(platform_admin.router)\n    # D2B2b3A: preparação DRAFT_ONLY pelo Console Master. A superfície\n    # nasce desligada e não autoriza aprovação, catálogo, writer ou runtime.\n    app.include_router(platform_consent_governance.router)\n    # Triagem Jev: status somente leitura + teste com mensagem sintética.\n    app.include_router(platform_jev.router)\n\n    @app.get(\"/health\", tags=[\"health\"])\n    def health() -> dict[str, str]:\n        \"\"\"Liveness probe — always 200 when the process is up.\"\"\"\n        return {\"status\": \"ok\"}\n\n    @app.get(\"/ready\", tags=[\"health\"])\n    async def readiness(request: Request) -> JSONResponse:\n        \"\"\"Dependency readiness, sanitized for public operational checks.\"\"\"\n        report = await collect_readiness()\n        logger.info(\n            \"readiness_check request_id=%s status=%s \"\n            \"required_failures=%d optional_failures=%d\",\n            request.state.request_id,\n            report.status,\n            report.required_failures,\n            report.optional_failures,\n        )\n        return JSONResponse(\n            status_code=report.http_status,\n            content=report.public_payload(),\n        )\n\n    return app\n\n\napp = create_app()","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01TN67s1n8kC2RTENQRkVZjy","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
