{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AQbo13FVq5EvDXin1xUGcM","type":"tool_result","content":"1\t\"\"\"Containment contracts over caller-supplied host ports.\n2\t\n3\tLocalHostContract proves the orchestration against a simulator only.\n4\tObservedHostContract is a contract over a caller-supplied driver: every field\n5\t(ingress, unknown writers, queue counts, health, digests) is driver-reported,\n6\tnever independent host evidence, so receipts carry host_verified=False. Queue\n7\tcounts cannot prove contents or quiescence. It may resume the pinned legacy\n8\tonly while no DDL marker is journaled; marker absence is no proof that DDL did\n9\tnot run elsewhere. The resume token binds the host identity, not a human\n10\tapproval. Partial containment or an abnormal exit is refused fail-closed; there\n11\tis no automatic recovery. Checks run immediately before each effect and again\n12\tafter it, without any atomicity over the driver or host; each resume effect is\n13\talso judged, without new IO, on the port's own final snapshot via a guard. Its\n14\tjournal is never shared with the local adapter (adapter-*/local-host-*). No SSH, Docker client,\n15\tgate setter, real executor or deploy operation is provided here.\n16\t\"\"\"\n17\tfrom __future__ import annotations\n18\t\n19\timport re\n20\t\n21\tfrom first_transition_adapter import ROLES, digest\n22\tfrom initial_transition_ops import Refused, require\n23\t\n24\tFIELDS = frozenset({'id', 'image', 'revision', 'compose_project', 'compose_service',\n25\t                    'started', 'restart_count', 'restart_policy', 'running', 'exit_code',\n26\t                    'gates_digest', 'mounts_digest', 'networks_digest'})\n27\tDYNAMIC = frozenset({'restart_policy', 'running', 'exit_code'})\n28\tHEX = re.compile('[0-9a-f]{64}')\n29\tRESUMABLE = frozenset({'started', 'restart_count'})\n30\tSTART_ORDER = ('backend', 'queue-worker', 'broadcast-worker', 'cron-worker')\n31\t\n32\t\n33\tclass LocalHostContract:\n34\t    def __init__(self, port, journal):\n35\t        self.port, self.j = port, journal\n36\t\n37\t    def _call(self, operation, *args):\n38\t        try:\n39\t            return getattr(self.port, operation)(*args)\n40\t        except TimeoutError:\n41\t            raise Refused('local-host-timeout') from None\n42\t        except Exception:\n43\t            raise Refused('local-host-effect-failed') from None\n44\t\n45\t    def _snapshot(self):\n46\t        data = self._call('snapshot')\n47\t        require(isinstance(data, dict) and set(data) == {\n48\t            'mode', 'ingress_blocked', 'support_digest', 'unknown_writers', 'services'}, 'local-host-shape')\n49\t        require(data['mode'] == 'local-simulation', 'local-host-simulation-required')\n50\t        require(type(data['ingress_blocked']) is bool\n51\t                and isinstance(data['support_digest'], str) and HEX.fullmatch(data['support_digest']),\n52\t                'local-host-shape')\n53\t        require(type(data['unknown_writers']) is int and data['unknown_writers'] == 0,\n54\t                'local-host-unknown-writer')\n55\t        services = data['services']\n56\t        require(isinstance(services, dict) and set(services) == set(ROLES), 'local-host-services')\n57\t        for role, state in services.items():\n58\t            require(isinstance(state, dict) and set(state) == FIELDS, 'local-host-service-shape')\n59\t            require(isinstance(state['id'], str) and HEX.fullmatch(state['id'])\n60\t                    and isinstance(state['image'], str) and re.fullmatch(r'sha256:[0-9a-f]{64}', state['image'])\n61\t                    and (state['revision'] is None or isinstance(state['revision'], str)\n62\t                         and re.fullmatch('[0-9a-f]{40}', state['revision'])), 'local-host-identity')\n63\t            require(type(state['running']) is bool and type(state['restart_count']) is int\n64\t                    and state['restart_count'] >= 0 and state['restart_policy'] in ('always', 'no')\n65\t                    and (state['exit_code'] is None or type(state['exit_code']) is int)\n66\t                    and isinstance(state['started'], str)\n67\t                    and re.fullmatch(r'[A-Za-z0-9_.:+-]{1,64}', state['started']), 'local-host-state')\n68\t            require(all(isinstance(state[key], str) and HEX.fullmatch(state[key])\n69\t                        for key in ('gates_digest', 'mounts_digest', 'networks_digest')), 'local-host-digest')\n70\t            if role == 'broadcast-worker':\n71\t                require(state['compose_project'] is None and state['compose_service'] is None,\n72\t                        'local-host-broadcast-must-be-standalone')\n73\t            else:\n74\t                require(state['compose_service'] == role and isinstance(state['compose_project'], str)\n75\t                        and re.fullmatch('[A-Za-z0-9_-]{1,63}', state['compose_project']), 'local-host-compose')\n76\t        require(len({s['id'] for s in services.values()}) == 4, 'local-host-duplicate-identity')\n77\t        require(len({s['compose_project'] for role, s in services.items() if role != 'broadcast-worker'}) == 1,\n78\t                'local-host-compose-projects')\n79\t        fingerprint = digest([data['support_digest'], {\n80\t            role: {key: state[key] for key in sorted(FIELDS - DYNAMIC)} for role, state in services.items()}])\n81\t        baseline = self.j.last('local-host-init')\n82\t        if baseline:\n83\t            require(fingerprint == baseline['fingerprint'], 'local-host-identity-or-support-changed')\n84\t        return data, fingerprint\n85\t\n86\t    def _intent(self, step):\n87\t        if self.j.last('local-host-intent', step) is None:\n88\t            self.j.append('local-host-intent', step=step)\n89\t\n90\t    def _done(self, step):\n91\t        if self.j.last('local-host-done', step) is None:\n92\t            self.j.append('local-host-done', step=step)\n93\t\n94\t    def assert_contained(self):\n95\t        require(self.j.last('local-host-init') is not None, 'local-host-unobserved')\n96\t        data, fingerprint = self._snapshot()\n97\t        require(data['ingress_blocked'], 'local-host-ingress-open')\n98\t        for state in data['services'].values():\n99\t            require(state['restart_policy'] == 'no' and not state['running'] and state['exit_code'] == 0,\n100\t                    'local-host-not-cleanly-contained')\n101\t        return dict(mode='local-simulation', fingerprint=fingerprint, stopped_roles=ROLES,\n102\t                    host_verified=False)\n103\t\n104\t    def contain(self):\n105\t        data, fingerprint = self._snapshot()\n106\t        if self.j.last('local-host-init') is None:\n107\t            require(all(s['running'] and s['restart_policy'] == 'always' for s in data['services'].values()),\n108\t                    'local-host-baseline-state')\n109\t            self.j.append('local-host-init', fingerprint=fingerprint, mode='local-simulation')\n110\t        if self.j.last('local-host-done', 'ingress'):\n111\t            require(data['ingress_blocked'], 'local-host-ingress-reopened')\n112\t        if not data['ingress_blocked']:\n113\t            self._intent('ingress')\n114\t            self._call('block_ingress')\n115\t        require(self._snapshot()[0]['ingress_blocked'], 'local-host-ingress-open')\n116\t        self._done('ingress')\n117\t        for role in ROLES:\n118\t            state = self._snapshot()[0]['services'][role]\n119\t            step = 'restart-no:' + role\n120\t            if self.j.last('local-host-done', step):\n121\t                require(state['restart_policy'] == 'no', 'local-host-restart-reenabled')\n122\t            if state['restart_policy'] != 'no':\n123\t                self._intent(step)\n124\t                self._call('disable_restart', state['id'])\n125\t            require(self._snapshot()[0]['services'][role]['restart_policy'] == 'no',\n126\t                    'local-host-restart-not-disabled')\n127\t            self._done(step)\n128\t            state = self._snapshot()[0]['services'][role]\n129\t            step = 'term:' + role\n130\t            if self.j.last('local-host-done', step):\n131\t                require(not state['running'], 'local-host-restarted')\n132\t            if state['running']:\n133\t                # An unreceipted SIGTERM may already have been delivered. Wait;\n134\t                # do not blindly signal again or escalate to SIGKILL/restart.\n135\t                if self.j.last('local-host-intent', step) is None:\n136\t                    self._intent(step)\n137\t                    self._call('signal_term', state['id'])\n138\t                self._call('wait_stopped', state['id'], 30)\n139\t            state = self._snapshot()[0]['services'][role]\n140\t            require(not state['running'] and state['exit_code'] == 0, 'local-host-exit-not-clean')\n141\t            self._done(step)\n142\t        receipt = self.assert_contained()\n143\t        if self.j.last('local-host-contained') is None:\n144\t            self.j.append('local-host-contained', **receipt)\n145\t        return receipt\n146\t\n147\t\n148\tdef _observed_services(services):\n149\t    require(isinstance(services, dict) and set(services) == set(ROLES), 'observed-host-services')\n150\t    for role, state in services.items():\n151\t        require(isinstance(state, dict) and set(state) == FIELDS, 'observed-host-service-shape')\n152\t        require(isinstance(state['id'], str) and HEX.fullmatch(state['id'])\n153\t                and isinstance(state['image'], str) and re.fullmatch(r'sha256:[0-9a-f]{64}', state['image'])\n154\t                and (state['revision'] is None or isinstance(state['revision'], str)\n155\t                     and re.fullmatch('[0-9a-f]{40}', state['revision'])), 'observed-host-identity')\n156\t        require(type(state['running']) is bool and type(state['restart_count']) is int\n157\t                and state['restart_count'] >= 0 and state['restart_policy'] in ('always', 'no')\n158\t                and (state['exit_code'] is None or type(state['exit_code']) is int)\n159\t                and isinstance(state['started'], str)\n160\t                and re.fullmatch(r'[A-Za-z0-9_.:+-]{1,64}', state['started']), 'observed-host-state')\n161\t        require(all(isinstance(state[key], str) and HEX.fullmatch(state[key])\n162\t                    for key in ('gates_digest', 'mounts_digest', 'networks_digest')), 'observed-host-digest')\n163\t        if role == 'broadcast-worker':\n164\t            require(state['compose_project'] is None and state['compose_service'] is None,\n165\t                    'observed-host-broadcast-must-be-standalone')\n166\t        else:\n167\t            require(state['compose_service'] == role and isinstance(state['compose_project'], str)\n168\t                    and re.fullmatch('[A-Za-z0-9_-]{1,63}', state['compose_project']), 'observed-host-compose')\n169\t    require(len({s['id'] for s in services.values()}) == 4, 'observed-host-duplicate-identity')\n170\t    require(len({s['compose_project'] for role, s in services.items() if role != 'broadcast-worker'}) == 1,\n171\t            'observed-host-compose-projects')\n172\t\n173\t\n174\tclass ObservedHostContract:\n175\t    def __init__(self, port, journal):\n176\t        self.port, self.j = port, journal\n177\t\n178\t    def _call(self, operation, *args):\n179\t        try:\n180\t            return getattr(self.port, operation)(*args)\n181\t        except TimeoutError:\n182\t            raise Refused('observed-host-timeout') from None\n183\t        except Exception:\n184\t            raise Refused('observed-host-effect-failed') from None\n185\t\n186\t    def _assert_own_journal(self):\n187\t        require(not any(event['kind'].startswith(('adapter-', 'local-host-')) for event in self.j.events),\n188\t                'observed-host-journal-mixed')\n189\t\n190\t    def _snapshot(self, data=None):\n191\t        # data: a port's final snapshot handed to a pre-effect guard, validated without new IO.\n192\t        self._assert_own_journal()\n193\t        if data is None:\n194\t            data = self._call('snapshot')\n195\t        require(isinstance(data, dict) and set(data) == {\n196\t            'mode', 'scope_digest', 'ingress_blocked', 'support_digest', 'unknown_writers', 'queue_digest', 'queue_counts',\n197\t            'services'}, 'observed-host-shape')\n198\t        require(data['mode'] == 'observed-host', 'observed-host-required')\n199\t        require(isinstance(data['scope_digest'], str) and HEX.fullmatch(data['scope_digest']),\n200\t                'observed-host-scope')\n201\t        require(type(data['ingress_blocked']) is bool\n202\t                and isinstance(data['support_digest'], str) and HEX.fullmatch(data['support_digest']),\n203\t                'observed-host-shape')\n204\t        require(type(data['unknown_writers']) is int and data['unknown_writers'] == 0,\n205\t                'observed-host-unknown-writer')\n206\t        counts = data['queue_counts']\n207\t        require(isinstance(data['queue_digest'], str) and HEX.fullmatch(data['queue_digest'])\n208\t                and isinstance(counts, dict) and counts\n209\t                and all(isinstance(k, str) and type(v) is int and v >= 0 for k, v in counts.items()),\n210\t                'observed-host-queue')\n211\t        services = data['services']\n212\t        _observed_services(services)\n213\t        # started/restart_count legitimately change on resume; un-resumed roles keep\n214\t        # their baseline and resumed roles keep their receipted fresh start.\n215\t        fingerprint = digest([data['scope_digest'], data['support_digest'], {\n216\t            role: {key: state[key] for key in sorted(FIELDS - DYNAMIC - RESUMABLE)}\n217\t            for role, state in services.items()}])\n218\t        baseline = self.j.last('observed-host-init')\n219\t        if baseline:\n220\t            require(fingerprint == baseline['fingerprint'], 'observed-host-identity-or-support-changed')\n221\t            for role, state in services.items():\n222\t                step = 'legacy-resume:' + role\n223\t                if self.j.last('observed-host-intent', step) is None:\n224\t                    require(state['started'] == baseline['initial_started'][role]\n225\t                            and state['restart_count'] == baseline['initial_restarts'][role],\n226\t                            'observed-host-identity-or-support-changed')\n227\t                done = self.j.last('observed-host-done', step)\n228\t                if done:\n229\t                    require(state['running'] is True and state['restart_policy'] == 'always'\n230\t                            and state['restart_count'] == 0 and state['started'] == done['started'],\n231\t                            'observed-host-resumed-state-changed')\n232\t        return data, fingerprint\n233\t\n234\t    def _intent(self, step):\n235\t        if self.j.last('observed-host-intent', step) is None:\n236\t            self.j.append('observed-host-intent', step=step)\n237\t\n238\t    def _done(self, step):\n239\t        if self.j.last('observed-host-done', step) is None:\n240\t            self.j.append('observed-host-done', step=step)\n241\t\n242\t    def assert_contained(self):\n243\t        self._assert_own_journal()\n244\t        # Once a resume is intended the host is never containment evidence again.\n245\t        require(self.j.last('observed-host-intent', 'legacy-resume') is None, 'observed-host-resume-started')\n246\t        settled = self.j.last('observed-host-settled')\n247\t        require(self.j.last('observed-host-init') is not None and settled is not None,\n248\t                'observed-host-unobserved')\n249\t        data, fingerprint = self._contain_observe()\n250\t        require(data['ingress_blocked'] is True, 'observed-host-ingress-open')\n251\t        for state in data['services'].values():\n252\t            require(state['restart_policy'] == 'no' and not state['running'] and state['exit_code'] == 0,\n253\t                    'observed-host-not-cleanly-contained')\n254\t        require(data['queue_digest'] == settled['queue_digest'], 'observed-host-queue-drift')\n255\t        return dict(mode='observed-host', evidence='driver-reported', fingerprint=fingerprint,\n256\t                    queue_digest=settled['queue_digest'], stopped_roles=ROLES, host_verified=False,\n257\t                    quiescence_proven=False)\n258\t\n259\t    def contain(self):\n260\t        self._assert_own_journal()\n261\t        require(self.j.last('observed-host-intent', 'legacy-resume') is None, 'observed-host-resume-started')\n262\t        data, fingerprint = self._contain_observe()\n263\t        if self.j.last('observed-host-init') is None:\n264\t            require(all(s['running'] and s['restart_policy'] == 'always' for s in data['services'].values()),\n265\t                    'observed-host-baseline-state')\n266\t            self.j.append('observed-host-init', fingerprint=fingerprint, mode='observed-host',\n267\t                          scope_digest=data['scope_digest'],\n268\t                          evidence='driver-reported', host_verified=False,\n269\t                          initial_started={role: data['services'][role]['started'] for role in ROLES},\n270\t                          initial_restarts={role: data['services'][role]['restart_count'] for role in ROLES})\n271\t        if self.j.last('observed-host-done', 'ingress'):\n272\t            require(data['ingress_blocked'], 'observed-host-ingress-reopened')\n273\t        if not data['ingress_blocked']:\n274\t            self._intent('ingress')\n275\t            self._effect('block_ingress', self._contain_snapshot)\n276\t        require(self._contain_observe()[0]['ingress_blocked'] is True, 'observed-host-ingress-open')\n277\t        self._done('ingress')\n278\t        for role in ROLES:\n279\t            state = self._contain_observe()[0]['services'][role]\n280\t            step = 'restart-no:' + role\n281\t            if self.j.last('observed-host-done', step):\n282\t                require(state['restart_policy'] == 'no', 'observed-host-restart-reenabled')\n283\t            if state['restart_policy'] != 'no':\n284\t                self._intent(step)\n285\t                self._effect('disable_restart', self._contain_snapshot, state['id'])\n286\t            require(self._contain_observe()[0]['services'][role]['restart_policy'] == 'no',\n287\t                    'observed-host-restart-not-disabled')\n288\t            self._done(step)\n289\t            state = self._contain_observe()[0]['services'][role]\n290\t            step = 'term:' + role\n291\t            if self.j.last('observed-host-done', step):\n292\t                require(not state['running'], 'observed-host-restarted')\n293\t            if state['running']:\n294\t                # Never re-signal an unreceipted SIGTERM; wait or hold.\n295\t                if self.j.last('observed-host-intent', step) is None:\n296\t                    self._intent(step)\n297\t                    self._effect('signal_term', self._contain_snapshot, state['id'])\n298\t                self._call('wait_stopped', state['id'], 30)\n299\t            state = self._contain_observe()[0]['services'][role]\n300\t            require(not state['running'] and state['exit_code'] == 0, 'observed-host-exit-not-clean')\n301\t            self._done(step)\n302\t        settled_data = self._contain_observe()[0]\n303\t        if self.j.last('observed-host-settled') is None:\n304\t            self.j.append('observed-host-settled', queue_digest=settled_data['queue_digest'],\n305\t                          queue_counts=settled_data['queue_counts'], evidence='driver-reported',\n306\t                          quiescence_proven=False)\n307\t        receipt = self.assert_contained()\n308\t        if self.j.last('observed-host-contained') is None:\n309\t            self.j.append('observed-host-contained', **receipt)\n310\t        return receipt\n311\t\n312\t    def _contain_observe(self):\n313\t        data, fingerprint = self._snapshot()\n314\t        if self.j.last('observed-host-init') is not None:\n315\t            self._contain_snapshot(data)  # validate adoption/phase without another port read\n316\t        return data, fingerprint\n317\t\n318\t    def _contain_snapshot(self, data=None):\n319\t        require(self.j.last('observed-host-intent', 'legacy-resume') is None, 'observed-host-resume-started')\n320\t        data, _ = self._snapshot(data)\n321\t        if self.j.last('observed-host-done', 'ingress'):\n322\t            require(data['ingress_blocked'] is True, 'observed-host-ingress-reopened')\n323\t        for role, state in data['services'].items():\n324\t            if self.j.last('observed-host-intent', 'restart-no:' + role) is None:\n325\t                require(state['restart_policy'] == 'always', 'observed-host-unintended-policy')\n326\t            if self.j.last('observed-host-done', 'restart-no:' + role):\n327\t                require(state['restart_policy'] == 'no', 'observed-host-restart-reenabled')\n328\t            if self.j.last('observed-host-intent', 'term:' + role) is None:\n329\t                require(state['running'] is True, 'observed-host-unintended-stop')\n330\t            elif not state['running']:\n331\t                require(state['exit_code'] == 0, 'observed-host-exit-not-clean')\n332\t            if self.j.last('observed-host-done', 'term:' + role):\n333\t                require(not state['running'], 'observed-host-restarted')\n334\t        return data\n335\t\n336\t    def resume_token(self):\n337\t        init = self.j.last('observed-host-init')\n338\t        require(init is not None, 'observed-host-unobserved')\n339\t        return 'RESUME:' + init['fingerprint']\n340\t\n341\t    def _assert_pre_ddl(self):\n342\t        # Journal-only guard, re-read before each effect and after each observation.\n343\t        # It cannot see DDL performed outside this journal; that needs a DB proof.\n344\t        require(self.j.last('adapter-ddl-marker') is None and self.j.last('ddl-marker') is None,\n345\t                'post-ddl-resume-forbidden')\n346\t\n347\t    def _resume_snapshot(self, data=None):\n348\t        self._assert_pre_ddl()  # keeps priority over the mixed-journal refusal\n349\t        data, _ = self._snapshot(data)\n350\t        self._assert_pre_ddl()\n351\t        self._check_resume_roles(data)\n352\t        if self.j.last('observed-host-intent', 'open-ingress') is None:\n353\t            # Ingress stays blocked through any partial resume until its opening is intended.\n354\t            require(data['ingress_blocked'] is True, 'observed-host-ingress-open')\n355\t        return data\n356\t\n357\t    def _check_resume_roles(self, data):\n358\t        # Every role must match its phase on every observation, not just the target.\n359\t        init = self.j.last('observed-host-init')\n360\t        for role, state in data['services'].items():\n361\t            step = 'legacy-resume:' + role\n362\t            if self.j.last('observed-host-done', step) is not None:\n363\t                continue  # _snapshot already proves the receipted fresh running state.\n364\t            if self.j.last('observed-host-intent', step) is None:\n365\t                require(not state['running'], 'observed-host-resume-not-fresh')\n366\t                require(state['restart_policy'] == 'no' and state['exit_code'] == 0,\n367\t                        'observed-host-not-cleanly-contained')\n368\t            elif state['running']:\n369\t                self._check_fresh(state, role, init)\n370\t            else:\n371\t                require(state['restart_policy'] == 'no' and state['exit_code'] == 0\n372\t                        and state['started'] == init['initial_started'][role]\n373\t                        and state['restart_count'] == init['initial_restarts'][role],\n374\t                        'observed-host-resume-not-fresh')\n375\t\n376\t    def _effect(self, operation, check, *args):\n377\t        # The port must pass its own final snapshot to the guard and emit only after\n378\t        # it returns; a guard refusal keeps its contract code, a skipped guard refuses.\n379\t        outcome = []\n380\t        def guard(final):\n381\t            try:\n382\t                check(final)\n383\t            except Refused as exc:\n384\t                outcome.append(exc)\n385\t                raise\n386\t            outcome.append(True)\n387\t        try:\n388\t            self._call(operation, *args, guard)\n389\t        except Refused:\n390\t            refusals = [item for item in outcome if isinstance(item, Refused)]\n391\t            if refusals:\n392\t                raise refusals[0] from None\n393\t            raise\n394\t        require(True in outcome, 'observed-host-guard-skipped')\n395\t\n396\t    def _start_observed(self, data, init):\n397\t        # An actual start: receipted, or intended with a verifiably fresh start.\n398\t        # A running or changed role without both is inconsistent and refused.\n399\t        observed = False\n400\t        for role in ROLES:\n401\t            step = 'legacy-resume:' + role\n402\t            if self.j.last('observed-host-done', step) is not None:\n403\t                observed = True\n404\t                continue\n405\t            state = data['services'][role]\n406\t            if state['running'] or state['started'] != init['initial_started'][role]:\n407\t                require(self.j.last('observed-host-intent', step) is not None and state['running'] is True\n408\t                        and state['restart_count'] == 0 and state['started'] != init['initial_started'][role],\n409\t                        'observed-host-resume-not-fresh')\n410\t                observed = True\n411\t        return observed\n412\t\n413\t    def _check_start(self, data, role, init, settled, allow_queue_drift):\n414\t        # Only a never-started container may be started; the queue gate holds until an actual start.\n415\t        state = data['services'][role]\n416\t        require(not state['running'] and state['exit_code'] == 0 and state['started'] == init['initial_started'][role]\n417\t                and state['restart_count'] == init['initial_restarts'][role]\n418\t                and state['restart_policy'] == 'no', 'observed-host-resume-not-fresh')\n419\t        if not self._start_observed(data, init):\n420\t            self._queue_gate(data, settled, allow_queue_drift)\n421\t\n422\t    def _check_fresh(self, state, role, init):\n423\t        require(state['running'] is True and state['restart_count'] == 0\n424\t                and state['started'] != init['initial_started'][role], 'observed-host-resume-not-fresh')\n425\t        return state\n426\t\n427\t    def _queue_gate(self, data, settled, allow_queue_drift):\n428\t        # Before the first actual start the queue must match the settled baseline or\n429\t        # the drift is explicitly accepted and journaled before the effect.\n430\t        if data['queue_digest'] != settled['queue_digest']:\n431\t            require(allow_queue_drift is True, 'observed-host-queue-drift')\n432\t            accepted = self.j.last('observed-host-queue-drift-accepted')\n433\t            if accepted is None or accepted['current_digest'] != data['queue_digest']:\n434\t                self.j.append('observed-host-queue-drift-accepted', settled_digest=settled['queue_digest'],\n435\t                              current_digest=data['queue_digest'])\n436\t\n437\t    def resume_legacy(self, confirmation, expected_token=None, *, allow_queue_drift=False):\n438\t        self._assert_pre_ddl()\n439\t        self._assert_own_journal()\n440\t        require(getattr(self.port, 'supports_resume', False) is True, 'observed-host-resume-unavailable')\n441\t        require(self.j.last('observed-host-contained') is not None, 'observed-host-not-contained')\n442\t        token = self.resume_token()  # bound to this journal's observed host; not a human approval\n443\t        require(expected_token is None or expected_token == token, 'observed-host-resume-confirmation')\n444\t        if self.j.last('observed-host-intent', 'legacy-resume') is None:\n445\t            require(confirmation == token, 'observed-host-resume-confirmation')\n446\t        init = self.j.last('observed-host-init')\n447\t        settled = self.j.last('observed-host-settled')\n448\t        data = self._resume_snapshot()\n449\t        if not self._start_observed(data, init):\n450\t            for state in data['services'].values():\n451\t                require(not state['running'] and state['exit_code'] == 0 and state['restart_policy'] == 'no',\n452\t                        'observed-host-not-cleanly-contained')\n453\t            self._queue_gate(data, settled, allow_queue_drift)\n454\t        else:\n455\t            require(self.j.last('observed-host-intent', 'legacy-resume') is not None,\n456\t                    'observed-host-not-contained')\n457\t        self._intent('legacy-resume')\n458\t        for role in START_ORDER:\n459\t            step = 'legacy-resume:' + role\n460\t            if self.j.last('observed-host-done', step) is not None:\n461\t                continue  # _snapshot() keeps re-validating the receipted fresh start\n462\t            if self.j.last('observed-host-intent', step) is None:\n463\t                state = self._resume_snapshot()['services'][role]\n464\t                require(not state['running'] and state['exit_code'] == 0 and state['restart_policy'] == 'no',\n465\t                        'observed-host-not-cleanly-contained')\n466\t                self._intent(step)\n467\t            # Re-observed after the intent, immediately before the effect (first run or replay).\n468\t            data = self._resume_snapshot()\n469\t            state = data['services'][role]\n470\t            if not state['running']:\n471\t                self._check_start(data, role, init, settled, allow_queue_drift)\n472\t                # Start before restart=always: never a stopped container with restart=always.\n473\t                self._effect('start_service', lambda final, role=role: self._check_start(\n474\t                    self._resume_snapshot(final), role, init, settled, allow_queue_drift), state['id'])\n475\t            state = self._check_fresh(self._resume_snapshot()['services'][role], role, init)\n476\t            if state['restart_policy'] != 'always':\n477\t                self._effect('enable_restart', lambda final, role=role: self._check_fresh(\n478\t                    self._resume_snapshot(final)['services'][role], role, init), state['id'])\n479\t            state = self._resume_snapshot()['services'][role]\n480\t            require(state['restart_policy'] == 'always', 'observed-host-restart-not-enabled')\n481\t            self._check_fresh(state, role, init)\n482\t            self.j.append('observed-host-done', step=step, started=state['started'])\n483\t        if self.j.last('observed-host-done', 'open-ingress') is None:\n484\t            if self.j.last('observed-host-intent', 'open-ingress') is None:\n485\t                self._resume_snapshot()  # still blocked and pre-DDL right before authorizing it\n486\t                self._intent('open-ingress')\n487\t            if self._resume_snapshot()['ingress_blocked']:\n488\t                # _snapshot() re-validates every receipted fresh start on the final observation.\n489\t                self._effect('open_ingress', self._resume_snapshot)\n490\t            require(not self._resume_snapshot()['ingress_blocked'], 'observed-host-ingress-still-blocked')\n491\t            self._done('open-ingress')\n492\t        # Every call, terminal replay included, re-proves the resumed host.\n493\t        final_data = self._resume_snapshot()\n494\t        require(final_data['ingress_blocked'] is False, 'observed-host-ingress-still-blocked')\n495\t        if self.j.last('observed-host-resumed') is None:\n496\t            self.j.append('observed-host-resumed', resumed_roles=START_ORDER, evidence='driver-reported')\n497\t        return dict(mode='observed-host', status='legacy-resumed', resumed_roles=START_ORDER,\n498\t                    ingress_blocked=False, evidence='driver-reported', host_verified=False)\n499\t"}]},"parent_tool_use_id":null,"session_id":"6f5f5b47-c66e-4591-b756-d99024a874c5","uuid":"86adf6a6-8bd5-414c-ab89-23b653d68f68","timestamp":"2026-10-30T15:03:45.338Z","tool_use_result":{"type":"text","file":{"filePath":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_host_contract.py","content":"\"\"\"Containment contracts over caller-supplied host ports.\n\nLocalHostContract proves the orchestration against a simulator only.\nObservedHostContract is a contract over a caller-supplied driver: every field\n(ingress, unknown writers, queue counts, health, digests) is driver-reported,\nnever independent host evidence, so receipts carry host_verified=False. Queue\ncounts cannot prove contents or quiescence. It may resume the pinned legacy\nonly while no DDL marker is journaled; marker absence is no proof that DDL did\nnot run elsewhere. The resume token binds the host identity, not a human\napproval. Partial containment or an abnormal exit is refused fail-closed; there\nis no automatic recovery. Checks run immediately before each effect and again\nafter it, without any atomicity over the driver or host; each resume effect is\nalso judged, without new IO, on the port's own final snapshot via a guard. Its\njournal is never shared with the local adapter (adapter-*/local-host-*). No SSH, Docker client,\ngate setter, real executor or deploy operation is provided here.\n\"\"\"\nfrom __future__ import annotations\n\nimport re\n\nfrom first_transition_adapter import ROLES, digest\nfrom initial_transition_ops import Refused, require\n\nFIELDS = frozenset({'id', 'image', 'revision', 'compose_project', 'compose_service',\n                    'started', 'restart_count', 'restart_policy', 'running', 'exit_code',\n                    'gates_digest', 'mounts_digest', 'networks_digest'})\nDYNAMIC = frozenset({'restart_policy', 'running', 'exit_code'})\nHEX = re.compile('[0-9a-f]{64}')\nRESUMABLE = frozenset({'started', 'restart_count'})\nSTART_ORDER = ('backend', 'queue-worker', 'broadcast-worker', 'cron-worker')\n\n\nclass LocalHostContract:\n    def __init__(self, port, journal):\n        self.port, self.j = port, journal\n\n    def _call(self, operation, *args):\n        try:\n            return getattr(self.port, operation)(*args)\n        except TimeoutError:\n            raise Refused('local-host-timeout') from None\n        except Exception:\n            raise Refused('local-host-effect-failed') from None\n\n    def _snapshot(self):\n        data = self._call('snapshot')\n        require(isinstance(data, dict) and set(data) == {\n            'mode', 'ingress_blocked', 'support_digest', 'unknown_writers', 'services'}, 'local-host-shape')\n        require(data['mode'] == 'local-simulation', 'local-host-simulation-required')\n        require(type(data['ingress_blocked']) is bool\n                and isinstance(data['support_digest'], str) and HEX.fullmatch(data['support_digest']),\n                'local-host-shape')\n        require(type(data['unknown_writers']) is int and data['unknown_writers'] == 0,\n                'local-host-unknown-writer')\n        services = data['services']\n        require(isinstance(services, dict) and set(services) == set(ROLES), 'local-host-services')\n        for role, state in services.items():\n            require(isinstance(state, dict) and set(state) == FIELDS, 'local-host-service-shape')\n            require(isinstance(state['id'], str) and HEX.fullmatch(state['id'])\n                    and isinstance(state['image'], str) and re.fullmatch(r'sha256:[0-9a-f]{64}', state['image'])\n                    and (state['revision'] is None or isinstance(state['revision'], str)\n                         and re.fullmatch('[0-9a-f]{40}', state['revision'])), 'local-host-identity')\n            require(type(state['running']) is bool and type(state['restart_count']) is int\n                    and state['restart_count'] >= 0 and state['restart_policy'] in ('always', 'no')\n                    and (state['exit_code'] is None or type(state['exit_code']) is int)\n                    and isinstance(state['started'], str)\n                    and re.fullmatch(r'[A-Za-z0-9_.:+-]{1,64}', state['started']), 'local-host-state')\n            require(all(isinstance(state[key], str) and HEX.fullmatch(state[key])\n                        for key in ('gates_digest', 'mounts_digest', 'networks_digest')), 'local-host-digest')\n            if role == 'broadcast-worker':\n                require(state['compose_project'] is None and state['compose_service'] is None,\n                        'local-host-broadcast-must-be-standalone')\n            else:\n                require(state['compose_service'] == role and isinstance(state['compose_project'], str)\n                        and re.fullmatch('[A-Za-z0-9_-]{1,63}', state['compose_project']), 'local-host-compose')\n        require(len({s['id'] for s in services.values()}) == 4, 'local-host-duplicate-identity')\n        require(len({s['compose_project'] for role, s in services.items() if role != 'broadcast-worker'}) == 1,\n                'local-host-compose-projects')\n        fingerprint = digest([data['support_digest'], {\n            role: {key: state[key] for key in sorted(FIELDS - DYNAMIC)} for role, state in services.items()}])\n        baseline = self.j.last('local-host-init')\n        if baseline:\n            require(fingerprint == baseline['fingerprint'], 'local-host-identity-or-support-changed')\n        return data, fingerprint\n\n    def _intent(self, step):\n        if self.j.last('local-host-intent', step) is None:\n            self.j.append('local-host-intent', step=step)\n\n    def _done(self, step):\n        if self.j.last('local-host-done', step) is None:\n            self.j.append('local-host-done', step=step)\n\n    def assert_contained(self):\n        require(self.j.last('local-host-init') is not None, 'local-host-unobserved')\n        data, fingerprint = self._snapshot()\n        require(data['ingress_blocked'], 'local-host-ingress-open')\n        for state in data['services'].values():\n            require(state['restart_policy'] == 'no' and not state['running'] and state['exit_code'] == 0,\n                    'local-host-not-cleanly-contained')\n        return dict(mode='local-simulation', fingerprint=fingerprint, stopped_roles=ROLES,\n                    host_verified=False)\n\n    def contain(self):\n        data, fingerprint = self._snapshot()\n        if self.j.last('local-host-init') is None:\n            require(all(s['running'] and s['restart_policy'] == 'always' for s in data['services'].values()),\n                    'local-host-baseline-state')\n            self.j.append('local-host-init', fingerprint=fingerprint, mode='local-simulation')\n        if self.j.last('local-host-done', 'ingress'):\n            require(data['ingress_blocked'], 'local-host-ingress-reopened')\n        if not data['ingress_blocked']:\n            self._intent('ingress')\n            self._call('block_ingress')\n        require(self._snapshot()[0]['ingress_blocked'], 'local-host-ingress-open')\n        self._done('ingress')\n        for role in ROLES:\n            state = self._snapshot()[0]['services'][role]\n            step = 'restart-no:' + role\n            if self.j.last('local-host-done', step):\n                require(state['restart_policy'] == 'no', 'local-host-restart-reenabled')\n            if state['restart_policy'] != 'no':\n                self._intent(step)\n                self._call('disable_restart', state['id'])\n            require(self._snapshot()[0]['services'][role]['restart_policy'] == 'no',\n                    'local-host-restart-not-disabled')\n            self._done(step)\n            state = self._snapshot()[0]['services'][role]\n            step = 'term:' + role\n            if self.j.last('local-host-done', step):\n                require(not state['running'], 'local-host-restarted')\n            if state['running']:\n                # An unreceipted SIGTERM may already have been delivered. Wait;\n                # do not blindly signal again or escalate to SIGKILL/restart.\n                if self.j.last('local-host-intent', step) is None:\n                    self._intent(step)\n                    self._call('signal_term', state['id'])\n                self._call('wait_stopped', state['id'], 30)\n            state = self._snapshot()[0]['services'][role]\n            require(not state['running'] and state['exit_code'] == 0, 'local-host-exit-not-clean')\n            self._done(step)\n        receipt = self.assert_contained()\n        if self.j.last('local-host-contained') is None:\n            self.j.append('local-host-contained', **receipt)\n        return receipt\n\n\ndef _observed_services(services):\n    require(isinstance(services, dict) and set(services) == set(ROLES), 'observed-host-services')\n    for role, state in services.items():\n        require(isinstance(state, dict) and set(state) == FIELDS, 'observed-host-service-shape')\n        require(isinstance(state['id'], str) and HEX.fullmatch(state['id'])\n                and isinstance(state['image'], str) and re.fullmatch(r'sha256:[0-9a-f]{64}', state['image'])\n                and (state['revision'] is None or isinstance(state['revision'], str)\n                     and re.fullmatch('[0-9a-f]{40}', state['revision'])), 'observed-host-identity')\n        require(type(state['running']) is bool and type(state['restart_count']) is int\n                and state['restart_count'] >= 0 and state['restart_policy'] in ('always', 'no')\n                and (state['exit_code'] is None or type(state['exit_code']) is int)\n                and isinstance(state['started'], str)\n                and re.fullmatch(r'[A-Za-z0-9_.:+-]{1,64}', state['started']), 'observed-host-state')\n        require(all(isinstance(state[key], str) and HEX.fullmatch(state[key])\n                    for key in ('gates_digest', 'mounts_digest', 'networks_digest')), 'observed-host-digest')\n        if role == 'broadcast-worker':\n            require(state['compose_project'] is None and state['compose_service'] is None,\n                    'observed-host-broadcast-must-be-standalone')\n        else:\n            require(state['compose_service'] == role and isinstance(state['compose_project'], str)\n                    and re.fullmatch('[A-Za-z0-9_-]{1,63}', state['compose_project']), 'observed-host-compose')\n    require(len({s['id'] for s in services.values()}) == 4, 'observed-host-duplicate-identity')\n    require(len({s['compose_project'] for role, s in services.items() if role != 'broadcast-worker'}) == 1,\n            'observed-host-compose-projects')\n\n\nclass ObservedHostContract:\n    def __init__(self, port, journal):\n        self.port, self.j = port, journal\n\n    def _call(self, operation, *args):\n        try:\n            return getattr(self.port, operation)(*args)\n        except TimeoutError:\n            raise Refused('observed-host-timeout') from None\n        except Exception:\n            raise Refused('observed-host-effect-failed') from None\n\n    def _assert_own_journal(self):\n        require(not any(event['kind'].startswith(('adapter-', 'local-host-')) for event in self.j.events),\n                'observed-host-journal-mixed')\n\n    def _snapshot(self, data=None):\n        # data: a port's final snapshot handed to a pre-effect guard, validated without new IO.\n        self._assert_own_journal()\n        if data is None:\n            data = self._call('snapshot')\n        require(isinstance(data, dict) and set(data) == {\n            'mode', 'scope_digest', 'ingress_blocked', 'support_digest', 'unknown_writers', 'queue_digest', 'queue_counts',\n            'services'}, 'observed-host-shape')\n        require(data['mode'] == 'observed-host', 'observed-host-required')\n        require(isinstance(data['scope_digest'], str) and HEX.fullmatch(data['scope_digest']),\n                'observed-host-scope')\n        require(type(data['ingress_blocked']) is bool\n                and isinstance(data['support_digest'], str) and HEX.fullmatch(data['support_digest']),\n                'observed-host-shape')\n        require(type(data['unknown_writers']) is int and data['unknown_writers'] == 0,\n                'observed-host-unknown-writer')\n        counts = data['queue_counts']\n        require(isinstance(data['queue_digest'], str) and HEX.fullmatch(data['queue_digest'])\n                and isinstance(counts, dict) and counts\n                and all(isinstance(k, str) and type(v) is int and v >= 0 for k, v in counts.items()),\n                'observed-host-queue')\n        services = data['services']\n        _observed_services(services)\n        # started/restart_count legitimately change on resume; un-resumed roles keep\n        # their baseline and resumed roles keep their receipted fresh start.\n        fingerprint = digest([data['scope_digest'], data['support_digest'], {\n            role: {key: state[key] for key in sorted(FIELDS - DYNAMIC - RESUMABLE)}\n            for role, state in services.items()}])\n        baseline = self.j.last('observed-host-init')\n        if baseline:\n            require(fingerprint == baseline['fingerprint'], 'observed-host-identity-or-support-changed')\n            for role, state in services.items():\n                step = 'legacy-resume:' + role\n                if self.j.last('observed-host-intent', step) is None:\n                    require(state['started'] == baseline['initial_started'][role]\n                            and state['restart_count'] == baseline['initial_restarts'][role],\n                            'observed-host-identity-or-support-changed')\n                done = self.j.last('observed-host-done', step)\n                if done:\n                    require(state['running'] is True and state['restart_policy'] == 'always'\n                            and state['restart_count'] == 0 and state['started'] == done['started'],\n                            'observed-host-resumed-state-changed')\n        return data, fingerprint\n\n    def _intent(self, step):\n        if self.j.last('observed-host-intent', step) is None:\n            self.j.append('observed-host-intent', step=step)\n\n    def _done(self, step):\n        if self.j.last('observed-host-done', step) is None:\n            self.j.append('observed-host-done', step=step)\n\n    def assert_contained(self):\n        self._assert_own_journal()\n        # Once a resume is intended the host is never containment evidence again.\n        require(self.j.last('observed-host-intent', 'legacy-resume') is None, 'observed-host-resume-started')\n        settled = self.j.last('observed-host-settled')\n        require(self.j.last('observed-host-init') is not None and settled is not None,\n                'observed-host-unobserved')\n        data, fingerprint = self._contain_observe()\n        require(data['ingress_blocked'] is True, 'observed-host-ingress-open')\n        for state in data['services'].values():\n            require(state['restart_policy'] == 'no' and not state['running'] and state['exit_code'] == 0,\n                    'observed-host-not-cleanly-contained')\n        require(data['queue_digest'] == settled['queue_digest'], 'observed-host-queue-drift')\n        return dict(mode='observed-host', evidence='driver-reported', fingerprint=fingerprint,\n                    queue_digest=settled['queue_digest'], stopped_roles=ROLES, host_verified=False,\n                    quiescence_proven=False)\n\n    def contain(self):\n        self._assert_own_journal()\n        require(self.j.last('observed-host-intent', 'legacy-resume') is None, 'observed-host-resume-started')\n        data, fingerprint = self._contain_observe()\n        if self.j.last('observed-host-init') is None:\n            require(all(s['running'] and s['restart_policy'] == 'always' for s in data['services'].values()),\n                    'observed-host-baseline-state')\n            self.j.append('observed-host-init', fingerprint=fingerprint, mode='observed-host',\n                          scope_digest=data['scope_digest'],\n                          evidence='driver-reported', host_verified=False,\n                          initial_started={role: data['services'][role]['started'] for role in ROLES},\n                          initial_restarts={role: data['services'][role]['restart_count'] for role in ROLES})\n        if self.j.last('observed-host-done', 'ingress'):\n            require(data['ingress_blocked'], 'observed-host-ingress-reopened')\n        if not data['ingress_blocked']:\n            self._intent('ingress')\n            self._effect('block_ingress', self._contain_snapshot)\n        require(self._contain_observe()[0]['ingress_blocked'] is True, 'observed-host-ingress-open')\n        self._done('ingress')\n        for role in ROLES:\n            state = self._contain_observe()[0]['services'][role]\n            step = 'restart-no:' + role\n            if self.j.last('observed-host-done', step):\n                require(state['restart_policy'] == 'no', 'observed-host-restart-reenabled')\n            if state['restart_policy'] != 'no':\n                self._intent(step)\n                self._effect('disable_restart', self._contain_snapshot, state['id'])\n            require(self._contain_observe()[0]['services'][role]['restart_policy'] == 'no',\n                    'observed-host-restart-not-disabled')\n            self._done(step)\n            state = self._contain_observe()[0]['services'][role]\n            step = 'term:' + role\n            if self.j.last('observed-host-done', step):\n                require(not state['running'], 'observed-host-restarted')\n            if state['running']:\n                # Never re-signal an unreceipted SIGTERM; wait or hold.\n                if self.j.last('observed-host-intent', step) is None:\n                    self._intent(step)\n                    self._effect('signal_term', self._contain_snapshot, state['id'])\n                self._call('wait_stopped', state['id'], 30)\n            state = self._contain_observe()[0]['services'][role]\n            require(not state['running'] and state['exit_code'] == 0, 'observed-host-exit-not-clean')\n            self._done(step)\n        settled_data = self._contain_observe()[0]\n        if self.j.last('observed-host-settled') is None:\n            self.j.append('observed-host-settled', queue_digest=settled_data['queue_digest'],\n                          queue_counts=settled_data['queue_counts'], evidence='driver-reported',\n                          quiescence_proven=False)\n        receipt = self.assert_contained()\n        if self.j.last('observed-host-contained') is None:\n            self.j.append('observed-host-contained', **receipt)\n        return receipt\n\n    def _contain_observe(self):\n        data, fingerprint = self._snapshot()\n        if self.j.last('observed-host-init') is not None:\n            self._contain_snapshot(data)  # validate adoption/phase without another port read\n        return data, fingerprint\n\n    def _contain_snapshot(self, data=None):\n        require(self.j.last('observed-host-intent', 'legacy-resume') is None, 'observed-host-resume-started')\n        data, _ = self._snapshot(data)\n        if self.j.last('observed-host-done', 'ingress'):\n            require(data['ingress_blocked'] is True, 'observed-host-ingress-reopened')\n        for role, state in data['services'].items():\n            if self.j.last('observed-host-intent', 'restart-no:' + role) is None:\n                require(state['restart_policy'] == 'always', 'observed-host-unintended-policy')\n            if self.j.last('observed-host-done', 'restart-no:' + role):\n                require(state['restart_policy'] == 'no', 'observed-host-restart-reenabled')\n            if self.j.last('observed-host-intent', 'term:' + role) is None:\n                require(state['running'] is True, 'observed-host-unintended-stop')\n            elif not state['running']:\n                require(state['exit_code'] == 0, 'observed-host-exit-not-clean')\n            if self.j.last('observed-host-done', 'term:' + role):\n                require(not state['running'], 'observed-host-restarted')\n        return data\n\n    def resume_token(self):\n        init = self.j.last('observed-host-init')\n        require(init is not None, 'observed-host-unobserved')\n        return 'RESUME:' + init['fingerprint']\n\n    def _assert_pre_ddl(self):\n        # Journal-only guard, re-read before each effect and after each observation.\n        # It cannot see DDL performed outside this journal; that needs a DB proof.\n        require(self.j.last('adapter-ddl-marker') is None and self.j.last('ddl-marker') is None,\n                'post-ddl-resume-forbidden')\n\n    def _resume_snapshot(self, data=None):\n        self._assert_pre_ddl()  # keeps priority over the mixed-journal refusal\n        data, _ = self._snapshot(data)\n        self._assert_pre_ddl()\n        self._check_resume_roles(data)\n        if self.j.last('observed-host-intent', 'open-ingress') is None:\n            # Ingress stays blocked through any partial resume until its opening is intended.\n            require(data['ingress_blocked'] is True, 'observed-host-ingress-open')\n        return data\n\n    def _check_resume_roles(self, data):\n        # Every role must match its phase on every observation, not just the target.\n        init = self.j.last('observed-host-init')\n        for role, state in data['services'].items():\n            step = 'legacy-resume:' + role\n            if self.j.last('observed-host-done', step) is not None:\n                continue  # _snapshot already proves the receipted fresh running state.\n            if self.j.last('observed-host-intent', step) is None:\n                require(not state['running'], 'observed-host-resume-not-fresh')\n                require(state['restart_policy'] == 'no' and state['exit_code'] == 0,\n                        'observed-host-not-cleanly-contained')\n            elif state['running']:\n                self._check_fresh(state, role, init)\n            else:\n                require(state['restart_policy'] == 'no' and state['exit_code'] == 0\n                        and state['started'] == init['initial_started'][role]\n                        and state['restart_count'] == init['initial_restarts'][role],\n                        'observed-host-resume-not-fresh')\n\n    def _effect(self, operation, check, *args):\n        # The port must pass its own final snapshot to the guard and emit only after\n        # it returns; a guard refusal keeps its contract code, a skipped guard refuses.\n        outcome = []\n        def guard(final):\n            try:\n                check(final)\n            except Refused as exc:\n                outcome.append(exc)\n                raise\n            outcome.append(True)\n        try:\n            self._call(operation, *args, guard)\n        except Refused:\n            refusals = [item for item in outcome if isinstance(item, Refused)]\n            if refusals:\n                raise refusals[0] from None\n            raise\n        require(True in outcome, 'observed-host-guard-skipped')\n\n    def _start_observed(self, data, init):\n        # An actual start: receipted, or intended with a verifiably fresh start.\n        # A running or changed role without both is inconsistent and refused.\n        observed = False\n        for role in ROLES:\n            step = 'legacy-resume:' + role\n            if self.j.last('observed-host-done', step) is not None:\n                observed = True\n                continue\n            state = data['services'][role]\n            if state['running'] or state['started'] != init['initial_started'][role]:\n                require(self.j.last('observed-host-intent', step) is not None and state['running'] is True\n                        and state['restart_count'] == 0 and state['started'] != init['initial_started'][role],\n                        'observed-host-resume-not-fresh')\n                observed = True\n        return observed\n\n    def _check_start(self, data, role, init, settled, allow_queue_drift):\n        # Only a never-started container may be started; the queue gate holds until an actual start.\n        state = data['services'][role]\n        require(not state['running'] and state['exit_code'] == 0 and state['started'] == init['initial_started'][role]\n                and state['restart_count'] == init['initial_restarts'][role]\n                and state['restart_policy'] == 'no', 'observed-host-resume-not-fresh')\n        if not self._start_observed(data, init):\n            self._queue_gate(data, settled, allow_queue_drift)\n\n    def _check_fresh(self, state, role, init):\n        require(state['running'] is True and state['restart_count'] == 0\n                and state['started'] != init['initial_started'][role], 'observed-host-resume-not-fresh')\n        return state\n\n    def _queue_gate(self, data, settled, allow_queue_drift):\n        # Before the first actual start the queue must match the settled baseline or\n        # the drift is explicitly accepted and journaled before the effect.\n        if data['queue_digest'] != settled['queue_digest']:\n            require(allow_queue_drift is True, 'observed-host-queue-drift')\n            accepted = self.j.last('observed-host-queue-drift-accepted')\n            if accepted is None or accepted['current_digest'] != data['queue_digest']:\n                self.j.append('observed-host-queue-drift-accepted', settled_digest=settled['queue_digest'],\n                              current_digest=data['queue_digest'])\n\n    def resume_legacy(self, confirmation, expected_token=None, *, allow_queue_drift=False):\n        self._assert_pre_ddl()\n        self._assert_own_journal()\n        require(getattr(self.port, 'supports_resume', False) is True, 'observed-host-resume-unavailable')\n        require(self.j.last('observed-host-contained') is not None, 'observed-host-not-contained')\n        token = self.resume_token()  # bound to this journal's observed host; not a human approval\n        require(expected_token is None or expected_token == token, 'observed-host-resume-confirmation')\n        if self.j.last('observed-host-intent', 'legacy-resume') is None:\n            require(confirmation == token, 'observed-host-resume-confirmation')\n        init = self.j.last('observed-host-init')\n        settled = self.j.last('observed-host-settled')\n        data = self._resume_snapshot()\n        if not self._start_observed(data, init):\n            for state in data['services'].values():\n                require(not state['running'] and state['exit_code'] == 0 and state['restart_policy'] == 'no',\n                        'observed-host-not-cleanly-contained')\n            self._queue_gate(data, settled, allow_queue_drift)\n        else:\n            require(self.j.last('observed-host-intent', 'legacy-resume') is not None,\n                    'observed-host-not-contained')\n        self._intent('legacy-resume')\n        for role in START_ORDER:\n            step = 'legacy-resume:' + role\n            if self.j.last('observed-host-done', step) is not None:\n                continue  # _snapshot() keeps re-validating the receipted fresh start\n            if self.j.last('observed-host-intent', step) is None:\n                state = self._resume_snapshot()['services'][role]\n                require(not state['running'] and state['exit_code'] == 0 and state['restart_policy'] == 'no',\n                        'observed-host-not-cleanly-contained')\n                self._intent(step)\n            # Re-observed after the intent, immediately before the effect (first run or replay).\n            data = self._resume_snapshot()\n            state = data['services'][role]\n            if not state['running']:\n                self._check_start(data, role, init, settled, allow_queue_drift)\n                # Start before restart=always: never a stopped container with restart=always.\n                self._effect('start_service', lambda final, role=role: self._check_start(\n                    self._resume_snapshot(final), role, init, settled, allow_queue_drift), state['id'])\n            state = self._check_fresh(self._resume_snapshot()['services'][role], role, init)\n            if state['restart_policy'] != 'always':\n                self._effect('enable_restart', lambda final, role=role: self._check_fresh(\n                    self._resume_snapshot(final)['services'][role], role, init), state['id'])\n            state = self._resume_snapshot()['services'][role]\n            require(state['restart_policy'] == 'always', 'observed-host-restart-not-enabled')\n            self._check_fresh(state, role, init)\n            self.j.append('observed-host-done', step=step, started=state['started'])\n        if self.j.last('observed-host-done', 'open-ingress') is None:\n            if self.j.last('observed-host-intent', 'open-ingress') is None:\n                self._resume_snapshot()  # still blocked and pre-DDL right before authorizing it\n                self._intent('open-ingress')\n            if self._resume_snapshot()['ingress_blocked']:\n                # _snapshot() re-validates every receipted fresh start on the final observation.\n                self._effect('open_ingress', self._resume_snapshot)\n            require(not self._resume_snapshot()['ingress_blocked'], 'observed-host-ingress-still-blocked')\n            self._done('open-ingress')\n        # Every call, terminal replay included, re-proves the resumed host.\n        final_data = self._resume_snapshot()\n        require(final_data['ingress_blocked'] is False, 'observed-host-ingress-still-blocked')\n        if self.j.last('observed-host-resumed') is None:\n            self.j.append('observed-host-resumed', resumed_roles=START_ORDER, evidence='driver-reported')\n        return dict(mode='observed-host', status='legacy-resumed', resumed_roles=START_ORDER,\n                    ingress_blocked=False, evidence='driver-reported', host_verified=False)\n","numLines":499,"startLine":1,"totalLines":499}},"tool_result_meta":[{"id":"toolu_01AQbo13FVq5EvDXin1xUGcM","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgYdFh44rMayJTd5fFeT9","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014UDACGBJx6n32mhUs5Sz1N","name":"Read","input":{"file_path":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_host_transport.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":13186,"cache_read_input_tokens":34497,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":13186},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6f5f5b47-c66e-4591-b756-d99024a874c5","uuid":"e5341f66-0247-4fa7-992c-ce39ce8361f8","timestamp":"2026-10-30T15:03:45.518Z","request_id":"req_011CgYdFgb3HeHXcbbEX9hn6","wire_tool_inputs":{"toolu_014UDACGBJx6n32mhUs5Sz1N":{"file_path":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_host_transport.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014UDACGBJx6n32mhUs5Sz1N","type":"tool_result","content":"1\t\"\"\"Command encoding for caller-supplied host drivers; no process or network executor.\n2\t\n3\tThe mandatory driver supplies sanitized metadata, not raw Docker inspect/env.\n4\tIngress remains a semantic operation: no guessed Nginx/Evolution command.\n5\tThe simulated transport cannot certify a real host. The observed transport only\n6\trestarts the four pinned legacy identities; it provides no deploy operation.\n7\tIt validates shape and binds identities, but every value is driver-reported:\n8\tit is no real executor, inventory or ingress implementation, and queue counts\n9\tprove neither contents nor quiescence. A reviewed real driver remains pending.\n10\tThe resume effects (start, restart=always, open-ingress) require a caller guard:\n11\tthe transport hands it its own final snapshot and emits the command only after\n12\tthe guard returns. Without a guard they refuse before any call; the bare\n13\ttransport is an unauthorized encoder, never a resume authority.\n14\t\"\"\"\n15\tfrom __future__ import annotations\n16\t\n17\tfrom copy import deepcopy\n18\timport re\n19\t\n20\tfrom first_transition_adapter import ROLES, digest, queue_metadata\n21\tfrom initial_transition_ops import Refused, require\n22\t\n23\tSUPPORT_ROLES = ('redis', 'evolution-postgres', 'evolution-api')\n24\tSUPPORT_FIELDS = frozenset({'id', 'image', 'compose_project', 'compose_service', 'running',\n25\t                            'restart_policy', 'health', 'networks_digest'})\n26\tSERVICE_FIELDS = frozenset({'id', 'image', 'revision', 'compose_project', 'compose_service', 'started',\n27\t                            'restart_count', 'restart_policy', 'running', 'exit_code', 'gates_digest',\n28\t                            'mounts_digest', 'networks_digest'})\n29\t\n30\t\n31\tdef host_command(operation, identifier):\n32\t    \"\"\"Pure encoder shared with the separately authorized disposable probe.\"\"\"\n33\t    require(isinstance(identifier, str) and re.fullmatch('[0-9a-f]{64}', identifier), 'transport-target')\n34\t    commands = {'restart-no': ('docker', 'update', '--restart=no', identifier),\n35\t                'term': ('docker', 'kill', '--signal=TERM', identifier),\n36\t                'wait': ('docker', 'wait', identifier),\n37\t                'restart-always': ('docker', 'update', '--restart=always', identifier),\n38\t                'start': ('docker', 'start', identifier)}\n39\t    require(operation in commands, 'transport-operation')\n40\t    return commands[operation]\n41\t\n42\t\n43\tclass SimulatedHostTransport:\n44\t    def __init__(self, driver):\n45\t        require(getattr(driver, 'mode', None) == 'local-simulation', 'transport-simulation-required')\n46\t        self.driver = driver\n47\t        self.identities = None\n48\t\n49\t    def _request(self, argv, timeout):\n50\t        require(getattr(self.driver, 'mode', None) == 'local-simulation', 'transport-simulation-required')\n51\t        try:\n52\t            return self.driver.request(tuple(argv), timeout=timeout)\n53\t        except TimeoutError:\n54\t            raise TimeoutError('simulated-transport-timeout') from None\n55\t        except Exception:\n56\t            raise Refused('simulated-transport-failed') from None\n57\t\n58\t    def snapshot(self):\n59\t        data = self._request(('snapshot-metadata',), 5)\n60\t        require(isinstance(data, dict) and data.get('mode') == 'local-simulation', 'transport-snapshot')\n61\t        services = data.get('services')\n62\t        require(isinstance(services, dict) and set(services) == set(ROLES), 'transport-scope')\n63\t        identities = {role: state.get('id') if isinstance(state, dict) else None\n64\t                      for role, state in services.items()}\n65\t        require(all(isinstance(value, str) and re.fullmatch('[0-9a-f]{64}', value)\n66\t                    for value in identities.values()) and len(set(identities.values())) == 4,\n67\t                'transport-identities')\n68\t        if self.identities is None:\n69\t            self.identities = identities\n70\t        require(identities == self.identities, 'transport-identity-changed')\n71\t        # Full shape/topology/gates validation remains in LocalHostContract.\n72\t        return deepcopy(data)\n73\t\n74\t    def _target(self, identifier):\n75\t        require(self.identities is not None and identifier in self.identities.values(), 'transport-target')\n76\t        self.snapshot()  # Detect replacement immediately before a simulated effect.\n77\t\n78\t    def block_ingress(self):\n79\t        require(self.identities is not None, 'transport-unobserved')\n80\t        self.snapshot()\n81\t        require(self._request(('block-ingress',), 5) is True, 'transport-ingress-receipt')\n82\t\n83\t    def disable_restart(self, identifier):\n84\t        self._target(identifier)\n85\t        require(self._request(host_command('restart-no', identifier), 5) is True,\n86\t                'transport-restart-receipt')\n87\t\n88\t    def signal_term(self, identifier):\n89\t        self._target(identifier)\n90\t        require(self._request(host_command('term', identifier), 5) is True,\n91\t                'transport-signal-receipt')\n92\t\n93\t    def wait_stopped(self, identifier, timeout):\n94\t        require(type(timeout) is int and 0 < timeout <= 30, 'transport-wait-bound')\n95\t        self._target(identifier)\n96\t        status = self._request(host_command('wait', identifier), timeout)\n97\t        require(type(status) is int and status == 0, 'transport-exit-not-clean')\n98\t\n99\t\n100\tdef _ids(value, roles):\n101\t    return (isinstance(value, dict) and set(value) == set(roles)\n102\t            and all(isinstance(v, str) and re.fullmatch('[0-9a-f]{64}', v) for v in value.values())\n103\t            and len(set(value.values())) == len(roles))\n104\t\n105\t\n106\tclass ObservedHostTransport:\n107\t    def __init__(self, driver, *, legacy_project, network_id, service_ids, support_ids, processing_keys=()):\n108\t        require(getattr(driver, 'mode', None) == 'observed-host', 'transport-observed-required')\n109\t        require(isinstance(legacy_project, str) and re.fullmatch(r'[A-Za-z0-9_-]{1,63}', legacy_project),\n110\t                'transport-project')\n111\t        require(isinstance(network_id, str) and re.fullmatch('[0-9a-f]{64}', network_id), 'transport-network')\n112\t        require(_ids(service_ids, ROLES), 'transport-identities')\n113\t        require(_ids(support_ids, SUPPORT_ROLES) and not set(support_ids.values()) & set(service_ids.values()),\n114\t                'transport-support-identities')\n115\t        self.driver, self.legacy_project, self.network_id = driver, legacy_project, network_id\n116\t        self.identities, self.support_ids = dict(service_ids), dict(support_ids)\n117\t        self.processing_keys = processing_keys  # validated by queue_metadata on every snapshot\n118\t        self.support_digest = None\n119\t        self.scope_digest = None\n120\t\n121\t    @property\n122\t    def supports_resume(self):\n123\t        return getattr(self.driver, 'supports_resume', False) is True\n124\t\n125\t    def _request(self, argv, timeout):\n126\t        require(getattr(self.driver, 'mode', None) == 'observed-host', 'transport-observed-required')\n127\t        try:\n128\t            return self.driver.request(tuple(argv), timeout=timeout)\n129\t        except TimeoutError:\n130\t            raise TimeoutError('observed-transport-timeout') from None\n131\t        except Exception:\n132\t            raise Refused('observed-transport-failed') from None\n133\t\n134\t    def snapshot(self):\n135\t        declared = getattr(self.driver, 'transport_scope', None)\n136\t        if callable(declared):\n137\t            require(declared() == dict(legacy_project=self.legacy_project, network_id=self.network_id,\n138\t                                      service_ids=self.identities, support_ids=self.support_ids,\n139\t                                      processing_keys=self.processing_keys), 'transport-driver-scope')\n140\t        raw = self._request(('inspect-host',), 10)\n141\t        require(isinstance(raw, dict) and set(raw) == {\n142\t            'scope_digest', 'ingress_blocked', 'unknown_writers', 'network_id', 'services', 'support'}, 'transport-snapshot')\n143\t        require(isinstance(raw['scope_digest'], str) and re.fullmatch('[0-9a-f]{64}', raw['scope_digest']),\n144\t                'transport-scope-digest')\n145\t        if self.scope_digest is None:\n146\t            self.scope_digest = raw['scope_digest']\n147\t        require(raw['scope_digest'] == self.scope_digest, 'transport-scope-changed')\n148\t        require(raw['network_id'] == self.network_id, 'transport-network-mismatch')\n149\t        require(type(raw['ingress_blocked']) is bool and type(raw['unknown_writers']) is int\n150\t                and raw['unknown_writers'] >= 0, 'transport-snapshot')\n151\t        support = raw['support']\n152\t        require(isinstance(support, dict) and set(support) == set(SUPPORT_ROLES), 'transport-support-scope')\n153\t        for role, state in support.items():\n154\t            require(isinstance(state, dict) and set(state) == SUPPORT_FIELDS, 'transport-support-shape')\n155\t            require(state['id'] == self.support_ids[role], 'transport-support-identity-changed')\n156\t            require(isinstance(state['image'], str) and re.fullmatch(r'sha256:[0-9a-f]{64}', state['image']),\n157\t                    'transport-support-image')\n158\t            require(state['compose_project'] == self.legacy_project and state['compose_service'] == role,\n159\t                    'transport-support-compose')\n160\t            require(state['running'] is True and state['restart_policy'] == 'always',\n161\t                    'transport-support-not-running')\n162\t            require(state['health'] == 'healthy' if role in ('redis', 'evolution-postgres')\n163\t                    else state['health'] in ('healthy', None), 'transport-support-unhealthy')\n164\t            require(isinstance(state['networks_digest'], str)\n165\t                    and re.fullmatch('[0-9a-f]{64}', state['networks_digest']), 'transport-support-network')\n166\t        support_digest = digest([self.network_id, {role: support[role] for role in sorted(SUPPORT_ROLES)}])\n167\t        if self.support_digest is None:\n168\t            self.support_digest = support_digest\n169\t        require(support_digest == self.support_digest, 'transport-support-changed')\n170\t        services = raw['services']\n171\t        require(isinstance(services, dict) and set(services) == set(ROLES), 'transport-scope')\n172\t        require(all(isinstance(services[role], dict) and set(services[role]) == SERVICE_FIELDS\n173\t                    for role in ROLES), 'transport-service-shape')\n174\t        require({role: services[role]['id'] for role in ROLES} == self.identities, 'transport-identity-changed')\n175\t        require(all(services[role].get('compose_project') == self.legacy_project\n176\t                    for role in ROLES if role != 'broadcast-worker'), 'transport-compose')\n177\t        queue = queue_metadata(lambda command, key: self._request(('redis-meta', command, key), 5),\n178\t                               processing_keys=self.processing_keys)\n179\t        # Field types/topology/gates validation remains in ObservedHostContract;\n180\t        # only the declared keys leave the transport, never extra driver data.\n181\t        return dict(mode='observed-host', scope_digest=raw['scope_digest'], ingress_blocked=raw['ingress_blocked'], support_digest=support_digest,\n182\t                    unknown_writers=raw['unknown_writers'], queue_digest=queue['metadata_digest'],\n183\t                    queue_counts=queue['counts'],\n184\t                    services=deepcopy({role: {key: services[role][key] for key in SERVICE_FIELDS}\n185\t                                       for role in ROLES}))\n186\t\n187\t    def _target(self, identifier):\n188\t        require(identifier in self.identities.values(), 'transport-target')\n189\t        self.snapshot()  # Detect replacement immediately before a host effect.\n190\t\n191\t    def _guarded(self, guard, identifier=None):\n192\t        if identifier is not None:\n193\t            require(identifier in self.identities.values(), 'transport-target')\n194\t        require(callable(guard), 'transport-guard-required')\n195\t        # This final observation, not an earlier one, is what the guard judges.\n196\t        guard(self.snapshot())\n197\t\n198\t    def block_ingress(self, guard=None):\n199\t        self._guarded(guard)\n200\t        require(self._request(('block-ingress',), 5) is True, 'transport-ingress-receipt')\n201\t\n202\t    def open_ingress(self, guard=None):\n203\t        self._guarded(guard)\n204\t        require(self._request(('open-ingress',), 5) is True, 'transport-ingress-receipt')\n205\t\n206\t    def disable_restart(self, identifier, guard=None):\n207\t        self._guarded(guard, identifier)\n208\t        require(self._request(host_command('restart-no', identifier), 5) is True,\n209\t                'transport-restart-receipt')\n210\t\n211\t    def enable_restart(self, identifier, guard=None):\n212\t        self._guarded(guard, identifier)\n213\t        require(self._request(host_command('restart-always', identifier), 5) is True,\n214\t                'transport-restart-receipt')\n215\t\n216\t    def signal_term(self, identifier, guard=None):\n217\t        self._guarded(guard, identifier)\n218\t        require(self._request(host_command('term', identifier), 5) is True,\n219\t                'transport-signal-receipt')\n220\t\n221\t    def wait_stopped(self, identifier, timeout):\n222\t        require(type(timeout) is int and 0 < timeout <= 30, 'transport-wait-bound')\n223\t        self._target(identifier)\n224\t        status = self._request(host_command('wait', identifier), timeout)\n225\t        require(type(status) is int and status == 0, 'transport-exit-not-clean')\n226\t\n227\t    def start_service(self, identifier, guard=None):\n228\t        self._guarded(guard, identifier)\n229\t        require(self._request(host_command('start', identifier), 10) is True,\n230\t                'transport-start-receipt')\n231\t"}]},"parent_tool_use_id":null,"session_id":"6f5f5b47-c66e-4591-b756-d99024a874c5","uuid":"91a061fb-6a1a-41b9-828f-b343c63bdd64","timestamp":"2026-10-30T15:03:45.530Z","tool_use_result":{"type":"text","file":{"filePath":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_host_transport.py","content":"\"\"\"Command encoding for caller-supplied host drivers; no process or network executor.\n\nThe mandatory driver supplies sanitized metadata, not raw Docker inspect/env.\nIngress remains a semantic operation: no guessed Nginx/Evolution command.\nThe simulated transport cannot certify a real host. The observed transport only\nrestarts the four pinned legacy identities; it provides no deploy operation.\nIt validates shape and binds identities, but every value is driver-reported:\nit is no real executor, inventory or ingress implementation, and queue counts\nprove neither contents nor quiescence. A reviewed real driver remains pending.\nThe resume effects (start, restart=always, open-ingress) require a caller guard:\nthe transport hands it its own final snapshot and emits the command only after\nthe guard returns. Without a guard they refuse before any call; the bare\ntransport is an unauthorized encoder, never a resume authority.\n\"\"\"\nfrom __future__ import annotations\n\nfrom copy import deepcopy\nimport re\n\nfrom first_transition_adapter import ROLES, digest, queue_metadata\nfrom initial_transition_ops import Refused, require\n\nSUPPORT_ROLES = ('redis', 'evolution-postgres', 'evolution-api')\nSUPPORT_FIELDS = frozenset({'id', 'image', 'compose_project', 'compose_service', 'running',\n                            'restart_policy', 'health', 'networks_digest'})\nSERVICE_FIELDS = frozenset({'id', 'image', 'revision', 'compose_project', 'compose_service', 'started',\n                            'restart_count', 'restart_policy', 'running', 'exit_code', 'gates_digest',\n                            'mounts_digest', 'networks_digest'})\n\n\ndef host_command(operation, identifier):\n    \"\"\"Pure encoder shared with the separately authorized disposable probe.\"\"\"\n    require(isinstance(identifier, str) and re.fullmatch('[0-9a-f]{64}', identifier), 'transport-target')\n    commands = {'restart-no': ('docker', 'update', '--restart=no', identifier),\n                'term': ('docker', 'kill', '--signal=TERM', identifier),\n                'wait': ('docker', 'wait', identifier),\n                'restart-always': ('docker', 'update', '--restart=always', identifier),\n                'start': ('docker', 'start', identifier)}\n    require(operation in commands, 'transport-operation')\n    return commands[operation]\n\n\nclass SimulatedHostTransport:\n    def __init__(self, driver):\n        require(getattr(driver, 'mode', None) == 'local-simulation', 'transport-simulation-required')\n        self.driver = driver\n        self.identities = None\n\n    def _request(self, argv, timeout):\n        require(getattr(self.driver, 'mode', None) == 'local-simulation', 'transport-simulation-required')\n        try:\n            return self.driver.request(tuple(argv), timeout=timeout)\n        except TimeoutError:\n            raise TimeoutError('simulated-transport-timeout') from None\n        except Exception:\n            raise Refused('simulated-transport-failed') from None\n\n    def snapshot(self):\n        data = self._request(('snapshot-metadata',), 5)\n        require(isinstance(data, dict) and data.get('mode') == 'local-simulation', 'transport-snapshot')\n        services = data.get('services')\n        require(isinstance(services, dict) and set(services) == set(ROLES), 'transport-scope')\n        identities = {role: state.get('id') if isinstance(state, dict) else None\n                      for role, state in services.items()}\n        require(all(isinstance(value, str) and re.fullmatch('[0-9a-f]{64}', value)\n                    for value in identities.values()) and len(set(identities.values())) == 4,\n                'transport-identities')\n        if self.identities is None:\n            self.identities = identities\n        require(identities == self.identities, 'transport-identity-changed')\n        # Full shape/topology/gates validation remains in LocalHostContract.\n        return deepcopy(data)\n\n    def _target(self, identifier):\n        require(self.identities is not None and identifier in self.identities.values(), 'transport-target')\n        self.snapshot()  # Detect replacement immediately before a simulated effect.\n\n    def block_ingress(self):\n        require(self.identities is not None, 'transport-unobserved')\n        self.snapshot()\n        require(self._request(('block-ingress',), 5) is True, 'transport-ingress-receipt')\n\n    def disable_restart(self, identifier):\n        self._target(identifier)\n        require(self._request(host_command('restart-no', identifier), 5) is True,\n                'transport-restart-receipt')\n\n    def signal_term(self, identifier):\n        self._target(identifier)\n        require(self._request(host_command('term', identifier), 5) is True,\n                'transport-signal-receipt')\n\n    def wait_stopped(self, identifier, timeout):\n        require(type(timeout) is int and 0 < timeout <= 30, 'transport-wait-bound')\n        self._target(identifier)\n        status = self._request(host_command('wait', identifier), timeout)\n        require(type(status) is int and status == 0, 'transport-exit-not-clean')\n\n\ndef _ids(value, roles):\n    return (isinstance(value, dict) and set(value) == set(roles)\n            and all(isinstance(v, str) and re.fullmatch('[0-9a-f]{64}', v) for v in value.values())\n            and len(set(value.values())) == len(roles))\n\n\nclass ObservedHostTransport:\n    def __init__(self, driver, *, legacy_project, network_id, service_ids, support_ids, processing_keys=()):\n        require(getattr(driver, 'mode', None) == 'observed-host', 'transport-observed-required')\n        require(isinstance(legacy_project, str) and re.fullmatch(r'[A-Za-z0-9_-]{1,63}', legacy_project),\n                'transport-project')\n        require(isinstance(network_id, str) and re.fullmatch('[0-9a-f]{64}', network_id), 'transport-network')\n        require(_ids(service_ids, ROLES), 'transport-identities')\n        require(_ids(support_ids, SUPPORT_ROLES) and not set(support_ids.values()) & set(service_ids.values()),\n                'transport-support-identities')\n        self.driver, self.legacy_project, self.network_id = driver, legacy_project, network_id\n        self.identities, self.support_ids = dict(service_ids), dict(support_ids)\n        self.processing_keys = processing_keys  # validated by queue_metadata on every snapshot\n        self.support_digest = None\n        self.scope_digest = None\n\n    @property\n    def supports_resume(self):\n        return getattr(self.driver, 'supports_resume', False) is True\n\n    def _request(self, argv, timeout):\n        require(getattr(self.driver, 'mode', None) == 'observed-host', 'transport-observed-required')\n        try:\n            return self.driver.request(tuple(argv), timeout=timeout)\n        except TimeoutError:\n            raise TimeoutError('observed-transport-timeout') from None\n        except Exception:\n            raise Refused('observed-transport-failed') from None\n\n    def snapshot(self):\n        declared = getattr(self.driver, 'transport_scope', None)\n        if callable(declared):\n            require(declared() == dict(legacy_project=self.legacy_project, network_id=self.network_id,\n                                      service_ids=self.identities, support_ids=self.support_ids,\n                                      processing_keys=self.processing_keys), 'transport-driver-scope')\n        raw = self._request(('inspect-host',), 10)\n        require(isinstance(raw, dict) and set(raw) == {\n            'scope_digest', 'ingress_blocked', 'unknown_writers', 'network_id', 'services', 'support'}, 'transport-snapshot')\n        require(isinstance(raw['scope_digest'], str) and re.fullmatch('[0-9a-f]{64}', raw['scope_digest']),\n                'transport-scope-digest')\n        if self.scope_digest is None:\n            self.scope_digest = raw['scope_digest']\n        require(raw['scope_digest'] == self.scope_digest, 'transport-scope-changed')\n        require(raw['network_id'] == self.network_id, 'transport-network-mismatch')\n        require(type(raw['ingress_blocked']) is bool and type(raw['unknown_writers']) is int\n                and raw['unknown_writers'] >= 0, 'transport-snapshot')\n        support = raw['support']\n        require(isinstance(support, dict) and set(support) == set(SUPPORT_ROLES), 'transport-support-scope')\n        for role, state in support.items():\n            require(isinstance(state, dict) and set(state) == SUPPORT_FIELDS, 'transport-support-shape')\n            require(state['id'] == self.support_ids[role], 'transport-support-identity-changed')\n            require(isinstance(state['image'], str) and re.fullmatch(r'sha256:[0-9a-f]{64}', state['image']),\n                    'transport-support-image')\n            require(state['compose_project'] == self.legacy_project and state['compose_service'] == role,\n                    'transport-support-compose')\n            require(state['running'] is True and state['restart_policy'] == 'always',\n                    'transport-support-not-running')\n            require(state['health'] == 'healthy' if role in ('redis', 'evolution-postgres')\n                    else state['health'] in ('healthy', None), 'transport-support-unhealthy')\n            require(isinstance(state['networks_digest'], str)\n                    and re.fullmatch('[0-9a-f]{64}', state['networks_digest']), 'transport-support-network')\n        support_digest = digest([self.network_id, {role: support[role] for role in sorted(SUPPORT_ROLES)}])\n        if self.support_digest is None:\n            self.support_digest = support_digest\n        require(support_digest == self.support_digest, 'transport-support-changed')\n        services = raw['services']\n        require(isinstance(services, dict) and set(services) == set(ROLES), 'transport-scope')\n        require(all(isinstance(services[role], dict) and set(services[role]) == SERVICE_FIELDS\n                    for role in ROLES), 'transport-service-shape')\n        require({role: services[role]['id'] for role in ROLES} == self.identities, 'transport-identity-changed')\n        require(all(services[role].get('compose_project') == self.legacy_project\n                    for role in ROLES if role != 'broadcast-worker'), 'transport-compose')\n        queue = queue_metadata(lambda command, key: self._request(('redis-meta', command, key), 5),\n                               processing_keys=self.processing_keys)\n        # Field types/topology/gates validation remains in ObservedHostContract;\n        # only the declared keys leave the transport, never extra driver data.\n        return dict(mode='observed-host', scope_digest=raw['scope_digest'], ingress_blocked=raw['ingress_blocked'], support_digest=support_digest,\n                    unknown_writers=raw['unknown_writers'], queue_digest=queue['metadata_digest'],\n                    queue_counts=queue['counts'],\n                    services=deepcopy({role: {key: services[role][key] for key in SERVICE_FIELDS}\n                                       for role in ROLES}))\n\n    def _target(self, identifier):\n        require(identifier in self.identities.values(), 'transport-target')\n        self.snapshot()  # Detect replacement immediately before a host effect.\n\n    def _guarded(self, guard, identifier=None):\n        if identifier is not None:\n            require(identifier in self.identities.values(), 'transport-target')\n        require(callable(guard), 'transport-guard-required')\n        # This final observation, not an earlier one, is what the guard judges.\n        guard(self.snapshot())\n\n    def block_ingress(self, guard=None):\n        self._guarded(guard)\n        require(self._request(('block-ingress',), 5) is True, 'transport-ingress-receipt')\n\n    def open_ingress(self, guard=None):\n        self._guarded(guard)\n        require(self._request(('open-ingress',), 5) is True, 'transport-ingress-receipt')\n\n    def disable_restart(self, identifier, guard=None):\n        self._guarded(guard, identifier)\n        require(self._request(host_command('restart-no', identifier), 5) is True,\n                'transport-restart-receipt')\n\n    def enable_restart(self, identifier, guard=None):\n        self._guarded(guard, identifier)\n        require(self._request(host_command('restart-always', identifier), 5) is True,\n                'transport-restart-receipt')\n\n    def signal_term(self, identifier, guard=None):\n        self._guarded(guard, identifier)\n        require(self._request(host_command('term', identifier), 5) is True,\n                'transport-signal-receipt')\n\n    def wait_stopped(self, identifier, timeout):\n        require(type(timeout) is int and 0 < timeout <= 30, 'transport-wait-bound')\n        self._target(identifier)\n        status = self._request(host_command('wait', identifier), timeout)\n        require(type(status) is int and status == 0, 'transport-exit-not-clean')\n\n    def start_service(self, identifier, guard=None):\n        self._guarded(guard, identifier)\n        require(self._request(host_command('start', identifier), 10) is True,\n                'transport-start-receipt')\n","numLines":231,"startLine":1,"totalLines":231}},"tool_result_meta":[{"id":"toolu_014UDACGBJx6n32mhUs5Sz1N","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
