{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HYeNDzzZsmQP764QpBSnjH","type":"tool_result","content":"80\t    require(len(keys) == len(set(keys)), 'contract-duplicate-key')\n81\t    return dict(pairs)\n82\t\n83\t\n84\tdef validate(data):\n85\t    require(isinstance(data, dict) and set(data) == {\n86\t        'schema', 'version', 'project', 'legacy_project', 'network', 'containers', 'reserved_legacy'},\n87\t        'contract-keys')\n88\t    require(data['schema'] == SCHEMA and type(data['version']) is int and data['version'] == VERSION,\n89\t            'contract-schema')\n90\t    for key in ('project', 'legacy_project'):\n91\t        require(isinstance(data[key], str) and PROJECT.fullmatch(data[key]), 'contract-project')\n92\t    require(data['project'] not in (data['legacy_project'], BASE_PROJECT), 'contract-project-is-legacy')\n93\t    network = data['network']\n94\t    require(isinstance(network, dict) and set(network) == {'name', 'id'}\n95\t            and isinstance(network['name'], str) and NETWORK.fullmatch(network['name'])\n96\t            and isinstance(network['id'], str) and RESOURCE_ID.fullmatch(network['id']), 'contract-network')\n97\t    for key, pattern in (('containers', CONTAINER), ('reserved_legacy', RESOURCE_ID)):\n98\t        values = data[key]\n99\t        require(isinstance(values, dict) and set(values) == set(SERVICES)\n100\t                and all(isinstance(v, str) and pattern.fullmatch(v) for v in values.values())\n101\t                and len(set(values.values())) == len(SERVICES), 'contract-' + key.replace('_', '-'))\n102\t    require(not set(data['containers'].values()) & set(SERVICES), 'contract-containers')\n103\t    return data\n104\t\n105\t\n106\tdef load(path):\n107\t    \"\"\"Regular file, final component never followed, bounded, strict JSON.\"\"\"\n108\t    try:\n109\t        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)\n110\t    except OSError:\n111\t        raise Refused('contract-unreadable') from None\n112\t    with os.fdopen(fd, 'rb') as handle:\n113\t        require(stat.S_ISREG(os.fstat(handle.fileno()).st_mode), 'contract-not-regular')\n114\t        raw = handle.read(MAX_BYTES + 1)\n115\t    require(len(raw) <= MAX_BYTES, 'contract-too-large')\n116\t    try:\n117\t        data = json.loads(raw.decode('utf-8'), object_pairs_hook=_no_duplicates)\n118\t    except (UnicodeDecodeError, ValueError):\n119\t        raise Refused('contract-invalid-json') from None\n120\t    return validate(data)\n121\t\n122\t\n123\tdef canonical(contract):\n124\t    return json.dumps(validate(contract), indent=2, sort_keys=True) + '\\n'\n125\t\n126\t\n127\tdef overlay(contract, image=None, sha=None):\n128\t    \"\"\"Compose overlay (YAML flow): project name, single external default network,\n129\t    container names, ``depends_on`` reset and the legacy-only services profiled out.\n130\t\n131\t    ``depends_on`` must be reset: with the dependencies outside the project,\n132\t    ``compose start`` refuses ``backend is missing dependency redis`` even after\n133\t    ``up --no-deps``. Only ``networks.default`` is redefined (no service-level\n134\t    ``networks``), so Compose cannot union a second network.\n135\t    \"\"\"\n136\t    validate(contract)\n137\t    require((image is None) == (sha is None), 'overlay-pin')\n138\t    require(image is None or ((IMAGE_REF.fullmatch(image) or IMAGE_ID.fullmatch(image)) and SHA.fullmatch(sha)),\n139\t            'overlay-pin')\n140\t    q = json.dumps\n141\t    services = []\n142\t    for role in SERVICES:\n143\t        fields = [f'\"container_name\": {q(contract[\"containers\"][role])}', '\"depends_on\": !reset {}']\n144\t        if image is not None:\n145\t            fields += [f'\"image\": {q(image)}', f'\"environment\": {{\"PASTORAI_RELEASE_SHA\": {q(sha)}}}']\n146\t        services.append(f'    {q(role)}: {{{\", \".join(fields)}}}')\n147\t    services += [f'    {q(name)}: {{\"profiles\": [{q(DEPENDENCY_PROFILE)}]}}' for name in BASE_ONLY]\n148\t    return ('# Generated from the validated release topology; public data only.\\n'\n149\t            f'{{\"name\": {q(contract[\"project\"])},\\n'\n150\t            f' \"networks\": {{\"default\": {{\"name\": {q(contract[\"network\"][\"name\"])}, \"external\": true}}}},\\n'\n151\t            ' \"services\": {\\n' + ',\\n'.join(services) + '}}\\n')\n152\t\n153\t\n154\tdef check_config(contract, model):\n155\t    \"\"\"The effective model is the adopted topology and nothing else.\"\"\"\n156\t    require(isinstance(model, dict) and model.get('name') == contract['project'], 'config-project')\n157\t    networks = model.get('networks')\n158\t    require(isinstance(networks, dict) and set(networks) == {'default'}\n159\t            and networks['default'].get('external') is True\n160\t            and networks['default'].get('name') == contract['network']['name']\n161\t            and set(networks['default']) <= {'name', 'external', 'ipam'}\n162\t            and not networks['default'].get('ipam'), 'config-network')\n163\t    services = model.get('services')\n164\t    require(isinstance(services, dict) and set(services) == set(SERVICES), 'config-services')\n165\t    for role in SERVICES:\n166\t        service = services[role]\n167\t        require(service.get('container_name') == contract['containers'][role], 'config-container-name')\n168\t        require(set(service.get('networks') or {}) == {'default'} and 'network_mode' not in service,\n169\t                'config-service-network')\n170\t        require(not service.get('depends_on') and not service.get('links')\n171\t                and not service.get('external_links'), 'config-dependencies')\n172\t\n173\t\n174\tdef write_new(path, text):\n175\t    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)\n176\t    with os.fdopen(fd, 'w', encoding='utf-8') as handle:\n177\t        handle.write(text)\n178\t    os.chmod(path, 0o644)\n179\t"}]},"parent_tool_use_id":null,"session_id":"6f5f5b4