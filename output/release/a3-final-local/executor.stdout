{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GdRhcQNUThKR6H58mcgiLH","type":"tool_result","content":"1:def migration_files(directory: pathlib.Path = MIGRATIONS_DIR) -> list[str]:\n9:def strip_outer_transaction(sql: str) -> str:\n17:    def _is_code(line: str) -> bool:\n35:def pending(files: list[str], applied: set[str]) -> list[str]:\n39:def _connect():\n40:    url = os.environ.get(DATABASE_URL_ENV, \"\").strip()\n42:        sys.exit(f\"defina {DATABASE_URL_ENV}\")\n45:    return psycopg2.connect(url)\n48:def _applied(cur) -> set[str]:\n51:        sys.exit(f\"{LEDGER} não existe neste banco; crie o ledger antes de aplicar\")\n56:def cmd_status(conn) -> int:\n62:    print(f\"aplicadas: {len(applied)}  arquivos: {len(files)}  pendentes: {len(todo)}\")\n64:        print(f\"  PENDENTE  {name}\")\n66:        print(f\"  NO BANCO, SEM ARQUIVO  {name}\")\n70:def _lock_timeout_ativo(cur) -> int:\n81:def cmd_apply(conn, name: str, *, transactional: bool, lock_timeout: int = 0) -> int:\n84:        sys.exit(f\"arquivo inválido: {name}\")\n87:        sys.exit(\"lock_timeout inválido: use 0 a 60000 ms\")\n89:        sys.exit(\"--lock-timeout vale só dentro da transação; com --no-transaction use 0\")\n91:        sys.exit(f\"{name} pertence a uma frente pausada ({PAUSED_MARKER})\")\n95:        sys.exit(f\"{name}: {exc}\")\n98:            sys.exit(f\"{name} já está registrada em {LEDGER}\")\n135:    print(f\"aplicada: {name}\")\n137:        print(f\"lock_timeout: {lock_timeout}ms\")\n141:def main(argv: list[str] | None = None) -> int:\n146:    ap.add_argument(\"name\", help=\"nome do arquivo em backend/migrations\")\n147:    ap.add_argument(\"--yes\", action=\"store_true\", help=\"confirma a escrita\")\n148:    ap.add_argument(\n153:    ap.add_argument(\n158:    args = parser.parse_args(argv)\n163:    conn = _connect()","is_error":false}]},"parent_tool_use_id":null,"session_id":"6f5f5b47-c66e-4591-b756-d99024a874c5","uuid":"80eeb5b6-361d-4f70-ae3d-0a6ec