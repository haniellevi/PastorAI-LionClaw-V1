   \"cron-worker\": \"a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2\",\n      \"broadcast-worker\": \"a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3\",\n      \"queue-worker\": \"a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4a4\"\n    },\n    \"support_ids\": {\n      \"redis\": \"b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1\",\n      \"evolution-postgres\": \"b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2\",\n      \"evolution-api\": \"b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3\"\n    },\n    \"processing_keys\": [],\n    \"gate_names\": [\"ALLOW_REAL_SENDS\", \"ASAAS_BILLING_ENABLED\", \"BREVO_SEND_MODE\", \"BROADCAST_ASYNC_ENABLED\"]\n  },\n  \"candidate\": {\n    \"sha\": \"afdfb78d71a53f2861632806e13cdda4662d7d63\",\n    \"image\": \"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\n    \"project\": \"example-release\",\n    \"containers\": {\n      \"backend\": \"example_release_backend\",\n      \"cron-worker\": \"example_release_cron_worker\",\n      \"broadcast-worker\": \"example_release_broadcast_worker\",\n      \"queue-worker\": \"example_release_queue_worker\"\n    },\n    \"network_name\": \"example_default\",\n    \"release_root\": \"/opt/pastorai-releases\",\n    \"hold_override\": \"/var/lib/example-first-transition/state/a9-hold.override.yml\",\n    \"env_file\": \"/srv/example/private/backend.conf\",\n    \"smoke_seconds\": 30\n  },\n  \"package_manifest_sha256\": \"4444444444444444444444444444444444444444444444444444444444444444\",\n  \"timeouts\": {\n    \"migration_s\": 300,\n    \"observe_s\": 10,\n    \"quiescence_interval_s\": 5,\n    \"quiescence_budget_s\": 60\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_017UwbgdvHKcghxU4a9uPY6q","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
