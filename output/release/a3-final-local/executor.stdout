{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011rzPaaiMWZSqH2fnMnECzr","type":"tool_result","content":"1\t\"\"\"Local-only database slice of the first-transition adapter.\n2\t\n3\tExact Git blobs, the reviewed migration CLI and the durable transition journal\n4\tare reused. There is deliberately no host/SSH/Redis/deploy transport here.\n5\tContainment/backup evidence is labelled local simulation, never production\n6\tproof. Completion holds at database-verified; it cannot start an application,\n7\tresume the legacy or change a gate. See the existing release runbook.\n8\t\"\"\"\n9\tfrom __future__ import annotations\n10\t\n11\tfrom dataclasses import dataclass, field\n12\timport hashlib\n13\timport json\n14\tfrom pathlib import Path\n15\timport re\n16\timport subprocess\n17\timport sys\n18\timport tempfile\n19\tfrom urllib.parse import urlsplit\n20\tfrom uuid import UUID\n21\t\n22\tfrom initial_transition_files import Journal, git_tree, read_regular\n23\tfrom initial_transition_ops import BACKFILL_SQL, Refused, require\n24\t\n25\tAPPLICATION_SHA = 'afdfb78d71a53f2861632806e13cdda4662d7d63'\n26\tEXECUTOR_SHA = '37c7d68d60b6f86cfb1fe75d4c720530537845d6'\n27\tROLES = ('backend', 'cron-worker', 'broadcast-worker', 'queue-worker')\n28\tMISSING = frozenset({\n29\t    '20260711_023515_backfill_pessoa_tipo_membro_por_vinculo_ativo.sql',\n30\t    '20260711_152127_reclassifica_pessoa_do_numero_whatsapp_fora_de_membro.sql',\n31\t    '20260925_183811_preserve_platform_admins_on_tenant_deletion.sql',\n32\t    '20260926_120446_platform_jev_settings.sql',\n33\t})\n34\tREVIEWED_CONCURRENT = {'20261023_100001_ai_usage_tenant_created_idx.sql': ('ai_usage_logs_igreja_created_at_idx',), '20261023_110001_notification_outbox_pending_created_idx.sql': ('notification_outbox_pending_igreja_created_idx',), '20261023_110002_notification_outbox_retry_created_idx.sql': ('notification_outbox_retry_igreja_created_idx',), '20261023_110003_notification_outbox_expired_lease_idx.sql': ('notification_outbox_lease_igreja_claimed_idx',), '20261023_110004_messages_pending_agent_created_idx.sql': ('messages_pending_agent_igreja_created_idx',), '20261023_110005_work_queue_pending_created_idx.sql': ('work_queue_pending_igreja_created_idx',), '20261028_100001_private_erasure_requests_overview_idx.sql': ('private_erasure_requests_overview_idx',), '20261028_100002_private_resume_delivered_overview_idx.sql': ('private_resume_delivered_overview_idx',)}\n35\t\n36\tSQL_PATH = re.compile(r'backend/migrations/[A-Za-z0-9_.-]+\\.sql')\n37\tINDEX = re.compile(r'create\\s+(?:unique\\s+)?index\\s+concurrently\\s+(?:if\\s+not\\s+exists\\s+)?'\n38\t                   r'(?:public\\.)?\"?([a-z0-9_]+)\"?', re.I)\n39\t\n40\t\n41\tdef digest(value):\n42\t    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',', ':')).encode()).hexdigest()\n43\t\n44\t\n45\tdef adapter_sources():\n46\t    root = Path(__file__).resolve().parent\n47\t    return tuple((name, hashlib.sha256(read_regular(root / name)).hexdigest()) for name in (\n48\t        'first_transition_adapter.py', 'first_transition_local_backup.py',\n49\t        'first_transition_host_contract.py', 'first_transition_host_transport.py', 'first_transition_host_driver.py',\n50\t        'initial_transition_files.py',\n51\t        'initial_transition_ops.py', 'release_topology.py'))\n52\t\n53\t\n54\tPREFLIGHT_PROBE = r'''\n55\timport json,os,sys\n56\ttry:\n57\t    import psycopg2\n58\t    sys.path.insert(0,sys.argv[1])\n59\t    import release_preflight\n60\t    connection=psycopg2.connect(os.environ['MIGRATION_DATABASE_URL'],connect_timeout=3,hostaddr='127.0.0.1',\n61\t        sslmode='disable',application_name='igreja12-local-preflight',\n62\t        options='-c search_path=pg_catalog,public -c statement_timeout=5000 -c lock_timeout=2000 -c row_security=off')\n63\t    try:\n64\t        connection.autocommit=True\n65\t        with connection.cursor() as cursor:\n66\t            cursor.execute(\"SELECT shobj_description(oid,'pg_database') FROM pg_database WHERE datname=current_database()\")\n67\t            if cursor.fetchone()[0]!='igreja12-local-disposable:'+os.environ['FIRST_TRANSITION_LOCAL_NONCE']:\n68\t                raise RuntimeError('unowned disposable database')\n69\t        connection.autocommit=False\n70\t        report=release_preflight.inspect_connection(connection)\n71\t        with connection.cursor() as cursor:\n72\t            cursor.execute(\"SELECT current_setting('transaction_read_only')\")\n73\t            readonly=cursor.fetchone()[0]=='on'\n74\t        output=dict(status='ok',read_only=readonly,files=len(report.migrations),\n75\t            applied=sum(row.state=='APLICADA' for row in report.migrations),\n76\t            pending=sum(row.state=='PENDENTE' for row in report.migrations),\n77\t            unknown=report.unknown_applied_count,fk_findings=len(report.fk_findings),\n78\t            duplicates=len(report.duplicate_findings),missing_tables=len(report.missing_backup_tables),\n79\t            definer_examined=len(report.definer_examined),\n80\t            definer_unverified=len(report.definer_unverified),definer_findings=len(report.definer_findings))\n81\t        print(json.dumps(output,sort_keys=True))\n82\t    finally:\n83\t        connection.rollback()\n84\t        connection.close()\n85\texcept BaseException:\n86\t    print('{\"status\":\"refused\",\"code\":\"full-preflight-failed\"}')\n87\t    sys.exit(3)\n88\t'''\n89\t\n90\tPREFLIGHT_COUNTS = frozenset({'files', 'applied', 'pending', 'unknown', 'fk_findings',\n91\t                            'duplicates', 'missing_tables', 'definer_examined',\n92\t                            'definer_unverified', 'definer_findings'})\n93\t\n94\t\n95\tdef preflight_summary(raw, files, applied):\n96\t    try:\n97\t        data = json.loads(raw)\n98\t    except (ValueError, TypeError):\n99\t        raise Refused('full-preflight-output') from None\n100\t    require(isinstance(data, dict) and set(data) == PREFLIGHT_COUNTS | {'status', 'read_only'},\n101\t            'full-preflight-output')\n102\t    require(data['status'] == 'ok' and data['read_only'] is True\n103\t            and all(type(data[k]) is int and 0 <= data[k] <= 10**9 for k in PREFLIGHT_COUNTS),\n104\t            'full-preflight-output')\n105\t    require(data['files'] == files and data['applied'] == applied\n106\t            and data['pending'] == files - applied, 'full-preflight-output')\n107\t    return data\n108\t\n109\t\n110\tdef require_clean_preflight(summary, *, complete):\n111\t    require(all(summary[key] == 0 for key in ('unknown', 'fk_findings', 'duplicates',\n112\t                                            'missing_tables', 'definer_findings')),\n113\t            'full-preflight-findings')\n114\t    if complete:\n115\t        require(summary['definer_unverified'] == 0, 'full-preflight-unverified')\n116\t\n117\t\n118\t@dataclass(frozen=True)\n119\tclass Migration:\n120\t    name: str\n121\t    sql: bytes = field(repr=False)\n122\t\n123\t    @property\n124\t    def sha256(self):\n125\t        return hashlib.sha256(self.sql).hexdigest()\n126\t\n127\t    @property\n128\t    def indexes(self):\n129\t        code = '\\n'.join(line for line in self.sql.decode().splitlines()\n130\t                         if not line.lstrip().startswith('--'))\n131\t        return tuple(sorted(set(match.lower() for match in INDEX.findall(code))))\n132\t\n133\t    @property\n134\t    def concurrent(self):\n135\t        return bool(self.indexes)\n136\t\n137\t\n138\t@dataclass(frozen=True)\n139\tclass Plan:\n140\t    application_sha: str\n141\t    executor_sha: str\n142\t    migrations: tuple[Migration, ...]\n143\t    baseline: tuple[str, ...]\n144\t    executor: bytes = field(repr=False)\n145\t    preflight: bytes = field(repr=False)\n146\t    adapter_sources: tuple[tuple[str, str], ...]\n147\t\n148\t    @property\n149\t    def pending(self):\n150\t        return tuple(m for m in self.migrations if m.name not in self.baseline)\n151\t\n152\t    @property\n153\t    def digest(self):\n154\t        return digest([self.application_sha, self.executor_sha, self.adapter_sources,\n155\t                       hashlib.sha256(self.executor).hexdigest(), hashlib.sha256(self.preflight).hexdigest(),\n156\t                       hashlib.sha256(PREFLIGHT_PROBE.encode()).hexdigest(), self.baseline,\n157\t                       [(m.name, m.sha256) for m in self.migrations]])\n158\t\n159\t    def report(self):\n160\t        return dict(application_sha=self.application_sha, executor_sha=self.executor_sha,\n161\t                    plan_digest=self.digest, baseline=len(self.baseline), pending=len(self.pending),\n162\t                    active=len(self.migrations), concurrent=sum(m.concurrent for m in self.pending),\n163\t                    production_ready=False, stops_at='database-verified',\n164\t                    preflight_sha256=hashlib.sha256(self.preflight).hexdigest(),\n165\t                    adapter_sources_digest=digest(self.adapter_sources))\n166\t\n167\t\n168\tdef prepare(repo: Path, application_sha=APPLICATION_SHA, executor_sha=EXECUTOR_SHA):\n169\t    require(application_sha == APPLICATION_SHA and executor_sha == EXECUTOR_SHA, 'unreviewed-release')\n170\t    files = git_tree(repo, application_sha, ('backend/migrations',), SQL_PATH)\n171\t    migrations = tuple(Migration(Path(name).name, sql) for name, sql in sorted(files.items())\n172\t                       if b'OPERATIONAL_AUTHORIZATION=BLOCKED' not in sql)\n173\t    baseline = tuple(m.name for m in migrations if m.name < '20261015' and m.name not in MISSING)\n174\t    runner = 'backend/scripts/migrate.py'\n175\t    executor = git_tree(repo, executor_sha, (runner,), re.compile(re.escape(runner)))\n176\t    require(runner in executor, 'executor-missing')\n177\t    probe = 'backend/scripts/release_preflight.py'\n178\t    probes = git_tree(repo, application_sha, (probe,), re.compile(re.escape(probe)))\n179\t    require(probe in probes, 'preflight-missing')\n180\t    plan = Plan(application_sha, executor_sha, migrations, baseline, executor[runner], probes[probe], adapter_sources())\n181\t    require((len(migrations), len(baseline), len(plan.pending)) == (129, 78, 51), 'release-shape')\n182\t    require(MISSING <= {m.name for m in migrations}, 'baseline-missing-set')\n183\t    require(all(not re.search(r'\\bconcurrently\\b', '\\n'.join(\n184\t        line for line in m.sql.decode().splitlines() if not line.lstrip().startswith('--')), re.I)\n185\t        or m.name in REVIEWED_CONCURRENT for m in plan.pending), 'unreviewed-concurrent-form')\n186\t    require({m.name: m.indexes for m in plan.pending if m.concurrent} == REVIEWED_CONCURRENT,\n187\t            'concurrent-set')\n188\t    return plan\n189\t\n190\t\n191\tdef local_endpoint(url, *, restore=False):\n192\t    try:\n193\t        parsed = urlsplit(url)\n194\t        valid = (parsed.scheme == 'postgresql' and parsed.hostname == '127.0.0.1'\n195\t                 and parsed.username == 'postgres' and parsed.password == 'synthetic-only'\n196\t                 and (bool(re.fullmatch(r'/first_transition_restore_[0-9a-f]{32}', parsed.path))\n197\t                      if restore else parsed.path == '/first_transition_test')\n198\t                 and not parsed.query and not parsed.fragment\n199\t                 and parsed.port is not None and 0 < parsed.port < 65536)\n200\t    except (TypeError, ValueError):\n201\t        valid = False\n202\t    require(valid, 'local-disposable-endpoint-required')\n203\t\n204\t\n205\tdef _full_preflight_at(plan, url, applied, nonce):\n206\t    # Both accepted database names are exclusively local disposable targets.\n207\t    local_endpoint(url, restore=bool(re.fullmatch(\n208\t        r'/first_transition_restore_[0-9a-f]{32}', urlsplit(url).path)))\n209\t    with tempfile.TemporaryDirectory(prefix='igreja12-first-transition-preflight-') as directory:\n210\t        root = Path(directory)\n211\t        scripts = root / 'scripts'\n212\t        scripts.mkdir()\n213\t        (root / 'migrations').mkdir()\n214\t        (scripts / 'migrate.py').write_bytes(plan.executor)\n215\t        (scripts / 'release_preflight.py').write_bytes(plan.preflight)\n216\t        for migration in plan.migrations:\n217\t            (root / 'migrations' / migration.name).write_bytes(migration.sql)\n218\t        env = dict(PATH='/usr/bin:/bin', PYTHON_DOTENV_DISABLED='1',\n219\t                   MIGRATION_DATABASE_URL=url, FIRST_TRANSITION_LOCAL_NONCE=nonce)\n220\t        try:\n221\t            result = subprocess.run([sys.executable, '-c', PREFLIGHT_PROBE, str(scripts)],\n222\t                                    cwd=root, env=env, capture_output=True, timeout=30)\n223\t        except (OSError, subprocess.TimeoutExpired):\n224\t            raise Refused('full-preflight-failed') from None\n225\t        require(result.returncode == 0, 'full-preflight-failed')\n226\t        return preflight_summary(result.stdout, len(plan.migrations), applied)\n227\t\n228\t\n229\t@dataclass(frozen=True)\n230\tclass LocalEvidence:\n231\t    \"\"\"A test receipt, bound to plan/catalog/ledger. Never a real backup receipt.\n232\t\n233\t    kind='observed-host' is only a metadata envelope over driver-reported data:\n234\t    validating it neither authorizes LocalTransition nor proves production.\n235\t    \"\"\"\n236\t    plan_digest: str\n237\t    baseline_digest: str\n238\t    stopped_roles: tuple[str, ...] = ROLES\n239\t    ingress_blocked: bool = True\n240\t    backup_rehearsal_requested: bool = True\n241\t    queue_preservation_assumed: bool = True\n242\t    support_preserved: bool = True\n243\t    gates_preserved: bool = True\n244\t    kind: str = 'local-simulation'\n245\t    host_digest: str | None = None\n246\t\n247\t    @classmethod\n248\t    def synthetic(cls, plan_digest, baseline_digest, *, host_digest=None):\n249\t        return cls(plan_digest, baseline_digest, host_digest=host_digest)\n250\t\n251\t    @classmethod\n252\t    def observed(cls, plan_digest, baseline_digest, *, host_digest):\n253\t        return cls(plan_digest, baseline_digest, kind='observed-host', host_digest=host_digest)\n254\t\n255\t    def validate(self, plan_digest, baseline_digest):\n256\t        require(self.kind in ('local-simulation', 'observed-host') and self.plan_digest == plan_digest\n257\t                and self.baseline_digest == baseline_digest and self.stopped_roles == ROLES\n258\t                and (self.host_digest is None and self.kind == 'local-simulation'\n259\t                     or isinstance(self.host_digest, str) and re.fullmatch('[0-9a-f]{64}', self.host_digest))\n260\t                and all(value is True for value in (self.ingress_blocked, self.backup_rehearsal_requested,\n261\t                        self.queue_preservation_assumed, self.support_preserved, self.gates_preserved)),\n262\t                'local-evidence-mismatch')\n263\t\n264\t\n265\tclass LocalDatabase:\n266\t    \"\"\"Literal loopback, dedicated DB and caller-owned disposable marker, before DDL.\n267\t\n268\t    Reads return ledger, catalog metadata and aggregate findings only. No row\n269\t    payloads, queue contents or row digests are read. Another client connection\n270\t    is refused, even idle. This plus a DB advisory lock is a local test boundary,\n271\t    not a proof of production quiescence or full data preservation.\n272\t    \"\"\"\n273\t    def __init__(self, url, nonce, *, restore=False):\n274\t        local_endpoint(url, restore=restore)\n275\t        try:\n276\t            require(str(UUID(nonce)) == nonce, 'disposable-marker')\n277\t        except (ValueError, TypeError, AttributeError):\n278\t            raise Refused('disposable-marker') from None\n279\t        self._url, self._nonce, self.conn = url, nonce, None\n280\t\n281\t    def __enter__(self):\n282\t        import psycopg2\n283\t        try:\n284\t            self.conn = psycopg2.connect(self._url, connect_timeout=3,hostaddr='127.0.0.1', sslmode='disable', options='',\n285\t                                         application_name='igreja12-first-transition-local')\n286\t            self.conn.autocommit = True\n287\t            with self.conn.cursor() as cur:\n288\t                cur.execute(\"SELECT shobj_description(oid, 'pg_database') FROM pg_database WHERE datname=current_database()\")\n289\t                require(cur.fetchone()[0] == 'igreja12-local-disposable:' + self._nonce, 'disposable-marker')\n290\t                cur.execute(\"SELECT system_identifier::text, (SELECT oid FROM pg_database WHERE datname=current_database()) FROM pg_control_system()\")\n291\t                system, database_oid = cur.fetchone()\n292\t                self.identity = digest([system, database_oid, self._nonce])\n293\t                cur.execute('SELECT pg_try_advisory_lock(12712951)')\n294\t                require(cur.fetchone()[0] is True, 'adapter-busy')\n295\t            return self\n296\t        except BaseException as exc:\n297\t            self.__exit__(None, None, None)\n298\t            if isinstance(exc, Exception) and not isinstance(exc, Refused):\n299\t                raise Refused('local-database-unavailable-or-unowned') from None\n300\t            raise\n301\t\n302\t    def __exit__(self, *_):\n303\t        if self.conn is not None:\n304\t            self.conn.close()\n305\t            self.conn = None\n306\t\n307\t    def observe(self):\n308\t        try:\n309\t            return self._observe()\n310\t        except Refused:\n311\t            raise\n312\t        except Exception:\n313\t            raise Refused('database-observation-failed') from None\n314\t\n315\t    def _observe(self):\n316\t        with self.conn.cursor() as cur:\n317\t            cur.execute('BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY')\n318\t            try:\n319\t                cur.execute(\"SET LOCAL statement_timeout='3s'\")\n320\t                cur.execute('SET LOCAL search_path=pg_catalog,public')\n321\t                cur.execute(\"SELECT count(*) FROM pg_stat_activity WHERE datid=(SELECT oid FROM pg_database WHERE datname=current_database()) AND pid<>pg_backend_pid() AND backend_type='client backend'\")\n322\t                require(cur.fetchone()[0] == 0, 'other-database-client')\n323\t                cur.execute('SELECT name FROM public.schema_migrations ORDER BY name COLLATE \"C\"')\n324\t                ledger = tuple(row[0] for row in cur.fetchall())\n325\t                cur.execute(\"SELECT c.relname FROM pg_index i JOIN pg_class c ON c.oid=i.indexrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND NOT (i.indisvalid AND i.indisready) ORDER BY c.relname\")\n326\t                invalid = tuple(row[0] for row in cur.fetchall())\n327\t                cur.execute(\"SELECT c.oid,c.relname,c.relkind,a.attnum,a.attname,a.atttypid,a.attnotnull FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace LEFT JOIN pg_attribute a ON a.attrelid=c.oid AND a.attnum>0 AND NOT a.attisdropped WHERE n.nspname='public' ORDER BY c.oid,a.attnum\")\n328\t                catalog = digest(cur.fetchall())\n329\t                cur.execute(\"SELECT c.relname,pg_get_indexdef(i.indexrelid) FROM pg_index i JOIN pg_class c ON c.oid=i.indexrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' ORDER BY c.relname\")\n330\t                indexes = {name: digest(definition) for name, definition in cur.fetchall()}\n331\t                cur.execute('SELECT count(*) FROM (SELECT 1 FROM public.app_users WHERE pessoa_id IS NOT NULL GROUP BY igreja_id,pessoa_id HAVING count(*)>1) s')\n332\t                duplicates = cur.fetchone()[0]\n333\t                cur.execute('SELECT count(*) FROM public.celula_solicitacao r WHERE r.celula_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM public.celulas c WHERE c.id=r.celula_id AND c.igreja_id=r.igreja_id)')\n334\t                invalid_links = cur.fetchone()[0]\n335\t                cur.execute('SELECT count(*) FROM public.pessoas WHERE apto_proxima_cd IS TRUE')\n336\t                aptitude_backfill = cur.fetchone()[0]\n337\t                cur.execute(BACKFILL_SQL)\n338\t                backfills = cur.fetchone()[0]\n339\t                cur.execute(\"SELECT c.relname FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' ORDER BY c.relname\")\n340\t                relations = tuple(row[0] for row in cur.fetchall())\n341\t                return dict(ledger=ledger, invalid=invalid, catalog=catalog, relations=relations, indexes=indexes,\n342\t                            duplicates=duplicates, invalid_links=invalid_links,\n343\t                            aptitude_backfill=aptitude_backfill, backfills=backfills)\n344\t            finally:\n345\t                cur.execute('ROLLBACK')\n346\t\n347\t    def full_preflight(self, plan, applied):\n348\t        return _full_preflight_at(plan, self._url, applied, self._nonce)\n349\t\n350\t    def rehearse_backup(self, plan):\n351\t        from first_transition_local_backup import rehearse_backup\n352\t        return rehearse_backup(self, plan)\n353\t\n354\t    def apply(self, plan, migration, *, timeout=300):\n355\t        \"\"\"One exact SQL blob through the exact reviewed CLI, fresh connection.\n356\t\n357\t        The environment is constructed, never inherited. stdout/stderr remain\n358\t        captured in this process and are discarded; errors expose fixed codes.\n359\t        \"\"\"\n360\t        with tempfile.TemporaryDirectory(prefix='igreja12-first-transition-sql-') as directory:\n361\t            root = Path(directory)\n362\t            (root / 'scripts').mkdir()\n363\t            (root / 'migrations').mkdir()\n364\t            (root / 'scripts/migrate.py').write_bytes(plan.executor)\n365\t            (root / 'migrations' / migration.name).write_bytes(migration.sql)\n366\t            args = [sys.executable, str(root / 'scripts/migrate.py'), 'apply', migration.name, '--yes']\n367\t            if migration.concurrent:\n368\t                args.append('--no-transaction')\n369\t            env = dict(PATH='/usr/bin:/bin', PYTHON_DOTENV_DISABLED='1',\n370\t                       MIGRATION_DATABASE_URL=self._url, PGAPPNAME='igreja12-local-migration')\n371\t            try:\n372\t                result = subprocess.run(args, cwd=root, env=env, capture_output=True, timeout=timeout)\n373\t            except subprocess.TimeoutExpired:\n374\t                raise Refused('migration-timeout') from None\n375\t            except OSError:\n376\t                raise Refused('migration-executor-unavailable') from None\n377\t            require(result.returncode == 0, 'migration-failed')\n378\t\n379\t\n380\tdef reviewed_indexes(migration, observation):\n381\t    require(set(migration.indexes) <= observation['indexes'].keys(), 'reviewed-index-missing')\n382\t    return {name: observation['indexes'][name] for name in migration.indexes}\n383\t\n384\t\n385\tdef baseline_digest(observation):\n386\t    return digest([observation['ledger'], observation['catalog']])\n387\t\n388\t\n389\tdef step_invariants(observation):\n390\t    require(not observation['invalid'], 'invalid-index')\n391\t    require(observation['duplicates'] == 0 and observation['invalid_links'] == 0,\n392\t            'aggregate-preflight-finding')\n393\t\n394\t\n395\tdef pre_ddl_findings(observation):\n396\t    step_invariants(observation)\n397\t    remaining_pre_ddl_gates(observation)\n398\t\n399\t\n400\tdef remaining_pre_ddl_gates(observation):\n401\t    applied = set(observation['ledger'])\n402\t    gates = (\n403\t        ('20260711_023515_backfill_pessoa_tipo_membro_por_vinculo_ativo.sql',\n404\t         observation['backfills']['membro_por_vinculo']),\n405\t        ('20260711_152127_reclassifica_pessoa_do_numero_whatsapp_fora_de_membro.sql',\n406\t         observation['backfills']['numero_atendimento']),\n407\t        ('20261017_230000_uv_marcos_conclusao.sql', observation['aptitude_backfill']),\n408\t    )\n409\t    require(all(name in applied or candidates == 0 for name, candidates in gates),\n410\t            'pre-ddl-backfill-candidate')\n411\t\n412\t\n413\tdef validate_clone_receipt(backup, plan, identity, baseline):\n414\t    require(isinstance(backup, dict) and backup.get('plan_digest') == plan.digest\n415\t            and backup.get('source_identity') == identity and backup.get('baseline_digest') == baseline\n416\t            and backup.get('restore_verified') is True, 'clone-receipt-invalid')\n417\t    clone = backup.get('clone_rehearsal')\n418\t    require(isinstance(clone, dict) and clone.get('migrations_verified') is True\n419\t            and clone.get('clone_identity') != identity\n420\t            and clone.get('cluster_global_ddl_possible') is True\n421\t            and type(clone.get('applied')) is int and clone['applied'] == len(plan.pending)\n422\t            and type(clone.get('final_ledger')) is int and clone['final_ledger'] == len(plan.migrations)\n423\t            and type(clone.get('concurrent')) is int and clone['concurrent'] == sum(m.concurrent for m in plan.pending)\n424\t            and clone.get('sql_digest') == digest([(m.name, m.sha256) for m in plan.pending])\n425\t            and all(isinstance(clone.get(key), str) and re.fullmatch('[0-9a-f]{64}', clone[key])\n426\t                    for key in ('final_schema_digest', 'clone_identity')),\n427\t            'clone-receipt-invalid')\n428\t\n429\t\n430\tclass LocalTransition:\n431\t    \"\"\"Durable local DB sequence; incomplete post-marker runs need explicit retry.\n432\t\n433\t    adapter-failed is diagnostic; run-start/complete determine recovery consent.\n434\t    Completed replay is read-only. Concurrent migrations committed without an\n435\t    index receipt refuse recovery; no automatic adoption of their definitions.\n436\t    No service promotion or legacy resume. The local disposable DB composes only\n437\t    with the simulated LocalHostContract: an observed host, observed-host\n438\t    evidence or a journal holding observed-host-* events is refused before any\n439\t    DB observation or journal write, at construction and before every step.\n440\t    \"\"\"\n441\t    def __init__(self, plan, database, journal: Journal, *, host=None):\n442\t        if host is not None:\n443\t            from first_transition_host_contract import LocalHostContract\n444\t            # One valid journal shared with the host contract.\n445\t            require(journal is not None and getattr(host, 'j', None) is journal, 'local-host-journal-mismatch')\n446\t            require(isinstance(host, LocalHostContract), 'local-transition-simulated-host-required')\n447\t        self.plan, self.db, self.j, self.host = plan, database, journal, host\n448\t        self._check_journal()\n449\t\n450\t    def _check_journal(self):\n451\t        require(isinstance(self.j, Journal) and self.j.lock_fd is not None,\n452\t                'local-transition-journal-required')\n453\t        require(not any(event['kind'].startswith('observed-host-') for event in self.j.events),\n454\t                'local-transition-observed-journal')\n455\t\n456\t    def _check_host(self, evidence):\n457\t        self._check_journal()\n458\t        require(evidence.kind == 'local-simulation', 'local-transition-simulated-evidence-required')\n459\t        if self.host is None:\n460\t            require(evidence.host_digest is None, 'local-host-evidence-unbound')\n461\t        else:\n462\t            receipt = self.host.assert_contained()\n463\t            require(receipt.get('mode') == 'local-simulation' and receipt.get('host_verified') is False\n464\t                    and evidence.host_digest == receipt['fingerprint'], 'local-host-evidence-mismatch')\n465\t\n466\t    def run(self, evidence: LocalEvidence, *, retry=False):\n467\t        self._check_host(evidence)\n468\t        init = self.j.last('adapter-init')\n469\t        if init:\n470\t            require(init['plan_digest'] == self.plan.digest, 'plan-changed')\n471\t            require(init['database_identity'] == self.db.identity, 'database-changed')\n472\t        else:\n473\t            self.j.append('adapter-init', plan_digest=self.plan.digest,\n474\t                          database_identity=self.db.identity, adapter_sources=dict(self.plan.adapter_sources),\n475\t                          production_ready=False)\n476\t        observed = self.db.observe()\n477\t        step_invariants(observed)\n478\t        marker = self.j.last('adapter-ddl-marker')\n479\t        previous = self.j.last('adapter-run-start')\n480\t        complete = self.j.last('adapter-run-complete')\n481\t        interrupted = previous and (complete is None or complete.get('start_seq') != previous['seq'])\n482\t        unreceipted = any(not self.j.last('done', event['step']) for event in self.j.find('intent')\n483\t                          if str(event.get('step', '')).startswith('adapter-migration:'))\n484\t        needs_retry = marker is not None and bool(interrupted or unreceipted)\n485\t        if needs_retry:\n486\t            require(retry is True, 'explicit-local-retry-required')\n487\t            self.j.append('adapter-retry', previous_start=previous['seq'] if previous else None)\n488\t        run_start = self.j.append('adapter-run-start')['seq']\n489\t        if marker is None:\n490\t            pre_ddl_findings(observed)\n491\t            pending_indexes = {name for migration in self.plan.pending for name in migration.indexes}\n492\t            require(not pending_indexes.intersection(observed['relations']), 'concurrent-index-without-ledger')\n493\t            require(observed['ledger'] == self.plan.baseline, 'baseline-ledger')\n494\t            evidence.validate(self.plan.digest, baseline_digest(observed))\n495\t            preflight = self.db.full_preflight(self.plan, len(observed['ledger']))\n496\t            require_clean_preflight(preflight, complete=False)\n497\t            self.j.append('adapter-preflight', phase='before-ddl', **preflight)\n498\t            backup = self.db.rehearse_backup(self.plan)\n499\t            validate_clone_receipt(backup, self.plan, self.db.identity, baseline_digest(observed))\n500\t            backup_event = self.j.append('adapter-local-restore', **backup)\n501\t            self._check_host(evidence)\n502\t            # Re-observe immediately before the irrevocable marker; no row hashes.\n503\t            fresh = self.db.observe()\n504\t            pre_ddl_findings(fresh)\n505\t            require(not pending_indexes.intersection(fresh['relations']), 'concurrent-index-without-ledger')\n506\t            require(baseline_digest(fresh) == baseline_digest(observed), 'baseline-changed')\n507\t            self.j.append('adapter-ddl-marker', baseline_digest=baseline_digest(fresh),\n508\t                          evidence_kind=evidence.kind, pending=len(self.plan.pending), irrevocable=True,\n509\t                          restore_seq=backup_event['seq'], restore_digest=digest(backup))\n510\t        else:\n511\t            evidence.validate(self.plan.digest, marker['baseline_digest'])\n512\t            restored = next((event for event in self.j.find('adapter-local-restore')\n513\t                             if event['seq'] == marker.get('restore_seq')), None)\n514\t            require(restored is not None and digest({k: v for k, v in restored.items()\n515\t                    if k not in ('seq', 'at', 'kind')}) == marker.get('restore_digest'), 'restore-receipt-changed')\n516\t            backup = {k: v for k, v in restored.items() if k not in ('seq', 'at', 'kind')}\n517\t            validate_clone_receipt(backup, self.plan, self.db.identity, marker['baseline_digest'])\n518\t            preflight = self.db.full_preflight(self.plan, len(observed['ledger']))\n519\t            require_clean_preflight(preflight, complete=len(observed['ledger']) == len(self.plan.migrations))\n520\t        ledger = list(observed['ledger'])\n521\t        completed = [m.name for m in self.plan.pending if m.name in ledger]\n522\t        require(set(ledger) == set(self.plan.baseline) | set(completed)\n523\t                and completed == [m.name for m in self.plan.pending[:len(completed)]], 'ledger-not-prefix')\n524\t        require(all(e['step'].removeprefix('adapter-migration:') in ledger\n525\t                    for e in self.j.find('done') if e['step'].startswith('adapter-migration:')),\n526\t                'ledger-regressed')\n527\t        try:\n528\t            for migration in self.plan.pending:\n529\t                self._check_host(evidence)\n530\t                step = 'adapter-migration:' + migration.name\n531\t                require(all(e.get('sql_sha256') == migration.sha256 for e in self.j.find('intent', step)),\n532\t                        'migration-intent-changed')\n533\t                if migration.name in ledger:\n534\t                    require(self.j.last('intent', step) is not None, 'unjournaled-migration')\n535\t                    index_receipt = reviewed_indexes(migration, observed)\n536\t                    done = self.j.last('done', step)\n537\t                    if done:\n538\t                        require(done.get('indexes') == index_receipt, 'reviewed-index-changed')\n539\t                    else:\n540\t                        require(not migration.indexes, 'reviewed-index-receipt-missing')\n541\t                        self.j.append('done', step=step, recovered=True, indexes=index_receipt)\n542\t                    continue\n543\t                current = self.db.observe()\n544\t                step_invariants(current)\n545\t                remaining_pre_ddl_gates(current)\n546\t                require(set(current['ledger']) == set(ledger), 'ledger-changed')\n547\t                require(not (set(migration.indexes) & set(current['relations'])), 'concurrent-index-without-ledger')\n548\t                self.j.append('intent', step=step, sql_sha256=migration.sha256)\n549\t                self.db.apply(self.plan, migration)\n550\t                self._check_host(evidence)\n551\t                after = self.db.observe()\n552\t                step_invariants(after)\n553\t                require(set(after['ledger']) == set(ledger) | {migration.name}, 'migration-ledger-mismatch')\n554\t                self.j.append('done', step=step, indexes=reviewed_indexes(migration, after))\n555\t                ledger.append(migration.name)\n556\t            require(set(ledger) == {m.name for m in self.plan.migrations}, 'final-ledger')\n557\t            preflight = self.db.full_preflight(self.plan, len(ledger))\n558\t            require_clean_preflight(preflight, complete=True)\n559\t            from first_transition_local_backup import snapshot\n560\t            try:\n561\t                source_schema = snapshot(self.db.conn)['catalog']\n562\t            except Exception:\n563\t                raise Refused('clone-source-schema-check-failed') from None\n564\t            require(source_schema == backup['clone_rehearsal']['final_schema_digest'],\n565\t                    'clone-source-schema-divergence')\n566\t            self._check_host(evidence)\n567\t            final = self.db.observe()\n568\t            step_invariants(final)\n569\t            require(set(final['ledger']) == set(ledger), 'ledger-changed')\n570\t            for migration in self.plan.pending:\n571\t                done = self.j.last('done', 'adapter-migration:' + migration.name)\n572\t                require(done is not None and done.get('indexes') == reviewed_indexes(migration, final),\n573\t                        'reviewed-index-changed')\n574\t            self.j.append('adapter-preflight', phase='after-ddl', **preflight)\n575\t            if self.j.last('adapter-database-verified') is None:\n576\t                self.j.append('adapter-database-verified', ledger=len(ledger), production_ready=False)\n577\t            self.j.append('adapter-run-complete', start_seq=run_start)\n578\t            return dict(status='database-verified', ledger=len(ledger), production_ready=False,\n579\t                        services='simulated-held', host_verified=False, legacy_resume_allowed=False)\n580\t        except BaseException as exc:\n581\t            self.j.append('adapter-failed', code=str(exc) if isinstance(exc, Refused) else 'interrupted',\n582\t                          legacy_resume_allowed=False)\n583\t            raise\n584\t\n585\t\n586\tdef queue_metadata(read, *, processing_keys=()):\n587\t    \"\"\"Metadata only, over an explicitly supplied command port (no Redis client).\n588\t\n589\t    Callers must already know the scoped processing lists; no KEYS/SCAN, value\n590\t    reads or row hashes. Equal lengths cannot prove equal contents, and the\n591\t    result expressly does not certify preservation or quiescence. Tests use a\n592\t    simulator; binding a real transport requires the separate host review.\n593\t    \"\"\"\n594\t    require(isinstance(processing_keys, (tuple, list)) and len(processing_keys) <= 64,\n595\t            'queue-scope')\n596\t    require(all(isinstance(key, str) and re.fullmatch(\n597\t        r'pastorai:webhooks:processing:[A-Za-z0-9_-]{1,80}', key) for key in processing_keys),\n598\t        'queue-scope')\n599\t    require(len(set(processing_keys)) == len(processing_keys), 'queue-scope')\n600\t    kinds = {'pastorai:webhooks': 'list', 'pastorai:webhooks:processing': 'list',\n601\t             'pastorai:webhooks:dead': 'list', 'pastorai:webhooks:retry-scheduled': 'zset',\n602\t             **dict.fromkeys(processing_keys, 'list')}\n603\t    counts = {}\n604\t    def command(name, key):\n605\t        try:\n606\t            return read(name, key)\n607\t        except Exception:\n608\t            raise Refused('queue-observation-failed') from None\n609\t    for key, expected in sorted(kinds.items()):\n610\t        kind = command('TYPE', key)\n611\t        require(kind in (expected, 'none'), 'queue-type')\n612\t        ttl = command('PTTL', key)\n613\t        require(type(ttl) is int and (ttl == -1 if kind != 'none' else ttl == -2),\n614\t                'queue-not-persistent')\n615\t        count = command('LLEN' if expected == 'list' else 'ZCARD', key)\n616\t        require(type(count) is int and 0 <= count <= 2**63 - 1, 'queue-count')\n617\t        require(kind != 'none' or count == 0, 'queue-count')\n618\t        counts[key] = count\n619\t    return dict(counts=counts, metadata_digest=digest(counts), content_verified=False)\n620\t"}]},"parent_tool_use_id":null,"session_id":"6f5f5b47-c66e-4591-b756-d99024a874c5","uuid":"1c8a18ec-076b-4bb4-9f2e-20502573df6b","timestamp":"2026-10-30T15:03:49.631Z","tool_use_result":{"type":"text","file":{"filePath":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_adapter.py","content":"\"\"\"Local-only database slice of the first-transition adapter.\n\nExact Git blobs, the reviewed migration CLI and the durable transition journal\nare reused. There is deliberately no host/SSH/Redis/deploy transport here.\nContainment/backup evidence is labelled local simulation, never production\nproof. Completion holds at database-verified; it cannot start an application,\nresume the legacy or change a gate. See the existing release runbook.\n\"\"\"\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nimport hashlib\nimport json\nfrom pathlib import Path\nimport re\nimport subprocess\nimport sys\nimport tempfile\nfrom urllib.parse import urlsplit\nfrom uuid import UUID\n\nfrom initial_transition_files import Journal, git_tree, read_regular\nfrom initial_transition_ops import BACKFILL_SQL, Refused, require\n\nAPPLICATION_SHA = 'afdfb78d71a53f2861632806e13cdda4662d7d63'\nEXECUTOR_SHA = '37c7d68d60b6f86cfb1fe75d4c720530537845d6'\nROLES = ('backend', 'cron-worker', 'broadcast-worker', 'queue-worker')\nMISSING = frozenset({\n    '20260711_023515_backfill_pessoa_tipo_membro_por_vinculo_ativo.sql',\n    '20260711_152127_reclassifica_pessoa_do_numero_whatsapp_fora_de_membro.sql',\n    '20260925_183811_preserve_platform_admins_on_tenant_deletion.sql',\n    '20260926_120446_platform_jev_settings.sql',\n})\nREVIEWED_CONCURRENT = {'20261023_100001_ai_usage_tenant_created_idx.sql': ('ai_usage_logs_igreja_created_at_idx',), '20261023_110001_notification_outbox_pending_created_idx.sql': ('notification_outbox_pending_igreja_created_idx',), '20261023_110002_notification_outbox_retry_created_idx.sql': ('notification_outbox_retry_igreja_created_idx',), '20261023_110003_notification_outbox_expired_lease_idx.sql': ('notification_outbox_lease_igreja_claimed_idx',), '20261023_110004_messages_pending_agent_created_idx.sql': ('messages_pending_agent_igreja_created_idx',), '20261023_110005_work_queue_pending_created_idx.sql': ('work_queue_pending_igreja_created_idx',), '20261028_100001_private_erasure_requests_overview_idx.sql': ('private_erasure_requests_overview_idx',), '20261028_100002_private_resume_delivered_overview_idx.sql': ('private_resume_delivered_overview_idx',)}\n\nSQL_PATH = re.compile(r'backend/migrations/[A-Za-z0-9_.-]+\\.sql')\nINDEX = re.compile(r'create\\s+(?:unique\\s+)?index\\s+concurrently\\s+(?:if\\s+not\\s+exists\\s+)?'\n                   r'(?:public\\.)?\"?([a-z0-9_]+)\"?', re.I)\n\n\ndef digest(value):\n    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',', ':')).encode()).hexdigest()\n\n\ndef adapter_sources():\n    root = Path(__file__).resolve().parent\n    return tuple((name, hashlib.sha256(read_regular(root / name)).hexdigest()) for name in (\n        'first_transition_adapter.py', 'first_transition_local_backup.py',\n        'first_transition_host_contract.py', 'first_transition_host_transport.py', 'first_transition_host_driver.py',\n        'initial_transition_files.py',\n        'initial_transition_ops.py', 'release_topology.py'))\n\n\nPREFLIGHT_PROBE = r'''\nimport json,os,sys\ntry:\n    import psycopg2\n    sys.path.insert(0,sys.argv[1])\n    import release_preflight\n    connection=psycopg2.connect(os.environ['MIGRATION_DATABASE_URL'],connect_timeout=3,hostaddr='127.0.0.1',\n        sslmode='disable',application_name='igreja12-local-preflight',\n        options='-c search_path=pg_catalog,public -c statement_timeout=5000 -c lock_timeout=2000 -c row_security=off')\n    try:\n        connection.autocommit=True\n        with connection.cursor() as cursor:\n            cursor.execute(\"SELECT shobj_description(oid,'pg_database') FROM pg_database WHERE datname=current_database()\")\n            if cursor.fetchone()[0]!='igreja12-local-disposable:'+os.environ['FIRST_TRANSITION_LOCAL_NONCE']:\n                raise RuntimeError('unowned disposable database')\n        connection.autocommit=False\n        report=release_preflight.inspect_connection(connection)\n        with connection.cursor() as cursor:\n            cursor.execute(\"SELECT current_setting('transaction_read_only')\")\n            readonly=cursor.fetchone()[0]=='on'\n        output=dict(status='ok',read_only=readonly,files=len(report.migrations),\n            applied=sum(row.state=='APLICADA' for row in report.migrations),\n            pending=sum(row.state=='PENDENTE' for row in report.migrations),\n            unknown=report.unknown_applied_count,fk_findings=len(report.fk_findings),\n            duplicates=len(report.duplicate_findings),missing_tables=len(report.missing_backup_tables),\n            definer_examined=len(report.definer_examined),\n            definer_unverified=len(report.definer_unverified),definer_findings=len(report.definer_findings))\n        print(json.dumps(output,sort_keys=True))\n    finally:\n        connection.rollback()\n        connection.close()\nexcept BaseException:\n    print('{\"status\":\"refused\",\"code\":\"full-preflight-failed\"}')\n    sys.exit(3)\n'''\n\nPREFLIGHT_COUNTS = frozenset({'files', 'applied', 'pending', 'unknown', 'fk_findings',\n                            'duplicates', 'missing_tables', 'definer_examined',\n                            'definer_unverified', 'definer_findings'})\n\n\ndef preflight_summary(raw, files, applied):\n    try:\n        data = json.loads(raw)\n    except (ValueError, TypeError):\n        raise Refused('full-preflight-output') from None\n    require(isinstance(data, dict) and set(data) == PREFLIGHT_COUNTS | {'status', 'read_only'},\n            'full-preflight-output')\n    require(data['status'] == 'ok' and data['read_only'] is True\n            and all(type(data[k]) is int and 0 <= data[k] <= 10**9 for k in PREFLIGHT_COUNTS),\n            'full-preflight-output')\n    require(data['files'] == files and data['applied'] == applied\n            and data['pending'] == files - applied, 'full-preflight-output')\n    return data\n\n\ndef require_clean_preflight(summary, *, complete):\n    require(all(summary[key] == 0 for key in ('unknown', 'fk_findings', 'duplicates',\n                                            'missing_tables', 'definer_findings')),\n            'full-preflight-findings')\n    if complete:\n        require(summary['definer_unverified'] == 0, 'full-preflight-unverified')\n\n\n@dataclass(frozen=True)\nclass Migration:\n    name: str\n    sql: bytes = field(repr=False)\n\n    @property\n    def sha256(self):\n        return hashlib.sha256(self.sql).hexdigest()\n\n    @property\n    def indexes(self):\n        code = '\\n'.join(line for line in self.sql.decode().splitlines()\n                         if not line.lstrip().startswith('--'))\n        return tuple(sorted(set(match.lower() for match in INDEX.findall(code))))\n\n    @property\n    def concurrent(self):\n        return bool(self.indexes)\n\n\n@dataclass(frozen=True)\nclass Plan:\n    application_sha: str\n    executor_sha: str\n    migrations: tuple[Migration, ...]\n    baseline: tuple[str, ...]\n    executor: bytes = field(repr=False)\n    preflight: bytes = field(repr=False)\n    adapter_sources: tuple[tuple[str, str], ...]\n\n    @property\n    def pending(self):\n        return tuple(m for m in self.migrations if m.name not in self.baseline)\n\n    @property\n    def digest(self):\n        return digest([self.application_sha, self.executor_sha, self.adapter_sources,\n                       hashlib.sha256(self.executor).hexdigest(), hashlib.sha256(self.preflight).hexdigest(),\n                       hashlib.sha256(PREFLIGHT_PROBE.encode()).hexdigest(), self.baseline,\n                       [(m.name, m.sha256) for m in self.migrations]])\n\n    def report(self):\n        return dict(application_sha=self.application_sha, executor_sha=self.executor_sha,\n                    plan_digest=self.digest, baseline=len(self.baseline), pending=len(self.pending),\n                    active=len(self.migrations), concurrent=sum(m.concurrent for m in self.pending),\n                    production_ready=False, stops_at='database-verified',\n                    preflight_sha256=hashlib.sha256(self.preflight).hexdigest(),\n                    adapter_sources_digest=digest(self.adapter_sources))\n\n\ndef prepare(repo: Path, application_sha=APPLICATION_SHA, executor_sha=EXECUTOR_SHA):\n    require(application_sha == APPLICATION_SHA and executor_sha == EXECUTOR_SHA, 'unreviewed-release')\n    files = git_tree(repo, application_sha, ('backend/migrations',), SQL_PATH)\n    migrations = tuple(Migration(Path(name).name, sql) for name, sql in sorted(files.items())\n                       if b'OPERATIONAL_AUTHORIZATION=BLOCKED' not in sql)\n    baseline = tuple(m.name for m in migrations if m.name < '20261015' and m.name not in MISSING)\n    runner = 'backend/scripts/migrate.py'\n    executor = git_tree(repo, executor_sha, (runner,), re.compile(re.escape(runner)))\n    require(runner in executor, 'executor-missing')\n    probe = 'backend/scripts/release_preflight.py'\n    probes = git_tree(repo, application_sha, (probe,), re.compile(re.escape(probe)))\n    require(probe in probes, 'preflight-missing')\n    plan = Plan(application_sha, executor_sha, migrations, baseline, executor[runner], probes[probe], adapter_sources())\n    require((len(migrations), len(baseline), len(plan.pending)) == (129, 78, 51), 'release-shape')\n    require(MISSING <= {m.name for m in migrations}, 'baseline-missing-set')\n    require(all(not re.search(r'\\bconcurrently\\b', '\\n'.join(\n        line for line in m.sql.decode().splitlines() if not line.lstrip().startswith('--')), re.I)\n        or m.name in REVIEWED_CONCURRENT for m in plan.pending), 'unreviewed-concurrent-form')\n    require({m.name: m.indexes for m in plan.pending if m.concurrent} == REVIEWED_CONCURRENT,\n            'concurrent-set')\n    return plan\n\n\ndef local_endpoint(url, *, restore=False):\n    try:\n        parsed = urlsplit(url)\n        valid = (parsed.scheme == 'postgresql' and parsed.hostname == '127.0.0.1'\n                 and parsed.username == 'postgres' and parsed.password == 'synthetic-only'\n                 and (bool(re.fullmatch(r'/first_transition_restore_[0-9a-f]{32}', parsed.path))\n                      if restore else parsed.path == '/first_transition_test')\n                 and not parsed.query and not parsed.fragment\n                 and parsed.port is not None and 0 < parsed.port < 65536)\n    except (TypeError, ValueError):\n        valid = False\n    require(valid, 'local-disposable-endpoint-required')\n\n\ndef _full_preflight_at(plan, url, applied, nonce):\n    # Both accepted database names are exclusively local disposable targets.\n    local_endpoint(url, restore=bool(re.fullmatch(\n        r'/first_transition_restore_[0-9a-f]{32}', urlsplit(url).path)))\n    with tempfile.TemporaryDirectory(prefix='igreja12-first-transition-preflight-') as directory:\n        root = Path(directory)\n        scripts = root / 'scripts'\n        scripts.mkdir()\n        (root / 'migrations').mkdir()\n        (scripts / 'migrate.py').write_bytes(plan.executor)\n        (scripts / 'release_preflight.py').write_bytes(plan.preflight)\n        for migration in plan.migrations:\n            (root / 'migrations' / migration.name).write_bytes(migration.sql)\n        env = dict(PATH='/usr/bin:/bin', PYTHON_DOTENV_DISABLED='1',\n                   MIGRATION_DATABASE_URL=url, FIRST_TRANSITION_LOCAL_NONCE=nonce)\n        try:\n            result = subprocess.run([sys.executable, '-c', PREFLIGHT_PROBE, str(scripts)],\n                                    cwd=root, env=env, capture_output=True, timeout=30)\n        except (OSError, subprocess.TimeoutExpired):\n            raise Refused('full-preflight-failed') from None\n        require(result.returncode == 0, 'full-preflight-failed')\n        return preflight_summary(result.stdout, len(plan.migrations), applied)\n\n\n@dataclass(frozen=True)\nclass LocalEvidence:\n    \"\"\"A test receipt, bound to plan/catalog/ledger. Never a real backup receipt.\n\n    kind='observed-host' is only a metadata envelope over driver-reported data:\n    validating it neither authorizes LocalTransition nor proves production.\n    \"\"\"\n    plan_digest: str\n    baseline_digest: str\n    stopped_roles: tuple[str, ...] = ROLES\n    ingress_blocked: bool = True\n    backup_rehearsal_requested: bool = True\n    queue_preservation_assumed: bool = True\n    support_preserved: bool = True\n    gates_preserved: bool = True\n    kind: str = 'local-simulation'\n    host_digest: str | None = None\n\n    @classmethod\n    def synthetic(cls, plan_digest, baseline_digest, *, host_digest=None):\n        return cls(plan_digest, baseline_digest, host_digest=host_digest)\n\n    @classmethod\n    def observed(cls, plan_digest, baseline_digest, *, host_digest):\n        return cls(plan_digest, baseline_digest, kind='observed-host', host_digest=host_digest)\n\n    def validate(self, plan_digest, baseline_digest):\n        require(self.kind in ('local-simulation', 'observed-host') and self.plan_digest == plan_digest\n                and self.baseline_digest == baseline_digest and self.stopped_roles == ROLES\n                and (self.host_digest is None and self.kind == 'local-simulation'\n                     or isinstance(self.host_digest, str) and re.fullmatch('[0-9a-f]{64}', self.host_digest))\n                and all(value is True for value in (self.ingress_blocked, self.backup_rehearsal_requested,\n                        self.queue_preservation_assumed, self.support_preserved, self.gates_preserved)),\n                'local-evidence-mismatch')\n\n\nclass LocalDatabase:\n    \"\"\"Literal loopback, dedicated DB and caller-owned disposable marker, before DDL.\n\n    Reads return ledger, catalog metadata and aggregate findings only. No row\n    payloads, queue contents or row digests are read. Another client connection\n    is refused, even idle. This plus a DB advisory lock is a local test boundary,\n    not a proof of production quiescence or full data preservation.\n    \"\"\"\n    def __init__(self, url, nonce, *, restore=False):\n        local_endpoint(url, restore=restore)\n        try:\n            require(str(UUID(nonce)) == nonce, 'disposable-marker')\n        except (ValueError, TypeError, AttributeError):\n            raise Refused('disposable-marker') from None\n        self._url, self._nonce, self.conn = url, nonce, None\n\n    def __enter__(self):\n        import psycopg2\n        try:\n            self.conn = psycopg2.connect(self._url, connect_timeout=3,hostaddr='127.0.0.1', sslmode='disable', options='',\n                                         application_name='igreja12-first-transition-local')\n            self.conn.autocommit = True\n            with self.conn.cursor() as cur:\n                cur.execute(\"SELECT shobj_description(oid, 'pg_database') FROM pg_database WHERE datname=current_database()\")\n                require(cur.fetchone()[0] == 'igreja12-local-disposable:' + self._nonce, 'disposable-marker')\n                cur.execute(\"SELECT system_identifier::text, (SELECT oid FROM pg_database WHERE datname=current_database()) FROM pg_control_system()\")\n                system, database_oid = cur.fetchone()\n                self.identity = digest([system, database_oid, self._nonce])\n                cur.execute('SELECT pg_try_advisory_lock(12712951)')\n                require(cur.fetchone()[0] is True, 'adapter-busy')\n            return self\n        except BaseException as exc:\n            self.__exit__(None, None, None)\n            if isinstance(exc, Exception) and not isinstance(exc, Refused):\n                raise Refused('local-database-unavailable-or-unowned') from None\n            raise\n\n    def __exit__(self, *_):\n        if self.conn is not None:\n            self.conn.close()\n            self.conn = None\n\n    def observe(self):\n        try:\n            return self._observe()\n        except Refused:\n            raise\n        except Exception:\n            raise Refused('database-observation-failed') from None\n\n    def _observe(self):\n        with self.conn.cursor() as cur:\n            cur.execute('BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY')\n            try:\n                cur.execute(\"SET LOCAL statement_timeout='3s'\")\n                cur.execute('SET LOCAL search_path=pg_catalog,public')\n                cur.execute(\"SELECT count(*) FROM pg_stat_activity WHERE datid=(SELECT oid FROM pg_database WHERE datname=current_database()) AND pid<>pg_backend_pid() AND backend_type='client backend'\")\n                require(cur.fetchone()[0] == 0, 'other-database-client')\n                cur.execute('SELECT name FROM public.schema_migrations ORDER BY name COLLATE \"C\"')\n                ledger = tuple(row[0] for row in cur.fetchall())\n                cur.execute(\"SELECT c.relname FROM pg_index i JOIN pg_class c ON c.oid=i.indexrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND NOT (i.indisvalid AND i.indisready) ORDER BY c.relname\")\n                invalid = tuple(row[0] for row in cur.fetchall())\n                cur.execute(\"SELECT c.oid,c.relname,c.relkind,a.attnum,a.attname,a.atttypid,a.attnotnull FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace LEFT JOIN pg_attribute a ON a.attrelid=c.oid AND a.attnum>0 AND NOT a.attisdropped WHERE n.nspname='public' ORDER BY c.oid,a.attnum\")\n                catalog = digest(cur.fetchall())\n                cur.execute(\"SELECT c.relname,pg_get_indexdef(i.indexrelid) FROM pg_index i JOIN pg_class c ON c.oid=i.indexrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' ORDER BY c.relname\")\n                indexes = {name: digest(definition) for name, definition in cur.fetchall()}\n                cur.execute('SELECT count(*) FROM (SELECT 1 FROM public.app_users WHERE pessoa_id IS NOT NULL GROUP BY igreja_id,pessoa_id HAVING count(*)>1) s')\n                duplicates = cur.fetchone()[0]\n                cur.execute('SELECT count(*) FROM public.celula_solicitacao r WHERE r.celula_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM public.celulas c WHERE c.id=r.celula_id AND c.igreja_id=r.igreja_id)')\n                invalid_links = cur.fetchone()[0]\n                cur.execute('SELECT count(*) FROM public.pessoas WHERE apto_proxima_cd IS TRUE')\n                aptitude_backfill = cur.fetchone()[0]\n                cur.execute(BACKFILL_SQL)\n                backfills = cur.fetchone()[0]\n                cur.execute(\"SELECT c.relname FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' ORDER BY c.relname\")\n                relations = tuple(row[0] for row in cur.fetchall())\n                return dict(ledger=ledger, invalid=invalid, catalog=catalog, relations=relations, indexes=indexes,\n                            duplicates=duplicates, invalid_links=invalid_links,\n                            aptitude_backfill=aptitude_backfill, backfills=backfills)\n            finally:\n                cur.execute('ROLLBACK')\n\n    def full_preflight(self, plan, applied):\n        return _full_preflight_at(plan, self._url, applied, self._nonce)\n\n    def rehearse_backup(self, plan):\n        from first_transition_local_backup import rehearse_backup\n        return rehearse_backup(self, plan)\n\n    def apply(self, plan, migration, *, timeout=300):\n        \"\"\"One exact SQL blob through the exact reviewed CLI, fresh connection.\n\n        The environment is constructed, never inherited. stdout/stderr remain\n        captured in this process and are discarded; errors expose fixed codes.\n        \"\"\"\n        with tempfile.TemporaryDirectory(prefix='igreja12-first-transition-sql-') as directory:\n            root = Path(directory)\n            (root / 'scripts').mkdir()\n            (root / 'migrations').mkdir()\n            (root / 'scripts/migrate.py').write_bytes(plan.executor)\n            (root / 'migrations' / migration.name).write_bytes(migration.sql)\n            args = [sys.executable, str(root / 'scripts/migrate.py'), 'apply', migration.name, '--yes']\n            if migration.concurrent:\n                args.append('--no-transaction')\n            env = dict(PATH='/usr/bin:/bin', PYTHON_DOTENV_DISABLED='1',\n                       MIGRATION_DATABASE_URL=self._url, PGAPPNAME='igreja12-local-migration')\n            try:\n                result = subprocess.run(args, cwd=root, env=env, capture_output=True, timeout=timeout)\n            except subprocess.TimeoutExpired:\n                raise Refused('migration-timeout') from None\n            except OSError:\n                raise Refused('migration-executor-unavailable') from None\n            require(result.returncode == 0, 'migration-failed')\n\n\ndef reviewed_indexes(migration, observation):\n    require(set(migration.indexes) <= observation['indexes'].keys(), 'reviewed-index-missing')\n    return {name: observation['indexes'][name] for name in migration.indexes}\n\n\ndef baseline_digest(observation):\n    return digest([observation['ledger'], observation['catalog']])\n\n\ndef step_invariants(observation):\n    require(not observation['invalid'], 'invalid-index')\n    require(observation['duplicates'] == 0 and observation['invalid_links'] == 0,\n            'aggregate-preflight-finding')\n\n\ndef pre_ddl_findings(observation):\n    step_invariants(observation)\n    remaining_pre_ddl_gates(observation)\n\n\ndef remaining_pre_ddl_gates(observation):\n    applied = set(observation['ledger'])\n    gates = (\n        ('20260711_023515_backfill_pessoa_tipo_membro_por_vinculo_ativo.sql',\n         observation['backfills']['membro_por_vinculo']),\n        ('20260711_152127_reclassifica_pessoa_do_numero_whatsapp_fora_de_membro.sql',\n         observation['backfills']['numero_atendimento']),\n        ('20261017_230000_uv_marcos_conclusao.sql', observation['aptitude_backfill']),\n    )\n    require(all(name in applied or candidates == 0 for name, candidates in gates),\n            'pre-ddl-backfill-candidate')\n\n\ndef validate_clone_receipt(backup, plan, identity, baseline):\n    require(isinstance(backup, dict) and backup.get('plan_digest') == plan.digest\n            and backup.get('source_identity') == identity and backup.get('baseline_digest') == baseline\n            and backup.get('restore_verified') is True, 'clone-receipt-invalid')\n    clone = backup.get('clone_rehearsal')\n    require(isinstance(clone, dict) and clone.get('migrations_verified') is True\n            and clone.get('clone_identity') != identity\n            and clone.get('cluster_global_ddl_possible') is True\n            and type(clone.get('applied')) is int and clone['applied'] == len(plan.pending)\n            and type(clone.get('final_ledger')) is int and clone['final_ledger'] == len(plan.migrations)\n            and type(clone.get('concurrent')) is int and clone['concurrent'] == sum(m.concurrent for m in plan.pending)\n            and clone.get('sql_digest') == digest([(m.name, m.sha256) for m in plan.pending])\n            and all(isinstance(clone.get(key), str) and re.fullmatch('[0-9a-f]{64}', clone[key])\n                    for key in ('final_schema_digest', 'clone_identity')),\n            'clone-receipt-invalid')\n\n\nclass LocalTransition:\n    \"\"\"Durable local DB sequence; incomplete post-marker runs need explicit retry.\n\n    adapter-failed is diagnostic; run-start/complete determine recovery consent.\n    Completed replay is read-only. Concurrent migrations committed without an\n    index receipt refuse recovery; no automatic adoption of their definitions.\n    No service promotion or legacy resume. The local disposable DB composes only\n    with the simulated LocalHostContract: an observed host, observed-host\n    evidence or a journal holding observed-host-* events is refused before any\n    DB observation or journal write, at construction and before every step.\n    \"\"\"\n    def __init__(self, plan, database, journal: Journal, *, host=None):\n        if host is not None:\n            from first_transition_host_contract import LocalHostContract\n            # One valid journal shared with the host contract.\n            require(journal is not None and getattr(host, 'j', None) is journal, 'local-host-journal-mismatch')\n            require(isinstance(host, LocalHostContract), 'local-transition-simulated-host-required')\n        self.plan, self.db, self.j, self.host = plan, database, journal, host\n        self._check_journal()\n\n    def _check_journal(self):\n        require(isinstance(self.j, Journal) and self.j.lock_fd is not None,\n                'local-transition-journal-required')\n        require(not any(event['kind'].startswith('observed-host-') for event in self.j.events),\n                'local-transition-observed-journal')\n\n    def _check_host(self, evidence):\n        self._check_journal()\n        require(evidence.kind == 'local-simulation', 'local-transition-simulated-evidence-required')\n        if self.host is None:\n            require(evidence.host_digest is None, 'local-host-evidence-unbound')\n        else:\n            receipt = self.host.assert_contained()\n            require(receipt.get('mode') == 'local-simulation' and receipt.get('host_verified') is False\n                    and evidence.host_digest == receipt['fingerprint'], 'local-host-evidence-mismatch')\n\n    def run(self, evidence: LocalEvidence, *, retry=False):\n        self._check_host(evidence)\n        init = self.j.last('adapter-init')\n        if init:\n            require(init['plan_digest'] == self.plan.digest, 'plan-changed')\n            require(init['database_identity'] == self.db.identity, 'database-changed')\n        else:\n            self.j.append('adapter-init', plan_digest=self.plan.digest,\n                          database_identity=self.db.identity, adapter_sources=dict(self.plan.adapter_sources),\n                          production_ready=False)\n        observed = self.db.observe()\n        step_invariants(observed)\n        marker = self.j.last('adapter-ddl-marker')\n        previous = self.j.last('adapter-run-start')\n        complete = self.j.last('adapter-run-complete')\n        interrupted = previous and (complete is None or complete.get('start_seq') != previous['seq'])\n        unreceipted = any(not self.j.last('done', event['step']) for event in self.j.find('intent')\n                          if str(event.get('step', '')).startswith('adapter-migration:'))\n        needs_retry = marker is not None and bool(interrupted or unreceipted)\n        if needs_retry:\n            require(retry is True, 'explicit-local-retry-required')\n            self.j.append('adapter-retry', previous_start=previous['seq'] if previous else None)\n        run_start = self.j.append('adapter-run-start')['seq']\n        if marker is None:\n            pre_ddl_findings(observed)\n            pending_indexes = {name for migration in self.plan.pending for name in migration.indexes}\n            require(not pending_indexes.intersection(observed['relations']), 'concurrent-index-without-ledger')\n            require(observed['ledger'] == self.plan.baseline, 'baseline-ledger')\n            evidence.validate(self.plan.digest, baseline_digest(observed))\n            preflight = self.db.full_preflight(self.plan, len(observed['ledger']))\n            require_clean_preflight(preflight, complete=False)\n            self.j.append('adapter-preflight', phase='before-ddl', **preflight)\n            backup = self.db.rehearse_backup(self.plan)\n            validate_clone_receipt(backup, self.plan, self.db.identity, baseline_digest(observed))\n            backup_event = self.j.append('adapter-local-restore', **backup)\n            self._check_host(evidence)\n            # Re-observe immediately before the irrevocable marker; no row hashes.\n            fresh = self.db.observe()\n            pre_ddl_findings(fresh)\n            require(not pending_indexes.intersection(fresh['relations']), 'concurrent-index-without-ledger')\n            require(baseline_digest(fresh) == baseline_digest(observed), 'baseline-changed')\n            self.j.append('adapter-ddl-marker', baseline_digest=baseline_digest(fresh),\n                          evidence_kind=evidence.kind, pending=len(self.plan.pending), irrevocable=True,\n                          restore_seq=backup_event['seq'], restore_digest=digest(backup))\n        else:\n            evidence.validate(self.plan.digest, marker['baseline_digest'])\n            restored = next((event for event in self.j.find('adapter-local-restore')\n                             if event['seq'] == marker.get('restore_seq')), None)\n            require(restored is not None and digest({k: v for k, v in restored.items()\n                    if k not in ('seq', 'at', 'kind')}) == marker.get('restore_digest'), 'restore-receipt-changed')\n            backup = {k: v for k, v in restored.items() if k not in ('seq', 'at', 'kind')}\n            validate_clone_receipt(backup, self.plan, self.db.identity, marker['baseline_digest'])\n            preflight = self.db.full_preflight(self.plan, len(observed['ledger']))\n            require_clean_preflight(preflight, complete=len(observed['ledger']) == len(self.plan.migrations))\n        ledger = list(observed['ledger'])\n        completed = [m.name for m in self.plan.pending if m.name in ledger]\n        require(set(ledger) == set(self.plan.baseline) | set(completed)\n                and completed == [m.name for m in self.plan.pending[:len(completed)]], 'ledger-not-prefix')\n        require(all(e['step'].removeprefix('adapter-migration:') in ledger\n                    for e in self.j.find('done') if e['step'].startswith('adapter-migration:')),\n                'ledger-regressed')\n        try:\n            for migration in self.plan.pending:\n                self._check_host(evidence)\n                step = 'adapter-migration:' + migration.name\n                require(all(e.get('sql_sha256') == migration.sha256 for e in self.j.find('intent', step)),\n                        'migration-intent-changed')\n                if migration.name in ledger:\n                    require(self.j.last('intent', step) is not None, 'unjournaled-migration')\n                    index_receipt = reviewed_indexes(migration, observed)\n                    done = self.j.last('done', step)\n                    if done:\n                        require(done.get('indexes') == index_receipt, 'reviewed-index-changed')\n                    else:\n                        require(not migration.indexes, 'reviewed-index-receipt-missing')\n                        self.j.append('done', step=step, recovered=True, indexes=index_receipt)\n                    continue\n                current = self.db.observe()\n                step_invariants(current)\n                remaining_pre_ddl_gates(current)\n                require(set(current['ledger']) == set(ledger), 'ledger-changed')\n                require(not (set(migration.indexes) & set(current['relations'])), 'concurrent-index-without-ledger')\n                self.j.append('intent', step=step, sql_sha256=migration.sha256)\n                self.db.apply(self.plan, migration)\n                self._check_host(evidence)\n                after = self.db.observe()\n                step_invariants(after)\n                require(set(after['ledger']) == set(ledger) | {migration.name}, 'migration-ledger-mismatch')\n                self.j.append('done', step=step, indexes=reviewed_indexes(migration, after))\n                ledger.append(migration.name)\n            require(set(ledger) == {m.name for m in self.plan.migrations}, 'final-ledger')\n            preflight = self.db.full_preflight(self.plan, len(ledger))\n            require_clean_preflight(preflight, complete=True)\n            from first_transition_local_backup import snapshot\n            try:\n                source_schema = snapshot(self.db.conn)['catalog']\n            except Exception:\n                raise Refused('clone-source-schema-check-failed') from None\n            require(source_schema == backup['clone_rehearsal']['final_schema_digest'],\n                    'clone-source-schema-divergence')\n            self._check_host(evidence)\n            final = self.db.observe()\n            step_invariants(final)\n            require(set(final['ledger']) == set(ledger), 'ledger-changed')\n            for migration in self.plan.pending:\n                done = self.j.last('done', 'adapter-migration:' + migration.name)\n                require(done is not None and done.get('indexes') == reviewed_indexes(migration, final),\n                        'reviewed-index-changed')\n            self.j.append('adapter-preflight', phase='after-ddl', **preflight)\n            if self.j.last('adapter-database-verified') is None:\n                self.j.append('adapter-database-verified', ledger=len(ledger), production_ready=False)\n            self.j.append('adapter-run-complete', start_seq=run_start)\n            return dict(status='database-verified', ledger=len(ledger), production_ready=False,\n                        services='simulated-held', host_verified=False, legacy_resume_allowed=False)\n        except BaseException as exc:\n            self.j.append('adapter-failed', code=str(exc) if isinstance(exc, Refused) else 'interrupted',\n                          legacy_resume_allowed=False)\n            raise\n\n\ndef queue_metadata(read, *, processing_keys=()):\n    \"\"\"Metadata only, over an explicitly supplied command port (no Redis client).\n\n    Callers must already know the scoped processing lists; no KEYS/SCAN, value\n    reads or row hashes. Equal lengths cannot prove equal contents, and the\n    result expressly does not certify preservation or quiescence. Tests use a\n    simulator; binding a real transport requires the separate host review.\n    \"\"\"\n    require(isinstance(processing_keys, (tuple, list)) and len(processing_keys) <= 64,\n            'queue-scope')\n    require(all(isinstance(key, str) and re.fullmatch(\n        r'pastorai:webhooks:processing:[A-Za-z0-9_-]{1,80}', key) for key in processing_keys),\n        'queue-scope')\n    require(len(set(processing_keys)) == len(processing_keys), 'queue-scope')\n    kinds = {'pastorai:webhooks': 'list', 'pastorai:webhooks:processing': 'list',\n             'pastorai:webhooks:dead': 'list', 'pastorai:webhooks:retry-scheduled': 'zset',\n             **dict.fromkeys(processing_keys, 'list')}\n    counts = {}\n    def command(name, key):\n        try:\n            return read(name, key)\n        except Exception:\n            raise Refused('queue-observation-failed') from None\n    for key, expected in sorted(kinds.items()):\n        kind = command('TYPE', key)\n        require(kind in (expected, 'none'), 'queue-type')\n        ttl = command('PTTL', key)\n        require(type(ttl) is int and (ttl == -1 if kind != 'none' else ttl == -2),\n                'queue-not-persistent')\n        count = command('LLEN' if expected == 'list' else 'ZCARD', key)\n        require(type(count) is int and 0 <= count <= 2**63 - 1, 'queue-count')\n        require(kind != 'none' or count == 0, 'queue-count')\n        counts[key] = count\n    return dict(counts=counts, metadata_digest=digest(counts), content_verified=False)\n","numLines":620,"startLine":1,"totalLines":620}},"tool_result_meta":[{"id":"toolu_011rzPaaiMWZSqH2fnMnECzr","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
