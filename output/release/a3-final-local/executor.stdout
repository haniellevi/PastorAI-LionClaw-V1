 = 'pastorai-legacy-dependencies'\n# The base file's own ``name:``; adopting it would target the legacy install.\nBASE_PROJECT = 'pastorai'\nPROJECT = re.compile(r'[a-z0-9][a-z0-9_-]{0,62}')\nNETWORK = re.compile(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,127}')\nCONTAINER = re.compile(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,127}')\nRESOURCE_ID = re.compile(r'[0-9a-f]{64}')\nSHA = re.compile(r'[0-9a-f]{40}')\nIMAGE_REF = re.compile(r'ghcr\\.io/haniellevi/pastorai-lionclaw-v1-backend@sha256:[0-9a-f]{64}')\nIMAGE_ID = re.compile(r'sha256:[0-9a-f]{64}')\nLOCAL_TAG = re.compile(r'[a-z0-9][a-z0-9._/-]{0,127}(?::[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?')\nMAX_BYTES = 16 * 1024\nPHASES = ('predecessor', 'replace', 'created', 'checker')\nPROJECT_LABEL = 'com.docker.compose.project'\nSERVICE_LABEL = 'com.docker.compose.service'\nONEOFF_LABEL = 'com.docker.compose.oneoff'\nREVISION_LABEL = 'org.opencontainers.image.revision'\n# One JSON array per container; Config.Env is never part of the template.\nINSPECT = ('[{{json .Id}},{{json .Name}},{{json .State.Running}},{{json .HostConfig.RestartPolicy.Name}},'\n           '{{json (index .Config.Labels \"' + PROJECT_LABEL + '\")}},'\n           '{{json (index .Config.Labels \"' + SERVICE_LABEL + '\")}},'\n           '{{json (index .Config.Labels \"' + ONEOFF_LABEL + '\")}},'\n           # ``index`` tolerates the absent Health key; only its status is printed, never the log.\n           '{{with index .State \"Health\"}}{{json .Status}}{{else}}null{{end}},'\n           '{{json .Image}},{{json .NetworkSettings.Networks}}]')\n\n\nclass Refused(Exception):\n    \"\"\"Fixed refusal code; never carries command output or values.\"\"\"\n\n\ndef require(condition, code):\n    if not condition:\n        raise Refused(code)\n\n\ndef _no_duplicates(pairs):\n    keys = [key for key, _ in pairs]\n    require(len(keys) == len(set(keys)), 'contract-duplicate-key')\n35:SCHEMA = 'pastorai.release-topology'\n36:VERSION = 1\n37:SERVICES = ('backend', 'queue-worker', 'cron-worker', 'broadcast-worker')\n40:BASE_ONLY = ('redis', 'evolution-postgres', 'evolution-api')\n41:DEPENDENCY_ALIASES = ('redis', 'evolution-api')\n42:DEPENDENCY_PROFILE = 'pastorai-legacy-dependencies'\n44:BASE_PROJECT = 'pastorai'\n45:PROJECT = re.compile(r'[a-z0-9][a-z0-9_-]{0,62}')\n46:NETWORK = re.compile(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,127}')\n47:CONTAINER = re.compile(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,127}')\n48:RESOURCE_ID = re.compile(r'[0-9a-f]{64}')\n49:SHA = re.compile(r'[0-9a-f]{40}')\n50:IMAGE_REF = re.compile(r'ghcr\\.io/haniellevi/pastorai-lionclaw-v1-backend@sha256:[0-9a-f]{64}')\n51:IMAGE_ID = re.compile(r'sha256:[0-9a-f]{64}')\n52:LOCAL_TAG = re.compile(r'[a-z0-9][a-z0-9._/-]{0,127}(?::[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?')\n53:MAX_BYTES = 16 * 1024\n54:PHASES = ('predecessor', 'replace', 'created', 'checker')\n55:PROJECT_LABEL = 'com.docker.compose.project'\n56:SERVICE_LABEL = 'com.docker.compose.service'\n57:ONEOFF_LABEL = 'com.docker.compose.oneoff'\n58:REVISION_LABEL = 'org.opencontainers.image.revision'\n60:INSPECT = ('[{{json .Id}},{{json .Name}},{{json .State.Running}},{{json .HostConfig.RestartPolicy.Name}},'\n69:class Refused(Exception):\n73:def require(condition, code):\n78:def _no_duplicates(pairs):\n84:def validate(data):\n106:def load(path):\n123:def canonical(contract):\n127:def overlay(contract, image=None, sha=None):\n154:def check_config(contract, model):\n174:def write_new(path, text):\n182:def docker(*args):\n191:def parse_row(line):\n198:def list_containers(attempts=3):\n222:def read_state(contract):\n231:def names_on(container, network):\n236:def ownership(contract, state):\n258:def check_targets(contract, state):\n278:def check_readiness(contract, state):\n293:def evaluate(contract, phase, state, revisions=None, revision=None):\n322:def guard(contract, phase, revision=None):\n334:def owned_ids(contract):\n342:def image_name(model):\n353:def main(argv=None):","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_resul