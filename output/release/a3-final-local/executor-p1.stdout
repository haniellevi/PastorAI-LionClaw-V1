{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qt82BgnQpy1k4F6j5Jb1EC","type":"tool_result","content":"414:def validate_clone_receipt(backup, plan, identity, baseline):\n415-    require(isinstance(backup, dict) and backup.get('plan_digest') == plan.digest\n416-            and backup.get('source_identity') == identity and backup.get('baseline_digest') == baseline\n417-            and backup.get('restore_verified') is True, 'clone-receipt-invalid')\n418-    clone = backup.get('clone_rehearsal')\n419-    require(isinstance(clone, dict) and clone.get('migrations_verified') is True\n420-            and clone.get('clone_identity') != identity\n421-            and clone.get('cluster_global_ddl_possible') is True\n422-            and type(clone.get('applied')) is int and clone['applied'] == len(plan.pending)\n423-            and type(clone.get('final_ledger')) is int and clone['final_ledger'] == len(plan.migrations)\n424-            and type(clone.get('concurrent')) is int and clone['concurrent'] == sum(m.concurrent for m in plan.pending)\n425-            and clone.get('sql_digest') == digest([(m.name, m.sha256) for m in plan.pending])\n426-            and all(isinstance(clone.get(key), str) and re.fullmatch('[0-9a-f]{64}', clone[key])\n427-                    for key in ('final_schema_digest', 'clone_identity')),\n428-            'clone-receipt-invalid')\n429-\n430-\n431-class LocalTransition:\n432-    \"\"\"Durable local DB sequence; incomplete post-marker runs need explicit retry.\n433-\n434-    adapter-failed is diagnostic; run-start/complete determine recovery consent.\n435-    Completed replay is read-only. Concurrent migrations committed without an\n436-    index receipt refuse recovery; no automatic adoption of their definitions.\n437-    No service promotion or legacy resume. The local disposable DB composes only\n438-    with the simulated LocalHostContract: an observed host, observed-host\n439-    evidence or a journal holding observed-host-* events is refused before any\n440-    DB observation or journal write, at construction and before every step.\n441-    \"\"\"\n442-    def __init__(self, plan, database, journal: Journal, *, host=None):\n443-        if host is not None:\n444-            from first_transition_host_contract import LocalHostContract\n445-            # One valid journal shared with the host contract.\n446-            require(journal is not None and getattr(host, 'j', None) is journal, 'local-host-journal-mismatch')\n447-            require(isinstance(host, LocalHostContract), 'local-transition-simulated-host-required')\n448-        self.plan, self.db, self.j, self.host = plan, database, journal, host\n449-        self._check_journal()\n450-\n451-    def _check_journal(self):\n452-        require(isinstance(self.j, Journal) and self.j.lock_fd is not None,\n453-                'local-transition-journal-required')\n454-        require(not any(event['kind'].startswith('observed-host-') for event in self.j.events),\n455-                'local-transition-observed-journal')\n456-\n457-    def _check_host(self, evidence):\n458-        self._check_journal()\n459-        require(evidence.kind == 'local-simulation', 'local-transition-simulated-evidence-required')\n63:        options='-c search_path=pg_catalog,public -c statement_timeout=5000 -c lock_timeout=2000 -c row_security=off')\n232:    \"\"\"A test receipt, bound to plan/catalog/ledger. Never a real backup receipt.\n269:    Reads return ledger, catalog metadata and aggregate findings only. No row\n321:                cur.execute('SET LOCAL search_path=pg_catalog,public')\n329:                catalog = digest(cur.fetchall())\n342:                return dict(ledger=ledger, invalid=invalid, catalog=catalog, relations=relations, indexes=indexes,\n387:    return digest([observation['ledger'], observation['catalog']])\n562:                source_schema = snapshot(self.db.conn)['catalog']\n78:class Journal:\n79-    \"\"\"Append-only JSON lines, one writer (``flock``), full write + ``fsync`` per record.\n80-\n81-    Opening validates every record (JSON object, consecutive ``seq``, ``kind``)\n82-    and refuses a torn tail instead of guessing what the crashed writer meant.\n83-    \"\"\"\n84-\n85-    def __init__(self, directory, *, writer=os.write):\n86-        self.dir = Path(directory)\n87-        self.path = self.dir / 'journal.jsonl'\n88-        self.lock_fd = None\n89-        self.events = []\n90-        self.writer = writer\n91-\n92-    def __enter__(self):\n93-        return self.open()\n94-\n95-    def __exit__(self, *_):\n96-        self.close()\n97-\n98-    def open(self):\n99-        no_symlink(self.dir)\n100-        self.dir.mkdir(mode=0o700, parents=True, exist_ok=True)\n101-        require(stat.S_ISDIR(os.lstat(self.dir).st_mode), 'state-not-directory')\n102-        no_symlink(self.dir / 'journal.lock')\n103-        no_symlink(self.path)\n104-        self.lock_fd = os.open(self.dir / 'journal.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)\n105-        try:\n106-            fcntl.flock(self.lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)\n107-        except BlockingIOError:\n108-            self.close()\n109-            raise Refused('controller-busy') from None\n110-        created = not os.path.lexists(self.path)\n111-        self.events = []\n112-        if not created:\n113-            raw = read_regular(self.path, 64 * 1024 * 1024)\n114-            lines = raw.split(b'\\n')\n115-            require(lines[-1] == b'', 'journal-torn')\n116-            for index, line in enumerate(lines[:-1], 1):\n117-                try:\n118-                    event = json.loads(line)\n119-                except ValueError:\n120-                    raise Refused('journal-torn') from None\n121-                require(isinstance(event, dict) and event.get('seq') == index\n122-                        and isinstance(event.get('kind'), str), 'journal-invalid')\n123-                self.events.append(event)\n124-        fd = os.open(self.path, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o600)\n125-        os.close(fd)\n126-        if created:\n127-            dir_fd = os.open(self.dir, os.O_RDONLY)\n128-            try:\n129-                os.fsync(dir_fd)\n130-            finally:\n131-                os.close(dir_fd)\n132-        return self\n133-\n134-    def close(self):\n135-        if self.lock_fd is not None:\n136-            os.close(self.lock_fd)  # releases the flock\n137-            self.lock_fd = None\n138-","is_error":false}]},"parent_tool_use_id":null,"session_id":"05249313-2279-499a-9431-55b58a17e539","uuid":"a623a511-5ecb-4a9b-a77e-1868f8a6f60d","timestamp":"2026-10-30T15:46:38.861Z","tool_use_result":{"stdout":"414:def validate_clone_receipt(backup, plan, identity, baseline):\n415-    require(isinstance(backup, dict) and backup.get('plan_digest') == plan.digest\n416-            and backup.get('source_identity') == identity and backup.get('baseline_digest') == baseline\n417-            and backup.get('restore_verified') is True, 'clone-receipt-invalid')\n418-    clone = backup.get('clone_rehearsal')\n419-    require(isinstance(clone, dict) and clone.get('migrations_verified') is True\n420-            and clone.get('clone_identity') != identity\n421-            and clone.get('cluster_global_ddl_possible') is True\n422-            and type(clone.get('applied')) is int and clone['applied'] == len(plan.pending)\n423-            and type(clone.get('final_ledger')) is int and clone['final_ledger'] == len(plan.migrations)\n424-            and type(clone.get('concurrent')) is int and clone['concurrent'] == sum(m.concurrent for m in plan.pending)\n425-            and clone.get('sql_digest') == digest([(m.name, m.sha256) for m in plan.pending])\n426-            and all(isinstance(clone.get(key), str) and re.fullmatch('[0-9a-f]{64}', clone[key])\n427-                    for key in ('final_schema_digest', 'clone_identity')),\n428-            'clone-re