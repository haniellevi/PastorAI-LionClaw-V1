{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QgrnCT6EbgvTXsvT9oh9Hp","type":"tool_result","content":"1\t\"\"\"Read-only PostgreSQL observations of the first transition over an injected connection.\n2\t\n3\t``ReadOnlyDatabase.observe`` opens a fresh connection from the injected factory,\n4\truns one ``REPEATABLE READ READ ONLY`` transaction and returns aggregates only:\n5\tdatabase identity, role visibility over pg_stat_activity, the ordered ledger,\n6\tthe public catalog digest (same query as the local adapter), invalid indexes,\n7\tindex builds, writing sessions and active leases. No row payload, query text,\n8\tPII or session detail is read. ``LedgerProof`` binds that observation to an\n9\texpected identity/baseline ledger/catalog: any DDL or ledger drift refuses. It\n10\tis the fresh database proof the observed driver requires before every resume\n11\teffect; a journal without a DDL marker alone is never accepted as that proof.\n12\t\n13\tNothing connects at import or construction. The real connection factory and\n14\texpected values are Phase 3 inputs (A5 preflight); errors are fixed codes.\n15\t\"\"\"\n16\tfrom __future__ import annotations\n17\t\n18\tfrom collections.abc import Callable\n19\tfrom dataclasses import dataclass\n20\timport re\n21\t\n22\tfrom first_transition_adapter import digest\n23\tfrom initial_transition_ops import Refused, require\n24\t\n25\tHEX64 = re.compile('[0-9a-f]{64}')\n26\tIDENT = re.compile('[a-z_][a-z0-9_]{0,62}')\n27\tAPPLICATION = re.compile(r'[A-Za-z0-9_.:-]{1,63}')\n28\tLEDGER_NAME = re.compile(r'[A-Za-z0-9_.-]{1,200}\\.sql')\n29\t# Lease columns of the consumers (active lease = column > now()). Counted, never read.\n30\tLEASES = (('broadcast_execucoes', 'lease_ate'), ('broadcast_entregas', 'lease_ate'),\n31\t          ('notification_outbox', 'claimed_until'), ('cell_report_audio_inputs', 'lease_until'))\n32\tOBSERVER_APPLICATION = 'igreja12-first-transition-observer'\n33\t\n34\tCURRENT_DB = '(SELECT oid FROM pg_database WHERE datname=current_database())'\n35\tQ_BEGIN = 'BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY'\n36\tQ_TIMEOUT = \"SELECT set_config('statement_timeout', %s, true)\"\n37\tQ_PATH = \"SELECT set_config('search_path', 'pg_catalog,public', true)\"\n38\tQ_RLS_OFF = \"SELECT set_config('row_security', 'off', true)\"\n39\tQ_READ_ONLY = \"SELECT current_setting('transaction_read_only')\"\n40\tQ_IDENTITY = ('SELECT s.system_identifier::text, d.oid::bigint, d.datname FROM pg_control_system() s, '\n41\t              'pg_database d WHERE d.datname=current_database()')\n42\t# USAGE, not MEMBER: a non-inherited membership does not make other sessions' activity visible.\n43\tQ_VISIBILITY = (\"SELECT r.rolsuper OR pg_has_role(current_user, 'pg_read_all_stats', 'USAGE') \"\n44\t                'FROM pg_roles r WHERE r.rolname=current_user')\n45\tQ_LEDGER = 'SELECT name FROM public.schema_migrations ORDER BY name COLLATE \"C\"'\n46\tQ_INVALID = ('SELECT c.relname FROM pg_index i JOIN pg_class c ON c.oid=i.indexrelid JOIN pg_namespace n '\n47\t             \"ON n.oid=c.relnamespace WHERE n.nspname='public' AND NOT (i.indisvalid AND i.indisready) \"\n48\t             'ORDER BY c.relname')\n49\tQ_INDEXES = (\"SELECT c.relname FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace \"\n50\t             \"WHERE n.nspname='public' AND c.relkind='i' ORDER BY c.relname\")\n51\tQ_BUILDS = 'SELECT count(*) FROM pg_stat_progress_create_index WHERE datid=' + CURRENT_DB\n52\tQ_CATALOG = ('SELECT c.oid,c.relname,c.relkind,a.attnum,a.attname,a.atttypid,a.attnotnull FROM pg_class c '\n53\t             'JOIN pg_namespace n ON n.oid=c.relnamespace LEFT JOIN pg_attribute a ON a.attrelid=c.oid '\n54\t             \"AND a.attnum>0 AND NOT a.attisdropped WHERE n.nspname='public' ORDER BY c.oid,a.attnum\")\n55\t# Potential writer = any other client session of this database holding an xid or not idle (active,\n56\t# idle in transaction, unknown state). Only this observer's own PID is excluded; no application_name\n57\t# exempts a session (a writer may not hold an xid yet). Only counted; never query/user/address.\n58\tQ_WRITERS = ('SELECT count(*) FROM pg_stat_activity WHERE datid=' + CURRENT_DB + ' AND pid<>pg_backend_pid() '\n59\t             \"AND backend_type='client backend' AND (backend_xid IS NOT NULL OR state IS DISTINCT FROM 'idle')\")\n60\tQ_RELATION = \"SELECT to_regclass(%s) IS NOT NULL\"\n61\t\n62\t\n63\tdef lease_query(table, column):\n64\t    require(IDENT.fullmatch(table) and IDENT.fullmatch(column), 'database-lease-scope')\n65\t    return f'SELECT count(*) FROM public.\"{table}\" WHERE \"{column}\" > now()'\n66\t\n67\t\n68\tdef _single(cur, query, params=None):\n69\t    cur.execute(query, params) if params is not None else cur.execute(query)\n70\t    rows = cur.fetchall()\n71\t    require(isinstance(rows, (list, tuple)) and len(rows) == 1 and len(rows[0]) >= 1, 'database-observation-shape')\n72\t    return rows[0]\n73\t\n74\t\n75\tdef _count(cur, query, params=None):\n76\t    value = _single(cur, query, params)[0]\n77\t    require(type(value) is int and 0 <= value <= 2**62, 'database-observation-shape')\n78\t    return value\n79\t\n80\t\n81\t@dataclass(frozen=True)\n82\tclass DatabaseExpectation:\n83\t    \"\"\"Identity + exact baseline ledger + catalog digest, from configuration (A5).\"\"\"\n84\t    identity: str\n85\t    ledger: tuple\n86\t    catalog: str\n87\t\n88\t    def validated(self):\n89\t        require(isinstance(self.identity, str) and HEX64.fullmatch(self.identity)\n90\t                and isinstance(self.catalog, str) and HEX64.fullmatch(self.catalog)\n91\t                and type(self.ledger) is tuple and self.ledger\n92\t                and all(isinstance(n, str) and LEDGER_NAME.fullmatch(n) for n in self.ledger)\n93\t                and list(self.ledger) == sorted(set(self.ledger)), 'database-expectation')\n94\t        return self\n95\t\n96\t    @property\n97\t    def baseline_digest(self):\n98\t        # Same value as first_transition_adapter.baseline_digest over an observation.\n99\t        return digest([list(self.ledger), self.catalog])\n100\t\n101\t\n102\tclass ReadOnlyDatabase:\n103\t    \"\"\"``observer_applications`` stays accepted (validated) for configuration compatibility only:\n104\t    application names are labels, never a bypass of the activity predicate of ``Q_WRITERS``.\"\"\"\n105\t\n106\t    def __init__(self, connect: Callable, *, lease_columns=LEASES, observer_applications=()):\n107\t        require(callable(connect), 'database-connect-missing')\n108\t        require(isinstance(lease_columns, tuple) and lease_columns and all(\n109\t            isinstance(p, tuple) and len(p) == 2 and all(isinstance(v, str) and IDENT.fullmatch(v) for v in p)\n110\t            for p in lease_columns) and len(set(lease_columns)) == len(lease_columns), 'database-lease-scope')\n111\t        require(isinstance(observer_applications, tuple) and len(observer_applications) <= 8\n112\t                and all(isinstance(a, str) and APPLICATION.fullmatch(a) for a in observer_applications),\n113\t                'database-observer-scope')\n114\t        self.connect, self.lease_columns = connect, lease_columns\n115\t        self.observer_applications = (OBSERVER_APPLICATION, *observer_applications)\n116\t\n117\t    def observe(self, *, timeout=10):\n118\t        require(type(timeout) in (int, float) and 0 < timeout <= 30, 'database-timeout-bound')\n119\t        conn, outcome = None, None\n120\t        try:\n121\t            conn = self.connect(timeout=timeout)\n122\t            result = self._observe(conn, timeout)\n123\t        except Refused as exc:\n124\t            outcome = str(exc) if str(exc).startswith('database-') else 'database-observation-failed'\n125\t        except Exception:\n126\t            outcome = 'database-observation-failed'\n127\t        finally:\n128\t            if conn is not None:\n129\t                try:\n130\t                    conn.close()\n131\t                except Exception:\n132\t                    outcome = outcome or 'database-observation-failed'\n133\t        require(outcome is None, outcome)\n134\t        return result\n135\t\n136\t    def _observe(self, conn, timeout):\n137\t        conn.autocommit = True\n138\t        cur = conn.cursor()\n139\t        cur.execute(Q_BEGIN)\n140\t        try:\n141\t            _single(cur, Q_TIMEOUT, (f'{int(timeout * 1000)}ms',))\n142\t            _single(cur, Q_PATH)\n143\t            # With row_security=off a restricted role errors instead of hiding leased rows.\n144\t            require(_single(cur, Q_RLS_OFF)[0] == 'off', 'database-row-security')\n145\t            read_only = _single(cur, Q_READ_ONLY)[0] == 'on'\n146\t            require(read_only, 'database-not-read-only')\n147\t            system, oid, name = _single(cur, Q_IDENTITY)[:3]\n148\t            require(isinstance(system, str) and system.isdigit() and type(oid) is int and isinstance(name, str),\n149\t                    'database-observation-shape')\n150\t            visible = _single(cur, Q_VISIBILITY)[0]\n151\t            require(visible is True, 'database-activity-not-visible')\n152\t            cur.execute(Q_LEDGER)\n153\t            ledger = tuple(row[0] for row in cur.fetchall())\n154\t            require(all(isinstance(n, str) and LEDGER_NAME.fullmatch(n) for n in ledger), 'database-ledger-shape')\n155\t            cur.execute(Q_INVALID)\n156\t            invalid = tuple(row[0] for row in cur.fetchall())\n157\t            cur.execute(Q_INDEXES)\n158\t            indexes = tuple(row[0] for row in cur.fetchall())\n159\t            builds = _count(cur, Q_BUILDS)\n160\t            cur.execute(Q_CATALOG)\n161\t            catalog = digest([list(row) for row in cur.fetchall()])\n162\t            writers = _count(cur, Q_WRITERS)\n163\t            leases = 0\n164\t            for table, column in self.lease_columns:\n165\t                require(_single(cur, Q_RELATION, ('public.' + table,))[0] is True, 'database-lease-relation')\n166\t                leases += _count(cur, lease_query(table, column))\n167\t            return dict(identity=digest([system, oid, name]), read_only=True, activity_visible=True,\n168\t                        ledger=ledger, ledger_digest=digest(list(ledger)), catalog=catalog, invalid=invalid,\n169\t                        indexes=indexes, index_builds=builds, writing_sessions=writers, active_leases=leases)\n170\t        finally:\n171\t            cur.execute('ROLLBACK')\n172\t\n173\t\n174\tdef require_same_database(observation, expected):\n175\t    \"\"\"Read-only observation with visible activity, of the expected database identity.\"\"\"\n176\t    require(observation['read_only'] is True and observation['activity_visible'] is True, 'database-not-read-only')\n177\t    require(observation['identity'] == expected.identity, 'database-identity-mismatch')\n178\t\n179\t\n180\tdef require_ddl_free(observation, expected):\n181\t    \"\"\"The observed database is exactly the expected baseline: no DDL, no ledger drift.\"\"\"\n182\t    require_same_database(observation, expected)\n183\t    require(observation['ledger'] == expected.ledger, 'database-ledger-drift')\n184\t    require(observation['catalog'] == expected.catalog, 'database-ddl-drift')\n185\t    require(not observation['invalid'] and observation['index_builds'] == 0, 'database-ddl-in-progress')\n186\t\n187\t\n188\tdef require_quiet(observation):\n189\t    require(observation['writing_sessions'] == 0, 'database-writing-session')\n190\t    require(observation['active_leases'] == 0, 'database-active-lease')\n191\t\n192\t\n193\tdef summary(observation):\n194\t    \"\"\"Journal-safe aggregates (no names beyond the ledger digest).\"\"\"\n195\t    return {key: observation[key] for key in ('identity', 'ledger_digest', 'catalog', 'index_builds',\n196\t                                             'writing_sessions', 'active_leases')} | dict(\n197\t        ledger_count=len(observation['ledger']), invalid_count=len(observation['invalid']))\n198\t\n199\t\n200\tclass LedgerProof:\n201\t    \"\"\"Fresh read-only proof, bound to a host scope, that no DDL ran since the baseline.\"\"\"\n202\t\n203\t    def __init__(self, database, expected, *, scope):\n204\t        require(isinstance(database, ReadOnlyDatabase), 'database-proof-source')\n205\t        require(isinstance(expected, DatabaseExpectation), 'database-expectation')\n206\t        require(isinstance(scope, str) and HEX64.fullmatch(scope), 'database-proof-scope')\n207\t        self.database, self.expected, self.scope = database, expected.validated(), scope\n208\t\n209\t    def prove(self, scope, *, timeout):\n210\t        require(scope == self.scope, 'database-proof-scope')\n211\t        observation = self.database.observe(timeout=min(timeout, 30))\n212\t        require_ddl_free(observation, self.expected)\n213\t        return dict(scope=scope, read_only=True, ddl_free=True, identity=observation['identity'],\n214\t                    ledger_digest=observation['ledger_digest'], catalog=observation['catalog'])\n215\t\n216\t\n217\tdef psycopg2_connector(secret, *, application_name=OBSERVER_APPLICATION):\n218\t    \"\"\"Connection factory for a future authorized run; the URL comes only from ``secret()``.\n219\t\n220\t    The session is forced read-only by default; the URL is never stored,\n221\t    logged or put in argv. Unused by tests.\n222\t    \"\"\"\n223\t    require(callable(secret) and APPLICATION.fullmatch(application_name), 'database-connect-missing')\n224\t\n225\t    def connect(*, timeout):\n226\t        import psycopg2\n227\t        url = secret()\n228\t        require(isinstance(url, str) and url.startswith('postgresql://') and '\\n' not in url, 'database-secret')\n229\t        return psycopg2.connect(url, connect_timeout=max(1, int(timeout)), application_name=application_name,\n230\t                                options='-c default_transaction_read_only=on')\n231\t    return connect\n232\t"}]},"parent_tool_use_id":null,"session_id":"05249313-2279-499a-9431-55b58a17e539","uuid":"1f021d1b-3172-46bf-914e-1fd388bfc43e","timestamp":"2026-10-30T15:45:19.285Z","tool_use_result":{"type":"text","file":{"filePath":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_database.py","content":"\"\"\"Read-only PostgreSQL observations of the first transition over an injected connection.\n\n``ReadOnlyDatabase.observe`` opens a fresh connection from the injected factory,\nruns one ``REPEATABLE READ READ ONLY`` transaction and returns aggregates only:\ndatabase identity, role visibility over pg_stat_activity, the ordered ledger,\nthe public catalog digest (same query as the local adapter), invalid indexes,\nindex builds, writing sessions and active leases. No row payload, query text,\nPII or session detail is read. ``LedgerProof`` binds that observation to an\nexpected identity/baseline ledger/catalog: any DDL or ledger drift refuses. It\nis the fresh database proof the observed driver requires before every resume\neffect; a journal without a DDL marker alone is never accepted as that proof.\n\nNothing connects at import or construction. The real connection factory and\nexpected values are Phase 3 inputs (A5 preflight); errors are fixed codes.\n\"\"\"\nfrom __future__ import annotations\n\nfrom collections.abc import Callable\nfrom dataclasses import dataclass\nimport re\n\nfrom first_transition_adapter import digest\nfrom initial_transition_ops import Refused, require\n\nHEX64 = re.compile('[0-9a-f]{64}')\nIDENT = re.compile('[a-z_][a-z0-9_]{0,62}')\nAPPLICATION = re.compile(r'[A-Za-z0-9_.:-]{1,63}')\nLEDGER_NAME = re.compile(r'[A-Za-z0-9_.-]{1,200}\\.sql')\n# Lease columns of the consumers (active lease = column > now()). Counted, never read.\nLEASES = (('broadcast_execucoes', 'lease_ate'), ('broadcast_entregas', 'lease_ate'),\n          ('notification_outbox', 'claimed_until'), ('cell_report_audio_inputs', 'lease_until'))\nOBSERVER_APPLICATION = 'igreja12-first-transition-observer'\n\nCURRENT_DB = '(SELECT oid FROM pg_database WHERE datname=current_database())'\nQ_BEGIN = 'BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY'\nQ_TIMEOUT = \"SELECT set_config('statement_timeout', %s, true)\"\nQ_PATH = \"SELECT set_config('search_path', 'pg_catalog,public', true)\"\nQ_RLS_OFF = \"SELECT set_config('row_security', 'off', true)\"\nQ_READ_ONLY = \"SELECT current_setting('transaction_read_only')\"\nQ_IDENTITY = ('SELECT s.system_identifier::text, d.oid::bigint, d.datname FROM pg_control_system() s, '\n              'pg_database d WHERE d.datname=current_database()')\n# USAGE, not MEMBER: a non-inherited membership does not make other sessions' activity visible.\nQ_VISIBILITY = (\"SELECT r.rolsuper OR pg_has_role(current_user, 'pg_read_all_stats', 'USAGE') \"\n                'FROM pg_roles r WHERE r.rolname=current_user')\nQ_LEDGER = 'SELECT name FROM public.schema_migrations ORDER BY name COLLATE \"C\"'\nQ_INVALID = ('SELECT c.relname FROM pg_index i JOIN pg_class c ON c.oid=i.indexrelid JOIN pg_namespace n '\n             \"ON n.oid=c.relnamespace WHERE n.nspname='public' AND NOT (i.indisvalid AND i.indisready) \"\n             'ORDER BY c.relname')\nQ_INDEXES = (\"SELECT c.relname FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace \"\n             \"WHERE n.nspname='public' AND c.relkind='i' ORDER BY c.relname\")\nQ_BUILDS = 'SELECT count(*) FROM pg_stat_progress_create_index WHERE datid=' + CURRENT_DB\nQ_CATALOG = ('SELECT c.oid,c.relname,c.relkind,a.attnum,a.attname,a.atttypid,a.attnotnull FROM pg_class c '\n             'JOIN pg_namespace n ON n.oid=c.relnamespace LEFT JOIN pg_attribute a ON a.attrelid=c.oid '\n             \"AND a.attnum>0 AND NOT a.attisdropped WHERE n.nspname='public' ORDER BY c.oid,a.attnum\")\n# Potential writer = any other client session of this database holding an xid or not idle (active,\n# idle in transaction, unknown state). Only this observer's own PID is excluded; no application_name\n# exempts a session (a writer may not hold an xid yet). Only counted; never query/user/address.\nQ_WRITERS = ('SELECT count(*) FROM pg_stat_activity WHERE datid=' + CURRENT_DB + ' AND pid<>pg_backend_pid() '\n             \"AND backend_type='client backend' AND (backend_xid IS NOT NULL OR state IS DISTINCT FROM 'idle')\")\nQ_RELATION = \"SELECT to_regclass(%s) IS NOT NULL\"\n\n\ndef lease_query(table, column):\n    require(IDENT.fullmatch(table) and IDENT.fullmatch(column), 'database-lease-scope')\n    return f'SELECT count(*) FROM public.\"{table}\" WHERE \"{column}\" > now()'\n\n\ndef _single(cur, query, params=None):\n    cur.execute(query, params) if params is not None else cur.execute(query)\n    rows = cur.fetchall()\n    require(isinstance(rows, (list, tuple)) and len(rows) == 1 and len(rows[0]) >= 1, 'database-observation-shape')\n    return rows[0]\n\n\ndef _count(cur, query, params=None):\n    value = _single(cur, query, params)[0]\n    require(type(value) is int and 0 <= value <= 2**62, 'database-observation-shape')\n    return value\n\n\n@dataclass(frozen=True)\nclass DatabaseExpectation:\n    \"\"\"Identity + exact baseline ledger + catalog digest, from configuration (A5).\"\"\"\n    identity: str\n    ledger: tuple\n    catalog: str\n\n    def validated(self):\n        require(isinstance(self.identity, str) and HEX64.fullmatch(self.identity)\n                and isinstance(self.catalog, str) and HEX64.fullmatch(self.catalog)\n                and type(self.ledger) is tuple and self.ledger\n                and all(isinstance(n, str) and LEDGER_NAME.fullmatch(n) for n in self.ledger)\n                and list(self.ledger) == sorted(set(self.ledger)), 'database-expectation')\n        return self\n\n    @property\n    def baseline_digest(self):\n        # Same value as first_transition_adapter.baseline_digest over an observation.\n        return digest([list(self.ledger), self.catalog])\n\n\nclass ReadOnlyDatabase:\n    \"\"\"``observer_applications`` stays accepted (validated) for configuration compatibility only:\n    application names are labels, never a bypass of the activity predicate of ``Q_WRITERS``.\"\"\"\n\n    def __init__(self, connect: Callable, *, lease_columns=LEASES, observer_applications=()):\n        require(callable(connect), 'database-connect-missing')\n        require(isinstance(lease_columns, tuple) and lease_columns and all(\n            isinstance(p, tuple) and len(p) == 2 and all(isinstance(v, str) and IDENT.fullmatch(v) for v in p)\n            for p in lease_columns) and len(set(lease_columns)) == len(lease_columns), 'database-lease-scope')\n        require(isinstance(observer_applications, tuple) and len(observer_applications) <= 8\n                and all(isinstance(a, str) and APPLICATION.fullmatch(a) for a in observer_applications),\n                'database-observer-scope')\n        self.connect, self.lease_columns = connect, lease_columns\n        self.observer_applications = (OBSERVER_APPLICATION, *observer_applications)\n\n    def observe(self, *, timeout=10):\n        require(type(timeout) in (int, float) and 0 < timeout <= 30, 'database-timeout-bound')\n        conn, outcome = None, None\n        try:\n            conn = self.connect(timeout=timeout)\n            result = self._observe(conn, timeout)\n        except Refused as exc:\n            outcome = str(exc) if str(exc).startswith('database-') else 'database-observation-failed'\n        except Exception:\n            outcome = 'database-observation-failed'\n        finally:\n            if conn is not None:\n                try:\n                    conn.close()\n                except Exception:\n                    outcome = outcome or 'database-observation-failed'\n        require(outcome is None, outcome)\n        return result\n\n    def _observe(self, conn, timeout):\n        conn.autocommit = True\n        cur = conn.cursor()\n        cur.execute(Q_BEGIN)\n        try:\n            _single(cur, Q_TIMEOUT, (f'{int(timeout * 1000)}ms',))\n            _single(cur, Q_PATH)\n            # With row_security=off a restricted role errors instead of hiding leased rows.\n            require(_single(cur, Q_RLS_OFF)[0] == 'off', 'database-row-security')\n            read_only = _single(cur, Q_READ_ONLY)[0] == 'on'\n            require(read_only, 'database-not-read-only')\n            system, oid, name = _single(cur, Q_IDENTITY)[:3]\n            require(isinstance(system, str) and system.isdigit() and type(oid) is int and isinstance(name, str),\n                    'database-observation-shape')\n            visible = _single(cur, Q_VISIBILITY)[0]\n            require(visible is True, 'database-activity-not-visible')\n            cur.execute(Q_LEDGER)\n            ledger = tuple(row[0] for row in cur.fetchall())\n            require(all(isinstance(n, str) and LEDGER_NAME.fullmatch(n) for n in ledger), 'database-ledger-shape')\n            cur.execute(Q_INVALID)\n            invalid = tuple(row[0] for row in cur.fetchall())\n            cur.execute(Q_INDEXES)\n            indexes = tuple(row[0] for row in cur.fetchall())\n            builds = _count(cur, Q_BUILDS)\n            cur.execute(Q_CATALOG)\n            catalog = digest([list(row) for row in cur.fetchall()])\n            writers = _count(cur, Q_WRITERS)\n            leases = 0\n            for table, column in self.lease_columns:\n                require(_single(cur, Q_RELATION, ('public.' + table,))[0] is True, 'database-lease-relation')\n                leases += _count(cur, lease_query(table, column))\n            return dict(identity=digest([system, oid, name]), read_only=True, activity_visible=True,\n                        ledger=ledger, ledger_digest=digest(list(ledger)), catalog=catalog, invalid=invalid,\n                        indexes=indexes, index_builds=builds, writing_sessions=writers, active_leases=leases)\n        finally:\n            cur.execute('ROLLBACK')\n\n\ndef require_same_database(observation, expected):\n    \"\"\"Read-only observation with visible activity, of the expected database identity.\"\"\"\n    require(observation['read_only'] is True and observation['activity_visible'] is True, 'database-not-read-only')\n    require(observation['identity'] == expected.identity, 'database-identity-mismatch')\n\n\ndef require_ddl_free(observation, expected):\n    \"\"\"The observed database is exactly the expected baseline: no DDL, no ledger drift.\"\"\"\n    require_same_database(observation, expected)\n    require(observation['ledger'] == expected.ledger, 'database-ledger-drift')\n    require(observation['catalog'] == expected.catalog, 'database-ddl-drift')\n    require(not observation['invalid'] and observation['index_builds'] == 0, 'database-ddl-in-progress')\n\n\ndef require_quiet(observation):\n    require(observation['writing_sessions'] == 0, 'database-writing-session')\n    require(observation['active_leases'] == 0, 'database-active-lease')\n\n\ndef summary(observation):\n    \"\"\"Journal-safe aggregates (no names beyond the ledger digest).\"\"\"\n    return {key: observation[key] for key in ('identity', 'ledger_digest', 'catalog', 'index_builds',\n                                             'writing_sessions', 'active_leases')} | dict(\n        ledger_count=len(observation['ledger']), invalid_count=len(observation['invalid']))\n\n\nclass LedgerProof:\n    \"\"\"Fresh read-only proof, bound to a host scope, that no DDL ran since the baseline.\"\"\"\n\n    def __init__(self, database, expected, *, scope):\n        require(isinstance(database, ReadOnlyDatabase), 'database-proof-source')\n        require(isinstance(expected, DatabaseExpectation), 'database-expectation')\n        require(isinstance(scope, str) and HEX64.fullmatch(scope), 'database-proof-scope')\n        self.database, self.expected, self.scope = database, expected.validated(), scope\n\n    def prove(self, scope, *, timeout):\n        require(scope == self.scope, 'database-proof-scope')\n        observation = self.database.observe(timeout=min(timeout, 30))\n        require_ddl_free(observation, self.expected)\n        return dict(scope=scope, read_only=True, ddl_free=True, identity=observation['identity'],\n                    ledger_digest=observation['ledger_digest'], catalog=observation['catalog'])\n\n\ndef psycopg2_connector(secret, *, application_name=OBSERVER_APPLICATION):\n    \"\"\"Connection factory for a future authorized run; the URL comes only from ``secret()``.\n\n    The session is forced read-only by default; the URL is never stored,\n    logged or put in argv. Unused by tests.\n    \"\"\"\n    require(callable(secret) and APPLICATION.fullmatch(application_name), 'database-connect-missing')\n\n    def connect(*, timeout):\n        import psycopg2\n        url = secret()\n        require(isinstance(url, str) and url.startswith('postgresql://') and '\\n' not in url, 'database-secret')\n        return psycopg2.connect(url, connect_timeout=max(1, int(timeout)), application_name=application_name,\n                                options='-c default_transaction_read_only=on')\n    return connect\n","numLines":232,"startLine":1,"totalLines":232}},"tool_result_meta":[{"id":"toolu_01QgrnCT6EbgvTXsvT9oh9Hp","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgYgRT83neEZNMCwW1sKV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01UhsYMSbYUCEpWM2Rrwnufz","name":"Read","input":{"file_path":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_orchestrator.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3009,"cache_read_input_tokens":25720,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3009},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"05249313-2279-499a-9431-55b58a17e539","uuid":"fb27c20e-f40c-4b31-95d3-1fde38f08f76","timestamp":"2026-10-30T15:45:19.610Z","request_id":"req_011CgYgRSmUGxgmxr81MGvuA","wire_tool_inputs":{"toolu_01UhsYMSbYUCEpWM2Rrwnufz":{"file_path":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_orchestrator.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UhsYMSbYUCEpWM2Rrwnufz","type":"tool_result","content":"1\t\"\"\"First-transition orchestration over injected ports, up to A9 (never A10).\n2\t\n3\tSequence (one durable journal, shared with ObservedHostContract):\n4\t\n5\t1. fresh read-only database baseline equal to the configured expectation;\n6\t2. ObservedHostContract.contain(): ingress blocked, four legacy restart=no,\n7\t   SIGTERM, clean exit 0;\n8\t3. two consecutive bounded fresh observations, each with the host still\n9\t   contained and zero writing sessions and zero active leases in the database;\n10\t4. injected backup/restore + clone rehearsal receipt validated against the plan,\n11\t   identity and baseline (first_transition_adapter.validate_clone_receipt);\n12\t5. final pre-DDL re-check, then the durable irrevocable ``ddl-marker``;\n13\t6. the 51 pending migrations (43 transactional, 8 CONCURRENTLY) one by one via\n14\t   the exact pinned ``backend/scripts/migrate.py`` bytes of the Plan, each with\n15\t   a durable intent first; the first failure or doubt stops for good;\n16\t7. candidate release layout ``<release_root>/<sha>`` (first_transition_candidate);\n17\t8. A9: four candidate containers created held (restart=no, gates closed), ONLY\n18\t   the backend started and smoked; consumers proven never started; legacy\n19\t   stopped, support preserved and ingress blocked throughout. The running\n20\t   candidate backend is a declared allowed source for the injected writer\n21\t   binding (see ``assemble``), never an unknown writer.\n22\t\n23\tRecovery is objective (``recovery()``), never automatic: no undo, no retry of a\n24\tdestructive operation, no legacy resume once the DDL marker exists. A\n25\tpre-DDL legacy resume goes through ObservedHostContract.resume_legacy, whose\n26\tdriver requires a fresh read-only ledger proof before every effect.\n27\t\n28\tConfiguration (``load_config``) holds public values only; secrets reach the\n29\tmigration child exclusively through its isolated environment. Nothing runs at\n30\timport; there is no command-line entry point and no production operation here.\n31\t\"\"\"\n32\tfrom __future__ import annotations\n33\t\n34\tfrom dataclasses import dataclass\n35\timport hashlib\n36\timport json\n37\timport os\n38\tfrom pathlib import Path\n39\timport re\n40\timport stat\n41\timport subprocess\n42\timport time\n43\t\n44\tfrom first_transition_adapter import APPLICATION_SHA, EXECUTOR_SHA, ROLES, Plan, digest, validate_clone_receipt\n45\tfrom first_transition_candidate import (CONSUMERS, CandidatePort, CandidateRunner, CandidateSpec, check_backend_running,\n46\t                                        check_held, check_identity, write_candidate_release, write_hold_override)\n47\tfrom first_transition_database import (LEASES, DatabaseExpectation, LedgerProof, ReadOnlyDatabase, require_ddl_free,\n48\t                                       require_quiet, require_same_database, summary)\n49\tfrom first_transition_host_contract import ObservedHostContract\n50\tfrom first_transition_host_driver import HostManifest, ObservedHostDriver, PopenRunner, _absolute\n51\tfrom first_transition_host_transport import ObservedHostTransport\n52\tfrom initial_transition_files import Journal, no_symlink, read_regular\n53\tfrom initial_transition_ops import Refused, require\n54\t\n55\tCONFIG_SCHEMA = 'igreja12.first-transition-config/1'\n56\tCONFIG_KEYS = frozenset({'schema', 'repo', 'state_dir', 'migration_workdir', 'python', 'docker', 'database',\n57\t                         'host', 'candidate', 'package_manifest_sha256', 'timeouts'})\n58\tTIMEOUTS = dict(migration_s=300, observe_s=10, quiescence_interval_s=5, quiescence_budget_s=60)\n59\tSHAPE = (51, 43, 8)  # pending, transactional, CONCURRENTLY\n60\tPROCEDURES = {\n61\t    'not-started': 'nothing intended: no recovery action',\n62\t    'containment-partial': 'replay run(): contain() never re-signals; an unclean exit stays refused for a human',\n63\t    'contained-pre-ddl': 'replay run() or resume_legacy(token): fresh ledger proof before every effect',\n64\t    'resume-partial': 'replay resume_legacy(token): receipted roles re-proven, ledger proof per effect',\n65\t    'legacy-resumed': 'legacy back with ingress open: start a new journal for any later attempt',\n66\t    'ddl-ambiguous': 'stop: no retry, no legacy; inspect ledger/indexes read-only and decide restore (A6) or completion',\n67\t    'ddl-failed': 'stop: no retry, no legacy; restore from the validated backup (A6) or fix forward by a new decision',\n68\t    'post-ddl-failed': 'stop: no legacy; keep ingress blocked and inspect the failure read-only before a decision',\n69\t    'candidate-ambiguous': 'stop: no undo; inspect the candidate project read-only, nothing restarted or removed',\n70\t    'candidate-failed': 'stop: no undo; consumers stay held, ingress blocked; human decision on the backend',\n71\t    'a9-complete': 'hold: backend smoked, consumers held, ingress blocked; A10 needs its own authorization',\n72\t}\n73\tPROCESS_ENV = frozenset({'PATH', 'LC_ALL', 'LANG', 'PYTHON_DOTENV_DISABLED', 'MIGRATION_DATABASE_URL', 'PGAPPNAME',\n74\t                         'PGCONNECT_TIMEOUT'})\n75\t\n76\t\n77\tclass ProcessRunner:\n78\t    \"\"\"Generic safe runner: allowlisted absolute binaries, constructed env, no shell, output discarded.\n79\t\n80\t    The environment is the only channel for secrets: argv never carries one and\n81\t    no output is captured, so nothing can reach logs or exceptions.\n82\t    \"\"\"\n83\t\n84\t    def __init__(self, *, binaries, run=None):\n85\t        require(isinstance(binaries, tuple) and binaries and all(_absolute(b) for b in binaries)\n86\t                and (run is None or callable(run)), 'process-runner-config')\n87\t        self.binaries, self.run = binaries, run\n88\t\n89\t    def __call__(self, argv, *, env, cwd, timeout):\n90\t        require(type(argv) is tuple and argv and argv[0] in self.binaries\n91\t                and all(type(a) is str and 0 < len(a) <= 4096 and '\\x00' not in a for a in argv), 'process-argv')\n92\t        require(isinstance(env, dict) and set(env) <= PROCESS_ENV\n93\t                and all(type(v) is str and '\\x00' not in v for v in env.values()), 'process-env')\n94\t        require(_absolute(cwd) and type(timeout) in (int, float) and 0 < timeout <= 3600, 'process-bounds')\n95\t        run = self.run or subprocess.run  # resolved per call, never at import/construction\n96\t        outcome = None\n97\t        try:\n98\t            done = run(list(argv), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n99\t                       env=dict(env), cwd=cwd, timeout=timeout, close_fds=True, shell=False, check=False)\n100\t        except subprocess.TimeoutExpired:\n101\t            outcome = 'timeout'\n102\t        except Exception:\n103\t            outcome = 'process-spawn-failed'\n104\t        if outcome == 'timeout':\n105\t            raise TimeoutError('process-timeout')\n106\t        require(outcome is None and type(getattr(done, 'returncode', None)) is int, outcome or 'process-failed')\n107\t        return done.returncode\n108\t\n109\t\n110\tclass MigrationExecutor:\n111\t    \"\"\"One pending migration through the exact pinned migrate.py bytes of the Plan.\n112\t\n113\t    ``python <dir>/scripts/migrate.py apply <name> --yes [--no-transaction]``\n114\t    in a fresh exclusive directory under the configured workdir; the database\n115\t    URL comes from ``secret()`` straight into the child environment.\n116\t    \"\"\"\n117\t\n118\t    def __init__(self, plan, *, python, workdir, secret, runner, timeout=300):\n119\t        require(isinstance(plan, Plan) and plan.application_sha == APPLICATION_SHA\n120\t                and plan.executor_sha == EXECUTOR_SHA, 'migration-plan')\n121\t        require(_absolute(python) and _absolute(workdir) and callable(secret) and callable(runner)\n122\t                and type(timeout) is int and 0 < timeout <= 3600, 'migration-executor-config')\n123\t        self.plan, self.python, self.workdir = plan, python, workdir\n124\t        self.secret, self.runner, self.timeout = secret, runner, timeout\n125\t\n126\t    @staticmethod\n127\t    def command(python, directory, migration):\n128\t        return (python, '-I', f'{directory}/scripts/migrate.py', 'apply', migration.name, '--yes',\n129\t                *(('--no-transaction',) if migration.concurrent else ()))\n130\t\n131\t    def _materialize(self, index, migration):\n132\t        root = no_symlink(Path(self.workdir))\n133\t        require(os.path.lexists(root) and stat.S_ISDIR(os.lstat(root).st_mode), 'migration-workdir-missing')\n134\t        directory = root / f'{index:02d}-{self.plan.digest[:16]}'\n135\t        try:\n136\t            directory.mkdir(mode=0o700)  # exclusive: a previous attempt's directory refuses\n137\t        except FileExistsError:\n138\t            raise Refused('migration-workdir-exists') from None\n139\t        (directory / 'scripts').mkdir(mode=0o700)\n140\t        (directory / 'migrations').mkdir(mode=0o700)\n141\t        for path, data in (('scripts/migrate.py', self.plan.executor), ('migrations/' + migration.name, migration.sql)):\n142\t            fd = os.open(directory / path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)\n143\t            with os.fdopen(fd, 'wb') as handle:\n144\t                handle.write(data)\n145\t        return str(directory)\n146\t\n147\t    def apply(self, index, migration):\n148\t        require(migration in self.plan.pending and self.plan.pending[index - 1] is migration, 'migration-not-pending')\n149\t        directory = self._materialize(index, migration)\n150\t        url = self.secret()\n151\t        require(isinstance(url, str) and url.startswith('postgresql://') and '\\n' not in url, 'migration-secret')\n152\t        env = dict(PATH='/usr/bin:/bin', LC_ALL='C', PYTHON_DOTENV_DISABLED='1', MIGRATION_DATABASE_URL=url,\n153\t                   PGAPPNAME=f'pastorai-first-transition-{index:02d}', PGCONNECT_TIMEOUT='10')\n154\t        return self.runner(self.command(self.python, directory, migration), env=env, cwd=directory,\n155\t                           timeout=self.timeout)\n156\t\n157\t\n158\tclass FirstTransition:\n159\t    def __init__(self, *, plan, journal, host, database, expected, backup_proof, executor, layout, candidate,\n160\t                 config_digest, clock=time.monotonic, sleep=time.sleep, timeouts=None):\n161\t        for value, kind, code in ((plan, Plan, 'plan'), (journal, Journal, 'journal'),\n162\t                                  (host, ObservedHostContract, 'host'), (database, ReadOnlyDatabase, 'database'),\n163\t                                  (expected, DatabaseExpectation, 'expectation'),\n164\t                                  (executor, MigrationExecutor, 'executor'), (candidate, CandidatePort, 'candidate')):\n165\t            require(isinstance(value, kind), 'transition-' + code + '-missing')\n166\t        require(callable(backup_proof), 'transition-backup-missing')\n167\t        require(callable(layout), 'transition-layout-missing')\n168\t        require(journal.lock_fd is not None and host.j is journal, 'transition-journal')\n169\t        require(executor.plan is plan and candidate.spec.sha == plan.application_sha, 'transition-plan-binding')\n170\t        pending = plan.pending\n171\t        require((len(pending), sum(not m.concurrent for m in pending), sum(m.concurrent for m in pending)) == SHAPE,\n172\t                'transition-release-shape')\n173\t        require(expected.validated().ledger == plan.baseline, 'transition-expectation-baseline')\n174\t        require(isinstance(config_digest, str) and re.fullmatch('[0-9a-f]{64}', config_digest), 'transition-config')\n175\t        self.t = {**TIMEOUTS, **(timeouts or {})}\n176\t        self.plan, self.j, self.host, self.db, self.expected = plan, journal, host, database, expected\n177\t        self.backup_proof, self.executor, self.layout, self.candidate = backup_proof, executor, layout, candidate\n178\t        self.config_digest, self.clock, self.sleep = config_digest, clock, sleep\n179\t\n180\t    # -- journal helpers -------------------------------------------------------------------\n181\t    def _intent(self, step, **fields):\n182\t        return self.j.append('transition-intent', step=step, **fields)\n183\t\n184\t    def _done(self, step, **fields):\n185\t        return self.j.append('transition-done', step=step, **fields)\n186\t\n187\t    def _open(self, step):\n188\t        \"\"\"Intent without receipt: the outcome is unknown and never retried automatically.\"\"\"\n189\t        return (self.j.last('transition-intent', step) is not None\n190\t                and self.j.last('transition-done', step) is None)\n191\t\n192\t    def _observe(self):\n193\t        return self.db.observe(timeout=self.t['observe_s'])\n194\t\n195\t    def _init(self):\n196\t        init = self.j.last('transition-init')\n197\t        values = dict(plan_digest=self.plan.digest, config_digest=self.config_digest,\n198\t                      baseline_digest=self.expected.baseline_digest, application_sha=self.plan.application_sha,\n199\t                      executor_sha=self.plan.executor_sha, candidate_image=self.candidate.spec.image)\n200\t        if init is None:\n201\t            self.j.append('transition-init', production_ready=False, **values)\n202\t        else:\n203\t            require(all(init.get(k) == v for k, v in values.items()), 'transition-inputs-changed')\n204\t\n205\t    # -- entry points --------------------------------------------------------------------------\n206\t    def run(self):\n207\t        self._init()\n208\t        require(self.j.last('observed-host-intent', 'legacy-resume') is None, 'transition-legacy-resume-started')\n209\t        require(self.j.last('transition-failed') is None, 'transition-stopped')  # first failure is final\n210\t        try:\n211\t            if self.j.last('ddl-marker') is None:\n212\t                self._baseline()\n213\t                self.host.contain()\n214\t                self._quiesce()\n215\t                self._backup()\n216\t                self._mark_ddl()\n217\t            self._migrate()\n218\t            self._release_layout()\n219\t            return self._a9()\n220\t        except BaseException as exc:\n221\t            if self.j.last('ddl-marker') is not None:\n222\t                self.j.append('transition-failed', code=str(exc) if isinstance(exc, Refused) else 'interrupted',\n223\t                              legacy_resume_allowed=False)\n224\t            raise\n225\t\n226\t    def resume_legacy(self, confirmation, *, allow_queue_drift=False):\n227\t        \"\"\"Pre-DDL only; the contract and the driver's ledger proof re-check everything.\"\"\"\n228\t        require(self.j.last('ddl-marker') is None and not self.j.find('transition-intent'),\n229\t                'post-ddl-resume-forbidden')\n230\t        return self.host.resume_legacy(confirmation, allow_queue_drift=allow_queue_drift)\n231\t\n232\t    # -- pre-DDL ---------------------------------------------------------------------------------\n233\t    def _baseline(self):\n234\t        observation = self._observe()\n235\t        require_ddl_free(observation, self.expected)\n236\t        if self.j.last('transition-baseline') is None:\n237\t            self.j.append('transition-baseline', evidence='database-read-only', **summary(observation))\n238\t\n239\t    def _quiet_observation(self):\n240\t        receipt = self.host.assert_contained()\n241\t        observation = self._observe()\n242\t        require_ddl_free(observation, self.expected)\n243\t        require_quiet(observation)\n244\t        return receipt['fingerprint'], receipt['queue_digest'], summary(observation)\n245\t\n246\t    def _quiesce(self):\n247\t        start = self.clock()\n248\t        first = self._quiet_observation()\n249\t        self.sleep(self.t['quiescence_interval_s'])\n250\t        second = self._quiet_observation()\n251\t        require(self.clock() - start <= self.t['quiescence_budget_s'], 'transition-quiescence-unbounded')\n252\t        require(first == second, 'transition-quiescence-changed')\n253\t        self.j.append('transition-quiescent', observations=2, writing_sessions=0, active_leases=0,\n254\t                      host_fingerprint=first[0], queue_digest=first[1], evidence='database-read-only')\n255\t\n256\t    def _backup(self):\n257\t        receipt = self.backup_proof()\n258\t        require(isinstance(receipt, dict), 'clone-receipt-invalid')\n259\t        validate_clone_receipt(receipt, self.plan, self.expected.identity, self.expected.baseline_digest)\n260\t        recorded = self.j.last('transition-backup')\n261\t        if recorded is None:\n262\t            self.j.append('transition-backup', receipt_digest=digest(receipt), restore_verified=True)\n263\t        else:\n264\t            require(recorded['receipt_digest'] == digest(receipt), 'transition-backup-changed')\n265\t        return digest(receipt)\n266\t\n267\t    def _mark_ddl(self):\n268\t        require(self.j.last('transition-quiescent') is not None, 'transition-not-quiescent')\n269\t        # Immediately before the irrevocable marker: contained, read-only baseline, quiet, backup valid.\n270\t        self._quiet_observation()\n271\t        backup = self._backup()\n272\t        self.j.append('ddl-marker', irrevocable=True, pending=[m.name for m in self.plan.pending],\n273\t                      baseline_digest=self.expected.baseline_digest, backup_digest=backup,\n274\t                      legacy_resume_allowed=False)\n275\t\n276\t    # -- DDL ----------------------------------------------------------------------------------------\n277\t    def _migrate(self):\n278\t        ledger = list(self.plan.baseline)\n279\t        for index, migration in enumerate(self.plan.pending, 1):\n280\t            step = 'migration:' + migration.name\n281\t            if self.j.last('transition-done', step) is not None:\n282\t                ledger.append(migration.name)\n283\t                continue\n284\t            require(self.j.last('transition-intent', step) is None, 'migration-outcome-ambiguous')\n285\t            before = self._observe()\n286\t            require_same_database(before, self.expected)\n287\t            require(list(before['ledger']) == sorted(ledger), 'migration-ledger-not-prefix')\n288\t            require(not before['invalid'] and before['index_builds'] == 0, 'database-ddl-in-progress')\n289\t            require_quiet(before)\n290\t            self.host.assert_contained()\n291\t            self._intent(step, index=index, sql_sha256=migration.sha256, concurrent=migration.concurrent)\n292\t            try:\n293\t                code = self.executor.apply(index, migration)\n294\t            except TimeoutError:\n295\t                code = None\n296\t            after = self._observe()\n297\t            failure = self._migration_failure(migration, code, ledger, after, self.expected)\n298\t            if failure is not None:\n299\t                # Definite only for a transactional rollback with no trace; anything else is ambiguous.\n300\t                definite = (failure == 'migration-failed' and not migration.concurrent\n301\t                            and not after['invalid'] and after['index_builds'] == 0)\n302\t                self.j.append('transition-migration-failed', step=step, code=failure, definite=definite)\n303\t                raise Refused(failure)\n304\t            self._done(step, ledger_digest=after['ledger_digest'])\n305\t            ledger.append(migration.name)\n306\t        final = self._observe()\n307\t        require_same_database(final, self.expected)  # before transition-migrated, layout and A9\n308\t        require(list(final['ledger']) == sorted(m.name for m in self.plan.migrations), 'final-ledger')\n309\t        if self.j.last('transition-migrated') is None:\n310\t            self.j.append('transition-migrated', ledger=len(final['ledger']), catalog=final['catalog'])\n311\t        else:\n312\t            require(self.j.last('transition-migrated')['catalog'] == final['catalog'], 'database-ddl-drift')\n313\t\n314\t    @staticmethod\n315\t    def _migration_failure(migration, code, ledger, after, expected):\n316\t        # A ledger read from another (or not read-only/visible) database proves nothing: ambiguous.\n317\t        try:\n318\t            require_same_database(after, expected)\n319\t        except Refused as exc:\n320\t            return str(exc)\n321\t        applied = list(after['ledger']) == sorted([*ledger, migration.name])\n322\t        if code is None:\n323\t            return 'migration-timeout'\n324\t        if code != 0:\n325\t            return 'migration-ambiguous-ledger-without-success' if applied else 'migration-failed'\n326\t        if not applied:\n327\t            return 'migration-ambiguous-exit0-no-ledger'\n328\t        if after['invalid'] or after['index_builds'] or not set(migration.indexes) <= set(after['indexes']):\n329\t            return 'migration-index-invalid'\n330\t        return None\n331\t\n332\t    def _release_layout(self):\n333\t        if self.j.last('transition-done', 'layout') is None:\n334\t            self._intent('layout')\n335\t        files = self.layout()  # exclusive or byte-for-byte verification, on every invocation\n336\t        if self.j.last('transition-done', 'layout') is None:\n337\t            self._done('layout', files=files)\n338\t\n339\t    # -- A9 ----------------------------------------------------------------------------------------\n340\t    def _candidate_states(self, ids):\n341\t        states = self.candidate.inspect(tuple(ids[r] for r in ROLES))\n342\t        result = {role: states[ids[role]] for role in ROLES}\n343\t        for role, state in result.items():\n344\t            check_identity(self.candidate.spec, role, state)\n345\t        return result\n346\t\n347\t    def _held(self, ids, created, backend_started):\n348\t        \"\"\"Consumers never started, legacy contained, support preserved, ingress blocked.\"\"\"\n349\t        states = self._candidate_states(ids)\n350\t        for role in CONSUMERS:\n351\t            check_held(states[role], created[role])\n352\t        if backend_started is None:\n353\t            check_held(states['backend'], created['backend'])\n354\t        else:\n355\t            check_backend_running(states['backend'], backend_started)\n356\t        self.host.assert_contained()\n357\t        return states\n358\t\n359\t    def _a9(self):\n360\t        created = self.j.last('transition-done', 'a9:create')\n361\t        if created is None:\n362\t            require(not self._open('a9:create'), 'candidate-create-ambiguous')\n363\t            self.host.assert_contained()\n364\t            require(self.candidate.project_ids() == (), 'candidate-project-not-empty')\n365\t            write_hold_override(self.candidate.spec)\n366\t            self._intent('a9:create', project=self.candidate.spec.project)\n367\t            self.candidate.create_held()\n368\t            found = self.candidate.project_ids()\n369\t            require(len(found) == 4, 'candidate-create-scope')\n370\t            states = self.candidate.inspect(found)\n371\t            ids = {state['service']: ident for ident, state in states.items()}\n372\t            require(set(ids) == set(ROLES), 'candidate-create-scope')\n373\t            for role in ROLES:\n374\t                check_identity(self.candidate.spec, role, states[ids[role]])\n375\t                check_held(states[ids[role]])\n376\t            created = self._done('a9:create', ids=ids, created={\n377\t                role: dict(started=states[ids[role]]['started'], restart_count=states[ids[role]]['restart_count'])\n378\t                for role in ROLES})\n379\t        ids, snapshot = created['ids'], created['created']\n380\t        require(self.candidate.project_ids() == tuple(sorted(ids.values())), 'candidate-project-changed')\n381\t        started = self.j.last('transition-done', 'a9:start-backend')\n382\t        if started is None:\n383\t            require(not self._open('a9:start-backend'), 'candidate-start-ambiguous')\n384\t            self._held(ids, snapshot, None)\n385\t            self._intent('a9:start-backend', id=ids['backend'])\n386\t            self.candidate.start_backend(ids['backend'])\n387\t            state = self._candidate_states(ids)['backend']\n388\t            check_backend_running(state)\n389\t            started = self._done('a9:start-backend', started=state['started'])\n390\t        self._held(ids, snapshot, started['started'])\n391\t        smoke = self.candidate.smoke(ids['backend'])  # fresh read-only probe on every invocation\n392\t        self._held(ids, snapshot, started['started'])\n393\t        if self.j.last('transition-a9-complete') is None:\n394\t            self.j.append('transition-a9-complete', smoke=smoke, consumers='held', ingress_blocked=True,\n395\t                          a10='not-implemented')\n396\t        return dict(status='a9-backend-smoked', smoke=smoke, consumers='held', ingress_blocked=True,\n397\t                    legacy_resume_allowed=False, a10='not-implemented', production_ready=False)\n398\t\n399\t    # -- recovery --------------------------------------------------------------------------------\n400\t    def recovery(self):\n401\t        \"\"\"Objective classification of the journal; never performs an action.\"\"\"\n402\t        j = self.j\n403\t        open_steps = [e['step'] for e in j.find('transition-intent') if self._open(e['step'])]\n404\t        failed = j.last('transition-failed')\n405\t        if j.last('transition-a9-complete') is not None and failed is None:\n406\t            state = 'a9-complete'\n407\t        elif j.last('ddl-marker') is not None:\n408\t            migrations = [s for s in open_steps if s.startswith('migration:')]\n409\t            if migrations:\n410\t                outcome = j.last('transition-migration-failed', migrations[-1])\n411\t                state = 'ddl-failed' if outcome is not None and outcome['definite'] is True else 'ddl-ambiguous'\n412\t            elif any(s.startswith('a9:') for s in open_steps):\n413\t                state = 'candidate-ambiguous'\n414\t            elif j.last('transition-done', 'layout') is not None and failed is not None:\n415\t                state = 'candidate-failed'\n416\t            else:\n417\t                state = 'post-ddl-failed'\n418\t        elif j.last('observed-host-resumed') is not None:\n419\t            state = 'legacy-resumed'\n420\t        elif j.last('observed-host-intent', 'legacy-resume') is not None:\n421\t            state = 'resume-partial'\n422\t        elif j.last('observed-host-contained') is not None:\n423\t            state = 'contained-pre-ddl'\n424\t        elif j.find('observed-host-intent'):\n425\t            state = 'containment-partial'\n426\t        else:\n427\t            state = 'not-started'\n428\t        return dict(state=state, procedure=PROCEDURES[state], open_steps=open_steps,\n429\t                    legacy_resume_allowed=state in ('contained-pre-ddl', 'resume-partial'),\n430\t                    automatic_undo=False, destructive_retry=False)\n431\t\n432\t\n433\t# -- configuration ----------------------------------------------------------------------------------\n434\t@dataclass(frozen=True)\n435\tclass FirstTransitionConfig:\n436\t    repo: str\n437\t    state_dir: str\n438\t    migration_workdir: str\n439\t    python: str\n440\t    docker: tuple\n441\t    catalog: str\n442\t    identity: str\n443\t    lease_columns: tuple\n444\t    observer_applications: tuple\n445\t    manifest: HostManifest\n446\t    candidate: CandidateSpec\n447\t    package_manifest_sha256: str\n448\t    timeouts: tuple\n449\t    digest: str\n450\t\n451\t\n452\tdef parse_config(data):\n453\t    \"\"\"Public values only: unknown keys (a password, a URL) refuse.\"\"\"\n454\t    require(isinstance(data, dict) and set(data) == CONFIG_KEYS and data['schema'] == CONFIG_SCHEMA, 'config-keys')\n455\t    docker, database, candidate, timeouts = data['docker'], data['database'], data['candidate'], data['timeouts']\n456\t    require(isinstance(docker, dict) and set(docker) == {'binary', 'endpoint', 'config_dir'}, 'config-docker')\n457\t    require(isinstance(database, dict) and set(database) == {\n458\t        'identity', 'catalog', 'lease_columns', 'observer_applications'}, 'config-database')\n459\t    require(isinstance(candidate, dict) and set(candidate) == {\n460\t        'sha', 'image', 'project', 'containers', 'network_name', 'release_root', 'hold_override', 'env_file',\n461\t        'smoke_seconds'}, 'config-candidate')\n462\t    require(isinstance(timeouts, dict) and set(timeouts) <= set(TIMEOUTS)\n463\t            and all(type(v) is int and 0 < v <= 3600 for v in timeouts.values())\n464\t            and timeouts.get('observe_s', TIMEOUTS['observe_s']) <= 30, 'config-timeouts')\n465\t    require(all(_absolute(data[k]) for k in ('repo', 'state_dir', 'migration_workdir', 'python')), 'config-paths')\n466\t    require(isinstance(database['lease_columns'], list) and isinstance(database['observer_applications'], list)\n467\t            and all(isinstance(p, list) for p in database['lease_columns']), 'config-database')\n468\t    manifest = HostManifest.from_dict(data['host'])\n469\t    containers = candidate['containers']\n470\t    require(isinstance(containers, dict) and set(containers) == set(ROLES), 'config-candidate')\n471\t    spec = CandidateSpec(sha=candidate['sha'], image=candidate['image'], project=candidate['project'],\n472\t                         containers=tuple((r, containers[r]) for r in ROLES), network_id=manifest.network_id,\n473\t                         network_name=candidate['network_name'], release_root=candidate['release_root'],\n474\t                         hold_override=candidate['hold_override'], env_file=candidate['env_file'],\n475\t                         daemon_id=manifest.daemon_id, smoke_seconds=candidate['smoke_seconds']).validated()\n476\t    require(spec.sha == APPLICATION_SHA, 'config-candidate-sha')\n477\t    require(isinstance(data['package_manifest_sha256'], str)\n478\t            and re.fullmatch('[0-9a-f]{64}', data['package_manifest_sha256']), 'config-package')\n479\t    canonical = json.dumps(data, sort_keys=True, separators=(',', ':')).encode()\n480\t    return FirstTransitionConfig(\n481\t        repo=data['repo'], state_dir=data['state_dir'], migration_workdir=data['migration_workdir'],\n482\t        python=data['python'], docker=(docker['binary'], docker['endpoint'], docker['config_dir']),\n483\t        catalog=database['catalog'], identity=database['identity'],\n484\t        lease_columns=tuple(tuple(p) for p in database['lease_columns']) or LEASES,\n485\t        observer_applications=tuple(database['observer_applications']), manifest=manifest, candidate=spec,\n486\t        package_manifest_sha256=data['package_manifest_sha256'], timeouts=tuple(sorted(timeouts.items())),\n487\t        digest=hashlib.sha256(canonical).hexdigest())\n488\t\n489\t\n490\tdef load_config(path):\n491\t    try:\n492\t        data = json.loads(read_regular(path, 64 * 1024))\n493\t    except ValueError:\n494\t        raise Refused('config-invalid-json') from None\n495\t    return parse_config(data)\n496\t\n497\t\n498\tdef assemble(config, *, plan, journal, connect, secret, ingress, writers, backup_proof, popen=None, run=None,\n499\t             clock=time.monotonic, sleep=time.sleep, git=None):\n500\t    \"\"\"Wire real ports from configuration plus injected providers; any absent provider refuses.\n501\t\n502\t    Providers (database connection, secret, ingress/writer bindings, backup\n503\t    receipt) are Phase 3 inputs; nothing is contacted while assembling.\n504\t\n505\t    ``writers.observe()`` returns the number of UNKNOWN writers: sources outside\n506\t    the declared allowed ones. Declared sources are this tool's own observer and\n507\t    migration child and, from the A9 backend start on, the candidate backend of\n508\t    ``config.candidate`` (its project/container name); none of them is an unknown\n509\t    writer. Any other source (legacy service, consumer, foreign client) counts and\n510\t    refuses. A binding that counted the candidate backend would fail closed at A9.\n511\t    \"\"\"\n512\t    require(isinstance(config, FirstTransitionConfig), 'transition-config')\n513\t    for value, code in ((connect, 'database'), (secret, 'secret'), (backup_proof, 'backup')):\n514\t        require(callable(value), 'transition-' + code + '-missing')\n515\t    require(ingress is not None and writers is not None, 'transition-host-bindings-missing')\n516\t    binary, endpoint, config_dir = config.docker\n517\t    database = ReadOnlyDatabase(connect, lease_columns=config.lease_columns,\n518\t                                observer_applications=config.observer_applications)\n519\t    expected = DatabaseExpectation(config.identity, plan.baseline, config.catalog).validated()\n520\t    proof = LedgerProof(database, expected, scope=config.manifest.digest)\n521\t    driver = ObservedHostDriver(config.manifest, ingress=ingress, writers=writers, ledger_proof=proof,\n522\t                                runner=PopenRunner(docker_binary=binary, endpoint=endpoint, config_dir=config_dir,\n523\t                                                   popen=popen, resume=True))\n524\t    host = ObservedHostContract(ObservedHostTransport(driver, **config.manifest.transport_scope()), journal)\n525\t    candidate = CandidatePort(config.candidate, runner=CandidateRunner(\n526\t        config.candidate, docker_binary=binary, endpoint=endpoint, config_dir=config_dir, popen=popen))\n527\t    executor = MigrationExecutor(plan, python=config.python, workdir=config.migration_workdir, secret=secret,\n528\t                                 runner=ProcessRunner(binaries=(config.python,), run=run),\n529\t                                 timeout=dict(config.timeouts).get('migration_s', TIMEOUTS['migration_s']))\n530\t    migrations = [m.name for m in plan.migrations]\n531\t\n532\t    def layout():\n533\t        return write_candidate_release(config.repo, config.candidate, config.manifest, migrations=migrations,\n534\t                                       package_manifest_sha256=config.package_manifest_sha256, git=git)\n535\t    return FirstTransition(plan=plan, journal=journal, host=host, database=database, expected=expected,\n536\t                           backup_proof=backup_proof, executor=executor, layout=layout, candidate=candidate,\n537\t                           config_digest=config.digest, clock=clock, sleep=sleep, timeouts=dict(config.timeouts))\n538\t"}]},"parent_tool_use_id":null,"session_id":"05249313-2279-499a-9431-55b58a17e539","uuid":"aef701f9-33a3-4a9a-9ae9-dcbaffd6601f","timestamp":"2026-10-30T15:45:19.946Z","tool_use_result":{"type":"text","file":{"filePath":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_orchestrator.py","content":"\"\"\"First-transition orchestration over injected ports, up to A9 (never A10).\n\nSequence (one durable journal, shared with ObservedHostContract):\n\n1. fresh read-only database baseline equal to the configured expectation;\n2. ObservedHostContract.contain(): ingress blocked, four legacy restart=no,\n   SIGTERM, clean exit 0;\n3. two consecutive bounded fresh observations, each with the host still\n   contained and zero writing sessions and zero active leases in the database;\n4. injected backup/restore + clone rehearsal receipt validated against the plan,\n   identity and baseline (first_transition_adapter.validate_clone_receipt);\n5. final pre-DDL re-check, then the durable irrevocable ``ddl-marker``;\n6. the 51 pending migrations (43 transactional, 8 CONCURRENTLY) one by one via\n   the exact pinned ``backend/scripts/migrate.py`` bytes of the Plan, each with\n   a durable intent first; the first failure or doubt stops for good;\n7. candidate release layout ``<release_root>/<sha>`` (first_transition_candidate);\n8. A9: four candidate containers created held (restart=no, gates closed), ONLY\n   the backend started and smoked; consumers proven never started; legacy\n   stopped, support preserved and ingress blocked throughout. The running\n   candidate backend is a declared allowed source for the injected writer\n   binding (see ``assemble``), never an unknown writer.\n\nRecovery is objective (``recovery()``), never automatic: no undo, no retry of a\ndestructive operation, no legacy resume once the DDL marker exists. A\npre-DDL legacy resume goes through ObservedHostContract.resume_legacy, whose\ndriver requires a fresh read-only ledger proof before every effect.\n\nConfiguration (``load_config``) holds public values only; secrets reach the\nmigration child exclusively through its isolated environment. Nothing runs at\nimport; there is no command-line entry point and no production operation here.\n\"\"\"\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport stat\nimport subprocess\nimport time\n\nfrom first_transition_adapter import APPLICATION_SHA, EXECUTOR_SHA, ROLES, Plan, digest, validate_clone_receipt\nfrom first_transition_candidate import (CONSUMERS, CandidatePort, CandidateRunner, CandidateSpec, check_backend_running,\n                                        check_held, check_identity, write_candidate_release, write_hold_override)\nfrom first_transition_database import (LEASES, DatabaseExpectation, LedgerProof, ReadOnlyDatabase, require_ddl_free,\n                                       require_quiet, require_same_database, summary)\nfrom first_transition_host_contract import ObservedHostContract\nfrom first_transition_host_driver import HostManifest, ObservedHostDriver, PopenRunner, _absolute\nfrom first_transition_host_transport import ObservedHostTransport\nfrom initial_transition_files import Journal, no_symlink, read_regular\nfrom initial_transition_ops import Refused, require\n\nCONFIG_SCHEMA = 'igreja12.first-transition-config/1'\nCONFIG_KEYS = frozenset({'schema', 'repo', 'state_dir', 'migration_workdir', 'python', 'docker', 'database',\n                         'host', 'candidate', 'package_manifest_sha256', 'timeouts'})\nTIMEOUTS = dict(migration_s=300, observe_s=10, quiescence_interval_s=5, quiescence_budget_s=60)\nSHAPE = (51, 43, 8)  # pending, transactional, CONCURRENTLY\nPROCEDURES = {\n    'not-started': 'nothing intended: no recovery action',\n    'containment-partial': 'replay run(): contain() never re-signals; an unclean exit stays refused for a human',\n    'contained-pre-ddl': 'replay run() or resume_legacy(token): fresh ledger proof before every effect',\n    'resume-partial': 'replay resume_legacy(token): receipted roles re-proven, ledger proof per effect',\n    'legacy-resumed': 'legacy back with ingress open: start a new journal for any later attempt',\n    'ddl-ambiguous': 'stop: no retry, no legacy; inspect ledger/indexes read-only and decide restore (A6) or completion',\n    'ddl-failed': 'stop: no retry, no legacy; restore from the validated backup (A6) or fix forward by a new decision',\n    'post-ddl-failed': 'stop: no legacy; keep ingress blocked and inspect the failure read-only before a decision',\n    'candidate-ambiguous': 'stop: no undo; inspect the candidate project read-only, nothing restarted or removed',\n    'candidate-failed': 'stop: no undo; consumers stay held, ingress blocked; human decision on the backend',\n    'a9-complete': 'hold: backend smoked, consumers held, ingress blocked; A10 needs its own authorization',\n}\nPROCESS_ENV = frozenset({'PATH', 'LC_ALL', 'LANG', 'PYTHON_DOTENV_DISABLED', 'MIGRATION_DATABASE_URL', 'PGAPPNAME',\n                         'PGCONNECT_TIMEOUT'})\n\n\nclass ProcessRunner:\n    \"\"\"Generic safe runner: allowlisted absolute binaries, constructed env, no shell, output discarded.\n\n    The environment is the only channel for secrets: argv never carries one and\n    no output is captured, so nothing can reach logs or exceptions.\n    \"\"\"\n\n    def __init__(self, *, binaries, run=None):\n        require(isinstance(binaries, tuple) and binaries and all(_absolute(b) for b in binaries)\n                and (run is None or callable(run)), 'process-runner-config')\n        self.binaries, self.run = binaries, run\n\n    def __call__(self, argv, *, env, cwd, timeout):\n        require(type(argv) is tuple and argv and argv[0] in self.binaries\n                and all(type(a) is str and 0 < len(a) <= 4096 and '\\x00' not in a for a in argv), 'process-argv')\n        require(isinstance(env, dict) and set(env) <= PROCESS_ENV\n                and all(type(v) is str and '\\x00' not in v for v in env.values()), 'process-env')\n        require(_absolute(cwd) and type(timeout) in (int, float) and 0 < timeout <= 3600, 'process-bounds')\n        run = self.run or subprocess.run  # resolved per call, never at import/construction\n        outcome = None\n        try:\n            done = run(list(argv), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n                       env=dict(env), cwd=cwd, timeout=timeout, close_fds=True, shell=False, check=False)\n        except subprocess.TimeoutExpired:\n            outcome = 'timeout'\n        except Exception:\n            outcome = 'process-spawn-failed'\n        if outcome == 'timeout':\n            raise TimeoutError('process-timeout')\n        require(outcome is None and type(getattr(done, 'returncode', None)) is int, outcome or 'process-failed')\n        return done.returncode\n\n\nclass MigrationExecutor:\n    \"\"\"One pending migration through the exact pinned migrate.py bytes of the Plan.\n\n    ``python <dir>/scripts/migrate.py apply <name> --yes [--no-transaction]``\n    in a fresh exclusive directory under the configured workdir; the database\n    URL comes from ``secret()`` straight into the child environment.\n    \"\"\"\n\n    def __init__(self, plan, *, python, workdir, secret, runner, timeout=300):\n        require(isinstance(plan, Plan) and plan.application_sha == APPLICATION_SHA\n                and plan.executor_sha == EXECUTOR_SHA, 'migration-plan')\n        require(_absolute(python) and _absolute(workdir) and callable(secret) and callable(runner)\n                and type(timeout) is int and 0 < timeout <= 3600, 'migration-executor-config')\n        self.plan, self.python, self.workdir = plan, python, workdir\n        self.secret, self.runner, self.timeout = secret, runner, timeout\n\n    @staticmethod\n    def command(python, directory, migration):\n        return (python, '-I', f'{directory}/scripts/migrate.py', 'apply', migration.name, '--yes',\n                *(('--no-transaction',) if migration.concurrent else ()))\n\n    def _materialize(self, index, migration):\n        root = no_symlink(Path(self.workdir))\n        require(os.path.lexists(root) and stat.S_ISDIR(os.lstat(root).st_mode), 'migration-workdir-missing')\n        directory = root / f'{index:02d}-{self.plan.digest[:16]}'\n        try:\n            directory.mkdir(mode=0o700)  # exclusive: a previous attempt's directory refuses\n        except FileExistsError:\n            raise Refused('migration-workdir-exists') from None\n        (directory / 'scripts').mkdir(mode=0o700)\n        (directory / 'migrations').mkdir(mode=0o700)\n        for path, data in (('scripts/migrate.py', self.plan.executor), ('migrations/' + migration.name, migration.sql)):\n            fd = os.open(directory / path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)\n            with os.fdopen(fd, 'wb') as handle:\n                handle.write(data)\n        return str(directory)\n\n    def apply(self, index, migration):\n        require(migration in self.plan.pending and self.plan.pending[index - 1] is migration, 'migration-not-pending')\n        directory = self._materialize(index, migration)\n        url = self.secret()\n        require(isinstance(url, str) and url.startswith('postgresql://') and '\\n' not in url, 'migration-secret')\n        env = dict(PATH='/usr/bin:/bin', LC_ALL='C', PYTHON_DOTENV_DISABLED='1', MIGRATION_DATABASE_URL=url,\n                   PGAPPNAME=f'pastorai-first-transition-{index:02d}', PGCONNECT_TIMEOUT='10')\n        return self.runner(self.command(self.python, directory, migration), env=env, cwd=directory,\n                           timeout=self.timeout)\n\n\nclass FirstTransition:\n    def __init__(self, *, plan, journal, host, database, expected, backup_proof, executor, layout, candidate,\n                 config_digest, clock=time.monotonic, sleep=time.sleep, timeouts=None):\n        for value, kind, code in ((plan, Plan, 'plan'), (journal, Journal, 'journal'),\n                                  (host, ObservedHostContract, 'host'), (database, ReadOnlyDatabase, 'database'),\n                                  (expected, DatabaseExpectation, 'expectation'),\n                                  (executor, MigrationExecutor, 'executor'), (candidate, CandidatePort, 'candidate')):\n            require(isinstance(value, kind), 'transition-' + code + '-missing')\n        require(callable(backup_proof), 'transition-backup-missing')\n        require(callable(layout), 'transition-layout-missing')\n        require(journal.lock_fd is not None and host.j is journal, 'transition-journal')\n        require(executor.plan is plan and candidate.spec.sha == plan.application_sha, 'transition-plan-binding')\n        pending = plan.pending\n        require((len(pending), sum(not m.concurrent for m in pending), sum(m.concurrent for m in pending)) == SHAPE,\n                'transition-release-shape')\n        require(expected.validated().ledger == plan.baseline, 'transition-expectation-baseline')\n        require(isinstance(config_digest, str) and re.fullmatch('[0-9a-f]{64}', config_digest), 'transition-config')\n        self.t = {**TIMEOUTS, **(timeouts or {})}\n        self.plan, self.j, self.host, self.db, self.expected = plan, journal, host, database, expected\n        self.backup_proof, self.executor, self.layout, self.candidate = backup_proof, executor, layout, candidate\n        self.config_digest, self.clock, self.sleep = config_digest, clock, sleep\n\n    # -- journal helpers -------------------------------------------------------------------\n    def _intent(self, step, **fields):\n        return self.j.append('transition-intent', step=step, **fields)\n\n    def _done(self, step, **fields):\n        return self.j.append('transition-done', step=step, **fields)\n\n    def _open(self, step):\n        \"\"\"Intent without receipt: the outcome is unknown and never retried automatically.\"\"\"\n        return (self.j.last('transition-intent', step) is not None\n                and self.j.last('transition-done', step) is None)\n\n    def _observe(self):\n        return self.db.observe(timeout=self.t['observe_s'])\n\n    def _init(self):\n        init = self.j.last('transition-init')\n        values = dict(plan_digest=self.plan.digest, config_digest=self.config_digest,\n                      baseline_digest=self.expected.baseline_digest, application_sha=self.plan.application_sha,\n                      executor_sha=self.plan.executor_sha, candidate_image=self.candidate.spec.image)\n        if init is None:\n            self.j.append('transition-init', production_ready=False, **values)\n        else:\n            require(all(init.get(k) == v for k, v in values.items()), 'transition-inputs-changed')\n\n    # -- entry points --------------------------------------------------------------------------\n    def run(self):\n        self._init()\n        require(self.j.last('observed-host-intent', 'legacy-resume') is None, 'transition-legacy-resume-started')\n        require(self.j.last('transition-failed') is None, 'transition-stopped')  # first failure is final\n        try:\n            if self.j.last('ddl-marker') is None:\n                self._baseline()\n                self.host.contain()\n                self._quiesce()\n                self._backup()\n                self._mark_ddl()\n            self._migrate()\n            self._release_layout()\n            return self._a9()\n        except BaseException as exc:\n            if self.j.last('ddl-marker') is not None:\n                self.j.append('transition-failed', code=str(exc) if isinstance(exc, Refused) else 'interrupted',\n                              legacy_resume_allowed=False)\n            raise\n\n    def resume_legacy(self, confirmation, *, allow_queue_drift=False):\n        \"\"\"Pre-DDL only; the contract and the driver's ledger proof re-check everything.\"\"\"\n        require(self.j.last('ddl-marker') is None and not self.j.find('transition-intent'),\n                'post-ddl-resume-forbidden')\n        return self.host.resume_legacy(confirmation, allow_queue_drift=allow_queue_drift)\n\n    # -- pre-DDL ---------------------------------------------------------------------------------\n    def _baseline(self):\n        observation = self._observe()\n        require_ddl_free(observation, self.expected)\n        if self.j.last('transition-baseline') is None:\n            self.j.append('transition-baseline', evidence='database-read-only', **summary(observation))\n\n    def _quiet_observation(self):\n        receipt = self.host.assert_contained()\n        observation = self._observe()\n        require_ddl_free(observation, self.expected)\n        require_quiet(observation)\n        return receipt['fingerprint'], receipt['queue_digest'], summary(observation)\n\n    def _quiesce(self):\n        start = self.clock()\n        first = self._quiet_observation()\n        self.sleep(self.t['quiescence_interval_s'])\n        second = self._quiet_observation()\n        require(self.clock() - start <= self.t['quiescence_budget_s'], 'transition-quiescence-unbounded')\n        require(first == second, 'transition-quiescence-changed')\n        self.j.append('transition-quiescent', observations=2, writing_sessions=0, active_leases=0,\n                      host_fingerprint=first[0], queue_digest=first[1], evidence='database-read-only')\n\n    def _backup(self):\n        receipt = self.backup_proof()\n        require(isinstance(receipt, dict), 'clone-receipt-invalid')\n        validate_clone_receipt(receipt, self.plan, self.expected.identity, self.expected.baseline_digest)\n        recorded = self.j.last('transition-backup')\n        if recorded is None:\n            self.j.append('transition-backup', receipt_digest=digest(receipt), restore_verified=True)\n        else:\n            require(recorded['receipt_digest'] == digest(receipt), 'transition-backup-changed')\n        return digest(receipt)\n\n    def _mark_ddl(self):\n        require(self.j.last('transition-quiescent') is not None, 'transition-not-quiescent')\n        # Immediately before the irrevocable marker: contained, read-only baseline, quiet, backup valid.\n        self._quiet_observation()\n        backup = self._backup()\n        self.j.append('ddl-marker', irrevocable=True, pending=[m.name for m in self.plan.pending],\n                      baseline_digest=self.expected.baseline_digest, backup_digest=backup,\n                      legacy_resume_allowed=False)\n\n    # -- DDL ----------------------------------------------------------------------------------------\n    def _migrate(self):\n        ledger = list(self.plan.baseline)\n        for index, migration in enumerate(self.plan.pending, 1):\n            step = 'migration:' + migration.name\n            if self.j.last('transition-done', step) is not None:\n                ledger.append(migration.name)\n                continue\n            require(self.j.last('transition-intent', step) is None, 'migration-outcome-ambiguous')\n            before = self._observe()\n            require_same_database(before, self.expected)\n            require(list(before['ledger']) == sorted(ledger), 'migration-ledger-not-prefix')\n            require(not before['invalid'] and before['index_builds'] == 0, 'database-ddl-in-progress')\n            require_quiet(before)\n            self.host.assert_contained()\n            self._intent(step, index=index, sql_sha256=migration.sha256, concurrent=migration.concurrent)\n            try:\n                code = self.executor.apply(index, migration)\n            except TimeoutError:\n                code = None\n            after = self._observe()\n            failure = self._migration_failure(migration, code, ledger, after, self.expected)\n            if failure is not None:\n                # Definite only for a transactional rollback with no trace; anything else is ambiguous.\n                definite = (failure == 'migration-failed' and not migration.concurrent\n                            and not after['invalid'] and after['index_builds'] == 0)\n                self.j.append('transition-migration-failed', step=step, code=failure, definite=definite)\n                raise Refused(failure)\n            self._done(step, ledger_digest=after['ledger_digest'])\n            ledger.append(migration.name)\n        final = self._observe()\n        require_same_database(final, self.expected)  # before transition-migrated, layout and A9\n        require(list(final['ledger']) == sorted(m.name for m in self.plan.migrations), 'final-ledger')\n        if self.j.last('transition-migrated') is None:\n            self.j.append('transition-migrated', ledger=len(final['ledger']), catalog=final['catalog'])\n        else:\n            require(self.j.last('transition-migrated')['catalog'] == final['catalog'], 'database-ddl-drift')\n\n    @staticmethod\n    def _migration_failure(migration, code, ledger, after, expected):\n        # A ledger read from another (or not read-only/visible) database proves nothing: ambiguous.\n        try:\n            require_same_database(after, expected)\n        except Refused as exc:\n            return str(exc)\n        applied = list(after['ledger']) == sorted([*ledger, migration.name])\n        if code is None:\n            return 'migration-timeout'\n        if code != 0:\n            return 'migration-ambiguous-ledger-without-success' if applied else 'migration-failed'\n        if not applied:\n            return 'migration-ambiguous-exit0-no-ledger'\n        if after['invalid'] or after['index_builds'] or not set(migration.indexes) <= set(after['indexes']):\n            return 'migration-index-invalid'\n        return None\n\n    def _release_layout(self):\n        if self.j.last('transition-done', 'layout') is None:\n            self._intent('layout')\n        files = self.layout()  # exclusive or byte-for-byte verification, on every invocation\n        if self.j.last('transition-done', 'layout') is None:\n            self._done('layout', files=files)\n\n    # -- A9 ----------------------------------------------------------------------------------------\n    def _candidate_states(self, ids):\n        states = self.candidate.inspect(tuple(ids[r] for r in ROLES))\n        result = {role: states[ids[role]] for role in ROLES}\n        for role, state in result.items():\n            check_identity(self.candidate.spec, role, state)\n        return result\n\n    def _held(self, ids, created, backend_started):\n        \"\"\"Consumers never started, legacy contained, support preserved, ingress blocked.\"\"\"\n        states = self._candidate_states(ids)\n        for role in CONSUMERS:\n            check_held(states[role], created[role])\n        if backend_started is None:\n            check_held(states['backend'], created['backend'])\n        else:\n            check_backend_running(states['backend'], backend_started)\n        self.host.assert_contained()\n        return states\n\n    def _a9(self):\n        created = self.j.last('transition-done', 'a9:create')\n        if created is None:\n            require(not self._open('a9:create'), 'candidate-create-ambiguous')\n            self.host.assert_contained()\n            require(self.candidate.project_ids() == (), 'candidate-project-not-empty')\n            write_hold_override(self.candidate.spec)\n            self._intent('a9:create', project=self.candidate.spec.project)\n            self.candidate.create_held()\n            found = self.candidate.project_ids()\n            require(len(found) == 4, 'candidate-create-scope')\n            states = self.candidate.inspect(found)\n            ids = {state['service']: ident for ident, state in states.items()}\n            require(set(ids) == set(ROLES), 'candidate-create-scope')\n            for role in ROLES:\n                check_identity(self.candidate.spec, role, states[ids[role]])\n                check_held(states[ids[role]])\n            created = self._done('a9:create', ids=ids, created={\n                role: dict(started=states[ids[role]]['started'], restart_count=states[ids[role]]['restart_count'])\n                for role in ROLES})\n        ids, snapshot = created['ids'], created['created']\n        require(self.candidate.project_ids() == tuple(sorted(ids.values())), 'candidate-project-changed')\n        started = self.j.last('transition-done', 'a9:start-backend')\n        if started is None:\n            require(not self._open('a9:start-backend'), 'candidate-start-ambiguous')\n            self._held(ids, snapshot, None)\n            self._intent('a9:start-backend', id=ids['backend'])\n            self.candidate.start_backend(ids['backend'])\n            state = self._candidate_states(ids)['backend']\n            check_backend_running(state)\n            started = self._done('a9:start-backend', started=state['started'])\n        self._held(ids, snapshot, started['started'])\n        smoke = self.candidate.smoke(ids['backend'])  # fresh read-only probe on every invocation\n        self._held(ids, snapshot, started['started'])\n        if self.j.last('transition-a9-complete') is None:\n            self.j.append('transition-a9-complete', smoke=smoke, consumers='held', ingress_blocked=True,\n                          a10='not-implemented')\n        return dict(status='a9-backend-smoked', smoke=smoke, consumers='held', ingress_blocked=True,\n                    legacy_resume_allowed=False, a10='not-implemented', production_ready=False)\n\n    # -- recovery --------------------------------------------------------------------------------\n    def recovery(self):\n        \"\"\"Objective classification of the journal; never performs an action.\"\"\"\n        j = self.j\n        open_steps = [e['step'] for e in j.find('transition-intent') if self._open(e['step'])]\n        failed = j.last('transition-failed')\n        if j.last('transition-a9-complete') is not None and failed is None:\n            state = 'a9-complete'\n        elif j.last('ddl-marker') is not None:\n            migrations = [s for s in open_steps if s.startswith('migration:')]\n            if migrations:\n                outcome = j.last('transition-migration-failed', migrations[-1])\n                state = 'ddl-failed' if outcome is not None and outcome['definite'] is True else 'ddl-ambiguous'\n            elif any(s.startswith('a9:') for s in open_steps):\n                state = 'candidate-ambiguous'\n            elif j.last('transition-done', 'layout') is not None and failed is not None:\n                state = 'candidate-failed'\n            else:\n                state = 'post-ddl-failed'\n        elif j.last('observed-host-resumed') is not None:\n            state = 'legacy-resumed'\n        elif j.last('observed-host-intent', 'legacy-resume') is not None:\n            state = 'resume-partial'\n        elif j.last('observed-host-contained') is not None:\n            state = 'contained-pre-ddl'\n        elif j.find('observed-host-intent'):\n            state = 'containment-partial'\n        else:\n            state = 'not-started'\n        return dict(state=state, procedure=PROCEDURES[state], open_steps=open_steps,\n                    legacy_resume_allowed=state in ('contained-pre-ddl', 'resume-partial'),\n                    automatic_undo=False, destructive_retry=False)\n\n\n# -- configuration ----------------------------------------------------------------------------------\n@dataclass(frozen=True)\nclass FirstTransitionConfig:\n    repo: str\n    state_dir: str\n    migration_workdir: str\n    python: str\n    docker: tuple\n    catalog: str\n    identity: str\n    lease_columns: tuple\n    observer_applications: tuple\n    manifest: HostManifest\n    candidate: CandidateSpec\n    package_manifest_sha256: str\n    timeouts: tuple\n    digest: str\n\n\ndef parse_config(data):\n    \"\"\"Public values only: unknown keys (a password, a URL) refuse.\"\"\"\n    require(isinstance(data, dict) and set(data) == CONFIG_KEYS and data['schema'] == CONFIG_SCHEMA, 'config-keys')\n    docker, database, candidate, timeouts = data['docker'], data['database'], data['candidate'], data['timeouts']\n    require(isinstance(docker, dict) and set(docker) == {'binary', 'endpoint', 'config_dir'}, 'config-docker')\n    require(isinstance(database, dict) and set(database) == {\n        'identity', 'catalog', 'lease_columns', 'observer_applications'}, 'config-database')\n    require(isinstance(candidate, dict) and set(candidate) == {\n        'sha', 'image', 'project', 'containers', 'network_name', 'release_root', 'hold_override', 'env_file',\n        'smoke_seconds'}, 'config-candidate')\n    require(isinstance(timeouts, dict) and set(timeouts) <= set(TIMEOUTS)\n            and all(type(v) is int and 0 < v <= 3600 for v in timeouts.values())\n            and timeouts.get('observe_s', TIMEOUTS['observe_s']) <= 30, 'config-timeouts')\n    require(all(_absolute(data[k]) for k in ('repo', 'state_dir', 'migration_workdir', 'python')), 'config-paths')\n    require(isinstance(database['lease_columns'], list) and isinstance(database['observer_applications'], list)\n            and all(isinstance(p, list) for p in database['lease_columns']), 'config-database')\n    manifest = HostManifest.from_dict(data['host'])\n    containers = candidate['containers']\n    require(isinstance(containers, dict) and set(containers) == set(ROLES), 'config-candidate')\n    spec = CandidateSpec(sha=candidate['sha'], image=candidate['image'], project=candidate['project'],\n                         containers=tuple((r, containers[r]) for r in ROLES), network_id=manifest.network_id,\n                         network_name=candidate['network_name'], release_root=candidate['release_root'],\n                         hold_override=candidate['hold_override'], env_file=candidate['env_file'],\n                         daemon_id=manifest.daemon_id, smoke_seconds=candidate['smoke_seconds']).validated()\n    require(spec.sha == APPLICATION_SHA, 'config-candidate-sha')\n    require(isinstance(data['package_manifest_sha256'], str)\n            and re.fullmatch('[0-9a-f]{64}', data['package_manifest_sha256']), 'config-package')\n    canonical = json.dumps(data, sort_keys=True, separators=(',', ':')).encode()\n    return FirstTransitionConfig(\n        repo=data['repo'], state_dir=data['state_dir'], migration_workdir=data['migration_workdir'],\n        python=data['python'], docker=(docker['binary'], docker['endpoint'], docker['config_dir']),\n        catalog=database['catalog'], identity=database['identity'],\n        lease_columns=tuple(tuple(p) for p in database['lease_columns']) or LEASES,\n        observer_applications=tuple(database['observer_applications']), manifest=manifest, candidate=spec,\n        package_manifest_sha256=data['package_manifest_sha256'], timeouts=tuple(sorted(timeouts.items())),\n        digest=hashlib.sha256(canonical).hexdigest())\n\n\ndef load_config(path):\n    try:\n        data = json.loads(read_regular(path, 64 * 1024))\n    except ValueError:\n        raise Refused('config-invalid-json') from None\n    return parse_config(data)\n\n\ndef assemble(config, *, plan, journal, connect, secret, ingress, writers, backup_proof, popen=None, run=None,\n             clock=time.monotonic, sleep=time.sleep, git=None):\n    \"\"\"Wire real ports from configuration plus injected providers; any absent provider refuses.\n\n    Providers (database connection, secret, ingress/writer bindings, backup\n    receipt) are Phase 3 inputs; nothing is contacted while assembling.\n\n    ``writers.observe()`` returns the number of UNKNOWN writers: sources outside\n    the declared allowed ones. Declared sources are this tool's own observer and\n    migration child and, from the A9 backend start on, the candidate backend of\n    ``config.candidate`` (its project/container name); none of them is an unknown\n    writer. Any other source (legacy service, consumer, foreign client) counts and\n    refuses. A binding that counted the candidate backend would fail closed at A9.\n    \"\"\"\n    require(isinstance(config, FirstTransitionConfig), 'transition-config')\n    for value, code in ((connect, 'database'), (secret, 'secret'), (backup_proof, 'backup')):\n        require(callable(value), 'transition-' + code + '-missing')\n    require(ingress is not None and writers is not None, 'transition-host-bindings-missing')\n    binary, endpoint, config_dir = config.docker\n    database = ReadOnlyDatabase(connect, lease_columns=config.lease_columns,\n                                observer_applications=config.observer_applications)\n    expected = DatabaseExpectation(config.identity, plan.baseline, config.catalog).validated()\n    proof = LedgerProof(database, expected, scope=config.manifest.digest)\n    driver = ObservedHostDriver(config.manifest, ingress=ingress, writers=writers, ledger_proof=proof,\n                                runner=PopenRunner(docker_binary=binary, endpoint=endpoint, config_dir=config_dir,\n                                                   popen=popen, resume=True))\n    host = ObservedHostContract(ObservedHostTransport(driver, **config.manifest.transport_scope()), journal)\n    candidate = CandidatePort(config.candidate, runner=CandidateRunner(\n        config.candidate, docker_binary=binary, endpoint=endpoint, config_dir=config_dir, popen=popen))\n    executor = MigrationExecutor(plan, python=config.python, workdir=config.migration_workdir, secret=secret,\n                                 runner=ProcessRunner(binaries=(config.python,), run=run),\n                                 timeout=dict(config.timeouts).get('migration_s', TIMEOUTS['migration_s']))\n    migrations = [m.name for m in plan.migrations]\n\n    def layout():\n        return write_candidate_release(config.repo, config.candidate, config.manifest, migrations=migrations,\n                                       package_manifest_sha256=config.package_manifest_sha256, git=git)\n    return FirstTransition(plan=plan, journal=journal, host=host, database=database, expected=expected,\n                           backup_proof=backup_proof, executor=executor, layout=layout, candidate=candidate,\n                           config_digest=config.digest, clock=clock, sleep=sleep, timeouts=dict(config.timeouts))\n","numLines":538,"startLine":1,"totalLines":538}},"tool_result_meta":[{"id":"toolu_01UhsYMSbYUCEpWM2Rrwnufz","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
