{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017Bq9oyYXrCqUrSx7e1Bro9","type":"tool_result","content":"1\t\"\"\"Read-only database observer/ledger proof over a fake DB-API connection; no PostgreSQL is used.\"\"\"\n2\timport os\n3\tfrom pathlib import Path\n4\timport socket\n5\timport subprocess\n6\timport sys\n7\t\n8\timport pytest\n9\t\n10\tsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\n11\timport first_transition_database as fdb\n12\tfrom first_transition_adapter import Refused, baseline_digest, digest\n13\tfrom first_transition_database import (DatabaseExpectation, LedgerProof, ReadOnlyDatabase, require_ddl_free,\n14\t                                       require_quiet)\n15\t\n16\tRLS_OFF = \"SELECT set_config('row_security', 'off', true)\"\n17\tSCOPE = 'c' * 64\n18\tSECRET = 'SENTINEL-DB-SECRET'\n19\tSTATEMENTS = {RLS_OFF, fdb.Q_BEGIN, fdb.Q_TIMEOUT, fdb.Q_PATH, fdb.Q_READ_ONLY, fdb.Q_IDENTITY, fdb.Q_VISIBILITY,\n20\t              fdb.Q_LEDGER, fdb.Q_INVALID, fdb.Q_INDEXES, fdb.Q_BUILDS, fdb.Q_CATALOG, fdb.Q_WRITERS,\n21\t              fdb.Q_RELATION, 'ROLLBACK', *(fdb.lease_query(t, c) for t, c in fdb.LEASES)}\n22\t\n23\t\n24\t@pytest.fixture(autouse=True)\n25\tdef no_real_processes_or_network(monkeypatch):\n26\t    def forbid(*_args, **_kwargs):\n27\t        raise AssertionError('real process/network forbidden')\n28\t    for module, names in ((subprocess, ('Popen', 'run')), (os, ('system', 'fork', 'execv', 'execve')),\n29\t                          (socket, ('socket', 'create_connection'))):\n30\t        for name in names:\n31\t            monkeypatch.setattr(module, name, forbid)\n32\t\n33\t\n34\tclass FakePg:\n35\t    \"\"\"Synthetic database state; DDL is modelled as catalog rows derived from the ledger.\"\"\"\n36\t\n37\t    def __init__(self, ledger):\n38\t        self.system, self.oid, self.name = '7300000000000000001', 16384, 'postgres'\n39\t        self.read_only, self.visible = 'on', True\n40\t        self.rls_applies, self.row_security = False, 'on'\n41\t        self.ledger = list(ledger)\n42\t        self.extra_ddl = []\n43\t        self.invalid, self.indexes, self.builds = [], ['base_idx'], 0\n44\t        self.writers, self.leases = 0, {t: 0 for t, _ in fdb.LEASES}\n45\t        self.missing_relations = set()\n46\t        self.executed, self.connections, self.closed = [], 0, 0\n47\t        self.fail_on = None\n48\t        self.on_connect = None\n49\t\n50\t    def catalog_rows(self, ledger=None):\n51\t        names = sorted(self.ledger if ledger is None else ledger)\n52\t        return [[index, 'rel_' + name[:20], 'r', 1, 'id', 23, True] for index, name in enumerate(names)] + [\n53\t            [9000 + i, name, 'r', 1, 'id', 23, True] for i, name in enumerate(self.extra_ddl)]\n54\t\n55\t    def catalog(self, ledger=None):\n56\t        return digest(self.catalog_rows(ledger))\n57\t\n58\t    def identity(self):\n59\t        return digest([self.system, self.oid, self.name])\n60\t\n61\t    def expectation(self, ledger=None):\n62\t        ledger = tuple(sorted(self.ledger if ledger is None else ledger))\n63\t        return DatabaseExpectation(self.identity(), ledger, self.catalog(ledger))\n64\t\n65\t    def connect(self, *, timeout):\n66\t        assert 0 < timeout <= 30\n67\t        self.connections += 1\n68\t        if self.on_connect:\n69\t            self.on_connect()\n70\t        if self.fail_on == 'connect':\n71\t            raise OSError('could not connect: password=' + SECRET)\n72\t        return FakeConnection(self)\n73\t\n74\t\n75\tclass FakeConnection:\n76\t    def __init__(self, pg):\n77\t        self.pg, self.autocommit = pg, False\n78\t\n79\t    def cursor(self):\n80\t        return FakeCursor(self.pg)\n81\t\n82\t    def close(self):\n83\t        self.pg.closed += 1\n84\t\n85\t\n86\tclass FakeCursor:\n87\t    def __init__(self, pg):\n88\t        self.pg, self.rows = pg, None\n89\t\n90\t    def execute(self, query, params=None):\n91\t        pg = self.pg\n92\t        assert query in STATEMENTS, query\n93\t        pg.executed.append((query, params))\n94\t        if pg.fail_on == query:\n95\t            raise RuntimeError('server error near ' + SECRET)\n96\t        if query == RLS_OFF:\n97\t            pg.row_security = 'off'\n98\t            self.rows = [('off',)]\n99\t            return\n100\t        lease = {fdb.lease_query(t, c): t for t, c in fdb.LEASES}\n101\t        answers = {\n102\t            fdb.Q_TIMEOUT: lambda: [(params[0],)], fdb.Q_PATH: lambda: [('pg_catalog,public',)],\n103\t            fdb.Q_READ_ONLY: lambda: [(pg.read_only,)], fdb.Q_IDENTITY: lambda: [(pg.system, pg.oid, pg.name)],\n104\t            fdb.Q_VISIBILITY: lambda: [(pg.visible,)], fdb.Q_LEDGER: lambda: [(n,) for n in sorted(pg.ledger)],\n105\t            fdb.Q_INVALID: lambda: [(n,) for n in pg.invalid], fdb.Q_INDEXES: lambda: [(n,) for n in pg.indexes],\n106\t            fdb.Q_BUILDS: lambda: [(pg.builds,)], fdb.Q_CATALOG: lambda: [tuple(r) for r in pg.catalog_rows()],\n107\t            fdb.Q_WRITERS: lambda: [(pg.writers,)],\n108\t            fdb.Q_RELATION: lambda: [(params[0].removeprefix('public.') not in pg.missing_relations,)],\n109\t        }\n110\t        if query in lease:\n111\t            if pg.rls_applies and pg.row_security != 'off':\n112\t                self.rows = [(0,)]  # a filtered empty view must not prove absence\n113\t            else:\n114\t                self.rows = [(pg.leases[lease[query]],)]\n115\t        else:\n116\t            self.rows = answers.get(query, lambda: None)()\n117\t\n118\t    def fetchall(self):\n119\t        return self.rows\n120\t\n121\t\n122\tLEDGER = ['0001_base.sql', '0002_more.sql']\n123\t\n124\t\n125\tdef make():\n126\t    pg = FakePg(LEDGER)\n127\t    return pg, ReadOnlyDatabase(pg.connect)\n128\t\n129\t\n130\tdef test_observation_is_read_only_aggregate_and_always_rolled_back_and_closed():\n131\t    pg, database = make()\n132\t    observation = database.observe(timeout=5)\n133\t    assert observation['ledger'] == tuple(LEDGER) and observation['identity'] == pg.identity()\n134\t    assert observation['catalog'] == pg.catalog() and observation['writing_sessions'] == 0\n135\t    assert baseline_digest(observation) == pg.expectation().baseline_digest\n136\t    queries = [q for q, _ in pg.executed]\n137\t    assert queries[0] == fdb.Q_BEGIN and queries[-1] == 'ROLLBACK' and pg.closed == 1\n138\t    assert ('5000ms',) in [p for q, p in pg.executed if q == fdb.Q_TIMEOUT]\n139\t    text = ' '.join(queries).lower()\n140\t    for forbidden in ('insert ', 'update ', 'delete ', 'create ', 'alter ', 'drop ', 'truncate', ' query',\n141\t                      'client_addr', 'usename', 'select *'):\n142\t        assert forbidden not in text\n143\t    # Writers exclude only the observer's own PID: no application name is passed or exempted.\n144\t    assert [p for q, p in pg.executed if q == fdb.Q_WRITERS] == [None]\n145\t\n146\t\n147\tdef test_writer_and_visibility_predicates_cannot_be_bypassed_by_names():\n148\t    writers = fdb.Q_WRITERS\n149\t    assert 'application_name' not in writers and '%s' not in writers\n150\t    assert \"pid<>pg_backend_pid()\" in writers and \"state IS DISTINCT FROM 'idle'\" in writers\n151\t    assert 'backend_xid IS NOT NULL OR' in writers and 'AND NOT' not in writers\n152\t    assert \"'pg_read_all_stats', 'USAGE')\" in fdb.Q_VISIBILITY and 'MEMBER' not in fdb.Q_VISIBILITY\n153\t    # A configured observer name is still validated, yet changes neither the SQL nor its parameters.\n154\t    pg = FakePg(LEDGER)\n155\t    pg.writers = 1  # e.g. an active session labelled with an observer name, no xid yet\n156\t    observation = ReadOnlyDatabase(pg.connect, observer_applications=('ops-observer',)).observe(timeout=5)\n157\t    assert observation['writing_sessions'] == 1\n158\t    assert [p for q, p in pg.executed if q == fdb.Q_WRITERS] == [None]\n159\t    with pytest.raises(Refused, match='^database-writing-session$'):\n160\t        require_quiet(observation)\n161\t\n162\t\n163\t@pytest.mark.parametrize('change, code', [\n164\t    (lambda pg: setattr(pg, 'read_only', 'off'), 'database-not-read-only'),\n165\t    (lambda pg: setattr(pg, 'visible', False), 'database-activity-not-visible'),\n166\t    (lambda pg: pg.missing_relations.add('notification_outbox'), 'database-lease-relation'),\n167\t    (lambda pg: setattr(pg, 'fail_on', fdb.Q_LEDGER), 'database-observation-failed'),\n168\t    (lambda pg: setattr(pg, 'fail_on', 'connect'), 'database-observation-failed'),\n169\t    (lambda pg: setattr(pg, 'builds', -1), 'database-observation-shape'),\n170\t    (lambda pg: pg.ledger.append('bad name'), 'database-ledger-shape'),\n171\t])\n172\tdef test_observation_failures_are_fixed_codes_without_secret(change, code):\n173\t    pg, database = make()\n174\t    change(pg)\n175\t    with pytest.raises(Refused, match='^' + code + '$') as raised:\n176\t        database.observe(timeout=5)\n177\t    assert SECRET not in repr(raised.value) and raised.value.__cause__ is None\n178\t    assert pg.closed == pg.connections - (pg.fail_on == 'connect')\n179\t\n180\t\n181\t@pytest.mark.parametrize('change, code', [\n182\t    (lambda pg: pg.ledger.append('0003_new.sql'), 'database-ledger-drift'),\n183\t    (lambda pg: pg.extra_ddl.append('rogue_table'), 'database-ddl-drift'),\n184\t    (lambda pg: setattr(pg, 'system', '7300000000000000002'), 'database-identity-mismatch'),\n185\t    (lambda pg: setattr(pg, 'name', 'other_db'), 'database-identity-mismatch'),\n186\t    (lambda pg: pg.invalid.append('half_built_idx'), 'database-ddl-in-progress'),\n187\t    (lambda pg: setattr(pg, 'builds', 1), 'database-ddl-in-progress'),\n188\t])\n189\tdef test_ledger_proof_rejects_any_ddl_or_ledger_drift(change, code):\n190\t    pg, database = make()\n191\t    proof = LedgerProof(database, pg.expectation(), scope=SCOPE)\n192\t    assert proof.prove(SCOPE, timeout=5)['ddl_free'] is True\n193\t    change(pg)\n194\t    with pytest.raises(Refused, match='^' + code + '$'):\n195\t        proof.prove(SCOPE, timeout=5)\n196\t\n197\t\n198\t@pytest.mark.parametrize('field, value, code', [\n199\t    ('identity', '0' * 64, 'database-identity-mismatch'), ('read_only', False, 'database-not-read-only'),\n200\t    ('activity_visible', None, 'database-not-read-only'),\n201\t])\n202\tdef test_same_database_requires_identity_read_only_and_visible_activity(field, value, code):\n203\t    pg, database = make()\n204\t    observation = database.observe(timeout=5)\n205\t    fdb.require_same_database(observation, pg.expectation())\n206\t    with pytest.raises(Refused, match='^' + code + '$'):\n207\t        fdb.require_same_database({**observation, field: value}, pg.expectation())\n208\t\n209\t\n210\tdef test_ledger_proof_is_fresh_per_call_and_scope_bound():\n211\t    pg, database = make()\n212\t    proof = LedgerProof(database, pg.expectation(), scope=SCOPE)\n213\t    for _ in range(3):\n214\t        proof.prove(SCOPE, timeout=5)\n215\t    assert pg.connections == 3\n216\t    with pytest.raises(Refused, match='^database-proof-scope$'):\n217\t        proof.prove('d' * 64, timeout=5)\n218\t    assert pg.connections == 3\n219\t    with pytest.raises(Refused, match='^database-proof-source$'):\n220\t        LedgerProof(object(), pg.expectation(), scope=SCOPE)\n221\t    with pytest.raises(Refused, match='^database-expectation$'):\n222\t        LedgerProof(database, DatabaseExpectation('x', (), 'y'), scope=SCOPE)\n223\t\n224\t\n225\t@pytest.mark.parametrize('field, value, code', [\n226\t    ('writers', 1, 'database-writing-session'),\n227\t    ('leases', {'notification_outbox': 2}, 'database-active-lease'),\n228\t])\n229\tdef test_quiet_requires_zero_writers_and_zero_leases(field, value, code):\n230\t    pg, database = make()\n231\t    require_quiet(database.observe(timeout=5))\n232\t    if field == 'leases':\n233\t        pg.leases.update(value)\n234\t    else:\n235\t        setattr(pg, field, value)\n236\t    observation = database.observe(timeout=5)\n237\t    require_ddl_free(observation, pg.expectation())  # quiet is a separate requirement\n238\t    with pytest.raises(Refused, match='^' + code + '$'):\n239\t        require_quiet(observation)\n240\t\n241\t\n242\t@pytest.mark.parametrize('kwargs', [\n243\t    dict(lease_columns=(('bad-name', 'x'),)), dict(lease_columns=()), dict(observer_applications=('a b',)),\n244\t    dict(lease_columns=(('t', 'c'), ('t', 'c'))),\n245\t])\n246\tdef test_configuration_is_validated_before_any_connection(kwargs):\n247\t    pg = FakePg(LEDGER)\n248\t    with pytest.raises(Refused, match='^database-'):\n249\t        ReadOnlyDatabase(pg.connect, **kwargs)\n250\t    with pytest.raises(Refused, match='^database-connect-missing$'):\n251\t        ReadOnlyDatabase(None)\n252\t    assert pg.connections == 0\n253\t\n254\t\n255\tdef test_psycopg2_connector_needs_a_secret_provider_and_is_inert():\n256\t    with pytest.raises(Refused, match='^database-connect-missing$'):\n257\t        fdb.psycopg2_connector(None)\n258\t    calls = []\n259\t    connect = fdb.psycopg2_connector(lambda: calls.append(1) or 'postgresql://x')\n260\t    assert callable(connect) and calls == []\n261\t\n262\t\n263\tdef test_rls_filtered_empty_lease_count_cannot_prove_quiet():\n264\t    pg, database = make()\n265\t    pg.rls_applies = True\n266\t    pg.leases['notification_outbox'] = 1\n267\t    observation = database.observe()\n268\t    assert observation['active_leases'] == 1\n269\t    with pytest.raises(Refused, match='^database-active-lease$'):\n270\t        require_quiet(observation)\n271\t\n272\t\n273\tdef test_row_security_refusal_stops_observation_and_closes_connection():\n274\t    pg, database = make()\n275\t    pg.fail_on = RLS_OFF\n276\t    with pytest.raises(Refused, match='^database-observation-failed$'):\n277\t        database.observe()\n278\t    assert pg.closed == 1\n279\t    assert all(q != fdb.Q_WRITERS for q, _ in pg.executed)\n280\t"}]},"parent_tool_use_id":null,"session_id":"05249313-2279-499a-9431-55b58a17e539","uuid":"05e4e4fc-9368-4014-b983-b4cc9f183a40","timestamp":"2026-10-30T15:46:46.915Z","tool_use_result":{"type":"text","file":{"filePath":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/tests/test_first_transition_database.py","content":"\"\"\"Read-only database observer/ledger proof over a fake DB-API connection; no PostgreSQL is used.\"\"\"\nimport os\nfrom pathlib import Path\nimport socket\nimport subprocess\nimport sys\n\nimport pytest\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\nimport first_transition_database as fdb\nfrom first_transition_adapter import Refused, baseline_digest, digest\nfrom first_transition_database import (DatabaseExpectation, LedgerProof, ReadOnlyDatabase, require_ddl_free,\n                                       require_quiet)\n\nRLS_OFF = \"SELECT set_config('row_security', 'off', true)\"\nSCOPE = 'c' * 64\nSECRET = 'SENTINEL-DB-SECRET'\nSTATEMENTS = {RLS_OFF, fdb.Q_BEGIN, fdb.Q_TIMEOUT, fdb.Q_PATH, fdb.Q_READ_ONLY, fdb.Q_IDENTITY, fdb.Q_VISIBILITY,\n              fdb.Q_LEDGER, fdb.Q_INVALID, fdb.Q_INDEXES, fdb.Q_BUILDS, fdb.Q_CATALOG, fdb.Q_WRITERS,\n              fdb.Q_RELATION, 'ROLLBACK', *(fdb.lease_query(t, c) for t, c in fdb.LEASES)}\n\n\n@pytest.fixture(autouse=True)\ndef no_real_processes_or_network(monkeypatch):\n    def forbid(*_args, **_kwargs):\n        raise AssertionError('real process/network forbidden')\n    for module, names in ((subprocess, ('Popen', 'run')), (os, ('system', 'fork', 'execv', 'execve')),\n                          (socket, ('socket', 'create_connection'))):\n        for name in names:\n            monkeypatch.setattr(module, name, forbid)\n\n\nclass FakePg:\n    \"\"\"Synthetic database state; DDL is modelled as catalog rows derived from the ledger.\"\"\"\n\n    def __init__(self, ledger):\n        self.system, self.oid, self.name = '7300000000000000001', 16384, 'postgres'\n        self.read_only, self.visible = 'on', True\n        self.rls_applies, self.row_security = False, 'on'\n        self.ledger = list(ledger)\n        self.extra_ddl = []\n        self.invalid, self.indexes, self.builds = [], ['base_idx'], 0\n        self.writers, self.leases = 0, {t: 0 for t, _ in fdb.LEASES}\n        self.missing_relations = set()\n        self.executed, self.connections, self.closed = [], 0, 0\n        self.fail_on = None\n        self.on_connect = None\n\n    def catalog_rows(self, ledger=None):\n        names = sorted(self.ledger if ledger is None else ledger)\n        return [[index, 'rel_' + name[:20], 'r', 1, 'id', 23, True] for index, name in enumerate(names)] + [\n            [9000 + i, name, 'r', 1, 'id', 23, True] for i, name in enumerate(self.extra_ddl)]\n\n    def catalog(self, ledger=None):\n        return digest(self.catalog_rows(ledger))\n\n    def identity(self):\n        return digest([self.system, self.oid, self.name])\n\n    def expectation(self, ledger=None):\n        ledger = tuple(sorted(self.ledger if ledger is None else ledger))\n        return DatabaseExpectation(self.identity(), ledger, self.catalog(ledger))\n\n    def connect(self, *, timeout):\n        assert 0 < timeout <= 30\n        self.connections += 1\n        if self.on_connect:\n            self.on_connect()\n        if self.fail_on == 'connect':\n            raise OSError('could not connect: password=' + SECRET)\n        return FakeConnection(self)\n\n\nclass FakeConnection:\n    def __init__(self, pg):\n        self.pg, self.autocommit = pg, False\n\n    def cursor(self):\n        return FakeCursor(self.pg)\n\n    def close(self):\n        self.pg.closed += 1\n\n\nclass FakeCursor:\n    def __init__(self, pg):\n        self.pg, self.rows = pg, None\n\n    def execute(self, query, params=None):\n        pg = self.pg\n        assert query in STATEMENTS, query\n        pg.executed.append((query, params))\n        if pg.fail_on == query:\n            raise RuntimeError('server error near ' + SECRET)\n        if query == RLS_OFF:\n            pg.row_security = 'off'\n            self.rows = [('off',)]\n            return\n        lease = {fdb.lease_query(t, c): t for t, c in fdb.LEASES}\n        answers = {\n            fdb.Q_TIMEOUT: lambda: [(params[0],)], fdb.Q_PATH: lambda: [('pg_catalog,public',)],\n            fdb.Q_READ_ONLY: lambda: [(pg.read_only,)], fdb.Q_IDENTITY: lambda: [(pg.system, pg.oid, pg.name)],\n            fdb.Q_VISIBILITY: lambda: [(pg.visible,)], fdb.Q_LEDGER: lambda: [(n,) for n in sorted(pg.ledger)],\n            fdb.Q_INVALID: lambda: [(n,) for n in pg.invalid], fdb.Q_INDEXES: lambda: [(n,) for n in pg.indexes],\n            fdb.Q_BUILDS: lambda: [(pg.builds,)], fdb.Q_CATALOG: lambda: [tuple(r) for r in pg.catalog_rows()],\n            fdb.Q_WRITERS: lambda: [(pg.writers,)],\n            fdb.Q_RELATION: lambda: [(params[0].removeprefix('public.') not in pg.missing_relations,)],\n        }\n        if query in lease:\n            if pg.rls_applies and pg.row_security != 'off':\n                self.rows = [(0,)]  # a filtered empty view must not prove absence\n            else:\n                self.rows = [(pg.leases[lease[query]],)]\n        else:\n            self.rows = answers.get(query, lambda: None)()\n\n    def fetchall(self):\n        return self.rows\n\n\nLEDGER = ['0001_base.sql', '0002_more.sql']\n\n\ndef make():\n    pg = FakePg(LEDGER)\n    return pg, ReadOnlyDatabase(pg.connect)\n\n\ndef test_observation_is_read_only_aggregate_and_always_rolled_back_and_closed():\n    pg, database = make()\n    observation = database.observe(timeout=5)\n    assert observation['ledger'] == tuple(LEDGER) and observation['identity'] == pg.identity()\n    assert observation['catalog'] == pg.catalog() and observation['writing_sessions'] == 0\n    assert baseline_digest(observation) == pg.expectation().baseline_digest\n    queries = [q for q, _ in pg.executed]\n    assert queries[0] == fdb.Q_BEGIN and queries[-1] == 'ROLLBACK' and pg.closed == 1\n    assert ('5000ms',) in [p for q, p in pg.executed if q == fdb.Q_TIMEOUT]\n    text = ' '.join(queries).lower()\n    for forbidden in ('insert ', 'update ', 'delete ', 'create ', 'alter ', 'drop ', 'truncate', ' query',\n                      'client_addr', 'usename', 'select *'):\n        assert forbidden not in text\n    # Writers exclude only the observer's own PID: no application name is passed or exempted.\n    assert [p for q, p in pg.executed if q == fdb.Q_WRITERS] == [None]\n\n\ndef test_writer_and_visibility_predicates_cannot_be_bypassed_by_names():\n    writers = fdb.Q_WRITERS\n    assert 'application_name' not in writers and '%s' not in writers\n    assert \"pid<>pg_backend_pid()\" in writers and \"state IS DISTINCT FROM 'idle'\" in writers\n    assert 'backend_xid IS NOT NULL OR' in writers and 'AND NOT' not in writers\n    assert \"'pg_read_all_stats', 'USAGE')\" in fdb.Q_VISIBILITY and 'MEMBER' not in fdb.Q_VISIBILITY\n    # A configured observer name is still validated, yet changes neither the SQL nor its parameters.\n    pg = FakePg(LEDGER)\n    pg.writers = 1  # e.g. an active session labelled with an observer name, no xid yet\n    observation = ReadOnlyDatabase(pg.connect, observer_applications=('ops-observer',)).observe(timeout=5)\n    assert observation['writing_sessions'] == 1\n    assert [p for q, p in pg.executed if q == fdb.Q_WRITERS] == [None]\n    with pytest.raises(Refused, match='^database-writing-session$'):\n        require_quiet(observation)\n\n\n@pytest.mark.parametrize('change, code', [\n    (lambda pg: setattr(pg, 'read_only', 'off'), 'database-not-read-only'),\n    (lambda pg: setattr(pg, 'visible', False), 'database-activity-not-visible'),\n    (lambda pg: pg.missing_relations.add('notification_outbox'), 'database-lease-relation'),\n    (lambda pg: setattr(pg, 'fail_on', fdb.Q_LEDGER), 'database-observation-failed'),\n    (lambda pg: setattr(pg, 'fail_on', 'connect'), 'database-observation-failed'),\n    (lambda pg: setattr(pg, 'builds', -1), 'database-observation-shape'),\n    (lambda pg: pg.ledger.append('bad name'), 'database-ledger-shape'),\n])\ndef test_observation_failures_are_fixed_codes_without_secret(change, code):\n    pg, database = make()\n    change(pg)\n    with pytest.raises(Refused, match='^' + code + '$') as raised:\n        database.observe(timeout=5)\n    assert SECRET not in repr(raised.value) and raised.value.__cause__ is None\n    assert pg.closed == pg.connections - (pg.fail_on == 'connect')\n\n\n@pytest.mark.parametrize('change, code', [\n    (lambda pg: pg.ledger.append('0003_new.sql'), 'database-ledger-drift'),\n    (lambda pg: pg.extra_ddl.append('rogue_table'), 'database-ddl-drift'),\n    (lambda pg: setattr(pg, 'system', '7300000000000000002'), 'database-identity-mismatch'),\n    (lambda pg: setattr(pg, 'name', 'other_db'), 'database-identity-mismatch'),\n    (lambda pg: pg.invalid.append('half_built_idx'), 'database-ddl-in-progress'),\n    (lambda pg: setattr(pg, 'builds', 1), 'database-ddl-in-progress'),\n])\ndef test_ledger_proof_rejects_any_ddl_or_ledger_drift(change, code):\n    pg, database = make()\n    proof = LedgerProof(database, pg.expectation(), scope=SCOPE)\n    assert proof.prove(SCOPE, timeout=5)['ddl_free'] is True\n    change(pg)\n    with pytest.raises(Refused, match='^' + code + '$'):\n        proof.prove(SCOPE, timeout=5)\n\n\n@pytest.mark.parametrize('field, value, code', [\n    ('identity', '0' * 64, 'database-identity-mismatch'), ('read_only', False, 'database-not-read-only'),\n    ('activity_visible', None, 'database-not-read-only'),\n])\ndef test_same_database_requires_identity_read_only_and_visible_activity(field, value, code):\n    pg, database = make()\n    observation = database.observe(timeout=5)\n    fdb.require_same_database(observation, pg.expectation())\n    with pytest.raises(Refused, match='^' + code + '$'):\n        fdb.require_same_database({**observation, field: value}, pg.expectation())\n\n\ndef test_ledger_proof_is_fresh_per_call_and_scope_bound():\n    pg, database = make()\n    proof = LedgerProof(database, pg.expectation(), scope=SCOPE)\n    for _ in range(3):\n        proof.prove(SCOPE, timeout=5)\n    assert pg.connections == 3\n    with pytest.raises(Refused, match='^database-proof-scope$'):\n        proof.prove('d' * 64, timeout=5)\n    assert pg.connections == 3\n    with pytest.raises(Refused, match='^database-proof-source$'):\n        LedgerProof(object(), pg.expectation(), scope=SCOPE)\n    with pytest.raises(Refused, match='^database-expectation$'):\n        LedgerProof(database, DatabaseExpectation('x', (), 'y'), scope=SCOPE)\n\n\n@pytest.mark.parametrize('field, value, code', [\n    ('writers', 1, 'database-writing-session'),\n    ('leases', {'notification_outbox': 2}, 'database-active-lease'),\n])\ndef test_quiet_requires_zero_writers_and_zero_leases(field, value, code):\n    pg, database = make()\n    require_quiet(database.observe(timeout=5))\n    if field == 'leases':\n        pg.leases.update(value)\n    else:\n        setattr(pg, field, value)\n    observation = database.observe(timeout=5)\n    require_ddl_free(observation, pg.expectation())  # quiet is a separate requirement\n    with pytest.raises(Refused, match='^' + code + '$'):\n        require_quiet(observation)\n\n\n@pytest.mark.parametrize('kwargs', [\n    dict(lease_columns=(('bad-name', 'x'),)), dict(lease_columns=()), dict(observer_applications=('a b',)),\n    dict(lease_columns=(('t', 'c'), ('t', 'c'))),\n])\ndef test_configuration_is_validated_before_any_connection(kwargs):\n    pg = FakePg(LEDGER)\n    with pytest.raises(Refused, match='^database-'):\n        ReadOnlyDatabase(pg.connect, **kwargs)\n    with pytest.raises(Refused, match='^database-connect-missing$'):\n        ReadOnlyDatabase(None)\n    assert pg.connections == 0\n\n\ndef test_psycopg2_connector_needs_a_secret_provider_and_is_inert():\n    with pytest.raises(Refused, match='^database-connect-missing$'):\n        fdb.psycopg2_connector(None)\n    calls = []\n    connect = fdb.psycopg2_connector(lambda: calls.append(1) or 'postgresql://x')\n    assert callable(connect) and calls == []\n\n\ndef test_rls_filtered_empty_lease_count_cannot_prove_quiet():\n    pg, database = make()\n    pg.rls_applies = True\n    pg.leases['notification_outbox'] = 1\n    observation = database.observe()\n    assert observation['active_leases'] == 1\n    with pytest.raises(Refused, match='^database-active-lease$'):\n        require_quiet(observation)\n\n\ndef test_row_security_refusal_stops_observation_and_closes_connection():\n    pg, database = make()\n    pg.fail_on = RLS_OFF\n    with pytest.raises(Refused, match='^database-observation-failed$'):\n        database.observe()\n    assert pg.closed == 1\n    assert all(q != fdb.Q_WRITERS for q, _ in pg.executed)\n","numLines":280,"startLine":1,"totalLines":280}},"tool_result_meta":[{"id":"toolu_017Bq9oyYXrCqUrSx7e1Bro9","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
