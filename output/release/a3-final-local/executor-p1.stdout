{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgYgRmzcbNpwSdZVwYsJm","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01L32QamGxenzzwETRtVG2wi","name":"Read","input":{"file_path":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_host_driver.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":18334,"cache_read_input_tokens":28729,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18334},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"05249313-2279-499a-9431-55b58a17e539","uuid":"78e51ee6-4274-4313-8f31-88ed739aa421","timestamp":"2026-10-30T15:45:24.085Z","request_id":"req_011CgYgRmaJbGeDyJzkzhQgJ","wire_tool_inputs":{"toolu_01L32QamGxenzzwETRtVG2wi":{"file_path":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_host_driver.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M6e5GNnJgHRZiJDH6iZaKR","type":"tool_result","content":"1\t\"\"\"Containment contracts over caller-supplied host ports.\n2\t\n3\tLocalHostContract proves the orchestration against a simulator only.\n4\tObservedHostContract is a contract over a caller-supplied driver: every field\n5\t(ingress, unknown writers, queue counts, health, digests) is driver-reported,\n6\tnever independent host evidence, so receipts carry host_verified=False. Queue\n7\tcounts cannot prove contents or quiescence. It may resume the pinned legacy\n8\tonly while no DDL marker is journaled; marker absence is no proof that DDL did\n9\tnot run elsewhere. The resume token binds the host identity, not a human\n10\tapproval. Partial containment or an abnormal exit is refused fail-closed; there\n11\tis no automatic recovery. Checks run immediately before each effect and again\n12\tafter it, without any atomicity over the driver or host; each resume effect is\n13\talso judged, without new IO, on the port's own final snapshot via a guard. Its\n14\tjournal is never shared with the local adapter (adapter-*/local-host-*). No SSH, Docker client,\n15\tgate setter, real executor or deploy operation is provided here.\n16\t\"\"\"\n17\tfrom __future__ import annotations\n18\t\n19\timport re\n20\t\n21\tfrom first_transition_adapter import ROLES, digest\n22\tfrom initial_transition_ops import Refused, require\n23\t\n24\tFIELDS = frozenset({'id', 'image', 'revision', 'compose_project', 'compose_service',\n25\t                    'started', 'restart_count', 'restart_policy', 'running', 'exit_code',\n26\t                    'gates_digest', 'mounts_digest', 'networks_digest'})\n27\tDYNAMIC = frozenset({'restart_policy', 'running', 'exit_code'})\n28\tHEX = re.compile('[0-9a-f]{64}')\n29\tRESUMABLE = frozenset({'started', 'restart_count'})\n30\tSTART_ORDER = ('backend', 'queue-worker', 'broadcast-worker', 'cron-worker')\n31\t\n32\t\n33\tclass LocalHostContract:\n34\t    def __init__(self, port, journal):\n35\t        self.port, self.j = port, journal\n36\t\n37\t    def _call(self, operation, *args):\n38\t        try:\n39\t            return getattr(self.port, operation)(*args)\n40\t        except TimeoutError:\n41\t            raise Refused('local-host-timeout') from None\n42\t        except Exception:\n43\t            raise Refused('local-host-effect-failed') from None\n44\t\n45\t    def _snapshot(self):\n46\t        data = self._call('snapshot')\n47\t        require(isinstance(data, dict) and set(data) == {\n48\t            'mode', 'ingress_blocked', 'support_digest', 'unknown_writers', 'services'}, 'local-host-shape')\n49\t        require(data['mode'] == 'local-simulation', 'local-host-simulation-required')\n50\t        require(type(data['ingress_blocked']) is bool\n51\t                and isinstance(data['support_digest'], str) and HEX.fullmatch(data['support_digest']),\n52\t                'local-host-shape')\n53\t        require(type(data['unknown_writers']) is int and data['unknown_writers'] == 0,\n54\t                'local-host-unknown-writer')\n55\t        services = data['services']\n56\t        require(isinstance(services, dict) and set(services) == set(ROLES), 'local-host-services')\n57\t        for role, state in services.items():\n58\t            require(isinstance(state, dict) and set(state) == FIELDS, 'local-host-service-shape')\n59\t            require(isinstance(state['id'], str) and HEX.fullmatch(state['id'])\n60\t                    and isinstance(state['image'], str) and re.fullmatch(r'sha256:[0-9a-f]{64}', state['image'])\n61\t                    and (state['revision'] is None or isinstance(state['revision'], str)\n62\t                         and re.fullmatch('[0-9a-f]{40}', state['revision'])), 'local-host-identity')\n63\t            require(type(state['running']) is bool and type(state['restart_count']) is int\n64\t                    and state['restart_count'] >= 0 and state['restart_policy'] in ('always', 'no')\n65\t                    and (state['exit_code'] is None or type(state['exit_code']) is int)\n66\t                    and isinstance(state['started'], str)\n67\t                    and re.fullmatch(r'[A-Za-z0-9_.:+-]{1,64}', state['started']), 'local-host-state')\n68\t            require(all(isinstance(state[key], str) and HEX.fullmatch(state[key])\n69\t                        for key in ('gates_digest', 'mounts_digest', 'networks_digest')), 'local-host-digest')\n70\t            if role == 'broadcast-worker':\n71\t                require(state['compose_project'] is None and state['compose_service'] is None,\n72\t                        'local-host-broadcast-must-be-standalone')\n73\t            else:\n74\t                require(state['compose_service'] == role and isinstance(state['compose_project'], str)\n75\t                        and re.fullmatch('[A-Za-z0-9_-]{1,63}', state['compose_project']), 'local-host-compose')\n76\t        require(len({s['id'] for s in services.values()}) == 4, 'local-host-duplicate-identity')\n77\t        require(len({s['compose_project'] for role, s in services.items() if role != 'broadcast-worker'}) == 1,\n78\t                'local-host-compose-projects')\n79\t        fingerprint = digest([data['support_digest'], {\n80\t            role: {key: state[key] for key in sorted(FIELDS - DYNAMIC)} for role, state in services.items()}])\n81\t        baseline = self.j.last('local-host-init')\n82\t        if baseline:\n83\t            require(fingerprint == baseline['fingerprint'], 'local-host-identity-or-support-changed')\n84\t        return data, fingerprint\n85\t\n86\t    def _intent(self, step):\n87\t        if self.j.last('local-host-intent', step) is None:\n88\t            self.j.append('local-host-intent', step=step)\n89\t\n90\t    def _done(self, step):\n91\t        if self.j.last('local-host-done', step) is None:\n92\t            self.j.append('local-host-done', step=step)\n93\t\n94\t    def assert_contained(self):\n95\t        require(self.j.last('local-host-init') is not None, 'local-host-unobserved')\n96\t        data, fingerprint = self._snapshot()\n97\t        require(data['ingress_blocked'], 'local-host-ingress-open')\n98\t        for state in data['services'].values():\n99\t            require(state['restart_policy'] == 'no' and not state['running'] and state['exit_code'] == 0,\n100\t                    'local-host-not-cleanly-contained')\n101\t        return dict(mode='local-simulation', fingerprint=fingerprint, stopped_roles=ROLES,\n102\t                    host_verified=False)\n103\t\n104\t    def contain(self):\n105\t        data, fingerprint = self._snapshot()\n106\t        if self.j.last('local-host-init') is None:\n107\t            require(all(s['running'] and s['restart_policy'] == 'always' for s in data['services'].values()),\n108\t                    'local-host-baseline-state')\n109\t            self.j.append('local-host-init', fingerprint=fingerprint, mode='local-simulation')\n110\t        if self.j.last('local-host-done', 'ingress'):\n111\t            require(data['ingress_blocked'], 'local-host-ingress-reopened')\n112\t        if not data['ingress_blocked']:\n113\t            self._intent('ingress')\n114\t            self._call('block_ingress')\n115\t        require(self._snapshot()[0]['ingress_blocked'], 'local-host-ingress-open')\n116\t        self._done('ingress')\n117\t        for role in ROLES:\n118\t            state = self._snapshot()[0]['services'][role]\n119\t            step = 'restart-no:' + role\n120\t            if self.j.last('local-host-done', step):\n121\t                require(state['restart_policy'] == 'no', 'local-host-restart-reenabled')\n122\t            if state['restart_policy'] != 'no':\n123\t                self._intent(step)\n124\t                self._call('disable_restart', state['id'])\n125\t            require(self._snapshot()[0]['services'][role]['restart_policy'] == 'no',\n126\t                    'local-host-restart-not-disabled')\n127\t            self._done(step)\n128\t            state = self._snapshot()[0]['services'][role]\n129\t            step = 'term:' + role\n130\t            if self.j.last('local-host-done', step):\n131\t                require(not state['running'], 'local-host-restarted')\n132\t            if state['running']:\n133\t                # An unreceipted SIGTERM may already have been delivered. Wait;\n134\t                # do not blindly signal again or escalate to SIGKILL/restart.\n135\t                if self.j.last('local-host-intent', step) is None:\n136\t                    self._intent(step)\n137\t                    self._call('signal_term', state['id'])\n138\t                self._call('wait_stopped', state['id'], 30)\n139\t            state = self._snapshot()[0]['services'][role]\n140\t            require(not state['running'] and state['exit_code'] == 0, 'local-host-exit-not-clean')\n141\t            self._done(step)\n142\t        receipt = self.assert_contained()\n143\t        if self.j.last('local-host-contained') is None:\n144\t            self.j.append('local-host-contained', **receipt)\n145\t        return receipt\n146\t\n147\t\n148\tdef _observed_services(services):\n149\t    require(isinstance(services, dict) and set(services) == set(ROLES), 'observed-host-services')\n150\t    for role, state in services.items():\n151\t        require(isinstance(state, dict) and set(state) == FIELDS, 'observed-host-service-shape')\n152\t        require(isinstance(state['id'], str) and HEX.fullmatch(state['id'])\n153\t                and isinstance(state['image'], str) and re.fullmatch(r'sha256:[0-9a-f]{64}', state['image'])\n154\t                and (state['revision'] is None or isinstance(state['revision'], str)\n155\t                     and re.fullmatch('[0-9a-f]{40}', state['revision'])), 'observed-host-identity')\n156\t        require(type(state['running']) is bool and type(state['restart_count']) is int\n157\t                and state['restart_count'] >= 0 and state['restart_policy'] in ('always', 'no')\n158\t                and (state['exit_code'] is None or type(state['exit_code']) is int)\n159\t                and isinstance(state['started'], str)\n160\t                and re.fullmatch(r'[A-Za-z0-9_.:+-]{1,64}', state['started']), 'observed-host-state')\n161\t        require(all(isinstance(state[key], str) and HEX.fullmatch(state[key])\n162\t                    for key in ('gates_digest', 'mounts_digest', 'networks_digest')), 'observed-host-digest')\n163\t        if role == 'broadcast-worker':\n164\t            require(state['compose_project'] is None and state['compose_service'] is None,\n165\t                    'observed-host-broadcast-must-be-standalone')\n166\t        else:\n167\t            require(state['compose_service'] == role and isinstance(state['compose_project'], str)\n168\t                    and re.fullmatch('[A-Za-z0-9_-]{1,63}', state['compose_project']), 'observed-host-compose')\n169\t    require(len({s['id'] for s in services.values()}) == 4, 'observed-host-duplicate-identity')\n170\t    require(len({s['compose_project'] for role, s in services.items() if role != 'broadcast-worker'}) == 1,\n171\t            'observed-host-compose-projects')\n172\t\n173\t\n174\tclass ObservedHostContract:\n175\t    def __init__(self, port, journal):\n176\t        self.port, self.j = port, journal\n177\t\n178\t    def _call(self, operation, *args):\n179\t        try:\n180\t            return getattr(self.port, operation)(*args)\n181\t        except TimeoutError:\n182\t            raise Refused('observed-host-timeout') from None\n183\t        except Exception:\n184\t            raise Refused('observed-host-effect-failed') from None\n185\t\n186\t    def _assert_own_journal(self):\n187\t        require(not any(event['kind'].startswith(('adapter-', 'local-host-')) for event in self.j.events),\n188\t                'observed-host-journal-mixed')\n189\t\n190\t    def _snapshot(self, data=None):\n191\t        # data: a port's final snapshot handed to a pre-effect guard, validated without new IO.\n192\t        self._assert_own_journal()\n193\t        if data is None:\n194\t            data = self._call('snapshot')\n195\t        require(isinstance(data, dict) and set(data) == {\n196\t            'mode', 'scope_digest', 'ingress_blocked', 'support_digest', 'unknown_writers', 'queue_digest', 'queue_counts',\n197\t            'services'}, 'observed-host-shape')\n198\t        require(data['mode'] == 'observed-host', 'observed-host-required')\n199\t        require(isinstance(data['scope_digest'], str) and HEX.fullmatch(data['scope_digest']),\n200\t                'observed-host-scope')\n201\t        require(type(data['ingress_blocked']) is bool\n202\t                and isinstance(data['support_digest'], str) and HEX.fullmatch(data['support_digest']),\n203\t                'observed-host-shape')\n204\t        require(type(data['unknown_writers']) is int and data['unknown_writers'] == 0,\n205\t                'observed-host-unknown-writer')\n206\t        counts = data['queue_counts']\n207\t        require(isinstance(data['queue_digest'], str) and HEX.fullmatch(data['queue_digest'])\n208\t                and isinstance(counts, dict) and counts\n209\t                and all(isinstance(k, str) and type(v) is int and v >= 0 for k, v in counts.items()),\n210\t                'observed-host-queue')\n211\t        services = data['services']\n212\t        _observed_services(services)\n213\t        # started/restart_count legitimately change on resume; un-resumed roles keep\n214\t        # their baseline and resumed roles keep their receipted fresh start.\n215\t        fingerprint = digest([data['scope_digest'], data['support_digest'], {\n216\t            role: {key: state[key] for key in sorted(FIELDS - DYNAMIC - RESUMABLE)}\n217\t            for role, state in services.items()}])\n218\t        baseline = self.j.last('observed-host-init')\n219\t        if baseline:\n220\t            require(fingerprint == baseline['fingerprint'], 'observed-host-identity-or-support-changed')\n221\t            for role, state in services.items():\n222\t                step = 'legacy-resume:' + role\n223\t                if self.j.last('observed-host-intent', step) is None:\n224\t                    require(state['started'] == baseline['initial_started'][role]\n225\t                            and state['restart_count'] == baseline['initial_restarts'][role],\n226\t                            'observed-host-identity-or-support-changed')\n227\t                done = self.j.last('observed-host-done', step)\n228\t                if done:\n229\t                    require(state['running'] is True and state['restart_policy'] == 'always'\n230\t                            and state['restart_count'] == 0 and state['started'] == done['started'],\n231\t                            'observed-host-resumed-state-changed')\n232\t        return data, fingerprint\n233\t\n234\t    def _intent(self, step):\n235\t        if self.j.last('observed-host-intent', step) is None:\n236\t            self.j.append('observed-host-intent', step=step)\n237\t\n238\t    def _done(self, step):\n239\t        if self.j.last('observed-host-done', step) is None:\n240\t            self.j.append('observed-host-done', step=step)\n241\t\n242\t    def assert_contained(self):\n243\t        self._assert_own_journal()\n244\t        # Once a resume is intended the host is never containment evidence again.\n245\t        require(self.j.last('observed-host-intent', 'legacy-resume') is None, 'observed-host-resume-started')\n246\t        settled = self.j.last('observed-host-settled')\n247\t        require(self.j.last('observed-host-init') is not None and settled is not None,\n248\t                'observed-host-unobserved')\n249\t        data, fingerprint = self._contain_observe()\n250\t        require(data['ingress_blocked'] is True, 'observed-host-ingress-open')\n251\t        for state in data['services'].values():\n252\t            require(state['restart_policy'] == 'no' and not state['running'] and state['exit_code'] == 0,\n253\t                    'observed-host-not-cleanly-contained')\n254\t        require(data['queue_digest'] == settled['queue_digest'], 'observed-host-queue-drift')\n255\t        return dict(mode='observed-host', evidence='driver-reported', fingerprint=fingerprint,\n256\t                    queue_digest=settled['queue_digest'], stopped_roles=ROLES, host_verified=False,\n257\t                    quiescence_proven=False)\n258\t\n259\t    def contain(self):\n260\t        self._assert_own_journal()\n261\t        require(self.j.last('observed-host-intent', 'legacy-resume') is None, 'observed-host-resume-started')\n262\t        data, fingerprint = self._contain_observe()\n263\t        if self.j.last('observed-host-init') is None:\n264\t            require(all(s['running'] and s['restart_policy'] == 'always' for s in data['services'].values()),\n265\t                    'observed-host-baseline-state')\n266\t            self.j.append('observed-host-init', fingerprint=fingerprint, mode='observed-host',\n267\t                          scope_digest=data['scope_digest'],\n268\t                          evidence='driver-reported', host_verified=False,\n269\t                          initial_started={role: data['services'][role]['started'] for role in ROLES},\n270\t                          initial_restarts={role: data['services'][role]['restart_count'] for role in ROLES})\n271\t        if self.j.last('observed-host-done', 'ingress'):\n272\t            require(data['ingress_blocked'], 'observed-host-ingress-reopened')\n273\t        if not data['ingress_blocked']:\n274\t            self._intent('ingress')\n275\t            self._effect('block_ingress', self._contain_snapshot)\n276\t        require(self._contain_observe()[0]['ingress_blocked'] is True, 'observed-host-ingress-open')\n277\t        self._done('ingress')\n278\t        for role in ROLES:\n279\t            state = self._contain_observe()[0]['services'][role]\n280\t            step = 'restart-no:' + role\n281\t            if self.j.last('observed-host-done', step):\n282\t                require(state['restart_policy'] == 'no', 'observed-host-restart-reenabled')\n283\t            if state['restart_policy'] != 'no':\n284\t                self._intent(step)\n285\t                self._effect('disable_restart', self._contain_snapshot, state['id'])\n286\t            require(self._contain_observe()[0]['services'][role]['restart_policy'] == 'no',\n287\t                    'observed-host-restart-not-disabled')\n288\t            self._done(step)\n289\t            state = self._contain_observe()[0]['services'][role]\n290\t            step = 'term:' + role\n291\t            if self.j.last('observed-host-done', step):\n292\t                require(not state['running'], 'observed-host-restarted')\n293\t            if state['running']:\n294\t                # Never re-signal an unreceipted SIGTERM; wait or hold.\n295\t                if self.j.last('observed-host-intent', step) is None:\n296\t                    self._intent(step)\n297\t                    self._effect('signal_term', self._contain_snapshot, state['id'])\n298\t                self._call('wait_stopped', state['id'], 30)\n299\t            state = self._contain_observe()[0]['services'][role]\n300\t            require(not state['running'] and state['exit_code'] == 0, 'observed-host-exit-not-clean')\n301\t            self._done(step)\n302\t        settled_data = self._contain_observe()[0]\n303\t        if self.j.last('observed-host-settled') is None:\n304\t            self.j.append('observed-host-settled', queue_digest=settled_data['queue_digest'],\n305\t                          queue_counts=settled_data['queue_counts'], evidence='driver-reported',\n306\t                          quiescence_proven=False)\n307\t        receipt = self.assert_contained()\n308\t        if self.j.last('observed-host-contained') is None:\n309\t            self.j.append('observed-host-contained', **receipt)\n310\t        return receipt\n311\t\n312\t    def _contain_observe(self):\n313\t        data, fingerprint = self._snapshot()\n314\t        if self.j.last('observed-host-init') is not None:\n315\t            self._contain_snapshot(data)  # validate adoption/phase without another port read\n316\t        return data, fingerprint\n317\t\n318\t    def _contain_snapshot(self, data=None):\n319\t        require(self.j.last('observed-host-intent', 'legacy-resume') is None, 'observed-host-resume-started')\n320\t        data, _ = self._snapshot(data)\n321\t        if self.j.last('observed-host-done', 'ingress'):\n322\t            require(data['ingress_blocked'] is True, 'observed-host-ingress-reopened')\n323\t        for role, state in data['services'].items():\n324\t            if self.j.last('observed-host-intent', 'restart-no:' + role) is None:\n325\t                require(state['restart_policy'] == 'always', 'observed-host-unintended-policy')\n326\t            if self.j.last('observed-host-done', 'restart-no:' + role):\n327\t                require(state['restart_policy'] == 'no', 'observed-host-restart-reenabled')\n328\t            if self.j.last('observed-host-intent', 'term:' + role) is None:\n329\t                require(state['running'] is True, 'observed-host-unintended-stop')\n330\t            elif not state['running']:\n331\t                require(state['exit_code'] == 0, 'observed-host-exit-not-clean')\n332\t            if self.j.last('observed-host-done', 'term:' + role):\n333\t                require(not state['running'], 'observed-host-restarted')\n334\t        return data\n335\t\n336\t    def resume_token(self):\n337\t        init = self.j.last('observed-host-init')\n338\t        require(init is not None, 'observed-host-unobserved')\n339\t        return 'RESUME:' + init['fingerprint']\n340\t\n341\t    def _assert_pre_ddl(self):\n342\t        # Journal-only guard, re-read before each effect and after each observation.\n343\t        # It cannot see DDL performed outside this journal; that needs a DB proof.\n344\t        require(self.j.last('adapter-ddl-marker') is None and self.j.last('ddl-marker') is None,\n345\t                'post-ddl-resume-forbidden')\n346\t\n347\t    def _resume_snapshot(self, data=None):\n348\t        self._assert_pre_ddl()  # keeps priority over the mixed-journal refusal\n349\t        data, _ = self._snapshot(data)\n350\t        self._assert_pre_ddl()\n351\t        self._check_resume_roles(data)\n352\t        if self.j.last('observed-host-intent', 'open-ingress') is None:\n353\t            # Ingress stays blocked through any partial resume until its opening is intended.\n354\t            require(data['ingress_blocked'] is True, 'observed-host-ingress-open')\n355\t        return data\n356\t\n357\t    def _check_resume_roles(self, data):\n358\t        # Every role must match its phase on every observation, not just the target.\n359\t        init = self.j.last('observed-host-init')\n360\t        for role, state in data['services'].items():\n361\t            step = 'legacy-resume:' + role\n362\t            if self.j.last('observed-host-done', step) is not None:\n363\t                continue  # _snapshot already proves the receipted fresh running state.\n364\t            if self.j.last('observed-host-intent', step) is None:\n365\t                require(not state['running'], 'observed-host-resume-not-fresh')\n366\t                require(state['restart_policy'] == 'no' and state['exit_code'] == 0,\n367\t                        'observed-host-not-cleanly-contained')\n368\t            elif state['running']:\n369\t                self._check_fresh(state, role, init)\n370\t            else:\n371\t                require(state['restart_policy'] == 'no' and state['exit_code'] == 0\n372\t                        and state['started'] == init['initial_started'][role]\n373\t                        and state['restart_count'] == init['initial_restarts'][role],\n374\t                        'observed-host-resume-not-fresh')\n375\t\n376\t    def _effect(self, operation, check, *args):\n377\t        # The port must pass its own final snapshot to the guard and emit only after\n378\t        # it returns; a guard refusal keeps its contract code, a skipped guard refuses.\n379\t        outcome = []\n380\t        def guard(final):\n381\t            try:\n382\t                check(final)\n383\t            except Refused as exc:\n384\t                outcome.append(exc)\n385\t                raise\n386\t            outcome.append(True)\n387\t        try:\n388\t            self._call(operation, *args, guard)\n389\t        except Refused:\n390\t            refusals = [item for item in outcome if isinstance(item, Refused)]\n391\t            if refusals:\n392\t                raise refusals[0] from None\n393\t            raise\n394\t        require(True in outcome, 'observed-host-guard-skipped')\n395\t\n396\t    def _start_observed(self, data, init):\n397\t        # An actual start: receipted, or intended with a verifiably fresh start.\n398\t        # A running or changed role without both is inconsistent and refused.\n399\t        observed = False\n400\t        for role in ROLES:\n401\t            step = 'legacy-resume:' + role\n402\t            if self.j.last('observed-host-done', step) is not None:\n403\t                observed = True\n404\t                continue\n405\t            state = data['services'][role]\n406\t            if state['running'] or state['started'] != init['initial_started'][role]:\n407\t                require(self.j.last('observed-host-intent', step) is not None and state['running'] is True\n408\t                        and state['restart_count'] == 0 and state['started'] != init['initial_started'][role],\n409\t                        'observed-host-resume-not-fresh')\n410\t                observed = True\n411\t        return observed\n412\t\n413\t    def _check_start(self, data, role, init, settled, allow_queue_drift):\n414\t        # Only a never-started container may be started; the queue gate holds until an actual start.\n415\t        state = data['services'][role]\n416\t        require(not state['running'] and state['exit_code'] == 0 and state['started'] == init['initial_started'][role]\n417\t                and state['restart_count'] == init['initial_restarts'][role]\n418\t                and state['restart_policy'] == 'no', 'observed-host-resume-not-fresh')\n419\t        if not self._start_observed(data, init):\n420\t            self._queue_gate(data, settled, allow_queue_drift)\n421\t\n422\t    def _check_fresh(self, state, role, init):\n423\t        require(state['running'] is True and state['restart_count'] == 0\n424\t                and state['started'] != init['initial_started'][role], 'observed-host-resume-not-fresh')\n425\t        return state\n426\t\n427\t    def _queue_gate(self, data, settled, allow_queue_drift):\n428\t        # Before the first actual start the queue must match the settled baseline or\n429\t        # the drift is explicitly accepted and journaled before the effect.\n430\t        if data['queue_digest'] != settled['queue_digest']:\n431\t            require(allow_queue_drift is True, 'observed-host-queue-drift')\n432\t            accepted = self.j.last('observed-host-queue-drift-accepted')\n433\t            if accepted is None or accepted['current_digest'] != data['queue_digest']:\n434\t                self.j.append('observed-host-queue-drift-accepted', settled_digest=settled['queue_digest'],\n435\t                              current_digest=data['queue_digest'])\n436\t\n437\t    def resume_legacy(self, confirmation, expected_token=None, *, allow_queue_drift=False):\n438\t        self._assert_pre_ddl()\n439\t        self._assert_own_journal()\n440\t        require(getattr(self.port, 'supports_resume', False) is True, 'observed-host-resume-unavailable')\n441\t        require(self.j.last('observed-host-contained') is not None, 'observed-host-not-contained')\n442\t        token = self.resume_token()  # bound to this journal's observed host; not a human approval\n443\t        require(expected_token is None or expected_token == token, 'observed-host-resume-confirmation')\n444\t        if self.j.last('observed-host-intent', 'legacy-resume') is None:\n445\t            require(confirmation == token, 'observed-host-resume-confirmation')\n446\t        init = self.j.last('observed-host-init')\n447\t        settled = self.j.last('observed-host-settled')\n448\t        data = self._resume_snapshot()\n449\t        if not self._start_observed(data, init):\n450\t            for state in data['services'].values():\n451\t                require(not state['running'] and state['exit_code'] == 0 and state['restart_policy'] == 'no',\n452\t                        'observed-host-not-cleanly-contained')\n453\t            self._queue_gate(data, settled, allow_queue_drift)\n454\t        else:\n455\t            require(self.j.last('observed-host-intent', 'legacy-resume') is not None,\n456\t                    'observed-host-not-contained')\n457\t        self._intent('legacy-resume')\n458\t        for role in START_ORDER:\n459\t            step = 'legacy-resume:' + role\n460\t            if self.j.last('observed-host-done', step) is not None:\n461\t                continue  # _snapshot() keeps re-validating the receipted fresh start\n462\t            if self.j.last('observed-host-intent', step) is None:\n463\t                state = self._resume_snapshot()['services'][role]\n464\t                require(not state['running'] and state['exit_code'] == 0 and state['restart_policy'] == 'no',\n465\t                        'observed-host-not-cleanly-contained')\n466\t                self._intent(step)\n467\t            # Re-observed after the intent, immediately before the effect (first run or replay).\n468\t            data = self._resume_snapshot()\n469\t            state = data['services'][role]\n470\t            if not state['running']:\n471\t                self._check_start(data, role, init, settled, allow_queue_drift)\n472\t                # Start before restart=always: never a stopped container with restart=always.\n473\t                self._effect('start_service', lambda final, role=role: self._check_start(\n474\t                    self._resume_snapshot(final), role, init, settled, allow_queue_drift), state['id'])\n475\t            state = self._check_fresh(self._resume_snapshot()['services'][role], role, init)\n476\t            if state['restart_policy'] != 'always':\n477\t                self._effect('enable_restart', lambda final, role=role: self._check_fresh(\n478\t                    self._resume_snapshot(final)['services'][role], role, init), state['id'])\n479\t            state = self._resume_snapshot()['services'][role]\n480\t            require(state['restart_policy'] == 'always', 'observed-host-restart-not-enabled')\n481\t            self._check_fresh(state, role, init)\n482\t            self.j.append('observed-host-done', step=step, started=state['started'])\n483\t        if self.j.last('observed-host-done', 'open-ingress') is None:\n484\t            if self.j.last('observed-host-intent', 'open-ingress') is None:\n485\t                self._resume_snapshot()  # still blocked and pre-DDL right before authorizing it\n486\t                self._intent('open-ingress')\n487\t            if self._resume_snapshot()['ingress_blocked']:\n488\t                # _snapshot() re-validates every receipted fresh start on the final observation.\n489\t                self._effect('open_ingress', self._resume_snapshot)\n490\t            require(not self._resume_snapshot()['ingress_blocked'], 'observed-host-ingress-still-blocked')\n491\t            self._done('open-ingress')\n492\t        # Every call, terminal replay included, re-proves the resumed host.\n493\t        final_data = self._resume_snapshot()\n494\t        require(final_data['ingress_blocked'] is False, 'observed-host-ingress-still-blocked')\n495\t        if self.j.last('observed-host-resumed') is None:\n496\t            self.j.append('observed-host-resumed', resumed_roles=START_ORDER, evidence='driver-reported')\n497\t        return dict(mode='observed-host', status='legacy-resumed', resumed_roles=START_ORDER,\n498\t                    ingress_blocked=False, evidence='driver-reported', host_verified=False)\n499\t"}]},"parent_tool_use_id":null,"session_id":"05249313-2279-499a-9431-55b58a17e539","uuid":"a8e6cfc4-e20a-43df-84d0-a932f72490dc","timestamp":"2026-10-30T15:45:24.164Z","tool_use_result":{"type":"text","file":{"filePath":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_host_contract.py","content":"\"\"\"Containment contracts over caller-supplied host ports.\n\nLocalHostContract proves the orchestration against a simulator only.\nObservedHostContract is a contract over a caller-supplied driver: every field\n(ingress, unknown writers, queue counts, health, digests) is driver-reported,\nnever independent host evidence, so receipts carry host_verified=False. Queue\ncounts cannot prove contents or quiescence. It may resume the pinned legacy\nonly while no DDL marker is journaled; marker absence is no proof that DDL did\nnot run elsewhere. The resume token binds the host identity, not a human\napproval. Partial containment or an abnormal exit is refused fail-closed; there\nis no automatic recovery. Checks run immediately before each effect and again\nafter it, without any atomicity over the driver or host; each resume effect is\nalso judged, without new IO, on the port's own final snapshot via a guard. Its\njournal is never shared with the local adapter (adapter-*/local-host-*). No SSH, Docker client,\ngate setter, real executor or deploy operation is provided here.\n\"\"\"\nfrom __future__ import annotations\n\nimport re\n\nfrom first_transition_adapter import ROLES, digest\nfrom initial_transition_ops import Refused, require\n\nFIELDS = frozenset({'id', 'image', 'revision', 'compose_project', 'compose_service',\n                    'started', 'restart_count', 'restart_policy', 'running', 'exit_code',\n                    'gates_digest', 'mounts_digest', 'networks_digest'})\nDYNAMIC = frozenset({'restart_policy', 'running', 'exit_code'})\nHEX = re.compile('[0-9a-f]{64}')\nRESUMABLE = frozenset({'started', 'restart_count'})\nSTART_ORDER = ('backend', 'queue-worker', 'broadcast-worker', 'cron-worker')\n\n\nclass LocalHostContract:\n    def __init__(self, port, journal):\n        self.port, self.j = port, journal\n\n    def _call(self, operation, *args):\n        try:\n            return getattr(self.port, operation)(*args)\n        except TimeoutError:\n            raise Refused('local-host-timeout') from None\n        except Exception:\n            raise Refused('local-host-effect-failed') from None\n\n    def _snapshot(self):\n        data = self._call('snapshot')\n        require(isinstance(data, dict) and set(data) == {\n            'mode', 'ingress_blocked', 'support_digest', 'unknown_writers', 'services'}, 'local-host-shape')\n        require(data['mode'] == 'local-simulation', 'local-host-simulation-required')\n        require(type(data['ingress_blocked']) is bool\n                and isinstance(data['support_digest'], str) and HEX.fullmatch(data['support_digest']),\n                'local-host-shape')\n        require(type(data['unknown_writers']) is int and data['unknown_writers'] == 0,\n                'local-host-unknown-writer')\n        services = data['services']\n        require(isinstance(services, dict) and set(services) == set(ROLES), 'local-host-services')\n        for role, state in services.items():\n            require(isinstance(state, dict) and set(state) == FIELDS, 'local-host-service-shape')\n            require(isinstance(state['id'], str) and HEX.fullmatch(state['id'])\n                    and isinstance(state['image'], str) and re.fullmatch(r'sha256:[0-9a-f]{64}', state['image'])\n                    and (state['revision'] is None or isinstance(state['revision'], str)\n                         and re.fullmatch('[0-9a-f]{40}', state['revision'])), 'local-host-identity')\n            require(type(state['running']) is bool and type(state['restart_count']) is int\n                    and state['restart_count'] >= 0 and state['restart_policy'] in ('always', 'no')\n                    and (state['exit_code'] is None or type(state['exit_code']) is int)\n                    and isinstance(state['started'], str)\n                    and re.fullmatch(r'[A-Za-z0-9_.:+-]{1,64}', state['started']), 'local-host-state')\n            require(all(isinstance(state[key], str) and HEX.fullmatch(state[key])\n                        for key in ('gates_digest', 'mounts_digest', 'networks_digest')), 'local-host-digest')\n            if role == 'broadcast-worker':\n                require(state['compose_project'] is None and state['compose_service'] is None,\n                        'local-host-broadcast-must-be-standalone')\n            else:\n                require(state['compose_service'] == role and isinstance(state['compose_project'], str)\n                        and re.fullmatch('[A-Za-z0-9_-]{1,63}', state['compose_project']), 'local-host-compose')\n        require(len({s['id'] for s in services.values()}) == 4, 'local-host-duplicate-identity')\n        require(len({s['compose_project'] for role, s in services.items() if role != 'broadcast-worker'}) == 1,\n                'local-host-compose-projects')\n        fingerprint = digest([data['support_digest'], {\n            role: {key: state[key] for key in sorted(FIELDS - DYNAMIC)} for role, state in services.items()}])\n        baseline = self.j.last('local-host-init')\n        if baseline:\n            require(fingerprint == baseline['fingerprint'], 'local-host-identity-or-support-changed')\n        return data, fingerprint\n\n    def _intent(self, step):\n        if self.j.last('local-host-intent', step) is None:\n            self.j.append('local-host-intent', step=step)\n\n    def _done(self, step):\n        if self.j.last('local-host-done', step) is None:\n            self.j.append('local-host-done', step=step)\n\n    def assert_contained(self):\n        require(self.j.last('local-host-init') is not None, 'local-host-unobserved')\n        data, fingerprint = self._snapshot()\n        require(data['ingress_blocked'], 'local-host-ingress-open')\n        for state in data['services'].values():\n            require(state['restart_policy'] == 'no' and not state['running'] and state['exit_code'] == 0,\n                    'local-host-not-cleanly-contained')\n        return dict(mode='local-simulation', fingerprint=fingerprint, stopped_roles=ROLES,\n                    host_verified=False)\n\n    def contain(self):\n        data, fingerprint = self._snapshot()\n        if self.j.last('local-host-init') is None:\n            require(all(s['running'] and s['restart_policy'] == 'always' for s in data['services'].values()),\n                    'local-host-baseline-state')\n            self.j.append('local-host-init', fingerprint=fingerprint, mode='local-simulation')\n        if self.j.last('local-host-done', 'ingress'):\n            require(data['ingress_blocked'], 'local-host-ingress-reopened')\n        if not data['ingress_blocked']:\n            self._intent('ingress')\n            self._call('block_ingress')\n        require(self._snapshot()[0]['ingress_blocked'], 'local-host-ingress-open')\n        self._done('ingress')\n        for role in ROLES:\n            state = self._snapshot()[0]['services'][role]\n            step = 'restart-no:' + role\n            if self.j.last('local-host-done', step):\n                require(state['restart_policy'] == 'no', 'local-host-restart-reenabled')\n            if state['restart_policy'] != 'no':\n                self._intent(step)\n                self._call('disable_restart', state['id'])\n            require(self._snapshot()[0]['services'][role]['restart_policy'] == 'no',\n                    'local-host-restart-not-disabled')\n            self._done(step)\n            state = self._snapshot()[0]['services'][role]\n            step = 'term:' + role\n            if self.j.last('local-host-done', step):\n                require(not state['running'], 'local-host-restarted')\n            if state['running']:\n                # An unreceipted SIGTERM may already have been delivered. Wait;\n                # do not blindly signal again or escalate to SIGKILL/restart.\n                if self.j.last('local-host-intent', step) is None:\n                    self._intent(step)\n                    self._call('signal_term', state['id'])\n                self._call('wait_stopped', state['id'], 30)\n            state = self._snapshot()[0]['services'][role]\n            require(not state['running'] and state['exit_code'] == 0, 'local-host-exit-not-clean')\n            self._done(step)\n        receipt = self.assert_contained()\n        if self.j.last('local-host-contained') is None:\n            self.j.append('local-host-contained', **receipt)\n        return receipt\n\n\ndef _observed_services(services):\n    require(isinstance(services, dict) and set(services) == set(ROLES), 'observed-host-services')\n    for role, state in services.items():\n        require(isinstance(state, dict) and set(state) == FIELDS, 'observed-host-service-shape')\n        require(isinstance(state['id'], str) and HEX.fullmatch(state['id'])\n                and isinstance(state['image'], str) and re.fullmatch(r'sha256:[0-9a-f]{64}', state['image'])\n                and (state['revision'] is None or isinstance(state['revision'], str)\n                     and re.fullmatch('[0-9a-f]{40}', state['revision'])), 'observed-host-identity')\n        require(type(state['running']) is bool and type(state['restart_count']) is int\n                and state['restart_count'] >= 0 and state['restart_policy'] in ('always', 'no')\n                and (state['exit_code'] is None or type(state['exit_code']) is int)\n                and isinstance(state['started'], str)\n                and re.fullmatch(r'[A-Za-z0-9_.:+-]{1,64}', state['started']), 'observed-host-state')\n        require(all(isinstance(state[key], str) and HEX.fullmatch(state[key])\n                    for key in ('gates_digest', 'mounts_digest', 'networks_digest')), 'observed-host-digest')\n        if role == 'broadcast-worker':\n            require(state['compose_project'] is None and state['compose_service'] is None,\n                    'observed-host-broadcast-must-be-standalone')\n        else:\n            require(state['compose_service'] == role and isinstance(state['compose_project'], str)\n                    and re.fullmatch('[A-Za-z0-9_-]{1,63}', state['compose_project']), 'observed-host-compose')\n    require(len({s['id'] for s in services.values()}) == 4, 'observed-host-duplicate-identity')\n    require(len({s['compose_project'] for role, s in services.items() if role != 'broadcast-worker'}) == 1,\n            'observed-host-compose-projects')\n\n\nclass ObservedHostContract:\n    def __init__(self, port, journal):\n        self.port, self.j = port, journal\n\n    def _call(self, operation, *args):\n        try:\n            return getattr(self.port, operation)(*args)\n        except TimeoutError:\n            raise Refused('observed-host-timeout') from None\n        except Exception:\n            raise Refused('observed-host-effect-failed') from None\n\n    def _assert_own_journal(self):\n        require(not any(event['kind'].startswith(('adapter-', 'local-host-')) for event in self.j.events),\n                'observed-host-journal-mixed')\n\n    def _snapshot(self, data=None):\n        # data: a port's final snapshot handed to a pre-effect guard, validated without new IO.\n        self._assert_own_journal()\n        if data is None:\n            data = self._call('snapshot')\n        require(isinstance(data, dict) and set(data) == {\n            'mode', 'scope_digest', 'ingress_blocked', 'support_digest', 'unknown_writers', 'queue_digest', 'queue_counts',\n            'services'}, 'observed-host-shape')\n        require(data['mode'] == 'observed-host', 'observed-host-required')\n        require(isinstance(data['scope_digest'], str) and HEX.fullmatch(data['scope_digest']),\n                'observed-host-scope')\n        require(type(data['ingress_blocked']) is bool\n                and isinstance(data['support_digest'], str) and HEX.fullmatch(data['support_digest']),\n                'observed-host-shape')\n        require(type(data['unknown_writers']) is int and data['unknown_writers'] == 0,\n                'observed-host-unknown-writer')\n        counts = data['queue_counts']\n        require(isinstance(data['queue_digest'], str) and HEX.fullmatch(data['queue_digest'])\n                and isinstance(counts, dict) and counts\n                and all(isinstance(k, str) and type(v) is int and v >= 0 for k, v in counts.items()),\n                'observed-host-queue')\n        services = data['services']\n        _observed_services(services)\n        # started/restart_count legitimately change on resume; un-resumed roles keep\n        # their baseline and resumed roles keep their receipted fresh start.\n        fingerprint = digest([data['scope_digest'], data['support_digest'], {\n            role: {key: state[key] for key in sorted(FIELDS - DYNAMIC - RESUMABLE)}\n            for role, state in services.items()}])\n        baseline = self.j.last('observed-host-init')\n        if baseline:\n            require(fingerprint == baseline['fingerprint'], 'observed-host-identity-or-support-changed')\n            for role, state in services.items():\n                step = 'legacy-resume:' + role\n                if self.j.last('observed-host-intent', step) is None:\n                    require(state['started'] == baseline['initial_started'][role]\n                            and state['restart_count'] == baseline['initial_restarts'][role],\n                            'observed-host-identity-or-support-changed')\n                done = self.j.last('observed-host-done', step)\n                if done:\n                    require(state['running'] is True and state['restart_policy'] == 'always'\n                            and state['restart_count'] == 0 and state['started'] == done['started'],\n                            'observed-host-resumed-state-changed')\n        return data, fingerprint\n\n    def _intent(self, step):\n        if self.j.last('observed-host-intent', step) is None:\n            self.j.append('observed-host-intent', step=step)\n\n    def _done(self, step):\n        if self.j.last('observed-host-done', step) is None:\n            self.j.append('observed-host-done', step=step)\n\n    def assert_contained(self):\n        self._assert_own_journal()\n        # Once a resume is intended the host is never containment evidence again.\n        require(self.j.last('observed-host-intent', 'legacy-resume') is None, 'observed-host-resume-started')\n        settled = self.j.last('observed-host-settled')\n        require(self.j.last('observed-host-init') is not None and settled is not None,\n                'observed-host-unobserved')\n        data, fingerprint = self._contain_observe()\n        require(data['ingress_blocked'] is True, 'observed-host-ingress-open')\n        for state in data['services'].values():\n            require(state['restart_policy'] == 'no' and not state['running'] and state['exit_code'] == 0,\n                    'observed-host-not-cleanly-contained')\n        require(data['queue_digest'] == settled['queue_digest'], 'observed-host-queue-drift')\n        return dict(mode='observed-host', evidence='driver-reported', fingerprint=fingerprint,\n                    queue_digest=settled['queue_digest'], stopped_roles=ROLES, host_verified=False,\n                    quiescence_proven=False)\n\n    def contain(self):\n        self._assert_own_journal()\n        require(self.j.last('observed-host-intent', 'legacy-resume') is None, 'observed-host-resume-started')\n        data, fingerprint = self._contain_observe()\n        if self.j.last('observed-host-init') is None:\n            require(all(s['running'] and s['restart_policy'] == 'always' for s in data['services'].values()),\n                    'observed-host-baseline-state')\n            self.j.append('observed-host-init', fingerprint=fingerprint, mode='observed-host',\n                          scope_digest=data['scope_digest'],\n                          evidence='driver-reported', host_verified=False,\n                          initial_started={role: data['services'][role]['started'] for role in ROLES},\n                          initial_restarts={role: data['services'][role]['restart_count'] for role in ROLES})\n        if self.j.last('observed-host-done', 'ingress'):\n            require(data['ingress_blocked'], 'observed-host-ingress-reopened')\n        if not data['ingress_blocked']:\n            self._intent('ingress')\n            self._effect('block_ingress', self._contain_snapshot)\n        require(self._contain_observe()[0]['ingress_blocked'] is True, 'observed-host-ingress-open')\n        self._done('ingress')\n        for role in ROLES:\n            state = self._contain_observe()[0]['services'][role]\n            step = 'restart-no:' + role\n            if self.j.last('observed-host-done', step):\n                require(state['restart_policy'] == 'no', 'observed-host-restart-reenabled')\n            if state['restart_policy'] != 'no':\n                self._intent(step)\n                self._effect('disable_restart', self._contain_snapshot, state['id'])\n            require(self._contain_observe()[0]['services'][role]['restart_policy'] == 'no',\n                    'observed-host-restart-not-disabled')\n            self._done(step)\n            state = self._contain_observe()[0]['services'][role]\n            step = 'term:' + role\n            if self.j.last('observed-host-done', step):\n                require(not state['running'], 'observed-host-restarted')\n            if state['running']:\n                # Never re-signal an unreceipted SIGTERM; wait or hold.\n                if self.j.last('observed-host-intent', step) is None:\n                    self._intent(step)\n                    self._effect('signal_term', self._contain_snapshot, state['id'])\n                self._call('wait_stopped', state['id'], 30)\n            state = self._contain_observe()[0]['services'][role]\n            require(not state['running'] and state['exit_code'] == 0, 'observed-host-exit-not-clean')\n            self._done(step)\n        settled_data = self._contain_observe()[0]\n        if self.j.last('observed-host-settled') is None:\n            self.j.append('observed-host-settled', queue_digest=settled_data['queue_digest'],\n                          queue_counts=settled_data['queue_counts'], evidence='driver-reported',\n                          quiescence_proven=False)\n        receipt = self.assert_contained()\n        if self.j.last('observed-host-contained') is None:\n            self.j.append('observed-host-contained', **receipt)\n        return receipt\n\n    def _contain_observe(self):\n        data, fingerprint = self._snapshot()\n        if self.j.last('observed-host-init') is not None:\n            self._contain_snapshot(data)  # validate adoption/phase without another port read\n        return data, fingerprint\n\n    def _contain_snapshot(self, data=None):\n        require(self.j.last('observed-host-intent', 'legacy-resume') is None, 'observed-host-resume-started')\n        data, _ = self._snapshot(data)\n        if self.j.last('observed-host-done', 'ingress'):\n            require(data['ingress_blocked'] is True, 'observed-host-ingress-reopened')\n        for role, state in data['services'].items():\n            if self.j.last('observed-host-intent', 'restart-no:' + role) is None:\n                require(state['restart_policy'] == 'always', 'observed-host-unintended-policy')\n            if self.j.last('observed-host-done', 'restart-no:' + role):\n                require(state['restart_policy'] == 'no', 'observed-host-restart-reenabled')\n            if self.j.last('observed-host-intent', 'term:' + role) is None:\n                require(state['running'] is True, 'observed-host-unintended-stop')\n            elif not state['running']:\n                require(state['exit_code'] == 0, 'observed-host-exit-not-clean')\n            if self.j.last('observed-host-done', 'term:' + role):\n                require(not state['running'], 'observed-host-restarted')\n        return data\n\n    def resume_token(self):\n        init = self.j.last('observed-host-init')\n        require(init is not None, 'observed-host-unobserved')\n        return 'RESUME:' + init['fingerprint']\n\n    def _assert_pre_ddl(self):\n        # Journal-only guard, re-read before each effect and after each observation.\n        # It cannot see DDL performed outside this journal; that needs a DB proof.\n        require(self.j.last('adapter-ddl-marker') is None and self.j.last('ddl-marker') is None,\n                'post-ddl-resume-forbidden')\n\n    def _resume_snapshot(self, data=None):\n        self._assert_pre_ddl()  # keeps priority over the mixed-journal refusal\n        data, _ = self._snapshot(data)\n        self._assert_pre_ddl()\n        self._check_resume_roles(data)\n        if self.j.last('observed-host-intent', 'open-ingress') is None:\n            # Ingress stays blocked through any partial resume until its opening is intended.\n            require(data['ingress_blocked'] is True, 'observed-host-ingress-open')\n        return data\n\n    def _check_resume_roles(self, data):\n        # Every role must match its phase on every observation, not just the target.\n        init = self.j.last('observed-host-init')\n        for role, state in data['services'].items():\n            step = 'legacy-resume:' + role\n            if self.j.last('observed-host-done', step) is not None:\n                continue  # _snapshot already proves the receipted fresh running state.\n            if self.j.last('observed-host-intent', step) is None:\n                require(not state['running'], 'observed-host-resume-not-fresh')\n                require(state['restart_policy'] == 'no' and state['exit_code'] == 0,\n                        'observed-host-not-cleanly-contained')\n            elif state['running']:\n                self._check_fresh(state, role, init)\n            else:\n                require(state['restart_policy'] == 'no' and state['exit_code'] == 0\n                        and state['started'] == init['initial_started'][role]\n                        and state['restart_count'] == init['initial_restarts'][role],\n                        'observed-host-resume-not-fresh')\n\n    def _effect(self, operation, check, *args):\n        # The port must pass its own final snapshot to the guard and emit only after\n        # it returns; a guard refusal keeps its contract code, a skipped guard refuses.\n        outcome = []\n        def guard(final):\n            try:\n                check(final)\n            except Refused as exc:\n                outcome.append(exc)\n                raise\n            outcome.append(True)\n        try:\n            self._call(operation, *args, guard)\n        except Refused:\n            refusals = [item for item in outcome if isinstance(item, Refused)]\n            if refusals:\n                raise refusals[0] from None\n            raise\n        require(True in outcome, 'observed-host-guard-skipped')\n\n    def _start_observed(self, data, init):\n        # An actual start: receipted, or intended with a verifiably fresh start.\n        # A running or changed role without both is inconsistent and refused.\n        observed = False\n        for role in ROLES:\n            step = 'legacy-resume:' + role\n            if self.j.last('observed-host-done', step) is not None:\n                observed = True\n                continue\n            state = data['services'][role]\n            if state['running'] or state['started'] != init['initial_started'][role]:\n                require(self.j.last('observed-host-intent', step) is not None and state['running'] is True\n                        and state['restart_count'] == 0 and state['started'] != init['initial_started'][role],\n                        'observed-host-resume-not-fresh')\n                observed = True\n        return observed\n\n    def _check_start(self, data, role, init, settled, allow_queue_drift):\n        # Only a never-started container may be started; the queue gate holds until an actual start.\n        state = data['services'][role]\n        require(not state['running'] and state['exit_code'] == 0 and state['started'] == init['initial_started'][role]\n                and state['restart_count'] == init['initial_restarts'][role]\n                and state['restart_policy'] == 'no', 'observed-host-resume-not-fresh')\n        if not self._start_observed(data, init):\n            self._queue_gate(data, settled, allow_queue_drift)\n\n    def _check_fresh(self, state, role, init):\n        require(state['running'] is True and state['restart_count'] == 0\n                and state['started'] != init['initial_started'][role], 'observed-host-resume-not-fresh')\n        return state\n\n    def _queue_gate(self, data, settled, allow_queue_drift):\n        # Before the first actual start the queue must match the settled baseline or\n        # the drift is explicitly accepted and journaled before the effect.\n        if data['queue_digest'] != settled['queue_digest']:\n            require(allow_queue_drift is True, 'observed-host-queue-drift')\n            accepted = self.j.last('observed-host-queue-drift-accepted')\n            if accepted is None or accepted['current_digest'] != data['queue_digest']:\n                self.j.append('observed-host-queue-drift-accepted', settled_digest=settled['queue_digest'],\n                              current_digest=data['queue_digest'])\n\n    def resume_legacy(self, confirmation, expected_token=None, *, allow_queue_drift=False):\n        self._assert_pre_ddl()\n        self._assert_own_journal()\n        require(getattr(self.port, 'supports_resume', False) is True, 'observed-host-resume-unavailable')\n        require(self.j.last('observed-host-contained') is not None, 'observed-host-not-contained')\n        token = self.resume_token()  # bound to this journal's observed host; not a human approval\n        require(expected_token is None or expected_token == token, 'observed-host-resume-confirmation')\n        if self.j.last('observed-host-intent', 'legacy-resume') is None:\n            require(confirmation == token, 'observed-host-resume-confirmation')\n        init = self.j.last('observed-host-init')\n        settled = self.j.last('observed-host-settled')\n        data = self._resume_snapshot()\n        if not self._start_observed(data, init):\n            for state in data['services'].values():\n                require(not state['running'] and state['exit_code'] == 0 and state['restart_policy'] == 'no',\n                        'observed-host-not-cleanly-contained')\n            self._queue_gate(data, settled, allow_queue_drift)\n        else:\n            require(self.j.last('observed-host-intent', 'legacy-resume') is not None,\n                    'observed-host-not-contained')\n        self._intent('legacy-resume')\n        for role in START_ORDER:\n            step = 'legacy-resume:' + role\n            if self.j.last('observed-host-done', step) is not None:\n                continue  # _snapshot() keeps re-validating the receipted fresh start\n            if self.j.last('observed-host-intent', step) is None:\n                state = self._resume_snapshot()['services'][role]\n                require(not state['running'] and state['exit_code'] == 0 and state['restart_policy'] == 'no',\n                        'observed-host-not-cleanly-contained')\n                self._intent(step)\n            # Re-observed after the intent, immediately before the effect (first run or replay).\n            data = self._resume_snapshot()\n            state = data['services'][role]\n            if not state['running']:\n                self._check_start(data, role, init, settled, allow_queue_drift)\n                # Start before restart=always: never a stopped container with restart=always.\n                self._effect('start_service', lambda final, role=role: self._check_start(\n                    self._resume_snapshot(final), role, init, settled, allow_queue_drift), state['id'])\n            state = self._check_fresh(self._resume_snapshot()['services'][role], role, init)\n            if state['restart_policy'] != 'always':\n                self._effect('enable_restart', lambda final, role=role: self._check_fresh(\n                    self._resume_snapshot(final)['services'][role], role, init), state['id'])\n            state = self._resume_snapshot()['services'][role]\n            require(state['restart_policy'] == 'always', 'observed-host-restart-not-enabled')\n            self._check_fresh(state, role, init)\n            self.j.append('observed-host-done', step=step, started=state['started'])\n        if self.j.last('observed-host-done', 'open-ingress') is None:\n            if self.j.last('observed-host-intent', 'open-ingress') is None:\n                self._resume_snapshot()  # still blocked and pre-DDL right before authorizing it\n                self._intent('open-ingress')\n            if self._resume_snapshot()['ingress_blocked']:\n                # _snapshot() re-validates every receipted fresh start on the final observation.\n                self._effect('open_ingress', self._resume_snapshot)\n            require(not self._resume_snapshot()['ingress_blocked'], 'observed-host-ingress-still-blocked')\n            self._done('open-ingress')\n        # Every call, terminal replay included, re-proves the resumed host.\n        final_data = self._resume_snapshot()\n        require(final_data['ingress_blocked'] is False, 'observed-host-ingress-still-blocked')\n        if self.j.last('observed-host-resumed') is None:\n            self.j.append('observed-host-resumed', resumed_roles=START_ORDER, evidence='driver-reported')\n        return dict(mode='observed-host', status='legacy-resumed', resumed_roles=START_ORDER,\n                    ingress_blocked=False, evidence='driver-reported', host_verified=False)\n","numLines":499,"startLine":1,"totalLines":499}},"tool_result_meta":[{"id":"toolu_01M6e5GNnJgHRZiJDH6iZaKR","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgYgRmzcbNpwSdZVwYsJm","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017DrvCYP11qa8zeQ5yp6jWb","name":"Read","input":{"file_path":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_host_transport.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":18334,"cache_read_input_tokens":28729,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18334},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"05249313-2279-499a-9431-55b58a17e539","uuid":"358f0e7d-028d-449c-a9c9-45c10073ffac","timestamp":"2026-10-30T15:45:24.335Z","request_id":"req_011CgYgRmaJbGeDyJzkzhQgJ","wire_tool_inputs":{"toolu_017DrvCYP11qa8zeQ5yp6jWb":{"file_path":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_host_transport.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017DrvCYP11qa8zeQ5yp6jWb","type":"tool_result","content":"1\t\"\"\"Command encoding for caller-supplied host drivers; no process or network executor.\n2\t\n3\tThe mandatory driver supplies sanitized metadata, not raw Docker inspect/env.\n4\tIngress remains a semantic operation: no guessed Nginx/Evolution command.\n5\tThe simulated transport cannot certify a real host. The observed transport only\n6\trestarts the four pinned legacy identities; it provides no deploy operation.\n7\tIt validates shape and binds identities, but every value is driver-reported:\n8\tit is no real executor, inventory or ingress implementation, and queue counts\n9\tprove neither contents nor quiescence. A reviewed real driver remains pending.\n10\tThe resume effects (start, restart=always, open-ingress) require a caller guard:\n11\tthe transport hands it its own final snapshot and emits the command only after\n12\tthe guard returns. Without a guard they refuse before any call; the bare\n13\ttransport is an unauthorized encoder, never a resume authority.\n14\t\"\"\"\n15\tfrom __future__ import annotations\n16\t\n17\tfrom copy import deepcopy\n18\timport re\n19\t\n20\tfrom first_transition_adapter import ROLES, digest, queue_metadata\n21\tfrom initial_transition_ops import Refused, require\n22\t\n23\tSUPPORT_ROLES = ('redis', 'evolution-postgres', 'evolution-api')\n24\tSUPPORT_FIELDS = frozenset({'id', 'image', 'compose_project', 'compose_service', 'running',\n25\t                            'restart_policy', 'health', 'networks_digest'})\n26\tSERVICE_FIELDS = frozenset({'id', 'image', 'revision', 'compose_project', 'compose_service', 'started',\n27\t                            'restart_count', 'restart_policy', 'running', 'exit_code', 'gates_digest',\n28\t                            'mounts_digest', 'networks_digest'})\n29\t\n30\t\n31\tdef host_command(operation, identifier):\n32\t    \"\"\"Pure encoder shared with the separately authorized disposable probe.\"\"\"\n33\t    require(isinstance(identifier, str) and re.fullmatch('[0-9a-f]{64}', identifier), 'transport-target')\n34\t    commands = {'restart-no': ('docker', 'update', '--restart=no', identifier),\n35\t                'term': ('docker', 'kill', '--signal=TERM', identifier),\n36\t                'wait': ('docker', 'wait', identifier),\n37\t                'restart-always': ('docker', 'update', '--restart=always', identifier),\n38\t                'start': ('docker', 'start', identifier)}\n39\t    require(operation in commands, 'transport-operation')\n40\t    return commands[operation]\n41\t\n42\t\n43\tclass SimulatedHostTransport:\n44\t    def __init__(self, driver):\n45\t        require(getattr(driver, 'mode', None) == 'local-simulation', 'transport-simulation-required')\n46\t        self.driver = driver\n47\t        self.identities = None\n48\t\n49\t    def _request(self, argv, timeout):\n50\t        require(getattr(self.driver, 'mode', None) == 'local-simulation', 'transport-simulation-required')\n51\t        try:\n52\t            return self.driver.request(tuple(argv), timeout=timeout)\n53\t        except TimeoutError:\n54\t            raise TimeoutError('simulated-transport-timeout') from None\n55\t        except Exception:\n56\t            raise Refused('simulated-transport-failed') from None\n57\t\n58\t    def snapshot(self):\n59\t        data = self._request(('snapshot-metadata',), 5)\n60\t        require(isinstance(data, dict) and data.get('mode') == 'local-simulation', 'transport-snapshot')\n61\t        services = data.get('services')\n62\t        require(isinstance(services, dict) and set(services) == set(ROLES), 'transport-scope')\n63\t        identities = {role: state.get('id') if isinstance(state, dict) else None\n64\t                      for role, state in services.items()}\n65\t        require(all(isinstance(value, str) and re.fullmatch('[0-9a-f]{64}', value)\n66\t                    for value in identities.values()) and len(set(identities.values())) == 4,\n67\t                'transport-identities')\n68\t        if self.identities is None:\n69\t            self.identities = identities\n70\t        require(identities == self.identities, 'transport-identity-changed')\n71\t        # Full shape/topology/gates validation remains in LocalHostContract.\n72\t        return deepcopy(data)\n73\t\n74\t    def _target(self, identifier):\n75\t        require(self.identities is not None and identifier in self.identities.values(), 'transport-target')\n76\t        self.snapshot()  # Detect replacement immediately before a simulated effect.\n77\t\n78\t    def block_ingress(self):\n79\t        require(self.identities is not None, 'transport-unobserved')\n80\t        self.snapshot()\n81\t        require(self._request(('block-ingress',), 5) is True, 'transport-ingress-receipt')\n82\t\n83\t    def disable_restart(self, identifier):\n84\t        self._target(identifier)\n85\t        require(self._request(host_command('restart-no', identifier), 5) is True,\n86\t                'transport-restart-receipt')\n87\t\n88\t    def signal_term(self, identifier):\n89\t        self._target(identifier)\n90\t        require(self._request(host_command('term', identifier), 5) is True,\n91\t                'transport-signal-receipt')\n92\t\n93\t    def wait_stopped(self, identifier, timeout):\n94\t        require(type(timeout) is int and 0 < timeout <= 30, 'transport-wait-bound')\n95\t        self._target(identifier)\n96\t        status = self._request(host_command('wait', identifier), timeout)\n97\t        require(type(status) is int and status == 0, 'transport-exit-not-clean')\n98\t\n99\t\n100\tdef _ids(value, roles):\n101\t    return (isinstance(value, dict) and set(value) == set(roles)\n102\t            and all(isinstance(v, str) and re.fullmatch('[0-9a-f]{64}', v) for v in value.values())\n103\t            and len(set(value.values())) == len(roles))\n104\t\n105\t\n106\tclass ObservedHostTransport:\n107\t    def __init__(self, driver, *, legacy_project, network_id, service_ids, support_ids, processing_keys=()):\n108\t        require(getattr(driver, 'mode', None) == 'observed-host', 'transport-observed-required')\n109\t        require(isinstance(legacy_project, str) and re.fullmatch(r'[A-Za-z0-9_-]{1,63}', legacy_project),\n110\t                'transport-project')\n111\t        require(isinstance(network_id, str) and re.fullmatch('[0-9a-f]{64}', network_id), 'transport-network')\n112\t        require(_ids(service_ids, ROLES), 'transport-identities')\n113\t        require(_ids(support_ids, SUPPORT_ROLES) and not set(support_ids.values()) & set(service_ids.values()),\n114\t                'transport-support-identities')\n115\t        self.driver, self.legacy_project, self.network_id = driver, legacy_project, network_id\n116\t        self.identities, self.support_ids = dict(service_ids), dict(support_ids)\n117\t        self.processing_keys = processing_keys  # validated by queue_metadata on every snapshot\n118\t        self.support_digest = None\n119\t        self.scope_digest = None\n120\t\n121\t    @property\n122\t    def supports_resume(self):\n123\t        return getattr(self.driver, 'supports_resume', False) is True\n124\t\n125\t    def _request(self, argv, timeout):\n126\t        require(getattr(self.driver, 'mode', None) == 'observed-host', 'transport-observed-required')\n127\t        try:\n128\t            return self.driver.request(tuple(argv), timeout=timeout)\n129\t        except TimeoutError:\n130\t            raise TimeoutError('observed-transport-timeout') from None\n131\t        except Exception:\n132\t            raise Refused('observed-transport-failed') from None\n133\t\n134\t    def snapshot(self):\n135\t        declared = getattr(self.driver, 'transport_scope', None)\n136\t        if callable(declared):\n137\t            require(declared() == dict(legacy_project=self.legacy_project, network_id=self.network_id,\n138\t                                      service_ids=self.identities, support_ids=self.support_ids,\n139\t                                      processing_keys=self.processing_keys), 'transport-driver-scope')\n140\t        raw = self._request(('inspect-host',), 10)\n141\t        require(isinstance(raw, dict) and set(raw) == {\n142\t            'scope_digest', 'ingress_blocked', 'unknown_writers', 'network_id', 'services', 'support'}, 'transport-snapshot')\n143\t        require(isinstance(raw['scope_digest'], str) and re.fullmatch('[0-9a-f]{64}', raw['scope_digest']),\n144\t                'transport-scope-digest')\n145\t        if self.scope_digest is None:\n146\t            self.scope_digest = raw['scope_digest']\n147\t        require(raw['scope_digest'] == self.scope_digest, 'transport-scope-changed')\n148\t        require(raw['network_id'] == self.network_id, 'transport-network-mismatch')\n149\t        require(type(raw['ingress_blocked']) is bool and type(raw['unknown_writers']) is int\n150\t                and raw['unknown_writers'] >= 0, 'transport-snapshot')\n151\t        support = raw['support']\n152\t        require(isinstance(support, dict) and set(support) == set(SUPPORT_ROLES), 'transport-support-scope')\n153\t        for role, state in support.items():\n154\t            require(isinstance(state, dict) and set(state) == SUPPORT_FIELDS, 'transport-support-shape')\n155\t            require(state['id'] == self.support_ids[role], 'transport-support-identity-changed')\n156\t            require(isinstance(state['image'], str) and re.fullmatch(r'sha256:[0-9a-f]{64}', state['image']),\n157\t                    'transport-support-image')\n158\t            require(state['compose_project'] == self.legacy_project and state['compose_service'] == role,\n159\t                    'transport-support-compose')\n160\t            require(state['running'] is True and state['restart_policy'] == 'always',\n161\t                    'transport-support-not-running')\n162\t            require(state['health'] == 'healthy' if role in ('redis', 'evolution-postgres')\n163\t                    else state['health'] in ('healthy', None), 'transport-support-unhealthy')\n164\t            require(isinstance(state['networks_digest'], str)\n165\t                    and re.fullmatch('[0-9a-f]{64}', state['networks_digest']), 'transport-support-network')\n166\t        support_digest = digest([self.network_id, {role: support[role] for role in sorted(SUPPORT_ROLES)}])\n167\t        if self.support_digest is None:\n168\t            self.support_digest = support_digest\n169\t        require(support_digest == self.support_digest, 'transport-support-changed')\n170\t        services = raw['services']\n171\t        require(isinstance(services, dict) and set(services) == set(ROLES), 'transport-scope')\n172\t        require(all(isinstance(services[role], dict) and set(services[role]) == SERVICE_FIELDS\n173\t                    for role in ROLES), 'transport-service-shape')\n174\t        require({role: services[role]['id'] for role in ROLES} == self.identities, 'transport-identity-changed')\n175\t        require(all(services[role].get('compose_project') == self.legacy_project\n176\t                    for role in ROLES if role != 'broadcast-worker'), 'transport-compose')\n177\t        queue = queue_metadata(lambda command, key: self._request(('redis-meta', command, key), 5),\n178\t                               processing_keys=self.processing_keys)\n179\t        # Field types/topology/gates validation remains in ObservedHostContract;\n180\t        # only the declared keys leave the transport, never extra driver data.\n181\t        return dict(mode='observed-host', scope_digest=raw['scope_digest'], ingress_blocked=raw['ingress_blocked'], support_digest=support_digest,\n182\t                    unknown_writers=raw['unknown_writers'], queue_digest=queue['metadata_digest'],\n183\t                    queue_counts=queue['counts'],\n184\t                    services=deepcopy({role: {key: services[role][key] for key in SERVICE_FIELDS}\n185\t                                       for role in ROLES}))\n186\t\n187\t    def _target(self, identifier):\n188\t        require(identifier in self.identities.values(), 'transport-target')\n189\t        self.snapshot()  # Detect replacement immediately before a host effect.\n190\t\n191\t    def _guarded(self, guard, identifier=None):\n192\t        if identifier is not None:\n193\t            require(identifier in self.identities.values(), 'transport-target')\n194\t        require(callable(guard), 'transport-guard-required')\n195\t        # This final observation, not an earlier one, is what the guard judges.\n196\t        guard(self.snapshot())\n197\t\n198\t    def block_ingress(self, guard=None):\n199\t        self._guarded(guard)\n200\t        require(self._request(('block-ingress',), 5) is True, 'transport-ingress-receipt')\n201\t\n202\t    def open_ingress(self, guard=None):\n203\t        self._guarded(guard)\n204\t        require(self._request(('open-ingress',), 5) is True, 'transport-ingress-receipt')\n205\t\n206\t    def disable_restart(self, identifier, guard=None):\n207\t        self._guarded(guard, identifier)\n208\t        require(self._request(host_command('restart-no', identifier), 5) is True,\n209\t                'transport-restart-receipt')\n210\t\n211\t    def enable_restart(self, identifier, guard=None):\n212\t        self._guarded(guard, identifier)\n213\t        require(self._request(host_command('restart-always', identifier), 5) is True,\n214\t                'transport-restart-receipt')\n215\t\n216\t    def signal_term(self, identifier, guard=None):\n217\t        self._guarded(guard, identifier)\n218\t        require(self._request(host_command('term', identifier), 5) is True,\n219\t                'transport-signal-receipt')\n220\t\n221\t    def wait_stopped(self, identifier, timeout):\n222\t        require(type(timeout) is int and 0 < timeout <= 30, 'transport-wait-bound')\n223\t        self._target(identifier)\n224\t        status = self._request(host_command('wait', identifier), timeout)\n225\t        require(type(status) is int and status == 0, 'transport-exit-not-clean')\n226\t\n227\t    def start_service(self, identifier, guard=None):\n228\t        self._guarded(guard, identifier)\n229\t        require(self._request(host_command('start', identifier), 10) is True,\n230\t                'transport-start-receipt')\n231\t"}]},"parent_tool_use_id":null,"session_id":"05249313-2279-499a-9431-55b58a17e539","uuid":"6dc6564e-e75c-4b7f-af02-4d3a2bbef033","timestamp":"2026-10-30T15:45:24.382Z","tool_use_result":{"type":"text","file":{"filePath":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_host_transport.py","content":"\"\"\"Command encoding for caller-supplied host drivers; no process or network executor.\n\nThe mandatory driver supplies sanitized metadata, not raw Docker inspect/env.\nIngress remains a semantic operation: no guessed Nginx/Evolution command.\nThe simulated transport cannot certify a real host. The observed transport only\nrestarts the four pinned legacy identities; it provides no deploy operation.\nIt validates shape and binds identities, but every value is driver-reported:\nit is no real executor, inventory or ingress implementation, and queue counts\nprove neither contents nor quiescence. A reviewed real driver remains pending.\nThe resume effects (start, restart=always, open-ingress) require a caller guard:\nthe transport hands it its own final snapshot and emits the command only after\nthe guard returns. Without a guard they refuse before any call; the bare\ntransport is an unauthorized encoder, never a resume authority.\n\"\"\"\nfrom __future__ import annotations\n\nfrom copy import deepcopy\nimport re\n\nfrom first_transition_adapter import ROLES, digest, queue_metadata\nfrom initial_transition_ops import Refused, require\n\nSUPPORT_ROLES = ('redis', 'evolution-postgres', 'evolution-api')\nSUPPORT_FIELDS = frozenset({'id', 'image', 'compose_project', 'compose_service', 'running',\n                            'restart_policy', 'health', 'networks_digest'})\nSERVICE_FIELDS = frozenset({'id', 'image', 'revision', 'compose_project', 'compose_service', 'started',\n                            'restart_count', 'restart_policy', 'running', 'exit_code', 'gates_digest',\n                            'mounts_digest', 'networks_digest'})\n\n\ndef host_command(operation, identifier):\n    \"\"\"Pure encoder shared with the separately authorized disposable probe.\"\"\"\n    require(isinstance(identifier, str) and re.fullmatch('[0-9a-f]{64}', identifier), 'transport-target')\n    commands = {'restart-no': ('docker', 'update', '--restart=no', identifier),\n                'term': ('docker', 'kill', '--signal=TERM', identifier),\n                'wait': ('docker', 'wait', identifier),\n                'restart-always': ('docker', 'update', '--restart=always', identifier),\n                'start': ('docker', 'start', identifier)}\n    require(operation in commands, 'transport-operation')\n    return commands[operation]\n\n\nclass SimulatedHostTransport:\n    def __init__(self, driver):\n        require(getattr(driver, 'mode', None) == 'local-simulation', 'transport-simulation-required')\n        self.driver = driver\n        self.identities = None\n\n    def _request(self, argv, timeout):\n        require(getattr(self.driver, 'mode', None) == 'local-simulation', 'transport-simulation-required')\n        try:\n            return self.driver.request(tuple(argv), timeout=timeout)\n        except TimeoutError:\n            raise TimeoutError('simulated-transport-timeout') from None\n        except Exception:\n            raise Refused('simulated-transport-failed') from None\n\n    def snapshot(self):\n        data = self._request(('snapshot-metadata',), 5)\n        require(isinstance(data, dict) and data.get('mode') == 'local-simulation', 'transport-snapshot')\n        services = data.get('services')\n        require(isinstance(services, dict) and set(services) == set(ROLES), 'transport-scope')\n        identities = {role: state.get('id') if isinstance(state, dict) else None\n                      for role, state in services.items()}\n        require(all(isinstance(value, str) and re.fullmatch('[0-9a-f]{64}', value)\n                    for value in identities.values()) and len(set(identities.values())) == 4,\n                'transport-identities')\n        if self.identities is None:\n            self.identities = identities\n        require(identities == self.identities, 'transport-identity-changed')\n        # Full shape/topology/gates validation remains in LocalHostContract.\n        return deepcopy(data)\n\n    def _target(self, identifier):\n        require(self.identities is not None and identifier in self.identities.values(), 'transport-target')\n        self.snapshot()  # Detect replacement immediately before a simulated effect.\n\n    def block_ingress(self):\n        require(self.identities is not None, 'transport-unobserved')\n        self.snapshot()\n        require(self._request(('block-ingress',), 5) is True, 'transport-ingress-receipt')\n\n    def disable_restart(self, identifier):\n        self._target(identifier)\n        require(self._request(host_command('restart-no', identifier), 5) is True,\n                'transport-restart-receipt')\n\n    def signal_term(self, identifier):\n        self._target(identifier)\n        require(self._request(host_command('term', identifier), 5) is True,\n                'transport-signal-receipt')\n\n    def wait_stopped(self, identifier, timeout):\n        require(type(timeout) is int and 0 < timeout <= 30, 'transport-wait-bound')\n        self._target(identifier)\n        status = self._request(host_command('wait', identifier), timeout)\n        require(type(status) is int and status == 0, 'transport-exit-not-clean')\n\n\ndef _ids(value, roles):\n    return (isinstance(value, dict) and set(value) == set(roles)\n            and all(isinstance(v, str) and re.fullmatch('[0-9a-f]{64}', v) for v in value.values())\n            and len(set(value.values())) == len(roles))\n\n\nclass ObservedHostTransport:\n    def __init__(self, driver, *, legacy_project, network_id, service_ids, support_ids, processing_keys=()):\n        require(getattr(driver, 'mode', None) == 'observed-host', 'transport-observed-required')\n        require(isinstance(legacy_project, str) and re.fullmatch(r'[A-Za-z0-9_-]{1,63}', legacy_project),\n                'transport-project')\n        require(isinstance(network_id, str) and re.fullmatch('[0-9a-f]{64}', network_id), 'transport-network')\n        require(_ids(service_ids, ROLES), 'transport-identities')\n        require(_ids(support_ids, SUPPORT_ROLES) and not set(support_ids.values()) & set(service_ids.values()),\n                'transport-support-identities')\n        self.driver, self.legacy_project, self.network_id = driver, legacy_project, network_id\n        self.identities, self.support_ids = dict(service_ids), dict(support_ids)\n        self.processing_keys = processing_keys  # validated by queue_metadata on every snapshot\n        self.support_digest = None\n        self.scope_digest = None\n\n    @property\n    def supports_resume(self):\n        return getattr(self.driver, 'supports_resume', False) is True\n\n    def _request(self, argv, timeout):\n        require(getattr(self.driver, 'mode', None) == 'observed-host', 'transport-observed-required')\n        try:\n            return self.driver.request(tuple(argv), timeout=timeout)\n        except TimeoutError:\n            raise TimeoutError('observed-transport-timeout') from None\n        except Exception:\n            raise Refused('observed-transport-failed') from None\n\n    def snapshot(self):\n        declared = getattr(self.driver, 'transport_scope', None)\n        if callable(declared):\n            require(declared() == dict(legacy_project=self.legacy_project, network_id=self.network_id,\n                                      service_ids=self.identities, support_ids=self.support_ids,\n                                      processing_keys=self.processing_keys), 'transport-driver-scope')\n        raw = self._request(('inspect-host',), 10)\n        require(isinstance(raw, dict) and set(raw) == {\n            'scope_digest', 'ingress_blocked', 'unknown_writers', 'network_id', 'services', 'support'}, 'transport-snapshot')\n        require(isinstance(raw['scope_digest'], str) and re.fullmatch('[0-9a-f]{64}', raw['scope_digest']),\n                'transport-scope-digest')\n        if self.scope_digest is None:\n            self.scope_digest = raw['scope_digest']\n        require(raw['scope_digest'] == self.scope_digest, 'transport-scope-changed')\n        require(raw['network_id'] == self.network_id, 'transport-network-mismatch')\n        require(type(raw['ingress_blocked']) is bool and type(raw['unknown_writers']) is int\n                and raw['unknown_writers'] >= 0, 'transport-snapshot')\n        support = raw['support']\n        require(isinstance(support, dict) and set(support) == set(SUPPORT_ROLES), 'transport-support-scope')\n        for role, state in support.items():\n            require(isinstance(state, dict) and set(state) == SUPPORT_FIELDS, 'transport-support-shape')\n            require(state['id'] == self.support_ids[role], 'transport-support-identity-changed')\n            require(isinstance(state['image'], str) and re.fullmatch(r'sha256:[0-9a-f]{64}', state['image']),\n                    'transport-support-image')\n            require(state['compose_project'] == self.legacy_project and state['compose_service'] == role,\n                    'transport-support-compose')\n            require(state['running'] is True and state['restart_policy'] == 'always',\n                    'transport-support-not-running')\n            require(state['health'] == 'healthy' if role in ('redis', 'evolution-postgres')\n                    else state['health'] in ('healthy', None), 'transport-support-unhealthy')\n            require(isinstance(state['networks_digest'], str)\n                    and re.fullmatch('[0-9a-f]{64}', state['networks_digest']), 'transport-support-network')\n        support_digest = digest([self.network_id, {role: support[role] for role in sorted(SUPPORT_ROLES)}])\n        if self.support_digest is None:\n            self.support_digest = support_digest\n        require(support_digest == self.support_digest, 'transport-support-changed')\n        services = raw['services']\n        require(isinstance(services, dict) and set(services) == set(ROLES), 'transport-scope')\n        require(all(isinstance(services[role], dict) and set(services[role]) == SERVICE_FIELDS\n                    for role in ROLES), 'transport-service-shape')\n        require({role: services[role]['id'] for role in ROLES} == self.identities, 'transport-identity-changed')\n        require(all(services[role].get('compose_project') == self.legacy_project\n                    for role in ROLES if role != 'broadcast-worker'), 'transport-compose')\n        queue = queue_metadata(lambda command, key: self._request(('redis-meta', command, key), 5),\n                               processing_keys=self.processing_keys)\n        # Field types/topology/gates validation remains in ObservedHostContract;\n        # only the declared keys leave the transport, never extra driver data.\n        return dict(mode='observed-host', scope_digest=raw['scope_digest'], ingress_blocked=raw['ingress_blocked'], support_digest=support_digest,\n                    unknown_writers=raw['unknown_writers'], queue_digest=queue['metadata_digest'],\n                    queue_counts=queue['counts'],\n                    services=deepcopy({role: {key: services[role][key] for key in SERVICE_FIELDS}\n                                       for role in ROLES}))\n\n    def _target(self, identifier):\n        require(identifier in self.identities.values(), 'transport-target')\n        self.snapshot()  # Detect replacement immediately before a host effect.\n\n    def _guarded(self, guard, identifier=None):\n        if identifier is not None:\n            require(identifier in self.identities.values(), 'transport-target')\n        require(callable(guard), 'transport-guard-required')\n        # This final observation, not an earlier one, is what the guard judges.\n        guard(self.snapshot())\n\n    def block_ingress(self, guard=None):\n        self._guarded(guard)\n        require(self._request(('block-ingress',), 5) is True, 'transport-ingress-receipt')\n\n    def open_ingress(self, guard=None):\n        self._guarded(guard)\n        require(self._request(('open-ingress',), 5) is True, 'transport-ingress-receipt')\n\n    def disable_restart(self, identifier, guard=None):\n        self._guarded(guard, identifier)\n        require(self._request(host_command('restart-no', identifier), 5) is True,\n                'transport-restart-receipt')\n\n    def enable_restart(self, identifier, guard=None):\n        self._guarded(guard, identifier)\n        require(self._request(host_command('restart-always', identifier), 5) is True,\n                'transport-restart-receipt')\n\n    def signal_term(self, identifier, guard=None):\n        self._guarded(guard, identifier)\n        require(self._request(host_command('term', identifier), 5) is True,\n                'transport-signal-receipt')\n\n    def wait_stopped(self, identifier, timeout):\n        require(type(timeout) is int and 0 < timeout <= 30, 'transport-wait-bound')\n        self._target(identifier)\n        status = self._request(host_command('wait', identifier), timeout)\n        require(type(status) is int and status == 0, 'transport-exit-not-clean')\n\n    def start_service(self, identifier, guard=None):\n        self._guarded(guard, identifier)\n        require(self._request(host_command('start', identifier), 10) is True,\n                'transport-start-receipt')\n","numLines":231,"startLine":1,"totalLines":231}},"tool_result_meta":[{"id":"toolu_017DrvCYP11qa8zeQ5yp6jWb","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L32QamGxenzzwETRtVG2wi","type":"tool_result","content":"1\t\"\"\"Observation/containment/resume driver behind ObservedHostTransport.\n2\t\n3\t``ObservedHostDriver.request(argv, *, timeout)`` answers the transport's\n4\tsemantic commands from an injected runner plus explicit callbacks:\n5\t\n6\t* inspect-host: pinned daemon, pinned network and the seven pinned containers\n7\t  through restricted ``--format`` stdout projections to Python, plus both ingress entries and the\n8\t  unknown-writer callback;\n9\t* redis-meta: TYPE/PTTL/LLEN/ZCARD on explicit keys via ``redis-cli`` inside the\n10\t  pinned, label-verified Redis container; no KEYS/SCAN/values/auth in argv, and\n11\t  an auth error is a refusal;\n12\t* block-ingress, ``docker update --restart=no``, ``docker kill --signal=TERM``\n13\t  and ``docker wait`` on the four legacy IDs only;\n14\t* resume (``docker start``, ``docker update --restart=always`` on the four\n15\t  legacy IDs and open-ingress through both bound entries) ONLY when a\n16\t  ``ledger_proof`` bound to this manifest is injected: a fresh read-only\n17\t  PostgreSQL proof (identity, exact baseline ledger, catalog; see\n18\t  first_transition_database.LedgerProof) runs inside every resume request,\n19\t  immediately before its effect. Without it, resume refuses before any call.\n20\t\n21\tThe writer binding reports UNKNOWN writers only: sources outside the declared\n22\tallowed ones (the transition's own observer/migration child and, once A9 starts\n23\tit, the configured candidate backend; see first_transition_orchestrator.assemble).\n24\t\n25\tEvery other operation refuses before any runner call. Ingress/writer values are\n26\tcallback-reported scope-bound answers, not independent proof, and no token or\n27\tboolean stands for a human approval. Docker values are CLI-reported for an\n28\toperator-configured endpoint; nothing here certifies the host or quiescence.\n29\tReal bindings/manifest values are Phase 3 inputs.\n30\t\n31\tThe Docker CLI applies --format client-side; only its restricted stdout\n32\tprojection enters Python/journals. Tests use synthetic data only.\n33\t\n34\tErrors carry fixed codes only; runner output never enters exceptions, logs or\n35\treceipts. No retry: a timeout or refusal is final for that request. Each\n36\trequest has a cooperative deadline, checked after injected calls return; per-command output caps are acceptance limits.\n37\tPopenRunner reads at most cap + 1 byte; joining buffers temporarily duplicates\n38\tthat bounded storage (plus Python overhead), so this is not a cap on process RSS; an\n39\tinjected runner's own buffering is its responsibility. Nothing runs at import\n40\tor construction; there is no command-line entry point.\n41\t\"\"\"\n42\tfrom __future__ import annotations\n43\t\n44\tfrom collections.abc import Mapping\n45\tfrom dataclasses import dataclass\n46\timport json\n47\timport os\n48\timport re\n49\timport select\n50\timport subprocess\n51\timport time\n52\t\n53\tfrom first_transition_adapter import ROLES, digest\n54\tfrom first_transition_host_transport import SUPPORT_ROLES, _ids, host_command\n55\tfrom initial_transition_ops import Refused, require\n56\t\n57\tSCHEMA = 'igreja12.first-transition-host-manifest/1'\n58\tMANIFEST_KEYS = frozenset({'schema', 'daemon_id', 'legacy_project', 'network_id', 'service_ids', 'support_ids',\n59\t                           'processing_keys', 'gate_names'})\n60\tENTRIES = ('external', 'evolution-backend')\n61\tQUEUE_KEYS = ('pastorai:webhooks', 'pastorai:webhooks:processing', 'pastorai:webhooks:dead',\n62\t              'pastorai:webhooks:retry-scheduled')\n63\tREDIS_COMMANDS = ('TYPE', 'PTTL', 'LLEN', 'ZCARD')\n64\tREDIS_TYPES = ('none', 'string', 'list', 'set', 'zset', 'hash', 'stream')\n65\tEFFECTS = ('restart-no', 'term', 'wait')\n66\tRESUME_EFFECTS = ('start', 'restart-always')\n67\t# Acceptance caps (bytes of stdout) per command; also PopenRunner's memory bound.\n68\tLIMITS = dict(info=256, network=1024, inspect=64 * 1024, redis=64, effect=256, wait=16)\n69\tMAX_OUTPUT = 1024 * 1024\n70\t\n71\tHEX64 = re.compile('[0-9a-f]{64}')\n72\tDAEMON = re.compile('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[A-Z0-9]{4}(?::[A-Z0-9]{4}){11}')\n73\tPROJECT = re.compile(r'[A-Za-z0-9_-]{1,63}')\n74\tPROCESSING = re.compile(r'pastorai:webhooks:processing:[A-Za-z0-9_-]{1,80}')\n75\tMANDATORY_GATES = ('ALLOW_REAL_SENDS', 'ASAAS_BILLING_ENABLED', 'BREVO_SEND_MODE', 'BROADCAST_ASYNC_ENABLED')\n76\tNETWORK_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,127}')\n77\tIMAGE = re.compile('sha256:[0-9a-f]{64}')\n78\tSTARTED = re.compile(r'[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})')\n79\tSTATUSES = ('created', 'running', 'exited')\n80\tHEALTH = ('starting', 'healthy', 'unhealthy')\n81\tRUNNER_CODES = frozenset({'runner-argv', 'runner-bounds', 'runner-spawn-failed', 'runner-output-oversize',\n82\t                          'runner-close-failed', 'runner-failed', 'runner-pending-cli'})\n83\tPROJECT_LABEL = 'com.docker.compose.project'\n84\tSERVICE_LABEL = 'com.docker.compose.service'\n85\tREVISION_LABEL = 'org.opencontainers.image.revision'\n86\tINFO_ARGV = ('docker', 'info', '--format', '{{json .ID}}')\n87\tNETWORK_TEMPLATE = '[{{json .Id}},{{json .Name}}]'\n88\t\n89\t\n90\tdef _gate_names(names):\n91\t    require(isinstance(names, (list, tuple)) and len(names) == len(MANDATORY_GATES)\n92\t            and all(isinstance(n, str) for n in names) and set(names) == set(MANDATORY_GATES),\n93\t            'manifest-gate-names')\n94\t    return tuple(sorted(names))\n95\t\n96\t\n97\tdef _label(key):\n98\t    # A nil label map prints null and a missing key prints \"\"; both normalize to None.\n99\t    return '{{with .Config.Labels}}{{json (index . \"' + key + '\")}}{{else}}null{{end}}'\n100\t\n101\t\n102\tdef inspect_template(gate_names):\n103\t    \"\"\"One JSON array per container; the trusted Docker CLI filters env by name before stdout.\"\"\"\n104\t    quoted = ' '.join('\"' + name + '\"' for name in _gate_names(gate_names))\n105\t    return ('[{{json .Id}},{{json .Image}},' + ','.join(_label(k) for k in (\n106\t            PROJECT_LABEL, SERVICE_LABEL, REVISION_LABEL)) + ','\n107\t            '{{json .State.Status}},{{json .State.Running}},{{json .State.Paused}},{{json .State.Restarting}},'\n108\t            '{{json .State.ExitCode}},{{json .State.StartedAt}},'\n109\t            '{{with .State.Health}}{{json .Status}}{{else}}null{{end}},'\n110\t            '{{json .RestartCount}},{{json .HostConfig.RestartPolicy.Name}},{{json .HostConfig.NetworkMode}},'\n111\t            '[{{range .Config.Env}}{{if eq (index (split . \"=\") 0) ' + quoted + '}}{{json .}},{{end}}{{end}}null],'\n112\t            '[{{range .Mounts}}[{{json .Type}},{{json .Name}},{{json .Source}},{{json .Destination}},'\n113\t            '{{json .RW}}],{{end}}null],'\n114\t            '[{{range $name, $net := .NetworkSettings.Networks}}[{{json $name}},{{json $net.Aliases}},'\n115\t            '{{json $net.NetworkID}}],{{end}}null]]')\n116\t\n117\t\n118\t@dataclass(frozen=True)\n119\tclass HostManifest:\n120\t    \"\"\"Sanitized, immutable scope; unknown keys (e.g. any secret) are refused.\"\"\"\n121\t    daemon_id: str\n122\t    legacy_project: str\n123\t    network_id: str\n124\t    service_ids: tuple\n125\t    support_ids: tuple\n126\t    processing_keys: tuple\n127\t    gate_names: tuple\n128\t    digest: str\n129\t\n130\t    @classmethod\n131\t    def from_dict(cls, data):\n132\t        require(isinstance(data, Mapping) and set(data) == MANIFEST_KEYS, 'manifest-keys')\n133\t        require(data['schema'] == SCHEMA, 'manifest-schema')\n134\t        require(isinstance(data['daemon_id'], str) and DAEMON.fullmatch(data['daemon_id']), 'manifest-daemon')\n135\t        require(isinstance(data['legacy_project'], str) and PROJECT.fullmatch(data['legacy_project']),\n136\t                'manifest-project')\n137\t        services, support = data['service_ids'], data['support_ids']\n138\t        require(_ids(services, ROLES) and _ids(support, SUPPORT_ROLES)\n139\t                and not set(services.values()) & set(support.values()), 'manifest-identities')\n140\t        require(isinstance(data['network_id'], str) and HEX64.fullmatch(data['network_id'])\n141\t                and data['network_id'] not in {*services.values(), *support.values()}, 'manifest-network')\n142\t        keys = data['processing_keys']\n143\t        require(isinstance(keys, (list, tuple)) and len(keys) <= 64 and all(isinstance(k, str) and PROCESSING.fullmatch(k) for k in keys)\n144\t                and len(set(keys)) == len(keys), 'manifest-processing-keys')\n145\t        values = dict(daemon_id=data['daemon_id'], legacy_project=data['legacy_project'],\n146\t                      network_id=data['network_id'], service_ids=tuple((r, services[r]) for r in ROLES),\n147\t                      support_ids=tuple((r, support[r]) for r in SUPPORT_ROLES), processing_keys=tuple(keys),\n148\t                      gate_names=_gate_names(data['gate_names']))\n149\t        return cls(**values, digest=digest([SCHEMA, values]))\n150\t\n151\t    def validated(self):\n152\t        require(all(type(v) is tuple for v in (\n153\t            self.service_ids, self.support_ids, self.processing_keys, self.gate_names)), 'manifest-values')\n154\t        ok, canonical = _attempt(type(self).from_dict, {\n155\t            'schema': SCHEMA, 'daemon_id': self.daemon_id, 'legacy_project': self.legacy_project,\n156\t            'network_id': self.network_id, 'service_ids': dict(self.service_ids),\n157\t            'support_ids': dict(self.support_ids), 'processing_keys': self.processing_keys,\n158\t            'gate_names': self.gate_names})\n159\t        require(ok and self == canonical, 'manifest-integrity')\n160\t        return canonical\n161\t\n162\t    def transport_scope(self):\n163\t        return dict(legacy_project=self.legacy_project, network_id=self.network_id,\n164\t                    service_ids=dict(self.service_ids), support_ids=dict(self.support_ids),\n165\t                    processing_keys=self.processing_keys)\n166\t\n167\t\n168\tdef _strict_json(text):\n169\t    def constant(_):\n170\t        raise ValueError('constant')\n171\t    return json.loads(text, parse_constant=constant)\n172\t\n173\t\n174\tdef _lines(out):\n175\t    text = out.decode('utf-8')\n176\t    if not text.endswith('\\n'):\n177\t        raise ValueError('unterminated')\n178\t    return [_strict_json(line) for line in text[:-1].split('\\n')]\n179\t\n180\t\n181\tdef _attempt(function, *args):\n182\t    # The failure is reported after the except block: no exception context can\n183\t    # carry runner output into a later traceback.\n184\t    try:\n185\t        return True, function(*args)\n186\t    except (ValueError, UnicodeDecodeError, RecursionError, TypeError):\n187\t        return False, None\n188\t\n189\t\n190\tdef _tail(value, code):\n191\t    require(isinstance(value, list) and value and value[-1] is None, code)\n192\t    return value[:-1]\n193\t\n194\t\n195\tclass ObservedHostDriver:\n196\t    mode = 'observed-host'\n197\t\n198\t    def __init__(self, manifest, *, runner, ingress, writers, ledger_proof=None):\n199\t        require(isinstance(manifest, HostManifest), 'driver-manifest')\n200\t        manifest = manifest.validated()\n201\t        require(callable(runner), 'driver-runner')\n202\t        require(isinstance(ingress, Mapping) and set(ingress) == set(ENTRIES)\n203\t                and ingress['external'] is not ingress['evolution-backend']\n204\t                and all(self._bound(ingress[e], manifest, e, 'observe', 'block') for e in ENTRIES),\n205\t                'driver-ingress-binding')\n206\t        require(self._bound(writers, manifest, None, 'observe'), 'driver-writer-binding')\n207\t        require(ledger_proof is None or self._bound(ledger_proof, manifest, None, 'prove'), 'driver-ledger-binding')\n208\t        self.manifest, self.runner = manifest, runner\n209\t        self.ingress, self.writers, self.ledger_proof = dict(ingress), writers, ledger_proof\n210\t        self.template = inspect_template(manifest.gate_names)\n211\t        self.roles = {ident: role for role, ident in (*manifest.service_ids, *manifest.support_ids)}\n212\t        self.legacy = tuple(ident for _, ident in manifest.service_ids)\n213\t        self.redis_id = dict(manifest.support_ids)['redis']\n214\t        self.redis_verified = False\n215\t        self.refusals = []  # fixed codes only, for diagnosis; never output\n216\t        self._bindings_fixed = (self.ingress['external'], self.ingress['evolution-backend'], self.writers,\n217\t                                ledger_proof)\n218\t\n219\t    @property\n220\t    def supports_resume(self):\n221\t        # Resume needs the database proof and an opener on both ingress entries.\n222\t        return (self.ledger_proof is not None and self._bound(self.ledger_proof, self.manifest, None, 'prove')\n223\t                and all(self._bound(self.ingress[e], self.manifest, e, 'open') for e in ENTRIES))\n224\t\n225\t    @staticmethod\n226\t    def _bound(binding, manifest, entry, *methods):\n227\t        return (binding is not None and getattr(binding, 'scope', None) == manifest.digest\n228\t                and (entry is None or getattr(binding, 'entry', None) == entry)\n229\t                and all(callable(getattr(binding, method, None)) for method in methods))\n230\t\n231\t    def transport_scope(self):\n232\t        return self.manifest.transport_scope()\n233\t\n234\t    def request(self, argv, *, timeout):\n235\t        try:\n236\t            self._assert_bindings()\n237\t            result = self._dispatch(argv, timeout)\n238\t            self._assert_bindings()\n239\t            return result\n240\t        except Refused as exc:\n241\t            self.refusals = [*self.refusals[-63:], str(exc)]\n242\t            raise\n243\t\n244\t    def _assert_bindings(self):\n245\t        require(isinstance(self.ingress, dict) and set(self.ingress) == set(ENTRIES), 'driver-ingress-binding')\n246\t        for index, entry in enumerate(ENTRIES):\n247\t            require(self.ingress[entry] is self._bindings_fixed[index]\n248\t                    and self._bound(self.ingress[entry], self.manifest, entry, 'observe', 'block'),\n249\t                    'driver-ingress-binding')\n250\t        require(self.writers is self._bindings_fixed[2]\n251\t                and self._bound(self.writers, self.manifest, None, 'observe'), 'driver-writer-binding')\n252\t        require(self.ledger_proof is self._bindings_fixed[3], 'driver-ledger-binding')\n253\t\n254\t    def _dispatch(self, argv, timeout):\n255\t        require(type(timeout) in (int, float) and 0 < timeout <= 30, 'driver-timeout-bound')\n256\t        require(type(argv) is tuple and argv and all(type(a) is str for a in argv), 'driver-operation-forbidden')\n257\t        deadline = time.monotonic() + timeout\n258\t        if argv == ('inspect-host',):\n259\t            return self._inspect_host(deadline)\n260\t        if argv[0] == 'redis-meta':\n261\t            require(len(argv) == 3 and argv[1] in REDIS_COMMANDS\n262\t                    and argv[2] in QUEUE_KEYS + self.manifest.processing_keys, 'driver-redis-scope')\n263\t            return self._redis_meta(argv[1], argv[2], deadline)\n264\t        if argv == ('block-ingress',):\n265\t            return self._block_ingress(deadline)\n266\t        if argv == ('open-ingress',):\n267\t            require(self.supports_resume, 'driver-operation-forbidden')\n268\t            return self._open_ingress(deadline)\n269\t        for kind in (*EFFECTS, *RESUME_EFFECTS):\n270\t            for ident in self.legacy:\n271\t                if argv == host_command(kind, ident):\n272\t                    require(kind in EFFECTS or self.supports_resume, 'driver-operation-forbidden')\n273\t                    return self._effect(kind, ident, argv, deadline)\n274\t        raise Refused('driver-operation-forbidden')\n275\t\n276\t    @staticmethod\n277\t    def _remaining(deadline):\n278\t        remaining = deadline - time.monotonic()\n279\t        if remaining <= 0:\n280\t            raise TimeoutError('driver-timeout')\n281\t        return remaining\n282\t\n283\t    def _run(self, argv, deadline, limit):\n284\t        outcome = None\n285\t        try:\n286\t            result = self.runner(argv, timeout=self._remaining(deadline), max_output=limit)\n287\t        except TimeoutError:\n288\t            outcome = 'timeout'\n289\t        except Refused as exc:\n290\t            outcome = str(exc) if str(exc) in RUNNER_CODES else 'driver-runner-failed'\n291\t        except Exception:\n292\t            outcome = 'driver-runner-failed'\n293\t        if outcome == 'timeout':\n294\t            raise TimeoutError('driver-timeout')\n295\t        require(outcome is None, outcome)\n296\t        require(isinstance(result, tuple) and len(result) == 2 and type(result[0]) is int\n297\t                and type(result[1]) is bytes, 'driver-runner-failed')\n298\t        self._remaining(deadline)\n299\t        self._assert_bindings()\n300\t        require(len(result[1]) <= limit, 'driver-output-oversize')\n301\t        return result\n302\t\n303\t    def _callback(self, binding, method, deadline, entry, code, failed='driver-binding-failed'):\n304\t        require(self._bound(binding, self.manifest, entry, method), code)\n305\t        outcome = None\n306\t        try:\n307\t            value = getattr(binding, method)(self.manifest.digest, timeout=self._remaining(deadline))\n308\t        except TimeoutError:\n309\t            outcome = 'timeout'\n310\t        except Exception:\n311\t            outcome = failed\n312\t        if outcome == 'timeout':\n313\t            raise TimeoutError('driver-timeout')\n314\t        self._remaining(deadline)\n315\t        require(self._bound(binding, self.manifest, entry, method), code)\n316\t        self._assert_bindings()\n317\t        require(outcome is None, outcome)\n318\t        return value\n319\t\n320\t    def _daemon(self, deadline):\n321\t        rc, out = self._run(INFO_ARGV, deadline, LIMITS['info'])\n322\t        require(rc == 0, 'driver-daemon-failed')\n323\t        ok, value = _attempt(_lines, out)\n324\t        require(ok and len(value) == 1 and isinstance(value[0], str) and DAEMON.fullmatch(value[0]),\n325\t                'driver-daemon-malformed')\n326\t        require(value[0] == self.manifest.daemon_id, 'driver-daemon-mismatch')\n327\t\n328\t    def _network(self, deadline):\n329\t        rc, out = self._run(('docker', 'network', 'inspect', '--format', NETWORK_TEMPLATE, self.manifest.network_id),\n330\t                            deadline, LIMITS['network'])\n331\t        require(rc == 0, 'driver-network-failed')\n332\t        ok, value = _attempt(_lines, out)\n333\t        require(ok and len(value) == 1 and isinstance(value[0], list) and len(value[0]) == 2\n334\t                and all(isinstance(v, str) for v in value[0]) and HEX64.fullmatch(value[0][0])\n335\t                and NETWORK_NAME.fullmatch(value[0][1]), 'driver-network-malformed')\n336\t        require(value[0][0] == self.manifest.network_id, 'driver-network-mismatch')\n337\t        return value[0]\n338\t\n339\t    def _ingress(self, deadline):\n340\t        states = {}\n341\t        for entry in ENTRIES:\n342\t            value = self._callback(self.ingress[entry], 'observe', deadline, entry, 'driver-ingress-binding')\n343\t            require(type(value) is str and value in ('blocked', 'open'), 'driver-ingress-shape')\n344\t            states[entry] = value\n345\t        return states\n346\t\n347\t    def _row(self, row, network_name):\n348\t        (ident, image, project, service, revision, status, running, paused, restarting, exit_code, started,\n349\t         health, restarts, policy, mode, gates, mounts, networks) = row\n350\t        labels = [None if value in (None, '') else value for value in (project, service, revision)]\n351\t        require(all(v is None or isinstance(v, str) and len(v) <= 128 for v in labels), 'driver-inspect-labels')\n352\t        require(isinstance(image, str) and IMAGE.fullmatch(image) and type(running) is bool\n353\t                and isinstance(status, str) and status in STATUSES and running == (status == 'running')\n354\t                and paused is False and restarting is False\n355\t                and type(exit_code) is int and 0 <= exit_code <= 255\n356\t                and isinstance(started, str) and STARTED.fullmatch(started)\n357\t                and (health is None or isinstance(health, str) and health in HEALTH)\n358\t                and type(restarts) is int and 0 <= restarts <= 10**6\n359\t                and isinstance(policy, str) and policy in ('always', 'no', '')\n360\t                and isinstance(mode, str) and len(mode) <= 128, 'driver-inspect-state')\n361\t        gates = _tail(gates, 'driver-inspect-gates')\n362\t        names = [g.split('=', 1)[0] if isinstance(g, str) and '=' in g else None for g in gates]\n363\t        require(all(n in self.manifest.gate_names for n in names) and len(set(names)) == len(names)\n364\t                and all(len(g) <= 512 for g in gates), 'driver-inspect-gates')\n365\t        mounts = _tail(mounts, 'driver-inspect-mounts')\n366\t        require(len(mounts) <= 64 and all(\n367\t            isinstance(m, list) and len(m) == 5 and type(m[4]) is bool\n368\t            and all(v is None or isinstance(v, str) and len(v) <= 4096 for v in m[:4]) for m in mounts),\n369\t            'driver-inspect-mounts')\n370\t        networks = _tail(networks, 'driver-inspect-networks')\n371\t        require(len(networks) <= 16 and all(\n372\t            isinstance(n, list) and len(n) == 3 and isinstance(n[0], str) and NETWORK_NAME.fullmatch(n[0])\n373\t            and (n[1] is None or isinstance(n[1], list) and all(isinstance(a, str) for a in n[1]))\n374\t            and isinstance(n[2], str) and HEX64.fullmatch(n[2]) for n in networks)\n375\t            and len({n[0] for n in networks}) == len(networks), 'driver-inspect-networks')\n376\t        require(network_name in {n[0] for n in networks}, 'driver-network-detached')\n377\t        require(any(n[0] == network_name and n[2] == self.manifest.network_id for n in networks),\n378\t                'driver-network-mismatch')\n379\t        # Stable configuration only: attachments by name/ID with configured aliases; IPAM is operational on some engines,\n380\t        # never IP, endpoint, gateway or MAC, which Docker clears on stop.\n381\t        attachments = [[n[0], sorted(n[1] or []), n[2]] for n in sorted(networks, key=lambda n: n[0])]\n382\t        return dict(\n383\t            id=ident, image=image, compose_project=labels[0], compose_service=labels[1], revision=labels[2],\n384\t            started=started, restart_count=restarts, restart_policy=policy or 'no', running=running,\n385\t            exit_code=None if running else exit_code, health=health,\n386\t            gates_digest=digest(['gates', sorted(gates)]),\n387\t            mounts_digest=digest(['mounts', sorted(mounts, key=json.dumps)]),\n388\t            networks_digest=digest(['networks', mode, attachments]))\n389\t\n390\t    def _inspect_host(self, deadline):\n391\t        self.redis_verified = False\n392\t        self._daemon(deadline)\n393\t        network_id, network_name = self._network(deadline)\n394\t        ids = tuple(self.roles)\n395\t        rc, out = self._run(('docker', 'inspect', '--type', 'container', '--format', self.template, *ids),\n396\t                            deadline, LIMITS['inspect'])\n397\t        require(rc == 0, 'driver-inspect-failed')\n398\t        ok, rows = _attempt(_lines, out)\n399\t        require(ok and all(isinstance(r, list) and len(r) == 18 and isinstance(r[0], str) for r in rows),\n400\t                'driver-inspect-malformed')\n401\t        require(len(rows) == len(ids) and {r[0] for r in rows} == set(ids), 'driver-inspect-scope')\n402\t        services, support = {}, {}\n403\t        for row in rows:\n404\t            state, role = self._row(row, network_name), self.roles[row[0]]\n405\t            if role in ROLES:\n406\t                state.pop('health')\n407\t                services[role] = state\n408\t            else:\n409\t                support[role] = {key: state[key] for key in (\n410\t                    'id', 'image', 'compose_project', 'compose_service', 'running', 'restart_policy', 'health',\n411\t                    'networks_digest')}\n412\t        ingress = self._ingress(deadline)\n413\t        writers = self._callback(self.writers, 'observe', deadline, None, 'driver-writer-binding')\n414\t        require(type(writers) is int and 0 <= writers <= 10**6, 'driver-writer-shape')\n415\t        redis = support['redis']\n416\t        self.redis_verified = (redis['compose_project'] == self.manifest.legacy_project\n417\t                               and redis['compose_service'] == 'redis' and redis['running'] is True)\n418\t        return dict(scope_digest=self.manifest.digest,\n419\t                    ingress_blocked=all(v == 'blocked' for v in ingress.values()), unknown_writers=writers,\n420\t                    network_id=network_id, services=services, support=support)\n421\t\n422\t    def _redis_meta(self, command, key, deadline):\n423\t        # Only into the Redis container this driver just verified by label; no auth in argv.\n424\t        require(self.redis_verified, 'driver-redis-unverified')\n425\t        self._daemon(deadline)\n426\t        rc, out = self._run(('docker', 'exec', self.redis_id, 'redis-cli', '--raw', command, key),\n427\t                            deadline, LIMITS['redis'])\n428\t        ok, text = _attempt(bytes.decode, out, 'ascii')\n429\t        require(ok, 'driver-redis-output')\n430\t        require(not text.startswith(('NOAUTH', 'WRONGPASS', 'NOPERM')), 'driver-redis-auth-required')\n431\t        require(rc == 0, 'driver-redis-failed')\n432\t        require(text.endswith('\\n'), 'driver-redis-output')\n433\t        value = text[:-1]\n434\t        if command == 'TYPE':\n435\t            require(value in REDIS_TYPES, 'driver-redis-output')\n436\t            return value\n437\t        require(re.fullmatch('-?[0-9]{1,19}', value), 'driver-redis-output')\n438\t        return int(value)\n439\t\n440\t    def _block_ingress(self, deadline):\n441\t        # Both entries are checked; one blocked entry never stands for the other.\n442\t        for entry, state in self._ingress(deadline).items():\n443\t            if state == 'open':\n444\t                require(self._callback(self.ingress[entry], 'block', deadline, entry,\n445\t                                       'driver-ingress-binding') is True, 'driver-ingress-receipt')\n446\t        require(all(v == 'blocked' for v in self._ingress(deadline).values()), 'driver-ingress-still-open')\n447\t        return True\n448\t\n449\t    def _prove_ledger(self, deadline):\n450\t        # Fresh read-only database proof inside this very request, before its effect.\n451\t        proof = self._callback(self.ledger_proof, 'prove', deadline, None, 'driver-ledger-binding',\n452\t                               'driver-ledger-proof')\n453\t        require(isinstance(proof, dict) and proof.get('scope') == self.manifest.digest\n454\t                and proof.get('read_only') is True and proof.get('ddl_free') is True, 'driver-ledger-proof')\n455\t\n456\t    def _open_ingress(self, deadline):\n457\t        # Internal Evolution->backend first, external last; both must end open.\n458\t        self._prove_ledger(deadline)\n459\t        for entry in reversed(ENTRIES):\n460\t            if self._ingress(deadline)[entry] == 'blocked':\n461\t                require(self._callback(self.ingress[entry], 'open', deadline, entry,\n462\t                                       'driver-ingress-binding') is True, 'driver-ingress-receipt')\n463\t        require(all(v == 'open' for v in self._ingress(deadline).values()), 'driver-ingress-still-blocked')\n464\t        return True\n465\t\n466\t    def _effect(self, kind, ident, argv, deadline):\n467\t        if kind in RESUME_EFFECTS:\n468\t            self._prove_ledger(deadline)\n469\t        self._daemon(deadline)\n470\t        if kind == 'wait':\n471\t            rc, out = self._run(argv, deadline, LIMITS['wait'])\n472\t            ok, text = _attempt(bytes.decode, out, 'ascii')\n473\t            require(ok and rc == 0 and re.fullmatch('[0-9]{1,3}\\n', text), 'driver-wait-receipt')\n474\t            return int(text)\n475\t        rc, out = self._run(argv, deadline, LIMITS['effect'])\n476\t        require(rc == 0 and out == (ident + '\\n').encode(), 'driver-effect-receipt')\n477\t        return True\n478\t\n479\t\n480\tGLOBAL_FLAGS = frozenset({'-H', '--host', '--context', '-c', '--config', '--tls', '--tlsverify', '--tlscacert',\n481\t                          '--tlscert', '--tlskey', '-D', '--debug', '-l', '--log-level'})\n482\tENV = {'LC_ALL': 'C', 'LANG': 'C'}\n483\tABS_PATH = re.compile('/[A-Za-z0-9._/-]{1,255}')\n484\t\n485\t\n486\tdef _absolute(path):\n487\t    return (isinstance(path, str) and ABS_PATH.fullmatch(path) is not None\n488\t            and all(part not in ('', '.', '..') for part in path[1:].split('/')))\n489\t\n490\t\n491\tdef _runner_argv(argv, resume=False):\n492\t    if not (type(argv) is tuple and 2 <= len(argv) <= 32 and argv[0] == 'docker'\n493\t            and all(type(a) is str and 0 < len(a) <= 16384 and '\\x00' not in a for a in argv)):\n494\t        return False\n495\t    if argv == INFO_ARGV:\n496\t        return True\n497\t    if len(argv) == 6 and argv[:5] == ('docker', 'network', 'inspect', '--format', NETWORK_TEMPLATE):\n498\t        return HEX64.fullmatch(argv[5]) is not None\n499\t    if 7 <= len(argv) <= 13 and argv[:6] == (\n500\t            'docker', 'inspect', '--type', 'container', '--format', inspect_template(MANDATORY_GATES)):\n501\t        return all(HEX64.fullmatch(i) for i in argv[6:]) and len(set(argv[6:])) == len(argv[6:])\n502\t    if len(argv) == 7 and argv[:2] == ('docker', 'exec'):\n503\t        return (HEX64.fullmatch(argv[2]) is not None and argv[3:5] == ('redis-cli', '--raw')\n504\t                and argv[5] in REDIS_COMMANDS and (argv[6] in QUEUE_KEYS or PROCESSING.fullmatch(argv[6])))\n505\t    if len(argv) == 4 and argv[:3] in (('docker', 'update', '--restart=no'),\n506\t                                     ('docker', 'kill', '--signal=TERM')):\n507\t        return HEX64.fullmatch(argv[3]) is not None\n508\t    if resume and (len(argv) == 4 and argv[:3] == ('docker', 'update', '--restart=always')\n509\t                   or len(argv) == 3 and argv[:2] == ('docker', 'start')):\n510\t        return HEX64.fullmatch(argv[-1]) is not None\n511\t    return len(argv) == 3 and argv[:2] == ('docker', 'wait') and HEX64.fullmatch(argv[2]) is not None\n512\t\n513\t\n514\tclass PopenRunner:\n515\t    \"\"\"Bounded docker CLI runner for a future authorized operator; never used by tests unmocked.\n516\t\n517\t    The endpoint (``unix://`` socket), docker binary and an operator-provided\n518\t    config directory are explicit; the child gets a minimal environment, so no\n519\t    inherited DOCKER_HOST/DOCKER_CONTEXT/credentials/HOME apply. Only block-A\n520\t    read/containment subcommands are accepted, plus ``start``/``restart=always``\n521\t    by ID only when constructed with ``resume=True``. On timeout, oversize or error it\n522\t    ends only its own CLI process, waits at most ``cleanup_wait`` and never\n523\t    retries; an unreaped CLI is counted, not escalated. Killing the CLI does not\n524\t    undo a request the daemon already received. Compatibility with a real\n525\t    Docker CLI/daemon is unverified here.\n526\t    \"\"\"\n527\t\n528\t    def __init__(self, *, docker_binary, endpoint, config_dir, popen=None, cleanup_wait=2.0, chunk=4096,\n529\t                 resume=False):\n530\t        require(_absolute(docker_binary) and docker_binary.endswith('/docker')\n531\t                and isinstance(endpoint, str) and endpoint.startswith('unix://')\n532\t                and _absolute(endpoint[len('unix://'):]) and endpoint.endswith('.sock')\n533\t                and _absolute(config_dir) and (popen is None or callable(popen))\n534\t                and type(cleanup_wait) in (int, float) and 0 < cleanup_wait <= 10\n535\t                and type(chunk) is int and 0 < chunk <= 65536 and type(resume) is bool, 'runner-config')\n536\t        self.resume = resume\n537\t        self.docker_binary, self.endpoint, self.config_dir = docker_binary, endpoint, config_dir\n538\t        self.popen, self.cleanup_wait, self.chunk = popen, cleanup_wait, chunk\n539\t        self.unreaped = 0\n540\t\n541\t    def _allowed(self, argv):\n542\t        return _runner_argv(argv, self.resume)\n543\t\n544\t    def _env(self):\n545\t        return dict(ENV)\n546\t\n547\t    def __call__(self, argv, *, timeout, max_output):\n548\t        require(self.unreaped == 0, 'runner-pending-cli')\n549\t        require(self._allowed(argv), 'runner-argv')\n550\t        require(type(timeout) in (int, float) and 0 < timeout <= 60\n551\t                and type(max_output) is int and 0 < max_output <= MAX_OUTPUT, 'runner-bounds')\n552\t        deadline = time.monotonic() + timeout\n553\t        popen = self.popen or subprocess.Popen  # resolved per call, never at import/construction\n554\t        command = [self.docker_binary, '--config', self.config_dir, '--host', self.endpoint, *argv[1:]]\n555\t        proc = None\n556\t        try:\n557\t            proc = popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,\n558\t                         env=self._env(), cwd='/', close_fds=True, shell=False, start_new_session=True)\n559\t        except Exception:\n560\t            pass\n561\t        require(proc is not None, 'runner-spawn-failed')\n562\t        outcome = 'runner-failed'\n563\t        try:\n564\t            out = self._read(proc, deadline, max_output)\n565\t            rc = proc.wait(timeout=max(deadline - time.monotonic(), 0))\n566\t            outcome = None\n567\t        except (TimeoutError, subprocess.TimeoutExpired):\n568\t            outcome = 'timeout'\n569\t        except Refused as exc:\n570\t            outcome = str(exc)\n571\t        except Exception:\n572\t            pass\n573\t        except BaseException:\n574\t            self._cleanup(proc)\n575\t            raise\n576\t        finally:\n577\t            try:\n578\t                proc.stdout.close()\n579\t            except Exception:\n580\t                if outcome is None:\n581\t                    outcome = 'runner-close-failed'\n582\t        if outcome is None and time.monotonic() > deadline:\n583\t            outcome = 'timeout'\n584\t        if outcome is not None:\n585\t            self._cleanup(proc)\n586\t            if outcome == 'timeout':\n587\t                raise TimeoutError('runner-timeout')\n588\t            raise Refused(outcome)\n589\t        return rc, out\n590\t\n591\t    def _read(self, proc, deadline, limit):\n592\t        fd, chunks, size = proc.stdout.fileno(), [], 0\n593\t        while True:\n594\t            remaining = deadline - time.monotonic()\n595\t            if remaining <= 0 or not select.select([fd], [], [], remaining)[0]:\n596\t                raise TimeoutError('runner-timeout')\n597\t            chunk = os.read(fd, min(self.chunk, limit + 1 - size))\n598\t            if not chunk:\n599\t                return b''.join(chunks)\n600\t            size += len(chunk)\n601\t            chunks.append(chunk)\n602\t            require(size <= limit, 'runner-output-oversize')\n603\t\n604\t    def _cleanup(self, proc):\n605\t        # Ends only this runner's own CLI child; never a container, never a retry.\n606\t        try:\n607\t            if proc.poll() is None:\n608\t                proc.kill()\n609\t            proc.wait(timeout=self.cleanup_wait)\n610\t        except Exception:\n611\t            self.unreaped += 1\n612\t"}]},"parent_tool_use_id":null,"session_id":"05249313-2279-499a-9431-55b58a17e539","uuid":"53ee1f41-28f0-4f0b-b2f8-fdfd0b6a0c5c","timestamp":"2026-10-30T15:45:24.546Z","tool_use_result":{"type":"text","file":{"filePath":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_host_driver.py","content":"\"\"\"Observation/containment/resume driver behind ObservedHostTransport.\n\n``ObservedHostDriver.request(argv, *, timeout)`` answers the transport's\nsemantic commands from an injected runner plus explicit callbacks:\n\n* inspect-host: pinned daemon, pinned network and the seven pinned containers\n  through restricted ``--format`` stdout projections to Python, plus both ingress entries and the\n  unknown-writer callback;\n* redis-meta: TYPE/PTTL/LLEN/ZCARD on explicit keys via ``redis-cli`` inside the\n  pinned, label-verified Redis container; no KEYS/SCAN/values/auth in argv, and\n  an auth error is a refusal;\n* block-ingress, ``docker update --restart=no``, ``docker kill --signal=TERM``\n  and ``docker wait`` on the four legacy IDs only;\n* resume (``docker start``, ``docker update --restart=always`` on the four\n  legacy IDs and open-ingress through both bound entries) ONLY when a\n  ``ledger_proof`` bound to this manifest is injected: a fresh read-only\n  PostgreSQL proof (identity, exact baseline ledger, catalog; see\n  first_transition_database.LedgerProof) runs inside every resume request,\n  immediately before its effect. Without it, resume refuses before any call.\n\nThe writer binding reports UNKNOWN writers only: sources outside the declared\nallowed ones (the transition's own observer/migration child and, once A9 starts\nit, the configured candidate backend; see first_transition_orchestrator.assemble).\n\nEvery other operation refuses before any runner call. Ingress/writer values are\ncallback-reported scope-bound answers, not independent proof, and no token or\nboolean stands for a human approval. Docker values are CLI-reported for an\noperator-configured endpoint; nothing here certifies the host or quiescence.\nReal bindings/manifest values are Phase 3 inputs.\n\nThe Docker CLI applies --format client-side; only its restricted stdout\nprojection enters Python/journals. Tests use synthetic data only.\n\nErrors carry fixed codes only; runner output never enters exceptions, logs or\nreceipts. No retry: a timeout or refusal is final for that request. Each\nrequest has a cooperative deadline, checked after injected calls return; per-command output caps are acceptance limits.\nPopenRunner reads at most cap + 1 byte; joining buffers temporarily duplicates\nthat bounded storage (plus Python overhead), so this is not a cap on process RSS; an\ninjected runner's own buffering is its responsibility. Nothing runs at import\nor construction; there is no command-line entry point.\n\"\"\"\nfrom __future__ import annotations\n\nfrom collections.abc import Mapping\nfrom dataclasses import dataclass\nimport json\nimport os\nimport re\nimport select\nimport subprocess\nimport time\n\nfrom first_transition_adapter import ROLES, digest\nfrom first_transition_host_transport import SUPPORT_ROLES, _ids, host_command\nfrom initial_transition_ops import Refused, require\n\nSCHEMA = 'igreja12.first-transition-host-manifest/1'\nMANIFEST_KEYS = frozenset({'schema', 'daemon_id', 'legacy_project', 'network_id', 'service_ids', 'support_ids',\n                           'processing_keys', 'gate_names'})\nENTRIES = ('external', 'evolution-backend')\nQUEUE_KEYS = ('pastorai:webhooks', 'pastorai:webhooks:processing', 'pastorai:webhooks:dead',\n              'pastorai:webhooks:retry-scheduled')\nREDIS_COMMANDS = ('TYPE', 'PTTL', 'LLEN', 'ZCARD')\nREDIS_TYPES = ('none', 'string', 'list', 'set', 'zset', 'hash', 'stream')\nEFFECTS = ('restart-no', 'term', 'wait')\nRESUME_EFFECTS = ('start', 'restart-always')\n# Acceptance caps (bytes of stdout) per command; also PopenRunner's memory bound.\nLIMITS = dict(info=256, network=1024, inspect=64 * 1024, redis=64, effect=256, wait=16)\nMAX_OUTPUT = 1024 * 1024\n\nHEX64 = re.compile('[0-9a-f]{64}')\nDAEMON = re.compile('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[A-Z0-9]{4}(?::[A-Z0-9]{4}){11}')\nPROJECT = re.compile(r'[A-Za-z0-9_-]{1,63}')\nPROCESSING = re.compile(r'pastorai:webhooks:processing:[A-Za-z0-9_-]{1,80}')\nMANDATORY_GATES = ('ALLOW_REAL_SENDS', 'ASAAS_BILLING_ENABLED', 'BREVO_SEND_MODE', 'BROADCAST_ASYNC_ENABLED')\nNETWORK_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,127}')\nIMAGE = re.compile('sha256:[0-9a-f]{64}')\nSTARTED = re.compile(r'[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})')\nSTATUSES = ('created', 'running', 'exited')\nHEALTH = ('starting', 'healthy', 'unhealthy')\nRUNNER_CODES = frozenset({'runner-argv', 'runner-bounds', 'runner-spawn-failed', 'runner-output-oversize',\n                          'runner-close-failed', 'runner-failed', 'runner-pending-cli'})\nPROJECT_LABEL = 'com.docker.compose.project'\nSERVICE_LABEL = 'com.docker.compose.service'\nREVISION_LABEL = 'org.opencontainers.image.revision'\nINFO_ARGV = ('docker', 'info', '--format', '{{json .ID}}')\nNETWORK_TEMPLATE = '[{{json .Id}},{{json .Name}}]'\n\n\ndef _gate_names(names):\n    require(isinstance(names, (list, tuple)) and len(names) == len(MANDATORY_GATES)\n            and all(isinstance(n, str) for n in names) and set(names) == set(MANDATORY_GATES),\n            'manifest-gate-names')\n    return tuple(sorted(names))\n\n\ndef _label(key):\n    # A nil label map prints null and a missing key prints \"\"; both normalize to None.\n    return '{{with .Config.Labels}}{{json (index . \"' + key + '\")}}{{else}}null{{end}}'\n\n\ndef inspect_template(gate_names):\n    \"\"\"One JSON array per container; the trusted Docker CLI filters env by name before stdout.\"\"\"\n    quoted = ' '.join('\"' + name + '\"' for name in _gate_names(gate_names))\n    return ('[{{json .Id}},{{json .Image}},' + ','.join(_label(k) for k in (\n            PROJECT_LABEL, SERVICE_LABEL, REVISION_LABEL)) + ','\n            '{{json .State.Status}},{{json .State.Running}},{{json .State.Paused}},{{json .State.Restarting}},'\n            '{{json .State.ExitCode}},{{json .State.StartedAt}},'\n            '{{with .State.Health}}{{json .Status}}{{else}}null{{end}},'\n            '{{json .RestartCount}},{{json .HostConfig.RestartPolicy.Name}},{{json .HostConfig.NetworkMode}},'\n            '[{{range .Config.Env}}{{if eq (index (split . \"=\") 0) ' + quoted + '}}{{json .}},{{end}}{{end}}null],'\n            '[{{range .Mounts}}[{{json .Type}},{{json .Name}},{{json .Source}},{{json .Destination}},'\n            '{{json .RW}}],{{end}}null],'\n            '[{{range $name, $net := .NetworkSettings.Networks}}[{{json $name}},{{json $net.Aliases}},'\n            '{{json $net.NetworkID}}],{{end}}null]]')\n\n\n@dataclass(frozen=True)\nclass HostManifest:\n    \"\"\"Sanitized, immutable scope; unknown keys (e.g. any secret) are refused.\"\"\"\n    daemon_id: str\n    legacy_project: str\n    network_id: str\n    service_ids: tuple\n    support_ids: tuple\n    processing_keys: tuple\n    gate_names: tuple\n    digest: str\n\n    @classmethod\n    def from_dict(cls, data):\n        require(isinstance(data, Mapping) and set(data) == MANIFEST_KEYS, 'manifest-keys')\n        require(data['schema'] == SCHEMA, 'manifest-schema')\n        require(isinstance(data['daemon_id'], str) and DAEMON.fullmatch(data['daemon_id']), 'manifest-daemon')\n        require(isinstance(data['legacy_project'], str) and PROJECT.fullmatch(data['legacy_project']),\n                'manifest-project')\n        services, support = data['service_ids'], data['support_ids']\n        require(_ids(services, ROLES) and _ids(support, SUPPORT_ROLES)\n                and not set(services.values()) & set(support.values()), 'manifest-identities')\n        require(isinstance(data['network_id'], str) and HEX64.fullmatch(data['network_id'])\n                and data['network_id'] not in {*services.values(), *support.values()}, 'manifest-network')\n        keys = data['processing_keys']\n        require(isinstance(keys, (list, tuple)) and len(keys) <= 64 and all(isinstance(k, str) and PROCESSING.fullmatch(k) for k in keys)\n                and len(set(keys)) == len(keys), 'manifest-processing-keys')\n        values = dict(daemon_id=data['daemon_id'], legacy_project=data['legacy_project'],\n                      network_id=data['network_id'], service_ids=tuple((r, services[r]) for r in ROLES),\n                      support_ids=tuple((r, support[r]) for r in SUPPORT_ROLES), processing_keys=tuple(keys),\n                      gate_names=_gate_names(data['gate_names']))\n        return cls(**values, digest=digest([SCHEMA, values]))\n\n    def validated(self):\n        require(all(type(v) is tuple for v in (\n            self.service_ids, self.support_ids, self.processing_keys, self.gate_names)), 'manifest-values')\n        ok, canonical = _attempt(type(self).from_dict, {\n            'schema': SCHEMA, 'daemon_id': self.daemon_id, 'legacy_project': self.legacy_project,\n            'network_id': self.network_id, 'service_ids': dict(self.service_ids),\n            'support_ids': dict(self.support_ids), 'processing_keys': self.processing_keys,\n            'gate_names': self.gate_names})\n        require(ok and self == canonical, 'manifest-integrity')\n        return canonical\n\n    def transport_scope(self):\n        return dict(legacy_project=self.legacy_project, network_id=self.network_id,\n                    service_ids=dict(self.service_ids), support_ids=dict(self.support_ids),\n                    processing_keys=self.processing_keys)\n\n\ndef _strict_json(text):\n    def constant(_):\n        raise ValueError('constant')\n    return json.loads(text, parse_constant=constant)\n\n\ndef _lines(out):\n    text = out.decode('utf-8')\n    if not text.endswith('\\n'):\n        raise ValueError('unterminated')\n    return [_strict_json(line) for line in text[:-1].split('\\n')]\n\n\ndef _attempt(function, *args):\n    # The failure is reported after the except block: no exception context can\n    # carry runner output into a later traceback.\n    try:\n        return True, function(*args)\n    except (ValueError, UnicodeDecodeError, RecursionError, TypeError):\n        return False, None\n\n\ndef _tail(value, code):\n    require(isinstance(value, list) and value and value[-1] is None, code)\n    return value[:-1]\n\n\nclass ObservedHostDriver:\n    mode = 'observed-host'\n\n    def __init__(self, manifest, *, runner, ingress, writers, ledger_proof=None):\n        require(isinstance(manifest, HostManifest), 'driver-manifest')\n        manifest = manifest.validated()\n        require(callable(runner), 'driver-runner')\n        require(isinstance(ingress, Mapping) and set(ingress) == set(ENTRIES)\n                and ingress['external'] is not ingress['evolution-backend']\n                and all(self._bound(ingress[e], manifest, e, 'observe', 'block') for e in ENTRIES),\n                'driver-ingress-binding')\n        require(self._bound(writers, manifest, None, 'observe'), 'driver-writer-binding')\n        require(ledger_proof is None or self._bound(ledger_proof, manifest, None, 'prove'), 'driver-ledger-binding')\n        self.manifest, self.runner = manifest, runner\n        self.ingress, self.writers, self.ledger_proof = dict(ingress), writers, ledger_proof\n        self.template = inspect_template(manifest.gate_names)\n        self.roles = {ident: role for role, ident in (*manifest.service_ids, *manifest.support_ids)}\n        self.legacy = tuple(ident for _, ident in manifest.service_ids)\n        self.redis_id = dict(manifest.support_ids)['redis']\n        self.redis_verified = False\n        self.refusals = []  # fixed codes only, for diagnosis; never output\n        self._bindings_fixed = (self.ingress['external'], self.ingress['evolution-backend'], self.writers,\n                                ledger_proof)\n\n    @property\n    def supports_resume(self):\n        # Resume needs the database proof and an opener on both ingress entries.\n        return (self.ledger_proof is not None and self._bound(self.ledger_proof, self.manifest, None, 'prove')\n                and all(self._bound(self.ingress[e], self.manifest, e, 'open') for e in ENTRIES))\n\n    @staticmethod\n    def _bound(binding, manifest, entry, *methods):\n        return (binding is not None and getattr(binding, 'scope', None) == manifest.digest\n                and (entry is None or getattr(binding, 'entry', None) == entry)\n                and all(callable(getattr(binding, method, None)) for method in methods))\n\n    def transport_scope(self):\n        return self.manifest.transport_scope()\n\n    def request(self, argv, *, timeout):\n        try:\n            self._assert_bindings()\n            result = self._dispatch(argv, timeout)\n            self._assert_bindings()\n            return result\n        except Refused as exc:\n            self.refusals = [*self.refusals[-63:], str(exc)]\n            raise\n\n    def _assert_bindings(self):\n        require(isinstance(self.ingress, dict) and set(self.ingress) == set(ENTRIES), 'driver-ingress-binding')\n        for index, entry in enumerate(ENTRIES):\n            require(self.ingress[entry] is self._bindings_fixed[index]\n                    and self._bound(self.ingress[entry], self.manifest, entry, 'observe', 'block'),\n                    'driver-ingress-binding')\n        require(self.writers is self._bindings_fixed[2]\n                and self._bound(self.writers, self.manifest, None, 'observe'), 'driver-writer-binding')\n        require(self.ledger_proof is self._bindings_fixed[3], 'driver-ledger-binding')\n\n    def _dispatch(self, argv, timeout):\n        require(type(timeout) in (int, float) and 0 < timeout <= 30, 'driver-timeout-bound')\n        require(type(argv) is tuple and argv and all(type(a) is str for a in argv), 'driver-operation-forbidden')\n        deadline = time.monotonic() + timeout\n        if argv == ('inspect-host',):\n            return self._inspect_host(deadline)\n        if argv[0] == 'redis-meta':\n            require(len(argv) == 3 and argv[1] in REDIS_COMMANDS\n                    and argv[2] in QUEUE_KEYS + self.manifest.processing_keys, 'driver-redis-scope')\n            return self._redis_meta(argv[1], argv[2], deadline)\n        if argv == ('block-ingress',):\n            return self._block_ingress(deadline)\n        if argv == ('open-ingress',):\n            require(self.supports_resume, 'driver-operation-forbidden')\n            return self._open_ingress(deadline)\n        for kind in (*EFFECTS, *RESUME_EFFECTS):\n            for ident in self.legacy:\n                if argv == host_command(kind, ident):\n                    require(kind in EFFECTS or self.supports_resume, 'driver-operation-forbidden')\n                    return self._effect(kind, ident, argv, deadline)\n        raise Refused('driver-operation-forbidden')\n\n    @staticmethod\n    def _remaining(deadline):\n        remaining = deadline - time.monotonic()\n        if remaining <= 0:\n            raise TimeoutError('driver-timeout')\n        return remaining\n\n    def _run(self, argv, deadline, limit):\n        outcome = None\n        try:\n            result = self.runner(argv, timeout=self._remaining(deadline), max_output=limit)\n        except TimeoutError:\n            outcome = 'timeout'\n        except Refused as exc:\n            outcome = str(exc) if str(exc) in RUNNER_CODES else 'driver-runner-failed'\n        except Exception:\n            outcome = 'driver-runner-failed'\n        if outcome == 'timeout':\n            raise TimeoutError('driver-timeout')\n        require(outcome is None, outcome)\n        require(isinstance(result, tuple) and len(result) == 2 and type(result[0]) is int\n                and type(result[1]) is bytes, 'driver-runner-failed')\n        self._remaining(deadline)\n        self._assert_bindings()\n        require(len(result[1]) <= limit, 'driver-output-oversize')\n        return result\n\n    def _callback(self, binding, method, deadline, entry, code, failed='driver-binding-failed'):\n        require(self._bound(binding, self.manifest, entry, method), code)\n        outcome = None\n        try:\n            value = getattr(binding, method)(self.manifest.digest, timeout=self._remaining(deadline))\n        except TimeoutError:\n            outcome = 'timeout'\n        except Exception:\n            outcome = failed\n        if outcome == 'timeout':\n            raise TimeoutError('driver-timeout')\n        self._remaining(deadline)\n        require(self._bound(binding, self.manifest, entry, method), code)\n        self._assert_bindings()\n        require(outcome is None, outcome)\n        return value\n\n    def _daemon(self, deadline):\n        rc, out = self._run(INFO_ARGV, deadline, LIMITS['info'])\n        require(rc == 0, 'driver-daemon-failed')\n        ok, value = _attempt(_lines, out)\n        require(ok and len(value) == 1 and isinstance(value[0], str) and DAEMON.fullmatch(value[0]),\n                'driver-daemon-malformed')\n        require(value[0] == self.manifest.daemon_id, 'driver-daemon-mismatch')\n\n    def _network(self, deadline):\n        rc, out = self._run(('docker', 'network', 'inspect', '--format', NETWORK_TEMPLATE, self.manifest.network_id),\n                            deadline, LIMITS['network'])\n        require(rc == 0, 'driver-network-failed')\n        ok, value = _attempt(_lines, out)\n        require(ok and len(value) == 1 and isinstance(value[0], list) and len(value[0]) == 2\n                and all(isinstance(v, str) for v in value[0]) and HEX64.fullmatch(value[0][0])\n                and NETWORK_NAME.fullmatch(value[0][1]), 'driver-network-malformed')\n        require(value[0][0] == self.manifest.network_id, 'driver-network-mismatch')\n        return value[0]\n\n    def _ingress(self, deadline):\n        states = {}\n        for entry in ENTRIES:\n            value = self._callback(self.ingress[entry], 'observe', deadline, entry, 'driver-ingress-binding')\n            require(type(value) is str and value in ('blocked', 'open'), 'driver-ingress-shape')\n            states[entry] = value\n        return states\n\n    def _row(self, row, network_name):\n        (ident, image, project, service, revision, status, running, paused, restarting, exit_code, started,\n         health, restarts, policy, mode, gates, mounts, networks) = row\n        labels = [None if value in (None, '') else value for value in (project, service, revision)]\n        require(all(v is None or isinstance(v, str) and len(v) <= 128 for v in labels), 'driver-inspect-labels')\n        require(isinstance(image, str) and IMAGE.fullmatch(image) and type(running) is bool\n                and isinstance(status, str) and status in STATUSES and running == (status == 'running')\n                and paused is False and restarting is False\n                and type(exit_code) is int and 0 <= exit_code <= 255\n                and isinstance(started, str) and STARTED.fullmatch(started)\n                and (health is None or isinstance(health, str) and health in HEALTH)\n                and type(restarts) is int and 0 <= restarts <= 10**6\n                and isinstance(policy, str) and policy in ('always', 'no', '')\n                and isinstance(mode, str) and len(mode) <= 128, 'driver-inspect-state')\n        gates = _tail(gates, 'driver-inspect-gates')\n        names = [g.split('=', 1)[0] if isinstance(g, str) and '=' in g else None for g in gates]\n        require(all(n in self.manifest.gate_names for n in names) and len(set(names)) == len(names)\n                and all(len(g) <= 512 for g in gates), 'driver-inspect-gates')\n        mounts = _tail(mounts, 'driver-inspect-mounts')\n        require(len(mounts) <= 64 and all(\n            isinstance(m, list) and len(m) == 5 and type(m[4]) is bool\n            and all(v is None or isinstance(v, str) and len(v) <= 4096 for v in m[:4]) for m in mounts),\n            'driver-inspect-mounts')\n        networks = _tail(networks, 'driver-inspect-networks')\n        require(len(networks) <= 16 and all(\n            isinstance(n, list) and len(n) == 3 and isinstance(n[0], str) and NETWORK_NAME.fullmatch(n[0])\n            and (n[1] is None or isinstance(n[1], list) and all(isinstance(a, str) for a in n[1]))\n            and isinstance(n[2], str) and HEX64.fullmatch(n[2]) for n in networks)\n            and len({n[0] for n in networks}) == len(networks), 'driver-inspect-networks')\n        require(network_name in {n[0] for n in networks}, 'driver-network-detached')\n        require(any(n[0] == network_name and n[2] == self.manifest.network_id for n in networks),\n                'driver-network-mismatch')\n        # Stable configuration only: attachments by name/ID with configured aliases; IPAM is operational on some engines,\n        # never IP, endpoint, gateway or MAC, which Docker clears on stop.\n        attachments = [[n[0], sorted(n[1] or []), n[2]] for n in sorted(networks, key=lambda n: n[0])]\n        return dict(\n            id=ident, image=image, compose_project=labels[0], compose_service=labels[1], revision=labels[2],\n            started=started, restart_count=restarts, restart_policy=policy or 'no', running=running,\n            exit_code=None if running else exit_code, health=health,\n            gates_digest=digest(['gates', sorted(gates)]),\n            mounts_digest=digest(['mounts', sorted(mounts, key=json.dumps)]),\n            networks_digest=digest(['networks', mode, attachments]))\n\n    def _inspect_host(self, deadline):\n        self.redis_verified = False\n        self._daemon(deadline)\n        network_id, network_name = self._network(deadline)\n        ids = tuple(self.roles)\n        rc, out = self._run(('docker', 'inspect', '--type', 'container', '--format', self.template, *ids),\n                            deadline, LIMITS['inspect'])\n        require(rc == 0, 'driver-inspect-failed')\n        ok, rows = _attempt(_lines, out)\n        require(ok and all(isinstance(r, list) and len(r) == 18 and isinstance(r[0], str) for r in rows),\n                'driver-inspect-malformed')\n        require(len(rows) == len(ids) and {r[0] for r in rows} == set(ids), 'driver-inspect-scope')\n        services, support = {}, {}\n        for row in rows:\n            state, role = self._row(row, network_name), self.roles[row[0]]\n            if role in ROLES:\n                state.pop('health')\n                services[role] = state\n            else:\n                support[role] = {key: state[key] for key in (\n                    'id', 'image', 'compose_project', 'compose_service', 'running', 'restart_policy', 'health',\n                    'networks_digest')}\n        ingress = self._ingress(deadline)\n        writers = self._callback(self.writers, 'observe', deadline, None, 'driver-writer-binding')\n        require(type(writers) is int and 0 <= writers <= 10**6, 'driver-writer-shape')\n        redis = support['redis']\n        self.redis_verified = (redis['compose_project'] == self.manifest.legacy_project\n                               and redis['compose_service'] == 'redis' and redis['running'] is True)\n        return dict(scope_digest=self.manifest.digest,\n                    ingress_blocked=all(v == 'blocked' for v in ingress.values()), unknown_writers=writers,\n                    network_id=network_id, services=services, support=support)\n\n    def _redis_meta(self, command, key, deadline):\n        # Only into the Redis container this driver just verified by label; no auth in argv.\n        require(self.redis_verified, 'driver-redis-unverified')\n        self._daemon(deadline)\n        rc, out = self._run(('docker', 'exec', self.redis_id, 'redis-cli', '--raw', command, key),\n                            deadline, LIMITS['redis'])\n        ok, text = _attempt(bytes.decode, out, 'ascii')\n        require(ok, 'driver-redis-output')\n        require(not text.startswith(('NOAUTH', 'WRONGPASS', 'NOPERM')), 'driver-redis-auth-required')\n        require(rc == 0, 'driver-redis-failed')\n        require(text.endswith('\\n'), 'driver-redis-output')\n        value = text[:-1]\n        if command == 'TYPE':\n            require(value in REDIS_TYPES, 'driver-redis-output')\n            return value\n        require(re.fullmatch('-?[0-9]{1,19}', value), 'driver-redis-output')\n        return int(value)\n\n    def _block_ingress(self, deadline):\n        # Both entries are checked; one blocked entry never stands for the other.\n        for entry, state in self._ingress(deadline).items():\n            if state == 'open':\n                require(self._callback(self.ingress[entry], 'block', deadline, entry,\n                                       'driver-ingress-binding') is True, 'driver-ingress-receipt')\n        require(all(v == 'blocked' for v in self._ingress(deadline).values()), 'driver-ingress-still-open')\n        return True\n\n    def _prove_ledger(self, deadline):\n        # Fresh read-only database proof inside this very request, before its effect.\n        proof = self._callback(self.ledger_proof, 'prove', deadline, None, 'driver-ledger-binding',\n                               'driver-ledger-proof')\n        require(isinstance(proof, dict) and proof.get('scope') == self.manifest.digest\n                and proof.get('read_only') is True and proof.get('ddl_free') is True, 'driver-ledger-proof')\n\n    def _open_ingress(self, deadline):\n        # Internal Evolution->backend first, external last; both must end open.\n        self._prove_ledger(deadline)\n        for entry in reversed(ENTRIES):\n            if self._ingress(deadline)[entry] == 'blocked':\n                require(self._callback(self.ingress[entry], 'open', deadline, entry,\n                                       'driver-ingress-binding') is True, 'driver-ingress-receipt')\n        require(all(v == 'open' for v in self._ingress(deadline).values()), 'driver-ingress-still-blocked')\n        return True\n\n    def _effect(self, kind, ident, argv, deadline):\n        if kind in RESUME_EFFECTS:\n            self._prove_ledger(deadline)\n        self._daemon(deadline)\n        if kind == 'wait':\n            rc, out = self._run(argv, deadline, LIMITS['wait'])\n            ok, text = _attempt(bytes.decode, out, 'ascii')\n            require(ok and rc == 0 and re.fullmatch('[0-9]{1,3}\\n', text), 'driver-wait-receipt')\n            return int(text)\n        rc, out = self._run(argv, deadline, LIMITS['effect'])\n        require(rc == 0 and out == (ident + '\\n').encode(), 'driver-effect-receipt')\n        return True\n\n\nGLOBAL_FLAGS = frozenset({'-H', '--host', '--context', '-c', '--config', '--tls', '--tlsverify', '--tlscacert',\n                          '--tlscert', '--tlskey', '-D', '--debug', '-l', '--log-level'})\nENV = {'LC_ALL': 'C', 'LANG': 'C'}\nABS_PATH = re.compile('/[A-Za-z0-9._/-]{1,255}')\n\n\ndef _absolute(path):\n    return (isinstance(path, str) and ABS_PATH.fullmatch(path) is not None\n            and all(part not in ('', '.', '..') for part in path[1:].split('/')))\n\n\ndef _runner_argv(argv, resume=False):\n    if not (type(argv) is tuple and 2 <= len(argv) <= 32 and argv[0] == 'docker'\n            and all(type(a) is str and 0 < len(a) <= 16384 and '\\x00' not in a for a in argv)):\n        return False\n    if argv == INFO_ARGV:\n        return True\n    if len(argv) == 6 and argv[:5] == ('docker', 'network', 'inspect', '--format', NETWORK_TEMPLATE):\n        return HEX64.fullmatch(argv[5]) is not None\n    if 7 <= len(argv) <= 13 and argv[:6] == (\n            'docker', 'inspect', '--type', 'container', '--format', inspect_template(MANDATORY_GATES)):\n        return all(HEX64.fullmatch(i) for i in argv[6:]) and len(set(argv[6:])) == len(argv[6:])\n    if len(argv) == 7 and argv[:2] == ('docker', 'exec'):\n        return (HEX64.fullmatch(argv[2]) is not None and argv[3:5] == ('redis-cli', '--raw')\n                and argv[5] in REDIS_COMMANDS and (argv[6] in QUEUE_KEYS or PROCESSING.fullmatch(argv[6])))\n    if len(argv) == 4 and argv[:3] in (('docker', 'update', '--restart=no'),\n                                     ('docker', 'kill', '--signal=TERM')):\n        return HEX64.fullmatch(argv[3]) is not None\n    if resume and (len(argv) == 4 and argv[:3] == ('docker', 'update', '--restart=always')\n                   or len(argv) == 3 and argv[:2] == ('docker', 'start')):\n        return HEX64.fullmatch(argv[-1]) is not None\n    return len(argv) == 3 and argv[:2] == ('docker', 'wait') and HEX64.fullmatch(argv[2]) is not None\n\n\nclass PopenRunner:\n    \"\"\"Bounded docker CLI runner for a future authorized operator; never used by tests unmocked.\n\n    The endpoint (``unix://`` socket), docker binary and an operator-provided\n    config directory are explicit; the child gets a minimal environment, so no\n    inherited DOCKER_HOST/DOCKER_CONTEXT/credentials/HOME apply. Only block-A\n    read/containment subcommands are accepted, plus ``start``/``restart=always``\n    by ID only when constructed with ``resume=True``. On timeout, oversize or error it\n    ends only its own CLI process, waits at most ``cleanup_wait`` and never\n    retries; an unreaped CLI is counted, not escalated. Killing the CLI does not\n    undo a request the daemon already received. Compatibility with a real\n    Docker CLI/daemon is unverified here.\n    \"\"\"\n\n    def __init__(self, *, docker_binary, endpoint, config_dir, popen=None, cleanup_wait=2.0, chunk=4096,\n                 resume=False):\n        require(_absolute(docker_binary) and docker_binary.endswith('/docker')\n                and isinstance(endpoint, str) and endpoint.startswith('unix://')\n                and _absolute(endpoint[len('unix://'):]) and endpoint.endswith('.sock')\n                and _absolute(config_dir) and (popen is None or callable(popen))\n                and type(cleanup_wait) in (int, float) and 0 < cleanup_wait <= 10\n                and type(chunk) is int and 0 < chunk <= 65536 and type(resume) is bool, 'runner-config')\n        self.resume = resume\n        self.docker_binary, self.endpoint, self.config_dir = docker_binary, endpoint, config_dir\n        self.popen, self.cleanup_wait, self.chunk = popen, cleanup_wait, chunk\n        self.unreaped = 0\n\n    def _allowed(self, argv):\n        return _runner_argv(argv, self.resume)\n\n    def _env(self):\n        return dict(ENV)\n\n    def __call__(self, argv, *, timeout, max_output):\n        require(self.unreaped == 0, 'runner-pending-cli')\n        require(self._allowed(argv), 'runner-argv')\n        require(type(timeout) in (int, float) and 0 < timeout <= 60\n                and type(max_output) is int and 0 < max_output <= MAX_OUTPUT, 'runner-bounds')\n        deadline = time.monotonic() + timeout\n        popen = self.popen or subprocess.Popen  # resolved per call, never at import/construction\n        command = [self.docker_binary, '--config', self.config_dir, '--host', self.endpoint, *argv[1:]]\n        proc = None\n        try:\n            proc = popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,\n                         env=self._env(), cwd='/', close_fds=True, shell=False, start_new_session=True)\n        except Exception:\n            pass\n        require(proc is not None, 'runner-spawn-failed')\n        outcome = 'runner-failed'\n        try:\n            out = self._read(proc, deadline, max_output)\n            rc = proc.wait(timeout=max(deadline - time.monotonic(), 0))\n            outcome = None\n        except (TimeoutError, subprocess.TimeoutExpired):\n            outcome = 'timeout'\n        except Refused as exc:\n            outcome = str(exc)\n        except Exception:\n            pass\n        except BaseException:\n            self._cleanup(proc)\n            raise\n        finally:\n            try:\n                proc.stdout.close()\n            except Exception:\n                if outcome is None:\n                    outcome = 'runner-close-failed'\n        if outcome is None and time.monotonic() > deadline:\n            outcome = 'timeout'\n        if outcome is not None:\n            self._cleanup(proc)\n            if outcome == 'timeout':\n                raise TimeoutError('runner-timeout')\n            raise Refused(outcome)\n        return rc, out\n\n    def _read(self, proc, deadline, limit):\n        fd, chunks, size = proc.stdout.fileno(), [], 0\n        while True:\n            remaining = deadline - time.monotonic()\n            if remaining <= 0 or not select.select([fd], [], [], remaining)[0]:\n                raise TimeoutError('runner-timeout')\n            chunk = os.read(fd, min(self.chunk, limit + 1 - size))\n            if not chunk:\n                return b''.join(chunks)\n            size += len(chunk)\n            chunks.append(chunk)\n            require(size <= limit, 'runner-output-oversize')\n\n    def _cleanup(self, proc):\n        # Ends only this runner's own CLI child; never a container, never a retry.\n        try:\n            if proc.poll() is None:\n                proc.kill()\n            proc.wait(timeout=self.cleanup_wait)\n        except Exception:\n            self.unreaped += 1\n","numLines":612,"startLine":1,"totalLines":612}},"tool_result_meta":[{"id":"toolu_01L32QamGxenzzwETRtVG2wi","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
