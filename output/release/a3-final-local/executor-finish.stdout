{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E8QSxZ6Zet88RdUYeWo46Z","type":"tool_result","content":"1\t\"\"\"Integrated first transition: real orchestrator, contract, transport, driver, database observer,\n2\tmigration executor, layout writer and candidate port over fixtures only.\n3\t\n4\tSimulated: Docker (legacy + candidate runners), PostgreSQL (DB-API fake), the\n5\tmigration child (fake ``subprocess.run`` behind ProcessRunner) and ingress/writer\n6\tbindings. Git blobs of the pinned SHAs are read once per module, before the\n7\tprocess/network guard is installed; nothing else touches the host.\n8\t\"\"\"\n9\timport json\n10\timport os\n11\tfrom pathlib import Path\n12\timport socket\n13\timport subprocess\n14\timport sys\n15\t\n16\timport pytest\n17\t\n18\tsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\n19\tfrom first_transition_adapter import (APPLICATION_SHA, EXECUTOR_SHA, ROLES, LocalTransition, Refused, digest,\n20\t                                      prepare)\n21\tfrom first_transition_candidate import (CANDIDATE_TEMPLATE, CLOSED_GATES, HOLD_OVERRIDE, ZERO_STARTED,\n22\t                                        CandidatePort, CandidateRunner, CandidateSpec, write_candidate_release)\n23\tfrom first_transition_database import LedgerProof, ReadOnlyDatabase\n24\tfrom first_transition_host_contract import ObservedHostContract\n25\tfrom first_transition_host_driver import INFO_ARGV, ObservedHostDriver\n26\tfrom first_transition_host_transport import ObservedHostTransport, host_command\n27\tfrom first_transition_orchestrator import (FirstTransition, MigrationExecutor, ProcessRunner, assemble,\n28\t                                           load_config, parse_config)\n29\tfrom initial_transition_files import Journal, git_tree\n30\timport package_backend_release\n31\tfrom test_first_transition_database import FakePg\n32\tfrom first_transition_host_driver import ENTRIES\n33\tfrom test_first_transition_host_driver import (DAEMON, LEGACY, NET_NAME, NETWORK, SUPPORT, FakeIngress, FakeWriters,\n34\t                                               Rig)\n35\t\n36\tROOT = Path(__file__).resolve().parents[2]\n37\tPYTHON = '/usr/bin/python3'\n38\tSECRET_URL = 'postgresql://owner:SENTINEL-MIGRATION-SECRET@db.example.invalid/app'\n39\tIMAGE = 'sha256:' + '9' * 64\n40\tCANDIDATE_IDS = {role: ch * 64 for role, ch in zip(ROLES, 'abcd')}\n41\tNAMES = {role: 'release_' + role.replace('-', '_') for role in ROLES}\n42\tEXAMPLE = Path(__file__).resolve().parents[1] / 'first-transition.example.json'\n43\t\n44\t\n45\tclass RecordingGit:\n46\t    \"\"\"Real ``git`` once (module setup), then served from the recording: no process per test.\"\"\"\n47\t\n48\t    def __init__(self):\n49\t        self.answers = {}\n50\t\n51\t    def __call__(self, args):\n52\t        key = tuple(args)\n53\t        if key not in self.answers:\n54\t            done = subprocess.run(['git', '-C', str(ROOT), *args], capture_output=True, timeout=60)\n55\t            assert done.returncode == 0\n56\t            self.answers[key] = done.stdout\n57\t        return self.answers[key]\n58\t\n59\t\n60\t@pytest.fixture(scope='module')\n61\tdef pinned():\n62\t    git = RecordingGit()\n63\t    plan = prepare(ROOT)\n64\t    files = package_backend_release.source_files(ROOT, APPLICATION_SHA, git)\n65\t    package = digest_bytes(package_backend_release.release_manifest(APPLICATION_SHA, files))\n66\t    return plan, git, package\n67\t\n68\t\n69\tdef digest_bytes(data):\n70\t    import hashlib\n71\t    return hashlib.sha256(data).hexdigest()\n72\t\n73\t\n74\t@pytest.fixture(autouse=True)\n75\tdef no_real_processes_or_network(monkeypatch):\n76\t    hits = []\n77\t\n78\t    def forbid(label):\n79\t        def blocked(*_args, **_kwargs):\n80\t            hits.append(label)\n81\t            raise AssertionError('real process/network forbidden: ' + label)\n82\t        return blocked\n83\t    for module, names in ((subprocess, ('Popen', 'run', 'call', 'check_call', 'check_output')),\n84\t                          (os, ('system', 'popen', 'execv', 'execve', 'fork', 'posix_spawn')),\n85\t                          (socket, ('socket', 'create_connection', 'getaddrinfo'))):\n86\t        for name in names:\n87\t            monkeypatch.setattr(module, name, forbid(module.__name__ + '.' + name))\n88\t    yield\n89\t    assert hits == []\n90\t\n91\t\n92\tclass Done:\n93\t    def __init__(self, returncode):\n94\t        self.returncode = returncode\n95\t\n96\t\n97\tclass FakeMigrate:\n98\t    \"\"\"Stands in for ``subprocess.run`` of the pinned migrate.py; applies to FakePg.\"\"\"\n99\t\n100\t    def __init__(self, pg, plan):\n101\t        self.pg, self.plan, self.applied, self.faults, self.argv = pg, plan, [], {}, []\n102\t        self.after = None\n103\t\n104\t    def __call__(self, argv, *, stdin, stdout, stderr, env, cwd, timeout, close_fds, shell, check):\n105\t        assert stdin is stdout is stderr is subprocess.DEVNULL and shell is False and close_fds is True\n106\t        assert argv[:2] == [PYTHON, '-I'] and argv[2] == cwd + '/scripts/migrate.py' and argv[3:4] == ['apply']\n107\t        name = argv[4]\n108\t        migration = next(m for m in self.plan.pending if m.name == name)\n109\t        assert argv[5:] == ['--yes', *(['--no-transaction'] if migration.concurrent else [])]\n110\t        assert Path(argv[2]).read_bytes() == self.plan.executor\n111\t        assert (Path(cwd) / 'migrations' / name).read_bytes() == migration.sql\n112\t        assert sorted(os.listdir(Path(cwd) / 'migrations')) == [name]\n113\t        assert env['MIGRATION_DATABASE_URL'] == SECRET_URL and SECRET_URL not in ' '.join(argv)\n114\t        self.applied.append(name)\n115\t        self.argv.append(argv)\n116\t        mode = self.faults.get(name)\n117\t        if mode == 'timeout':\n118\t            raise subprocess.TimeoutExpired(argv, timeout)\n119\t        if mode == 'fail':\n120\t            return Done(1)\n121\t        if mode == 'exit0-no-ledger':\n122\t            return Done(0)\n123\t        if mode == 'crash':\n124\t            raise KeyboardInterrupt\n125\t        self.pg.ledger.append(name)\n126\t        self.pg.indexes.extend(migration.indexes)\n127\t        if mode == 'invalid-index':\n128\t            self.pg.invalid.append(migration.indexes[0])\n129\t        if self.after:\n130\t            self.after(name)\n131\t        return Done(1 if mode == 'fail-with-ledger' else 0)\n132\t\n133\t\n134\tclass FakeCandidateDocker:\n135\t    \"\"\"Candidate-side Docker CLI answers for exactly the argv CandidatePort builds.\"\"\"\n136\t\n137\t    def __init__(self, spec):\n138\t        self.spec, self.calls, self.containers = spec, [], {}\n139\t        self.gates = [f'{k}={v}' for k, v in CLOSED_GATES.items()]\n140\t        self.hold_applied, self.autostart, self.start_also = True, set(), set()\n141\t        self.smoke = dict(health=200, health_ok=True, ready=200, required_ok=True, ready_status='degraded')\n142\t        self.on_create = self.on_start = None\n143\t        self.starts = 0\n144\t\n145\t    def __call__(self, argv, *, timeout, max_output):\n146\t        assert type(argv) is tuple and 0 < timeout <= 60\n147\t        self.calls.append(argv)\n148\t        spec = self.spec\n149\t        if argv == INFO_ARGV:\n150\t            return 0, (json.dumps(DAEMON) + '\\n').encode()\n151\t        if argv == spec.compose_argv():\n152\t            for role in ROLES:\n153\t                self.containers[CANDIDATE_IDS[role]] = dict(\n154\t                    name=spec.names()[role], service=role, status='created', running=False, started=ZERO_STARTED,\n155\t                    restarts=0, policy='no' if self.hold_applied else 'always', env=list(self.gates))\n156\t            for role in self.autostart:\n157\t                self._run(CANDIDATE_IDS[role])\n158\t            if self.on_create:\n159\t                self.on_create()\n160\t            return 0, b''\n161\t        if argv == spec.ps_argv():\n162\t            return 0, ''.join(i + '\\n' for i in sorted(self.containers)).encode()\n163\t        if argv[:6] == ('docker', 'inspect', '--type', 'container', '--format', CANDIDATE_TEMPLATE):\n164\t            return 0, ''.join(json.dumps(self._render(i)) + '\\n' for i in argv[6:]).encode()\n165\t        if argv[:2] == ('docker', 'start'):\n166\t            self._run(argv[2])\n167\t            for role in self.start_also:\n168\t                self._run(CANDIDATE_IDS[role])\n169\t            if self.on_start:\n170\t                self.on_start()\n171\t            return 0, (argv[2] + '\\n').encode()\n172\t        if argv[:2] == ('docker', 'exec'):\n173\t            assert argv == spec.smoke_argv(CANDIDATE_IDS['backend'])\n174\t            return 0, (json.dumps(self.smoke) + '\\n').encode()\n175\t        raise AssertionError('unexpected candidate argv')\n176\t\n177\t    def _run(self, ident):\n178\t        self.starts += 1\n179\t        self.containers[ident].update(status='running', running=True,\n180\t                                      started='2026-10-30T13:00:%02d.000000001Z' % self.starts)\n181\t\n182\t    def _render(self, ident):\n183\t        c, spec = self.containers[ident], self.spec\n184\t        return ['/' + c['name'], ident, spec.image, spec.project, c['service'], spec.sha, c['status'], c['running'],\n185\t                False, False, 0, c['started'], None, c['restarts'], c['policy'], NET_NAME, [*c['env'], None],\n186\t                [None], [[NET_NAME, [c['service']], spec.network_id], None]]\n187\t\n188\t    def effects(self):\n189\t        return [a for a in self.calls if a[:2] == ('docker', 'start') or a[:2] == ('docker', 'compose')]\n190\t\n191\t\n192\tclass World:\n193\t    def __init__(self, pinned, tmp_path):\n194\t        plan, git, package = pinned\n195\t        self.plan, self.tmp = plan, tmp_path\n196\t        self.pg = FakePg(plan.baseline)\n197\t        self.pg.indexes = []\n198\t        self.rig = Rig()\n199\t        self.expected = self.pg.expectation()\n200\t        self.database = ReadOnlyDatabase(self.pg.connect)\n201\t        self.proof = LedgerProof(self.database, self.expected, scope=self.rig.manifest.digest)\n202\t        self.driver = ObservedHostDriver(self.rig.manifest, runner=self.rig.docker, ingress=self.rig.ingress,\n203\t                                         writers=self.rig.writers, ledger_proof=self.proof)\n204\t        self.transport = ObservedHostTransport(self.driver, **self.rig.manifest.transport_scope())\n205\t        (tmp_path / 'releases').mkdir()\n206\t        (tmp_path / 'work').mkdir()\n207\t        (tmp_path / 'state').mkdir()\n208\t        self.spec = CandidateSpec(\n209\t            sha=APPLICATION_SHA, image=IMAGE, project='pastorai-release', containers=tuple(NAMES.items()),\n210\t            network_id=NETWORK, network_name=NET_NAME, release_root=str(tmp_path / 'releases'),\n211\t            hold_override=str(tmp_path / 'state' / 'a9-hold.override.yml'),\n212\t            env_file='/srv/synthetic-private/backend.conf', daemon_id=DAEMON, smoke_seconds=20)\n213\t        self.cdocker = FakeCandidateDocker(self.spec)\n214\t        self.migrate = FakeMigrate(self.pg, plan)\n215\t        self.layouts = []\n216\t        self.backup = self.receipt()\n217\t        self.git, self.package = git, package\n218\t        self.clock = [0.0]\n219\t        self.journal = None\n220\t\n221\t    def receipt(self):\n222\t        plan = self.plan\n223\t        return dict(plan_digest=plan.digest, source_identity=self.expected.identity,\n224\t                    baseline_digest=self.expected.baseline_digest, restore_verified=True,\n225\t                    clone_rehearsal=dict(migrations_verified=True, clone_identity='8' * 64,\n226\t                                         cluster_global_ddl_possible=True, applied=51, final_ledger=129,\n227\t                                         concurrent=8, final_schema_digest='7' * 64,\n228\t                                         sql_digest=digest([(m.name, m.sha256) for m in plan.pending])))\n229\t\n230\t    def layout(self):\n231\t        self.layouts.append(1)\n232\t        return write_candidate_release(ROOT, self.spec, self.rig.manifest, package_manifest_sha256=self.package,\n233\t                                       migrations=[m.name for m in self.plan.migrations], git=self.git)\n234\t\n235\t    def transition(self, journal=None):\n236\t        self.journal = journal or Journal(self.tmp / 'journal').open()\n237\t        host = ObservedHostContract(self.transport, self.journal)\n238\t        executor = MigrationExecutor(self.plan, python=PYTHON, workdir=str(self.tmp / 'work'),\n239\t                                     secret=lambda: SECRET_URL,\n240\t                                     runner=ProcessRunner(binaries=(PYTHON,), run=self.migrate))\n241\t\n242\t        def sleep(seconds):\n243\t            self.clock[0] += seconds\n244\t        return FirstTransition(plan=self.plan, journal=self.journal, host=host, database=self.database,\n245\t                               expected=self.expected, backup_proof=lambda: self.backup, executor=executor,\n246\t                               layout=self.layout, candidate=CandidatePort(self.spec, runner=self.cdocker),\n247\t                               config_digest='f' * 64, clock=lambda: self.clock[0], sleep=sleep)\n248\t\n249\t    def legacy_effects(self):\n250\t        return self.rig.docker.effects()\n251\t\n252\t    def text(self):\n253\t        return (self.tmp / 'journal' / 'journal.jsonl').read_text()\n254\t\n255\t    def assert_legacy_contained(self):\n256\t        for ident in LEGACY.values():\n257\t            c = self.rig.docker.containers[ident]\n258\t            assert c['State']['Running'] is False and c['RestartPolicy'] == 'no'\n259\t        for ident in SUPPORT.values():\n260\t            c = self.rig.docker.containers[ident]\n261\t            assert c['State']['Running'] is True and c['RestartPolicy'] == 'always'\n262\t        assert all(i.state == 'blocked' for i in self.rig.ingress.values())\n263\t\n264\t    def consumers_held(self):\n265\t        for role in ('queue-worker', 'cron-worker', 'broadcast-worker'):\n266\t            c = self.cdocker.containers[CANDIDATE_IDS[role]]\n267\t            assert (c['status'], c['running'], c['restarts'], c['started'], c['policy']) == (\n268\t                'created', False, 0, ZERO_STARTED, 'no')\n269\t\n270\t\n271\t@pytest.fixture\n272\tdef world(pinned, tmp_path):\n273\t    w = World(pinned, tmp_path)\n274\t    yield w\n275\t    if w.journal is not None:\n276\t        w.journal.close()\n277\t\n278\t\n279\tdef kinds(journal):\n280\t    return [e['kind'] + (':' + e['step'] if 'step' in e else '') for e in journal.events]\n281\t\n282\t\n283\t# --- happy path ---------------------------------------------------------------------------------\n284\t\n285\tdef test_full_a9_sequence_through_real_ports(world):\n286\t    transition = world.transition()\n287\t    result = transition.run()\n288\t    assert result == dict(status='a9-backend-smoked', smoke=dict(health=200, ready=200, ready_status='degraded'),\n289\t                          consumers='held', ingress_blocked=True, legacy_resume_allowed=False,\n290\t                          a10='not-implemented', production_ready=False)\n291\t    j = world.journal\n292\t    order = kinds(j)\n293\t    marker = order.index('ddl-marker')\n294\t    assert order.index('observed-host-contained') < order.index('transition-quiescent') < order.index(\n295\t        'transition-backup') < marker < order.index('transition-intent:migration:' + world.plan.pending[0].name)\n296\t    assert j.last('transition-quiescent')['observations'] == 2 and world.pg.connections >= 4\n297\t    # 51 migrations one by one in plan order, 8 without transaction, exact pinned executor bytes.\n298\t    assert world.migrate.applied == [m.name for m in world.plan.pending]\n299\t    assert sum('--no-transaction' in a for a in world.migrate.argv) == 8\n300\t    assert sorted(world.pg.ledger) == sorted(m.name for m in world.plan.migrations)\n301\t    for m in world.plan.pending:\n302\t        step = 'migration:' + m.name\n303\t        assert order.index('transition-intent:' + step) < order.index('transition-done:' + step)\n304\t    # Legacy contained throughout, never resumed; support untouched; ingress never opened.\n305\t    assert world.legacy_effects() == [host_command(op, LEGACY[role]) for role in ROLES\n306\t                                      for op in ('restart-no', 'term', 'wait')]\n307\t    world.assert_legacy_contained()\n308\t    assert all(i.blocks == 1 for i in world.rig.ingress.values())\n309\t    # A9: one held creation, only backend started, consumers created/never started/restart=no.\n310\t    effects = world.cdocker.effects()\n311\t    assert effects == [world.spec.compose_argv(), ('docker', 'start', CANDIDATE_IDS['backend'])]\n312\t    assert '--no-start' in effects[0] and '--no-deps' in effects[0] and world.spec.hold_override in effects[0]\n313\t    assert Path(world.spec.hold_override).read_text() == HOLD_OVERRIDE\n314\t    world.consumers_held()\n315\t    backend = world.cdocker.containers[CANDIDATE_IDS['backend']]\n316\t    assert backend['running'] and backend['policy'] == 'no' and backend['restarts'] == 0\n317\t    # Layout written under the configured root with the topology contract.\n318\t    release = world.tmp / 'releases' / APPLICATION_SHA / 'deploy'\n319\t    topology = json.loads((release / 'release-topology.json').read_text())\n320\t    assert topology['project'] == 'pastorai-release' and topology['reserved_legacy'] == LEGACY\n321\t    assert topology['network'] == dict(name=NET_NAME, id=NETWORK)\n322\t    assert not (release / '.env').exists()\n323\t    text = world.text()\n324\t    assert 'SENTINEL' not in text and 'postgresql://' not in text\n325\t    assert transition.recovery()['state'] == 'a9-complete'\n326\t\n327\t\n328\tdef test_replay_after_a9_re_proves_and_repeats_no_effect(world):\n329\t    world.transition().run()\n330\t    world.journal.close()\n331\t    effects = (list(world.legacy_effects()), list(world.cdocker.effects()), list(world.migrate.applied))\n332\t    smokes = sum(1 for a in world.cdocker.calls if a[:2] == ('docker', 'exec'))\n333\t    result = world.transition().run()\n334\t    assert result['status'] == 'a9-backend-smoked'\n335\t    assert (world.legacy_effects(), world.cdocker.effects(), world.migrate.applied) == effects\n336\t    assert sum(1 for a in world.cdocker.calls if a[:2] == ('docker', 'exec')) == smokes + 1\n337\t    assert len(world.layouts) == 2  # verified byte for byte, not rewritten\n338\t\n339\t\n340\t# --- pre-DDL refusals ------------------------------------------------------------------------------\n341\t\n342\tdef test_baseline_drift_refuses_before_any_host_effect(world):\n343\t    world.pg.ledger.append(world.plan.pending[0].name)\n344\t    transition = world.transition()\n345\t    with pytest.raises(Refused, match='^database-ledger-drift$'):\n346\t        transition.run()\n347\t    assert world.legacy_effects() == [] and world.migrate.applied == []\n348\t    assert transition.recovery()['state'] == 'not-started'\n349\t\n350\t\n351\t@pytest.mark.parametrize('fault, code', [\n352\t    ('writer', 'database-writing-session'), ('lease', 'database-active-lease'), ('ddl', 'database-ddl-drift'),\n353\t])\n354\tdef test_quiescence_needs_two_consecutive_quiet_observations(world, fault, code):\n355\t    def change():\n356\t        if fault == 'writer':\n357\t            world.pg.writers = 1\n358\t        elif fault == 'lease':\n359\t            world.pg.leases['broadcast_entregas'] = 1\n360\t        else:\n361\t            world.pg.extra_ddl.append('rogue_table')\n362\t    transition = world.transition()\n363\t    original = transition.sleep\n364\t    transition.sleep = lambda seconds: (original(seconds), change())\n365\t    with pytest.raises(Refused, match='^' + code + '$'):\n366\t        transition.run()\n367\t    j = world.journal\n368\t    assert j.last('ddl-marker') is None and j.last('transition-quiescent') is None\n369\t    assert world.migrate.applied == [] and world.cdocker.calls == []\n370\t    recovery = transition.recovery()\n371\t    assert recovery['state'] == 'contained-pre-ddl' and recovery['legacy_resume_allowed'] is True\n372\t\n373\t\n374\tdef test_unbounded_quiescence_is_refused(world):\n375\t    transition = world.transition()\n376\t    transition.t['quiescence_budget_s'] = 3\n377\t    with pytest.raises(Refused, match='^transition-quiescence-unbounded$'):\n378\t        transition.run()\n379\t    assert world.journal.last('ddl-marker') is None\n380\t\n381\t\n382\t@pytest.mark.parametrize('change', [\n383\t    lambda r: r.update(plan_digest='0' * 64), lambda r: r['clone_rehearsal'].update(applied=50),\n384\t    lambda r: r.update(restore_verified=False), lambda r: r.update(source_identity='0' * 64),\n385\t    lambda r: r['clone_rehearsal'].update(clone_identity=None),\n386\t])\n387\tdef test_invalid_backup_proof_refuses_before_the_ddl_marker(world, change):\n388\t    change(world.backup)\n389\t    transition = world.transition()\n390\t    with pytest.raises(Refused, match='^clone-receipt-invalid$'):\n391\t        transition.run()\n392\t    assert world.journal.last('ddl-marker') is None and world.migrate.applied == []\n393\t\n394\t\n395\tdef test_pre_ddl_failure_allows_legacy_resume_with_fresh_ledger_proofs(world):\n396\t    world.backup = None\n397\t    transition = world.transition()\n398\t    with pytest.raises(Refused, match='^clone-receipt-invalid$'):\n399\t        transition.run()\n400\t    proofs = world.pg.connections\n401\t    result = transition.resume_legacy(transition.host.resume_token())\n402\t    assert result['status'] == 'legacy-resumed'\n403\t    assert world.pg.connections - proofs >= 9  # one read-only proof per resume effect, plus observations\n404\t    assert all(i.state == 'open' for i in world.rig.ingress.values())\n405\t    assert transition.recovery()['state'] == 'legacy-resumed'\n406\t    with pytest.raises(Refused, match='^transition-legacy-resume-started$'):\n407\t        transition.run()\n408\t\n409\t\n410\tdef test_missing_injections_fail_closed(world):\n411\t    transition = world.transition()\n412\t    base = dict(plan=world.plan, journal=world.journal, host=transition.host, database=world.database,\n413\t                expected=world.expected, backup_proof=lambda: world.backup, executor=transition.executor,\n414\t                layout=world.layout, candidate=transition.candidate, config_digest='f' * 64)\n415\t    for key in ('host', 'database', 'expected', 'backup_proof', 'executor', 'layout', 'candidate', 'plan'):\n416\t        with pytest.raises(Refused, match='^transition-'):\n417\t            FirstTransition(**{**base, key: None})\n418\t    other = Journal(world.tmp / 'other').open()\n419\t    try:\n420\t        with pytest.raises(Refused, match='^transition-journal$'):\n421\t            FirstTransition(**{**base, 'journal': other})\n422\t    finally:\n423\t        other.close()\n424\t    assert world.legacy_effects() == [] and world.pg.connections == 0\n425\t\n426\t\n427\t# --- DDL failures: first failure stops for good, never the legacy -----------------------------\n428\t\n429\t@pytest.mark.parametrize('mode, code', [\n430\t    ('fail', 'migration-failed'), ('timeout', 'migration-timeout'),\n431\t    ('exit0-no-ledger', 'migration-ambiguous-exit0-no-ledger'),\n432\t    ('fail-with-ledger', 'migration-ambiguous-ledger-without-success'),\n433\t])\n434\tdef test_migration_failure_stops_without_retry_or_legacy_resume(world, mode, code):\n435\t    failing = world.plan.pending[5]\n436\t    world.migrate.faults[failing.name] = mode\n437\t    transition = world.transition()\n438\t    with pytest.raises(Refused, match='^' + code + '$'):\n439\t        transition.run()\n440\t    assert world.migrate.applied == [m.name for m in world.plan.pending[:6]]\n441\t    assert world.journal.last('transition-failed')['legacy_resume_allowed'] is False\n442\t    assert world.cdocker.calls == []\n443\t    with pytest.raises(Refused, match='^transition-stopped$'):\n444\t        transition.run()\n445\t    with pytest.raises(Refused, match='^post-ddl-resume-forbidden$'):\n446\t        transition.resume_legacy(transition.host.resume_token())\n447\t    with pytest.raises(Refused, match='^post-ddl-resume-forbidden$'):\n448\t        transition.host.resume_legacy(transition.host.resume_token())\n449\t    assert world.migrate.applied == [m.name for m in world.plan.pending[:6]]\n450\t    assert not any(a[:2] == ('docker', 'start') for a in world.rig.docker.calls)\n451\t    recovery = transition.recovery()\n452\t    assert recovery['state'] == ('ddl-failed' if mode == 'fail' else 'ddl-ambiguous')\n453\t    assert recovery['legacy_resume_allowed'] is False\n454\t    assert recovery['automatic_undo'] is False and recovery['destructive_retry'] is False\n455\t    world.assert_legacy_contained()\n456\t\n457\t\n458\tdef test_invalid_concurrent_index_stops(world):\n459\t    concurrent = next(m for m in world.plan.pending if m.concurrent)\n460\t    world.migrate.faults[concurrent.name] = 'invalid-index'\n461\t    with pytest.raises(Refused, match='^migration-index-invalid$'):\n462\t        world.transition().run()\n463\t    assert world.migrate.applied[-1] == concurrent.name\n464\t\n465\t\n466\tdef test_controller_killed_after_intent_is_ambiguous_on_replay(world):\n467\t    victim = world.plan.pending[2]\n468\t    world.migrate.faults[victim.name] = 'crash'\n469\t    transition = world.transition()\n470\t    original = world.journal.append\n471\t\n472\t    def append(kind, **fields):\n473\t        if kind == 'transition-failed':\n474\t            raise KeyboardInterrupt  # the controller dies before recording the failure\n475\t        return original(kind, **fields)\n476\t    world.journal.append = append\n477\t    with pytest.raises(KeyboardInterrupt):\n478\t        transition.run()\n479\t    world.journal.close()\n480\t    applied = list(world.migrate.applied)\n481\t    replay = world.transition()\n482\t    with pytest.raises(Refused, match='^migration-outcome-ambiguous$'):\n483\t        replay.run()\n484\t    assert world.migrate.applied == applied\n485\t    recovery = replay.recovery()\n486\t    assert recovery['state'] == 'ddl-ambiguous' and recovery['open_steps'] == ['migration:' + victim.name]\n487\t    with pytest.raises(Refused, match='^post-ddl-resume-forbidden$'):\n488\t        replay.resume_legacy(replay.host.resume_token())\n489\t\n490\t\n491\tdef test_writer_appearing_between_migrations_stops_before_next_ddl(world):\n492\t    first = world.plan.pending[0]\n493\t    world.migrate.after = lambda name: name == first.name and setattr(world.pg, 'writers', 1)\n494\t    with pytest.raises(Refused, match='^database-writing-session$'):\n495\t        world.transition().run()\n496\t    assert world.migrate.applied == [first.name]\n497\t\n498\t\n499\t# --- A9 failures: no undo, consumers held, ingress blocked -------------------------------------\n500\t\n501\t@pytest.mark.parametrize('fault, code', [\n502\t    ('gate', 'candidate-gate-open'), ('restart-always', 'candidate-consumer-not-held'),\n503\t    ('autostart', 'candidate-consumer-not-held'), ('start-dependency', 'candidate-consumer-not-held'),\n504\t    ('smoke-ready', 'candidate-ready-failed'), ('smoke-health', 'candidate-health-failed'),\n505\t    ('ingress-opened', 'observed-host-ingress-reopened'), ('legacy-restarted', 'observed-host-identity-or-support-changed'),\n506\t    ('support-stopped', 'observed-host-effect-failed'),\n507\t])\n508\tdef test_a9_failures_stop_without_undo(world, fault, code):\n509\t    c = world.cdocker\n510\t    if fault == 'gate':\n511\t        c.gates = ['ALLOW_REAL_SENDS=true', *c.gates[1:]]\n512\t    elif fault == 'restart-always':\n513\t        c.hold_applied = False\n514\t    elif fault == 'autostart':\n515\t        c.autostart = {'cron-worker'}\n516\t    elif fault == 'start-dependency':\n517\t        c.start_also = {'queue-worker'}\n518\t    elif fault == 'smoke-ready':\n519\t        c.smoke = dict(c.smoke, ready=503, ready_status='not_ready', required_ok=False)\n520\t    elif fault == 'smoke-health':\n521\t        c.smoke = dict(c.smoke, health=None, health_ok=False, ready=None, ready_status=None, required_ok=False)\n522\t    elif fault == 'ingress-opened':\n523\t        c.on_start = lambda: setattr(world.rig.ingress['evolution-backend'], 'state', 'open')\n524\t    elif fault == 'legacy-restarted':\n525\t        def restart():\n526\t            state = world.rig.docker.containers[LEGACY['cron-worker']]['State']\n527\t            state.update(Status='running', Running=True, StartedAt='2026-10-30T14:00:00.000000001Z')\n528\t        c.on_start = restart\n529\t    else:\n530\t        c.on_create = lambda: world.rig.docker.containers[SUPPORT['redis']]['State'].update(\n531\t            Status='exited', Running=False)\n532\t    transition = world.transition()\n533\t    with pytest.raises(Refused, match='^' + code + '$'):\n534\t        transition.run()\n535\t    assert world.journal.last('transition-failed')['code'] == code\n536\t    assert not any(a[:2] == ('docker', 'start') and a[2] != CANDIDATE_IDS['backend'] for a in c.calls)\n537\t    assert not any(a[1] in ('rm', 'stop', 'kill', 'update', 'restart') for a in c.calls)\n538\t    assert not any(a[:2] == ('docker', 'start') for a in world.rig.docker.calls)\n539\t    recovery = transition.recovery()\n540\t    assert recovery['state'] in ('candidate-failed', 'candidate-ambiguous')\n541\t    assert recovery['legacy_resume_allowed'] is False\n542\t    calls = len(c.calls)\n543\t    with pytest.raises(Refused, match='^transition-stopped$'):\n544\t        transition.run()\n545\t    assert len(c.calls) == calls\n546\t\n547\t\n548\tdef test_a9_refuses_a_non_empty_candidate_project_before_creating(world):\n549\t    world.cdocker.containers['e' * 63 + 'f'] = dict(name='stale', service='backend', status='exited', running=False,\n550\t                                                     started=ZERO_STARTED, restarts=0, policy='no', env=[])\n551\t    with pytest.raises(Refused, match='^candidate-project-not-empty$'):\n552\t        world.transition().run()\n553\t    assert world.cdocker.effects() == []\n554\t\n555\t\n556\tdef test_crash_after_backend_start_intent_is_ambiguous(world):\n557\t    transition = world.transition()\n558\t    world.cdocker.on_start = lambda: (_ for _ in ()).throw(KeyboardInterrupt)\n559\t    original = world.journal.append\n560\t\n561\t    def append(kind, **fields):\n562\t        if kind == 'transition-failed':\n563\t            raise KeyboardInterrupt\n564\t        return original(kind, **fields)\n565\t    world.journal.append = append\n566\t    with pytest.raises(KeyboardInterrupt):\n567\t        transition.run()\n568\t    world.journal.close()\n569\t    world.cdocker.on_start = None\n570\t    replay = world.transition()\n571\t    starts = len(world.cdocker.effects())\n572\t    with pytest.raises(Refused, match='^candidate-start-ambiguous$'):\n573\t        replay.run()\n574\t    assert len(world.cdocker.effects()) == starts\n575\t    assert replay.recovery()['state'] == 'candidate-ambiguous'\n576\t\n577\t\n578\tdef test_layout_is_exclusive_and_package_bound(world):\n579\t    count = world.layout()\n580\t    target = world.tmp / 'releases' / APPLICATION_SHA\n581\t    assert count == len([p for p in target.rglob('*') if p.is_file()]) and world.layout() == count\n582\t    (target / 'deploy' / 'docker-compose.yml').write_text('tampered\\n')\n583\t    with pytest.raises(Refused, match='^layout-mismatch$'):\n584\t        world.layout()\n585\t    assert (target / 'deploy' / 'docker-compose.yml').read_text() == 'tampered\\n'  # never overwritten\n586\t    with pytest.raises(Refused, match='^package-identity-mismatch$'):\n587\t        write_candidate_release(ROOT, world.spec, world.rig.manifest, package_manifest_sha256='0' * 64,\n588\t                                migrations=[m.name for m in world.plan.migrations], git=world.git)\n589\t    with pytest.raises(Refused, match='^layout-migrations-differ-from-plan$'):\n590\t        write_candidate_release(ROOT, world.spec, world.rig.manifest, package_manifest_sha256=world.package,\n591\t                                migrations=[], git=world.git)\n592\t    missing = CandidateSpec(**{**world.spec.__dict__, 'release_root': str(world.tmp / 'absent')})\n593\t    with pytest.raises(Refused, match='^release-root-missing$'):\n594\t        write_candidate_release(ROOT, missing, world.rig.manifest, package_manifest_sha256=world.package,\n595\t                                migrations=[m.name for m in world.plan.migrations], git=world.git)\n596\t    assert not (world.tmp / 'absent').exists()\n597\t\n598\t\n599\t# --- ports, runners and configuration -------------------------------------------------------------\n600\t\n601\tdef test_migration_executor_builds_the_canonical_command_and_isolates_the_secret(world):\n602\t    tx = next(m for m in world.plan.pending if not m.concurrent)\n603\t    nt = next(m for m in world.plan.pending if m.concurrent)\n604\t    assert MigrationExecutor.command(PYTHON, '/w', tx) == (PYTHON, '-I', '/w/scripts/migrate.py', 'apply', tx.name,\n605\t                                                           '--yes')\n606\t    assert MigrationExecutor.command(PYTHON, '/w', nt)[-1] == '--no-transaction'\n607\t    executor = world.transition().executor\n608\t    index = world.plan.pending.index(tx) + 1\n609\t    world.pg.ledger = list(world.plan.baseline)\n610\t    assert executor.apply(index, tx) == 0\n611\t    with pytest.raises(Refused, match='^migration-workdir-exists$'):\n612\t        executor.apply(index, tx)\n613\t    with pytest.raises(Refused, match='^migration-not-pending$'):\n614\t        executor.apply(index, nt)\n615\t    with pytest.raises(Refused, match='^migration-plan$'):\n616\t        MigrationExecutor(object(), python=PYTHON, workdir='/w', secret=lambda: SECRET_URL, runner=lambda *a: 0)\n617\t\n618\t\n619\t@pytest.mark.parametrize('argv, env', [\n620\t    (('/usr/bin/sh', '-c', 'x'), {}), ((PYTHON, 'x'), {'HOME': '/root'}), ((PYTHON, 'a\\x00b'), {}),\n621\t    ([PYTHON, 'x'], {}),\n622\t])\n623\tdef test_process_runner_refuses_unlisted_binary_env_or_shape_before_spawn(argv, env):\n624\t    calls = []\n625\t    runner = ProcessRunner(binaries=(PYTHON,), run=lambda *a, **k: calls.append(1))\n626\t    with pytest.raises(Refused, match='^process-'):\n627\t        runner(argv, env=env, cwd='/w', timeout=5)\n628\t    assert calls == []\n629\t\n630\t\n631\tdef test_process_runner_sanitizes_spawn_failure():\n632\t    def explode(*_a, **_k):\n633\t        raise OSError(SECRET_URL)\n634\t    with pytest.raises(Refused, match='^process-spawn-failed$') as raised:\n635\t        ProcessRunner(binaries=(PYTHON,), run=explode)((PYTHON, 'x'), env={}, cwd='/w', timeout=5)\n636\t    assert 'SENTINEL' not in repr(raised.value) and raised.value.__cause__ is None\n637\t\n638\t\n639\t@pytest.mark.parametrize('argv', [\n640\t    ('docker', 'compose', 'up', '-d'), ('docker', 'start', 'x'), ('docker', 'rm', 'a' * 64),\n641\t    ('docker', 'exec', 'a' * 64, 'sh', '-c', 'x'), ('docker', 'update', '--restart=always', 'a' * 64),\n642\t    ('docker', 'compose', '--project-name', 'pastorai-release', 'start'),\n643\t])\n644\tdef test_candidate_runner_allows_only_the_ports_own_argv(world, argv):\n645\t    from test_first_transition_host_driver import FakePopen, FakeProc\n646\t    popen = FakePopen(FakeProc())\n647\t    runner = CandidateRunner(world.spec, docker_binary='/usr/bin/docker', endpoint='unix:///run/x/docker.sock',\n648\t                             config_dir='/etc/synthetic-docker', popen=popen)\n649\t    with pytest.raises(Refused, match='^runner-argv$'):\n650\t        runner(argv, timeout=5, max_output=64)\n651\t    assert popen.calls == []\n652\t    runner(world.spec.compose_argv(), timeout=5, max_output=64)\n653\t    env = popen.calls[0][1]['env']\n654\t    assert env['PASTORAI_ENV_FILE'] == world.spec.env_file and set(env) == {'LC_ALL', 'LANG', 'PASTORAI_ENV_FILE'}\n655\t\n656\t\n657\tdef test_example_config_is_sanitized_and_assembles_without_contacting_anything(world):\n658\t    config = load_config(EXAMPLE)\n659\t    assert config.candidate.release_root == '/opt/pastorai-releases'\n660\t    raw = json.loads(EXAMPLE.read_text())\n661\t    for forbidden in ('password', 'postgresql://', 'token', 'secret', 'key='):\n662\t        assert forbidden not in EXAMPLE.read_text().lower()\n663\t    with pytest.raises(Refused, match='^config-keys$'):\n664\t        parse_config({**raw, 'database_url': 'postgresql://x'})\n665\t    with pytest.raises(Refused, match='^config-candidate-sha$'):\n666\t        parse_config({**raw, 'candidate': {**raw['candidate'], 'sha': 'a' * 40}})\n667\t    journal = Journal(world.tmp / 'assembled').open()\n668\t    touched = []\n669\t    ingress = {entry: FakeIngress(config.manifest.digest, entry) for entry in ENTRIES}\n670\t    try:\n671\t        common = dict(plan=world.plan, journal=journal, secret=lambda: touched.append('secret'),\n672\t                      ingress=ingress, writers=FakeWriters(config.manifest.digest),\n673\t                      backup_proof=lambda: touched.append('backup'), popen=lambda *a, **k: touched.append('popen'),\n674\t                      run=lambda *a, **k: touched.append('run'))\n675\t        with pytest.raises(Refused, match='^transition-database-missing$'):\n676\t            assemble(config, connect=None, **common)\n677\t        # Example IDs are not this plan's baseline expectation, yet assembling contacts nothing.\n678\t        transition = assemble(config, connect=lambda **k: touched.append('connect'), **common)\n679\t        assert isinstance(transition, FirstTransition) and touched == []\n680\t        assert transition.host.port.driver.supports_resume is True and touched == []\n681\t        for binding in ingress.values():\n682\t            binding.open = None  # without openers the same assembly cannot resume\n683\t        assert transition.host.port.driver.supports_resume is False\n684\t    finally:\n685\t        journal.close()\n686\t\n687\t\n688\tdef test_observed_orchestrator_journal_stays_out_of_the_local_adapter(world):\n689\t    world.backup = None\n690\t    with pytest.raises(Refused):\n691\t        world.transition().run()\n692\t\n693\t    class Database:\n694\t        identity = 'x'\n695\t    with pytest.raises(Refused, match='^local-transition-observed-journal$'):\n696\t        LocalTransition(world.plan, Database(), world.journal)\n697\t\n698\t\n699\tdef test_partial_containment_is_classified_and_never_resumable(world):\n700\t    world.rig.docker.term_exit[LEGACY['cron-worker']] = 143\n701\t    transition = world.transition()\n702\t    with pytest.raises(Refused, match='^observed-host-'):\n703\t        transition.run()\n704\t    recovery = transition.recovery()\n705\t    assert recovery['state'] == 'containment-partial' and recovery['legacy_resume_allowed'] is False\n706\t    with pytest.raises(Refused, match='^observed-host-not-contained$'):\n707\t        transition.resume_legacy(transition.host.resume_token())\n708\t    assert EXECUTOR_SHA and world.migrate.applied == []\n709\t\n710\t\n711\tdef test_failed_concurrent_migration_is_never_classified_as_definite(world):\n712\t    concurrent = next(m for m in world.plan.pending if m.concurrent)\n713\t    world.migrate.faults[concurrent.name] = 'fail'\n714\t    transition = world.transition()\n715\t    with pytest.raises(Refused, match='^migration-failed$'):\n716\t        transition.run()\n717\t    outcome = world.journal.last('transition-migration-failed')\n718\t    assert outcome['definite'] is False and outcome['step'] == 'migration:' + concurrent.name\n719\t    assert transition.recovery()['state'] == 'ddl-ambiguous'\n720\t"}]},"parent_tool_use_id":null,"session_id":"b7c0715d-1aa9-47c4-a1be-b9d449b8e96c","uuid":"0da3e9c7-d077-42b8-8ca4-260dd53e14e3","timestamp":"2026-10-30T15:30:03.196Z","tool_use_result":{"type":"text","file":{"filePath":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/tests/test_first_transition_orchestrator.py","content":"\"\"\"Integrated first transition: real orchestrator, contract, transport, driver, database observer,\nmigration executor, layout writer and candidate port over fixtures only.\n\nSimulated: Docker (legacy + candidate runners), PostgreSQL (DB-API fake), the\nmigration child (fake ``subprocess.run`` behind ProcessRunner) and ingress/writer\nbindings. Git blobs of the pinned SHAs are read once per module, before the\nprocess/network guard is installed; nothing else touches the host.\n\"\"\"\nimport json\nimport os\nfrom pathlib import Path\nimport socket\nimport subprocess\nimport sys\n\nimport pytest\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\nfrom first_transition_adapter import (APPLICATION_SHA, EXECUTOR_SHA, ROLES, LocalTransition, Refused, digest,\n                                      prepare)\nfrom first_transition_candidate import (CANDIDATE_TEMPLATE, CLOSED_GATES, HOLD_OVERRIDE, ZERO_STARTED,\n                                        CandidatePort, CandidateRunner, CandidateSpec, write_candidate_release)\nfrom first_transition_database import LedgerProof, ReadOnlyDatabase\nfrom first_transition_host_contract import ObservedHostContract\nfrom first_transition_host_driver import INFO_ARGV, ObservedHostDriver\nfrom first_transition_host_transport import ObservedHostTransport, host_command\nfrom first_transition_orchestrator import (FirstTransition, MigrationExecutor, ProcessRunner, assemble,\n                                           load_config, parse_config)\nfrom initial_transition_files import Journal, git_tree\nimport package_backend_release\nfrom test_first_transition_database import FakePg\nfrom first_transition_host_driver import ENTRIES\nfrom test_first_transition_host_driver import (DAEMON, LEGACY, NET_NAME, NETWORK, SUPPORT, FakeIngress, FakeWriters,\n                                               Rig)\n\nROOT = Path(__file__).resolve().parents[2]\nPYTHON = '/usr/bin/python3'\nSECRET_URL = 'postgresql://owner:SENTINEL-MIGRATION-SECRET@db.example.invalid/app'\nIMAGE = 'sha256:' + '9' * 64\nCANDIDATE_IDS = {role: ch * 64 for role, ch in zip(ROLES, 'abcd')}\nNAMES = {role: 'release_' + role.replace('-', '_') for role in ROLES}\nEXAMPLE = Path(__file__).resolve().parents[1] / 'first-transition.example.json'\n\n\nclass RecordingGit:\n    \"\"\"Real ``git`` once (module setup), then served from the recording: no process per test.\"\"\"\n\n    def __init__(self):\n        self.answers = {}\n\n    def __call__(self, args):\n        key = tuple(args)\n        if key not in self.answers:\n            done = subprocess.run(['git', '-C', str(ROOT), *args], capture_output=True, timeout=60)\n            assert done.returncode == 0\n            self.answers[key] = done.stdout\n        return self.answers[key]\n\n\n@pytest.fixture(scope='module')\ndef pinned():\n    git = RecordingGit()\n    plan = prepare(ROOT)\n    files = package_backend_release.source_files(ROOT, APPLICATION_SHA, git)\n    package = digest_bytes(package_backend_release.release_manifest(APPLICATION_SHA, files))\n    return plan, git, package\n\n\ndef digest_bytes(data):\n    import hashlib\n    return hashlib.sha256(data).hexdigest()\n\n\n@pytest.fixture(autouse=True)\ndef no_real_processes_or_network(monkeypatch):\n    hits = []\n\n    def forbid(label):\n        def blocked(*_args, **_kwargs):\n            hits.append(label)\n            raise AssertionError('real process/network forbidden: ' + label)\n        return blocked\n    for module, names in ((subprocess, ('Popen', 'run', 'call', 'check_call', 'check_output')),\n                          (os, ('system', 'popen', 'execv', 'execve', 'fork', 'posix_spawn')),\n                          (socket, ('socket', 'create_connection', 'getaddrinfo'))):\n        for name in names:\n            monkeypatch.setattr(module, name, forbid(module.__name__ + '.' + name))\n    yield\n    assert hits == []\n\n\nclass Done:\n    def __init__(self, returncode):\n        self.returncode = returncode\n\n\nclass FakeMigrate:\n    \"\"\"Stands in for ``subprocess.run`` of the pinned migrate.py; applies to FakePg.\"\"\"\n\n    def __init__(self, pg, plan):\n        self.pg, self.plan, self.applied, self.faults, self.argv = pg, plan, [], {}, []\n        self.after = None\n\n    def __call__(self, argv, *, stdin, stdout, stderr, env, cwd, timeout, close_fds, shell, check):\n        assert stdin is stdout is stderr is subprocess.DEVNULL and shell is False and close_fds is True\n        assert argv[:2] == [PYTHON, '-I'] and argv[2] == cwd + '/scripts/migrate.py' and argv[3:4] == ['apply']\n        name = argv[4]\n        migration = next(m for m in self.plan.pending if m.name == name)\n        assert argv[5:] == ['--yes', *(['--no-transaction'] if migration.concurrent else [])]\n        assert Path(argv[2]).read_bytes() == self.plan.executor\n        assert (Path(cwd) / 'migrations' / name).read_bytes() == migration.sql\n        assert sorted(os.listdir(Path(cwd) / 'migrations')) == [name]\n        assert env['MIGRATION_DATABASE_URL'] == SECRET_URL and SECRET_URL not in ' '.join(argv)\n        self.applied.append(name)\n        self.argv.append(argv)\n        mode = self.faults.get(name)\n        if mode == 'timeout':\n            raise subprocess.TimeoutExpired(argv, timeout)\n        if mode == 'fail':\n            return Done(1)\n        if mode == 'exit0-no-ledger':\n            return Done(0)\n        if mode == 'crash':\n            raise KeyboardInterrupt\n        self.pg.ledger.append(name)\n        self.pg.indexes.extend(migration.indexes)\n        if mode == 'invalid-index':\n            self.pg.invalid.append(migration.indexes[0])\n        if self.after:\n            self.after(name)\n        return Done(1 if mode == 'fail-with-ledger' else 0)\n\n\nclass FakeCandidateDocker:\n    \"\"\"Candidate-side Docker CLI answers for exactly the argv CandidatePort builds.\"\"\"\n\n    def __init__(self, spec):\n        self.spec, self.calls, self.containers = spec, [], {}\n        self.gates = [f'{k}={v}' for k, v in CLOSED_GATES.items()]\n        self.hold_applied, self.autostart, self.start_also = True, set(), set()\n        self.smoke = dict(health=200, health_ok=True, ready=200, required_ok=True, ready_status='degraded')\n        self.on_create = self.on_start = None\n        self.starts = 0\n\n    def __call__(self, argv, *, timeout, max_output):\n        assert type(argv) is tuple and 0 < timeout <= 60\n        self.calls.append(argv)\n        spec = self.spec\n        if argv == INFO_ARGV:\n            return 0, (json.dumps(DAEMON) + '\\n').encode()\n        if argv == spec.compose_argv():\n            for role in ROLES:\n                self.containers[CANDIDATE_IDS[role]] = dict(\n                    name=spec.names()[role], service=role, status='created', running=False, started=ZERO_STARTED,\n                    restarts=0, policy='no' if self.hold_applied else 'always', env=list(self.gates))\n            for role in self.autostart:\n                self._run(CANDIDATE_IDS[role])\n            if self.on_create:\n                self.on_create()\n            return 0, b''\n        if argv == spec.ps_argv():\n            return 0, ''.join(i + '\\n' for i in sorted(self.containers)).encode()\n        if argv[:6] == ('docker', 'inspect', '--type', 'container', '--format', CANDIDATE_TEMPLATE):\n            return 0, ''.join(json.dumps(self._render(i)) + '\\n' for i in argv[6:]).encode()\n        if argv[:2] == ('docker', 'start'):\n            self._run(argv[2])\n            for role in self.start_also:\n                self._run(CANDIDATE_IDS[role])\n            if self.on_start:\n                self.on_start()\n            return 0, (argv[2] + '\\n').encode()\n        if argv[:2] == ('docker', 'exec'):\n            assert argv == spec.smoke_argv(CANDIDATE_IDS['backend'])\n            return 0, (json.dumps(self.smoke) + '\\n').encode()\n        raise AssertionError('unexpected candidate argv')\n\n    def _run(self, ident):\n        self.starts += 1\n        self.containers[ident].update(status='running', running=True,\n                                      started='2026-10-30T13:00:%02d.000000001Z' % self.starts)\n\n    def _render(self, ident):\n        c, spec = self.containers[ident], self.spec\n        return ['/' + c['name'], ident, spec.image, spec.project, c['service'], spec.sha, c['status'], c['running'],\n                False, False, 0, c['started'], None, c['restarts'], c['policy'], NET_NAME, [*c['env'], None],\n                [None], [[NET_NAME, [c['service']], spec.network_id], None]]\n\n    def effects(self):\n        return [a for a in self.calls if a[:2] == ('docker', 'start') or a[:2] == ('docker', 'compose')]\n\n\nclass World:\n    def __init__(self, pinned, tmp_path):\n        plan, git, package = pinned\n        self.plan, self.tmp = plan, tmp_path\n        self.pg = FakePg(plan.baseline)\n        self.pg.indexes = []\n        self.rig = Rig()\n        self.expected = self.pg.expectation()\n        self.database = ReadOnlyDatabase(self.pg.connect)\n        self.proof = LedgerProof(self.database, self.expected, scope=self.rig.manifest.digest)\n        self.driver = ObservedHostDriver(self.rig.manifest, runner=self.rig.docker, ingress=self.rig.ingress,\n                                         writers=self.rig.writers, ledger_proof=self.proof)\n        self.transport = ObservedHostTransport(self.driver, **self.rig.manifest.transport_scope())\n        (tmp_path / 'releases').mkdir()\n        (tmp_path / 'work').mkdir()\n        (tmp_path / 'state').mkdir()\n        self.spec = CandidateSpec(\n            sha=APPLICATION_SHA, image=IMAGE, project='pastorai-release', containers=tuple(NAMES.items()),\n            network_id=NETWORK, network_name=NET_NAME, release_root=str(tmp_path / 'releases'),\n            hold_override=str(tmp_path / 'state' / 'a9-hold.override.yml'),\n            env_file='/srv/synthetic-private/backend.conf', daemon_id=DAEMON, smoke_seconds=20)\n        self.cdocker = FakeCandidateDocker(self.spec)\n        self.migrate = FakeMigrate(self.pg, plan)\n        self.layouts = []\n        self.backup = self.receipt()\n        self.git, self.package = git, package\n        self.clock = [0.0]\n        self.journal = None\n\n    def receipt(self):\n        plan = self.plan\n        return dict(plan_digest=plan.digest, source_identity=self.expected.identity,\n                    baseline_digest=self.expected.baseline_digest, restore_verified=True,\n                    clone_rehearsal=dict(migrations_verified=True, clone_identity='8' * 64,\n                                         cluster_global_ddl_possible=True, applied=51, final_ledger=129,\n                                         concurrent=8, final_schema_digest='7' * 64,\n                                         sql_digest=digest([(m.name, m.sha256) for m in plan.pending])))\n\n    def layout(self):\n        self.layouts.append(1)\n        return write_candidate_release(ROOT, self.spec, self.rig.manifest, package_manifest_sha256=self.package,\n                                       migrations=[m.name for m in self.plan.migrations], git=self.git)\n\n    def transition(self, journal=None):\n        self.journal = journal or Journal(self.tmp / 'journal').open()\n        host = ObservedHostContract(self.transport, self.journal)\n        executor = MigrationExecutor(self.plan, python=PYTHON, workdir=str(self.tmp / 'work'),\n                                     secret=lambda: SECRET_URL,\n                                     runner=ProcessRunner(binaries=(PYTHON,), run=self.migrate))\n\n        def sleep(seconds):\n            self.clock[0] += seconds\n        return FirstTransition(plan=self.plan, journal=self.journal, host=host, database=self.database,\n                               expected=self.expected, backup_proof=lambda: self.backup, executor=executor,\n                               layout=self.layout, candidate=CandidatePort(self.spec, runner=self.cdocker),\n                               config_digest='f' * 64, clock=lambda: self.clock[0], sleep=sleep)\n\n    def legacy_effects(self):\n        return self.rig.docker.effects()\n\n    def text(self):\n        return (self.tmp / 'journal' / 'journal.jsonl').read_text()\n\n    def assert_legacy_contained(self):\n        for ident in LEGACY.values():\n            c = self.rig.docker.containers[ident]\n            assert c['State']['Running'] is False and c['RestartPolicy'] == 'no'\n        for ident in SUPPORT.values():\n            c = self.rig.docker.containers[ident]\n            assert c['State']['Running'] is True and c['RestartPolicy'] == 'always'\n        assert all(i.state == 'blocked' for i in self.rig.ingress.values())\n\n    def consumers_held(self):\n        for role in ('queue-worker', 'cron-worker', 'broadcast-worker'):\n            c = self.cdocker.containers[CANDIDATE_IDS[role]]\n            assert (c['status'], c['running'], c['restarts'], c['started'], c['policy']) == (\n                'created', False, 0, ZERO_STARTED, 'no')\n\n\n@pytest.fixture\ndef world(pinned, tmp_path):\n    w = World(pinned, tmp_path)\n    yield w\n    if w.journal is not None:\n        w.journal.close()\n\n\ndef kinds(journal):\n    return [e['kind'] + (':' + e['step'] if 'step' in e else '') for e in journal.events]\n\n\n# --- happy path ---------------------------------------------------------------------------------\n\ndef test_full_a9_sequence_through_real_ports(world):\n    transition = world.transition()\n    result = transition.run()\n    assert result == dict(status='a9-backend-smoked', smoke=dict(health=200, ready=200, ready_status='degraded'),\n                          consumers='held', ingress_blocked=True, legacy_resume_allowed=False,\n                          a10='not-implemented', production_ready=False)\n    j = world.journal\n    order = kinds(j)\n    marker = order.index('ddl-marker')\n    assert order.index('observed-host-contained') < order.index('transition-quiescent') < order.index(\n        'transition-backup') < marker < order.index('transition-intent:migration:' + world.plan.pending[0].name)\n    assert j.last('transition-quiescent')['observations'] == 2 and world.pg.connections >= 4\n    # 51 migrations one by one in plan order, 8 without transaction, exact pinned executor bytes.\n    assert world.migrate.applied == [m.name for m in world.plan.pending]\n    assert sum('--no-transaction' in a for a in world.migrate.argv) == 8\n    assert sorted(world.pg.ledger) == sorted(m.name for m in world.plan.migrations)\n    for m in world.plan.pending:\n        step = 'migration:' + m.name\n        assert order.index('transition-intent:' + step) < order.index('transition-done:' + step)\n    # Legacy contained throughout, never resumed; support untouched; ingress never opened.\n    assert world.legacy_effects() == [host_command(op, LEGACY[role]) for role in ROLES\n                                      for op in ('restart-no', 'term', 'wait')]\n    world.assert_legacy_contained()\n    assert all(i.blocks == 1 for i in world.rig.ingress.values())\n    # A9: one held creation, only backend started, consumers created/never started/restart=no.\n    effects = world.cdocker.effects()\n    assert effects == [world.spec.compose_argv(), ('docker', 'start', CANDIDATE_IDS['backend'])]\n    assert '--no-start' in effects[0] and '--no-deps' in effects[0] and world.spec.hold_override in effects[0]\n    assert Path(world.spec.hold_override).read_text() == HOLD_OVERRIDE\n    world.consumers_held()\n    backend = world.cdocker.containers[CANDIDATE_IDS['backend']]\n    assert backend['running'] and backend['policy'] == 'no' and backend['restarts'] == 0\n    # Layout written under the configured root with the topology contract.\n    release = world.tmp / 'releases' / APPLICATION_SHA / 'deploy'\n    topology = json.loads((release / 'release-topology.json').read_text())\n    assert topology['project'] == 'pastorai-release' and topology['reserved_legacy'] == LEGACY\n    assert topology['network'] == dict(name=NET_NAME, id=NETWORK)\n    assert not (release / '.env').exists()\n    text = world.text()\n    assert 'SENTINEL' not in text and 'postgresql://' not in text\n    assert transition.recovery()['state'] == 'a9-complete'\n\n\ndef test_replay_after_a9_re_proves_and_repeats_no_effect(world):\n    world.transition().run()\n    world.journal.close()\n    effects = (list(world.legacy_effects()), list(world.cdocker.effects()), list(world.migrate.applied))\n    smokes = sum(1 for a in world.cdocker.calls if a[:2] == ('docker', 'exec'))\n    result = world.transition().run()\n    assert result['status'] == 'a9-backend-smoked'\n    assert (world.legacy_effects(), world.cdocker.effects(), world.migrate.applied) == effects\n    assert sum(1 for a in world.cdocker.calls if a[:2] == ('docker', 'exec')) == smokes + 1\n    assert len(world.layouts) == 2  # verified byte for byte, not rewritten\n\n\n# --- pre-DDL refusals ------------------------------------------------------------------------------\n\ndef test_baseline_drift_refuses_before_any_host_effect(world):\n    world.pg.ledger.append(world.plan.pending[0].name)\n    transition = world.transition()\n    with pytest.raises(Refused, match='^database-ledger-drift$'):\n        transition.run()\n    assert world.legacy_effects() == [] and world.migrate.applied == []\n    assert transition.recovery()['state'] == 'not-started'\n\n\n@pytest.mark.parametrize('fault, code', [\n    ('writer', 'database-writing-session'), ('lease', 'database-active-lease'), ('ddl', 'database-ddl-drift'),\n])\ndef test_quiescence_needs_two_consecutive_quiet_observations(world, fault, code):\n    def change():\n        if fault == 'writer':\n            world.pg.writers = 1\n        elif fault == 'lease':\n            world.pg.leases['broadcast_entregas'] = 1\n        else:\n            world.pg.extra_ddl.append('rogue_table')\n    transition = world.transition()\n    original = transition.sleep\n    transition.sleep = lambda seconds: (original(seconds), change())\n    with pytest.raises(Refused, match='^' + code + '$'):\n        transition.run()\n    j = world.journal\n    assert j.last('ddl-marker') is None and j.last('transition-quiescent') is None\n    assert world.migrate.applied == [] and world.cdocker.calls == []\n    recovery = transition.recovery()\n    assert recovery['state'] == 'contained-pre-ddl' and recovery['legacy_resume_allowed'] is True\n\n\ndef test_unbounded_quiescence_is_refused(world):\n    transition = world.transition()\n    transition.t['quiescence_budget_s'] = 3\n    with pytest.raises(Refused, match='^transition-quiescence-unbounded$'):\n        transition.run()\n    assert world.journal.last('ddl-marker') is None\n\n\n@pytest.mark.parametrize('change', [\n    lambda r: r.update(plan_digest='0' * 64), lambda r: r['clone_rehearsal'].update(applied=50),\n    lambda r: r.update(restore_verified=False), lambda r: r.update(source_identity='0' * 64),\n    lambda r: r['clone_rehearsal'].update(clone_identity=None),\n])\ndef test_invalid_backup_proof_refuses_before_the_ddl_marker(world, change):\n    change(world.backup)\n    transition = world.transition()\n    with pytest.raises(Refused, match='^clone-receipt-invalid$'):\n        transition.run()\n    assert world.journal.last('ddl-marker') is None and world.migrate.applied == []\n\n\ndef test_pre_ddl_failure_allows_legacy_resume_with_fresh_ledger_proofs(world):\n    world.backup = None\n    transition = world.transition()\n    with pytest.raises(Refused, match='^clone-receipt-invalid$'):\n        transition.run()\n    proofs = world.pg.connections\n    result = transition.resume_legacy(transition.host.resume_token())\n    assert result['status'] == 'legacy-resumed'\n    assert world.pg.connections - proofs >= 9  # one read-only proof per resume effect, plus observations\n    assert all(i.state == 'open' for i in world.rig.ingress.values())\n    assert transition.recovery()['state'] == 'legacy-resumed'\n    with pytest.raises(Refused, match='^transition-legacy-resume-started$'):\n        transition.run()\n\n\ndef test_missing_injections_fail_closed(world):\n    transition = world.transition()\n    base = dict(plan=world.plan, journal=world.journal, host=transition.host, database=world.database,\n                expected=world.expected, backup_proof=lambda: world.backup, executor=transition.executor,\n                layout=world.layout, candidate=transition.candidate, config_digest='f' * 64)\n    for key in ('host', 'database', 'expected', 'backup_proof', 'executor', 'layout', 'candidate', 'plan'):\n        with pytest.raises(Refused, match='^transition-'):\n            FirstTransition(**{**base, key: None})\n    other = Journal(world.tmp / 'other').open()\n    try:\n        with pytest.raises(Refused, match='^transition-journal$'):\n            FirstTransition(**{**base, 'journal': other})\n    finally:\n        other.close()\n    assert world.legacy_effects() == [] and world.pg.connections == 0\n\n\n# --- DDL failures: first failure stops for good, never the legacy -----------------------------\n\n@pytest.mark.parametrize('mode, code', [\n    ('fail', 'migration-failed'), ('timeout', 'migration-timeout'),\n    ('exit0-no-ledger', 'migration-ambiguous-exit0-no-ledger'),\n    ('fail-with-ledger', 'migration-ambiguous-ledger-without-success'),\n])\ndef test_migration_failure_stops_without_retry_or_legacy_resume(world, mode, code):\n    failing = world.plan.pending[5]\n    world.migrate.faults[failing.name] = mode\n    transition = world.transition()\n    with pytest.raises(Refused, match='^' + code + '$'):\n        transition.run()\n    assert world.migrate.applied == [m.name for m in world.plan.pending[:6]]\n    assert world.journal.last('transition-failed')['legacy_resume_allowed'] is False\n    assert world.cdocker.calls == []\n    with pytest.raises(Refused, match='^transition-stopped$'):\n        transition.run()\n    with pytest.raises(Refused, match='^post-ddl-resume-forbidden$'):\n        transition.resume_legacy(transition.host.resume_token())\n    with pytest.raises(Refused, match='^post-ddl-resume-forbidden$'):\n        transition.host.resume_legacy(transition.host.resume_token())\n    assert world.migrate.applied == [m.name for m in world.plan.pending[:6]]\n    assert not any(a[:2] == ('docker', 'start') for a in world.rig.docker.calls)\n    recovery = transition.recovery()\n    assert recovery['state'] == ('ddl-failed' if mode == 'fail' else 'ddl-ambiguous')\n    assert recovery['legacy_resume_allowed'] is False\n    assert recovery['automatic_undo'] is False and recovery['destructive_retry'] is False\n    world.assert_legacy_contained()\n\n\ndef test_invalid_concurrent_index_stops(world):\n    concurrent = next(m for m in world.plan.pending if m.concurrent)\n    world.migrate.faults[concurrent.name] = 'invalid-index'\n    with pytest.raises(Refused, match='^migration-index-invalid$'):\n        world.transition().run()\n    assert world.migrate.applied[-1] == concurrent.name\n\n\ndef test_controller_killed_after_intent_is_ambiguous_on_replay(world):\n    victim = world.plan.pending[2]\n    world.migrate.faults[victim.name] = 'crash'\n    transition = world.transition()\n    original = world.journal.append\n\n    def append(kind, **fields):\n        if kind == 'transition-failed':\n            raise KeyboardInterrupt  # the controller dies before recording the failure\n        return original(kind, **fields)\n    world.journal.append = append\n    with pytest.raises(KeyboardInterrupt):\n        transition.run()\n    world.journal.close()\n    applied = list(world.migrate.applied)\n    replay = world.transition()\n    with pytest.raises(Refused, match='^migration-outcome-ambiguous$'):\n        replay.run()\n    assert world.migrate.applied == applied\n    recovery = replay.recovery()\n    assert recovery['state'] == 'ddl-ambiguous' and recovery['open_steps'] == ['migration:' + victim.name]\n    with pytest.raises(Refused, match='^post-ddl-resume-forbidden$'):\n        replay.resume_legacy(replay.host.resume_token())\n\n\ndef test_writer_appearing_between_migrations_stops_before_next_ddl(world):\n    first = world.plan.pending[0]\n    world.migrate.after = lambda name: name == first.name and setattr(world.pg, 'writers', 1)\n    with pytest.raises(Refused, match='^database-writing-session$'):\n        world.transition().run()\n    assert world.migrate.applied == [first.name]\n\n\n# --- A9 failures: no undo, consumers held, ingress blocked -------------------------------------\n\n@pytest.mark.parametrize('fault, code', [\n    ('gate', 'candidate-gate-open'), ('restart-always', 'candidate-consumer-not-held'),\n    ('autostart', 'candidate-consumer-not-held'), ('start-dependency', 'candidate-consumer-not-held'),\n    ('smoke-ready', 'candidate-ready-failed'), ('smoke-health', 'candidate-health-failed'),\n    ('ingress-opened', 'observed-host-ingress-reopened'), ('legacy-restarted', 'observed-host-identity-or-support-changed'),\n    ('support-stopped', 'observed-host-effect-failed'),\n])\ndef test_a9_failures_stop_without_undo(world, fault, code):\n    c = world.cdocker\n    if fault == 'gate':\n        c.gates = ['ALLOW_REAL_SENDS=true', *c.gates[1:]]\n    elif fault == 'restart-always':\n        c.hold_applied = False\n    elif fault == 'autostart':\n        c.autostart = {'cron-worker'}\n    elif fault == 'start-dependency':\n        c.start_also = {'queue-worker'}\n    elif fault == 'smoke-ready':\n        c.smoke = dict(c.smoke, ready=503, ready_status='not_ready', required_ok=False)\n    elif fault == 'smoke-health':\n        c.smoke = dict(c.smoke, health=None, health_ok=False, ready=None, ready_status=None, required_ok=False)\n    elif fault == 'ingress-opened':\n        c.on_start = lambda: setattr(world.rig.ingress['evolution-backend'], 'state', 'open')\n    elif fault == 'legacy-restarted':\n        def restart():\n            state = world.rig.docker.containers[LEGACY['cron-worker']]['State']\n            state.update(Status='running', Running=True, StartedAt='2026-10-30T14:00:00.000000001Z')\n        c.on_start = restart\n    else:\n        c.on_create = lambda: world.rig.docker.containers[SUPPORT['redis']]['State'].update(\n            Status='exited', Running=False)\n    transition = world.transition()\n    with pytest.raises(Refused, match='^' + code + '$'):\n        transition.run()\n    assert world.journal.last('transition-failed')['code'] == code\n    assert not any(a[:2] == ('docker', 'start') and a[2] != CANDIDATE_IDS['backend'] for a in c.calls)\n    assert not any(a[1] in ('rm', 'stop', 'kill', 'update', 'restart') for a in c.calls)\n    assert not any(a[:2] == ('docker', 'start') for a in world.rig.docker.calls)\n    recovery = transition.recovery()\n    assert recovery['state'] in ('candidate-failed', 'candidate-ambiguous')\n    assert recovery['legacy_resume_allowed'] is False\n    calls = len(c.calls)\n    with pytest.raises(Refused, match='^transition-stopped$'):\n        transition.run()\n    assert len(c.calls) == calls\n\n\ndef test_a9_refuses_a_non_empty_candidate_project_before_creating(world):\n    world.cdocker.containers['e' * 63 + 'f'] = dict(name='stale', service='backend', status='exited', running=False,\n                                                     started=ZERO_STARTED, restarts=0, policy='no', env=[])\n    with pytest.raises(Refused, match='^candidate-project-not-empty$'):\n        world.transition().run()\n    assert world.cdocker.effects() == []\n\n\ndef test_crash_after_backend_start_intent_is_ambiguous(world):\n    transition = world.transition()\n    world.cdocker.on_start = lambda: (_ for _ in ()).throw(KeyboardInterrupt)\n    original = world.journal.append\n\n    def append(kind, **fields):\n        if kind == 'transition-failed':\n            raise KeyboardInterrupt\n        return original(kind, **fields)\n    world.journal.append = append\n    with pytest.raises(KeyboardInterrupt):\n        transition.run()\n    world.journal.close()\n    world.cdocker.on_start = None\n    replay = world.transition()\n    starts = len(world.cdocker.effects())\n    with pytest.raises(Refused, match='^candidate-start-ambiguous$'):\n        replay.run()\n    assert len(world.cdocker.effects()) == starts\n    assert replay.recovery()['state'] == 'candidate-ambiguous'\n\n\ndef test_layout_is_exclusive_and_package_bound(world):\n    count = world.layout()\n    target = world.tmp / 'releases' / APPLICATION_SHA\n    assert count == len([p for p in target.rglob('*') if p.is_file()]) and world.layout() == count\n    (target / 'deploy' / 'docker-compose.yml').write_text('tampered\\n')\n    with pytest.raises(Refused, match='^layout-mismatch$'):\n        world.layout()\n    assert (target / 'deploy' / 'docker-compose.yml').read_text() == 'tampered\\n'  # never overwritten\n    with pytest.raises(Refused, match='^package-identity-mismatch$'):\n        write_candidate_release(ROOT, world.spec, world.rig.manifest, package_manifest_sha256='0' * 64,\n                                migrations=[m.name for m in world.plan.migrations], git=world.git)\n    with pytest.raises(Refused, match='^layout-migrations-differ-from-plan$'):\n        write_candidate_release(ROOT, world.spec, world.rig.manifest, package_manifest_sha256=world.package,\n                                migrations=[], git=world.git)\n    missing = CandidateSpec(**{**world.spec.__dict__, 'release_root': str(world.tmp / 'absent')})\n    with pytest.raises(Refused, match='^release-root-missing$'):\n        write_candidate_release(ROOT, missing, world.rig.manifest, package_manifest_sha256=world.package,\n                                migrations=[m.name for m in world.plan.migrations], git=world.git)\n    assert not (world.tmp / 'absent').exists()\n\n\n# --- ports, runners and configuration -------------------------------------------------------------\n\ndef test_migration_executor_builds_the_canonical_command_and_isolates_the_secret(world):\n    tx = next(m for m in world.plan.pending if not m.concurrent)\n    nt = next(m for m in world.plan.pending if m.concurrent)\n    assert MigrationExecutor.command(PYTHON, '/w', tx) == (PYTHON, '-I', '/w/scripts/migrate.py', 'apply', tx.name,\n                                                           '--yes')\n    assert MigrationExecutor.command(PYTHON, '/w', nt)[-1] == '--no-transaction'\n    executor = world.transition().executor\n    index = world.plan.pending.index(tx) + 1\n    world.pg.ledger = list(world.plan.baseline)\n    assert executor.apply(index, tx) == 0\n    with pytest.raises(Refused, match='^migration-workdir-exists$'):\n        executor.apply(index, tx)\n    with pytest.raises(Refused, match='^migration-not-pending$'):\n        executor.apply(index, nt)\n    with pytest.raises(Refused, match='^migration-plan$'):\n        MigrationExecutor(object(), python=PYTHON, workdir='/w', secret=lambda: SECRET_URL, runner=lambda *a: 0)\n\n\n@pytest.mark.parametrize('argv, env', [\n    (('/usr/bin/sh', '-c', 'x'), {}), ((PYTHON, 'x'), {'HOME': '/root'}), ((PYTHON, 'a\\x00b'), {}),\n    ([PYTHON, 'x'], {}),\n])\ndef test_process_runner_refuses_unlisted_binary_env_or_shape_before_spawn(argv, env):\n    calls = []\n    runner = ProcessRunner(binaries=(PYTHON,), run=lambda *a, **k: calls.append(1))\n    with pytest.raises(Refused, match='^process-'):\n        runner(argv, env=env, cwd='/w', timeout=5)\n    assert calls == []\n\n\ndef test_process_runner_sanitizes_spawn_failure():\n    def explode(*_a, **_k):\n        raise OSError(SECRET_URL)\n    with pytest.raises(Refused, match='^process-spawn-failed$') as raised:\n        ProcessRunner(binaries=(PYTHON,), run=explode)((PYTHON, 'x'), env={}, cwd='/w', timeout=5)\n    assert 'SENTINEL' not in repr(raised.value) and raised.value.__cause__ is None\n\n\n@pytest.mark.parametrize('argv', [\n    ('docker', 'compose', 'up', '-d'), ('docker', 'start', 'x'), ('docker', 'rm', 'a' * 64),\n    ('docker', 'exec', 'a' * 64, 'sh', '-c', 'x'), ('docker', 'update', '--restart=always', 'a' * 64),\n    ('docker', 'compose', '--project-name', 'pastorai-release', 'start'),\n])\ndef test_candidate_runner_allows_only_the_ports_own_argv(world, argv):\n    from test_first_transition_host_driver import FakePopen, FakeProc\n    popen = FakePopen(FakeProc())\n    runner = CandidateRunner(world.spec, docker_binary='/usr/bin/docker', endpoint='unix:///run/x/docker.sock',\n                             config_dir='/etc/synthetic-docker', popen=popen)\n    with pytest.raises(Refused, match='^runner-argv$'):\n        runner(argv, timeout=5, max_output=64)\n    assert popen.calls == []\n    runner(world.spec.compose_argv(), timeout=5, max_output=64)\n    env = popen.calls[0][1]['env']\n    assert env['PASTORAI_ENV_FILE'] == world.spec.env_file and set(env) == {'LC_ALL', 'LANG', 'PASTORAI_ENV_FILE'}\n\n\ndef test_example_config_is_sanitized_and_assembles_without_contacting_anything(world):\n    config = load_config(EXAMPLE)\n    assert config.candidate.release_root == '/opt/pastorai-releases'\n    raw = json.loads(EXAMPLE.read_text())\n    for forbidden in ('password', 'postgresql://', 'token', 'secret', 'key='):\n        assert forbidden not in EXAMPLE.read_text().lower()\n    with pytest.raises(Refused, match='^config-keys$'):\n        parse_config({**raw, 'database_url': 'postgresql://x'})\n    with pytest.raises(Refused, match='^config-candidate-sha$'):\n        parse_config({**raw, 'candidate': {**raw['candidate'], 'sha': 'a' * 40}})\n    journal = Journal(world.tmp / 'assembled').open()\n    touched = []\n    ingress = {entry: FakeIngress(config.manifest.digest, entry) for entry in ENTRIES}\n    try:\n        common = dict(plan=world.plan, journal=journal, secret=lambda: touched.append('secret'),\n                      ingress=ingress, writers=FakeWriters(config.manifest.digest),\n                      backup_proof=lambda: touched.append('backup'), popen=lambda *a, **k: touched.append('popen'),\n                      run=lambda *a, **k: touched.append('run'))\n        with pytest.raises(Refused, match='^transition-database-missing$'):\n            assemble(config, connect=None, **common)\n        # Example IDs are not this plan's baseline expectation, yet assembling contacts nothing.\n        transition = assemble(config, connect=lambda **k: touched.append('connect'), **common)\n        assert isinstance(transition, FirstTransition) and touched == []\n        assert transition.host.port.driver.supports_resume is True and touched == []\n        for binding in ingress.values():\n            binding.open = None  # without openers the same assembly cannot resume\n        assert transition.host.port.driver.supports_resume is False\n    finally:\n        journal.close()\n\n\ndef test_observed_orchestrator_journal_stays_out_of_the_local_adapter(world):\n    world.backup = None\n    with pytest.raises(Refused):\n        world.transition().run()\n\n    class Database:\n        identity = 'x'\n    with pytest.raises(Refused, match='^local-transition-observed-journal$'):\n        LocalTransition(world.plan, Database(), world.journal)\n\n\ndef test_partial_containment_is_classified_and_never_resumable(world):\n    world.rig.docker.term_exit[LEGACY['cron-worker']] = 143\n    transition = world.transition()\n    with pytest.raises(Refused, match='^observed-host-'):\n        transition.run()\n    recovery = transition.recovery()\n    assert recovery['state'] == 'containment-partial' and recovery['legacy_resume_allowed'] is False\n    with pytest.raises(Refused, match='^observed-host-not-contained$'):\n        transition.resume_legacy(transition.host.resume_token())\n    assert EXECUTOR_SHA and world.migrate.applied == []\n\n\ndef test_failed_concurrent_migration_is_never_classified_as_definite(world):\n    concurrent = next(m for m in world.plan.pending if m.concurrent)\n    world.migrate.faults[concurrent.name] = 'fail'\n    transition = world.transition()\n    with pytest.raises(Refused, match='^migration-failed$'):\n        transition.run()\n    outcome = world.journal.last('transition-migration-failed')\n    assert outcome['definite'] is False and outcome['step'] == 'migration:' + concurrent.name\n    assert transition.recovery()['state'] == 'ddl-ambiguous'\n","numLines":720,"startLine":1,"totalLines":720}},"tool_result_meta":[{"id":"toolu_01E8QSxZ6Zet88RdUYeWo46Z","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
