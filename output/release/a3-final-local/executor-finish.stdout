{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgYfGC9XPQDPx8KRinpsR","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01K4VbUg3KmJsxiPBV7QVZgp","name":"Read","input":{"file_path":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/tests/test_first_transition_database.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16062,"cache_read_input_tokens":61186,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16062},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b7c0715d-1aa9-47c4-a1be-b9d449b8e96c","uuid":"4d0feba0-5d2d-48ef-b029-8aaf56c0a856","timestamp":"2026-10-30T15:30:06.471Z","request_id":"req_011CgYfGBiUjF43E2q5Y41VP","wire_tool_inputs":{"toolu_01K4VbUg3KmJsxiPBV7QVZgp":{"file_path":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/tests/test_first_transition_database.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K4VbUg3KmJsxiPBV7QVZgp","type":"tool_result","content":"1\t\"\"\"Read-only database observer/ledger proof over a fake DB-API connection; no PostgreSQL is used.\"\"\"\n2\timport os\n3\tfrom pathlib import Path\n4\timport socket\n5\timport subprocess\n6\timport sys\n7\t\n8\timport pytest\n9\t\n10\tsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\n11\timport first_transition_database as fdb\n12\tfrom first_transition_adapter import Refused, baseline_digest, digest\n13\tfrom first_transition_database import (DatabaseExpectation, LedgerProof, ReadOnlyDatabase, require_ddl_free,\n14\t                                       require_quiet)\n15\t\n16\tSCOPE = 'c' * 64\n17\tSECRET = 'SENTINEL-DB-SECRET'\n18\tSTATEMENTS = {fdb.Q_BEGIN, fdb.Q_TIMEOUT, fdb.Q_PATH, fdb.Q_READ_ONLY, fdb.Q_IDENTITY, fdb.Q_VISIBILITY,\n19\t              fdb.Q_LEDGER, fdb.Q_INVALID, fdb.Q_INDEXES, fdb.Q_BUILDS, fdb.Q_CATALOG, fdb.Q_WRITERS,\n20\t              fdb.Q_RELATION, 'ROLLBACK', *(fdb.lease_query(t, c) for t, c in fdb.LEASES)}\n21\t\n22\t\n23\t@pytest.fixture(autouse=True)\n24\tdef no_real_processes_or_network(monkeypatch):\n25\t    def forbid(*_args, **_kwargs):\n26\t        raise AssertionError('real process/network forbidden')\n27\t    for module, names in ((subprocess, ('Popen', 'run')), (os, ('system', 'fork', 'execv', 'execve')),\n28\t                          (socket, ('socket', 'create_connection'))):\n29\t        for name in names:\n30\t            monkeypatch.setattr(module, name, forbid)\n31\t\n32\t\n33\tclass FakePg:\n34\t    \"\"\"Synthetic database state; DDL is modelled as catalog rows derived from the ledger.\"\"\"\n35\t\n36\t    def __init__(self, ledger):\n37\t        self.system, self.oid, self.name = '7300000000000000001', 16384, 'postgres'\n38\t        self.read_only, self.visible = 'on', True\n39\t        self.ledger = list(ledger)\n40\t        self.extra_ddl = []\n41\t        self.invalid, self.indexes, self.builds = [], ['base_idx'], 0\n42\t        self.writers, self.leases = 0, {t: 0 for t, _ in fdb.LEASES}\n43\t        self.missing_relations = set()\n44\t        self.executed, self.connections, self.closed = [], 0, 0\n45\t        self.fail_on = None\n46\t        self.on_connect = None\n47\t\n48\t    def catalog_rows(self, ledger=None):\n49\t        names = sorted(self.ledger if ledger is None else ledger)\n50\t        return [[index, 'rel_' + name[:20], 'r', 1, 'id', 23, True] for index, name in enumerate(names)] + [\n51\t            [9000 + i, name, 'r', 1, 'id', 23, True] for i, name in enumerate(self.extra_ddl)]\n52\t\n53\t    def catalog(self, ledger=None):\n54\t        return digest(self.catalog_rows(ledger))\n55\t\n56\t    def identity(self):\n57\t        return digest([self.system, self.oid, self.name])\n58\t\n59\t    def expectation(self, ledger=None):\n60\t        ledger = tuple(sorted(self.ledger if ledger is None else ledger))\n61\t        return DatabaseExpectation(self.identity(), ledger, self.catalog(ledger))\n62\t\n63\t    def connect(self, *, timeout):\n64\t        assert 0 < timeout <= 30\n65\t        self.connections += 1\n66\t        if self.on_connect:\n67\t            self.on_connect()\n68\t        if self.fail_on == 'connect':\n69\t            raise OSError('could not connect: password=' + SECRET)\n70\t        return FakeConnection(self)\n71\t\n72\t\n73\tclass FakeConnection:\n74\t    def __init__(self, pg):\n75\t        self.pg, self.autocommit = pg, False\n76\t\n77\t    def cursor(self):\n78\t        return FakeCursor(self.pg)\n79\t\n80\t    def close(self):\n81\t        self.pg.closed += 1\n82\t\n83\t\n84\tclass FakeCursor:\n85\t    def __init__(self, pg):\n86\t        self.pg, self.rows = pg, None\n87\t\n88\t    def execute(self, query, params=None):\n89\t        pg = self.pg\n90\t        assert query in STATEMENTS, query\n91\t        pg.executed.append((query, params))\n92\t        if pg.fail_on == query:\n93\t            raise RuntimeError('server error near ' + SECRET)\n94\t        lease = {fdb.lease_query(t, c): t for t, c in fdb.LEASES}\n95\t        answers = {\n96\t            fdb.Q_TIMEOUT: lambda: [(params[0],)], fdb.Q_PATH: lambda: [('pg_catalog,public',)],\n97\t            fdb.Q_READ_ONLY: lambda: [(pg.read_only,)], fdb.Q_IDENTITY: lambda: [(pg.system, pg.oid, pg.name)],\n98\t            fdb.Q_VISIBILITY: lambda: [(pg.visible,)], fdb.Q_LEDGER: lambda: [(n,) for n in sorted(pg.ledger)],\n99\t            fdb.Q_INVALID: lambda: [(n,) for n in pg.invalid], fdb.Q_INDEXES: lambda: [(n,) for n in pg.indexes],\n100\t            fdb.Q_BUILDS: lambda: [(pg.builds,)], fdb.Q_CATALOG: lambda: [tuple(r) for r in pg.catalog_rows()],\n101\t            fdb.Q_WRITERS: lambda: [(pg.writers,)],\n102\t            fdb.Q_RELATION: lambda: [(params[0].removeprefix('public.') not in pg.missing_relations,)],\n103\t        }\n104\t        if query in lease:\n105\t            self.rows = [(pg.leases[lease[query]],)]\n106\t        else:\n107\t            self.rows = answers.get(query, lambda: None)()\n108\t\n109\t    def fetchall(self):\n110\t        return self.rows\n111\t\n112\t\n113\tLEDGER = ['0001_base.sql', '0002_more.sql']\n114\t\n115\t\n116\tdef make():\n117\t    pg = FakePg(LEDGER)\n118\t    return pg, ReadOnlyDatabase(pg.connect)\n119\t\n120\t\n121\tdef test_observation_is_read_only_aggregate_and_always_rolled_back_and_closed():\n122\t    pg, database = make()\n123\t    observation = database.observe(timeout=5)\n124\t    assert observation['ledger'] == tuple(LEDGER) and observation['identity'] == pg.identity()\n125\t    assert observation['catalog'] == pg.catalog() and observation['writing_sessions'] == 0\n126\t    assert baseline_digest(observation) == pg.expectation().baseline_digest\n127\t    queries = [q for q, _ in pg.executed]\n128\t    assert queries[0] == fdb.Q_BEGIN and queries[-1] == 'ROLLBACK' and pg.closed == 1\n129\t    assert ('5000ms',) in [p for q, p in pg.executed if q == fdb.Q_TIMEOUT]\n130\t    text = ' '.join(queries).lower()\n131\t    for forbidden in ('insert ', 'update ', 'delete ', 'create ', 'alter ', 'drop ', 'truncate', ' query',\n132\t                      'client_addr', 'usename', 'select *'):\n133\t        assert forbidden not in text\n134\t    # Writers never count the observer itself; applications are a bound parameter, not SQL text.\n135\t    assert [p for q, p in pg.executed if q == fdb.Q_WRITERS] == [([fdb.OBSERVER_APPLICATION],)]\n136\t\n137\t\n138\t@pytest.mark.parametrize('change, code', [\n139\t    (lambda pg: setattr(pg, 'read_only', 'off'), 'database-not-read-only'),\n140\t    (lambda pg: setattr(pg, 'visible', False), 'database-activity-not-visible'),\n141\t    (lambda pg: pg.missing_relations.add('notification_outbox'), 'database-lease-relation'),\n142\t    (lambda pg: setattr(pg, 'fail_on', fdb.Q_LEDGER), 'database-observation-failed'),\n143\t    (lambda pg: setattr(pg, 'fail_on', 'connect'), 'database-observation-failed'),\n144\t    (lambda pg: setattr(pg, 'builds', -1), 'database-observation-shape'),\n145\t    (lambda pg: pg.ledger.append('bad name'), 'database-ledger-shape'),\n146\t])\n147\tdef test_observation_failures_are_fixed_codes_without_secret(change, code):\n148\t    pg, database = make()\n149\t    change(pg)\n150\t    with pytest.raises(Refused, match='^' + code + '$') as raised:\n151\t        database.observe(timeout=5)\n152\t    assert SECRET not in repr(raised.value) and raised.value.__cause__ is None\n153\t    assert pg.closed == pg.connections - (pg.fail_on == 'connect')\n154\t\n155\t\n156\t@pytest.mark.parametrize('change, code', [\n157\t    (lambda pg: pg.ledger.append('0003_new.sql'), 'database-ledger-drift'),\n158\t    (lambda pg: pg.extra_ddl.append('rogue_table'), 'database-ddl-drift'),\n159\t    (lambda pg: setattr(pg, 'system', '7300000000000000002'), 'database-identity-mismatch'),\n160\t    (lambda pg: setattr(pg, 'name', 'other_db'), 'database-identity-mismatch'),\n161\t    (lambda pg: pg.invalid.append('half_built_idx'), 'database-ddl-in-progress'),\n162\t    (lambda pg: setattr(pg, 'builds', 1), 'database-ddl-in-progress'),\n163\t])\n164\tdef test_ledger_proof_rejects_any_ddl_or_ledger_drift(change, code):\n165\t    pg, database = make()\n166\t    proof = LedgerProof(database, pg.expectation(), scope=SCOPE)\n167\t    assert proof.prove(SCOPE, timeout=5)['ddl_free'] is True\n168\t    change(pg)\n169\t    with pytest.raises(Refused, match='^' + code + '$'):\n170\t        proof.prove(SCOPE, timeout=5)\n171\t\n172\t\n173\tdef test_ledger_proof_is_fresh_per_call_and_scope_bound():\n174\t    pg, database = make()\n175\t    proof = LedgerProof(database, pg.expectation(), scope=SCOPE)\n176\t    for _ in range(3):\n177\t        proof.prove(SCOPE, timeout=5)\n178\t    assert pg.connections == 3\n179\t    with pytest.raises(Refused, match='^database-proof-scope$'):\n180\t        proof.prove('d' * 64, timeout=5)\n181\t    assert pg.connections == 3\n182\t    with pytest.raises(Refused, match='^database-proof-source$'):\n183\t        LedgerProof(object(), pg.expectation(), scope=SCOPE)\n184\t    with pytest.raises(Refused, match='^database-expectation$'):\n185\t        LedgerProof(database, DatabaseExpectation('x', (), 'y'), scope=SCOPE)\n186\t\n187\t\n188\t@pytest.mark.parametrize('field, value, code', [\n189\t    ('writers', 1, 'database-writing-session'),\n190\t    ('leases', {'notification_outbox': 2}, 'database-active-lease'),\n191\t])\n192\tdef test_quiet_requires_zero_writers_and_zero_leases(field, value, code):\n193\t    pg, database = make()\n194\t    require_quiet(database.observe(timeout=5))\n195\t    if field == 'leases':\n196\t        pg.leases.update(value)\n197\t    else:\n198\t        setattr(pg, field, value)\n199\t    observation = database.observe(timeout=5)\n200\t    require_ddl_free(observation, pg.expectation())  # quiet is a separate requirement\n201\t    with pytest.raises(Refused, match='^' + code + '$'):\n202\t        require_quiet(observation)\n203\t\n204\t\n205\t@pytest.mark.parametrize('kwargs', [\n206\t    dict(lease_columns=(('bad-name', 'x'),)), dict(lease_columns=()), dict(observer_applications=('a b',)),\n207\t    dict(lease_columns=(('t', 'c'), ('t', 'c'))),\n208\t])\n209\tdef test_configuration_is_validated_before_any_connection(kwargs):\n210\t    pg = FakePg(LEDGER)\n211\t    with pytest.raises(Refused, match='^database-'):\n212\t        ReadOnlyDatabase(pg.connect, **kwargs)\n213\t    with pytest.raises(Refused, match='^database-connect-missing$'):\n214\t        ReadOnlyDatabase(None)\n215\t    assert pg.connections == 0\n216\t\n217\t\n218\tdef test_psycopg2_connector_needs_a_secret_provider_and_is_inert():\n219\t    with pytest.raises(Refused, match='^database-connect-missing$'):\n220\t        fdb.psycopg2_connector(None)\n221\t    calls = []\n222\t    connect = fdb.psycopg2_connector(lambda: calls.append(1) or 'postgresql://x')\n223\t    assert callable(connect) and calls == []\n224\t"}]},"parent_tool_use_id":null,"session_id":"b7c0715d-1aa9-47c4-a1be-b9d449b8e96c","uuid":"01abf4c2-4df1-44fa-a151-3bed20d19926","timestamp":"2026-10-30T15:30:06.501Z","tool_use_result":{"type":"text","file":{"filePath":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/tests/test_first_transition_database.py","content":"\"\"\"Read-only database observer/ledger proof over a fake DB-API connection; no PostgreSQL is used.\"\"\"\nimport os\nfrom pathlib import Path\nimport socket\nimport subprocess\nimport sys\n\nimport pytest\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\nimport first_transition_database as fdb\nfrom first_transition_adapter import Refused, baseline_digest, digest\nfrom first_transition_database import (DatabaseExpectation, LedgerProof, ReadOnlyDatabase, require_ddl_free,\n                                       require_quiet)\n\nSCOPE = 'c' * 64\nSECRET = 'SENTINEL-DB-SECRET'\nSTATEMENTS = {fdb.Q_BEGIN, fdb.Q_TIMEOUT, fdb.Q_PATH, fdb.Q_READ_ONLY, fdb.Q_IDENTITY, fdb.Q_VISIBILITY,\n              fdb.Q_LEDGER, fdb.Q_INVALID, fdb.Q_INDEXES, fdb.Q_BUILDS, fdb.Q_CATALOG, fdb.Q_WRITERS,\n              fdb.Q_RELATION, 'ROLLBACK', *(fdb.lease_query(t, c) for t, c in fdb.LEASES)}\n\n\n@pytest.fixture(autouse=True)\ndef no_real_processes_or_network(monkeypatch):\n    def forbid(*_args, **_kwargs):\n        raise AssertionError('real process/network forbidden')\n    for module, names in ((subprocess, ('Popen', 'run')), (os, ('system', 'fork', 'execv', 'execve')),\n                          (socket, ('socket', 'create_connection'))):\n        for name in names:\n            monkeypatch.setattr(module, name, forbid)\n\n\nclass FakePg:\n    \"\"\"Synthetic database state; DDL is modelled as catalog rows derived from the ledger.\"\"\"\n\n    def __init__(self, ledger):\n        self.system, self.oid, self.name = '7300000000000000001', 16384, 'postgres'\n        self.read_only, self.visible = 'on', True\n        self.ledger = list(ledger)\n        self.extra_ddl = []\n        self.invalid, self.indexes, self.builds = [], ['base_idx'], 0\n        self.writers, self.leases = 0, {t: 0 for t, _ in fdb.LEASES}\n        self.missing_relations = set()\n        self.executed, self.connections, self.closed = [], 0, 0\n        self.fail_on = None\n        self.on_connect = None\n\n    def catalog_rows(self, ledger=None):\n        names = sorted(self.ledger if ledger is None else ledger)\n        return [[index, 'rel_' + name[:20], 'r', 1, 'id', 23, True] for index, name in enumerate(names)] + [\n            [9000 + i, name, 'r', 1, 'id', 23, True] for i, name in enumerate(self.extra_ddl)]\n\n    def catalog(self, ledger=None):\n        return digest(self.catalog_rows(ledger))\n\n    def identity(self):\n        return digest([self.system, self.oid, self.name])\n\n    def expectation(self, ledger=None):\n        ledger = tuple(sorted(self.ledger if ledger is None else ledger))\n        return DatabaseExpectation(self.identity(), ledger, self.catalog(ledger))\n\n    def connect(self, *, timeout):\n        assert 0 < timeout <= 30\n        self.connections += 1\n        if self.on_connect:\n            self.on_connect()\n        if self.fail_on == 'connect':\n            raise OSError('could not connect: password=' + SECRET)\n        return FakeConnection(self)\n\n\nclass FakeConnection:\n    def __init__(self, pg):\n        self.pg, self.autocommit = pg, False\n\n    def cursor(self):\n        return FakeCursor(self.pg)\n\n    def close(self):\n        self.pg.closed += 1\n\n\nclass FakeCursor:\n    def __init__(self, pg):\n        self.pg, self.rows = pg, None\n\n    def execute(self, query, params=None):\n        pg = self.pg\n        assert query in STATEMENTS, query\n        pg.executed.append((query, params))\n        if pg.fail_on == query:\n            raise RuntimeError('server error near ' + SECRET)\n        lease = {fdb.lease_query(t, c): t for t, c in fdb.LEASES}\n        answers = {\n            fdb.Q_TIMEOUT: lambda: [(params[0],)], fdb.Q_PATH: lambda: [('pg_catalog,public',)],\n            fdb.Q_READ_ONLY: lambda: [(pg.read_only,)], fdb.Q_IDENTITY: lambda: [(pg.system, pg.oid, pg.name)],\n            fdb.Q_VISIBILITY: lambda: [(pg.visible,)], fdb.Q_LEDGER: lambda: [(n,) for n in sorted(pg.ledger)],\n            fdb.Q_INVALID: lambda: [(n,) for n in pg.invalid], fdb.Q_INDEXES: lambda: [(n,) for n in pg.indexes],\n            fdb.Q_BUILDS: lambda: [(pg.builds,)], fdb.Q_CATALOG: lambda: [tuple(r) for r in pg.catalog_rows()],\n            fdb.Q_WRITERS: lambda: [(pg.writers,)],\n            fdb.Q_RELATION: lambda: [(params[0].removeprefix('public.') not in pg.missing_relations,)],\n        }\n        if query in lease:\n            self.rows = [(pg.leases[lease[query]],)]\n        else:\n            self.rows = answers.get(query, lambda: None)()\n\n    def fetchall(self):\n        return self.rows\n\n\nLEDGER = ['0001_base.sql', '0002_more.sql']\n\n\ndef make():\n    pg = FakePg(LEDGER)\n    return pg, ReadOnlyDatabase(pg.connect)\n\n\ndef test_observation_is_read_only_aggregate_and_always_rolled_back_and_closed():\n    pg, database = make()\n    observation = database.observe(timeout=5)\n    assert observation['ledger'] == tuple(LEDGER) and observation['identity'] == pg.identity()\n    assert observation['catalog'] == pg.catalog() and observation['writing_sessions'] == 0\n    assert baseline_digest(observation) == pg.expectation().baseline_digest\n    queries = [q for q, _ in pg.executed]\n    assert queries[0] == fdb.Q_BEGIN and queries[-1] == 'ROLLBACK' and pg.closed == 1\n    assert ('5000ms',) in [p for q, p in pg.executed if q == fdb.Q_TIMEOUT]\n    text = ' '.join(queries).lower()\n    for forbidden in ('insert ', 'update ', 'delete ', 'create ', 'alter ', 'drop ', 'truncate', ' query',\n                      'client_addr', 'usename', 'select *'):\n        assert forbidden not in text\n    # Writers never count the observer itself; applications are a bound parameter, not SQL text.\n    assert [p for q, p in pg.executed if q == fdb.Q_WRITERS] == [([fdb.OBSERVER_APPLICATION],)]\n\n\n@pytest.mark.parametrize('change, code', [\n    (lambda pg: setattr(pg, 'read_only', 'off'), 'database-not-read-only'),\n    (lambda pg: setattr(pg, 'visible', False), 'database-activity-not-visible'),\n    (lambda pg: pg.missing_relations.add('notification_outbox'), 'database-lease-relation'),\n    (lambda pg: setattr(pg, 'fail_on', fdb.Q_LEDGER), 'database-observation-failed'),\n    (lambda pg: setattr(pg, 'fail_on', 'connect'), 'database-observation-failed'),\n    (lambda pg: setattr(pg, 'builds', -1), 'database-observation-shape'),\n    (lambda pg: pg.ledger.append('bad name'), 'database-ledger-shape'),\n])\ndef test_observation_failures_are_fixed_codes_without_secret(change, code):\n    pg, database = make()\n    change(pg)\n    with pytest.raises(Refused, match='^' + code + '$') as raised:\n        database.observe(timeout=5)\n    assert SECRET not in repr(raised.value) and raised.value.__cause__ is None\n    assert pg.closed == pg.connections - (pg.fail_on == 'connect')\n\n\n@pytest.mark.parametrize('change, code', [\n    (lambda pg: pg.ledger.append('0003_new.sql'), 'database-ledger-drift'),\n    (lambda pg: pg.extra_ddl.append('rogue_table'), 'database-ddl-drift'),\n    (lambda pg: setattr(pg, 'system', '7300000000000000002'), 'database-identity-mismatch'),\n    (lambda pg: setattr(pg, 'name', 'other_db'), 'database-identity-mismatch'),\n    (lambda pg: pg.invalid.append('half_built_idx'), 'database-ddl-in-progress'),\n    (lambda pg: setattr(pg, 'builds', 1), 'database-ddl-in-progress'),\n])\ndef test_ledger_proof_rejects_any_ddl_or_ledger_drift(change, code):\n    pg, database = make()\n    proof = LedgerProof(database, pg.expectation(), scope=SCOPE)\n    assert proof.prove(SCOPE, timeout=5)['ddl_free'] is True\n    change(pg)\n    with pytest.raises(Refused, match='^' + code + '$'):\n        proof.prove(SCOPE, timeout=5)\n\n\ndef test_ledger_proof_is_fresh_per_call_and_scope_bound():\n    pg, database = make()\n    proof = LedgerProof(database, pg.expectation(), scope=SCOPE)\n    for _ in range(3):\n        proof.prove(SCOPE, timeout=5)\n    assert pg.connections == 3\n    with pytest.raises(Refused, match='^database-proof-scope$'):\n        proof.prove('d' * 64, timeout=5)\n    assert pg.connections == 3\n    with pytest.raises(Refused, match='^database-proof-source$'):\n        LedgerProof(object(), pg.expectation(), scope=SCOPE)\n    with pytest.raises(Refused, match='^database-expectation$'):\n        LedgerProof(database, DatabaseExpectation('x', (), 'y'), scope=SCOPE)\n\n\n@pytest.mark.parametrize('field, value, code', [\n    ('writers', 1, 'database-writing-session'),\n    ('leases', {'notification_outbox': 2}, 'database-active-lease'),\n])\ndef test_quiet_requires_zero_writers_and_zero_leases(field, value, code):\n    pg, database = make()\n    require_quiet(database.observe(timeout=5))\n    if field == 'leases':\n        pg.leases.update(value)\n    else:\n        setattr(pg, field, value)\n    observation = database.observe(timeout=5)\n    require_ddl_free(observation, pg.expectation())  # quiet is a separate requirement\n    with pytest.raises(Refused, match='^' + code + '$'):\n        require_quiet(observation)\n\n\n@pytest.mark.parametrize('kwargs', [\n    dict(lease_columns=(('bad-name', 'x'),)), dict(lease_columns=()), dict(observer_applications=('a b',)),\n    dict(lease_columns=(('t', 'c'), ('t', 'c'))),\n])\ndef test_configuration_is_validated_before_any_connection(kwargs):\n    pg = FakePg(LEDGER)\n    with pytest.raises(Refused, match='^database-'):\n        ReadOnlyDatabase(pg.connect, **kwargs)\n    with pytest.raises(Refused, match='^database-connect-missing$'):\n        ReadOnlyDatabase(None)\n    assert pg.connections == 0\n\n\ndef test_psycopg2_connector_needs_a_secret_provider_and_is_inert():\n    with pytest.raises(Refused, match='^database-connect-missing$'):\n        fdb.psycopg2_connector(None)\n    calls = []\n    connect = fdb.psycopg2_connector(lambda: calls.append(1) or 'postgresql://x')\n    assert callable(connect) and calls == []\n","numLines":224,"startLine":1,"totalLines":224}},"tool_result_meta":[{"id":"toolu_01K4VbUg3KmJsxiPBV7QVZgp","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
