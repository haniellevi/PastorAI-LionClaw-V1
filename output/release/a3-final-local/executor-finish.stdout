{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GAdVXWwC3rt8ayCDrkUYEi","type":"tool_result","content":"1\t\"\"\"Candidate release layout and the A9 held start of the first transition.\n2\t\n3\t``write_candidate_release`` writes ``<release_root>/<sha>`` (configured root,\n4\te.g. ``/opt/pastorai-releases``) from the exact package blobs of ``sha`` plus\n5\t``deploy/release-topology.json``, reusing initial_transition_files. The\n6\tpackage identity (``release-manifest.json`` digest of package_backend_release)\n7\tand the migration manifest are checked first; an existing release is verified,\n8\tnever overwritten.\n9\t\n10\t``CandidatePort`` builds every Docker argv itself and runs it through an\n11\tinjected runner (``(argv, *, timeout, max_output) -> (rc, stdout)``):\n12\t\n13\t* ``create_held``: ONE ``docker compose ... up --no-start --no-deps`` for the four\n14\t  services of the candidate project, with an extra hold file forcing\n15\t  ``restart: \"no\"``; nothing is started, no dependency is touched;\n16\t* ``start_backend``: ``docker start`` of the backend ID only;\n17\t* ``smoke``: a bounded /health + /ready probe executed inside the backend,\n18\t  printing only status codes and fixed flags;\n19\t* ``inspect``: restricted projection (gates by name only, never full Env).\n20\t\n21\tThere is no operation to start a consumer, change a gate, open ingress, remove\n22\tor recreate a container: A10 is a separate, not implemented step. Every call is\n23\tpreceded by a daemon identity check. Compatibility with a real Docker\n24\tCLI/Compose is unverified; tests use fixtures only.\n25\t\"\"\"\n26\tfrom __future__ import annotations\n27\t\n28\tfrom dataclasses import dataclass\n29\timport hashlib\n30\timport json\n31\timport os\n32\tfrom pathlib import Path\n33\timport re\n34\timport stat\n35\t\n36\tfrom first_transition_adapter import ROLES\n37\tfrom first_transition_host_driver import (DAEMON, HEX64, IMAGE, INFO_ARGV, MANDATORY_GATES, NETWORK_NAME, STARTED,\n38\t                                          STATUSES, PopenRunner, _absolute, _attempt, _lines, _tail,\n39\t                                          inspect_template)\n40\tfrom initial_transition_files import migration_manifest, no_symlink, write_release\n41\tfrom initial_transition_ops import Refused, require\n42\timport package_backend_release\n43\timport release_topology\n44\t\n45\tCONSUMERS = ('queue-worker', 'cron-worker', 'broadcast-worker')\n46\tZERO_STARTED = '0001-01-01T00:00:00Z'\n47\t# Closed value of each gate (backend/app/config.py defaults); absence keeps the closed default.\n48\tCLOSED_GATES = {'ALLOW_REAL_SENDS': 'false', 'ASAAS_BILLING_ENABLED': 'false', 'BREVO_SEND_MODE': 'off',\n49\t                'BROADCAST_ASYNC_ENABLED': 'false'}\n50\tCANDIDATE_TEMPLATE = '[{{json .Name}},' + inspect_template(MANDATORY_GATES)[1:]\n51\tHOLD_OVERRIDE = ('# A9 hold: candidate containers are created with restart \"no\" and never started here.\\n'\n52\t                 '{\"services\": {' + ', '.join(f'\"{r}\": {{\"restart\": \"no\"}}' for r in ROLES) + '}}\\n')\n53\tLIMITS = dict(info=256, compose=64 * 1024, ps=4096, inspect=64 * 1024, effect=256, smoke=1024)\n54\tPROJECT_LABEL = 'com.docker.compose.project'\n55\tSMOKE_PROBE = r'''\n56\timport json, sys, time, urllib.error, urllib.request\n57\tlimit = time.monotonic() + float(sys.argv[1])\n58\tdef get(path):\n59\t    try:\n60\t        with urllib.request.urlopen('http://127.0.0.1:8000' + path, timeout=5) as response:\n61\t            return response.status, json.loads(response.read(65536) or b'null')\n62\t    except urllib.error.HTTPError as exc:\n63\t        return exc.code, None\n64\t    except (OSError, ValueError):\n65\t        return None, None\n66\twhile True:\n67\t    health, body = get('/health')\n68\t    ready, report = get('/ready') if health == 200 else (None, None)\n69\t    report = report if isinstance(report, dict) else {}\n70\t    required = report.get('required') if isinstance(report.get('required'), dict) else {}\n71\t    result = {'health': health, 'health_ok': isinstance(body, dict) and body.get('status') == 'ok',\n72\t              'ready': ready, 'required_ok': bool(required) and all(v == 'ok' for v in required.values()),\n73\t              'ready_status': report.get('status') if report.get('status') in ('ready', 'degraded', 'not_ready') else None}\n74\t    if (result['health_ok'] and ready == 200 and result['required_ok']) or time.monotonic() >= limit:\n75\t        break\n76\t    time.sleep(1)\n77\tprint(json.dumps(result, sort_keys=True))\n78\t'''\n79\tSMOKE_KEYS = frozenset({'health', 'health_ok', 'ready', 'required_ok', 'ready_status'})\n80\t\n81\t\n82\t@dataclass(frozen=True)\n83\tclass CandidateSpec:\n84\t    \"\"\"Public candidate scope from configuration; no secret, only the private config PATH.\"\"\"\n85\t    sha: str\n86\t    image: str\n87\t    project: str\n88\t    containers: tuple\n89\t    network_id: str\n90\t    network_name: str\n91\t    release_root: str\n92\t    hold_override: str\n93\t    env_file: str\n94\t    daemon_id: str\n95\t    smoke_seconds: int = 60\n96\t\n97\t    def validated(self):\n98\t        names = dict(self.containers) if isinstance(self.containers, tuple) else {}\n99\t        require(isinstance(self.sha, str) and re.fullmatch('[0-9a-f]{40}', self.sha)\n100\t                and isinstance(self.image, str) and IMAGE.fullmatch(self.image)\n101\t                and isinstance(self.project, str) and release_topology.PROJECT.fullmatch(self.project)\n102\t                and self.project != release_topology.BASE_PROJECT\n103\t                and set(names) == set(ROLES) and len(names) == len(self.containers)\n104\t                and all(isinstance(v, str) and release_topology.CONTAINER.fullmatch(v) for v in names.values())\n105\t                and len(set(names.values())) == 4\n106\t                and isinstance(self.network_id, str) and HEX64.fullmatch(self.network_id)\n107\t                and isinstance(self.network_name, str) and NETWORK_NAME.fullmatch(self.network_name)\n108\t                and all(_absolute(p) for p in (self.release_root, self.hold_override, self.env_file))\n109\t                and isinstance(self.daemon_id, str) and DAEMON.fullmatch(self.daemon_id)\n110\t                and type(self.smoke_seconds) is int and 5 <= self.smoke_seconds <= 50, 'candidate-spec')\n111\t        return self\n112\t\n113\t    @property\n114\t    def deploy_dir(self):\n115\t        return f'{self.release_root}/{self.sha}/deploy'\n116\t\n117\t    def names(self):\n118\t        return dict(self.containers)\n119\t\n120\t    def compose_argv(self):\n121\t        deploy = self.deploy_dir\n122\t        return ('docker', 'compose', '--project-name', self.project, '--project-directory', deploy,\n123\t                '--file', deploy + '/docker-compose.yml', '--file', deploy + '/docker-compose.override.yml',\n124\t                '--file', self.hold_override, 'up', '--no-start', '--no-deps', '--no-build', '--no-recreate',\n125\t                '--pull', 'never', *ROLES)\n126\t\n127\t    def ps_argv(self):\n128\t        return ('docker', 'ps', '--all', '--quiet', '--no-trunc', '--filter', f'label={PROJECT_LABEL}={self.project}')\n129\t\n130\t    def smoke_argv(self, backend_id):\n131\t        return ('docker', 'exec', backend_id, 'python', '-I', '-c', SMOKE_PROBE, str(self.smoke_seconds))\n132\t\n133\t\n134\tdef topology_contract(spec, manifest):\n135\t    \"\"\"Public release topology: candidate project/names, existing network, contained legacy IDs.\"\"\"\n136\t    return dict(schema=release_topology.SCHEMA, version=release_topology.VERSION, project=spec.project,\n137\t                legacy_project=manifest.legacy_project, network=dict(name=spec.network_name, id=manifest.network_id),\n138\t                containers=spec.names(), reserved_legacy=dict(manifest.service_ids))\n139\t\n140\t\n141\tdef write_candidate_release(repo, spec, manifest, *, package_manifest_sha256, migrations, git=None):\n142\t    \"\"\"Exact package blobs of ``spec.sha`` -> ``<release_root>/<sha>``; returns the file count.\"\"\"\n143\t    spec = spec.validated()\n144\t    require(isinstance(package_manifest_sha256, str) and HEX64.fullmatch(package_manifest_sha256),\n145\t            'package-identity-missing')\n146\t    files = package_backend_release.source_files(repo, spec.sha, git)\n147\t    require(hashlib.sha256(package_backend_release.release_manifest(spec.sha, files)).hexdigest()\n148\t            == package_manifest_sha256, 'package-identity-mismatch')\n149\t    sql = {p.split('/', 2)[2]: b for p, b in files.items() if re.fullmatch(r'backend/migrations/[^/]+\\.sql', p)}\n150\t    names = migration_manifest(files['backend/scripts/migrate.py'], sql)\n151\t    require(list(names) == list(migrations), 'layout-migrations-differ-from-plan')\n152\t    return write_release(spec.release_root, spec.sha, files, topology_contract(spec, manifest), names, spec.image)\n153\t\n154\t\n155\tdef write_hold_override(spec):\n156\t    \"\"\"Exclusive creation of the public hold file; an existing file must be identical.\"\"\"\n157\t    path = no_symlink(Path(spec.hold_override))\n158\t    data = HOLD_OVERRIDE.encode()\n159\t    if os.path.lexists(path):\n160\t        require(stat.S_ISREG(os.lstat(path).st_mode) and path.read_bytes() == data, 'candidate-hold-mismatch')\n161\t        return\n162\t    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)\n163\t    with os.fdopen(fd, 'wb') as handle:\n164\t        handle.write(data)\n165\t\n166\t\n167\tclass CandidateRunner(PopenRunner):\n168\t    \"\"\"PopenRunner whose allowlist is exactly the argv this spec's CandidatePort builds.\"\"\"\n169\t\n170\t    def __init__(self, spec, **kwargs):\n171\t        self.spec = spec.validated()\n172\t        super().__init__(**kwargs)\n173\t\n174\t    def _allowed(self, argv):\n175\t        if argv in (INFO_ARGV, self.spec.compose_argv(), self.spec.ps_argv()):\n176\t            return True\n177\t        if len(argv) == 3 and argv[:2] == ('docker', 'start'):\n178\t            return HEX64.fullmatch(argv[2]) is not None\n179\t        if len(argv) == 8 and HEX64.fullmatch(argv[2]):\n180\t            return argv == self.spec.smoke_argv(argv[2])\n181\t        return (6 < len(argv) <= 10 and argv[:6] == ('docker', 'inspect', '--type', 'container', '--format',\n182\t                                                     CANDIDATE_TEMPLATE)\n183\t                and all(HEX64.fullmatch(i) for i in argv[6:]) and len(set(argv[6:])) == len(argv[6:]))\n184\t\n185\t    def _env(self):\n186\t        # Path of the private configuration only; Compose reads it, this process never does.\n187\t        return {**super()._env(), 'PASTORAI_ENV_FILE': self.spec.env_file}\n188\t\n189\t\n190\tclass CandidatePort:\n191\t    def __init__(self, spec, *, runner):\n192\t        require(isinstance(spec, CandidateSpec), 'candidate-spec')\n193\t        require(callable(runner), 'candidate-runner')\n194\t        self.spec, self.runner = spec.validated(), runner\n195\t\n196\t    def _run(self, argv, timeout, limit):\n197\t        outcome = None\n198\t        try:\n199\t            result = self.runner(argv, timeout=timeout, max_output=limit)\n200\t        except TimeoutError:\n201\t            outcome = 'candidate-timeout'\n202\t        except Exception:\n203\t            outcome = 'candidate-runner-failed'\n204\t        require(outcome is None, outcome)\n205\t        require(isinstance(result, tuple) and len(result) == 2 and type(result[0]) is int\n206\t                and type(result[1]) is bytes and len(result[1]) <= limit, 'candidate-runner-failed')\n207\t        return result\n208\t\n209\t    def _daemon(self):\n210\t        rc, out = self._run(INFO_ARGV, 10, LIMITS['info'])\n211\t        ok, value = _attempt(_lines, out)\n212\t        require(rc == 0 and ok and value == [self.spec.daemon_id], 'candidate-daemon-mismatch')\n213\t\n214\t    def project_ids(self):\n215\t        self._daemon()\n216\t        rc, out = self._run(self.spec.ps_argv(), 10, LIMITS['ps'])\n217\t        ok, text = _attempt(bytes.decode, out, 'ascii')\n218\t        require(rc == 0 and ok and (text == '' or text.endswith('\\n')), 'candidate-ps-failed')\n219\t        ids = text.split()\n220\t        require(all(HEX64.fullmatch(i) for i in ids) and len(set(ids)) == len(ids), 'candidate-ps-failed')\n221\t        return tuple(sorted(ids))\n222\t\n223\t    def create_held(self):\n224\t        self._daemon()\n225\t        rc, _ = self._run(self.spec.compose_argv(), 60, LIMITS['compose'])\n226\t        require(rc == 0, 'candidate-create-failed')\n227\t\n228\t    def inspect(self, ids):\n229\t        require(isinstance(ids, (tuple, list)) and 1 <= len(ids) <= 4\n230\t                and all(isinstance(i, str) and HEX64.fullmatch(i) for i in ids), 'candidate-ids')\n231\t        self._daemon()\n232\t        rc, out = self._run(('docker', 'inspect', '--type', 'container', '--format', CANDIDATE_TEMPLATE, *ids),\n233\t                            10, LIMITS['inspect'])\n234\t        require(rc == 0, 'candidate-inspect-failed')\n235\t        ok, rows = _attempt(_lines, out)\n236\t        require(ok and all(isinstance(r, list) and len(r) == 19 for r in rows)\n237\t                and [r[1] for r in rows] == list(ids), 'candidate-inspect-malformed')\n238\t        return {row[1]: self._row(row) for row in rows}\n239\t\n240\t    @staticmethod\n241\t    def _row(row):\n242\t        (name, ident, image, project, service, revision, status, running, paused, restarting, exit_code, started,\n243\t         health, restarts, policy, _mode, gates, mounts, networks) = row\n244\t        require(isinstance(name, str) and name.startswith('/') and isinstance(image, str)\n245\t                and isinstance(status, str) and status in STATUSES and type(running) is bool\n246\t                and running == (status == 'running') and paused is False and restarting is False\n247\t                and type(exit_code) is int and isinstance(started, str) and STARTED.fullmatch(started)\n248\t                and (health is None or isinstance(health, str))\n249\t                and type(restarts) is int and restarts >= 0 and isinstance(policy, str),\n250\t                'candidate-inspect-state')\n251\t        gates = _tail(gates, 'candidate-inspect-gates')\n252\t        require(all(isinstance(g, str) and '=' in g for g in gates), 'candidate-inspect-gates')\n253\t        values = dict(g.split('=', 1) for g in gates)\n254\t        require(len(values) == len(gates) and set(values) <= set(MANDATORY_GATES), 'candidate-inspect-gates')\n255\t        networks = _tail(networks, 'candidate-inspect-networks')\n256\t        require(all(isinstance(n, list) and len(n) == 3 and isinstance(n[2], str) for n in networks),\n257\t                'candidate-inspect-networks')\n258\t        _tail(mounts, 'candidate-inspect-mounts')\n259\t        labels = [None if v in (None, '') else v for v in (project, service, revision)]\n260\t        return dict(id=ident, name=name[1:], image=image, project=labels[0], service=labels[1], revision=labels[2],\n261\t                    status=status, running=running, exit_code=exit_code, started=started, health=health,\n262\t                    restart_count=restarts, restart_policy=policy or 'no', gates=values,\n263\t                    networks=sorted(n[2] for n in networks))\n264\t\n265\t    def start_backend(self, backend_id):\n266\t        require(isinstance(backend_id, str) and HEX64.fullmatch(backend_id), 'candidate-ids')\n267\t        self._daemon()\n268\t        rc, out = self._run(('docker', 'start', backend_id), 30, LIMITS['effect'])\n269\t        require(rc == 0 and out == (backend_id + '\\n').encode(), 'candidate-start-receipt')\n270\t\n271\t    def smoke(self, backend_id):\n272\t        require(isinstance(backend_id, str) and HEX64.fullmatch(backend_id), 'candidate-ids')\n273\t        self._daemon()\n274\t        rc, out = self._run(self.spec.smoke_argv(backend_id), self.spec.smoke_seconds + 10, LIMITS['smoke'])\n275\t        ok, value = _attempt(_lines, out)\n276\t        require(rc == 0 and ok and len(value) == 1 and isinstance(value[0], dict)\n277\t                and set(value[0]) == SMOKE_KEYS, 'candidate-smoke-malformed')\n278\t        result = value[0]\n279\t        require(result['health'] == 200 and result['health_ok'] is True, 'candidate-health-failed')\n280\t        require(result['ready'] == 200 and result['required_ok'] is True\n281\t                and result['ready_status'] in ('ready', 'degraded'), 'candidate-ready-failed')\n282\t        return dict(health=200, ready=200, ready_status=result['ready_status'])\n283\t\n284\t\n285\tdef check_identity(spec, role, state):\n286\t    \"\"\"Pinned image/revision, own project/service/name, single network, every gate closed.\"\"\"\n287\t    require(state['image'] == spec.image and state['revision'] == spec.sha, 'candidate-image-mismatch')\n288\t    require(state['project'] == spec.project and state['service'] == role\n289\t            and state['name'] == spec.names()[role], 'candidate-identity-mismatch')\n290\t    require(state['networks'] == [spec.network_id], 'candidate-network-mismatch')\n291\t    require(all(state['gates'].get(g, CLOSED_GATES[g]) == CLOSED_GATES[g] for g in MANDATORY_GATES),\n292\t            'candidate-gate-open')\n293\t\n294\t\n295\tdef check_held(state, created=None):\n296\t    \"\"\"Created, never started, restart=no; unchanged since its creation receipt when given.\"\"\"\n297\t    require(state['status'] == 'created' and state['running'] is False and state['restart_count'] == 0\n298\t            and state['started'] == ZERO_STARTED and state['restart_policy'] == 'no', 'candidate-consumer-not-held')\n299\t    if created is not None:\n300\t        require(state['started'] == created['started'] and state['restart_count'] == created['restart_count'],\n301\t                'candidate-consumer-not-held')\n302\t\n303\t\n304\tdef check_backend_running(state, started=None):\n305\t    require(state['status'] == 'running' and state['running'] is True and state['restart_count'] == 0\n306\t            and state['started'] != ZERO_STARTED and state['restart_policy'] == 'no', 'candidate-backend-not-running')\n307\t    if started is not None:\n308\t        require(state['started'] == started, 'candidate-backend-restarted')\n309\t"}]},"parent_tool_use_id":null,"session_id":"b7c0715d-1aa9-47c4-a1be-b9d449b8e96c","uuid":"c4caee21-6073-4ee3-bdc3-8b259158202f","timestamp":"2026-10-30T15:29:35.312Z","tool_use_result":{"type":"text","file":{"filePath":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_candidate.py","content":"\"\"\"Candidate release layout and the A9 held start of the first transition.\n\n``write_candidate_release`` writes ``<release_root>/<sha>`` (configured root,\ne.g. ``/opt/pastorai-releases``) from the exact package blobs of ``sha`` plus\n``deploy/release-topology.json``, reusing initial_transition_files. The\npackage identity (``release-manifest.json`` digest of package_backend_release)\nand the migration manifest are checked first; an existing release is verified,\nnever overwritten.\n\n``CandidatePort`` builds every Docker argv itself and runs it through an\ninjected runner (``(argv, *, timeout, max_output) -> (rc, stdout)``):\n\n* ``create_held``: ONE ``docker compose ... up --no-start --no-deps`` for the four\n  services of the candidate project, with an extra hold file forcing\n  ``restart: \"no\"``; nothing is started, no dependency is touched;\n* ``start_backend``: ``docker start`` of the backend ID only;\n* ``smoke``: a bounded /health + /ready probe executed inside the backend,\n  printing only status codes and fixed flags;\n* ``inspect``: restricted projection (gates by name only, never full Env).\n\nThere is no operation to start a consumer, change a gate, open ingress, remove\nor recreate a container: A10 is a separate, not implemented step. Every call is\npreceded by a daemon identity check. Compatibility with a real Docker\nCLI/Compose is unverified; tests use fixtures only.\n\"\"\"\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport stat\n\nfrom first_transition_adapter import ROLES\nfrom first_transition_host_driver import (DAEMON, HEX64, IMAGE, INFO_ARGV, MANDATORY_GATES, NETWORK_NAME, STARTED,\n                                          STATUSES, PopenRunner, _absolute, _attempt, _lines, _tail,\n                                          inspect_template)\nfrom initial_transition_files import migration_manifest, no_symlink, write_release\nfrom initial_transition_ops import Refused, require\nimport package_backend_release\nimport release_topology\n\nCONSUMERS = ('queue-worker', 'cron-worker', 'broadcast-worker')\nZERO_STARTED = '0001-01-01T00:00:00Z'\n# Closed value of each gate (backend/app/config.py defaults); absence keeps the closed default.\nCLOSED_GATES = {'ALLOW_REAL_SENDS': 'false', 'ASAAS_BILLING_ENABLED': 'false', 'BREVO_SEND_MODE': 'off',\n                'BROADCAST_ASYNC_ENABLED': 'false'}\nCANDIDATE_TEMPLATE = '[{{json .Name}},' + inspect_template(MANDATORY_GATES)[1:]\nHOLD_OVERRIDE = ('# A9 hold: candidate containers are created with restart \"no\" and never started here.\\n'\n                 '{\"services\": {' + ', '.join(f'\"{r}\": {{\"restart\": \"no\"}}' for r in ROLES) + '}}\\n')\nLIMITS = dict(info=256, compose=64 * 1024, ps=4096, inspect=64 * 1024, effect=256, smoke=1024)\nPROJECT_LABEL = 'com.docker.compose.project'\nSMOKE_PROBE = r'''\nimport json, sys, time, urllib.error, urllib.request\nlimit = time.monotonic() + float(sys.argv[1])\ndef get(path):\n    try:\n        with urllib.request.urlopen('http://127.0.0.1:8000' + path, timeout=5) as response:\n            return response.status, json.loads(response.read(65536) or b'null')\n    except urllib.error.HTTPError as exc:\n        return exc.code, None\n    except (OSError, ValueError):\n        return None, None\nwhile True:\n    health, body = get('/health')\n    ready, report = get('/ready') if health == 200 else (None, None)\n    report = report if isinstance(report, dict) else {}\n    required = report.get('required') if isinstance(report.get('required'), dict) else {}\n    result = {'health': health, 'health_ok': isinstance(body, dict) and body.get('status') == 'ok',\n              'ready': ready, 'required_ok': bool(required) and all(v == 'ok' for v in required.values()),\n              'ready_status': report.get('status') if report.get('status') in ('ready', 'degraded', 'not_ready') else None}\n    if (result['health_ok'] and ready == 200 and result['required_ok']) or time.monotonic() >= limit:\n        break\n    time.sleep(1)\nprint(json.dumps(result, sort_keys=True))\n'''\nSMOKE_KEYS = frozenset({'health', 'health_ok', 'ready', 'required_ok', 'ready_status'})\n\n\n@dataclass(frozen=True)\nclass CandidateSpec:\n    \"\"\"Public candidate scope from configuration; no secret, only the private config PATH.\"\"\"\n    sha: str\n    image: str\n    project: str\n    containers: tuple\n    network_id: str\n    network_name: str\n    release_root: str\n    hold_override: str\n    env_file: str\n    daemon_id: str\n    smoke_seconds: int = 60\n\n    def validated(self):\n        names = dict(self.containers) if isinstance(self.containers, tuple) else {}\n        require(isinstance(self.sha, str) and re.fullmatch('[0-9a-f]{40}', self.sha)\n                and isinstance(self.image, str) and IMAGE.fullmatch(self.image)\n                and isinstance(self.project, str) and release_topology.PROJECT.fullmatch(self.project)\n                and self.project != release_topology.BASE_PROJECT\n                and set(names) == set(ROLES) and len(names) == len(self.containers)\n                and all(isinstance(v, str) and release_topology.CONTAINER.fullmatch(v) for v in names.values())\n                and len(set(names.values())) == 4\n                and isinstance(self.network_id, str) and HEX64.fullmatch(self.network_id)\n                and isinstance(self.network_name, str) and NETWORK_NAME.fullmatch(self.network_name)\n                and all(_absolute(p) for p in (self.release_root, self.hold_override, self.env_file))\n                and isinstance(self.daemon_id, str) and DAEMON.fullmatch(self.daemon_id)\n                and type(self.smoke_seconds) is int and 5 <= self.smoke_seconds <= 50, 'candidate-spec')\n        return self\n\n    @property\n    def deploy_dir(self):\n        return f'{self.release_root}/{self.sha}/deploy'\n\n    def names(self):\n        return dict(self.containers)\n\n    def compose_argv(self):\n        deploy = self.deploy_dir\n        return ('docker', 'compose', '--project-name', self.project, '--project-directory', deploy,\n                '--file', deploy + '/docker-compose.yml', '--file', deploy + '/docker-compose.override.yml',\n                '--file', self.hold_override, 'up', '--no-start', '--no-deps', '--no-build', '--no-recreate',\n                '--pull', 'never', *ROLES)\n\n    def ps_argv(self):\n        return ('docker', 'ps', '--all', '--quiet', '--no-trunc', '--filter', f'label={PROJECT_LABEL}={self.project}')\n\n    def smoke_argv(self, backend_id):\n        return ('docker', 'exec', backend_id, 'python', '-I', '-c', SMOKE_PROBE, str(self.smoke_seconds))\n\n\ndef topology_contract(spec, manifest):\n    \"\"\"Public release topology: candidate project/names, existing network, contained legacy IDs.\"\"\"\n    return dict(schema=release_topology.SCHEMA, version=release_topology.VERSION, project=spec.project,\n                legacy_project=manifest.legacy_project, network=dict(name=spec.network_name, id=manifest.network_id),\n                containers=spec.names(), reserved_legacy=dict(manifest.service_ids))\n\n\ndef write_candidate_release(repo, spec, manifest, *, package_manifest_sha256, migrations, git=None):\n    \"\"\"Exact package blobs of ``spec.sha`` -> ``<release_root>/<sha>``; returns the file count.\"\"\"\n    spec = spec.validated()\n    require(isinstance(package_manifest_sha256, str) and HEX64.fullmatch(package_manifest_sha256),\n            'package-identity-missing')\n    files = package_backend_release.source_files(repo, spec.sha, git)\n    require(hashlib.sha256(package_backend_release.release_manifest(spec.sha, files)).hexdigest()\n            == package_manifest_sha256, 'package-identity-mismatch')\n    sql = {p.split('/', 2)[2]: b for p, b in files.items() if re.fullmatch(r'backend/migrations/[^/]+\\.sql', p)}\n    names = migration_manifest(files['backend/scripts/migrate.py'], sql)\n    require(list(names) == list(migrations), 'layout-migrations-differ-from-plan')\n    return write_release(spec.release_root, spec.sha, files, topology_contract(spec, manifest), names, spec.image)\n\n\ndef write_hold_override(spec):\n    \"\"\"Exclusive creation of the public hold file; an existing file must be identical.\"\"\"\n    path = no_symlink(Path(spec.hold_override))\n    data = HOLD_OVERRIDE.encode()\n    if os.path.lexists(path):\n        require(stat.S_ISREG(os.lstat(path).st_mode) and path.read_bytes() == data, 'candidate-hold-mismatch')\n        return\n    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)\n    with os.fdopen(fd, 'wb') as handle:\n        handle.write(data)\n\n\nclass CandidateRunner(PopenRunner):\n    \"\"\"PopenRunner whose allowlist is exactly the argv this spec's CandidatePort builds.\"\"\"\n\n    def __init__(self, spec, **kwargs):\n        self.spec = spec.validated()\n        super().__init__(**kwargs)\n\n    def _allowed(self, argv):\n        if argv in (INFO_ARGV, self.spec.compose_argv(), self.spec.ps_argv()):\n            return True\n        if len(argv) == 3 and argv[:2] == ('docker', 'start'):\n            return HEX64.fullmatch(argv[2]) is not None\n        if len(argv) == 8 and HEX64.fullmatch(argv[2]):\n            return argv == self.spec.smoke_argv(argv[2])\n        return (6 < len(argv) <= 10 and argv[:6] == ('docker', 'inspect', '--type', 'container', '--format',\n                                                     CANDIDATE_TEMPLATE)\n                and all(HEX64.fullmatch(i) for i in argv[6:]) and len(set(argv[6:])) == len(argv[6:]))\n\n    def _env(self):\n        # Path of the private configuration only; Compose reads it, this process never does.\n        return {**super()._env(), 'PASTORAI_ENV_FILE': self.spec.env_file}\n\n\nclass CandidatePort:\n    def __init__(self, spec, *, runner):\n        require(isinstance(spec, CandidateSpec), 'candidate-spec')\n        require(callable(runner), 'candidate-runner')\n        self.spec, self.runner = spec.validated(), runner\n\n    def _run(self, argv, timeout, limit):\n        outcome = None\n        try:\n            result = self.runner(argv, timeout=timeout, max_output=limit)\n        except TimeoutError:\n            outcome = 'candidate-timeout'\n        except Exception:\n            outcome = 'candidate-runner-failed'\n        require(outcome is None, outcome)\n        require(isinstance(result, tuple) and len(result) == 2 and type(result[0]) is int\n                and type(result[1]) is bytes and len(result[1]) <= limit, 'candidate-runner-failed')\n        return result\n\n    def _daemon(self):\n        rc, out = self._run(INFO_ARGV, 10, LIMITS['info'])\n        ok, value = _attempt(_lines, out)\n        require(rc == 0 and ok and value == [self.spec.daemon_id], 'candidate-daemon-mismatch')\n\n    def project_ids(self):\n        self._daemon()\n        rc, out = self._run(self.spec.ps_argv(), 10, LIMITS['ps'])\n        ok, text = _attempt(bytes.decode, out, 'ascii')\n        require(rc == 0 and ok and (text == '' or text.endswith('\\n')), 'candidate-ps-failed')\n        ids = text.split()\n        require(all(HEX64.fullmatch(i) for i in ids) and len(set(ids)) == len(ids), 'candidate-ps-failed')\n        return tuple(sorted(ids))\n\n    def create_held(self):\n        self._daemon()\n        rc, _ = self._run(self.spec.compose_argv(), 60, LIMITS['compose'])\n        require(rc == 0, 'candidate-create-failed')\n\n    def inspect(self, ids):\n        require(isinstance(ids, (tuple, list)) and 1 <= len(ids) <= 4\n                and all(isinstance(i, str) and HEX64.fullmatch(i) for i in ids), 'candidate-ids')\n        self._daemon()\n        rc, out = self._run(('docker', 'inspect', '--type', 'container', '--format', CANDIDATE_TEMPLATE, *ids),\n                            10, LIMITS['inspect'])\n        require(rc == 0, 'candidate-inspect-failed')\n        ok, rows = _attempt(_lines, out)\n        require(ok and all(isinstance(r, list) and len(r) == 19 for r in rows)\n                and [r[1] for r in rows] == list(ids), 'candidate-inspect-malformed')\n        return {row[1]: self._row(row) for row in rows}\n\n    @staticmethod\n    def _row(row):\n        (name, ident, image, project, service, revision, status, running, paused, restarting, exit_code, started,\n         health, restarts, policy, _mode, gates, mounts, networks) = row\n        require(isinstance(name, str) and name.startswith('/') and isinstance(image, str)\n                and isinstance(status, str) and status in STATUSES and type(running) is bool\n                and running == (status == 'running') and paused is False and restarting is False\n                and type(exit_code) is int and isinstance(started, str) and STARTED.fullmatch(started)\n                and (health is None or isinstance(health, str))\n                and type(restarts) is int and restarts >= 0 and isinstance(policy, str),\n                'candidate-inspect-state')\n        gates = _tail(gates, 'candidate-inspect-gates')\n        require(all(isinstance(g, str) and '=' in g for g in gates), 'candidate-inspect-gates')\n        values = dict(g.split('=', 1) for g in gates)\n        require(len(values) == len(gates) and set(values) <= set(MANDATORY_GATES), 'candidate-inspect-gates')\n        networks = _tail(networks, 'candidate-inspect-networks')\n        require(all(isinstance(n, list) and len(n) == 3 and isinstance(n[2], str) for n in networks),\n                'candidate-inspect-networks')\n        _tail(mounts, 'candidate-inspect-mounts')\n        labels = [None if v in (None, '') else v for v in (project, service, revision)]\n        return dict(id=ident, name=name[1:], image=image, project=labels[0], service=labels[1], revision=labels[2],\n                    status=status, running=running, exit_code=exit_code, started=started, health=health,\n                    restart_count=restarts, restart_policy=policy or 'no', gates=values,\n                    networks=sorted(n[2] for n in networks))\n\n    def start_backend(self, backend_id):\n        require(isinstance(backend_id, str) and HEX64.fullmatch(backend_id), 'candidate-ids')\n        self._daemon()\n        rc, out = self._run(('docker', 'start', backend_id), 30, LIMITS['effect'])\n        require(rc == 0 and out == (backend_id + '\\n').encode(), 'candidate-start-receipt')\n\n    def smoke(self, backend_id):\n        require(isinstance(backend_id, str) and HEX64.fullmatch(backend_id), 'candidate-ids')\n        self._daemon()\n        rc, out = self._run(self.spec.smoke_argv(backend_id), self.spec.smoke_seconds + 10, LIMITS['smoke'])\n        ok, value = _attempt(_lines, out)\n        require(rc == 0 and ok and len(value) == 1 and isinstance(value[0], dict)\n                and set(value[0]) == SMOKE_KEYS, 'candidate-smoke-malformed')\n        result = value[0]\n        require(result['health'] == 200 and result['health_ok'] is True, 'candidate-health-failed')\n        require(result['ready'] == 200 and result['required_ok'] is True\n                and result['ready_status'] in ('ready', 'degraded'), 'candidate-ready-failed')\n        return dict(health=200, ready=200, ready_status=result['ready_status'])\n\n\ndef check_identity(spec, role, state):\n    \"\"\"Pinned image/revision, own project/service/name, single network, every gate closed.\"\"\"\n    require(state['image'] == spec.image and state['revision'] == spec.sha, 'candidate-image-mismatch')\n    require(state['project'] == spec.project and state['service'] == role\n            and state['name'] == spec.names()[role], 'candidate-identity-mismatch')\n    require(state['networks'] == [spec.network_id], 'candidate-network-mismatch')\n    require(all(state['gates'].get(g, CLOSED_GATES[g]) == CLOSED_GATES[g] for g in MANDATORY_GATES),\n            'candidate-gate-open')\n\n\ndef check_held(state, created=None):\n    \"\"\"Created, never started, restart=no; unchanged since its creation receipt when given.\"\"\"\n    require(state['status'] == 'created' and state['running'] is False and state['restart_count'] == 0\n            and state['started'] == ZERO_STARTED and state['restart_policy'] == 'no', 'candidate-consumer-not-held')\n    if created is not None:\n        require(state['started'] == created['started'] and state['restart_count'] == created['restart_count'],\n                'candidate-consumer-not-held')\n\n\ndef check_backend_running(state, started=None):\n    require(state['status'] == 'running' and state['running'] is True and state['restart_count'] == 0\n            and state['started'] != ZERO_STARTED and state['restart_policy'] == 'no', 'candidate-backend-not-running')\n    if started is not None:\n        require(state['started'] == started, 'candidate-backend-restarted')\n","numLines":309,"startLine":1,"totalLines":309}},"tool_result_meta":[{"id":"toolu_01GAdVXWwC3rt8ayCDrkUYEi","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgYfDtuP9Myae53F65GLa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011eFDusUb596mHdxVNA6Unh","name":"Read","input":{"file_path":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_database.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":935,"cache_read_input_tokens":21365,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":935},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b7c0715d-1aa9-47c4-a1be-b9d449b8e96c","uuid":"4a69af0d-17e6-42f0-a0ac-dddacd8e286f","timestamp":"2026-10-30T15:29:35.530Z","request_id":"req_011CgYfDtbH6yRvZRhvtK7Rq","wire_tool_inputs":{"toolu_011eFDusUb596mHdxVNA6Unh":{"file_path":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_database.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011eFDusUb596mHdxVNA6Unh","type":"tool_result","content":"1\t\"\"\"Read-only PostgreSQL observations of the first transition over an injected connection.\n2\t\n3\t``ReadOnlyDatabase.observe`` opens a fresh connection from the injected factory,\n4\truns one ``REPEATABLE READ READ ONLY`` transaction and returns aggregates only:\n5\tdatabase identity, role visibility over pg_stat_activity, the ordered ledger,\n6\tthe public catalog digest (same query as the local adapter), invalid indexes,\n7\tindex builds, writing sessions and active leases. No row payload, query text,\n8\tPII or session detail is read. ``LedgerProof`` binds that observation to an\n9\texpected identity/baseline ledger/catalog: any DDL or ledger drift refuses. It\n10\tis the fresh database proof the observed driver requires before every resume\n11\teffect; a journal without a DDL marker alone is never accepted as that proof.\n12\t\n13\tNothing connects at import or construction. The real connection factory and\n14\texpected values are Phase 3 inputs (A5 preflight); errors are fixed codes.\n15\t\"\"\"\n16\tfrom __future__ import annotations\n17\t\n18\tfrom collections.abc import Callable\n19\tfrom dataclasses import dataclass\n20\timport re\n21\t\n22\tfrom first_transition_adapter import digest\n23\tfrom initial_transition_ops import Refused, require\n24\t\n25\tHEX64 = re.compile('[0-9a-f]{64}')\n26\tIDENT = re.compile('[a-z_][a-z0-9_]{0,62}')\n27\tAPPLICATION = re.compile(r'[A-Za-z0-9_.:-]{1,63}')\n28\tLEDGER_NAME = re.compile(r'[A-Za-z0-9_.-]{1,200}\\.sql')\n29\t# Lease columns of the consumers (active lease = column > now()). Counted, never read.\n30\tLEASES = (('broadcast_execucoes', 'lease_ate'), ('broadcast_entregas', 'lease_ate'),\n31\t          ('notification_outbox', 'claimed_until'), ('cell_report_audio_inputs', 'lease_until'))\n32\tOBSERVER_APPLICATION = 'igreja12-first-transition-observer'\n33\t\n34\tCURRENT_DB = '(SELECT oid FROM pg_database WHERE datname=current_database())'\n35\tQ_BEGIN = 'BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY'\n36\tQ_TIMEOUT = \"SELECT set_config('statement_timeout', %s, true)\"\n37\tQ_PATH = \"SELECT set_config('search_path', 'pg_catalog,public', true)\"\n38\tQ_READ_ONLY = \"SELECT current_setting('transaction_read_only')\"\n39\tQ_IDENTITY = ('SELECT s.system_identifier::text, d.oid::bigint, d.datname FROM pg_control_system() s, '\n40\t              'pg_database d WHERE d.datname=current_database()')\n41\tQ_VISIBILITY = (\"SELECT r.rolsuper OR pg_has_role(current_user, 'pg_read_all_stats', 'MEMBER') \"\n42\t                'FROM pg_roles r WHERE r.rolname=current_user')\n43\tQ_LEDGER = 'SELECT name FROM public.schema_migrations ORDER BY name COLLATE \"C\"'\n44\tQ_INVALID = ('SELECT c.relname FROM pg_index i JOIN pg_class c ON c.oid=i.indexrelid JOIN pg_namespace n '\n45\t             \"ON n.oid=c.relnamespace WHERE n.nspname='public' AND NOT (i.indisvalid AND i.indisready) \"\n46\t             'ORDER BY c.relname')\n47\tQ_INDEXES = (\"SELECT c.relname FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace \"\n48\t             \"WHERE n.nspname='public' AND c.relkind='i' ORDER BY c.relname\")\n49\tQ_BUILDS = 'SELECT count(*) FROM pg_stat_progress_create_index WHERE datid=' + CURRENT_DB\n50\tQ_CATALOG = ('SELECT c.oid,c.relname,c.relkind,a.attnum,a.attname,a.atttypid,a.attnotnull FROM pg_class c '\n51\t             'JOIN pg_namespace n ON n.oid=c.relnamespace LEFT JOIN pg_attribute a ON a.attrelid=c.oid '\n52\t             \"AND a.attnum>0 AND NOT a.attisdropped WHERE n.nspname='public' ORDER BY c.oid,a.attnum\")\n53\t# Writing = in a transaction, holding an xid or not idle. Only counted; never query/user/address.\n54\tQ_WRITERS = ('SELECT count(*) FROM pg_stat_activity WHERE datid=' + CURRENT_DB + ' AND pid<>pg_backend_pid() '\n55\t             \"AND backend_type='client backend' AND (backend_xid IS NOT NULL OR state IS DISTINCT FROM 'idle') \"\n56\t             'AND NOT (backend_xid IS NULL AND application_name = ANY(%s))')\n57\tQ_RELATION = \"SELECT to_regclass(%s) IS NOT NULL\"\n58\t\n59\t\n60\tdef lease_query(table, column):\n61\t    require(IDENT.fullmatch(table) and IDENT.fullmatch(column), 'database-lease-scope')\n62\t    return f'SELECT count(*) FROM public.\"{table}\" WHERE \"{column}\" > now()'\n63\t\n64\t\n65\tdef _single(cur, query, params=None):\n66\t    cur.execute(query, params) if params is not None else cur.execute(query)\n67\t    rows = cur.fetchall()\n68\t    require(isinstance(rows, (list, tuple)) and len(rows) == 1 and len(rows[0]) >= 1, 'database-observation-shape')\n69\t    return rows[0]\n70\t\n71\t\n72\tdef _count(cur, query, params=None):\n73\t    value = _single(cur, query, params)[0]\n74\t    require(type(value) is int and 0 <= value <= 2**62, 'database-observation-shape')\n75\t    return value\n76\t\n77\t\n78\t@dataclass(frozen=True)\n79\tclass DatabaseExpectation:\n80\t    \"\"\"Identity + exact baseline ledger + catalog digest, from configuration (A5).\"\"\"\n81\t    identity: str\n82\t    ledger: tuple\n83\t    catalog: str\n84\t\n85\t    def validated(self):\n86\t        require(isinstance(self.identity, str) and HEX64.fullmatch(self.identity)\n87\t                and isinstance(self.catalog, str) and HEX64.fullmatch(self.catalog)\n88\t                and type(self.ledger) is tuple and self.ledger\n89\t                and all(isinstance(n, str) and LEDGER_NAME.fullmatch(n) for n in self.ledger)\n90\t                and list(self.ledger) == sorted(set(self.ledger)), 'database-expectation')\n91\t        return self\n92\t\n93\t    @property\n94\t    def baseline_digest(self):\n95\t        # Same value as first_transition_adapter.baseline_digest over an observation.\n96\t        return digest([list(self.ledger), self.catalog])\n97\t\n98\t\n99\tclass ReadOnlyDatabase:\n100\t    def __init__(self, connect: Callable, *, lease_columns=LEASES, observer_applications=()):\n101\t        require(callable(connect), 'database-connect-missing')\n102\t        require(isinstance(lease_columns, tuple) and lease_columns and all(\n103\t            isinstance(p, tuple) and len(p) == 2 and all(isinstance(v, str) and IDENT.fullmatch(v) for v in p)\n104\t            for p in lease_columns) and len(set(lease_columns)) == len(lease_columns), 'database-lease-scope')\n105\t        require(isinstance(observer_applications, tuple) and len(observer_applications) <= 8\n106\t                and all(isinstance(a, str) and APPLICATION.fullmatch(a) for a in observer_applications),\n107\t                'database-observer-scope')\n108\t        self.connect, self.lease_columns = connect, lease_columns\n109\t        self.observer_applications = (OBSERVER_APPLICATION, *observer_applications)\n110\t\n111\t    def observe(self, *, timeout=10):\n112\t        require(type(timeout) in (int, float) and 0 < timeout <= 30, 'database-timeout-bound')\n113\t        conn, outcome = None, None\n114\t        try:\n115\t            conn = self.connect(timeout=timeout)\n116\t            result = self._observe(conn, timeout)\n117\t        except Refused as exc:\n118\t            outcome = str(exc) if str(exc).startswith('database-') else 'database-observation-failed'\n119\t        except Exception:\n120\t            outcome = 'database-observation-failed'\n121\t        finally:\n122\t            if conn is not None:\n123\t                try:\n124\t                    conn.close()\n125\t                except Exception:\n126\t                    outcome = outcome or 'database-observation-failed'\n127\t        require(outcome is None, outcome)\n128\t        return result\n129\t\n130\t    def _observe(self, conn, timeout):\n131\t        conn.autocommit = True\n132\t        cur = conn.cursor()\n133\t        cur.execute(Q_BEGIN)\n134\t        try:\n135\t            _single(cur, Q_TIMEOUT, (f'{int(timeout * 1000)}ms',))\n136\t            _single(cur, Q_PATH)\n137\t            read_only = _single(cur, Q_READ_ONLY)[0] == 'on'\n138\t            require(read_only, 'database-not-read-only')\n139\t            system, oid, name = _single(cur, Q_IDENTITY)[:3]\n140\t            require(isinstance(system, str) and system.isdigit() and type(oid) is int and isinstance(name, str),\n141\t                    'database-observation-shape')\n142\t            visible = _single(cur, Q_VISIBILITY)[0]\n143\t            require(visible is True, 'database-activity-not-visible')\n144\t            cur.execute(Q_LEDGER)\n145\t            ledger = tuple(row[0] for row in cur.fetchall())\n146\t            require(all(isinstance(n, str) and LEDGER_NAME.fullmatch(n) for n in ledger), 'database-ledger-shape')\n147\t            cur.execute(Q_INVALID)\n148\t            invalid = tuple(row[0] for row in cur.fetchall())\n149\t            cur.execute(Q_INDEXES)\n150\t            indexes = tuple(row[0] for row in cur.fetchall())\n151\t            builds = _count(cur, Q_BUILDS)\n152\t            cur.execute(Q_CATALOG)\n153\t            catalog = digest([list(row) for row in cur.fetchall()])\n154\t            writers = _count(cur, Q_WRITERS, (list(self.observer_applications),))\n155\t            leases = 0\n156\t            for table, column in self.lease_columns:\n157\t                require(_single(cur, Q_RELATION, ('public.' + table,))[0] is True, 'database-lease-relation')\n158\t                leases += _count(cur, lease_query(table, column))\n159\t            return dict(identity=digest([system, oid, name]), read_only=True, activity_visible=True,\n160\t                        ledger=ledger, ledger_digest=digest(list(ledger)), catalog=catalog, invalid=invalid,\n161\t                        indexes=indexes, index_builds=builds, writing_sessions=writers, active_leases=leases)\n162\t        finally:\n163\t            cur.execute('ROLLBACK')\n164\t\n165\t\n166\tdef require_ddl_free(observation, expected):\n167\t    \"\"\"The observed database is exactly the expected baseline: no DDL, no ledger drift.\"\"\"\n168\t    require(observation['read_only'] is True and observation['activity_visible'] is True, 'database-not-read-only')\n169\t    require(observation['identity'] == expected.identity, 'database-identity-mismatch')\n170\t    require(observation['ledger'] == expected.ledger, 'database-ledger-drift')\n171\t    require(observation['catalog'] == expected.catalog, 'database-ddl-drift')\n172\t    require(not observation['invalid'] and observation['index_builds'] == 0, 'database-ddl-in-progress')\n173\t\n174\t\n175\tdef require_quiet(observation):\n176\t    require(observation['writing_sessions'] == 0, 'database-writing-session')\n177\t    require(observation['active_leases'] == 0, 'database-active-lease')\n178\t\n179\t\n180\tdef summary(observation):\n181\t    \"\"\"Journal-safe aggregates (no names beyond the ledger digest).\"\"\"\n182\t    return {key: observation[key] for key in ('identity', 'ledger_digest', 'catalog', 'index_builds',\n183\t                                             'writing_sessions', 'active_leases')} | dict(\n184\t        ledger_count=len(observation['ledger']), invalid_count=len(observation['invalid']))\n185\t\n186\t\n187\tclass LedgerProof:\n188\t    \"\"\"Fresh read-only proof, bound to a host scope, that no DDL ran since the baseline.\"\"\"\n189\t\n190\t    def __init__(self, database, expected, *, scope):\n191\t        require(isinstance(database, ReadOnlyDatabase), 'database-proof-source')\n192\t        require(isinstance(expected, DatabaseExpectation), 'database-expectation')\n193\t        require(isinstance(scope, str) and HEX64.fullmatch(scope), 'database-proof-scope')\n194\t        self.database, self.expected, self.scope = database, expected.validated(), scope\n195\t\n196\t    def prove(self, scope, *, timeout):\n197\t        require(scope == self.scope, 'database-proof-scope')\n198\t        observation = self.database.observe(timeout=min(timeout, 30))\n199\t        require_ddl_free(observation, self.expected)\n200\t        return dict(scope=scope, read_only=True, ddl_free=True, identity=observation['identity'],\n201\t                    ledger_digest=observation['ledger_digest'], catalog=observation['catalog'])\n202\t\n203\t\n204\tdef psycopg2_connector(secret, *, application_name=OBSERVER_APPLICATION):\n205\t    \"\"\"Connection factory for a future authorized run; the URL comes only from ``secret()``.\n206\t\n207\t    The session is forced read-only by default; the URL is never stored,\n208\t    logged or put in argv. Unused by tests.\n209\t    \"\"\"\n210\t    require(callable(secret) and APPLICATION.fullmatch(application_name), 'database-connect-missing')\n211\t\n212\t    def connect(*, timeout):\n213\t        import psycopg2\n214\t        url = secret()\n215\t        require(isinstance(url, str) and url.startswith('postgresql://') and '\\n' not in url, 'database-secret')\n216\t        return psycopg2.connect(url, connect_timeout=max(1, int(timeout)), application_name=application_name,\n217\t                                options='-c default_transaction_read_only=on')\n218\t    return connect\n219\t"}]},"parent_tool_use_id":null,"session_id":"b7c0715d-1aa9-47c4-a1be-b9d449b8e96c","uuid":"db738811-1ef5-4c41-984d-f3cf05e750b8","timestamp":"2026-10-30T15:29:35.547Z","tool_use_result":{"type":"text","file":{"filePath":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_database.py","content":"\"\"\"Read-only PostgreSQL observations of the first transition over an injected connection.\n\n``ReadOnlyDatabase.observe`` opens a fresh connection from the injected factory,\nruns one ``REPEATABLE READ READ ONLY`` transaction and returns aggregates only:\ndatabase identity, role visibility over pg_stat_activity, the ordered ledger,\nthe public catalog digest (same query as the local adapter), invalid indexes,\nindex builds, writing sessions and active leases. No row payload, query text,\nPII or session detail is read. ``LedgerProof`` binds that observation to an\nexpected identity/baseline ledger/catalog: any DDL or ledger drift refuses. It\nis the fresh database proof the observed driver requires before every resume\neffect; a journal without a DDL marker alone is never accepted as that proof.\n\nNothing connects at import or construction. The real connection factory and\nexpected values are Phase 3 inputs (A5 preflight); errors are fixed codes.\n\"\"\"\nfrom __future__ import annotations\n\nfrom collections.abc import Callable\nfrom dataclasses import dataclass\nimport re\n\nfrom first_transition_adapter import digest\nfrom initial_transition_ops import Refused, require\n\nHEX64 = re.compile('[0-9a-f]{64}')\nIDENT = re.compile('[a-z_][a-z0-9_]{0,62}')\nAPPLICATION = re.compile(r'[A-Za-z0-9_.:-]{1,63}')\nLEDGER_NAME = re.compile(r'[A-Za-z0-9_.-]{1,200}\\.sql')\n# Lease columns of the consumers (active lease = column > now()). Counted, never read.\nLEASES = (('broadcast_execucoes', 'lease_ate'), ('broadcast_entregas', 'lease_ate'),\n          ('notification_outbox', 'claimed_until'), ('cell_report_audio_inputs', 'lease_until'))\nOBSERVER_APPLICATION = 'igreja12-first-transition-observer'\n\nCURRENT_DB = '(SELECT oid FROM pg_database WHERE datname=current_database())'\nQ_BEGIN = 'BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY'\nQ_TIMEOUT = \"SELECT set_config('statement_timeout', %s, true)\"\nQ_PATH = \"SELECT set_config('search_path', 'pg_catalog,public', true)\"\nQ_READ_ONLY = \"SELECT current_setting('transaction_read_only')\"\nQ_IDENTITY = ('SELECT s.system_identifier::text, d.oid::bigint, d.datname FROM pg_control_system() s, '\n              'pg_database d WHERE d.datname=current_database()')\nQ_VISIBILITY = (\"SELECT r.rolsuper OR pg_has_role(current_user, 'pg_read_all_stats', 'MEMBER') \"\n                'FROM pg_roles r WHERE r.rolname=current_user')\nQ_LEDGER = 'SELECT name FROM public.schema_migrations ORDER BY name COLLATE \"C\"'\nQ_INVALID = ('SELECT c.relname FROM pg_index i JOIN pg_class c ON c.oid=i.indexrelid JOIN pg_namespace n '\n             \"ON n.oid=c.relnamespace WHERE n.nspname='public' AND NOT (i.indisvalid AND i.indisready) \"\n             'ORDER BY c.relname')\nQ_INDEXES = (\"SELECT c.relname FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace \"\n             \"WHERE n.nspname='public' AND c.relkind='i' ORDER BY c.relname\")\nQ_BUILDS = 'SELECT count(*) FROM pg_stat_progress_create_index WHERE datid=' + CURRENT_DB\nQ_CATALOG = ('SELECT c.oid,c.relname,c.relkind,a.attnum,a.attname,a.atttypid,a.attnotnull FROM pg_class c '\n             'JOIN pg_namespace n ON n.oid=c.relnamespace LEFT JOIN pg_attribute a ON a.attrelid=c.oid '\n             \"AND a.attnum>0 AND NOT a.attisdropped WHERE n.nspname='public' ORDER BY c.oid,a.attnum\")\n# Writing = in a transaction, holding an xid or not idle. Only counted; never query/user/address.\nQ_WRITERS = ('SELECT count(*) FROM pg_stat_activity WHERE datid=' + CURRENT_DB + ' AND pid<>pg_backend_pid() '\n             \"AND backend_type='client backend' AND (backend_xid IS NOT NULL OR state IS DISTINCT FROM 'idle') \"\n             'AND NOT (backend_xid IS NULL AND application_name = ANY(%s))')\nQ_RELATION = \"SELECT to_regclass(%s) IS NOT NULL\"\n\n\ndef lease_query(table, column):\n    require(IDENT.fullmatch(table) and IDENT.fullmatch(column), 'database-lease-scope')\n    return f'SELECT count(*) FROM public.\"{table}\" WHERE \"{column}\" > now()'\n\n\ndef _single(cur, query, params=None):\n    cur.execute(query, params) if params is not None else cur.execute(query)\n    rows = cur.fetchall()\n    require(isinstance(rows, (list, tuple)) and len(rows) == 1 and len(rows[0]) >= 1, 'database-observation-shape')\n    return rows[0]\n\n\ndef _count(cur, query, params=None):\n    value = _single(cur, query, params)[0]\n    require(type(value) is int and 0 <= value <= 2**62, 'database-observation-shape')\n    return value\n\n\n@dataclass(frozen=True)\nclass DatabaseExpectation:\n    \"\"\"Identity + exact baseline ledger + catalog digest, from configuration (A5).\"\"\"\n    identity: str\n    ledger: tuple\n    catalog: str\n\n    def validated(self):\n        require(isinstance(self.identity, str) and HEX64.fullmatch(self.identity)\n                and isinstance(self.catalog, str) and HEX64.fullmatch(self.catalog)\n                and type(self.ledger) is tuple and self.ledger\n                and all(isinstance(n, str) and LEDGER_NAME.fullmatch(n) for n in self.ledger)\n                and list(self.ledger) == sorted(set(self.ledger)), 'database-expectation')\n        return self\n\n    @property\n    def baseline_digest(self):\n        # Same value as first_transition_adapter.baseline_digest over an observation.\n        return digest([list(self.ledger), self.catalog])\n\n\nclass ReadOnlyDatabase:\n    def __init__(self, connect: Callable, *, lease_columns=LEASES, observer_applications=()):\n        require(callable(connect), 'database-connect-missing')\n        require(isinstance(lease_columns, tuple) and lease_columns and all(\n            isinstance(p, tuple) and len(p) == 2 and all(isinstance(v, str) and IDENT.fullmatch(v) for v in p)\n            for p in lease_columns) and len(set(lease_columns)) == len(lease_columns), 'database-lease-scope')\n        require(isinstance(observer_applications, tuple) and len(observer_applications) <= 8\n                and all(isinstance(a, str) and APPLICATION.fullmatch(a) for a in observer_applications),\n                'database-observer-scope')\n        self.connect, self.lease_columns = connect, lease_columns\n        self.observer_applications = (OBSERVER_APPLICATION, *observer_applications)\n\n    def observe(self, *, timeout=10):\n        require(type(timeout) in (int, float) and 0 < timeout <= 30, 'database-timeout-bound')\n        conn, outcome = None, None\n        try:\n            conn = self.connect(timeout=timeout)\n            result = self._observe(conn, timeout)\n        except Refused as exc:\n            outcome = str(exc) if str(exc).startswith('database-') else 'database-observation-failed'\n        except Exception:\n            outcome = 'database-observation-failed'\n        finally:\n            if conn is not None:\n                try:\n                    conn.close()\n                except Exception:\n                    outcome = outcome or 'database-observation-failed'\n        require(outcome is None, outcome)\n        return result\n\n    def _observe(self, conn, timeout):\n        conn.autocommit = True\n        cur = conn.cursor()\n        cur.execute(Q_BEGIN)\n        try:\n            _single(cur, Q_TIMEOUT, (f'{int(timeout * 1000)}ms',))\n            _single(cur, Q_PATH)\n            read_only = _single(cur, Q_READ_ONLY)[0] == 'on'\n            require(read_only, 'database-not-read-only')\n            system, oid, name = _single(cur, Q_IDENTITY)[:3]\n            require(isinstance(system, str) and system.isdigit() and type(oid) is int and isinstance(name, str),\n                    'database-observation-shape')\n            visible = _single(cur, Q_VISIBILITY)[0]\n            require(visible is True, 'database-activity-not-visible')\n            cur.execute(Q_LEDGER)\n            ledger = tuple(row[0] for row in cur.fetchall())\n            require(all(isinstance(n, str) and LEDGER_NAME.fullmatch(n) for n in ledger), 'database-ledger-shape')\n            cur.execute(Q_INVALID)\n            invalid = tuple(row[0] for row in cur.fetchall())\n            cur.execute(Q_INDEXES)\n            indexes = tuple(row[0] for row in cur.fetchall())\n            builds = _count(cur, Q_BUILDS)\n            cur.execute(Q_CATALOG)\n            catalog = digest([list(row) for row in cur.fetchall()])\n            writers = _count(cur, Q_WRITERS, (list(self.observer_applications),))\n            leases = 0\n            for table, column in self.lease_columns:\n                require(_single(cur, Q_RELATION, ('public.' + table,))[0] is True, 'database-lease-relation')\n                leases += _count(cur, lease_query(table, column))\n            return dict(identity=digest([system, oid, name]), read_only=True, activity_visible=True,\n                        ledger=ledger, ledger_digest=digest(list(ledger)), catalog=catalog, invalid=invalid,\n                        indexes=indexes, index_builds=builds, writing_sessions=writers, active_leases=leases)\n        finally:\n            cur.execute('ROLLBACK')\n\n\ndef require_ddl_free(observation, expected):\n    \"\"\"The observed database is exactly the expected baseline: no DDL, no ledger drift.\"\"\"\n    require(observation['read_only'] is True and observation['activity_visible'] is True, 'database-not-read-only')\n    require(observation['identity'] == expected.identity, 'database-identity-mismatch')\n    require(observation['ledger'] == expected.ledger, 'database-ledger-drift')\n    require(observation['catalog'] == expected.catalog, 'database-ddl-drift')\n    require(not observation['invalid'] and observation['index_builds'] == 0, 'database-ddl-in-progress')\n\n\ndef require_quiet(observation):\n    require(observation['writing_sessions'] == 0, 'database-writing-session')\n    require(observation['active_leases'] == 0, 'database-active-lease')\n\n\ndef summary(observation):\n    \"\"\"Journal-safe aggregates (no names beyond the ledger digest).\"\"\"\n    return {key: observation[key] for key in ('identity', 'ledger_digest', 'catalog', 'index_builds',\n                                             'writing_sessions', 'active_leases')} | dict(\n        ledger_count=len(observation['ledger']), invalid_count=len(observation['invalid']))\n\n\nclass LedgerProof:\n    \"\"\"Fresh read-only proof, bound to a host scope, that no DDL ran since the baseline.\"\"\"\n\n    def __init__(self, database, expected, *, scope):\n        require(isinstance(database, ReadOnlyDatabase), 'database-proof-source')\n        require(isinstance(expected, DatabaseExpectation), 'database-expectation')\n        require(isinstance(scope, str) and HEX64.fullmatch(scope), 'database-proof-scope')\n        self.database, self.expected, self.scope = database, expected.validated(), scope\n\n    def prove(self, scope, *, timeout):\n        require(scope == self.scope, 'database-proof-scope')\n        observation = self.database.observe(timeout=min(timeout, 30))\n        require_ddl_free(observation, self.expected)\n        return dict(scope=scope, read_only=True, ddl_free=True, identity=observation['identity'],\n                    ledger_digest=observation['ledger_digest'], catalog=observation['catalog'])\n\n\ndef psycopg2_connector(secret, *, application_name=OBSERVER_APPLICATION):\n    \"\"\"Connection factory for a future authorized run; the URL comes only from ``secret()``.\n\n    The session is forced read-only by default; the URL is never stored,\n    logged or put in argv. Unused by tests.\n    \"\"\"\n    require(callable(secret) and APPLICATION.fullmatch(application_name), 'database-connect-missing')\n\n    def connect(*, timeout):\n        import psycopg2\n        url = secret()\n        require(isinstance(url, str) and url.startswith('postgresql://') and '\\n' not in url, 'database-secret')\n        return psycopg2.connect(url, connect_timeout=max(1, int(timeout)), application_name=application_name,\n                                options='-c default_transaction_read_only=on')\n    return connect\n","numLines":219,"startLine":1,"totalLines":219}},"tool_result_meta":[{"id":"toolu_011eFDusUb596mHdxVNA6Unh","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgYfDtuP9Myae53F65GLa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01B77iNGiZBXXKcY217XeAFt","name":"Read","input":{"file_path":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_orchestrator.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":935,"cache_read_input_tokens":21365,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":935},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b7c0715d-1aa9-47c4-a1be-b9d449b8e96c","uuid":"83466aad-cfa7-45dc-b006-16a2b20c613a","timestamp":"2026-10-30T15:29:35.947Z","request_id":"req_011CgYfDtbH6yRvZRhvtK7Rq","wire_tool_inputs":{"toolu_01B77iNGiZBXXKcY217XeAFt":{"file_path":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_orchestrator.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B77iNGiZBXXKcY217XeAFt","type":"tool_result","content":"1\t\"\"\"First-transition orchestration over injected ports, up to A9 (never A10).\n2\t\n3\tSequence (one durable journal, shared with ObservedHostContract):\n4\t\n5\t1. fresh read-only database baseline equal to the configured expectation;\n6\t2. ObservedHostContract.contain(): ingress blocked, four legacy restart=no,\n7\t   SIGTERM, clean exit 0;\n8\t3. two consecutive bounded fresh observations, each with the host still\n9\t   contained and zero writing sessions and zero active leases in the database;\n10\t4. injected backup/restore + clone rehearsal receipt validated against the plan,\n11\t   identity and baseline (first_transition_adapter.validate_clone_receipt);\n12\t5. final pre-DDL re-check, then the durable irrevocable ``ddl-marker``;\n13\t6. the 51 pending migrations (43 transactional, 8 CONCURRENTLY) one by one via\n14\t   the exact pinned ``backend/scripts/migrate.py`` bytes of the Plan, each with\n15\t   a durable intent first; the first failure or doubt stops for good;\n16\t7. candidate release layout ``<release_root>/<sha>`` (first_transition_candidate);\n17\t8. A9: four candidate containers created held (restart=no, gates closed), ONLY\n18\t   the backend started and smoked; consumers proven never started; legacy\n19\t   stopped, support preserved and ingress blocked throughout.\n20\t\n21\tRecovery is objective (``recovery()``), never automatic: no undo, no retry of a\n22\tdestructive operation, no legacy resume once the DDL marker exists. A\n23\tpre-DDL legacy resume goes through ObservedHostContract.resume_legacy, whose\n24\tdriver requires a fresh read-only ledger proof before every effect.\n25\t\n26\tConfiguration (``load_config``) holds public values only; secrets reach the\n27\tmigration child exclusively through its isolated environment. Nothing runs at\n28\timport; there is no command-line entry point and no production operation here.\n29\t\"\"\"\n30\tfrom __future__ import annotations\n31\t\n32\tfrom dataclasses import dataclass\n33\timport hashlib\n34\timport json\n35\timport os\n36\tfrom pathlib import Path\n37\timport re\n38\timport stat\n39\timport subprocess\n40\timport time\n41\t\n42\tfrom first_transition_adapter import APPLICATION_SHA, EXECUTOR_SHA, ROLES, Plan, digest, validate_clone_receipt\n43\tfrom first_transition_candidate import (CONSUMERS, CandidatePort, CandidateRunner, CandidateSpec, check_backend_running,\n44\t                                        check_held, check_identity, write_candidate_release, write_hold_override)\n45\tfrom first_transition_database import (LEASES, DatabaseExpectation, LedgerProof, ReadOnlyDatabase, require_ddl_free,\n46\t                                       require_quiet, summary)\n47\tfrom first_transition_host_contract import ObservedHostContract\n48\tfrom first_transition_host_driver import HostManifest, ObservedHostDriver, PopenRunner, _absolute\n49\tfrom first_transition_host_transport import ObservedHostTransport\n50\tfrom initial_transition_files import Journal, no_symlink, read_regular\n51\tfrom initial_transition_ops import Refused, require\n52\t\n53\tCONFIG_SCHEMA = 'igreja12.first-transition-config/1'\n54\tCONFIG_KEYS = frozenset({'schema', 'repo', 'state_dir', 'migration_workdir', 'python', 'docker', 'database',\n55\t                         'host', 'candidate', 'package_manifest_sha256', 'timeouts'})\n56\tTIMEOUTS = dict(migration_s=300, observe_s=10, quiescence_interval_s=5, quiescence_budget_s=60)\n57\tSHAPE = (51, 43, 8)  # pending, transactional, CONCURRENTLY\n58\tPROCEDURES = {\n59\t    'not-started': 'nothing intended: no recovery action',\n60\t    'containment-partial': 'replay run(): contain() never re-signals; an unclean exit stays refused for a human',\n61\t    'contained-pre-ddl': 'replay run() or resume_legacy(token): fresh ledger proof before every effect',\n62\t    'resume-partial': 'replay resume_legacy(token): receipted roles re-proven, ledger proof per effect',\n63\t    'legacy-resumed': 'legacy back with ingress open: start a new journal for any later attempt',\n64\t    'ddl-ambiguous': 'stop: no retry, no legacy; inspect ledger/indexes read-only and decide restore (A6) or completion',\n65\t    'ddl-failed': 'stop: no retry, no legacy; restore from the validated backup (A6) or fix forward by a new decision',\n66\t    'post-ddl-failed': 'stop: no legacy; keep ingress blocked and inspect the failure read-only before a decision',\n67\t    'candidate-ambiguous': 'stop: no undo; inspect the candidate project read-only, nothing restarted or removed',\n68\t    'candidate-failed': 'stop: no undo; consumers stay held, ingress blocked; human decision on the backend',\n69\t    'a9-complete': 'hold: backend smoked, consumers held, ingress blocked; A10 needs its own authorization',\n70\t}\n71\tPROCESS_ENV = frozenset({'PATH', 'LC_ALL', 'LANG', 'PYTHON_DOTENV_DISABLED', 'MIGRATION_DATABASE_URL', 'PGAPPNAME',\n72\t                         'PGCONNECT_TIMEOUT'})\n73\t\n74\t\n75\tclass ProcessRunner:\n76\t    \"\"\"Generic safe runner: allowlisted absolute binaries, constructed env, no shell, output discarded.\n77\t\n78\t    The environment is the only channel for secrets: argv never carries one and\n79\t    no output is captured, so nothing can reach logs or exceptions.\n80\t    \"\"\"\n81\t\n82\t    def __init__(self, *, binaries, run=None):\n83\t        require(isinstance(binaries, tuple) and binaries and all(_absolute(b) for b in binaries)\n84\t                and (run is None or callable(run)), 'process-runner-config')\n85\t        self.binaries, self.run = binaries, run\n86\t\n87\t    def __call__(self, argv, *, env, cwd, timeout):\n88\t        require(type(argv) is tuple and argv and argv[0] in self.binaries\n89\t                and all(type(a) is str and 0 < len(a) <= 4096 and '\\x00' not in a for a in argv), 'process-argv')\n90\t        require(isinstance(env, dict) and set(env) <= PROCESS_ENV\n91\t                and all(type(v) is str and '\\x00' not in v for v in env.values()), 'process-env')\n92\t        require(_absolute(cwd) and type(timeout) in (int, float) and 0 < timeout <= 3600, 'process-bounds')\n93\t        run = self.run or subprocess.run  # resolved per call, never at import/construction\n94\t        outcome = None\n95\t        try:\n96\t            done = run(list(argv), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n97\t                       env=dict(env), cwd=cwd, timeout=timeout, close_fds=True, shell=False, check=False)\n98\t        except subprocess.TimeoutExpired:\n99\t            outcome = 'timeout'\n100\t        except Exception:\n101\t            outcome = 'process-spawn-failed'\n102\t        if outcome == 'timeout':\n103\t            raise TimeoutError('process-timeout')\n104\t        require(outcome is None and type(getattr(done, 'returncode', None)) is int, outcome or 'process-failed')\n105\t        return done.returncode\n106\t\n107\t\n108\tclass MigrationExecutor:\n109\t    \"\"\"One pending migration through the exact pinned migrate.py bytes of the Plan.\n110\t\n111\t    ``python <dir>/scripts/migrate.py apply <name> --yes [--no-transaction]``\n112\t    in a fresh exclusive directory under the configured workdir; the database\n113\t    URL comes from ``secret()`` straight into the child environment.\n114\t    \"\"\"\n115\t\n116\t    def __init__(self, plan, *, python, workdir, secret, runner, timeout=300):\n117\t        require(isinstance(plan, Plan) and plan.application_sha == APPLICATION_SHA\n118\t                and plan.executor_sha == EXECUTOR_SHA, 'migration-plan')\n119\t        require(_absolute(python) and _absolute(workdir) and callable(secret) and callable(runner)\n120\t                and type(timeout) is int and 0 < timeout <= 3600, 'migration-executor-config')\n121\t        self.plan, self.python, self.workdir = plan, python, workdir\n122\t        self.secret, self.runner, self.timeout = secret, runner, timeout\n123\t\n124\t    @staticmethod\n125\t    def command(python, directory, migration):\n126\t        return (python, '-I', f'{directory}/scripts/migrate.py', 'apply', migration.name, '--yes',\n127\t                *(('--no-transaction',) if migration.concurrent else ()))\n128\t\n129\t    def _materialize(self, index, migration):\n130\t        root = no_symlink(Path(self.workdir))\n131\t        require(os.path.lexists(root) and stat.S_ISDIR(os.lstat(root).st_mode), 'migration-workdir-missing')\n132\t        directory = root / f'{index:02d}-{self.plan.digest[:16]}'\n133\t        try:\n134\t            directory.mkdir(mode=0o700)  # exclusive: a previous attempt's directory refuses\n135\t        except FileExistsError:\n136\t            raise Refused('migration-workdir-exists') from None\n137\t        (directory / 'scripts').mkdir(mode=0o700)\n138\t        (directory / 'migrations').mkdir(mode=0o700)\n139\t        for path, data in (('scripts/migrate.py', self.plan.executor), ('migrations/' + migration.name, migration.sql)):\n140\t            fd = os.open(directory / path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)\n141\t            with os.fdopen(fd, 'wb') as handle:\n142\t                handle.write(data)\n143\t        return str(directory)\n144\t\n145\t    def apply(self, index, migration):\n146\t        require(migration in self.plan.pending and self.plan.pending[index - 1] is migration, 'migration-not-pending')\n147\t        directory = self._materialize(index, migration)\n148\t        url = self.secret()\n149\t        require(isinstance(url, str) and url.startswith('postgresql://') and '\\n' not in url, 'migration-secret')\n150\t        env = dict(PATH='/usr/bin:/bin', LC_ALL='C', PYTHON_DOTENV_DISABLED='1', MIGRATION_DATABASE_URL=url,\n151\t                   PGAPPNAME=f'pastorai-first-transition-{index:02d}', PGCONNECT_TIMEOUT='10')\n152\t        return self.runner(self.command(self.python, directory, migration), env=env, cwd=directory,\n153\t                           timeout=self.timeout)\n154\t\n155\t\n156\tclass FirstTransition:\n157\t    def __init__(self, *, plan, journal, host, database, expected, backup_proof, executor, layout, candidate,\n158\t                 config_digest, clock=time.monotonic, sleep=time.sleep, timeouts=None):\n159\t        for value, kind, code in ((plan, Plan, 'plan'), (journal, Journal, 'journal'),\n160\t                                  (host, ObservedHostContract, 'host'), (database, ReadOnlyDatabase, 'database'),\n161\t                                  (expected, DatabaseExpectation, 'expectation'),\n162\t                                  (executor, MigrationExecutor, 'executor'), (candidate, CandidatePort, 'candidate')):\n163\t            require(isinstance(value, kind), 'transition-' + code + '-missing')\n164\t        require(callable(backup_proof), 'transition-backup-missing')\n165\t        require(callable(layout), 'transition-layout-missing')\n166\t        require(journal.lock_fd is not None and host.j is journal, 'transition-journal')\n167\t        require(executor.plan is plan and candidate.spec.sha == plan.application_sha, 'transition-plan-binding')\n168\t        pending = plan.pending\n169\t        require((len(pending), sum(not m.concurrent for m in pending), sum(m.concurrent for m in pending)) == SHAPE,\n170\t                'transition-release-shape')\n171\t        require(expected.validated().ledger == plan.baseline, 'transition-expectation-baseline')\n172\t        require(isinstance(config_digest, str) and re.fullmatch('[0-9a-f]{64}', config_digest), 'transition-config')\n173\t        self.t = {**TIMEOUTS, **(timeouts or {})}\n174\t        self.plan, self.j, self.host, self.db, self.expected = plan, journal, host, database, expected\n175\t        self.backup_proof, self.executor, self.layout, self.candidate = backup_proof, executor, layout, candidate\n176\t        self.config_digest, self.clock, self.sleep = config_digest, clock, sleep\n177\t\n178\t    # -- journal helpers -------------------------------------------------------------------\n179\t    def _intent(self, step, **fields):\n180\t        return self.j.append('transition-intent', step=step, **fields)\n181\t\n182\t    def _done(self, step, **fields):\n183\t        return self.j.append('transition-done', step=step, **fields)\n184\t\n185\t    def _open(self, step):\n186\t        \"\"\"Intent without receipt: the outcome is unknown and never retried automatically.\"\"\"\n187\t        return (self.j.last('transition-intent', step) is not None\n188\t                and self.j.last('transition-done', step) is None)\n189\t\n190\t    def _observe(self):\n191\t        return self.db.observe(timeout=self.t['observe_s'])\n192\t\n193\t    def _init(self):\n194\t        init = self.j.last('transition-init')\n195\t        values = dict(plan_digest=self.plan.digest, config_digest=self.config_digest,\n196\t                      baseline_digest=self.expected.baseline_digest, application_sha=self.plan.application_sha,\n197\t                      executor_sha=self.plan.executor_sha, candidate_image=self.candidate.spec.image)\n198\t        if init is None:\n199\t            self.j.append('transition-init', production_ready=False, **values)\n200\t        else:\n201\t            require(all(init.get(k) == v for k, v in values.items()), 'transition-inputs-changed')\n202\t\n203\t    # -- entry points --------------------------------------------------------------------------\n204\t    def run(self):\n205\t        self._init()\n206\t        require(self.j.last('observed-host-intent', 'legacy-resume') is None, 'transition-legacy-resume-started')\n207\t        require(self.j.last('transition-failed') is None, 'transition-stopped')  # first failure is final\n208\t        try:\n209\t            if self.j.last('ddl-marker') is None:\n210\t                self._baseline()\n211\t                self.host.contain()\n212\t                self._quiesce()\n213\t                self._backup()\n214\t                self._mark_ddl()\n215\t            self._migrate()\n216\t            self._release_layout()\n217\t            return self._a9()\n218\t        except BaseException as exc:\n219\t            if self.j.last('ddl-marker') is not None:\n220\t                self.j.append('transition-failed', code=str(exc) if isinstance(exc, Refused) else 'interrupted',\n221\t                              legacy_resume_allowed=False)\n222\t            raise\n223\t\n224\t    def resume_legacy(self, confirmation, *, allow_queue_drift=False):\n225\t        \"\"\"Pre-DDL only; the contract and the driver's ledger proof re-check everything.\"\"\"\n226\t        require(self.j.last('ddl-marker') is None and not self.j.find('transition-intent'),\n227\t                'post-ddl-resume-forbidden')\n228\t        return self.host.resume_legacy(confirmation, allow_queue_drift=allow_queue_drift)\n229\t\n230\t    # -- pre-DDL ---------------------------------------------------------------------------------\n231\t    def _baseline(self):\n232\t        observation = self._observe()\n233\t        require_ddl_free(observation, self.expected)\n234\t        if self.j.last('transition-baseline') is None:\n235\t            self.j.append('transition-baseline', evidence='database-read-only', **summary(observation))\n236\t\n237\t    def _quiet_observation(self):\n238\t        receipt = self.host.assert_contained()\n239\t        observation = self._observe()\n240\t        require_ddl_free(observation, self.expected)\n241\t        require_quiet(observation)\n242\t        return receipt['fingerprint'], receipt['queue_digest'], summary(observation)\n243\t\n244\t    def _quiesce(self):\n245\t        start = self.clock()\n246\t        first = self._quiet_observation()\n247\t        self.sleep(self.t['quiescence_interval_s'])\n248\t        second = self._quiet_observation()\n249\t        require(self.clock() - start <= self.t['quiescence_budget_s'], 'transition-quiescence-unbounded')\n250\t        require(first == second, 'transition-quiescence-changed')\n251\t        self.j.append('transition-quiescent', observations=2, writing_sessions=0, active_leases=0,\n252\t                      host_fingerprint=first[0], queue_digest=first[1], evidence='database-read-only')\n253\t\n254\t    def _backup(self):\n255\t        receipt = self.backup_proof()\n256\t        require(isinstance(receipt, dict), 'clone-receipt-invalid')\n257\t        validate_clone_receipt(receipt, self.plan, self.expected.identity, self.expected.baseline_digest)\n258\t        recorded = self.j.last('transition-backup')\n259\t        if recorded is None:\n260\t            self.j.append('transition-backup', receipt_digest=digest(receipt), restore_verified=True)\n261\t        else:\n262\t            require(recorded['receipt_digest'] == digest(receipt), 'transition-backup-changed')\n263\t        return digest(receipt)\n264\t\n265\t    def _mark_ddl(self):\n266\t        require(self.j.last('transition-quiescent') is not None, 'transition-not-quiescent')\n267\t        # Immediately before the irrevocable marker: contained, read-only baseline, quiet, backup valid.\n268\t        self._quiet_observation()\n269\t        backup = self._backup()\n270\t        self.j.append('ddl-marker', irrevocable=True, pending=[m.name for m in self.plan.pending],\n271\t                      baseline_digest=self.expected.baseline_digest, backup_digest=backup,\n272\t                      legacy_resume_allowed=False)\n273\t\n274\t    # -- DDL ----------------------------------------------------------------------------------------\n275\t    def _migrate(self):\n276\t        ledger = list(self.plan.baseline)\n277\t        for index, migration in enumerate(self.plan.pending, 1):\n278\t            step = 'migration:' + migration.name\n279\t            if self.j.last('transition-done', step) is not None:\n280\t                ledger.append(migration.name)\n281\t                continue\n282\t            require(self.j.last('transition-intent', step) is None, 'migration-outcome-ambiguous')\n283\t            before = self._observe()\n284\t            require(before['identity'] == self.expected.identity, 'database-identity-mismatch')\n285\t            require(list(before['ledger']) == sorted(ledger), 'migration-ledger-not-prefix')\n286\t            require(not before['invalid'] and before['index_builds'] == 0, 'database-ddl-in-progress')\n287\t            require_quiet(before)\n288\t            self.host.assert_contained()\n289\t            self._intent(step, index=index, sql_sha256=migration.sha256, concurrent=migration.concurrent)\n290\t            try:\n291\t                code = self.executor.apply(index, migration)\n292\t            except TimeoutError:\n293\t                code = None\n294\t            after = self._observe()\n295\t            failure = self._migration_failure(migration, code, ledger, after)\n296\t            if failure is not None:\n297\t                # Definite only for a transactional rollback with no trace; anything else is ambiguous.\n298\t                definite = (failure == 'migration-failed' and not migration.concurrent\n299\t                            and not after['invalid'] and after['index_builds'] == 0)\n300\t                self.j.append('transition-migration-failed', step=step, code=failure, definite=definite)\n301\t                raise Refused(failure)\n302\t            self._done(step, ledger_digest=after['ledger_digest'])\n303\t            ledger.append(migration.name)\n304\t        final = self._observe()\n305\t        require(list(final['ledger']) == sorted(m.name for m in self.plan.migrations), 'final-ledger')\n306\t        if self.j.last('transition-migrated') is None:\n307\t            self.j.append('transition-migrated', ledger=len(final['ledger']), catalog=final['catalog'])\n308\t        else:\n309\t            require(self.j.last('transition-migrated')['catalog'] == final['catalog'], 'database-ddl-drift')\n310\t\n311\t    @staticmethod\n312\t    def _migration_failure(migration, code, ledger, after):\n313\t        applied = list(after['ledger']) == sorted([*ledger, migration.name])\n314\t        if code is None:\n315\t            return 'migration-timeout'\n316\t        if code != 0:\n317\t            return 'migration-ambiguous-ledger-without-success' if applied else 'migration-failed'\n318\t        if not applied:\n319\t            return 'migration-ambiguous-exit0-no-ledger'\n320\t        if after['invalid'] or after['index_builds'] or not set(migration.indexes) <= set(after['indexes']):\n321\t            return 'migration-index-invalid'\n322\t        return None\n323\t\n324\t    def _release_layout(self):\n325\t        if self.j.last('transition-done', 'layout') is None:\n326\t            self._intent('layout')\n327\t        files = self.layout()  # exclusive or byte-for-byte verification, on every invocation\n328\t        if self.j.last('transition-done', 'layout') is None:\n329\t            self._done('layout', files=files)\n330\t\n331\t    # -- A9 ----------------------------------------------------------------------------------------\n332\t    def _candidate_states(self, ids):\n333\t        states = self.candidate.inspect(tuple(ids[r] for r in ROLES))\n334\t        result = {role: states[ids[role]] for role in ROLES}\n335\t        for role, state in result.items():\n336\t            check_identity(self.candidate.spec, role, state)\n337\t        return result\n338\t\n339\t    def _held(self, ids, created, backend_started):\n340\t        \"\"\"Consumers never started, legacy contained, support preserved, ingress blocked.\"\"\"\n341\t        states = self._candidate_states(ids)\n342\t        for role in CONSUMERS:\n343\t            check_held(states[role], created[role])\n344\t        if backend_started is None:\n345\t            check_held(states['backend'], created['backend'])\n346\t        else:\n347\t            check_backend_running(states['backend'], backend_started)\n348\t        self.host.assert_contained()\n349\t        return states\n350\t\n351\t    def _a9(self):\n352\t        created = self.j.last('transition-done', 'a9:create')\n353\t        if created is None:\n354\t            require(not self._open('a9:create'), 'candidate-create-ambiguous')\n355\t            self.host.assert_contained()\n356\t            require(self.candidate.project_ids() == (), 'candidate-project-not-empty')\n357\t            write_hold_override(self.candidate.spec)\n358\t            self._intent('a9:create', project=self.candidate.spec.project)\n359\t            self.candidate.create_held()\n360\t            found = self.candidate.project_ids()\n361\t            require(len(found) == 4, 'candidate-create-scope')\n362\t            states = self.candidate.inspect(found)\n363\t            ids = {state['service']: ident for ident, state in states.items()}\n364\t            require(set(ids) == set(ROLES), 'candidate-create-scope')\n365\t            for role in ROLES:\n366\t                check_identity(self.candidate.spec, role, states[ids[role]])\n367\t                check_held(states[ids[role]])\n368\t            created = self._done('a9:create', ids=ids, created={\n369\t                role: dict(started=states[ids[role]]['started'], restart_count=states[ids[role]]['restart_count'])\n370\t                for role in ROLES})\n371\t        ids, snapshot = created['ids'], created['created']\n372\t        require(self.candidate.project_ids() == tuple(sorted(ids.values())), 'candidate-project-changed')\n373\t        started = self.j.last('transition-done', 'a9:start-backend')\n374\t        if started is None:\n375\t            require(not self._open('a9:start-backend'), 'candidate-start-ambiguous')\n376\t            self._held(ids, snapshot, None)\n377\t            self._intent('a9:start-backend', id=ids['backend'])\n378\t            self.candidate.start_backend(ids['backend'])\n379\t            state = self._candidate_states(ids)['backend']\n380\t            check_backend_running(state)\n381\t            started = self._done('a9:start-backend', started=state['started'])\n382\t        self._held(ids, snapshot, started['started'])\n383\t        smoke = self.candidate.smoke(ids['backend'])  # fresh read-only probe on every invocation\n384\t        self._held(ids, snapshot, started['started'])\n385\t        if self.j.last('transition-a9-complete') is None:\n386\t            self.j.append('transition-a9-complete', smoke=smoke, consumers='held', ingress_blocked=True,\n387\t                          a10='not-implemented')\n388\t        return dict(status='a9-backend-smoked', smoke=smoke, consumers='held', ingress_blocked=True,\n389\t                    legacy_resume_allowed=False, a10='not-implemented', production_ready=False)\n390\t\n391\t    # -- recovery --------------------------------------------------------------------------------\n392\t    def recovery(self):\n393\t        \"\"\"Objective classification of the journal; never performs an action.\"\"\"\n394\t        j = self.j\n395\t        open_steps = [e['step'] for e in j.find('transition-intent') if self._open(e['step'])]\n396\t        failed = j.last('transition-failed')\n397\t        if j.last('transition-a9-complete') is not None and failed is None:\n398\t            state = 'a9-complete'\n399\t        elif j.last('ddl-marker') is not None:\n400\t            migrations = [s for s in open_steps if s.startswith('migration:')]\n401\t            if migrations:\n402\t                outcome = j.last('transition-migration-failed', migrations[-1])\n403\t                state = 'ddl-failed' if outcome is not None and outcome['definite'] is True else 'ddl-ambiguous'\n404\t            elif any(s.startswith('a9:') for s in open_steps):\n405\t                state = 'candidate-ambiguous'\n406\t            elif j.last('transition-done', 'layout') is not None and failed is not None:\n407\t                state = 'candidate-failed'\n408\t            else:\n409\t                state = 'post-ddl-failed'\n410\t        elif j.last('observed-host-resumed') is not None:\n411\t            state = 'legacy-resumed'\n412\t        elif j.last('observed-host-intent', 'legacy-resume') is not None:\n413\t            state = 'resume-partial'\n414\t        elif j.last('observed-host-contained') is not None:\n415\t            state = 'contained-pre-ddl'\n416\t        elif j.find('observed-host-intent'):\n417\t            state = 'containment-partial'\n418\t        else:\n419\t            state = 'not-started'\n420\t        return dict(state=state, procedure=PROCEDURES[state], open_steps=open_steps,\n421\t                    legacy_resume_allowed=state in ('contained-pre-ddl', 'resume-partial'),\n422\t                    automatic_undo=False, destructive_retry=False)\n423\t\n424\t\n425\t# -- configuration ----------------------------------------------------------------------------------\n426\t@dataclass(frozen=True)\n427\tclass FirstTransitionConfig:\n428\t    repo: str\n429\t    state_dir: str\n430\t    migration_workdir: str\n431\t    python: str\n432\t    docker: tuple\n433\t    catalog: str\n434\t    identity: str\n435\t    lease_columns: tuple\n436\t    observer_applications: tuple\n437\t    manifest: HostManifest\n438\t    candidate: CandidateSpec\n439\t    package_manifest_sha256: str\n440\t    timeouts: tuple\n441\t    digest: str\n442\t\n443\t\n444\tdef parse_config(data):\n445\t    \"\"\"Public values only: unknown keys (a password, a URL) refuse.\"\"\"\n446\t    require(isinstance(data, dict) and set(data) == CONFIG_KEYS and data['schema'] == CONFIG_SCHEMA, 'config-keys')\n447\t    docker, database, candidate, timeouts = data['docker'], data['database'], data['candidate'], data['timeouts']\n448\t    require(isinstance(docker, dict) and set(docker) == {'binary', 'endpoint', 'config_dir'}, 'config-docker')\n449\t    require(isinstance(database, dict) and set(database) == {\n450\t        'identity', 'catalog', 'lease_columns', 'observer_applications'}, 'config-database')\n451\t    require(isinstance(candidate, dict) and set(candidate) == {\n452\t        'sha', 'image', 'project', 'containers', 'network_name', 'release_root', 'hold_override', 'env_file',\n453\t        'smoke_seconds'}, 'config-candidate')\n454\t    require(isinstance(timeouts, dict) and set(timeouts) <= set(TIMEOUTS)\n455\t            and all(type(v) is int and 0 < v <= 3600 for v in timeouts.values())\n456\t            and timeouts.get('observe_s', TIMEOUTS['observe_s']) <= 30, 'config-timeouts')\n457\t    require(all(_absolute(data[k]) for k in ('repo', 'state_dir', 'migration_workdir', 'python')), 'config-paths')\n458\t    require(isinstance(database['lease_columns'], list) and isinstance(database['observer_applications'], list)\n459\t            and all(isinstance(p, list) for p in database['lease_columns']), 'config-database')\n460\t    manifest = HostManifest.from_dict(data['host'])\n461\t    containers = candidate['containers']\n462\t    require(isinstance(containers, dict) and set(containers) == set(ROLES), 'config-candidate')\n463\t    spec = CandidateSpec(sha=candidate['sha'], image=candidate['image'], project=candidate['project'],\n464\t                         containers=tuple((r, containers[r]) for r in ROLES), network_id=manifest.network_id,\n465\t                         network_name=candidate['network_name'], release_root=candidate['release_root'],\n466\t                         hold_override=candidate['hold_override'], env_file=candidate['env_file'],\n467\t                         daemon_id=manifest.daemon_id, smoke_seconds=candidate['smoke_seconds']).validated()\n468\t    require(spec.sha == APPLICATION_SHA, 'config-candidate-sha')\n469\t    require(isinstance(data['package_manifest_sha256'], str)\n470\t            and re.fullmatch('[0-9a-f]{64}', data['package_manifest_sha256']), 'config-package')\n471\t    canonical = json.dumps(data, sort_keys=True, separators=(',', ':')).encode()\n472\t    return FirstTransitionConfig(\n473\t        repo=data['repo'], state_dir=data['state_dir'], migration_workdir=data['migration_workdir'],\n474\t        python=data['python'], docker=(docker['binary'], docker['endpoint'], docker['config_dir']),\n475\t        catalog=database['catalog'], identity=database['identity'],\n476\t        lease_columns=tuple(tuple(p) for p in database['lease_columns']) or LEASES,\n477\t        observer_applications=tuple(database['observer_applications']), manifest=manifest, candidate=spec,\n478\t        package_manifest_sha256=data['package_manifest_sha256'], timeouts=tuple(sorted(timeouts.items())),\n479\t        digest=hashlib.sha256(canonical).hexdigest())\n480\t\n481\t\n482\tdef load_config(path):\n483\t    try:\n484\t        data = json.loads(read_regular(path, 64 * 1024))\n485\t    except ValueError:\n486\t        raise Refused('config-invalid-json') from None\n487\t    return parse_config(data)\n488\t\n489\t\n490\tdef assemble(config, *, plan, journal, connect, secret, ingress, writers, backup_proof, popen=None, run=None,\n491\t             clock=time.monotonic, sleep=time.sleep, git=None):\n492\t    \"\"\"Wire real ports from configuration plus injected providers; any absent provider refuses.\n493\t\n494\t    Providers (database connection, secret, ingress/writer bindings, backup\n495\t    receipt) are Phase 3 inputs; nothing is contacted while assembling.\n496\t    \"\"\"\n497\t    require(isinstance(config, FirstTransitionConfig), 'transition-config')\n498\t    for value, code in ((connect, 'database'), (secret, 'secret'), (backup_proof, 'backup')):\n499\t        require(callable(value), 'transition-' + code + '-missing')\n500\t    require(ingress is not None and writers is not None, 'transition-host-bindings-missing')\n501\t    binary, endpoint, config_dir = config.docker\n502\t    database = ReadOnlyDatabase(connect, lease_columns=config.lease_columns,\n503\t                                observer_applications=config.observer_applications)\n504\t    expected = DatabaseExpectation(config.identity, plan.baseline, config.catalog).validated()\n505\t    proof = LedgerProof(database, expected, scope=config.manifest.digest)\n506\t    driver = ObservedHostDriver(config.manifest, ingress=ingress, writers=writers, ledger_proof=proof,\n507\t                                runner=PopenRunner(docker_binary=binary, endpoint=endpoint, config_dir=config_dir,\n508\t                                                   popen=popen, resume=True))\n509\t    host = ObservedHostContract(ObservedHostTransport(driver, **config.manifest.transport_scope()), journal)\n510\t    candidate = CandidatePort(config.candidate, runner=CandidateRunner(\n511\t        config.candidate, docker_binary=binary, endpoint=endpoint, config_dir=config_dir, popen=popen))\n512\t    executor = MigrationExecutor(plan, python=config.python, workdir=config.migration_workdir, secret=secret,\n513\t                                 runner=ProcessRunner(binaries=(config.python,), run=run),\n514\t                                 timeout=dict(config.timeouts).get('migration_s', TIMEOUTS['migration_s']))\n515\t    migrations = [m.name for m in plan.migrations]\n516\t\n517\t    def layout():\n518\t        return write_candidate_release(config.repo, config.candidate, config.manifest, migrations=migrations,\n519\t                                       package_manifest_sha256=config.package_manifest_sha256, git=git)\n520\t    return FirstTransition(plan=plan, journal=journal, host=host, database=database, expected=expected,\n521\t                           backup_proof=backup_proof, executor=executor, layout=layout, candidate=candidate,\n522\t                           config_digest=config.digest, clock=clock, sleep=sleep, timeouts=dict(config.timeouts))\n523\t"}]},"parent_tool_use_id":null,"session_id":"b7c0715d-1aa9-47c4-a1be-b9d449b8e96c","uuid":"df6a58e8-fac0-436e-8ad3-d98e62edeceb","timestamp":"2026-10-30T15:29:36.246Z","tool_use_result":{"type":"text","file":{"filePath":"/home/raniel-linux/.codex/worktrees/fase1-a3-transicao-20261029/PastorAi-1.0/deploy/first_transition_orchestrator.py","content":"\"\"\"First-transition orchestration over injected ports, up to A9 (never A10).\n\nSequence (one durable journal, shared with ObservedHostContract):\n\n1. fresh read-only database baseline equal to the configured expectation;\n2. ObservedHostContract.contain(): ingress blocked, four legacy restart=no,\n   SIGTERM, clean exit 0;\n3. two consecutive bounded fresh observations, each with the host still\n   contained and zero writing sessions and zero active leases in the database;\n4. injected backup/restore + clone rehearsal receipt validated against the plan,\n   identity and baseline (first_transition_adapter.validate_clone_receipt);\n5. final pre-DDL re-check, then the durable irrevocable ``ddl-marker``;\n6. the 51 pending migrations (43 transactional, 8 CONCURRENTLY) one by one via\n   the exact pinned ``backend/scripts/migrate.py`` bytes of the Plan, each with\n   a durable intent first; the first failure or doubt stops for good;\n7. candidate release layout ``<release_root>/<sha>`` (first_transition_candidate);\n8. A9: four candidate containers created held (restart=no, gates closed), ONLY\n   the backend started and smoked; consumers proven never started; legacy\n   stopped, support preserved and ingress blocked throughout.\n\nRecovery is objective (``recovery()``), never automatic: no undo, no retry of a\ndestructive operation, no legacy resume once the DDL marker exists. A\npre-DDL legacy resume goes through ObservedHostContract.resume_legacy, whose\ndriver requires a fresh read-only ledger proof before every effect.\n\nConfiguration (``load_config``) holds public values only; secrets reach the\nmigration child exclusively through its isolated environment. Nothing runs at\nimport; there is no command-line entry point and no production operation here.\n\"\"\"\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport stat\nimport subprocess\nimport time\n\nfrom first_transition_adapter import APPLICATION_SHA, EXECUTOR_SHA, ROLES, Plan, digest, validate_clone_receipt\nfrom first_transition_candidate import (CONSUMERS, CandidatePort, CandidateRunner, CandidateSpec, check_backend_running,\n                                        check_held, check_identity, write_candidate_release, write_hold_override)\nfrom first_transition_database import (LEASES, DatabaseExpectation, LedgerProof, ReadOnlyDatabase, require_ddl_free,\n                                       require_quiet, summary)\nfrom first_transition_host_contract import ObservedHostContract\nfrom first_transition_host_driver import HostManifest, ObservedHostDriver, PopenRunner, _absolute\nfrom first_transition_host_transport import ObservedHostTransport\nfrom initial_transition_files import Journal, no_symlink, read_regular\nfrom initial_transition_ops import Refused, require\n\nCONFIG_SCHEMA = 'igreja12.first-transition-config/1'\nCONFIG_KEYS = frozenset({'schema', 'repo', 'state_dir', 'migration_workdir', 'python', 'docker', 'database',\n                         'host', 'candidate', 'package_manifest_sha256', 'timeouts'})\nTIMEOUTS = dict(migration_s=300, observe_s=10, quiescence_interval_s=5, quiescence_budget_s=60)\nSHAPE = (51, 43, 8)  # pending, transactional, CONCURRENTLY\nPROCEDURES = {\n    'not-started': 'nothing intended: no recovery action',\n    'containment-partial': 'replay run(): contain() never re-signals; an unclean exit stays refused for a human',\n    'contained-pre-ddl': 'replay run() or resume_legacy(token): fresh ledger proof before every effect',\n    'resume-partial': 'replay resume_legacy(token): receipted roles re-proven, ledger proof per effect',\n    'legacy-resumed': 'legacy back with ingress open: start a new journal for any later attempt',\n    'ddl-ambiguous': 'stop: no retry, no legacy; inspect ledger/indexes read-only and decide restore (A6) or completion',\n    'ddl-failed': 'stop: no retry, no legacy; restore from the validated backup (A6) or fix forward by a new decision',\n    'post-ddl-failed': 'stop: no legacy; keep ingress blocked and inspect the failure read-only before a decision',\n    'candidate-ambiguous': 'stop: no undo; inspect the candidate project read-only, nothing restarted or removed',\n    'candidate-failed': 'stop: no undo; consumers stay held, ingress blocked; human decision on the backend',\n    'a9-complete': 'hold: backend smoked, consumers held, ingress blocked; A10 needs its own authorization',\n}\nPROCESS_ENV = frozenset({'PATH', 'LC_ALL', 'LANG', 'PYTHON_DOTENV_DISABLED', 'MIGRATION_DATABASE_URL', 'PGAPPNAME',\n                         'PGCONNECT_TIMEOUT'})\n\n\nclass ProcessRunner:\n    \"\"\"Generic safe runner: allowlisted absolute binaries, constructed env, no shell, output discarded.\n\n    The environment is the only channel for secrets: argv never carries one and\n    no output is captured, so nothing can reach logs or exceptions.\n    \"\"\"\n\n    def __init__(self, *, binaries, run=None):\n        require(isinstance(binaries, tuple) and binaries and all(_absolute(b) for b in binaries)\n                and (run is None or callable(run)), 'process-runner-config')\n        self.binaries, self.run = binaries, run\n\n    def __call__(self, argv, *, env, cwd, timeout):\n        require(type(argv) is tuple and argv and argv[0] in self.binaries\n                and all(type(a) is str and 0 < len(a) <= 4096 and '\\x00' not in a for a in argv), 'process-argv')\n        require(isinstance(env, dict) and set(env) <= PROCESS_ENV\n                and all(type(v) is str and '\\x00' not in v for v in env.values()), 'process-env')\n        require(_absolute(cwd) and type(timeout) in (int, float) and 0 < timeout <= 3600, 'process-bounds')\n        run = self.run or subprocess.run  # resolved per call, never at import/construction\n        outcome = None\n        try:\n            done = run(list(argv), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,\n                       env=dict(env), cwd=cwd, timeout=timeout, close_fds=True, shell=False, check=False)\n        except subprocess.TimeoutExpired:\n            outcome = 'timeout'\n        except Exception:\n            outcome = 'process-spawn-failed'\n        if outcome == 'timeout':\n            raise TimeoutError('process-timeout')\n        require(outcome is None and type(getattr(done, 'returncode', None)) is int, outcome or 'process-failed')\n        return done.returncode\n\n\nclass MigrationExecutor:\n    \"\"\"One pending migration through the exact pinned migrate.py bytes of the Plan.\n\n    ``python <dir>/scripts/migrate.py apply <name> --yes [--no-transaction]``\n    in a fresh exclusive directory under the configured workdir; the database\n    URL comes from ``secret()`` straight into the child environment.\n    \"\"\"\n\n    def __init__(self, plan, *, python, workdir, secret, runner, timeout=300):\n        require(isinstance(plan, Plan) and plan.application_sha == APPLICATION_SHA\n                and plan.executor_sha == EXECUTOR_SHA, 'migration-plan')\n        require(_absolute(python) and _absolute(workdir) and callable(secret) and callable(runner)\n                and type(timeout) is int and 0 < timeout <= 3600, 'migration-executor-config')\n        self.plan, self.python, self.workdir = plan, python, workdir\n        self.secret, self.runner, self.timeout = secret, runner, timeout\n\n    @staticmethod\n    def command(python, directory, migration):\n        return (python, '-I', f'{directory}/scripts/migrate.py', 'apply', migration.name, '--yes',\n                *(('--no-transaction',) if migration.concurrent else ()))\n\n    def _materialize(self, index, migration):\n        root = no_symlink(Path(self.workdir))\n        require(os.path.lexists(root) and stat.S_ISDIR(os.lstat(root).st_mode), 'migration-workdir-missing')\n        directory = root / f'{index:02d}-{self.plan.digest[:16]}'\n        try:\n            directory.mkdir(mode=0o700)  # exclusive: a previous attempt's directory refuses\n        except FileExistsError:\n            raise Refused('migration-workdir-exists') from None\n        (directory / 'scripts').mkdir(mode=0o700)\n        (directory / 'migrations').mkdir(mode=0o700)\n        for path, data in (('scripts/migrate.py', self.plan.executor), ('migrations/' + migration.name, migration.sql)):\n            fd = os.open(directory / path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)\n            with os.fdopen(fd, 'wb') as handle:\n                handle.write(data)\n        return str(directory)\n\n    def apply(self, index, migration):\n        require(migration in self.plan.pending and self.plan.pending[index - 1] is migration, 'migration-not-pending')\n        directory = self._materialize(index, migration)\n        url = self.secret()\n        require(isinstance(url, str) and url.startswith('postgresql://') and '\\n' not in url, 'migration-secret')\n        env = dict(PATH='/usr/bin:/bin', LC_ALL='C', PYTHON_DOTENV_DISABLED='1', MIGRATION_DATABASE_URL=url,\n                   PGAPPNAME=f'pastorai-first-transition-{index:02d}', PGCONNECT_TIMEOUT='10')\n        return self.runner(self.command(self.python, directory, migration), env=env, cwd=directory,\n                           timeout=self.timeout)\n\n\nclass FirstTransition:\n    def __init__(self, *, plan, journal, host, database, expected, backup_proof, executor, layout, candidate,\n                 config_digest, clock=time.monotonic, sleep=time.sleep, timeouts=None):\n        for value, kind, code in ((plan, Plan, 'plan'), (journal, Journal, 'journal'),\n                                  (host, ObservedHostContract, 'host'), (database, ReadOnlyDatabase, 'database'),\n                                  (expected, DatabaseExpectation, 'expectation'),\n                                  (executor, MigrationExecutor, 'executor'), (candidate, CandidatePort, 'candidate')):\n            require(isinstance(value, kind), 'transition-' + code + '-missing')\n        require(callable(backup_proof), 'transition-backup-missing')\n        require(callable(layout), 'transition-layout-missing')\n        require(journal.lock_fd is not None and host.j is journal, 'transition-journal')\n        require(executor.plan is plan and candidate.spec.sha == plan.application_sha, 'transition-plan-binding')\n        pending = plan.pending\n        require((len(pending), sum(not m.concurrent for m in pending), sum(m.concurrent for m in pending)) == SHAPE,\n                'transition-release-shape')\n        require(expected.validated().ledger == plan.baseline, 'transition-expectation-baseline')\n        require(isinstance(config_digest, str) and re.fullmatch('[0-9a-f]{64}', config_digest), 'transition-config')\n        self.t = {**TIMEOUTS, **(timeouts or {})}\n        self.plan, self.j, self.host, self.db, self.expected = plan, journal, host, database, expected\n        self.backup_proof, self.executor, self.layout, self.candidate = backup_proof, executor, layout, candidate\n        self.config_digest, self.clock, self.sleep = config_digest, clock, sleep\n\n    # -- journal helpers -------------------------------------------------------------------\n    def _intent(self, step, **fields):\n        return self.j.append('transition-intent', step=step, **fields)\n\n    def _done(self, step, **fields):\n        return self.j.append('transition-done', step=step, **fields)\n\n    def _open(self, step):\n        \"\"\"Intent without receipt: the outcome is unknown and never retried automatically.\"\"\"\n        return (self.j.last('transition-intent', step) is not None\n                and self.j.last('transition-done', step) is None)\n\n    def _observe(self):\n        return self.db.observe(timeout=self.t['observe_s'])\n\n    def _init(self):\n        init = self.j.last('transition-init')\n        values = dict(plan_digest=self.plan.digest, config_digest=self.config_digest,\n                      baseline_digest=self.expected.baseline_digest, application_sha=self.plan.application_sha,\n                      executor_sha=self.plan.executor_sha, candidate_image=self.candidate.spec.image)\n        if init is None:\n            self.j.append('transition-init', production_ready=False, **values)\n        else:\n            require(all(init.get(k) == v for k, v in values.items()), 'transition-inputs-changed')\n\n    # -- entry points --------------------------------------------------------------------------\n    def run(self):\n        self._init()\n        require(self.j.last('observed-host-intent', 'legacy-resume') is None, 'transition-legacy-resume-started')\n        require(self.j.last('transition-failed') is None, 'transition-stopped')  # first failure is final\n        try:\n            if self.j.last('ddl-marker') is None:\n                self._baseline()\n                self.host.contain()\n                self._quiesce()\n                self._backup()\n                self._mark_ddl()\n            self._migrate()\n            self._release_layout()\n            return self._a9()\n        except BaseException as exc:\n            if self.j.last('ddl-marker') is not None:\n                self.j.append('transition-failed', code=str(exc) if isinstance(exc, Refused) else 'interrupted',\n                              legacy_resume_allowed=False)\n            raise\n\n    def resume_legacy(self, confirmation, *, allow_queue_drift=False):\n        \"\"\"Pre-DDL only; the contract and the driver's ledger proof re-check everything.\"\"\"\n        require(self.j.last('ddl-marker') is None and not self.j.find('transition-intent'),\n                'post-ddl-resume-forbidden')\n        return self.host.resume_legacy(confirmation, allow_queue_drift=allow_queue_drift)\n\n    # -- pre-DDL ---------------------------------------------------------------------------------\n    def _baseline(self):\n        observation = self._observe()\n        require_ddl_free(observation, self.expected)\n        if self.j.last('transition-baseline') is None:\n            self.j.append('transition-baseline', evidence='database-read-only', **summary(observation))\n\n    def _quiet_observation(self):\n        receipt = self.host.assert_contained()\n        observation = self._observe()\n        require_ddl_free(observation, self.expected)\n        require_quiet(observation)\n        return receipt['fingerprint'], receipt['queue_digest'], summary(observation)\n\n    def _quiesce(self):\n        start = self.clock()\n        first = self._quiet_observation()\n        self.sleep(self.t['quiescence_interval_s'])\n        second = self._quiet_observation()\n        require(self.clock() - start <= self.t['quiescence_budget_s'], 'transition-quiescence-unbounded')\n        require(first == second, 'transition-quiescence-changed')\n        self.j.append('transition-quiescent', observations=2, writing_sessions=0, active_leases=0,\n                      host_fingerprint=first[0], queue_digest=first[1], evidence='database-read-only')\n\n    def _backup(self):\n        receipt = self.backup_proof()\n        require(isinstance(receipt, dict), 'clone-receipt-invalid')\n        validate_clone_receipt(receipt, self.plan, self.expected.identity, self.expected.baseline_digest)\n        recorded = self.j.last('transition-backup')\n        if recorded is None:\n            self.j.append('transition-backup', receipt_digest=digest(receipt), restore_verified=True)\n        else:\n            require(recorded['receipt_digest'] == digest(receipt), 'transition-backup-changed')\n        return digest(receipt)\n\n    def _mark_ddl(self):\n        require(self.j.last('transition-quiescent') is not None, 'transition-not-quiescent')\n        # Immediately before the irrevocable marker: contained, read-only baseline, quiet, backup valid.\n        self._quiet_observation()\n        backup = self._backup()\n        self.j.append('ddl-marker', irrevocable=True, pending=[m.name for m in self.plan.pending],\n                      baseline_digest=self.expected.baseline_digest, backup_digest=backup,\n                      legacy_resume_allowed=False)\n\n    # -- DDL ----------------------------------------------------------------------------------------\n    def _migrate(self):\n        ledger = list(self.plan.baseline)\n        for index, migration in enumerate(self.plan.pending, 1):\n            step = 'migration:' + migration.name\n            if self.j.last('transition-done', step) is not None:\n                ledger.append(migration.name)\n                continue\n            require(self.j.last('transition-intent', step) is None, 'migration-outcome-ambiguous')\n            before = self._observe()\n            require(before['identity'] == self.expected.identity, 'database-identity-mismatch')\n            require(list(before['ledger']) == sorted(ledger), 'migration-ledger-not-prefix')\n            require(not before['invalid'] and before['index_builds'] == 0, 'database-ddl-in-progress')\n            require_quiet(before)\n            self.host.assert_contained()\n            self._intent(step, index=index, sql_sha256=migration.sha256, concurrent=migration.concurrent)\n            try:\n                code = self.executor.apply(index, migration)\n            except TimeoutError:\n                code = None\n            after = self._observe()\n            failure = self._migration_failure(migration, code, ledger, after)\n            if failure is not None:\n                # Definite only for a transactional rollback with no trace; anything else is ambiguous.\n                definite = (failure == 'migration-failed' and not migration.concurrent\n                            and not after['invalid'] and after['index_builds'] == 0)\n                self.j.append('transition-migration-failed', step=step, code=failure, definite=definite)\n                raise Refused(failure)\n            self._done(step, ledger_digest=after['ledger_digest'])\n            ledger.append(migration.name)\n        final = self._observe()\n        require(list(final['ledger']) == sorted(m.name for m in self.plan.migrations), 'final-ledger')\n        if self.j.last('transition-migrated') is None:\n            self.j.append('transition-migrated', ledger=len(final['ledger']), catalog=final['catalog'])\n        else:\n            require(self.j.last('transition-migrated')['catalog'] == final['catalog'], 'database-ddl-drift')\n\n    @staticmethod\n    def _migration_failure(migration, code, ledger, after):\n        applied = list(after['ledger']) == sorted([*ledger, migration.name])\n        if code is None:\n            return 'migration-timeout'\n        if code != 0:\n            return 'migration-ambiguous-ledger-without-success' if applied else 'migration-failed'\n        if not applied:\n            return 'migration-ambiguous-exit0-no-ledger'\n        if after['invalid'] or after['index_builds'] or not set(migration.indexes) <= set(after['indexes']):\n            return 'migration-index-invalid'\n        return None\n\n    def _release_layout(self):\n        if self.j.last('transition-done', 'layout') is None:\n            self._intent('layout')\n        files = self.layout()  # exclusive or byte-for-byte verification, on every invocation\n        if self.j.last('transition-done', 'layout') is None:\n            self._done('layout', files=files)\n\n    # -- A9 ----------------------------------------------------------------------------------------\n    def _candidate_states(self, ids):\n        states = self.candidate.inspect(tuple(ids[r] for r in ROLES))\n        result = {role: states[ids[role]] for role in ROLES}\n        for role, state in result.items():\n            check_identity(self.candidate.spec, role, state)\n        return result\n\n    def _held(self, ids, created, backend_started):\n        \"\"\"Consumers never started, legacy contained, support preserved, ingress blocked.\"\"\"\n        states = self._candidate_states(ids)\n        for role in CONSUMERS:\n            check_held(states[role], created[role])\n        if backend_started is None:\n            check_held(states['backend'], created['backend'])\n        else:\n            check_backend_running(states['backend'], backend_started)\n        self.host.assert_contained()\n        return states\n\n    def _a9(self):\n        created = self.j.last('transition-done', 'a9:create')\n        if created is None:\n            require(not self._open('a9:create'), 'candidate-create-ambiguous')\n            self.host.assert_contained()\n            require(self.candidate.project_ids() == (), 'candidate-project-not-empty')\n            write_hold_override(self.candidate.spec)\n            self._intent('a9:create', project=self.candidate.spec.project)\n            self.candidate.create_held()\n            found = self.candidate.project_ids()\n            require(len(found) == 4, 'candidate-create-scope')\n            states = self.candidate.inspect(found)\n            ids = {state['service']: ident for ident, state in states.items()}\n            require(set(ids) == set(ROLES), 'candidate-create-scope')\n            for role in ROLES:\n                check_identity(self.candidate.spec, role, states[ids[role]])\n                check_held(states[ids[role]])\n            created = self._done('a9:create', ids=ids, created={\n                role: dict(started=states[ids[role]]['started'], restart_count=states[ids[role]]['restart_count'])\n                for role in ROLES})\n        ids, snapshot = created['ids'], created['created']\n        require(self.candidate.project_ids() == tuple(sorted(ids.values())), 'candidate-project-changed')\n        started = self.j.last('transition-done', 'a9:start-backend')\n        if started is None:\n            require(not self._open('a9:start-backend'), 'candidate-start-ambiguous')\n            self._held(ids, snapshot, None)\n            self._intent('a9:start-backend', id=ids['backend'])\n            self.candidate.start_backend(ids['backend'])\n            state = self._candidate_states(ids)['backend']\n            check_backend_running(state)\n            started = self._done('a9:start-backend', started=state['started'])\n        self._held(ids, snapshot, started['started'])\n        smoke = self.candidate.smoke(ids['backend'])  # fresh read-only probe on every invocation\n        self._held(ids, snapshot, started['started'])\n        if self.j.last('transition-a9-complete') is None:\n            self.j.append('transition-a9-complete', smoke=smoke, consumers='held', ingress_blocked=True,\n                          a10='not-implemented')\n        return dict(status='a9-backend-smoked', smoke=smoke, consumers='held', ingress_blocked=True,\n                    legacy_resume_allowed=False, a10='not-implemented', production_ready=False)\n\n    # -- recovery --------------------------------------------------------------------------------\n    def recovery(self):\n        \"\"\"Objective classification of the journal; never performs an action.\"\"\"\n        j = self.j\n        open_steps = [e['step'] for e in j.find('transition-intent') if self._open(e['step'])]\n        failed = j.last('transition-failed')\n        if j.last('transition-a9-complete') is not None and failed is None:\n            state = 'a9-complete'\n        elif j.last('ddl-marker') is not None:\n            migrations = [s for s in open_steps if s.startswith('migration:')]\n            if migrations:\n                outcome = j.last('transition-migration-failed', migrations[-1])\n                state = 'ddl-failed' if outcome is not None and outcome['definite'] is True else 'ddl-ambiguous'\n            elif any(s.startswith('a9:') for s in open_steps):\n                state = 'candidate-ambiguous'\n            elif j.last('transition-done', 'layout') is not None and failed is not None:\n                state = 'candidate-failed'\n            else:\n                state = 'post-ddl-failed'\n        elif j.last('observed-host-resumed') is not None:\n            state = 'legacy-resumed'\n        elif j.last('observed-host-intent', 'legacy-resume') is not None:\n            state = 'resume-partial'\n        elif j.last('observed-host-contained') is not None:\n            state = 'contained-pre-ddl'\n        elif j.find('observed-host-intent'):\n            state = 'containment-partial'\n        else:\n            state = 'not-started'\n        return dict(state=state, procedure=PROCEDURES[state], open_steps=open_steps,\n                    legacy_resume_allowed=state in ('contained-pre-ddl', 'resume-partial'),\n                    automatic_undo=False, destructive_retry=False)\n\n\n# -- configuration ----------------------------------------------------------------------------------\n@dataclass(frozen=True)\nclass FirstTransitionConfig:\n    repo: str\n    state_dir: str\n    migration_workdir: str\n    python: str\n    docker: tuple\n    catalog: str\n    identity: str\n    lease_columns: tuple\n    observer_applications: tuple\n    manifest: HostManifest\n    candidate: CandidateSpec\n    package_manifest_sha256: str\n    timeouts: tuple\n    digest: str\n\n\ndef parse_config(data):\n    \"\"\"Public values only: unknown keys (a password, a URL) refuse.\"\"\"\n    require(isinstance(data, dict) and set(data) == CONFIG_KEYS and data['schema'] == CONFIG_SCHEMA, 'config-keys')\n    docker, database, candidate, timeouts = data['docker'], data['database'], data['candidate'], data['timeouts']\n    require(isinstance(docker, dict) and set(docker) == {'binary', 'endpoint', 'config_dir'}, 'config-docker')\n    require(isinstance(database, dict) and set(database) == {\n        'identity', 'catalog', 'lease_columns', 'observer_applications'}, 'config-database')\n    require(isinstance(candidate, dict) and set(candidate) == {\n        'sha', 'image', 'project', 'containers', 'network_name', 'release_root', 'hold_override', 'env_file',\n        'smoke_seconds'}, 'config-candidate')\n    require(isinstance(timeouts, dict) and set(timeouts) <= set(TIMEOUTS)\n            and all(type(v) is int and 0 < v <= 3600 for v in timeouts.values())\n            and timeouts.get('observe_s', TIMEOUTS['observe_s']) <= 30, 'config-timeouts')\n    require(all(_absolute(data[k]) for k in ('repo', 'state_dir', 'migration_workdir', 'python')), 'config-paths')\n    require(isinstance(database['lease_columns'], list) and isinstance(database['observer_applications'], list)\n            and all(isinstance(p, list) for p in database['lease_columns']), 'config-database')\n    manifest = HostManifest.from_dict(data['host'])\n    containers = candidate['containers']\n    require(isinstance(containers, dict) and set(containers) == set(ROLES), 'config-candidate')\n    spec = CandidateSpec(sha=candidate['sha'], image=candidate['image'], project=candidate['project'],\n                         containers=tuple((r, containers[r]) for r in ROLES), network_id=manifest.network_id,\n                         network_name=candidate['network_name'], release_root=candidate['release_root'],\n                         hold_override=candidate['hold_override'], env_file=candidate['env_file'],\n                         daemon_id=manifest.daemon_id, smoke_seconds=candidate['smoke_seconds']).validated()\n    require(spec.sha == APPLICATION_SHA, 'config-candidate-sha')\n    require(isinstance(data['package_manifest_sha256'], str)\n            and re.fullmatch('[0-9a-f]{64}', data['package_manifest_sha256']), 'config-package')\n    canonical = json.dumps(data, sort_keys=True, separators=(',', ':')).encode()\n    return FirstTransitionConfig(\n        repo=data['repo'], state_dir=data['state_dir'], migration_workdir=data['migration_workdir'],\n        python=data['python'], docker=(docker['binary'], docker['endpoint'], docker['config_dir']),\n        catalog=database['catalog'], identity=database['identity'],\n        lease_columns=tuple(tuple(p) for p in database['lease_columns']) or LEASES,\n        observer_applications=tuple(database['observer_applications']), manifest=manifest, candidate=spec,\n        package_manifest_sha256=data['package_manifest_sha256'], timeouts=tuple(sorted(timeouts.items())),\n        digest=hashlib.sha256(canonical).hexdigest())\n\n\ndef load_config(path):\n    try:\n        data = json.loads(read_regular(path, 64 * 1024))\n    except ValueError:\n        raise Refused('config-invalid-json') from None\n    return parse_config(data)\n\n\ndef assemble(config, *, plan, journal, connect, secret, ingress, writers, backup_proof, popen=None, run=None,\n             clock=time.monotonic, sleep=time.sleep, git=None):\n    \"\"\"Wire real ports from configuration plus injected providers; any absent provider refuses.\n\n    Providers (database connection, secret, ingress/writer bindings, backup\n    receipt) are Phase 3 inputs; nothing is contacted while assembling.\n    \"\"\"\n    require(isinstance(config, FirstTransitionConfig), 'transition-config')\n    for value, code in ((connect, 'database'), (secret, 'secret'), (backup_proof, 'backup')):\n        require(callable(value), 'transition-' + code + '-missing')\n    require(ingress is not None and writers is not None, 'transition-host-bindings-missing')\n    binary, endpoint, config_dir = config.docker\n    database = ReadOnlyDatabase(connect, lease_columns=config.lease_columns,\n                                observer_applications=config.observer_applications)\n    expected = DatabaseExpectation(config.identity, plan.baseline, config.catalog).validated()\n    proof = LedgerProof(database, expected, scope=config.manifest.digest)\n    driver = ObservedHostDriver(config.manifest, ingress=ingress, writers=writers, ledger_proof=proof,\n                                runner=PopenRunner(docker_binary=binary, endpoint=endpoint, config_dir=config_dir,\n                                                   popen=popen, resume=True))\n    host = ObservedHostContract(ObservedHostTransport(driver, **config.manifest.transport_scope()), journal)\n    candidate = CandidatePort(config.candidate, runner=CandidateRunner(\n        config.candidate, docker_binary=binary, endpoint=endpoint, config_dir=config_dir, popen=popen))\n    executor = MigrationExecutor(plan, python=config.python, workdir=config.migration_workdir, secret=secret,\n                                 runner=ProcessRunner(binaries=(config.python,), run=run),\n                                 timeout=dict(config.timeouts).get('migration_s', TIMEOUTS['migration_s']))\n    migrations = [m.name for m in plan.migrations]\n\n    def layout():\n        return write_candidate_release(config.repo, config.candidate, config.manifest, migrations=migrations,\n                                       package_manifest_sha256=config.package_manifest_sha256, git=git)\n    return FirstTransition(plan=plan, journal=journal, host=host, database=database, expected=expected,\n                           backup_proof=backup_proof, executor=executor, layout=layout, candidate=candidate,\n                           config_digest=config.digest, clock=clock, sleep=sleep, timeouts=dict(config.timeouts))\n","numLines":523,"startLine":1,"totalLines":523}},"tool_result_meta":[{"id":"toolu_01B77iNGiZBXXKcY217XeAFt","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
