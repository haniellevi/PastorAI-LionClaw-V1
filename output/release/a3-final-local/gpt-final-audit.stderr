# --- resume gated by a fresh read-only ledger proof (block B) ----------------

from first_transition_database import LedgerProof, ReadOnlyDatabase  # noqa: E402
from first_transition_host_contract import START_ORDER  # noqa: E402
from test_first_transition_database import FakePg  # noqa: E402


class ResumeRig(Rig):
    def __init__(self, *, openers=True, proof_scope=None):
        super().__init__()
        self.pg = FakePg(['0001_base.sql', '0002_more.sql'])
        self.proofs = []  # index into docker.calls at which each fresh proof connected
        self.pg.on_connect = lambda: self.proofs.append(len(self.docker.calls))
        self.proof = LedgerProof(ReadOnlyDatabase(self.pg.connect), self.pg.expectation(),
                                 scope=proof_scope or self.manifest.digest)
        if not openers:
            for binding in self.ingress.values():
                binding.open = None
        self.driver = ObservedHostDriver(self.manifest, runner=self.docker, ingress=self.ingress,
                                         writers=self.writers, ledger_proof=self.proof)
        self.transport = ObservedHostTransport(self.driver, **self.manifest.transport_scope())

    def resume_effects(self):
        return [(i, argv) for i, argv in enumerate(self.docker.calls)
                if argv[:2] == ('docker', 'start') or argv[:3] == ('docker', 'update', '--restart=always')]


def test_resume_runs_a_fresh_ledger_proof_before_every_effect(tmp_path):
    rig = ResumeRig()
    with Journal(tmp_path / 'journal') as journal:
        contract = rig.contract(journal)
        contract.contain()
        assert rig.driver.supports_resume is True and rig.pg.connections == 0
        result = contract.resume_legacy(contract.resume_token())
        assert result['status'] == 'legacy-resumed' and result['host_verified'] is False
    effects = rig.resume_effects()
    assert [argv for _, argv in effects] == [
        host_command(op, LEGACY[role]) for role in START_ORDER for op in ('start', 'restart-always')]
    # One proof per resume request (8 container effects + open-ingress), each before its own effect.
    assert len(rig.proofs) == 9 and rig.pg.closed == 9
    previous = -1
    for (index, _), proof in zip(effects, rig.proofs):
        assert previous < proof <= index
        previous = index
    assert all(i.state == 'open' for i in rig.ingress.values())


@pytest.mark.parametrize('drift', [
    lambda pg: pg.ledger.append('0003_applied_elsewhere.sql'),
    lambda pg: pg.extra_ddl.append('rogue_table'),
    lambda pg: setattr(pg, 'system', '7300000000000000009'),
    lambda pg: pg.invalid.append('half_built_idx'),
])
def test_ddl_or_ledger_drift_without_journal_marker_refuses_resume_before_any_start(tmp_path, drift):
    rig = ResumeRig()
    with Journal(tmp_path / 'journal') as journal:
        contract = rig.contract(journal)
        contract.contain()
        drift(rig.pg)
        assert journal.last('ddl-marker') is None  # journal absence alone is not accepted as proof
        with pytest.raises(Refused, match='^observed-host-effect-failed$'):
            contract.resume_legacy(contract.resume_token())
    assert rig.resume_effects() == [] and rig.driver.refusals[-1].startswith('driver-ledger-proof')
    assert all(i.state == 'blocked' for i in rig.ingress.values())
    assert all(not rig.docker.containers[i]['State']['Running'] for i in LEGACY.values())


def test_drift_after_first_start_stops_before_the_next_effect_and_replay(tmp_path):
    rig = ResumeRig()
    rig.docker.after['start'] = lambda _argv: rig.pg.extra_ddl.append('rogue_table')
    with Journal(tmp_path / 'journal') as journal:
        contract = rig.contract(journal)
        contract.contain()
        with pytest.raises(Refused):
            contract.resume_legacy(contract.resume_token())
        assert [argv for _, argv in rig.resume_effects()] == [host_command('start', LEGACY['backend'])]
        with pytest.raises(Refused):
            contract.resume_legacy(contract.resume_token())
    assert [argv for _, argv in rig.resume_effects()] == [host_command('start', LEGACY['backend'])]
    assert all(i.state == 'blocked' for i in rig.ingress.values())


def test_open_ingress_needs_its_own_fresh_proof(tmp_path):
    rig = ResumeRig()
    last = host_command('restart-always', LEGACY[START_ORDER[-1]])
    rig.docker.after['update'] = lambda argv: argv == last and rig.pg.ledger.append('0003_late.sql')
    with Journal(tmp_path / 'journal') as journal:
        contract = rig.contract(journal)
        contract.contain()
        with pytest.raises(Refused):
            contract.resume_legacy(contract.resume_token())
        assert journal.last('observed-host-intent', 'open-ingress') is not None
        assert journal.last('observed-host-done', 'open-ingress') is None
    assert all(i.state == 'blocked' for i in rig.ingress.values())


def test_resume_is_unavailable_without_openers_and_proof_scope_is_bound(tmp_path):
    rig = ResumeRig(openers=False)
    assert rig.driver.supports_resume is False
    with Journal(tmp_path / 'journal') as journal:
        contract = rig.contract(journal)
        contract.contain()
        with pytest.raises(Refused, match='^observed-host-resume-unavailable$'):
            contract.resume_legacy(contract.resume_token())
    with pytest.raises(Refused, match='^driver-operation-forbidden$'):
        rig.driver.request(('open-ingress',), timeout=5)
    assert rig.pg.connections == 0 and rig.resume_effects() == []
    with pytest.raises(Refused, match='^driver-ledger-binding$'):
        ResumeRig(proof_scope='a' * 64)


def test_rebound_ledger_proof_refuses_before_effects(tmp_path):
    rig = ResumeRig()
    with Journal(tmp_path / 'journal') as journal:
        contract = rig.contract(journal)
        contract.contain()
        rig.driver.ledger_proof = LedgerProof(ReadOnlyDatabase(rig.pg.connect), rig.pg.expectation(),
                                              scope=rig.manifest.digest)
        with pytest.raises(Refused):
            contract.resume_legacy(contract.resume_token())
    assert rig.resume_effects() == []


def test_popen_runner_accepts_resume_commands_only_when_configured():
    for argv in (('docker', 'start', 'a' * 64), ('docker', 'update', '--restart=always', 'a' * 64)):
        popen = FakePopen(FakeProc())
        with pytest.raises(Refused, match='^runner-argv$'):
            runner(popen)(argv, timeout=1, max_output=16)
        popen = FakePopen(FakeProc())
        runner(popen, resume=True)(argv, timeout=1, max_output=256)
        assert popen.calls and popen.calls[0][0][-len(argv) + 1:] == list(argv[1:])
    for argv in (('docker', 'start', 'x'), ('docker', 'update', '--restart=unless-stopped', 'a' * 64)):
        with pytest.raises(Refused, match='^runner-argv$'):
            runner(FakePopen(FakeProc()), resume=True)(argv, timeout=1, max_output=16)

CURRENT ROADMAP TOP
# Igreja 12 — roteiro único

## A3 — blocos A e B implementados localmente (30/10/2026)

Base `e241a63fc8fc6a08c7305a5762ef7549bb01d488` (#605). **Escopo corrigido pelo dono:** A3 é só código local + testes sintéticos. Todo inventário real de host/banco (daemon, rede, IDs, ingresso, escritores, identidade/catálogo do banco, provedores de conexão/segredo) pertence à **Fase 3/A5**, junto do preflight; backup/restore real à **A6**. Configuração real ausente é entrada da Fase 3, não bloqueio de código: os ports falham fechados sem ela. A9 aprovado: backend saudável + queue/cron/broadcast criados e nunca iniciados (restart=no) até A10, que exige autorização própria.

- Driver (`first_transition_host_driver.py`): contenção do bloco A preservada; retomada (`start`, `restart=always`, abertura dos dois ingressos por binding) só com `LedgerProof` injetada, que faz prova PostgreSQL READ ONLY fresca (identidade, ledger exato, catálogo, índices inválidos/builds) dentro de cada efeito. Ausência de marcador no diário não basta; salvaguardas do `ObservedHostContract` mantidas.
- `first_transition_database.py`: observador somente leitura por conexão injetada; só agregados (sem PII, query ou payload), visibilidade/identidade conferidas, sessões de escrita e leases ativos.
- `first_transition_orchestrator.py`: baseline → contenção → duas observações quietas consecutivas e limitadas → recibo de backup/ensaio validado → `ddl-marker` durável → 51 migrations (43 TX/8 NT) uma a uma pelos bytes fixados de `migrate.py` (Plan/Journal), com intenção antes de cada uma; a primeira falha encerra, sem retry nem legado após DDL; segredo só no ambiente do filho. `recovery()` classifica o estado sem executar nada.
- `first_transition_candidate.py`: `<release_root>/<SHA>` + `release-topology.json` via `write_release` (exclusivo, sem sobrescrita, identidade pacote/SHA); A9 com uma criação `compose up --no-start --no-deps` + hold `restart: "no"`, gates fechados, início só do backend e smoke `/health`/`/ready`; consumidores `created`, StartedAt zero, RestartCount 0 e restart=no antes e depois; legado parado, suporte preservado e ingresso bloqueado durante todo o A9. A10 não implementado.
- Config sanitizada `deploy/first-transition.example.json`; `assemble()` só liga ports com provedores injetados e não contata nada.

**Recuperação (objetiva, nunca automática; API Python exata em `docs/ops/RELEASE-LOTE-2026-10.md`):** contenção parcial → replay sem re-sinal; contido pré-DDL → replay ou `resume_legacy` com prova por efeito; retomada parcial → replay; DDL definitiva (TX revertida, sem vestígio) ou ambígua → parar, sem retry nem legado, decisão de restore (A6) ou conclusão; candidato ambíguo/falho → parar sem desfazer, consumidores contidos, ingresso bloqueado.

Validação local final (Python 3.13): 598 testes + 51 subtestes verdes, sem skips na seleção exclusivamente sintética de transição/topologia/empacotamento; Ruff dos arquivos tocados e git diff --check limpos. Auditoria paralela única em andamento. Sem commit/push/PR/dispatch, operação Docker/PG, SSH, VPS ou produção.

Fechado no bloco B: `start_backend`/`smoke` inspecionam o ID e exigem o backend desta spec (consumidor, projeto ou imagem alheios recusam sem `start`); observações após cada migration e final exigem mesma identidade + READ ONLY + atividade visível antes de `done`/layout/A9; `Q_VISIBILITY` usa `pg_has_role(..., 'USAGE')`; `Q_WRITERS` conta toda sessão cliente não ociosa/em transação exceto o próprio PID (`observer_applications` segue aceito só por compatibilidade, nunca isenta); o backend candidato iniciado no A9 é fonte declarada do binding de escritores, não escritor desconhecido (docstring de `assemble`).

**Inventário separado cancelado:** não há etapa nem proposta própria de inventário; o inventário real de host/banco fica consolidado na Fase 3 (A5), como entrada de configuração/provedores.

P2: compatibilidade com Docker CLI/Compose real e permissões PostgreSQL (`pg_control_system`, `pg_read_all_stats` por USAGE) só verificáveis com os dados da Fase 3.
P2: o binding de escritores real deve excluir o backend candidato do A9 conforme a docstring de `assemble`; contá-lo apenas falha fechado.
P2: `CandidateRunner` segue aceitando `docker start` de ID hexadecimal; a restrição de identidade é do `CandidatePort`.

## HISTÓRICO — Fase 1, transporte observado e consolidação enxuta do release (29/10/2026)

> **Histórico:** prevalece a seção A3 acima (30/10/2026). O escopo "A3 parcial — contrato/encoder" e os bloqueadores 1–6 "a implementar" abaixo foram superados pela implementação local dos blocos A e B; o inventário real fica na Fase 3.

Base integrada `64853268a4c1623f5b9d4906457335fcb7849931` (#597–#604). Esta seção consolida o caminho crítico mínimo até o release restrito do piloto Filadélfia e substitui a cadência anterior de microetapas de laboratório offline (A1/I0: extração manual `.deb`, `unshare/chroot`, CPython 3.13.18 e VM QEMU sem rede), que não é retomada. O arquivamento dos diretórios temporários `/tmp/igreja12-*-20261029/` fora do repositório é registro do operador, não verificável a partir do repositório nem reverificado nesta fatia.

### Escopo e limites desta fatia (A3 parcial — contrato/encoder)

**Esta fatia é contrato + encoder de comandos sobre um driver fornecido pelo chamador. Não é executor real, não é inventário real, não é implementação de ingresso e não é autorização operacional.** A3 **não** está completa.

- `deploy/first_transition_host_transport.py`: `SimulatedHostTransport` intacto; `ObservedHostTransport` valida forma e fixa identidades das três dependências de suporte (`redis`, `evolution-postgres`, `evolution-api`), dos três serviços Compose legados + `broadcast-worker` avulso e `support_digest`; lê metadados de filas (`queue_metadata` via `redis-meta`, sem payloads) e codifica `restart-always`, `start`, `open-ingress`. Todos os valores são **reportados pelo driver**.
- `deploy/first_transition_host_contract.py`: `LocalHostContract` intacto; `ObservedHostContract` grava recibos `evidence='driver-reported'`, `host_verified=False`, `quiescence_proven=False`. `resume_legacy` pré-DDL (`backend → queue-worker → broadcast-worker → cron-worker` → `open-ingress`) revalida, imediatamente antes de cada efeito e após cada observação: ausência de marcador DDL no diário, ingresso bloqueado durante toda retomada parcial e antes de autorizar sua abertura, e igualdade da fila com a base assentada antes do **primeiro início efetivamente observado** (início recibado, ou intencionado com `started` comprovadamente novo; mera intenção não conta, e serviço `running` com `started` inalterado é inconsistência recusada antes de efeitos; replay incluído). Mudanças de fila após um serviço realmente iniciado são legítimas. Cada efeito de retomada (`start`, `restart=always`, `open-ingress`) também passa por uma guarda pré-efeito que julga, sem nova leitura, a **última observação feita pelo próprio transporte** (DDL no diário, ingresso, identidades, serviços e fila antes do primeiro início); no `ObservedHostTransport`, o comando só é emitido depois que a guarda aceita, e o transporte sem guarda recusa (um port alternativo é parte da base de confiança; o contrato só detecta uma guarda omitida após a chamada); é só encoder, não autoridade de retomada. Não há atomicidade sobre driver/host: resta a janela entre essa última observação e o efeito.
- `deploy/first_transition_adapter.py`: `LocalTransition` (banco local descartável) compõe-se **somente** com `LocalHostContract` simulado e diário válido; `ObservedHostContract`, recibos `observed-host` e evidência `LocalEvidence.observed` são recusados antes de `db.observe` ou de escrita no diário. Os diários são separados nos dois sentidos: `LocalTransition` (inclusive sem host) recusa diário com eventos `observed-host-*` na construção e antes de cada execução/etapa; `ObservedHostContract` recusa diário com `adapter-*`/`local-host-*` em `contain`/`assert_contained`/`resume_legacy` antes de qualquer leitura ou efeito do port (com marcador DDL, `post-ddl-resume-forbidden` mantém prioridade). `LocalEvidence.observed` é apenas envelope de metadados: sua validação não autoriza `LocalTransition` nem prova produção. Pins SQL (`afdfb78d71a53f2861632806e13cdda4662d7d63`) e executor (`37c7d68d60b6f86cfb1fe75d4c720530537845d6`) preservados; `plan.digest` reflete os novos hashes de `adapter_sources()`.

### Bloqueadores pendentes antes do pacote operacional de produção (Pacote 4)

1. **Driver real** de inventário/ingresso/executor de host: implementação e revisão independentes ainda não existem; até lá nenhum recibo é evidência de host (`host_verified=False`).
2. **Prova de banco** de que nenhuma DDL ocorreu antes de `resume_legacy` (leitura do ledger/marcador no BD); a ausência de marcador no diário não prova nada sobre DDL feita fora dele.
3. **Prova de ingresso e de escritores desconhecidos** independente do driver.
4. **Fila/quiescência**: contagem por chave declarada não comprova conteúdo, chaves não declaradas nem `notification_outbox`; não existe ferramenta de "comprovar quiescência".
5. **Recuperação nominal de contenção parcial/saída anormal** (ex.: `exit 143`, timeout de `wait`): hoje `contain` recusa fail-closed sem SIGKILL nem retomada. O replay de `contain` não repete o sinal já intencionado para o mesmo papel, mas **pode avançar a papéis seguintes** após um timeout (desligar restart, sinalizar e esperar outros serviços); não é "sem efeitos". `resume_legacy` sobre contenção parcial recusa sem efeitos. O procedimento manual de retorno precisa ser definido e revisado.
6. **Recuperação de retomada parcial**: se `resume_legacy` parar no meio (ex.: serviço iniciado sai antes de `restart=always` → `resume-not-fresh`; DDL, ingresso, identidade ou fila recusados após o primeiro início), a ferramenta fica parada com ingresso bloqueado e parte dos serviços já de pé, sem recuperação automática; o procedimento precisa ser definido e revisado.
7. O token `RESUME:<fingerprint>` vincula a identidade do host no diário; **não** representa aprovação humana nem autoriza ação.

### Plano enxuto em 5 fases e pacotes de aprovação

| Fase | Escopo objetivo | Portão de aprovação humana |
|---|---|---|
| **Fase 1 (atual)** | Consolidar roteiro enxuto e entregar A3 **parcial**: `ObservedHostTransport` + `ObservedHostContract` + `resume_legacy` como contrato/encoder sobre driver do chamador, com suíte sintética. Revisão independente concluída em 30/10/2026: GO para PR parcial, sem P0/P1, por GPT-6.1-Sol High e Sarah Opus 5.5 High. | **Pacote 1:** commit, push em branch própria e abertura da PR (sem merge). |
| **Fase 2 (A4)** | Acompanhar os 6 workflows automáticos na PR, integrar na `main`, confirmar `main` verde e gerar o pacote `.tar.gz` com `deploy/package_backend_release.py`. | **Pacote 2:** merge na `main` após CI verde. |
| **Fase 3 (A5 + A6)** | Preflight somente leitura no banco e VPS de PROD (`release_preflight.py`, `backend-release-ledger.sql`, `backend-release-inventory.sql`) e prova de backup/restore real (`backup-production.sh`) em banco temporário isolado antes de qualquer DDL. Inclui o inventário real de host/banco que alimenta a configuração/provedores do código A3 (bloqueadores 1–6 já têm implementação local). | **Pacote 3:** leitura read-only em PROD + execução de backup e restore em alvo isolado. |
| **Fase 4 (A7 + A8 + A9)** | **Pré-requisito: bloqueadores 1–6 resolvidos e revisados.** A9 ajustado pela decisão acima: preparar quatro candidatos, iniciar apenas backend para smoke e manter três consumidores contidos até A10. Na janela aprovada: conter os 4 serviços antigos (`restart=no` + `SIGTERM`) antes de fechar gates (evitando que o `cron-worker` cancele pendências de `notification_outbox` durante a janela) → verificar quiescência (ferramenta pendente) → backup novo da janela → aplicar as 51 migrations (43 TX / 8 NT) uma a uma via `migrate.py` → preparar quatro candidatos, iniciar apenas backend + painel para smoke e manter consumidores contidos até A10 → smoke `/health` e `/ready`. | **Pacote 4:** janela operacional de produção com horário, SHA e contingência definidos. |
| **Fase 5 (A10)** | Reabrir envio restrito ao piloto Filadélfia (equipe interna), monitorar filas/erros e concluir o aceite pastoral (20 conversas/cenários G12). | **Pacote 5:** reabertura do gate do piloto Filadélfia. |


**Validação de fechamento (30/10/2026):** sete suítes sintéticas pertinentes com Python 3.13.15: **333 passed, 49 subtests passed**; Ruff e `git diff --check` aprovados. Revisores avaliaram os bytes fornecidos; não executaram essa suíte. A suíte completa com casos PostgreSQL **não foi validada** (URL de fixture ausente), e os resultados do CI devem ser conferidos pelo SHA exato na PR; testes locais não os substituem. GO limitado à **PR parcial**. Pacote 1 autorizado nominalmente em 30/10/2026: commit, push sem force e abertura da PR; sem merge, dispatch manual, deploy, reativação, VPS ou produção. Antes da publicação foram reconfirmados DEV disabled_manually, DEV_PIPELINE_ENABLED=false, zero projetos Vercel ligados ao repositório e zero publicações ativas nos projetos do painel; deploymentEnabled=false permanece no código.

**P2 não bloqueantes desta PR:** port alternativo e diário do contrato observado permanecem na base de confiança do chamador; callback que contamine o diário durante execução local pode deixar diagnóstico `adapter-failed` antes da recusa; ampliar a matriz de estados intermediários continua melhoria de teste. Não há isolamento contra código malicioso no mesmo processo nem atomicidade entre observação e efeito. Implementação do driver real, prova operacional e recuperação nominal continuam bloqueadoras de produção, conforme itens 1–6.

## Fatia local — segurança do controlador (29/10/2026)

Base integrada `609952de`. Commit/push sem force e PR separada autorizados
em 29/10/2026, após reconferir suspensões; merge não autorizado.
Sem dispatch manual, deploy, reativação, novos ensaios físicos locais, VPS
ou produção. OPERATIONAL_AUTHORIZATION=BLOCKED para essas operações.
Pré-publicação: DEV disabled_manually e DEV_PIPELINE_ENABLED=false; painel
Vercel sem vínculo Git, nenhum projeto vinculado a este repositório na equipe,
nenhuma publicação em andamento; deploymentEnabled=false preservado.
Quatro checks obrigatórios app15368, strict=true e enforce_admins=true.
Abertura da PR aciona seis workflows de testes, incluindo recursos sintéticos
descartáveis no GitHub; não aciona publicação/deploy. Evidências de CI ficam
na PR por head exato; a validação local não as substitui.
Sinais SIGINT/SIGTERM/SIGHUP geram relatório e limpeza limitada; segunda
interrupção encerra a tentativa de limpeza. Subprocesso CLI próprio é encerrado
com espera limitada, nunca grupo alheio. Falha primária permanece fail.
CID ausente/vazio nunca é adotado por nome: preserva resíduo para recuperação
