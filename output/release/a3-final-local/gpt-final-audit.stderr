FILE deploy/first_transition_host_driver.py
"""Observation/containment/resume driver behind ObservedHostTransport.

``ObservedHostDriver.request(argv, *, timeout)`` answers the transport's
semantic commands from an injected runner plus explicit callbacks:

* inspect-host: pinned daemon, pinned network and the seven pinned containers
  through restricted ``--format`` stdout projections to Python, plus both ingress entries and the
  unknown-writer callback;
* redis-meta: TYPE/PTTL/LLEN/ZCARD on explicit keys via ``redis-cli`` inside the
  pinned, label-verified Redis container; no KEYS/SCAN/values/auth in argv, and
  an auth error is a refusal;
* block-ingress, ``docker update --restart=no``, ``docker kill --signal=TERM``
  and ``docker wait`` on the four legacy IDs only;
* resume (``docker start``, ``docker update --restart=always`` on the four
  legacy IDs and open-ingress through both bound entries) ONLY when a
  ``ledger_proof`` bound to this manifest is injected: a fresh read-only
  PostgreSQL proof (identity, exact baseline ledger, catalog; see
  first_transition_database.LedgerProof) runs inside every resume request,
  immediately before its effect. Without it, resume refuses before any call.

The writer binding reports UNKNOWN writers only: sources outside the declared
allowed ones (the transition's own observer/migration child and, once A9 starts
it, the configured candidate backend; see first_transition_orchestrator.assemble).

Every other operation refuses before any runner call. Ingress/writer values are
callback-reported scope-bound answers, not independent proof, and no token or
boolean stands for a human approval. Docker values are CLI-reported for an
operator-configured endpoint; nothing here certifies the host or quiescence.
Real bindings/manifest values are Phase 3 inputs.

The Docker CLI applies --format client-side; only its restricted stdout
projection enters Python/journals. Tests use synthetic data only.

Errors carry fixed codes only; runner output never enters exceptions, logs or
receipts. No retry: a timeout or refusal is final for that request. Each
request has a cooperative deadline, checked after injected calls return; per-command output caps are acceptance limits.
PopenRunner reads at most cap + 1 byte; joining buffers temporarily duplicates
that bounded storage (plus Python overhead), so this is not a cap on process RSS; an
injected runner's own buffering is its responsibility. Nothing runs at import
or construction; there is no command-line entry point.
"""
from __future__ import annotations

from collections.abc import Mapping
from dataclasses import dataclass
import json
import os
import re
import select
import subprocess
import time

from first_transition_adapter import ROLES, digest
from first_transition_host_transport import SUPPORT_ROLES, _ids, host_command
from initial_transition_ops import Refused, require

SCHEMA = 'igreja12.first-transition-host-manifest/1'
MANIFEST_KEYS = frozenset({'schema', 'daemon_id', 'legacy_project', 'network_id', 'service_ids', 'support_ids',
                           'processing_keys', 'gate_names'})
ENTRIES = ('external', 'evolution-backend')
QUEUE_KEYS = ('pastorai:webhooks', 'pastorai:webhooks:processing', 'pastorai:webhooks:dead',
              'pastorai:webhooks:retry-scheduled')
REDIS_COMMANDS = ('TYPE', 'PTTL', 'LLEN', 'ZCARD')
REDIS_TYPES = ('none', 'string', 'list', 'set', 'zset', 'hash', 'stream')
EFFECTS = ('restart-no', 'term', 'wait')
RESUME_EFFECTS = ('start', 'restart-always')
# Acceptance caps (bytes of stdout) per command; also PopenRunner's memory bound.
LIMITS = dict(info=256, network=1024, inspect=64 * 1024, redis=64, effect=256, wait=16)
MAX_OUTPUT = 1024 * 1024

HEX64 = re.compile('[0-9a-f]{64}')
DAEMON = re.compile('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[A-Z0-9]{4}(?::[A-Z0-9]{4}){11}')
PROJECT = re.compile(r'[A-Za-z0-9_-]{1,63}')
PROCESSING = re.compile(r'pastorai:webhooks:processing:[A-Za-z0-9_-]{1,80}')
MANDATORY_GATES = ('ALLOW_REAL_SENDS', 'ASAAS_BILLING_ENABLED', 'BREVO_SEND_MODE', 'BROADCAST_ASYNC_ENABLED')
NETWORK_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,127}')
IMAGE = re.compile('sha256:[0-9a-f]{64}')
STARTED = re.compile(r'[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})')
STATUSES = ('created', 'running', 'exited')
HEALTH = ('starting', 'healthy', 'unhealthy')
RUNNER_CODES = frozenset({'runner-argv', 'runner-bounds', 'runner-spawn-failed', 'runner-output-oversize',
                          'runner-close-failed', 'runner-failed', 'runner-pending-cli'})
PROJECT_LABEL = 'com.docker.compose.project'
SERVICE_LABEL = 'com.docker.compose.service'
REVISION_LABEL = 'org.opencontainers.image.revision'
INFO_ARGV = ('docker', 'info', '--format', '{{json .ID}}')
NETWORK_TEMPLATE = '[{{json .Id}},{{json .Name}}]'


def _gate_names(names):
    require(isinstance(names, (list, tuple)) and len(names) == len(MANDATORY_GATES)
            and all(isinstance(n, str) for n in names) and set(names) == set(MANDATORY_GATES),
            'manifest-gate-names')
    return tuple(sorted(names))


def _label(key):
    # A nil label map prints null and a missing key prints ""; both normalize to None.
    return '{{with .Config.Labels}}{{json (index . "' + key + '")}}{{else}}null{{end}}'


def inspect_template(gate_names):
    """One JSON array per container; the trusted Docker CLI filters env by name before stdout."""
    quoted = ' '.join('"' + name + '"' for name in _gate_names(gate_names))
    return ('[{{json .Id}},{{json .Image}},' + ','.join(_label(k) for k in (
            PROJECT_LABEL, SERVICE_LABEL, REVISION_LABEL)) + ','
            '{{json .State.Status}},{{json .State.Running}},{{json .State.Paused}},{{json .State.Restarting}},'
            '{{json .State.ExitCode}},{{json .State.StartedAt}},'
            '{{with .State.Health}}{{json .Status}}{{else}}null{{end}},'
            '{{json .RestartCount}},{{json .HostConfig.RestartPolicy.Name}},{{json .HostConfig.NetworkMode}},'
            '[{{range .Config.Env}}{{if eq (index (split . "=") 0) ' + quoted + '}}{{json .}},{{end}}{{end}}null],'
            '[{{range .Mounts}}[{{json .Type}},{{json .Name}},{{json .Source}},{{json .Destination}},'
            '{{json .RW}}],{{end}}null],'
            '[{{range $name, $net := .NetworkSettings.Networks}}[{{json $name}},{{json $net.Aliases}},'
            '{{json $net.NetworkID}}],{{end}}null]]')


@dataclass(frozen=True)
class HostManifest:
    """Sanitized, immutable scope; unknown keys (e.g. any secret) are refused."""
    daemon_id: str
    legacy_project: str
    network_id: str
    service_ids: tuple
    support_ids: tuple
    processing_keys: tuple
    gate_names: tuple
    digest: str

    @classmethod
    def from_dict(cls, data):
        require(isinstance(data, Mapping) and set(data) == MANIFEST_KEYS, 'manifest-keys')
        require(data['schema'] == SCHEMA, 'manifest-schema')
        require(isinstance(data['daemon_id'], str) and DAEMON.fullmatch(data['daemon_id']), 'manifest-daemon')
        require(isinstance(data['legacy_project'], str) and PROJECT.fullmatch(data['legacy_project']),
                'manifest-project')
        services, support = data['service_ids'], data['support_ids']
        require(_ids(services, ROLES) and _ids(support, SUPPORT_ROLES)
                and not set(services.values()) & set(support.values()), 'manifest-identities')
        require(isinstance(data['network_id'], str) and HEX64.fullmatch(data['network_id'])
                and data['network_id'] not in {*services.values(), *support.values()}, 'manifest-network')
        keys = data['processing_keys']
        require(isinstance(keys, (list, tuple)) and len(keys) <= 64 and all(isinstance(k, str) and PROCESSING.fullmatch(k) for k in keys)
                and len(set(keys)) == len(keys), 'manifest-processing-keys')
        values = dict(daemon_id=data['daemon_id'], legacy_project=data['legacy_project'],
                      network_id=data['network_id'], service_ids=tuple((r, services[r]) for r in ROLES),
                      support_ids=tuple((r, support[r]) for r in SUPPORT_ROLES), processing_keys=tuple(keys),
                      gate_names=_gate_names(data['gate_names']))
        return cls(**values, digest=digest([SCHEMA, values]))

    def validated(self):
        require(all(type(v) is tuple for v in (
            self.service_ids, self.support_ids, self.processing_keys, self.gate_names)), 'manifest-values')
        ok, canonical = _attempt(type(self).from_dict, {
            'schema': SCHEMA, 'daemon_id': self.daemon_id, 'legacy_project': self.legacy_project,
            'network_id': self.network_id, 'service_ids': dict(self.service_ids),
            'support_ids': dict(self.support_ids), 'processing_keys': self.processing_keys,
            'gate_names': self.gate_names})
        require(ok and self == canonical, 'manifest-integrity')
        return canonical

    def transport_scope(self):
        return dict(legacy_project=self.legacy_project, network_id=self.network_id,
                    service_ids=dict(self.service_ids), support_ids=dict(self.support_ids),
                    processing_keys=self.processing_keys)


def _strict_json(text):
    def constant(_):
        raise ValueError('constant')
    return json.loads(text, parse_constant=constant)


def _lines(out):
    text = out.decode('utf-8')
    if not text.endswith('\n'):
        raise ValueError('unterminated')
    return [_strict_json(line) for line in text[:-1].split('\n')]


def _attempt(function, *args):
    # The failure is reported after the except block: no exception context can
    # carry runner output into a later traceback.
    try:
        return True, function(*args)
    except (ValueError, UnicodeDecodeError, RecursionError, TypeError):
        return False, None


def _tail(value, code):
    require(isinstance(value, list) and value and value[-1] is None, code)
    return value[:-1]


class ObservedHostDriver:
    mode = 'observed-host'

    def __init__(self, manifest, *, runner, ingress, writers, ledger_proof=None):
        require(isinstance(manifest, HostManifest), 'driver-manifest')
        manifest = manifest.validated()
        require(callable(runner), 'driver-runner')
        require(isinstance(ingress, Mapping) and set(ingress) == set(ENTRIES)
                and ingress['external'] is not ingress['evolution-backend']
                and all(self._bound(ingress[e], manifest, e, 'observe', 'block') for e in ENTRIES),
                'driver-ingress-binding')
        require(self._bound(writers, manifest, None, 'observe'), 'driver-writer-binding')
        require(ledger_proof is None or self._bound(ledger_proof, manifest, None, 'prove'), 'driver-ledger-binding')
        self.manifest, self.runner = manifest, runner
        self.ingress, self.writers, self.ledger_proof = dict(ingress), writers, ledger_proof
        self.template = inspect_template(manifest.gate_names)
        self.roles = {ident: role for role, ident in (*manifest.service_ids, *manifest.support_ids)}
        self.legacy = tuple(ident for _, ident in manifest.service_ids)
        self.redis_id = dict(manifest.support_ids)['redis']
        self.redis_verified = False
        self.refusals = []  # fixed codes only, for diagnosis; never output
        self._bindings_fixed = (self.ingress['external'], self.ingress['evolution-backend'], self.writers,
                                ledger_proof)

    @property
    def supports_resume(self):
        # Resume needs the database proof and an opener on both ingress entries.
        return (self.ledger_proof is not None and self._bound(self.ledger_proof, self.manifest, None, 'prove')
                and all(self._bound(self.ingress[e], self.manifest, e, 'open') for e in ENTRIES))

    @staticmethod
    def _bound(binding, manifest, entry, *methods):
        return (binding is not None and getattr(binding, 'scope', None) == manifest.digest
                and (entry is None or getattr(binding, 'entry', None) == entry)
                and all(callable(getattr(binding, method, None)) for method in methods))

    def transport_scope(self):
        return self.manifest.transport_scope()

    def request(self, argv, *, timeout):
        try:
            self._assert_bindings()
            result = self._dispatch(argv, timeout)
            self._assert_bindings()
            return result
        except Refused as exc:
            self.refusals = [*self.refusals[-63:], str(exc)]
            raise

    def _assert_bindings(self):
        require(isinstance(self.ingress, dict) and set(self.ingress) == set(ENTRIES), 'driver-ingress-binding')
        for index, entry in enumerate(ENTRIES):
            require(self.ingress[entry] is self._bindings_fixed[index]
                    and self._bound(self.ingress[entry], self.manifest, entry, 'observe', 'block'),
                    'driver-ingress-binding')
        require(self.writers is self._bindings_fixed[2]
                and self._bound(self.writers, self.manifest, None, 'observe'), 'driver-writer-binding')
        require(self.ledger_proof is self._bindings_fixed[3], 'driver-ledger-binding')

    def _dispatch(self, argv, timeout):
        require(type(timeout) in (int, float) and 0 < timeout <= 30, 'driver-timeout-bound')
        require(type(argv) is tuple and argv and all(type(a) is str for a in argv), 'driver-operation-forbidden')
        deadline = time.monotonic() + timeout
        if argv == ('inspect-host',):
            return self._inspect_host(deadline)
        if argv[0] == 'redis-meta':
            require(len(argv) == 3 and argv[1] in REDIS_COMMANDS
                    and argv[2] in QUEUE_KEYS + self.manifest.processing_keys, 'driver-redis-scope')
            return self._redis_meta(argv[1], argv[2], deadline)
        if argv == ('block-ingress',):
            return self._block_ingress(deadline)
        if argv == ('open-ingress',):
            require(self.supports_resume, 'driver-operation-forbidden')
            return self._open_ingress(deadline)
        for kind in (*EFFECTS, *RESUME_EFFECTS):
            for ident in self.legacy:
                if argv == host_command(kind, ident):
                    require(kind in EFFECTS or self.supports_resume, 'driver-operation-forbidden')
                    return self._effect(kind, ident, argv, deadline)
        raise Refused('driver-operation-forbidden')

    @staticmethod
    def _remaining(deadline):
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError('driver-timeout')
        return remaining

    def _run(self, argv, deadline, limit):
        outcome = None
        try:
            result = self.runner(argv, timeout=self._remaining(deadline), max_output=limit)
        except TimeoutError:
            outcome = 'timeout'
        except Refused as exc:
            outcome = str(exc) if str(exc) in RUNNER_CODES else 'driver-runner-failed'
        except Exception:
            outcome = 'driver-runner-failed'
        if outcome == 'timeout':
            raise TimeoutError('driver-timeout')
        require(outcome is None, outcome)
        require(isinstance(result, tuple) and len(result) == 2 and type(result[0]) is int
                and type(result[1]) is bytes, 'driver-runner-failed')
        self._remaining(deadline)
        self._assert_bindings()
        require(len(result[1]) <= limit, 'driver-output-oversize')
        return result

    def _callback(self, binding, method, deadline, entry, code, failed='driver-binding-failed'):
        require(self._bound(binding, self.manifest, entry, method), code)
        outcome = None
        try:
            value = getattr(binding, method)(self.manifest.digest, timeout=self._remaining(deadline))
        except TimeoutError:
            outcome = 'timeout'
        except Exception:
            outcome = failed
        if outcome == 'timeout':
            raise TimeoutError('driver-timeout')
        self._remaining(deadline)
        require(self._bound(binding, self.manifest, entry, method), code)
        self._assert_bindings()
        require(outcome is None, outcome)
        return value

    def _daemon(self, deadline):
        rc, out = self._run(INFO_ARGV, deadline, LIMITS['info'])
        require(rc == 0, 'driver-daemon-failed')
        ok, value = _attempt(_lines, out)
        require(ok and len(value) == 1 and isinstance(value[0], str) and DAEMON.fullmatch(value[0]),
                'driver-daemon-malformed')
        require(value[0] == self.manifest.daemon_id, 'driver-daemon-mismatch')

    def _network(self, deadline):
        rc, out = self._run(('docker', 'network', 'inspect', '--format', NETWORK_TEMPLATE, self.manifest.network_id),
                            deadline, LIMITS['network'])
        require(rc == 0, 'driver-network-failed')
        ok, value = _attempt(_lines, out)
        require(ok and len(value) == 1 and isinstance(value[0], list) and len(value[0]) == 2
                and all(isinstance(v, str) for v in value[0]) and HEX64.fullmatch(value[0][0])
                and NETWORK_NAME.fullmatch(value[0][1]), 'driver-network-malformed')
        require(value[0][0] == self.manifest.network_id, 'driver-network-mismatch')
        return value[0]

    def _ingress(self, deadline):
        states = {}
        for entry in ENTRIES:
            value = self._callback(self.ingress[entry], 'observe', deadline, entry, 'driver-ingress-binding')
            require(type(value) is str and value in ('blocked', 'open'), 'driver-ingress-shape')
            states[entry] = value
        return states

    def _row(self, row, network_name):
        (ident, image, project, service, revision, status, running, paused, restarting, exit_code, started,
         health, restarts, policy, mode, gates, mounts, networks) = row
        labels = [None if value in (None, '') else value for value in (project, service, revision)]
        require(all(v is None or isinstance(v, str) and len(v) <= 128 for v in labels), 'driver-inspect-labels')
        require(isinstance(image, str) and IMAGE.fullmatch(image) and type(running) is bool
                and isinstance(status, str) and status in STATUSES and running == (status == 'running')
                and paused is False and restarting is False
                and type(exit_code) is int and 0 <= exit_code <= 255
                and isinstance(started, str) and STARTED.fullmatch(started)
                and (health is None or isinstance(health, str) and health in HEALTH)
                and type(restarts) is int and 0 <= restarts <= 10**6
                and isinstance(policy, str) and policy in ('always', 'no', '')
                and isinstance(mode, str) and len(mode) <= 128, 'driver-inspect-state')
        gates = _tail(gates, 'driver-inspect-gates')
        names = [g.split('=', 1)[0] if isinstance(g, str) and '=' in g else None for g in gates]
        require(all(n in self.manifest.gate_names for n in names) and len(set(names)) == len(names)
                and all(len(g) <= 512 for g in gates), 'driver-inspect-gates')
        mounts = _tail(mounts, 'driver-inspect-mounts')
        require(len(mounts) <= 64 and all(
            isinstance(m, list) and len(m) == 5 and type(m[4]) is bool
            and all(v is None or isinstance(v, str) and len(v) <= 4096 for v in m[:4]) for m in mounts),
            'driver-inspect-mounts')
        networks = _tail(networks, 'driver-inspect-networks')
        require(len(networks) <= 16 and all(
            isinstance(n, list) and len(n) == 3 and isinstance(n[0], str) and NETWORK_NAME.fullmatch(n[0])
            and (n[1] is None or isinstance(n[1], list) and all(isinstance(a, str) for a in n[1]))
            and isinstance(n[2], str) and HEX64.fullmatch(n[2]) for n in networks)
            and len({n[0] for n in networks}) == len(networks), 'driver-inspect-networks')
        require(network_name in {n[0] for n in networks}, 'driver-network-detached')
        require(any(n[0] == network_name and n[2] == self.manifest.network_id for n in networks),
                'driver-network-mismatch')
        # Stable configuration only: attachments by name/ID with configured aliases; IPAM is operational on some engines,
        # never IP, endpoint, gateway or MAC, which Docker clears on stop.
        attachments = [[n[0], sorted(n[1] or []), n[2]] for n in sorted(networks, key=lambda n: n[0])]
        return dict(
            id=ident, image=image, compose_project=labels[0], compose_service=labels[1], revision=labels[2],
            started=started, restart_count=restarts, restart_policy=policy or 'no', running=running,
            exit_code=None if running else exit_code, health=health,
            gates_digest=digest(['gates', sorted(gates)]),
            mounts_digest=digest(['mounts', sorted(mounts, key=json.dumps)]),
            networks_digest=digest(['networks', mode, attachments]))

    def _inspect_host(self, deadline):
        self.redis_verified = False
        self._daemon(deadline)
        network_id, network_name = self._network(deadline)
        ids = tuple(self.roles)
        rc, out = self._run(('docker', 'inspect', '--type', 'container', '--format', self.template, *ids),
                            deadline, LIMITS['inspect'])
        require(rc == 0, 'driver-inspect-failed')
        ok, rows = _attempt(_lines, out)
        require(ok and all(isinstance(r, list) and len(r) == 18 and isinstance(r[0], str) for r in rows),
                'driver-inspect-malformed')
        require(len(rows) == len(ids) and {r[0] for r in rows} == set(ids), 'driver-inspect-scope')
        services, support = {}, {}
        for row in rows:
            state, role = self._row(row, network_name), self.roles[row[0]]
            if role in ROLES:
                state.pop('health')
                services[role] = state
            else:
                support[role] = {key: state[key] for key in (
                    'id', 'image', 'compose_project', 'compose_service', 'running', 'restart_policy', 'health',
                    'networks_digest')}
        ingress = self._ingress(deadline)
        writers = self._callback(self.writers, 'observe', deadline, None, 'driver-writer-binding')
        require(type(writers) is int and 0 <= writers <= 10**6, 'driver-writer-shape')
        redis = support['redis']
        self.redis_verified = (redis['compose_project'] == self.manifest.legacy_project
                               and redis['compose_service'] == 'redis' and redis['running'] is True)
        return dict(scope_digest=self.manifest.digest,
                    ingress_blocked=all(v == 'blocked' for v in ingress.values()), unknown_writers=writers,
                    network_id=network_id, services=services, support=support)

    def _redis_meta(self, command, key, deadline):
        # Only into the Redis container this driver just verified by label; no auth in argv.
        require(self.redis_verified, 'driver-redis-unverified')
        self._daemon(deadline)
        rc, out = self._run(('docker', 'exec', self.redis_id, 'redis-cli', '--raw', command, key),
                            deadline, LIMITS['redis'])
        ok, text = _attempt(bytes.decode, out, 'ascii')
        require(ok, 'driver-redis-output')
        require(not text.startswith(('NOAUTH', 'WRONGPASS', 'NOPERM')), 'driver-redis-auth-required')
        require(rc == 0, 'driver-redis-failed')
        require(text.endswith('\n'), 'driver-redis-output')
        value = text[:-1]
        if command == 'TYPE':
            require(value in REDIS_TYPES, 'driver-redis-output')
            return value
        require(re.fullmatch('-?[0-9]{1,19}', value), 'driver-redis-output')
        return int(value)

    def _block_ingress(self, deadline):
        # Both entries are checked; one blocked entry never stands for the other.
        for entry, state in self._ingress(deadline).items():
            if state == 'open':
                require(self._callback(self.ingress[entry], 'block', deadline, entry,
                                       'driver-ingress-binding') is True, 'driver-ingress-receipt')
        require(all(v == 'blocked' for v in self._ingress(deadline).values()), 'driver-ingress-still-open')
        return True

    def _prove_ledger(self, deadline):
        # Fresh read-only database proof inside this very request, before its effect.
        proof = self._callback(self.ledger_proof, 'prove', deadline, None, 'driver-ledger-binding',
                               'driver-ledger-proof')
        require(isinstance(proof, dict) and proof.get('scope') == self.manifest.digest
                and proof.get('read_only') is True and proof.get('ddl_free') is True, 'driver-ledger-proof')

    def _open_ingress(self, deadline):
        # Internal Evolution->backend first, external last; both must end open.
        self._prove_ledger(deadline)
        for entry in reversed(ENTRIES):
            if self._ingress(deadline)[entry] == 'blocked':
                require(self._callback(self.ingress[entry], 'open', deadline, entry,
                                       'driver-ingress-binding') is True, 'driver-ingress-receipt')
        require(all(v == 'open' for v in self._ingress(deadline).values()), 'driver-ingress-still-blocked')
        return True

    def _effect(self, kind, ident, argv, deadline):
        if kind in RESUME_EFFECTS:
            self._prove_ledger(deadline)
        self._daemon(deadline)
        if kind == 'wait':
            rc, out = self._run(argv, deadline, LIMITS['wait'])
            ok, text = _attempt(bytes.decode, out, 'ascii')
            require(ok and rc == 0 and re.fullmatch('[0-9]{1,3}\n', text), 'driver-wait-receipt')
            return int(text)
        rc, out = self._run(argv, deadline, LIMITS['effect'])
        require(rc == 0 and out == (ident + '\n').encode(), 'driver-effect-receipt')
        return True


GLOBAL_FLAGS = frozenset({'-H', '--host', '--context', '-c', '--config', '--tls', '--tlsverify', '--tlscacert',
                          '--tlscert', '--tlskey', '-D', '--debug', '-l', '--log-level'})
ENV = {'LC_ALL': 'C', 'LANG': 'C'}
ABS_PATH = re.compile('/[A-Za-z0-9._/-]{1,255}')


def _absolute(path):
    return (isinstance(path, str) and ABS_PATH.fullmatch(path) is not None
            and all(part not in ('', '.', '..') for part in path[1:].split('/')))


def _runner_argv(argv, resume=False):
    if not (type(argv) is tuple and 2 <= len(argv) <= 32 and argv[0] == 'docker'
            and all(type(a) is str and 0 < len(a) <= 16384 and '\x00' not in a for a in argv)):
        return False
    if argv == INFO_ARGV:
        return True
    if len(argv) == 6 and argv[:5] == ('docker', 'network', 'inspect', '--format', NETWORK_TEMPLATE):
        return HEX64.fullmatch(argv[5]) is not None
    if 7 <= len(argv) <= 13 and argv[:6] == (
            'docker', 'inspect', '--type', 'container', '--format', inspect_template(MANDATORY_GATES)):
        return all(HEX64.fullmatch(i) for i in argv[6:]) and len(set(argv[6:])) == len(argv[6:])
    if len(argv) == 7 and argv[:2] == ('docker', 'exec'):
        return (HEX64.fullmatch(argv[2]) is not None and argv[3:5] == ('redis-cli', '--raw')
                and argv[5] in REDIS_COMMANDS and (argv[6] in QUEUE_KEYS or PROCESSING.fullmatch(argv[6])))
    if len(argv) == 4 and argv[:3] in (('docker', 'update', '--restart=no'),
                                     ('docker', 'kill', '--signal=TERM')):
        return HEX64.fullmatch(argv[3]) is not None
    if resume and (len(argv) == 4 and argv[:3] == ('docker', 'update', '--restart=always')
                   or len(argv) == 3 and argv[:2] == ('docker', 'start')):
        return HEX64.fullmatch(argv[-1]) is not None
    return len(argv) == 3 and argv[:2] == ('docker', 'wait') and HEX64.fullmatch(argv[2]) is not None


class PopenRunner:
    """Bounded docker CLI runner for a future authorized operator; never used by tests unmocked.

    The endpoint (``unix://`` socket), docker binary and an operator-provided
    config directory are explicit; the child gets a minimal environment, so no
    inherited DOCKER_HOST/DOCKER_CONTEXT/credentials/HOME apply. Only block-A
    read/containment subcommands are accepted, plus ``start``/``restart=always``
    by ID only when constructed with ``resume=True``. On timeout, oversize or error it
    ends only its own CLI process, waits at most ``cleanup_wait`` and never
    retries; an unreaped CLI is counted, not escalated. Killing the CLI does not
    undo a request the daemon already received. Compatibility with a real
    Docker CLI/daemon is unverified here.
    """

    def __init__(self, *, docker_binary, endpoint, config_dir, popen=None, cleanup_wait=2.0, chunk=4096,
                 resume=False):
        require(_absolute(docker_binary) and docker_binary.endswith('/docker')
                and isinstance(endpoint, str) and endpoint.startswith('unix://')
                and _absolute(endpoint[len('unix://'):]) and endpoint.endswith('.sock')
                and _absolute(config_dir) and (popen is None or callable(popen))
                and type(cleanup_wait) in (int, float) and 0 < cleanup_wait <= 10
                and type(chunk) is int and 0 < chunk <= 65536 and type(resume) is bool, 'runner-config')
        self.resume = resume
        self.docker_binary, self.endpoint, self.config_dir = docker_binary, endpoint, config_dir
        self.popen, self.cleanup_wait, self.chunk = popen, cleanup_wait, chunk
        self.unreaped = 0

    def _allowed(self, argv):
        return _runner_argv(argv, self.resume)

    def _env(self):
        return dict(ENV)

    def __call__(self, argv, *, timeout, max_output):
        require(self.unreaped == 0, 'runner-pending-cli')
        require(self._allowed(argv), 'runner-argv')
        require(type(timeout) in (int, float) and 0 < timeout <= 60
                and type(max_output) is int and 0 < max_output <= MAX_OUTPUT, 'runner-bounds')
        deadline = time.monotonic() + timeout
        popen = self.popen or subprocess.Popen  # resolved per call, never at import/construction
        command = [self.docker_binary, '--config', self.config_dir, '--host', self.endpoint, *argv[1:]]
        proc = None
        try:
            proc = popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                         env=self._env(), cwd='/', close_fds=True, shell=False, start_new_session=True)
        except Exception:
            pass
        require(proc is not None, 'runner-spawn-failed')
        outcome = 'runner-failed'
        try:
            out = self._read(proc, deadline, max_output)
            rc = proc.wait(timeout=max(deadline - time.monotonic(), 0))
            outcome = None
        except (TimeoutError, subprocess.TimeoutExpired):
            outcome = 'timeout'
        except Refused as exc:
            outcome = str(exc)
        except Exception:
            pass
        except BaseException:
            self._cleanup(proc)
            raise
        finally:
            try:
                proc.stdout.close()
            except Exception:
                if outcome is None:
                    outcome = 'runner-close-failed'
        if outcome is None and time.monotonic() > deadline:
            outcome = 'timeout'
        if outcome is not None:
            self._cleanup(proc)
            if outcome == 'timeout':
                raise TimeoutError('runner-timeout')
            raise Refused(outcome)
        return rc, out

    def _read(self, proc, deadline, limit):
        fd, chunks, size = proc.stdout.fileno(), [], 0
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0 or not select.select([fd], [], [], remaining)[0]:
                raise TimeoutError('runner-timeout')
            chunk = os.read(fd, min(self.chunk, limit + 1 - size))
            if not chunk:
                return b''.join(chunks)
            size += len(chunk)
            chunks.append(chunk)
            require(size <= limit, 'runner-output-oversize')

    def _cleanup(self, proc):
        # Ends only this runner's own CLI child; never a container, never a retry.
        try:
            if proc.poll() is None:
                proc.kill()
            proc.wait(timeout=self.cleanup_wait)
        except Exception:
            self.unreaped += 1

FILE deploy/first_transition_database.py
"""Read-only PostgreSQL observations of the first transition over an injected connection.

``ReadOnlyDatabase.observe`` opens a fresh connection from the injected factory,
runs one ``REPEATABLE READ READ ONLY`` transaction and returns aggregates only:
database identity, role visibility over pg_stat_activity, the ordered ledger,
the public catalog digest (same query as the local adapter), invalid indexes,
index builds, writing sessions and active leases. No row payload, query text,
PII or session detail is read. ``LedgerProof`` binds that observation to an
expected identity/baseline ledger/catalog: any DDL or ledger drift refuses. It
is the fresh database proof the observed driver requires before every resume
effect; a journal without a DDL marker alone is never accepted as that proof.

Nothing connects at import or construction. The real connection factory and
expected values are Phase 3 inputs (A5 preflight); errors are fixed codes.
"""
from __future__ import annotations

from collections.abc import Callable
from dataclasses import dataclass
import re

from first_transition_adapter import digest
from initial_transition_ops import Refused, require

HEX64 = re.compile('[0-9a-f]{64}')
IDENT = re.compile('[a-z_][a-z0-9_]{0,62}')
APPLICATION = re.compile(r'[A-Za-z0-9_.:-]{1,63}')
LEDGER_NAME = re.compile(r'[A-Za-z0-9_.-]{1,200}\.sql')
# Lease columns of the consumers (active lease = column > now()). Counted, never read.
LEASES = (('broadcast_execucoes', 'lease_ate'), ('broadcast_entregas', 'lease_ate'),
          ('notification_outbox', 'claimed_until'), ('cell_report_audio_inputs', 'lease_until'))
OBSERVER_APPLICATION = 'igreja12-first-transition-observer'

CURRENT_DB = '(SELECT oid FROM pg_database WHERE datname=current_database())'
Q_BEGIN = 'BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY'
Q_TIMEOUT = "SELECT set_config('statement_timeout', %s, true)"
Q_PATH = "SELECT set_config('search_path', 'pg_catalog,public', true)"
Q_RLS_OFF = "SELECT set_config('row_security', 'off', true)"
Q_READ_ONLY = "SELECT current_setting('transaction_read_only')"
Q_IDENTITY = ('SELECT s.system_identifier::text, d.oid::bigint, d.datname FROM pg_control_system() s, '
              'pg_database d WHERE d.datname=current_database()')
# USAGE, not MEMBER: a non-inherited membership does not make other sessions' activity visible.
Q_VISIBILITY = ("SELECT r.rolsuper OR pg_has_role(current_user, 'pg_read_all_stats', 'USAGE') "
                'FROM pg_roles r WHERE r.rolname=current_user')
Q_LEDGER = 'SELECT name FROM public.schema_migrations ORDER BY name COLLATE "C"'
Q_INVALID = ('SELECT c.relname FROM pg_index i JOIN pg_class c ON c.oid=i.indexrelid JOIN pg_namespace n '
             "ON n.oid=c.relnamespace WHERE n.nspname='public' AND NOT (i.indisvalid AND i.indisready) "
             'ORDER BY c.relname')
Q_INDEXES = ("SELECT c.relname FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace "
             "WHERE n.nspname='public' AND c.relkind='i' ORDER BY c.relname")
Q_BUILDS = 'SELECT count(*) FROM pg_stat_progress_create_index WHERE datid=' + CURRENT_DB
Q_CATALOG = ('SELECT c.oid,c.relname,c.relkind,a.attnum,a.attname,a.atttypid,a.attnotnull FROM pg_class c '
             'JOIN pg_namespace n ON n.oid=c.relnamespace LEFT JOIN pg_attribute a ON a.attrelid=c.oid '
             "AND a.attnum>0 AND NOT a.attisdropped WHERE n.nspname='public' ORDER BY c.oid,a.attnum")
# Potential writer = any other client session of this database holding an xid or not idle (active,
# idle in transaction, unknown state). Only this observer's own PID is excluded; no application_name
# exempts a session (a writer may not hold an xid yet). Only counted; never query/user/address.
Q_WRITERS = ('SELECT count(*) FROM pg_stat_activity WHERE datid=' + CURRENT_DB + ' AND pid<>pg_backend_pid() '
             "AND backend_type='client backend' AND (backend_xid IS NOT NULL OR state IS DISTINCT FROM 'idle')")
Q_RELATION = "SELECT to_regclass(%s) IS NOT NULL"


def lease_query(table, column):
    require(IDENT.fullmatch(table) and IDENT.fullmatch(column), 'database-lease-scope')
    return f'SELECT count(*) FROM public."{table}" WHERE "{column}" > now()'


def _single(cur, query, params=None):
    cur.execute(query, params) if params is not None else cur.execute(query)
    rows = cur.fetchall()
    require(isinstance(rows, (list, tuple)) and len(rows) == 1 and len(rows[0]) >= 1, 'database-observation-shape')
    return rows[0]


def _count(cur, query, params=None):
    value = _single(cur, query, params)[0]
    require(type(value) is int and 0 <= value <= 2**62, 'database-observation-shape')
    return value


@dataclass(frozen=True)
class DatabaseExpectation:
    """Identity + exact baseline ledger + catalog digest, from configuration (A5)."""
    identity: str
    ledger: tuple
    catalog: str

    def validated(self):
        require(isinstance(self.identity, str) and HEX64.fullmatch(self.identity)
                and isinstance(self.catalog, str) and HEX64.fullmatch(self.catalog)
                and type(self.ledger) is tuple and self.ledger
                and all(isinstance(n, str) and LEDGER_NAME.fullmatch(n) for n in self.ledger)
                and list(self.ledger) == sorted(set(self.ledger)), 'database-expectation')
        return self

    @property
    def baseline_digest(self):
        # Same value as first_transition_adapter.baseline_digest over an observation.
        return digest([list(self.ledger), self.catalog])


class ReadOnlyDatabase:
    """``observer_applications`` stays accepted (validated) for configuration compatibility only:
    application names are labels, never a bypass of the activity predicate of ``Q_WRITERS``."""

    def __init__(self, connect: Callable, *, lease_columns=LEASES, observer_applications=()):
        require(callable(connect), 'database-connect-missing')
        require(isinstance(lease_columns, tuple) and lease_columns and all(
            isinstance(p, tuple) and len(p) == 2 and all(isinstance(v, str) and IDENT.fullmatch(v) for v in p)
            for p in lease_columns) and len(set(lease_columns)) == len(lease_columns), 'database-lease-scope')
        require(isinstance(observer_applications, tuple) and len(observer_applications) <= 8
                and all(isinstance(a, str) and APPLICATION.fullmatch(a) for a in observer_applications),
                'database-observer-scope')
        self.connect, self.lease_columns = connect, lease_columns
        self.observer_applications = (OBSERVER_APPLICATION, *observer_applications)

    def observe(self, *, timeout=10):
        require(type(timeout) in (int, float) and 0 < timeout <= 30, 'database-timeout-bound')
        conn, outcome = None, None
        try:
            conn = self.connect(timeout=timeout)
            result = self._observe(conn, timeout)
        except Refused as exc:
            outcome = str(exc) if str(exc).startswith('database-') else 'database-observation-failed'
        except Exception:
            outcome = 'database-observation-failed'
        finally:
            if conn is not None:
                try:
                    conn.close()
                except Exception:
                    outcome = outcome or 'database-observation-failed'
        require(outcome is None, outcome)
        return result

    def _observe(self, conn, timeout):
        conn.autocommit = True
        cur = conn.cursor()
        cur.execute(Q_BEGIN)
        try:
            _single(cur, Q_TIMEOUT, (f'{int(timeout * 1000)}ms',))
            _single(cur, Q_PATH)
            # With row_security=off a restricted role errors instead of hiding leased rows.
            require(_single(cur, Q_RLS_OFF)[0] == 'off', 'database-row-security')
            read_only = _single(cur, Q_READ_ONLY)[0] == 'on'
            require(read_only, 'database-not-read-only')
            system, oid, name = _single(cur, Q_IDENTITY)[:3]
            require(isinstance(system, str) and system.isdigit() and type(oid) is int and isinstance(name, str),
                    'database-observation-shape')
            visible = _single(cur, Q_VISIBILITY)[0]
            require(visible is True, 'database-activity-not-visible')
            cur.execute(Q_LEDGER)
            ledger = tuple(row[0] for row in cur.fetchall())
            require(all(isinstance(n, str) and LEDGER_NAME.fullmatch(n) for n in ledger), 'database-ledger-shape')
            cur.execute(Q_INVALID)
            invalid = tuple(row[0] for row in cur.fetchall())
            cur.execute(Q_INDEXES)
            indexes = tuple(row[0] for row in cur.fetchall())
            builds = _count(cur, Q_BUILDS)
            cur.execute(Q_CATALOG)
            catalog = digest([list(row) for row in cur.fetchall()])
            writers = _count(cur, Q_WRITERS)
            leases = 0
            for table, column in self.lease_columns:
                require(_single(cur, Q_RELATION, ('public.' + table,))[0] is True, 'database-lease-relation')
                leases += _count(cur, lease_query(table, column))
            return dict(identity=digest([system, oid, name]), read_only=True, activity_visible=True,
                        ledger=ledger, ledger_digest=digest(list(ledger)), catalog=catalog, invalid=invalid,
                        indexes=indexes, index_builds=builds, writing_sessions=writers, active_leases=leases)
        finally:
            cur.execute('ROLLBACK')


def require_same_database(observation, expected):
    """Read-only observation with visible activity, of the expected database identity."""
    require(observation['read_only'] is True and observation['activity_visible'] is True, 'database-not-read-only')
    require(observation['identity'] == expected.identity, 'database-identity-mismatch')


def require_ddl_free(observation, expected):
    """The observed database is exactly the expected baseline: no DDL, no ledger drift."""
    require_same_database(observation, expected)
    require(observation['ledger'] == expected.ledger, 'database-ledger-drift')
    require(observation['catalog'] == expected.catalog, 'database-ddl-drift')
    require(not observation['invalid'] and observation['index_builds'] == 0, 'database-ddl-in-progress')


def require_quiet(observation):
    require(observation['writing_sessions'] == 0, 'database-writing-session')
    require(observation['active_leases'] == 0, 'database-active-lease')


def summary(observation):
    """Journal-safe aggregates (no names beyond the ledger digest)."""
    return {key: observation[key] for key in ('identity', 'ledger_digest', 'catalog', 'index_builds',
                                             'writing_sessions', 'active_leases')} | dict(
        ledger_count=len(observation['ledger']), invalid_count=len(observation['invalid']))


class LedgerProof:
    """Fresh read-only proof, bound to a host scope, that no DDL ran since the baseline."""

    def __init__(self, database, expected, *, scope):
        require(isinstance(database, ReadOnlyDatabase), 'database-proof-source')
        require(isinstance(expected, DatabaseExpectation), 'database-expectation')
        require(isinstance(scope, str) and HEX64.fullmatch(scope), 'database-proof-scope')
        self.database, self.expected, self.scope = database, expected.validated(), scope

    def prove(self, scope, *, timeout):
        require(scope == self.scope, 'database-proof-scope')
        observation = self.database.observe(timeout=min(timeout, 30))
        require_ddl_free(observation, self.expected)
        return dict(scope=scope, read_only=True, ddl_free=True, identity=observation['identity'],
                    ledger_digest=observation['ledger_digest'], catalog=observation['catalog'])


def psycopg2_connector(secret, *, application_name=OBSERVER_APPLICATION):
    """Connection factory for a future authorized run; the URL comes only from ``secret()``.

    The session is forced read-only by default; the URL is never stored,
    logged or put in argv. Unused by tests.
    """
    require(callable(secret) and APPLICATION.fullmatch(application_name), 'database-connect-missing')

    def connect(*, timeout):
        import psycopg2
        url = secret()
        require(isinstance(url, str) and url.startswith('postgresql://') and '\n' not in url, 'database-secret')
        return psycopg2.connect(url, connect_timeout=max(1, int(timeout)), application_name=application_name,
                                options='-c default_transaction_read_only=on')
    return connect

FILE deploy/first_transition_orchestrator.py
"""First-transition orchestration over injected ports, up to A9 (never A10).

Sequence (one durable journal, shared with ObservedHostContract):

1. fresh read-only database baseline equal to the configured expectation;
2. ObservedHostContract.contain(): ingress blocked, four legacy restart=no,
   SIGTERM, clean exit 0;
3. two consecutive bounded fresh observations, each with the host still
   contained and zero writing sessions and zero active leases in the database;
4. injected backup/restore + clone rehearsal receipt validated against the plan,
   identity and baseline (first_transition_adapter.validate_clone_receipt);
5. final pre-DDL re-check, then the durable irrevocable ``ddl-marker``;
6. the 51 pending migrations (43 transactional, 8 CONCURRENTLY) one by one via
   the exact pinned ``backend/scripts/migrate.py`` bytes of the Plan, each with
   a durable intent first; the first failure or doubt stops for good;
7. candidate release layout ``<release_root>/<sha>`` (first_transition_candidate);
8. A9: four candidate containers created held (restart=no, gates closed), ONLY
   the backend started and smoked; consumers proven never started; legacy
   stopped, support preserved and ingress blocked throughout. The running
   candidate backend is a declared allowed source for the injected writer
   binding (see ``assemble``), never an unknown writer.

Recovery is objective (``recovery()``), never automatic: no undo, no retry of a
destructive operation, no legacy resume once the DDL marker exists. A
pre-DDL legacy resume goes through ObservedHostContract.resume_legacy, whose
driver requires a fresh read-only ledger proof before every effect.

Configuration (``load_config``) holds public values only; secrets reach the
migration child exclusively through its isolated environment. Nothing runs at
import; there is no command-line entry point and no production operation here.
"""
from __future__ import annotations

from dataclasses import dataclass
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import time

from first_transition_adapter import APPLICATION_SHA, EXECUTOR_SHA, ROLES, Plan, digest, validate_clone_receipt
from first_transition_candidate import (CONSUMERS, CandidatePort, CandidateRunner, CandidateSpec, check_backend_running,
                                        check_held, check_identity, write_candidate_release, write_hold_override)
from first_transition_database import (LEASES, DatabaseExpectation, LedgerProof, ReadOnlyDatabase, require_ddl_free,
                                       require_quiet, require_same_database, summary)
from first_transition_host_contract import ObservedHostContract
from first_transition_host_driver import HostManifest, ObservedHostDriver, PopenRunner, _absolute
from first_transition_host_transport import ObservedHostTransport
from initial_transition_files import Journal, no_symlink, read_regular
from initial_transition_ops import Refused, require

CONFIG_SCHEMA = 'igreja12.first-transition-config/1'
CONFIG_KEYS = frozenset({'schema', 'repo', 'state_dir', 'migration_workdir', 'python', 'docker', 'database',
                         'host', 'candidate', 'package_manifest_sha256', 'timeouts'})
TIMEOUTS = dict(migration_s=300, observe_s=10, quiescence_interval_s=5, quiescence_budget_s=60)
SHAPE = (51, 43, 8)  # pending, transactional, CONCURRENTLY
PROCEDURES = {
    'not-started': 'nothing intended: no recovery action',
    'containment-partial': 'replay run(): contain() never re-signals; an unclean exit stays refused for a human',
    'contained-pre-ddl': 'replay run() or resume_legacy(token): fresh ledger proof before every effect',
    'resume-partial': 'replay resume_legacy(token): receipted roles re-proven, ledger proof per effect',
    'legacy-resumed': 'legacy back with ingress open: start a new journal for any later attempt',
    'ddl-ambiguous': 'stop: no retry, no legacy; inspect ledger/indexes read-only and decide restore (A6) or completion',
    'ddl-failed': 'stop: no retry, no legacy; restore from the validated backup (A6) or fix forward by a new decision',
    'post-ddl-failed': 'stop: no legacy; keep ingress blocked and inspect the failure read-only before a decision',
    'candidate-ambiguous': 'stop: no undo; inspect the candidate project read-only, nothing restarted or removed',
    'candidate-failed': 'stop: no undo; consumers stay held, ingress blocked; human decision on the backend',
    'a9-complete': 'hold: backend smoked, consumers held, ingress blocked; A10 needs its own authorization',
}
PROCESS_ENV = frozenset({'PATH', 'LC_ALL', 'LANG', 'PYTHON_DOTENV_DISABLED', 'MIGRATION_DATABASE_URL', 'PGAPPNAME',
                         'PGCONNECT_TIMEOUT'})


class ProcessRunner:
    """Generic safe runner: allowlisted absolute binaries, constructed env, no shell, output discarded.

    The environment is the only channel for secrets: argv never carries one and
    no output is captured, so nothing can reach logs or exceptions.
    """

    def __init__(self, *, binaries, run=None):
        require(isinstance(binaries, tuple) and binaries and all(_absolute(b) for b in binaries)
                and (run is None or callable(run)), 'process-runner-config')
        self.binaries, self.run = binaries, run

    def __call__(self, argv, *, env, cwd, timeout):
        require(type(argv) is tuple and argv and argv[0] in self.binaries
                and all(type(a) is str and 0 < len(a) <= 4096 and '\x00' not in a for a in argv), 'process-argv')
        require(isinstance(env, dict) and set(env) <= PROCESS_ENV
                and all(type(v) is str and '\x00' not in v for v in env.values()), 'process-env')
        require(_absolute(cwd) and type(timeout) in (int, float) and 0 < timeout <= 3600, 'process-bounds')
        run = self.run or subprocess.run  # resolved per call, never at import/construction
        outcome = None
        try:
            done = run(list(argv), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       env=dict(env), cwd=cwd, timeout=timeout, close_fds=True, shell=False, check=False)
        except subprocess.TimeoutExpired:
            outcome = 'timeout'
        except Exception:
            outcome = 'process-spawn-failed'
        if outcome == 'timeout':
            raise TimeoutError('process-timeout')
        require(outcome is None and type(getattr(done, 'returncode', None)) is int, outcome or 'process-failed')
        return done.returncode


class MigrationExecutor:
    """One pending migration through the exact pinned migrate.py bytes of the Plan.

    ``python <dir>/scripts/migrate.py apply <name> --yes [--no-transaction]``
    in a fresh exclusive directory under the configured workdir; the database
    URL comes from ``secret()`` straight into the child environment.
    """

    def __init__(self, plan, *, python, workdir, secret, runner, timeout=300):
        require(isinstance(plan, Plan) and plan.application_sha == APPLICATION_SHA
                and plan.executor_sha == EXECUTOR_SHA, 'migration-plan')
        require(_absolute(python) and _absolute(workdir) and callable(secret) and callable(runner)
                and type(timeout) is int and 0 < timeout <= 3600, 'migration-executor-config')
        self.plan, self.python, self.workdir = plan, python, workdir
        self.secret, self.runner, self.timeout = secret, runner, timeout

    @staticmethod
    def command(python, directory, migration):
        return (python, '-I', f'{directory}/scripts/migrate.py', 'apply', migration.name, '--yes',
                *(('--no-transaction',) if migration.concurrent else ()))

    def _materialize(self, index, migration):
        root = no_symlink(Path(self.workdir))
        require(os.path.lexists(root) and stat.S_ISDIR(os.lstat(root).st_mode), 'migration-workdir-missing')
        directory = root / f'{index:02d}-{self.plan.digest[:16]}'
        try:
            directory.mkdir(mode=0o700)  # exclusive: a previous attempt's directory refuses
        except FileExistsError:
            raise Refused('migration-workdir-exists') from None
        (directory / 'scripts').mkdir(mode=0o700)
        (directory / 'migrations').mkdir(mode=0o700)
        for path, data in (('scripts/migrate.py', self.plan.executor), ('migrations/' + migration.name, migration.sql)):
            fd = os.open(directory / path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            with os.fdopen(fd, 'wb') as handle:
                handle.write(data)
        return str(directory)

    def apply(self, index, migration):
        require(migration in self.plan.pending and self.plan.pending[index - 1] is migration, 'migration-not-pending')
        directory = self._materialize(index, migration)
        url = self.secret()
        require(isinstance(url, str) and url.startswith('postgresql://') and '\n' not in url, 'migration-secret')
        env = dict(PATH='/usr/bin:/bin', LC_ALL='C', PYTHON_DOTENV_DISABLED='1', MIGRATION_DATABASE_URL=url,
                   PGAPPNAME=f'pastorai-first-transition-{index:02d}', PGCONNECT_TIMEOUT='10')
        return self.runner(self.command(self.python, directory, migration), env=env, cwd=directory,
                           timeout=self.timeout)


class FirstTransition:
    def __init__(self, *, plan, journal, host, database, expected, backup_proof, executor, layout, candidate,
                 config_digest, clock=time.monotonic, sleep=time.sleep, timeouts=None):
        for value, kind, code in ((plan, Plan, 'plan'), (journal, Journal, 'journal'),
                                  (host, ObservedHostContract, 'host'), (database, ReadOnlyDatabase, 'database'),
                                  (expected, DatabaseExpectation, 'expectation'),
                                  (executor, MigrationExecutor, 'executor'), (candidate, CandidatePort, 'candidate')):
            require(isinstance(value, kind), 'transition-' + code + '-missing')
        require(callable(backup_proof), 'transition-backup-missing')
        require(callable(layout), 'transition-layout-missing')
        require(journal.lock_fd is not None and host.j is journal, 'transition-journal')
        require(executor.plan is plan and candidate.spec.sha == plan.application_sha, 'transition-plan-binding')
        pending = plan.pending
        require((len(pending), sum(not m.concurrent for m in pending), sum(m.concurrent for m in pending)) == SHAPE,
                'transition-release-shape')
        require(expected.validated().ledger == plan.baseline, 'transition-expectation-baseline')
        require(isinstance(config_digest, str) and re.fullmatch('[0-9a-f]{64}', config_digest), 'transition-config')
        self.t = {**TIMEOUTS, **(timeouts or {})}
        self.plan, self.j, self.host, self.db, self.expected = plan, journal, host, database, expected
        self.backup_proof, self.executor, self.layout, self.candidate = backup_proof, executor, layout, candidate
        self.config_digest, self.clock, self.sleep = config_digest, clock, sleep

    # -- journal helpers -------------------------------------------------------------------
    def _intent(self, step, **fields):
        return self.j.append('transition-intent', step=step, **fields)

    def _done(self, step, **fields):
        return self.j.append('transition-done', step=step, **fields)

    def _open(self, step):
        """Intent without receipt: the outcome is unknown and never retried automatically."""
        return (self.j.last('transition-intent', step) is not None
                and self.j.last('transition-done', step) is None)

    def _observe(self):
        return self.db.observe(timeout=self.t['observe_s'])

    def _init(self):
        init = self.j.last('transition-init')
        values = dict(plan_digest=self.plan.digest, config_digest=self.config_digest,
                      baseline_digest=self.expected.baseline_digest, application_sha=self.plan.application_sha,
                      executor_sha=self.plan.executor_sha, candidate_image=self.candidate.spec.image)
        if init is None:
            self.j.append('transition-init', production_ready=False, **values)
        else:
            require(all(init.get(k) == v for k, v in values.items()), 'transition-inputs-changed')

    # -- entry points --------------------------------------------------------------------------
    def run(self):
        self._init()
        require(self.j.last('observed-host-intent', 'legacy-resume') is None, 'transition-legacy-resume-started')
        require(self.j.last('transition-failed') is None, 'transition-stopped')  # first failure is final
        try:
            if self.j.last('ddl-marker') is None:
                self._baseline()
                self.host.contain()
                self._quiesce()
                self._backup()
                self._mark_ddl()
            self._migrate()
            self._release_layout()
            return self._a9()
        except BaseException as exc:
            if self.j.last('ddl-marker') is not None:
                self.j.append('transition-failed', code=str(exc) if isinstance(exc, Refused) else 'interrupted',
                              legacy_resume_allowed=False)
            raise

    def resume_legacy(self, confirmation, *, allow_queue_drift=False):
        """Pre-DDL only; the contract and the driver's ledger proof re-check everything."""
        require(self.j.last('ddl-marker') is None and not self.j.find('transition-intent'),
                'post-ddl-resume-forbidden')
        return self.host.resume_legacy(confirmation, allow_queue_drift=allow_queue_drift)

    # -- pre-DDL ---------------------------------------------------------------------------------
    def _baseline(self):
        observation = self._observe()
        require_ddl_free(observation, self.expected)
        if self.j.last('transition-baseline') is None:
            self.j.append('transition-baseline', evidence='database-read-only', **summary(observation))

    def _quiet_observation(self):
        receipt = self.host.assert_contained()
        observation = self._observe()
        require_ddl_free(observation, self.expected)
        require_quiet(observation)
        return receipt['fingerprint'], receipt['queue_digest'], summary(observation)

    def _quiesce(self):
        start = self.clock()
        first = self._quiet_observation()
        self.sleep(self.t['quiescence_interval_s'])
        second = self._quiet_observation()
        require(self.clock() - start <= self.t['quiescence_budget_s'], 'transition-quiescence-unbounded')
        require(first == second, 'transition-quiescence-changed')
        self.j.append('transition-quiescent', observations=2, writing_sessions=0, active_leases=0,
                      host_fingerprint=first[0], queue_digest=first[1], evidence='database-read-only')

    def _backup(self):
        receipt = self.backup_proof()
        require(isinstance(receipt, dict), 'clone-receipt-invalid')
        validate_clone_receipt(receipt, self.plan, self.expected.identity, self.expected.baseline_digest)
        recorded = self.j.last('transition-backup')
        if recorded is None:
            self.j.append('transition-backup', receipt_digest=digest(receipt), restore_verified=True)
        else:
            require(recorded['receipt_digest'] == digest(receipt), 'transition-backup-changed')
        return digest(receipt)

    def _mark_ddl(self):
        require(self.j.last('transition-quiescent') is not None, 'transition-not-quiescent')
        # Immediately before the irrevocable marker: contained, read-only baseline, quiet, backup valid.
        self._quiet_observation()
        backup = self._backup()
        self.j.append('ddl-marker', irrevocable=True, pending=[m.name for m in self.plan.pending],
                      baseline_digest=self.expected.baseline_digest, backup_digest=backup,
                      legacy_resume_allowed=False)

    # -- DDL ----------------------------------------------------------------------------------------
    def _migrate(self):
        ledger = list(self.plan.baseline)
        for index, migration in enumerate(self.plan.pending, 1):
            step = 'migration:' + migration.name
            if self.j.last('transition-done', step) is not None:
                ledger.append(migration.name)
                continue
            require(self.j.last('transition-intent', step) is None, 'migration-outcome-ambiguous')
            before = self._observe()
            require_same_database(before, self.expected)
            require(list(before['ledger']) == sorted(ledger), 'migration-ledger-not-prefix')
            require(not before['invalid'] and before['index_builds'] == 0, 'database-ddl-in-progress')
            require_quiet(before)
            self.host.assert_contained()
            self._intent(step, index=index, sql_sha256=migration.sha256, concurrent=migration.concurrent)
            try:
                code = self.executor.apply(index, migration)
            except TimeoutError:
                code = None
            after = self._observe()
            failure = self._migration_failure(migration, code, ledger, after, self.expected)
            if failure is not None:
                # Definite only for a transactional rollback with no trace; anything else is ambiguous.
                definite = (failure == 'migration-failed' and not migration.concurrent
                            and not after['invalid'] and after['index_builds'] == 0)
                self.j.append('transition-migration-failed', step=step, code=failure, definite=definite)
                raise Refused(failure)
            self._done(step, ledger_digest=after['ledger_digest'])
            ledger.append(migration.name)
        final = self._observe()
        require_same_database(final, self.expected)  # before transition-migrated, layout and A9
        require(list(final['ledger']) == sorted(m.name for m in self.plan.migrations), 'final-ledger')
        if self.j.last('transition-migrated') is None:
            self.j.append('transition-migrated', ledger=len(final['ledger']), catalog=final['catalog'])
        else:
            require(self.j.last('transition-migrated')['catalog'] == final['catalog'], 'database-ddl-drift')

    @staticmethod
    def _migration_failure(migration, code, ledger, after, expected):
        # A ledger read from another (or not read-only/visible) database proves nothing: ambiguous.
        try:
            require_same_database(after, expected)
        except Refused as exc:
            return str(exc)
        applied = list(after['ledger']) == sorted([*ledger, migration.name])
        if code is None:
            return 'migration-timeout'
        if code != 0:
            return 'migration-ambiguous-ledger-without-success' if applied else 'migration-failed'
        if not applied:
            return 'migration-ambiguous-exit0-no-ledger'
        if after['invalid'] or after['index_builds'] or not set(migration.indexes) <= set(after['indexes']):
            return 'migration-index-invalid'
        return None

    def _release_layout(self):
        if self.j.last('transition-done', 'layout') is None:
            self._intent('layout')
        files = self.layout()  # exclusive or byte-for-byte verification, on every invocation
        if self.j.last('transition-done', 'layout') is None:
            self._done('layout', files=files)

    # -- A9 ----------------------------------------------------------------------------------------
    def _candidate_states(self, ids):
        states = self.candidate.inspect(tuple(ids[r] for r in ROLES))
        result = {role: states[ids[role]] for role in ROLES}
        for role, state in result.items():
            check_identity(self.candidate.spec, role, state)
        return result

    def _held(self, ids, created, backend_started):
        """Consumers never started, legacy contained, support preserved, ingress blocked."""
        states = self._candidate_states(ids)
        for role in CONSUMERS:
            check_held(states[role], created[role])
        if backend_started is None:
            check_held(states['backend'], created['backend'])
        else:
            check_backend_running(states['backend'], backend_started)
        self.host.assert_contained()
        return states

    def _a9(self):
        created = self.j.last('transition-done', 'a9:create')
        if created is None:
            require(not self._open('a9:create'), 'candidate-create-ambiguous')
            self.host.assert_contained()
            require(self.candidate.project_ids() == (), 'candidate-project-not-empty')
            write_hold_override(self.candidate.spec)
            self._intent('a9:create', project=self.candidate.spec.project)
            self.candidate.create_held()
            found = self.candidate.project_ids()
            require(len(found) == 4, 'candidate-create-scope')
            states = self.candidate.inspect(found)
            ids = {state['service']: ident for ident, state in states.items()}
            require(set(ids) == set(ROLES), 'candidate-create-scope')
            for role in ROLES:
                check_identity(self.candidate.spec, role, states[ids[role]])
                check_held(states[ids[role]])
            created = self._done('a9:create', ids=ids, created={
                role: dict(started=states[ids[role]]['started'], restart_count=states[ids[role]]['restart_count'])
                for role in ROLES})
        ids, snapshot = created['ids'], created['created']
        require(self.candidate.project_ids() == tuple(sorted(ids.values())), 'candidate-project-changed')
        started = self.j.last('transition-done', 'a9:start-backend')
        if started is None:
            require(not self._open('a9:start-backend'), 'candidate-start-ambiguous')
            self._held(ids, snapshot, None)
            self._intent('a9:start-backend', id=ids['backend'])
            self.candidate.start_backend(ids['backend'])
            state = self._candidate_states(ids)['backend']
            check_backend_running(state)
            started = self._done('a9:start-backend', started=state['started'])
        self._held(ids, snapshot, started['started'])
        smoke = self.candidate.smoke(ids['backend'])  # fresh read-only probe on every invocation
        self._held(ids, snapshot, started['started'])
        if self.j.last('transition-a9-complete') is None:
            self.j.append('transition-a9-complete', smoke=smoke, consumers='held', ingress_blocked=True,
                          a10='not-implemented')
        return dict(status='a9-backend-smoked', smoke=smoke, consumers='held', ingress_blocked=True,
                    legacy_resume_allowed=False, a10='not-implemented', production_ready=False)

    # -- recovery --------------------------------------------------------------------------------
    def recovery(self):
        """Objective classification of the journal; never performs an action."""
        j = self.j
        open_steps = [e['step'] for e in j.find('transition-intent') if self._open(e['step'])]
        failed = j.last('transition-failed')
        if j.last('transition-a9-complete') is not None and failed is None:
            state = 'a9-complete'
        elif j.last('ddl-marker') is not None:
            migrations = [s for s in open_steps if s.startswith('migration:')]
            if migrations:
                outcome = j.last('transition-migration-failed', migrations[-1])
                state = 'ddl-failed' if outcome is not None and outcome['definite'] is True else 'ddl-ambiguous'
            elif any(s.startswith('a9:') for s in open_steps):
                state = 'candidate-ambiguous'
            elif j.last('transition-done', 'layout') is not None and failed is not None:
                state = 'candidate-failed'
            else:
                state = 'post-ddl-failed'
        elif j.last('observed-host-resumed') is not None:
            state = 'legacy-resumed'
        elif j.last('observed-host-intent', 'legacy-resume') is not None:
            state = 'resume-partial'
        elif j.last('observed-host-contained') is not None:
            state = 'contained-pre-ddl'
        elif j.find('observed-host-intent'):
            state = 'containment-partial'
        else:
            state = 'not-started'
        return dict(state=state, procedure=PROCEDURES[state], open_steps=open_steps,
                    legacy_resume_allowed=state in ('contained-pre-ddl', 'resume-partial'),
                    automatic_undo=False, destructive_retry=False)


# -- configuration ----------------------------------------------------------------------------------
@dataclass(frozen=True)
class FirstTransitionConfig:
    repo: str
    state_dir: str
    migration_workdir: str
    python: str
    docker: tuple
    catalog: str
    identity: str
    lease_columns: tuple
    observer_applications: tuple
    manifest: HostManifest
    candidate: CandidateSpec
    package_manifest_sha256: str
    timeouts: tuple
    digest: str


def parse_config(data):
    """Public values only: unknown keys (a password, a URL) refuse."""
    require(isinstance(data, dict) and set(data) == CONFIG_KEYS and data['schema'] == CONFIG_SCHEMA, 'config-keys')
    docker, database, candidate, timeouts = data['docker'], data['database'], data['candidate'], data['timeouts']
    require(isinstance(docker, dict) and set(docker) == {'binary', 'endpoint', 'config_dir'}, 'config-docker')
    require(isinstance(database, dict) and set(database) == {
        'identity', 'catalog', 'lease_columns', 'observer_applications'}, 'config-database')
    require(isinstance(candidate, dict) and set(candidate) == {
        'sha', 'image', 'project', 'containers', 'network_name', 'release_root', 'hold_override', 'env_file',
        'smoke_seconds'}, 'config-candidate')
    require(isinstance(timeouts, dict) and set(timeouts) <= set(TIMEOUTS)
            and all(type(v) is int and 0 < v <= 3600 for v in timeouts.values())
            and timeouts.get('observe_s', TIMEOUTS['observe_s']) <= 30, 'config-timeouts')
    require(all(_absolute(data[k]) for k in ('repo', 'state_dir', 'migration_workdir', 'python')), 'config-paths')
    require(isinstance(database['lease_columns'], list) and isinstance(database['observer_applications'], list)
            and all(isinstance(p, list) for p in database['lease_columns']), 'config-database')
    manifest = HostManifest.from_dict(data['host'])
    containers = candidate['containers']
    require(isinstance(containers, dict) and set(containers) == set(ROLES), 'config-candidate')
    spec = CandidateSpec(sha=candidate['sha'], image=candidate['image'], project=candidate['project'],
                         containers=tuple((r, containers[r]) for r in ROLES), network_id=manifest.network_id,
                         network_name=candidate['network_name'], release_root=candidate['release_root'],
                         hold_override=candidate['hold_override'], env_file=candidate['env_file'],
                         daemon_id=manifest.daemon_id, smoke_seconds=candidate['smoke_seconds']).validated()
    require(spec.sha == APPLICATION_SHA, 'config-candidate-sha')
    require(isinstance(data['package_manifest_sha256'], str)
            and re.fullmatch('[0-9a-f]{64}', data['package_manifest_sha256']), 'config-package')
    canonical = json.dumps(data, sort_keys=True, separators=(',', ':')).encode()
    return FirstTransitionConfig(
        repo=data['repo'], state_dir=data['state_dir'], migration_workdir=data['migration_workdir'],
        python=data['python'], docker=(docker['binary'], docker['endpoint'], docker['config_dir']),
        catalog=database['catalog'], identity=database['identity'],
        lease_columns=tuple(tuple(p) for p in database['lease_columns']) or LEASES,
        observer_applications=tuple(database['observer_applications']), manifest=manifest, candidate=spec,
        package_manifest_sha256=data['package_manifest_sha256'], timeouts=tuple(sorted(timeouts.items())),
        digest=hashlib.sha256(canonical).hexdigest())


def load_config(path):
    try:
        data = json.loads(read_regular(path, 64 * 1024))
    except ValueError:
        raise Refused('config-invalid-json') from None
    return parse_config(data)


def assemble(config, *, plan, journal, connect, secret, ingress, writers, backup_proof, popen=None, run=None,
             clock=time.monotonic, sleep=time.sleep, git=None):
    """Wire real ports from configuration plus injected providers; any absent provider refuses.

    Providers (database connection, secret, ingress/writer bindings, backup
    receipt) are Phase 3 inputs; nothing is contacted while assembling.

    ``writers.observe()`` returns the number of UNKNOWN writers: sources outside
    the declared allowed ones. Declared sources are this tool's own observer and
    migration child and, from the A9 backend start on, the candidate backend of
    ``config.candidate`` (its project/container name); none of them is an unknown
    writer. Any other source (legacy service, consumer, foreign client) counts and
    refuses. A binding that counted the candidate backend would fail closed at A9.
    """
    require(isinstance(config, FirstTransitionConfig), 'transition-config')
    for value, code in ((connect, 'database'), (secret, 'secret'), (backup_proof, 'backup')):
        require(callable(value), 'transition-' + code + '-missing')
    require(ingress is not None and writers is not None, 'transition-host-bindings-missing')
    binary, endpoint, config_dir = config.docker
    database = ReadOnlyDatabase(connect, lease_columns=config.lease_columns,
                                observer_applications=config.observer_applications)
    expected = DatabaseExpectation(config.identity, plan.baseline, config.catalog).validated()
    proof = LedgerProof(database, expected, scope=config.manifest.digest)
    driver = ObservedHostDriver(config.manifest, ingress=ingress, writers=writers, ledger_proof=proof,
                                runner=PopenRunner(docker_binary=binary, endpoint=endpoint, config_dir=config_dir,
                                                   popen=popen, resume=True))
    host = ObservedHostContract(ObservedHostTransport(driver, **config.manifest.transport_scope()), journal)
    candidate = CandidatePort(config.candidate, runner=CandidateRunner(
        config.candidate, docker_binary=binary, endpoint=endpoint, config_dir=config_dir, popen=popen))
    executor = MigrationExecutor(plan, python=config.python, workdir=config.migration_workdir, secret=secret,
                                 runner=ProcessRunner(binaries=(config.python,), run=run),
                                 timeout=dict(config.timeouts).get('migration_s', TIMEOUTS['migration_s']))
    migrations = [m.name for m in plan.migrations]

    def layout():
        return write_candidate_release(config.repo, config.candidate, config.manifest, migrations=migrations,
                                       package_manifest_sha256=config.package_manifest_sha256, git=git)
    return FirstTransition(plan=plan, journal=journal, host=host, database=database, expected=expected,
                           backup_proof=backup_proof, executor=executor, layout=layout, candidate=candidate,
                           config_digest=config.digest, clock=clock, sleep=sleep, timeouts=dict(config.timeouts))

FILE deploy/first_transition_candidate.py
"""Candidate release layout and the A9 held start of the first transition.

``write_candidate_release`` writes ``<release_root>/<sha>`` (configured root,
e.g. ``/opt/pastorai-releases``) from the exact package blobs of ``sha`` plus
``deploy/release-topology.json``, reusing initial_transition_files. The
package identity (``release-manifest.json`` digest of package_backend_release)
and the migration manifest are checked first; an existing release is verified,
never overwritten.

``CandidatePort`` builds every Docker argv itself and runs it through an
injected runner (``(argv, *, timeout, max_output) -> (rc, stdout)``):

* ``create_held``: ONE ``docker compose ... up --no-start --no-deps`` for the four
  services of the candidate project, with an extra hold file forcing
  ``restart: "no"``; nothing is started, no dependency is touched;
* ``start_backend``: ``docker start`` of the backend ID only, after a fresh
  inspect proves that ID is this spec's backend (image, revision, project,
  service, name, network, closed gates) and still held;
* ``smoke``: same identity check plus running, then a bounded /health + /ready
  probe executed inside the backend, printing only status codes and fixed flags;
* ``inspect``: restricted projection (gates by name only, never full Env).

There is no operation to start a consumer, change a gate, open ingress, remove
or recreate a container: A10 is a separate, not implemented step. Every call is
preceded by a daemon identity check. Compatibility with a real Docker
CLI/Compose is unverified; tests use fixtures only.
"""
from __future__ import annotations

from dataclasses import dataclass
import hashlib
import json
import os
from pathlib import Path
import re
import stat

from first_transition_adapter import ROLES
from first_transition_host_driver import (DAEMON, HEX64, IMAGE, INFO_ARGV, MANDATORY_GATES, NETWORK_NAME, STARTED,
                                          STATUSES, PopenRunner, _absolute, _attempt, _lines, _tail,
                                          inspect_template)
from initial_transition_files import migration_manifest, no_symlink, write_release
from initial_transition_ops import Refused, require
import package_backend_release
import release_topology

CONSUMERS = ('queue-worker', 'cron-worker', 'broadcast-worker')
ZERO_STARTED = '0001-01-01T00:00:00Z'
# Closed value of each gate (backend/app/config.py defaults); absence keeps the closed default.
CLOSED_GATES = {'ALLOW_REAL_SENDS': 'false', 'ASAAS_BILLING_ENABLED': 'false', 'BREVO_SEND_MODE': 'off',
                'BROADCAST_ASYNC_ENABLED': 'false'}
CANDIDATE_TEMPLATE = '[{{json .Name}},' + inspect_template(MANDATORY_GATES)[1:]
HOLD_OVERRIDE = ('# A9 hold: candidate containers are created with restart "no" and never started here.\n'
                 '{"services": {' + ', '.join(f'"{r}": {{"restart": "no"}}' for r in ROLES) + '}}\n')
LIMITS = dict(info=256, compose=64 * 1024, ps=4096, inspect=64 * 1024, effect=256, smoke=1024)
PROJECT_LABEL = 'com.docker.compose.project'
SMOKE_PROBE = r'''
import json, sys, time, urllib.error, urllib.request
limit = time.monotonic() + float(sys.argv[1])
def get(path):
    try:
        with urllib.request.urlopen('http://127.0.0.1:8000' + path, timeout=5) as response:
            return response.status, json.loads(response.read(65536) or b'null')
    except urllib.error.HTTPError as exc:
        return exc.code, None
    except (OSError, ValueError):
        return None, None
while True:
    health, body = get('/health')
    ready, report = get('/ready') if health == 200 else (None, None)
    report = report if isinstance(report, dict) else {}
    required = report.get('required') if isinstance(report.get('required'), dict) else {}
    result = {'health': health, 'health_ok': isinstance(body, dict) and body.get('status') == 'ok',
              'ready': ready, 'required_ok': bool(required) and all(v == 'ok' for v in required.values()),
              'ready_status': report.get('status') if report.get('status') in ('ready', 'degraded', 'not_ready') else None}
    if (result['health_ok'] and ready == 200 and result['required_ok']) or time.monotonic() >= limit:
        break
    time.sleep(1)
print(json.dumps(result, sort_keys=True))
'''
SMOKE_KEYS = frozenset({'health', 'health_ok', 'ready', 'required_ok', 'ready_status'})


@dataclass(frozen=True)
class CandidateSpec:
    """Public candidate scope from configuration; no secret, only the private config PATH."""
    sha: str
    image: str
    project: str
    containers: tuple
    network_id: str
    network_name: str
    release_root: str
    hold_override: str
    env_file: str
    daemon_id: str
    smoke_seconds: int = 60

    def validated(self):
        names = dict(self.containers) if isinstance(self.containers, tuple) else {}
        require(isinstance(self.sha, str) and re.fullmatch('[0-9a-f]{40}', self.sha)
                and isinstance(self.image, str) and IMAGE.fullmatch(self.image)
                and isinstance(self.project, str) and release_topology.PROJECT.fullmatch(self.project)
                and self.project != release_topology.BASE_PROJECT
                and set(names) == set(ROLES) and len(names) == len(self.containers)
                and all(isinstance(v, str) and release_topology.CONTAINER.fullmatch(v) for v in names.values())
                and len(set(names.values())) == 4
                and isinstance(self.network_id, str) and HEX64.fullmatch(self.network_id)
                and isinstance(self.network_name, str) and NETWORK_NAME.fullmatch(self.network_name)
                and all(_absolute(p) for p in (self.release_root, self.hold_override, self.env_file))
                and isinstance(self.daemon_id, str) and DAEMON.fullmatch(self.daemon_id)
                and type(self.smoke_seconds) is int and 5 <= self.smoke_seconds <= 50, 'candidate-spec')
        return self

    @property
    def deploy_dir(self):
        return f'{self.release_root}/{self.sha}/deploy'

    def names(self):
        return dict(self.containers)

    def compose_argv(self):
        deploy = self.deploy_dir
        return ('docker', 'compose', '--project-name', self.project, '--project-directory', deploy,
                '--file', deploy + '/docker-compose.yml', '--file', deploy + '/docker-compose.override.yml',
                '--file', self.hold_override, 'up', '--no-start', '--no-deps', '--no-build', '--no-recreate',
                '--pull', 'never', *ROLES)

    def ps_argv(self):
        return ('docker', 'ps', '--all', '--quiet', '--no-trunc', '--filter', f'label={PROJECT_LABEL}={self.project}')

    def smoke_argv(self, backend_id):
        return ('docker', 'exec', backend_id, 'python', '-I', '-c', SMOKE_PROBE, str(self.smoke_seconds))


def topology_contract(spec, manifest):
    """Public release topology: candidate project/names, existing network, contained legacy IDs."""
    return dict(schema=release_topology.SCHEMA, version=release_topology.VERSION, project=spec.project,
                legacy_project=manifest.legacy_project, network=dict(name=spec.network_name, id=manifest.network_id),
                containers=spec.names(), reserved_legacy=dict(manifest.service_ids))


def write_candidate_release(repo, spec, manifest, *, package_manifest_sha256, migrations, git=None):
    """Exact package blobs of ``spec.sha`` -> ``<release_root>/<sha>``; returns the file count."""
    spec = spec.validated()
    require(isinstance(package_manifest_sha256, str) and HEX64.fullmatch(package_manifest_sha256),
            'package-identity-missing')
    files = package_backend_release.source_files(repo, spec.sha, git)
    require(hashlib.sha256(package_backend_release.release_manifest(spec.sha, files)).hexdigest()
            == package_manifest_sha256, 'package-identity-mismatch')
    sql = {p.split('/', 2)[2]: b for p, b in files.items() if re.fullmatch(r'backend/migrations/[^/]+\.sql', p)}
    names = migration_manifest(files['backend/scripts/migrate.py'], sql)
    require(list(names) == list(migrations), 'layout-migrations-differ-from-plan')
    return write_release(spec.release_root, spec.sha, files, topology_contract(spec, manifest), names, spec.image)


def write_hold_override(spec):
    """Exclusive creation of the public hold file; an existing file must be identical."""
    path = no_symlink(Path(spec.hold_override))
    data = HOLD_OVERRIDE.encode()
    if os.path.lexists(path):
        require(stat.S_ISREG(os.lstat(path).st_mode) and path.read_bytes() == data, 'candidate-hold-mismatch')
        return
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, 'wb') as handle:
        handle.write(data)


class CandidateRunner(PopenRunner):
    """PopenRunner whose allowlist is exactly the argv this spec's CandidatePort builds."""

    def __init__(self, spec, **kwargs):
        self.spec = spec.validated()
        super().__init__(**kwargs)

    def _allowed(self, argv):
        if argv in (INFO_ARGV, self.spec.compose_argv(), self.spec.ps_argv()):
            return True
        if len(argv) == 3 and argv[:2] == ('docker', 'start'):
            return HEX64.fullmatch(argv[2]) is not None
        if len(argv) == 8 and HEX64.fullmatch(argv[2]):
            return argv == self.spec.smoke_argv(argv[2])
        return (6 < len(argv) <= 10 and argv[:6] == ('docker', 'inspect', '--type', 'container', '--format',
                                                     CANDIDATE_TEMPLATE)
                and all(HEX64.fullmatch(i) for i in argv[6:]) and len(set(argv[6:])) == len(argv[6:]))

    def _env(self):
        # Path of the private configuration only; Compose reads it, this process never does.
        return {**super()._env(), 'PASTORAI_ENV_FILE': self.spec.env_file}


class CandidatePort:
    def __init__(self, spec, *, runner):
        require(isinstance(spec, CandidateSpec), 'candidate-spec')
        require(callable(runner), 'candidate-runner')
        self.spec, self.runner = spec.validated(), runner

    def _run(self, argv, timeout, limit):
        outcome = None
        try:
            result = self.runner(argv, timeout=timeout, max_output=limit)
        except TimeoutError:
            outcome = 'candidate-timeout'
        except Exception:
            outcome = 'candidate-runner-failed'
        require(outcome is None, outcome)
        require(isinstance(result, tuple) and len(result) == 2 and type(result[0]) is int
                and type(result[1]) is bytes and len(result[1]) <= limit, 'candidate-runner-failed')
        return result

    def _daemon(self):
        rc, out = self._run(INFO_ARGV, 10, LIMITS['info'])
        ok, value = _attempt(_lines, out)
        require(rc == 0 and ok and value == [self.spec.daemon_id], 'candidate-daemon-mismatch')

    def project_ids(self):
        self._daemon()
        rc, out = self._run(self.spec.ps_argv(), 10, LIMITS['ps'])
        ok, text = _attempt(bytes.decode, out, 'ascii')
        require(rc == 0 and ok and (text == '' or text.endswith('\n')), 'candidate-ps-failed')
        ids = text.split()
        require(all(HEX64.fullmatch(i) for i in ids) and len(set(ids)) == len(ids), 'candidate-ps-failed')
        return tuple(sorted(ids))

    def create_held(self):
        self._daemon()
        rc, _ = self._run(self.spec.compose_argv(), 60, LIMITS['compose'])
        require(rc == 0, 'candidate-create-failed')

    def inspect(self, ids):
        require(isinstance(ids, (tuple, list)) and 1 <= len(ids) <= 4
                and all(isinstance(i, str) and HEX64.fullmatch(i) for i in ids), 'candidate-ids')
        self._daemon()
        rc, out = self._run(('docker', 'inspect', '--type', 'container', '--format', CANDIDATE_TEMPLATE, *ids),
                            10, LIMITS['inspect'])
        require(rc == 0, 'candidate-inspect-failed')
        ok, rows = _attempt(_lines, out)
        require(ok and all(isinstance(r, list) and len(r) == 19 for r in rows)
                and [r[1] for r in rows] == list(ids), 'candidate-inspect-malformed')
        return {row[1]: self._row(row) for row in rows}

    @staticmethod
    def _row(row):
        (name, ident, image, project, service, revision, status, running, paused, restarting, exit_code, started,
         health, restarts, policy, _mode, gates, mounts, networks) = row
        require(isinstance(name, str) and name.startswith('/') and isinstance(image, str)
                and isinstance(status, str) and status in STATUSES and type(running) is bool
                and running == (status == 'running') and paused is False and restarting is False
                and type(exit_code) is int and isinstance(started, str) and STARTED.fullmatch(started)
                and (health is None or isinstance(health, str))
                and type(restarts) is int and restarts >= 0 and isinstance(policy, str),
                'candidate-inspect-state')
        gates = _tail(gates, 'candidate-inspect-gates')
        require(all(isinstance(g, str) and '=' in g for g in gates), 'candidate-inspect-gates')
        values = dict(g.split('=', 1) for g in gates)
        require(len(values) == len(gates) and set(values) <= set(MANDATORY_GATES), 'candidate-inspect-gates')
        networks = _tail(networks, 'candidate-inspect-networks')
        require(all(isinstance(n, list) and len(n) == 3 and isinstance(n[2], str) for n in networks),
                'candidate-inspect-networks')
        _tail(mounts, 'candidate-inspect-mounts')
        labels = [None if v in (None, '') else v for v in (project, service, revision)]
        return dict(id=ident, name=name[1:], image=image, project=labels[0], service=labels[1], revision=labels[2],
                    status=status, running=running, exit_code=exit_code, started=started, health=health,
                    restart_count=restarts, restart_policy=policy or 'no', gates=values,
                    networks=sorted(n[2] for n in networks))

    def _backend(self, backend_id):
        """Fresh inspect of the given ID: it must be THIS spec's backend (image, project, name, network, gates)."""
        require(isinstance(backend_id, str) and HEX64.fullmatch(backend_id), 'candidate-ids')
        state = self.inspect((backend_id,))[backend_id]
        check_identity(self.spec, 'backend', state)
        return state

    def start_backend(self, backend_id):
        # A consumer, a foreign project or a foreign image refuses before any start is issued.
        check_held(self._backend(backend_id), code='candidate-backend-not-held')
        self._daemon()
        rc, out = self._run(('docker', 'start', backend_id), 30, LIMITS['effect'])
        require(rc == 0 and out == (backend_id + '\n').encode(), 'candidate-start-receipt')

    def smoke(self, backend_id):
        check_backend_running(self._backend(backend_id))
        self._daemon()
        rc, out = self._run(self.spec.smoke_argv(backend_id), self.spec.smoke_seconds + 10, LIMITS['smoke'])
        ok, value = _attempt(_lines, out)
        require(rc == 0 and ok and len(value) == 1 and isinstance(value[0], dict)
                and set(value[0]) == SMOKE_KEYS, 'candidate-smoke-malformed')
        result = value[0]
        require(result['health'] == 200 and result['health_ok'] is True, 'candidate-health-failed')
        require(result['ready'] == 200 and result['required_ok'] is True
                and result['ready_status'] in ('ready', 'degraded'), 'candidate-ready-failed')
        return dict(health=200, ready=200, ready_status=result['ready_status'])


def check_identity(spec, role, state):
    """Pinned image/revision, own project/service/name, single network, every gate closed."""
    require(state['image'] == spec.image and state['revision'] == spec.sha, 'candidate-image-mismatch')
    require(state['project'] == spec.project and state['service'] == role
            and state['name'] == spec.names()[role], 'candidate-identity-mismatch')
    require(state['networks'] == [spec.network_id], 'candidate-network-mismatch')
    require(all(state['gates'].get(g, CLOSED_GATES[g]) == CLOSED_GATES[g] for g in MANDATORY_GATES),
            'candidate-gate-open')


def check_held(state, created=None, *, code='candidate-consumer-not-held'):
    """Created, never started, restart=no; unchanged since its creation receipt when given."""
    require(state['status'] == 'created' and state['running'] is False and state['restart_count'] == 0
            and state['started'] == ZERO_STARTED and state['restart_policy'] == 'no', code)
    if created is not None:
        require(state['started'] == created['started'] and state['restart_count'] == created['restart_count'], code)


def check_backend_running(state, started=None):
    require(state['status'] == 'running' and state['running'] is True and state['restart_count'] == 0
            and state['started'] != ZERO_STARTED and state['restart_policy'] == 'no', 'candidate-backend-not-running')
    if started is not None:
        require(state['started'] == started, 'candidate-backend-restarted')

FILE deploy/first_transition_host_contract.py
"""Containment contracts over caller-supplied host ports.

LocalHostContract proves the orchestration against a simulator only.
ObservedHostContract is a contract over a caller-supplied driver: every field
(ingress, unknown writers, queue counts, health, digests) is driver-reported,
never independent host evidence, so receipts carry host_verified=False. Queue
counts cannot prove contents or quiescence. It may resume the pinned legacy
only while no DDL marker is journaled; marker absence is no proof that DDL did
not run elsewhere. The resume token binds the host identity, not a human
approval. Partial containment or an abnormal exit is refused fail-closed; there
is no automatic recovery. Checks run immediately before each effect and again
after it, without any atomicity over the driver or host; each resume effect is
also judged, without new IO, on the port's own final snapshot via a guard. Its
journal is never shared with the local adapter (adapter-*/local-host-*). No SSH, Docker client,
gate setter, real executor or deploy operation is provided here.
"""
from __future__ import annotations

import re

from first_transition_adapter import ROLES, digest
from initial_transition_ops import Refused, require

FIELDS = frozenset({'id', 'image', 'revision', 'compose_project', 'compose_service',
                    'started', 'restart_count', 'restart_policy', 'running', 'exit_code',
                    'gates_digest', 'mounts_digest', 'networks_digest'})
DYNAMIC = frozenset({'restart_policy', 'running', 'exit_code'})
HEX = re.compile('[0-9a-f]{64}')
RESUMABLE = frozenset({'started', 'restart_count'})
START_ORDER = ('backend', 'queue-worker', 'broadcast-worker', 'cron-worker')


class LocalHostContract:
    def __init__(self, port, journal):
        self.port, self.j = port, journal

    def _call(self, operation, *args):
        try:
            return getattr(self.port, operation)(*args)
        except TimeoutError:
            raise Refused('local-host-timeout') from None
        except Exception:
            raise Refused('local-host-effect-failed') from None

    def _snapshot(self):
        data = self._call('snapshot')
        require(isinstance(data, dict) and set(data) == {
            'mode', 'ingress_blocked', 'support_digest', 'unknown_writers', 'services'}, 'local-host-shape')
        require(data['mode'] == 'local-simulation', 'local-host-simulation-required')
        require(type(data['ingress_blocked']) is bool
                and isinstance(data['support_digest'], str) and HEX.fullmatch(data['support_digest']),
                'local-host-shape')
        require(type(data['unknown_writers']) is int and data['unknown_writers'] == 0,
                'local-host-unknown-writer')
        services = data['services']
        require(isinstance(services, dict) and set(services) == set(ROLES), 'local-host-services')
        for role, state in services.items():
            require(isinstance(state, dict) and set(state) == FIELDS, 'local-host-service-shape')
            require(isinstance(state['id'], str) and HEX.fullmatch(state['id'])
                    and isinstance(state['image'], str) and re.fullmatch(r'sha256:[0-9a-f]{64}', state['image'])
                    and (state['revision'] is None or isinstance(state['revision'], str)
                         and re.fullmatch('[0-9a-f]{40}', state['revision'])), 'local-host-identity')
            require(type(state['running']) is bool and type(state['restart_count']) is int
                    and state['restart_count'] >= 0 and state['restart_policy'] in ('always', 'no')
                    and (state['exit_code'] is None or type(state['exit_code']) is int)
                    and isinstance(state['started'], str)
                    and re.fullmatch(r'[A-Za-z0-9_.:+-]{1,64}', state['started']), 'local-host-state')
            require(all(isinstance(state[key], str) and HEX.fullmatch(state[key])
                        for key in ('gates_digest', 'mounts_digest', 'networks_digest')), 'local-host-digest')
            if role == 'broadcast-worker':
                require(state['compose_project'] is None and state['compose_service'] is None,
                        'local-host-broadcast-must-be-standalone')
            else:
                require(state['compose_service'] == role and isinstance(state['compose_project'], str)
                        and re.fullmatch('[A-Za-z0-9_-]{1,63}', state['compose_project']), 'local-host-compose')
        require(len({s['id'] for s in services.values()}) == 4, 'local-host-duplicate-identity')
        require(len({s['compose_project'] for role, s in services.items() if role != 'broadcast-worker'}) == 1,
                'local-host-compose-projects')
        fingerprint = digest([data['support_digest'], {
            role: {key: state[key] for key in sorted(FIELDS - DYNAMIC)} for role, state in services.items()}])
        baseline = self.j.last('local-host-init')
        if baseline:
            require(fingerprint == baseline['fingerprint'], 'local-host-identity-or-support-changed')
        return data, fingerprint

    def _intent(self, step):
        if self.j.last('local-host-intent', step) is None:
            self.j.append('local-host-intent', step=step)

    def _done(self, step):
        if self.j.last('local-host-done', step) is None:
            self.j.append('local-host-done', step=step)

    def assert_contained(self):
        require(self.j.last('local-host-init') is not None, 'local-host-unobserved')
        data, fingerprint = self._snapshot()
        require(data['ingress_blocked'], 'local-host-ingress-open')
        for state in data['services'].values():
            require(state['restart_policy'] == 'no' and not state['running'] and state['exit_code'] == 0,
                    'local-host-not-cleanly-contained')
        return dict(mode='local-simulation', fingerprint=fingerprint, stopped_roles=ROLES,
                    host_verified=False)

    def contain(self):
        data, fingerprint = self._snapshot()
        if self.j.last('local-host-init') is None:
            require(all(s['running'] and s['restart_policy'] == 'always' for s in data['services'].values()),
                    'local-host-baseline-state')
            self.j.append('local-host-init', fingerprint=fingerprint, mode='local-simulation')
        if self.j.last('local-host-done', 'ingress'):
            require(data['ingress_blocked'], 'local-host-ingress-reopened')
        if not data['ingress_blocked']:
            self._intent('ingress')
            self._call('block_ingress')
        require(self._snapshot()[0]['ingress_blocked'], 'local-host-ingress-open')
        self._done('ingress')
        for role in ROLES:
            state = self._snapshot()[0]['services'][role]
            step = 'restart-no:' + role
            if self.j.last('local-host-done', step):
                require(state['restart_policy'] == 'no', 'local-host-restart-reenabled')
            if state['restart_policy'] != 'no':
                self._intent(step)
                self._call('disable_restart', state['id'])
            require(self._snapshot()[0]['services'][role]['restart_policy'] == 'no',
                    'local-host-restart-not-disabled')
            self._done(step)
            state = self._snapshot()[0]['services'][role]
            step = 'term:' + role
            if self.j.last('local-host-done', step):
                require(not state['running'], 'local-host-restarted')
            if state['running']:
                # An unreceipted SIGTERM may already have been delivered. Wait;
                # do not blindly signal again or escalate to SIGKILL/restart.
                if self.j.last('local-host-intent', step) is None:
                    self._intent(step)
                    self._call('signal_term', state['id'])
                self._call('wait_stopped', state['id'], 30)
            state = self._snapshot()[0]['services'][role]
            require(not state['running'] and state['exit_code'] == 0, 'local-host-exit-not-clean')
            self._done(step)
        receipt = self.assert_contained()
        if self.j.last('local-host-contained') is None:
            self.j.append('local-host-contained', **receipt)
        return receipt


def _observed_services(services):
    require(isinstance(services, dict) and set(services) == set(ROLES), 'observed-host-services')
    for role, state in services.items():
        require(isinstance(state, dict) and set(state) == FIELDS, 'observed-host-service-shape')
        require(isinstance(state['id'], str) and HEX.fullmatch(state['id'])
                and isinstance(state['image'], str) and re.fullmatch(r'sha256:[0-9a-f]{64}', state['image'])
                and (state['revision'] is None or isinstance(state['revision'], str)
                     and re.fullmatch('[0-9a-f]{40}', state['revision'])), 'observed-host-identity')
        require(type(state['running']) is bool and type(state['restart_count']) is int
                and state['restart_count'] >= 0 and state['restart_policy'] in ('always', 'no')
                and (state['exit_code'] is None or type(state['exit_code']) is int)
                and isinstance(state['started'], str)
                and re.fullmatch(r'[A-Za-z0-9_.:+-]{1,64}', state['started']), 'observed-host-state')
        require(all(isinstance(state[key], str) and HEX.fullmatch(state[key])
                    for key in ('gates_digest', 'mounts_digest', 'networks_digest')), 'observed-host-digest')
        if role == 'broadcast-worker':
            require(state['compose_project'] is None and state['compose_service'] is None,
                    'observed-host-broadcast-must-be-standalone')
        else:
            require(state['compose_service'] == role and isinstance(state['compose_project'], str)
                    and re.fullmatch('[A-Za-z0-9_-]{1,63}', state['compose_project']), 'observed-host-compose')
    require(len({s['id'] for s in services.values()}) == 4, 'observed-host-duplicate-identity')
    require(len({s['compose_project'] for role, s in services.items() if role != 'broadcast-worker'}) == 1,
            'observed-host-compose-projects')


class ObservedHostContract:
    def __init__(self, port, journal):
        self.port, self.j = port, journal

    def _call(self, operation, *args):
        try:
            return getattr(self.port, operation)(*args)
        except TimeoutError:
            raise Refused('observed-host-timeout') from None
        except Exception:
            raise Refused('observed-host-effect-failed') from None

    def _assert_own_journal(self):
        require(not any(event['kind'].startswith(('adapter-', 'local-host-')) for event in self.j.events),
                'observed-host-journal-mixed')

    def _snapshot(self, data=None):
        # data: a port's final snapshot handed to a pre-effect guard, validated without new IO.
        self._assert_own_journal()
        if data is None:
            data = self._call('snapshot')
        require(isinstance(data, dict) and set(data) == {
            'mode', 'scope_digest', 'ingress_blocked', 'support_digest', 'unknown_writers', 'queue_digest', 'queue_counts',
            'services'}, 'observed-host-shape')
        require(data['mode'] == 'observed-host', 'observed-host-required')
        require(isinstance(data['scope_digest'], str) and HEX.fullmatch(data['scope_digest']),
                'observed-host-scope')
        require(type(data['ingress_blocked']) is bool
                and isinstance(data['support_digest'], str) and HEX.fullmatch(data['support_digest']),
                'observed-host-shape')
        require(type(data['unknown_writers']) is int and data['unknown_writers'] == 0,
                'observed-host-unknown-writer')
        counts = data['queue_counts']
        require(isinstance(data['queue_digest'], str) and HEX.fullmatch(data['queue_digest'])
                and isinstance(counts, dict) and counts
                and all(isinstance(k, str) and type(v) is int and v >= 0 for k, v in counts.items()),
                'observed-host-queue')
        services = data['services']
        _observed_services(services)
        # started/restart_count legitimately change on resume; un-resumed roles keep
        # their baseline and resumed roles keep their receipted fresh start.
        fingerprint = digest([data['scope_digest'], data['support_digest'], {
            role: {key: state[key] for key in sorted(FIELDS - DYNAMIC - RESUMABLE)}
            for role, state in services.items()}])
        baseline = self.j.last('observed-host-init')
        if baseline:
            require(fingerprint == baseline['fingerprint'], 'observed-host-identity-or-support-changed')
            for role, state in services.items():
                step = 'legacy-resume:' + role
                if self.j.last('observed-host-intent', step) is None:
                    require(state['started'] == baseline['initial_started'][role]
                            and state['restart_count'] == baseline['initial_restarts'][role],
                            'observed-host-identity-or-support-changed')
                done = self.j.last('observed-host-done', step)
                if done:
                    require(state['running'] is True and state['restart_policy'] == 'always'
                            and state['restart_count'] == 0 and state['started'] == done['started'],
                            'observed-host-resumed-state-changed')
        return data, fingerprint

    def _intent(self, step):
        if self.j.last('observed-host-intent', step) is None:
            self.j.append('observed-host-intent', step=step)

    def _done(self, step):
        if self.j.last('observed-host-done', step) is None:
            self.j.append('observed-host-done', step=step)

    def assert_contained(self):
        self._assert_own_journal()
        # Once a resume is intended the host is never containment evidence again.
        require(self.j.last('observed-host-intent', 'legacy-resume') is None, 'observed-host-resume-started')
        settled = self.j.last('observed-host-settled')
        require(self.j.last('observed-host-init') is not None and settled is not None,
                'observed-host-unobserved')
        data, fingerprint = self._contain_observe()
        require(data['ingress_blocked'] is True, 'observed-host-ingress-open')
        for state in data['services'].values():
            require(state['restart_policy'] == 'no' and not state['running'] and state['exit_code'] == 0,
                    'observed-host-not-cleanly-contained')
        require(data['queue_digest'] == settled['queue_digest'], 'observed-host-queue-drift')
        return dict(mode='observed-host', evidence='driver-reported', fingerprint=fingerprint,
                    queue_digest=settled['queue_digest'], stopped_roles=ROLES, host_verified=False,
                    quiescence_proven=False)

    def contain(self):
        self._assert_own_journal()
        require(self.j.last('observed-host-intent', 'legacy-resume') is None, 'observed-host-resume-started')
        data, fingerprint = self._contain_observe()
        if self.j.last('observed-host-init') is None:
            require(all(s['running'] and s['restart_policy'] == 'always' for s in data['services'].values()),
                    'observed-host-baseline-state')
            self.j.append('observed-host-init', fingerprint=fingerprint, mode='observed-host',
                          scope_digest=data['scope_digest'],
                          evidence='driver-reported', host_verified=False,
                          initial_started={role: data['services'][role]['started'] for role in ROLES},
                          initial_restarts={role: data['services'][role]['restart_count'] for role in ROLES})
        if self.j.last('observed-host-done', 'ingress'):
            require(data['ingress_blocked'], 'observed-host-ingress-reopened')
        if not data['ingress_blocked']:
            self._intent('ingress')
            self._effect('block_ingress', self._contain_snapshot)
        require(self._contain_observe()[0]['ingress_blocked'] is True, 'observed-host-ingress-open')
        self._done('ingress')
        for role in ROLES:
            state = self._contain_observe()[0]['services'][role]
            step = 'restart-no:' + role
            if self.j.last('observed-host-done', step):
                require(state['restart_policy'] == 'no', 'observed-host-restart-reenabled')
            if state['restart_policy'] != 'no':
                self._intent(step)
                self._effect('disable_restart', self._contain_snapshot, state['id'])
            require(self._contain_observe()[0]['services'][role]['restart_policy'] == 'no',
                    'observed-host-restart-not-disabled')
            self._done(step)
            state = self._contain_observe()[0]['services'][role]
            step = 'term:' + role
            if self.j.last('observed-host-done', step):
                require(not state['running'], 'observed-host-restarted')
            if state['running']:
                # Never re-signal an unreceipted SIGTERM; wait or hold.
                if self.j.last('observed-host-intent', step) is None:
                    self._intent(step)
                    self._effect('signal_term', self._contain_snapshot, state['id'])
                self._call('wait_stopped', state['id'], 30)
            state = self._contain_observe()[0]['services'][role]
            require(not state['running'] and state['exit_code'] == 0, 'observed-host-exit-not-clean')
            self._done(step)
        settled_data = self._contain_observe()[0]
        if self.j.last('observed-host-settled') is None:
            self.j.append('observed-host-settled', queue_digest=settled_data['queue_digest'],
                          queue_counts=settled_data['queue_counts'], evidence='driver-reported',
                          quiescence_proven=False)
        receipt = self.assert_contained()
        if self.j.last('observed-host-contained') is None:
            self.j.append('observed-host-contained', **receipt)
        return receipt

    def _contain_observe(self):
        data, fingerprint = self._snapshot()
        if self.j.last('observed-host-init') is not None:
            self._contain_snapshot(data)  # validate adoption/phase without another port read
        return data, fingerprint

    def _contain_snapshot(self, data=None):
        require(self.j.last('observed-host-intent', 'legacy-resume') is None, 'observed-host-resume-started')
        data, _ = self._snapshot(data)
        if self.j.last('observed-host-done', 'ingress'):
            require(data['ingress_blocked'] is True, 'observed-host-ingress-reopened')
        for role, state in data['services'].items():
            if self.j.last('observed-host-intent', 'restart-no:' + role) is None:
                require(state['restart_policy'] == 'always', 'observed-host-unintended-policy')
            if self.j.last('observed-host-done', 'restart-no:' + role):
                require(state['restart_policy'] == 'no', 'observed-host-restart-reenabled')
            if self.j.last('observed-host-intent', 'term:' + role) is None:
                require(state['running'] is True, 'observed-host-unintended-stop')
            elif not state['running']:
                require(state['exit_code'] == 0, 'observed-host-exit-not-clean')
            if self.j.last('observed-host-done', 'term:' + role):
                require(not state['running'], 'observed-host-restarted')
        return data

    def resume_token(self):
        init = self.j.last('observed-host-init')
        require(init is not None, 'observed-host-unobserved')
        return 'RESUME:' + init['fingerprint']

    def _assert_pre_ddl(self):
        # Journal-only guard, re-read before each effect and after each observation.
        # It cannot see DDL performed outside this journal; that needs a DB proof.
        require(self.j.last('adapter-ddl-marker') is None and self.j.last('ddl-marker') is None,
                'post-ddl-resume-forbidden')

    def _resume_snapshot(self, data=None):
        self._assert_pre_ddl()  # keeps priority over the mixed-journal refusal
        data, _ = self._snapshot(data)
        self._assert_pre_ddl()
        self._check_resume_roles(data)
        if self.j.last('observed-host-intent', 'open-ingress') is None:
            # Ingress stays blocked through any partial resume until its opening is intended.
            require(data['ingress_blocked'] is True, 'observed-host-ingress-open')
        return data

    def _check_resume_roles(self, data):
        # Every role must match its phase on every observation, not just the target.
        init = self.j.last('observed-host-init')
        for role, state in data['services'].items():
            step = 'legacy-resume:' + role
            if self.j.last('observed-host-done', step) is not None:
                continue  # _snapshot already proves the receipted fresh running state.
            if self.j.last('observed-host-intent', step) is None:
                require(not state['running'], 'observed-host-resume-not-fresh')
                require(state['restart_policy'] == 'no' and state['exit_code'] == 0,
                        'observed-host-not-cleanly-contained')
            elif state['running']:
                self._check_fresh(state, role, init)
            else:
                require(state['restart_policy'] == 'no' and state['exit_code'] == 0
                        and state['started'] == init['initial_started'][role]
                        and state['restart_count'] == init['initial_restarts'][role],
                        'observed-host-resume-not-fresh')

    def _effect(self, operation, check, *args):
        # The port must pass its own final snapshot to the guard and emit only after
        # it returns; a guard refusal keeps its contract code, a skipped guard refuses.
        outcome = []
        def guard(final):
            try:
                check(final)
            except Refused as exc:
                outcome.append(exc)
                raise
            outcome.append(True)
        try:
            self._call(operation, *args, guard)
        except Refused:
            refusals = [item for item in outcome if isinstance(item, Refused)]
            if refusals:
                raise refusals[0] from None
            raise
        require(True in outcome, 'observed-host-guard-skipped')

    def _start_observed(self, data, init):
        # An actual start: receipted, or intended with a verifiably fresh start.
        # A running or changed role without both is inconsistent and refused.
        observed = False
        for role in ROLES:
            step = 'legacy-resume:' + role
            if self.j.last('observed-host-done', step) is not None:
                observed = True
                continue
            state = data['services'][role]
            if state['running'] or state['started'] != init['initial_started'][role]:
                require(self.j.last('observed-host-intent', step) is not None and state['running'] is True
                        and state['restart_count'] == 0 and state['started'] != init['initial_started'][role],
                        'observed-host-resume-not-fresh')
                observed = True
        return observed

    def _check_start(self, data, role, init, settled, allow_queue_drift):
        # Only a never-started container may be started; the queue gate holds until an actual start.
        state = data['services'][role]
        require(not state['running'] and state['exit_code'] == 0 and state['started'] == init['initial_started'][role]
                and state['restart_count'] == init['initial_restarts'][role]
                and state['restart_policy'] == 'no', 'observed-host-resume-not-fresh')
        if not self._start_observed(data, init):
            self._queue_gate(data, settled, allow_queue_drift)

    def _check_fresh(self, state, role, init):
        require(state['running'] is True and state['restart_count'] == 0
                and state['started'] != init['initial_started'][role], 'observed-host-resume-not-fresh')
        return state

    def _queue_gate(self, data, settled, allow_queue_drift):
        # Before the first actual start the queue must match the settled baseline or
        # the drift is explicitly accepted and journaled before the effect.
        if data['queue_digest'] != settled['queue_digest']:
            require(allow_queue_drift is True, 'observed-host-queue-drift')
            accepted = self.j.last('observed-host-queue-drift-accepted')
            if accepted is None or accepted['current_digest'] != data['queue_digest']:
                self.j.append('observed-host-queue-drift-accepted', settled_digest=settled['queue_digest'],
                              current_digest=data['queue_digest'])

    def resume_legacy(self, confirmation, expected_token=None, *, allow_queue_drift=False):
        self._assert_pre_ddl()
        self._assert_own_journal()
        require(getattr(self.port, 'supports_resume', False) is True, 'observed-host-resume-unavailable')
        require(self.j.last('observed-host-contained') is not None, 'observed-host-not-contained')
        token = self.resume_token()  # bound to this journal's observed host; not a human approval
        require(expected_token is None or expected_token == token, 'observed-host-resume-confirmation')
        if self.j.last('observed-host-intent', 'legacy-resume') is None:
            require(confirmation == token, 'observed-host-resume-confirmation')
        init = self.j.last('observed-host-init')
        settled = self.j.last('observed-host-settled')
        data = self._resume_snapshot()
        if not self._start_observed(data, init):
            for state in data['services'].values():
                require(not state['running'] and state['exit_code'] == 0 and state['restart_policy'] == 'no',
                        'observed-host-not-cleanly-contained')
            self._queue_gate(data, settled, allow_queue_drift)
        else:
            require(self.j.last('observed-host-intent', 'legacy-resume') is not None,
                    'observed-host-not-contained')
        self._intent('legacy-resume')
        for role in START_ORDER:
            step = 'legacy-resume:' + role
            if self.j.last('observed-host-done', step) is not None:
                continue  # _snapshot() keeps re-validating the receipted fresh start
            if self.j.last('observed-host-intent', step) is None:
                state = self._resume_snapshot()['services'][role]
                require(not state['running'] and state['exit_code'] == 0 and state['restart_policy'] == 'no',
                        'observed-host-not-cleanly-contained')
                self._intent(step)
            # Re-observed after the intent, immediately before the effect (first run or replay).
            data = self._resume_snapshot()
            state = data['services'][role]
            if not state['running']:
                self._check_start(data, role, init, settled, allow_queue_drift)
                # Start before restart=always: never a stopped container with restart=always.
                self._effect('start_service', lambda final, role=role: self._check_start(
                    self._resume_snapshot(final), role, init, settled, allow_queue_drift), state['id'])
            state = self._check_fresh(self._resume_snapshot()['services'][role], role, init)
            if state['restart_policy'] != 'always':
                self._effect('enable_restart', lambda final, role=role: self._check_fresh(
                    self._resume_snapshot(final)['services'][role], role, init), state['id'])
            state = self._resume_snapshot()['services'][role]
            require(state['restart_policy'] == 'always', 'observed-host-restart-not-enabled')
            self._check_fresh(state, role, init)
            self.j.append('observed-host-done', step=step, started=state['started'])
        if self.j.last('observed-host-done', 'open-ingress') is None:
            if self.j.last('observed-host-intent', 'open-ingress') is None:
                self._resume_snapshot()  # still blocked and pre-DDL right before authorizing it
                self._intent('open-ingress')
            if self._resume_snapshot()['ingress_blocked']:
                # _snapshot() re-validates every receipted fresh start on the final observation.
                self._effect('open_ingress', self._resume_snapshot)
            require(not self._resume_snapshot()['ingress_blocked'], 'observed-host-ingress-still-blocked')
            self._done('open-ingress')
        # Every call, terminal replay included, re-proves the resumed host.
        final_data = self._resume_snapshot()
        require(final_data['ingress_blocked'] is False, 'observed-host-ingress-still-blocked')
        if self.j.last('observed-host-resumed') is None:
            self.j.append('observed-host-resumed', resumed_roles=START_ORDER, evidence='driver-reported')
        return dict(mode='observed-host', status='legacy-resumed', resumed_roles=START_ORDER,
                    ingress_blocked=False, evidence='driver-reported', host_verified=False)

FILE deploy/first_transition_host_transport.py
"""Command encoding for caller-supplied host drivers; no process or network executor.

The mandatory driver supplies sanitized metadata, not raw Docker inspect/env.
Ingress remains a semantic operation: no guessed Nginx/Evolution command.
The simulated transport cannot certify a real host. The observed transport only
restarts the four pinned legacy identities; it provides no deploy operation.
It validates shape and binds identities, but every value is driver-reported:
it is no real executor, inventory or ingress implementation, and queue counts
prove neither contents nor quiescence. A reviewed real driver remains pending.
The resume effects (start, restart=always, open-ingress) require a caller guard:
the transport hands it its own final snapshot and emits the command only after
the guard returns. Without a guard they refuse before any call; the bare
transport is an unauthorized encoder, never a resume authority.
"""
from __future__ import annotations

from copy import deepcopy
import re

from first_transition_adapter import ROLES, digest, queue_metadata
from initial_transition_ops import Refused, require

SUPPORT_ROLES = ('redis', 'evolution-postgres', 'evolution-api')
SUPPORT_FIELDS = frozenset({'id', 'image', 'compose_project', 'compose_service', 'running',
                            'restart_policy', 'health', 'networks_digest'})
SERVICE_FIELDS = frozenset({'id', 'image', 'revision', 'compose_project', 'compose_service', 'started',
                            'restart_count', 'restart_policy', 'running', 'exit_code', 'gates_digest',
                            'mounts_digest', 'networks_digest'})


def host_command(operation, identifier):
    """Pure encoder shared with the separately authorized disposable probe."""
    require(isinstance(identifier, str) and re.fullmatch('[0-9a-f]{64}', identifier), 'transport-target')
    commands = {'restart-no': ('docker', 'update', '--restart=no', identifier),
                'term': ('docker', 'kill', '--signal=TERM', identifier),
                'wait': ('docker', 'wait', identifier),
                'restart-always': ('docker', 'update', '--restart=always', identifier),
                'start': ('docker', 'start', identifier)}
    require(operation in commands, 'transport-operation')
    return commands[operation]


class SimulatedHostTransport:
    def __init__(self, driver):
        require(getattr(driver, 'mode', None) == 'local-simulation', 'transport-simulation-required')
        self.driver = driver
        self.identities = None

    def _request(self, argv, timeout):
        require(getattr(self.driver, 'mode', None) == 'local-simulation', 'transport-simulation-required')
        try:
            return self.driver.request(tuple(argv), timeout=timeout)
        except TimeoutError:
            raise TimeoutError('simulated-transport-timeout') from None
        except Exception:
            raise Refused('simulated-transport-failed') from None

    def snapshot(self):
        data = self._request(('snapshot-metadata',), 5)
        require(isinstance(data, dict) and data.get('mode') == 'local-simulation', 'transport-snapshot')
        services = data.get('services')
        require(isinstance(services, dict) and set(services) == set(ROLES), 'transport-scope')
        identities = {role: state.get('id') if isinstance(state, dict) else None
                      for role, state in services.items()}
        require(all(isinstance(value, str) and re.fullmatch('[0-9a-f]{64}', value)
                    for value in identities.values()) and len(set(identities.values())) == 4,
                'transport-identities')
        if self.identities is None:
            self.identities = identities
        require(identities == self.identities, 'transport-identity-changed')
        # Full shape/topology/gates validation remains in LocalHostContract.
        return deepcopy(data)

    def _target(self, identifier):
        require(self.identities is not None and identifier in self.identities.values(), 'transport-target')
        self.snapshot()  # Detect replacement immediately before a simulated effect.

    def block_ingress(self):
        require(self.identities is not None, 'transport-unobserved')
        self.snapshot()
        require(self._request(('block-ingress',), 5) is True, 'transport-ingress-receipt')

    def disable_restart(self, identifier):
        self._target(identifier)
        require(self._request(host_command('restart-no', identifier), 5) is True,
                'transport-restart-receipt')

    def signal_term(self, identifier):
        self._target(identifier)
        require(self._request(host_command('term', identifier), 5) is True,
                'transport-signal-receipt')

    def wait_stopped(self, identifier, timeout):
        require(type(timeout) is int and 0 < timeout <= 30, 'transport-wait-bound')
        self._target(identifier)
        status = self._request(host_command('wait', identifier), timeout)
        require(type(status) is int and status == 0, 'transport-exit-not-clean')


def _ids(value, roles):
    return (isinstance(value, dict) and set(value) == set(roles)
            and all(isinstance(v, str) and re.fullmatch('[0-9a-f]{64}', v) for v in value.values())
            and len(set(value.values())) == len(roles))


class ObservedHostTransport:
    def __init__(self, driver, *, legacy_project, network_id, service_ids, support_ids, processing_keys=()):
        require(getattr(driver, 'mode', None) == 'observed-host', 'transport-observed-required')
        require(isinstance(legacy_project, str) and re.fullmatch(r'[A-Za-z0-9_-]{1,63}', legacy_project),
                'transport-project')
        require(isinstance(network_id, str) and re.fullmatch('[0-9a-f]{64}', network_id), 'transport-network')
        require(_ids(service_ids, ROLES), 'transport-identities')
        require(_ids(support_ids, SUPPORT_ROLES) and not set(support_ids.values()) & set(service_ids.values()),
                'transport-support-identities')
        self.driver, self.legacy_project, self.network_id = driver, legacy_project, network_id
        self.identities, self.support_ids = dict(service_ids), dict(support_ids)
        self.processing_keys = processing_keys  # validated by queue_metadata on every snapshot
        self.support_digest = None
        self.scope_digest = None

    @property
    def supports_resume(self):
        return getattr(self.driver, 'supports_resume', False) is True

    def _request(self, argv, timeout):
        require(getattr(self.driver, 'mode', None) == 'observed-host', 'transport-observed-required')
        try:
            return self.driver.request(tuple(argv), timeout=timeout)
        except TimeoutError:
            raise TimeoutError('observed-transport-timeout') from None
        except Exception:
            raise Refused('observed-transport-failed') from None

    def snapshot(self):
        declared = getattr(self.driver, 'transport_scope', None)
        if callable(declared):
            require(declared() == dict(legacy_project=self.legacy_project, network_id=self.network_id,
                                      service_ids=self.identities, support_ids=self.support_ids,
                                      processing_keys=self.processing_keys), 'transport-driver-scope')
        raw = self._request(('inspect-host',), 10)
        require(isinstance(raw, dict) and set(raw) == {
            'scope_digest', 'ingress_blocked', 'unknown_writers', 'network_id', 'services', 'support'}, 'transport-snapshot')
        require(isinstance(raw['scope_digest'], str) and re.fullmatch('[0-9a-f]{64}', raw['scope_digest']),
                'transport-scope-digest')
        if self.scope_digest is None:
            self.scope_digest = raw['scope_digest']
        require(raw['scope_digest'] == self.scope_digest, 'transport-scope-changed')
        require(raw['network_id'] == self.network_id, 'transport-network-mismatch')
        require(type(raw['ingress_blocked']) is bool and type(raw['unknown_writers']) is int
                and raw['unknown_writers'] >= 0, 'transport-snapshot')
        support = raw['support']
        require(isinstance(support, dict) and set(support) == set(SUPPORT_ROLES), 'transport-support-scope')
        for role, state in support.items():
            require(isinstance(state, dict) and set(state) == SUPPORT_FIELDS, 'transport-support-shape')
            require(state['id'] == self.support_ids[role], 'transport-support-identity-changed')
            require(isinstance(state['image'], str) and re.fullmatch(r'sha256:[0-9a-f]{64}', state['image']),
                    'transport-support-image')
            require(state['compose_project'] == self.legacy_project and state['compose_service'] == role,
                    'transport-support-compose')
            require(state['running'] is True and state['restart_policy'] == 'always',
                    'transport-support-not-running')
            require(state['health'] == 'healthy' if role in ('redis', 'evolution-postgres')
                    else state['health'] in ('healthy', None), 'transport-support-unhealthy')
            require(isinstance(state['networks_digest'], str)
                    and re.fullmatch('[0-9a-f]{64}', state['networks_digest']), 'transport-support-network')
        support_digest = digest([self.network_id, {role: support[role] for role in sorted(SUPPORT_ROLES)}])
        if self.support_digest is None:
            self.support_digest = support_digest
        require(support_digest == self.support_digest, 'transport-support-changed')
        services = raw['services']
        require(isinstance(services, dict) and set(services) == set(ROLES), 'transport-scope')
        require(all(isinstance(services[role], dict) and set(services[role]) == SERVICE_FIELDS
                    for role in ROLES), 'transport-service-shape')
        require({role: services[role]['id'] for role in ROLES} == self.identities, 'transport-identity-changed')
        require(all(services[role].get('compose_project') == self.legacy_project
                    for role in ROLES if role != 'broadcast-worker'), 'transport-compose')
        queue = queue_metadata(lambda command, key: self._request(('redis-meta', command, key), 5),
                               processing_keys=self.processing_keys)
        # Field types/topology/gates validation remains in ObservedHostContract;
        # only the declared keys leave the transport, never extra driver data.
        return dict(mode='observed-host', scope_digest=raw['scope_digest'], ingress_blocked=raw['ingress_blocked'], support_digest=support_digest,
                    unknown_writers=raw['unknown_writers'], queue_digest=queue['metadata_digest'],
                    queue_counts=queue['counts'],
                    services=deepcopy({role: {key: services[role][key] for key in SERVICE_FIELDS}
                                       for role in ROLES}))

    def _target(self, identifier):
        require(identifier in self.identities.values(), 'transport-target')
        self.snapshot()  # Detect replacement immediately before a host effect.

    def _guarded(self, guard, identifier=None):
        if identifier is not None:
            require(identifier in self.identities.values(), 'transport-target')
        require(callable(guard), 'transport-guard-required')
        # This final observation, not an earlier one, is what the guard judges.
        guard(self.snapshot())

    def block_ingress(self, guard=None):
        self._guarded(guard)
        require(self._request(('block-ingress',), 5) is True, 'transport-ingress-receipt')

    def open_ingress(self, guard=None):
        self._guarded(guard)
        require(self._request(('open-ingress',), 5) is True, 'transport-ingress-receipt')

    def disable_restart(self, identifier, guard=None):
        self._guarded(guard, identifier)
        require(self._request(host_command('restart-no', identifier), 5) is True,
                'transport-restart-receipt')

    def enable_restart(self, identifier, guard=None):
        self._guarded(guard, identifier)
        require(self._request(host_command('restart-always', identifier), 5) is True,
                'transport-restart-receipt')

    def signal_term(self, identifier, guard=None):
        self._guarded(guard, identifier)
        require(self._request(host_command('term', identifier), 5) is True,
                'transport-signal-receipt')

    def wait_stopped(self, identifier, timeout):
        require(type(timeout) is int and 0 < timeout <= 30, 'transport-wait-bound')
        self._target(identifier)
        status = self._request(host_command('wait', identifier), timeout)
        require(type(status) is int and status == 0, 'transport-exit-not-clean')

    def start_service(self, identifier, guard=None):
        self._guarded(guard, identifier)
        require(self._request(host_command('start', identifier), 10) is True,
                'transport-start-receipt')

FILE deploy/initial_transition_files.py
"""Durable journal, exact Git blobs and release layout of the initial transition.

Every local path (spec, state/journal, compose, release layout) is refused
when any component is protected (``.env*``, ``secrets``, keys, dumps, ...)
before it is opened, created or even ``lstat``-ed; then symlinks are refused
for the path and every existing ancestor and files are opened ``O_NOFOLLOW``.
Git paths with a protected component are refused before any blob is read,
even when they would match the allowlist.
"""
from __future__ import annotations

import fcntl
import hashlib
import json
import os
import re
import runpy
import stat
import subprocess
import tempfile
import time
from pathlib import Path

from initial_transition_ops import MIGRATION, SHA, Refused, require
import release_topology

PROTECTED = re.compile(r'(?:\.env.*|secrets?|.*\.pem|.*\.key|id_rsa.*|id_ed25519.*|target_users.*|.*\.dump'
                       r'|dumps?|backups?|exports?|media|migrate_clerk_production.*|clerk_.*)', re.IGNORECASE)
CLERK = re.compile(r'.*clerk.*', re.IGNORECASE)


def is_protected(parts):
    """Protected component, or any clerk-named entry under a ``scripts`` directory (admin tooling).

    Pure string check: callers apply it before any lstat/open/cat-file.
    """
    parts = [p for p in parts if p not in ('', os.sep)]
    return any(PROTECTED.fullmatch(p) for p in parts) or any(
        CLERK.fullmatch(p) for i, p in enumerate(parts) if 'scripts' in (q.lower() for q in parts[:i]))
LAYOUT_DEPLOY = ('backend-release.sh', 'check_backend_schema.py', 'emit_schema_check.py',
                 'schema_compatibility.py', 'docker-compose.yml')
LAYOUT_SQL = re.compile(r'backend/migrations/(?:[A-Za-z0-9_]+/)?[A-Za-z0-9_.-]+\.sql')
MAX_FILE = 4 * 1024 * 1024


def no_symlink(path):
    """Refuse a protected component anywhere in ``path`` (checked on the string, before any
    filesystem access), then a symlink in ``path`` or any existing ancestor (no TOCTOU-free claim)."""
    path = Path(os.path.abspath(path))
    require(not is_protected(path.parts), 'protected-path')
    for candidate in (path, *path.parents):
        try:
            if stat.S_ISLNK(os.lstat(candidate).st_mode):
                raise Refused('symlink-refused')
        except FileNotFoundError:
            continue
    return path


def read_regular(path, limit=MAX_FILE):
    path = no_symlink(path)
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        raise Refused('file-unreadable') from None
    with os.fdopen(fd, 'rb') as handle:
        require(stat.S_ISREG(os.fstat(handle.fileno()).st_mode), 'file-not-regular')
        data = handle.read(limit + 1)
    require(len(data) <= limit, 'file-too-large')
    return data


def sha256(data):
    return hashlib.sha256(data).hexdigest()


# -- journal --------------------------------------------------------------
class Journal:
    """Append-only JSON lines, one writer (``flock``), full write + ``fsync`` per record.

    Opening validates every record (JSON object, consecutive ``seq``, ``kind``)
    and refuses a torn tail instead of guessing what the crashed writer meant.
    """

    def __init__(self, directory, *, writer=os.write):
        self.dir = Path(directory)
        self.path = self.dir / 'journal.jsonl'
        self.lock_fd = None
        self.events = []
        self.writer = writer

    def __enter__(self):
        return self.open()

    def __exit__(self, *_):
        self.close()

    def open(self):
        no_symlink(self.dir)
        self.dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        require(stat.S_ISDIR(os.lstat(self.dir).st_mode), 'state-not-directory')
        no_symlink(self.dir / 'journal.lock')
        no_symlink(self.path)
        self.lock_fd = os.open(self.dir / 'journal.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        try:
            fcntl.flock(self.lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            self.close()
            raise Refused('controller-busy') from None
        created = not os.path.lexists(self.path)
        self.events = []
        if not created:
            raw = read_regular(self.path, 64 * 1024 * 1024)
            lines = raw.split(b'\n')
            require(lines[-1] == b'', 'journal-torn')
            for index, line in enumerate(lines[:-1], 1):
                try:
                    event = json.loads(line)
                except ValueError:
                    raise Refused('journal-torn') from None
                require(isinstance(event, dict) and event.get('seq') == index
                        and isinstance(event.get('kind'), str), 'journal-invalid')
                self.events.append(event)
        fd = os.open(self.path, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        os.close(fd)
        if created:
            dir_fd = os.open(self.dir, os.O_RDONLY)
            try:
                os.fsync(dir_fd)
            finally:
                os.close(dir_fd)
        return self

    def close(self):
        if self.lock_fd is not None:
            os.close(self.lock_fd)  # releases the flock
            self.lock_fd = None

    def digest(self):
        return sha256(read_regular(self.path, 64 * 1024 * 1024) if os.path.lexists(self.path) else b'')

    def append(self, kind, **fields):
        require(self.lock_fd is not None, 'journal-not-locked')
        event = dict(seq=len(self.events) + 1, at=time.time(), kind=kind, **fields)
        line = memoryview((json.dumps(event, sort_keys=True, separators=(',', ':')) + '\n').encode())
        fd = os.open(self.path, os.O_WRONLY | os.O_APPEND | os.O_NOFOLLOW)
        try:
            while line:  # a short write is completed, never left as a torn record
                written = self.writer(fd, line)
                require(written > 0, 'journal-write')
                line = line[written:]
            os.fsync(fd)
        finally:
            os.close(fd)
        self.events.append(event)
        return event

    def find(self, kind, step=None, since=0):
        return [e for e in self.events if e['kind'] == kind and e['seq'] > since
                and (step is None or e.get('step') == step)]

    def last(self, kind, step=None, since=0):
        found = self.find(kind, step, since)
        return found[-1] if found else None


# -- Git ------------------------------------------------------------------
def git_tree(repo, sha, pathspecs, pattern, git=None, excluded=None):
    """``{path: bytes}`` of tracked blobs matching ``pattern``; blob hashes re-verified.

    Any listed path with a protected component refuses the whole read before
    the first ``cat-file``. With ``excluded`` set, unexpected paths refuse;
    only exact excluded names may be skipped without reading their blobs.
    """
    def call(*args):
        if git is not None:
            return git(list(args))
        try:
            done = subprocess.run(['git', '-C', str(repo), *args], capture_output=True, timeout=60)
        except subprocess.TimeoutExpired:
            raise Refused('git-step') from None
        require(done.returncode == 0, 'git-step')
        return done.stdout

    require(SHA.fullmatch(sha or ''), 'sha')
    require(call('rev-parse', '--verify', '--quiet', '--end-of-options', sha + '^{commit}').decode().strip() == sha,
            'sha')
    entries = []
    for entry in filter(None, call('ls-tree', '-r', '-z', '--full-tree', sha, '--', *pathspecs).split(b'\0')):
        meta, _, raw = entry.partition(b'\t')
        mode, kind, oid = meta.decode('ascii').split(' ')
        path = raw.decode('utf-8')
        require(not is_protected(path.split('/')), 'source-protected-path')
        entries.append((mode, kind, oid, path))
    files = {}
    for mode, kind, oid, path in entries:
        if not pattern.fullmatch(path):
            require(excluded is None or path in excluded, 'source-unexpected-file')
            continue
        require(kind == 'blob' and mode in ('100644', '100755'), 'source-entry-type')
        data = call('cat-file', 'blob', oid)
        require(hashlib.sha1(b'blob %d\0' % len(data) + data).hexdigest() == oid, 'source-blob-hash')
        files[path] = data
    return files


def migration_manifest(migrate_source, sql):
    """The candidate's own selection rule over its exact SQL blobs, in a private temp tree."""
    with tempfile.TemporaryDirectory(prefix='pastorai-transition-manifest-') as directory:
        root = Path(directory)
        (root / 'scripts').mkdir()
        (root / 'migrations').mkdir()
        (root / 'scripts' / 'migrate.py').write_bytes(migrate_source)
        for name, body in sql.items():
            (root / 'migrations' / name).write_bytes(body)
        files = runpy.run_path(str(root / 'scripts' / 'migrate.py'))['migration_files'](root / 'migrations')
    require(files and all(MIGRATION.fullmatch(n) for n in files) and len(files) == len(set(files)), 'manifest')
    return files


# -- release layout -----------------------------------------------------------
def layout_files(files, topology, image, sha):
    """Exact blobs plus the public topology contract and maintenance override.

    The helper the runner needs travels with it as an exact blob. The override
    pins the candidate's verified local image ID (no registry digest invented),
    so ordinary Compose maintenance never falls back to a mutable tag. The
    layout holds no build source: recovery to it reuses that image ID.
    """
    wanted = {f'deploy/{name}': files[f'deploy/{name}'] for name in LAYOUT_DEPLOY}
    helper = 'deploy/release_topology.py'
    if helper in files:
        wanted[helper] = files[helper]
    require(helper in files or b'release_topology.py' not in files['deploy/backend-release.sh'], 'layout-helper-missing')
    wanted['backend/scripts/migrate.py'] = files['backend/scripts/migrate.py']
    wanted.update({p: b for p, b in files.items() if LAYOUT_SQL.fullmatch(p)})
    try:
        wanted['deploy/release-topology.json'] = release_topology.canonical(topology).encode()
        wanted['deploy/docker-compose.override.yml'] = release_topology.overlay(topology, image, sha).encode()
    except release_topology.Refused as exc:
        raise Refused('layout-topology') from exc
    return wanted


def inventory(root):
    """Relative regular files under ``root`` by ``lstat`` only; links/specials/protected refused unread."""
    found = []
    for top, dirs, names in os.walk(root, followlinks=False):
        for name in [*dirs, *names]:
            full = os.path.join(top, name)
            rel = os.path.relpath(full, root)
            require(not is_protected(rel.split(os.sep)), 'layout-unsafe-entry')  # before lstat
            mode = os.lstat(full).st_mode
            require(not stat.S_ISLNK(mode), 'layout-unsafe-entry')
            if name in names:
                require(stat.S_ISREG(mode), 'layout-unsafe-entry')
                found.append(rel)
    return sorted(found)


def write_layout(root, sha, files, topology, manifest, image):
    """``releases/<sha>`` from exact blobs (tooling, runner, SQL), the topology contract and
    the maintenance override pinned to ``image`` (verified ID); no private config. Idempotent."""
    releases = no_symlink(Path(root) / 'releases')
    releases.mkdir(mode=0o755, parents=True, exist_ok=True)
    return _materialize(releases, sha, files, topology, manifest, image)


def write_release(release_root, sha, files, topology, manifest, image):
    """``<release_root>/<sha>`` (production layout, e.g. ``/opt/pastorai-releases``) with the same
    content rules as ``write_layout``. The root is configured and must already exist; an existing
    release is only verified byte for byte, never overwritten."""
    releases = no_symlink(Path(release_root))
    require(os.path.lexists(releases) and stat.S_ISDIR(os.lstat(releases).st_mode), 'release-root-missing')
    return _materialize(releases, sha, files, topology, manifest, image)


def _materialize(releases, sha, files, topology, manifest, image):
    require(SHA.fullmatch(sha or ''), 'sha')
    require(release_topology.IMAGE_ID.fullmatch(image or ''), 'layout-topology')
    wanted = layout_files(files, topology, image, sha)
    target = releases / sha
    if os.path.lexists(target):
        require(stat.S_ISDIR(os.lstat(target).st_mode), 'layout-mismatch')
        if inventory(target) != sorted(wanted):  # decided before reading any content
            raise Refused('layout-mismatch')
        if any(read_regular(target / p) != wanted[p] for p in sorted(wanted)):
            raise Refused('layout-mismatch')
        return len(wanted)
    staging = Path(tempfile.mkdtemp(prefix=f'.{sha}.staging-', dir=releases))
    for path, data in sorted(wanted.items()):
        out = staging / path
        out.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o755 if path.endswith('.sh') else 0o644)
        with os.fdopen(fd, 'wb') as handle:
            handle.write(data)
    staging.chmod(0o755)
    found = runpy.run_path(str(staging / 'backend/scripts/migrate.py'))['migration_files'](staging / 'backend/migrations')
    require(found == manifest, 'layout-manifest')
    # Exclusive: an empty reservation is the only thing rename may replace; a
    # concurrent non-empty target makes rename fail instead of being overwritten.
    try:
        os.mkdir(target, 0o755)
        os.rename(staging, target)
    except OSError:
        raise Refused('layout-exists') from None
    return len(wanted)


def activate(root, sha):
    root = no_symlink(Path(root))
    link, target = root / 'current', root / 'releases' / sha
    require(os.path.isdir(target) and not os.path.islink(target), 'layout-missing')
    if os.path.islink(link):
        require(os.readlink(link) == str(target), 'current-exists')
        return
    require(not os.path.lexists(link), 'current-exists')
    staging = root / f'current.next.{os.getpid()}'
    if os.path.lexists(staging):
        os.unlink(staging)
    os.symlink(target, staging)
    os.replace(staging, link)

FILE deploy/package_backend_release.py
#!/usr/bin/env python3
"""Build a reproducible production tarball from exact, allowlisted Git blobs.

No worktree content, Git archive attributes, credentials or administrative
scripts enter the archive. Uses the existing protected-path/blob reader; it
never executes the candidate. This only creates a local artifact, not a release.
"""
from __future__ import annotations

import argparse
import gzip
import hashlib
import io
import json
import os
from pathlib import Path
import re
import sys
import tarfile
import tempfile

from initial_transition_files import git_tree, no_symlink
from initial_transition_ops import Refused, require

REQUIRED = (
    'backend/Dockerfile', 'backend/.dockerignore', 'backend/requirements.lock',
    'backend/scripts/migrate.py', 'backend/app/main.py',
    'deploy/backend-release.sh', 'deploy/check_backend_schema.py',
    'deploy/emit_schema_check.py', 'deploy/schema_compatibility.py',
    'deploy/release_topology.py', 'deploy/docker-compose.yml',
)
PATHSPECS = ('backend/app', 'backend/migrations', *REQUIRED)
ALLOWLIST = re.compile(
    r'backend/app/(?:[A-Za-z_][A-Za-z0-9_]*/)*[A-Za-z_][A-Za-z0-9_]*\.py'
    r'|backend/migrations/(?:[A-Za-z0-9_]+/)*[A-Za-z0-9_.-]+\.sql'
    r'|' + '|'.join(re.escape(name) for name in REQUIRED)
)


def source_files(repo: Path, sha: str, git=None) -> dict:
    """The exact allowlisted blobs of ``sha`` that the package carries."""
    files = git_tree(repo, sha, PATHSPECS, ALLOWLIST, git,
                     excluded={'backend/migrations/README.md'})
    require(set(REQUIRED) <= files.keys(), 'package-required-files')
    require(any(re.fullmatch(r'backend/migrations/[^/]+\.sql', name) for name in files),
            'package-migrations-missing')
    return files


def release_manifest(sha: str, files: dict) -> bytes:
    """``release-manifest.json`` bytes: binds the package to its commit and blob digests."""
    manifest = {
        'commit': sha,
        'files': {name: hashlib.sha256(data).hexdigest() for name, data in sorted(files.items())},
    }
    return (json.dumps(manifest, sort_keys=True, indent=2) + '\n').encode()


def build(repo: Path, sha: str, output: Path) -> dict:
    output = no_symlink(output)
    require(not output.exists(), 'package-output-exists')
    files = source_files(repo, sha)
    contents = {**files, 'release-manifest.json': release_manifest(sha, files)}
    archive = io.BytesIO()
    with tarfile.open(fileobj=archive, mode='w', format=tarfile.PAX_FORMAT) as tar:
        directories = {str(parent) for name in contents for parent in Path(name).parents
                       if str(parent) != '.'}
        for name in sorted(directories):
            entry = tarfile.TarInfo(name + '/')
            entry.type = tarfile.DIRTYPE
            entry.mode = 0o755
            tar.addfile(entry)
        for name, data in sorted(contents.items()):
            entry = tarfile.TarInfo(name)
            entry.size = len(data)
            entry.mode = 0o755 if name == 'deploy/backend-release.sh' else 0o644
            # TarInfo defaults: regular file, uid/gid/mtime zero, no owner names.
            tar.addfile(entry, io.BytesIO(data))
    payload = gzip.compress(archive.getvalue(), mtime=0)
    # Publish atomically without overwriting an existing artifact, even if another
    # invocation created it after the early check. No partial tarball is consumed.
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(dir=output.parent, prefix='release-package-', delete=False) as handle:
            temporary = Path(handle.name)
            os.fchmod(handle.fileno(), 0o644)
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.link(temporary, output)
    except OSError:
        raise Refused('package-output') from None
    finally:
        if temporary is not None:
            temporary.unlink()
    return {'commit': sha, 'files': len(files), 'sha256': hashlib.sha256(payload).hexdigest()}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--repo', type=Path, required=True)
    parser.add_argument('--sha', required=True)
    parser.add_argument('--output', type=Path, required=True)
    args = parser.parse_args()
    try:
        result = build(args.repo, args.sha, args.output)
    except Refused as exc:
        print(f'package refused: {exc}', file=sys.stderr)
        return 1
    except (OSError, ValueError):
        print('package refused: invalid source or output', file=sys.stderr)
        return 1
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())

FILE deploy/first_transition_adapter.py
"""Local-only database slice of the first-transition adapter.

Exact Git blobs, the reviewed migration CLI and the durable transition journal
are reused. There is deliberately no host/SSH/Redis/deploy transport here.
Containment/backup evidence is labelled local simulation, never production
proof. Completion holds at database-verified; it cannot start an application,
resume the legacy or change a gate. See the existing release runbook.
"""
from __future__ import annotations

from dataclasses import dataclass, field
import hashlib
import json
from pathlib import Path
import re
import subprocess
import sys
import tempfile
from urllib.parse import urlsplit
from uuid import UUID

from initial_transition_files import Journal, git_tree, read_regular
from initial_transition_ops import BACKFILL_SQL, Refused, require

APPLICATION_SHA = 'afdfb78d71a53f2861632806e13cdda4662d7d63'
EXECUTOR_SHA = '37c7d68d60b6f86cfb1fe75d4c720530537845d6'
ROLES = ('backend', 'cron-worker', 'broadcast-worker', 'queue-worker')
MISSING = frozenset({
    '20260711_023515_backfill_pessoa_tipo_membro_por_vinculo_ativo.sql',
    '20260711_152127_reclassifica_pessoa_do_numero_whatsapp_fora_de_membro.sql',
    '20260925_183811_preserve_platform_admins_on_tenant_deletion.sql',
    '20260926_120446_platform_jev_settings.sql',
})
REVIEWED_CONCURRENT = {'20261023_100001_ai_usage_tenant_created_idx.sql': ('ai_usage_logs_igreja_created_at_idx',), '20261023_110001_notification_outbox_pending_created_idx.sql': ('notification_outbox_pending_igreja_created_idx',), '20261023_110002_notification_outbox_retry_created_idx.sql': ('notification_outbox_retry_igreja_created_idx',), '20261023_110003_notification_outbox_expired_lease_idx.sql': ('notification_outbox_lease_igreja_claimed_idx',), '20261023_110004_messages_pending_agent_created_idx.sql': ('messages_pending_agent_igreja_created_idx',), '20261023_110005_work_queue_pending_created_idx.sql': ('work_queue_pending_igreja_created_idx',), '20261028_100001_private_erasure_requests_overview_idx.sql': ('private_erasure_requests_overview_idx',), '20261028_100002_private_resume_delivered_overview_idx.sql': ('private_resume_delivered_overview_idx',)}

SQL_PATH = re.compile(r'backend/migrations/[A-Za-z0-9_.-]+\.sql')
INDEX = re.compile(r'create\s+(?:unique\s+)?index\s+concurrently\s+(?:if\s+not\s+exists\s+)?'
                   r'(?:public\.)?"?([a-z0-9_]+)"?', re.I)


def digest(value):
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',', ':')).encode()).hexdigest()


def adapter_sources():
    root = Path(__file__).resolve().parent
    return tuple((name, hashlib.sha256(read_regular(root / name)).hexdigest()) for name in (
        'first_transition_adapter.py', 'first_transition_local_backup.py',
        'first_transition_host_contract.py', 'first_transition_host_transport.py', 'first_transition_host_driver.py',
        'first_transition_database.py', 'first_transition_candidate.py', 'first_transition_orchestrator.py',
        'initial_transition_files.py', 'package_backend_release.py',
        'initial_transition_ops.py', 'release_topology.py'))


PREFLIGHT_PROBE = r'''
import json,os,sys
try:
    import psycopg2
    sys.path.insert(0,sys.argv[1])
    import release_preflight
    connection=psycopg2.connect(os.environ['MIGRATION_DATABASE_URL'],connect_timeout=3,hostaddr='127.0.0.1',
        sslmode='disable',application_name='igreja12-local-preflight',
        options='-c search_path=pg_catalog,public -c statement_timeout=5000 -c lock_timeout=2000 -c row_security=off')
    try:
        connection.autocommit=True
        with connection.cursor() as cursor:
            cursor.execute("SELECT shobj_description(oid,'pg_database') FROM pg_database WHERE datname=current_database()")
            if cursor.fetchone()[0]!='igreja12-local-disposable:'+os.environ['FIRST_TRANSITION_LOCAL_NONCE']:
                raise RuntimeError('unowned disposable database')
        connection.autocommit=False
        report=release_preflight.inspect_connection(connection)
        with connection.cursor() as cursor:
            cursor.execute("SELECT current_setting('transaction_read_only')")
            readonly=cursor.fetchone()[0]=='on'
        output=dict(status='ok',read_only=readonly,files=len(report.migrations),
            applied=sum(row.state=='APLICADA' for row in report.migrations),
            pending=sum(row.state=='PENDENTE' for row in report.migrations),
            unknown=report.unknown_applied_count,fk_findings=len(report.fk_findings),
            duplicates=len(report.duplicate_findings),missing_tables=len(report.missing_backup_tables),
            definer_examined=len(report.definer_examined),
            definer_unverified=len(report.definer_unverified),definer_findings=len(report.definer_findings))
        print(json.dumps(output,sort_keys=True))
    finally:
        connection.rollback()
        connection.close()
except BaseException:
    print('{"status":"refused","code":"full-preflight-failed"}')
    sys.exit(3)
'''

PREFLIGHT_COUNTS = frozenset({'files', 'applied', 'pending', 'unknown', 'fk_findings',
                            'duplicates', 'missing_tables', 'definer_examined',
                            'definer_unverified', 'definer_findings'})


def preflight_summary(raw, files, applied):
    try:
        data = json.loads(raw)
    except (ValueError, TypeError):
        raise Refused('full-preflight-output') from None
    require(isinstance(data, dict) and set(data) == PREFLIGHT_COUNTS | {'status', 'read_only'},
            'full-preflight-output')
    require(data['status'] == 'ok' and data['read_only'] is True
            and all(type(data[k]) is int and 0 <= data[k] <= 10**9 for k in PREFLIGHT_COUNTS),
            'full-preflight-output')
    require(data['files'] == files and data['applied'] == applied
            and data['pending'] == files - applied, 'full-preflight-output')
    return data


def require_clean_preflight(summary, *, complete):
    require(all(summary[key] == 0 for key in ('unknown', 'fk_findings', 'duplicates',
                                            'missing_tables', 'definer_findings')),
            'full-preflight-findings')
    if complete:
        require(summary['definer_unverified'] == 0, 'full-preflight-unverified')


@dataclass(frozen=True)
class Migration:
    name: str
    sql: bytes = field(repr=False)

    @property
    def sha256(self):
        return hashlib.sha256(self.sql).hexdigest()

    @property
    def indexes(self):
        code = '\n'.join(line for line in self.sql.decode().splitlines()
                         if not line.lstrip().startswith('--'))
        return tuple(sorted(set(match.lower() for match in INDEX.findall(code))))

    @property
    def concurrent(self):
        return bool(self.indexes)


@dataclass(frozen=True)
class Plan:
    application_sha: str
    executor_sha: str
    migrations: tuple[Migration, ...]
    baseline: tuple[str, ...]
    executor: bytes = field(repr=False)
    preflight: bytes = field(repr=False)
    adapter_sources: tuple[tuple[str, str], ...]

    @property
    def pending(self):
        return tuple(m for m in self.migrations if m.name not in self.baseline)

    @property
    def digest(self):
        return digest([self.application_sha, self.executor_sha, self.adapter_sources,
                       hashlib.sha256(self.executor).hexdigest(), hashlib.sha256(self.preflight).hexdigest(),
                       hashlib.sha256(PREFLIGHT_PROBE.encode()).hexdigest(), self.baseline,
                       [(m.name, m.sha256) for m in self.migrations]])

    def report(self):
        return dict(application_sha=self.application_sha, executor_sha=self.executor_sha,
                    plan_digest=self.digest, baseline=len(self.baseline), pending=len(self.pending),
                    active=len(self.migrations), concurrent=sum(m.concurrent for m in self.pending),
                    production_ready=False, stops_at='database-verified',
                    preflight_sha256=hashlib.sha256(self.preflight).hexdigest(),
                    adapter_sources_digest=digest(self.adapter_sources))


def prepare(repo: Path, application_sha=APPLICATION_SHA, executor_sha=EXECUTOR_SHA):
    require(application_sha == APPLICATION_SHA and executor_sha == EXECUTOR_SHA, 'unreviewed-release')
    files = git_tree(repo, application_sha, ('backend/migrations',), SQL_PATH)
    migrations = tuple(Migration(Path(name).name, sql) for name, sql in sorted(files.items())
                       if b'OPERATIONAL_AUTHORIZATION=BLOCKED' not in sql)
    baseline = tuple(m.name for m in migrations if m.name < '20261015' and m.name not in MISSING)
    runner = 'backend/scripts/migrate.py'
    executor = git_tree(repo, executor_sha, (runner,), re.compile(re.escape(runner)))
    require(runner in executor, 'executor-missing')
    probe = 'backend/scripts/release_preflight.py'
    probes = git_tree(repo, application_sha, (probe,), re.compile(re.escape(probe)))
    require(probe in probes, 'preflight-missing')
    plan = Plan(application_sha, executor_sha, migrations, baseline, executor[runner], probes[probe], adapter_sources())
    require((len(migrations), len(baseline), len(plan.pending)) == (129, 78, 51), 'release-shape')
    require(MISSING <= {m.name for m in migrations}, 'baseline-missing-set')
    require(all(not re.search(r'\bconcurrently\b', '\n'.join(
        line for line in m.sql.decode().splitlines() if not line.lstrip().startswith('--')), re.I)
        or m.name in REVIEWED_CONCURRENT for m in plan.pending), 'unreviewed-concurrent-form')
    require({m.name: m.indexes for m in plan.pending if m.concurrent} == REVIEWED_CONCURRENT,
            'concurrent-set')
    return plan


def local_endpoint(url, *, restore=False):
    try:
        parsed = urlsplit(url)
        valid = (parsed.scheme == 'postgresql' and parsed.hostname == '127.0.0.1'
                 and parsed.username == 'postgres' and parsed.password == 'synthetic-only'
                 and (bool(re.fullmatch(r'/first_transition_restore_[0-9a-f]{32}', parsed.path))
                      if restore else parsed.path == '/first_transition_test')
                 and not parsed.query and not parsed.fragment
                 and parsed.port is not None and 0 < parsed.port < 65536)
    except (TypeError, ValueError):
        valid = False
    require(valid, 'local-disposable-endpoint-required')


def _full_preflight_at(plan, url, applied, nonce):
    # Both accepted database names are exclusively local disposable targets.
    local_endpoint(url, restore=bool(re.fullmatch(
        r'/first_transition_restore_[0-9a-f]{32}', urlsplit(url).path)))
    with tempfile.TemporaryDirectory(prefix='igreja12-first-transition-preflight-') as directory:
        root = Path(directory)
        scripts = root / 'scripts'
        scripts.mkdir()
        (root / 'migrations').mkdir()
        (scripts / 'migrate.py').write_bytes(plan.executor)
        (scripts / 'release_preflight.py').write_bytes(plan.preflight)
        for migration in plan.migrations:
            (root / 'migrations' / migration.name).write_bytes(migration.sql)
        env = dict(PATH='/usr/bin:/bin', PYTHON_DOTENV_DISABLED='1',
                   MIGRATION_DATABASE_URL=url, FIRST_TRANSITION_LOCAL_NONCE=nonce)
        try:
            result = subprocess.run([sys.executable, '-c', PREFLIGHT_PROBE, str(scripts)],
                                    cwd=root, env=env, capture_output=True, timeout=30)
        except (OSError, subprocess.TimeoutExpired):
            raise Refused('full-preflight-failed') from None
        require(result.returncode == 0, 'full-preflight-failed')
        return preflight_summary(result.stdout, len(plan.migrations), applied)


@dataclass(frozen=True)
class LocalEvidence:
    """A test receipt, bound to plan/catalog/ledger. Never a real backup receipt.

    kind='observed-host' is only a metadata envelope over driver-reported data:
    validating it neither authorizes LocalTransition nor proves production.
    """
    plan_digest: str
    baseline_digest: str
    stopped_roles: tuple[str, ...] = ROLES
    ingress_blocked: bool = True
    backup_rehearsal_requested: bool = True
    queue_preservation_assumed: bool = True
    support_preserved: bool = True
    gates_preserved: bool = True
    kind: str = 'local-simulation'
    host_digest: str | None = None

    @classmethod
    def synthetic(cls, plan_digest, baseline_digest, *, host_digest=None):
        return cls(plan_digest, baseline_digest, host_digest=host_digest)

    @classmethod
    def observed(cls, plan_digest, baseline_digest, *, host_digest):
        return cls(plan_digest, baseline_digest, kind='observed-host', host_digest=host_digest)

    def validate(self, plan_digest, baseline_digest):
        require(self.kind in ('local-simulation', 'observed-host') and self.plan_digest == plan_digest
                and self.baseline_digest == baseline_digest and self.stopped_roles == ROLES
                and (self.host_digest is None and self.kind == 'local-simulation'
                     or isinstance(self.host_digest, str) and re.fullmatch('[0-9a-f]{64}', self.host_digest))
                and all(value is True for value in (self.ingress_blocked, self.backup_rehearsal_requested,
                        self.queue_preservation_assumed, self.support_preserved, self.gates_preserved)),
                'local-evidence-mismatch')


class LocalDatabase:
    """Literal loopback, dedicated DB and caller-owned disposable marker, before DDL.

    Reads return ledger, catalog metadata and aggregate findings only. No row
    payloads, queue contents or row digests are read. Another client connection
    is refused, even idle. This plus a DB advisory lock is a local test boundary,
    not a proof of production quiescence or full data preservation.
    """
    def __init__(self, url, nonce, *, restore=False):
        local_endpoint(url, restore=restore)
        try:
            require(str(UUID(nonce)) == nonce, 'disposable-marker')
        except (ValueError, TypeError, AttributeError):
            raise Refused('disposable-marker') from None
        self._url, self._nonce, self.conn = url, nonce, None

    def __enter__(self):
        import psycopg2
        try:
            self.conn = psycopg2.connect(self._url, connect_timeout=3,hostaddr='127.0.0.1', sslmode='disable', options='',
                                         application_name='igreja12-first-transition-local')
            self.conn.autocommit = True
            with self.conn.cursor() as cur:
                cur.execute("SELECT shobj_description(oid, 'pg_database') FROM pg_database WHERE datname=current_database()")
                require(cur.fetchone()[0] == 'igreja12-local-disposable:' + self._nonce, 'disposable-marker')
                cur.execute("SELECT system_identifier::text, (SELECT oid FROM pg_database WHERE datname=current_database()) FROM pg_control_system()")
                system, database_oid = cur.fetchone()
                self.identity = digest([system, database_oid, self._nonce])
                cur.execute('SELECT pg_try_advisory_lock(12712951)')
                require(cur.fetchone()[0] is True, 'adapter-busy')
            return self
        except BaseException as exc:
            self.__exit__(None, None, None)
            if isinstance(exc, Exception) and not isinstance(exc, Refused):
                raise Refused('local-database-unavailable-or-unowned') from None
            raise

    def __exit__(self, *_):
        if self.conn is not None:
            self.conn.close()
            self.conn = None

    def observe(self):
        try:
            return self._observe()
        except Refused:
            raise
        except Exception:
            raise Refused('database-observation-failed') from None

    def _observe(self):
        with self.conn.cursor() as cur:
            cur.execute('BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY')
            try:
                cur.execute("SET LOCAL statement_timeout='3s'")
                cur.execute('SET LOCAL search_path=pg_catalog,public')
                cur.execute("SELECT count(*) FROM pg_stat_activity WHERE datid=(SELECT oid FROM pg_database WHERE datname=current_database()) AND pid<>pg_backend_pid() AND backend_type='client backend'")
                require(cur.fetchone()[0] == 0, 'other-database-client')
                cur.execute('SELECT name FROM public.schema_migrations ORDER BY name COLLATE "C"')
                ledger = tuple(row[0] for row in cur.fetchall())
                cur.execute("SELECT c.relname FROM pg_index i JOIN pg_class c ON c.oid=i.indexrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND NOT (i.indisvalid AND i.indisready) ORDER BY c.relname")
                invalid = tuple(row[0] for row in cur.fetchall())
                cur.execute("SELECT c.oid,c.relname,c.relkind,a.attnum,a.attname,a.atttypid,a.attnotnull FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace LEFT JOIN pg_attribute a ON a.attrelid=c.oid AND a.attnum>0 AND NOT a.attisdropped WHERE n.nspname='public' ORDER BY c.oid,a.attnum")
                catalog = digest(cur.fetchall())
                cur.execute("SELECT c.relname,pg_get_indexdef(i.indexrelid) FROM pg_index i JOIN pg_class c ON c.oid=i.indexrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' ORDER BY c.relname")
                indexes = {name: digest(definition) for name, definition in cur.fetchall()}
                cur.execute('SELECT count(*) FROM (SELECT 1 FROM public.app_users WHERE pessoa_id IS NOT NULL GROUP BY igreja_id,pessoa_id HAVING count(*)>1) s')
                duplicates = cur.fetchone()[0]
                cur.execute('SELECT count(*) FROM public.celula_solicitacao r WHERE r.celula_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM public.celulas c WHERE c.id=r.celula_id AND c.igreja_id=r.igreja_id)')
                invalid_links = cur.fetchone()[0]
                cur.execute('SELECT count(*) FROM public.pessoas WHERE apto_proxima_cd IS TRUE')
                aptitude_backfill = cur.fetchone()[0]
                cur.execute(BACKFILL_SQL)
                backfills = cur.fetchone()[0]
                cur.execute("SELECT c.relname FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' ORDER BY c.relname")
                relations = tuple(row[0] for row in cur.fetchall())
                return dict(ledger=ledger, invalid=invalid, catalog=catalog, relations=relations, indexes=indexes,
                            duplicates=duplicates, invalid_links=invalid_links,
                            aptitude_backfill=aptitude_backfill, backfills=backfills)
            finally:
                cur.execute('ROLLBACK')

    def full_preflight(self, plan, applied):
        return _full_preflight_at(plan, self._url, applied, self._nonce)

    def rehearse_backup(self, plan):
        from first_transition_local_backup import rehearse_backup
        return rehearse_backup(self, plan)

    def apply(self, plan, migration, *, timeout=300):
        """One exact SQL blob through the exact reviewed CLI, fresh connection.

        The environment is constructed, never inherited. stdout/stderr remain
        captured in this process and are discarded; errors expose fixed codes.
        """
        with tempfile.TemporaryDirectory(prefix='igreja12-first-transition-sql-') as directory:
            root = Path(directory)
            (root / 'scripts').mkdir()
            (root / 'migrations').mkdir()
            (root / 'scripts/migrate.py').write_bytes(plan.executor)
            (root / 'migrations' / migration.name).write_bytes(migration.sql)
            args = [sys.executable, str(root / 'scripts/migrate.py'), 'apply', migration.name, '--yes']
            if migration.concurrent:
                args.append('--no-transaction')
            env = dict(PATH='/usr/bin:/bin', PYTHON_DOTENV_DISABLED='1',
                       MIGRATION_DATABASE_URL=self._url, PGAPPNAME='igreja12-local-migration')
            try:
                result = subprocess.run(args, cwd=root, env=env, capture_output=True, timeout=timeout)
            except subprocess.TimeoutExpired:
                raise Refused('migration-timeout') from None
            except OSError:
                raise Refused('migration-executor-unavailable') from None
            require(result.returncode == 0, 'migration-failed')


def reviewed_indexes(migration, observation):
    require(set(migration.indexes) <= observation['indexes'].keys(), 'reviewed-index-missing')
    return {name: observation['indexes'][name] for name in migration.indexes}


def baseline_digest(observation):
    return digest([observation['ledger'], observation['catalog']])


def step_invariants(observation):
    require(not observation['invalid'], 'invalid-index')
    require(observation['duplicates'] == 0 and observation['invalid_links'] == 0,
            'aggregate-preflight-finding')


def pre_ddl_findings(observation):
    step_invariants(observation)
    remaining_pre_ddl_gates(observation)


def remaining_pre_ddl_gates(observation):
    applied = set(observation['ledger'])
    gates = (
        ('20260711_023515_backfill_pessoa_tipo_membro_por_vinculo_ativo.sql',
         observation['backfills']['membro_por_vinculo']),
        ('20260711_152127_reclassifica_pessoa_do_numero_whatsapp_fora_de_membro.sql',
         observation['backfills']['numero_atendimento']),
        ('20261017_230000_uv_marcos_conclusao.sql', observation['aptitude_backfill']),
    )
    require(all(name in applied or candidates == 0 for name, candidates in gates),
            'pre-ddl-backfill-candidate')


def validate_clone_receipt(backup, plan, identity, baseline):
    require(isinstance(backup, dict) and backup.get('plan_digest') == plan.digest
            and backup.get('source_identity') == identity and backup.get('baseline_digest') == baseline
            and backup.get('restore_verified') is True, 'clone-receipt-invalid')
    clone = backup.get('clone_rehearsal')
    require(isinstance(clone, dict) and clone.get('migrations_verified') is True
            and clone.get('clone_identity') != identity
            and clone.get('cluster_global_ddl_possible') is True
            and type(clone.get('applied')) is int and clone['applied'] == len(plan.pending)
            and type(clone.get('final_ledger')) is int and clone['final_ledger'] == len(plan.migrations)
            and type(clone.get('concurrent')) is int and clone['concurrent'] == sum(m.concurrent for m in plan.pending)
            and clone.get('sql_digest') == digest([(m.name, m.sha256) for m in plan.pending])
            and all(isinstance(clone.get(key), str) and re.fullmatch('[0-9a-f]{64}', clone[key])
                    for key in ('final_schema_digest', 'clone_identity')),
            'clone-receipt-invalid')


class LocalTransition:
    """Durable local DB sequence; incomplete post-marker runs need explicit retry.

    adapter-failed is diagnostic; run-start/complete determine recovery consent.
    Completed replay is read-only. Concurrent migrations committed without an
    index receipt refuse recovery; no automatic adoption of their definitions.
    No service promotion or legacy resume. The local disposable DB composes only
    with the simulated LocalHostContract: an observed host, observed-host
    evidence or a journal holding observed-host-* events is refused before any
    DB observation or journal write, at construction and before every step.
    """
    def __init__(self, plan, database, journal: Journal, *, host=None):
        if host is not None:
            from first_transition_host_contract import LocalHostContract
            # One valid journal shared with the host contract.
            require(journal is not None and getattr(host, 'j', None) is journal, 'local-host-journal-mismatch')
            require(isinstance(host, LocalHostContract), 'local-transition-simulated-host-required')
        self.plan, self.db, self.j, self.host = plan, database, journal, host
        self._check_journal()

    def _check_journal(self):
        require(isinstance(self.j, Journal) and self.j.lock_fd is not None,
                'local-transition-journal-required')
        require(not any(event['kind'].startswith('observed-host-') for event in self.j.events),
                'local-transition-observed-journal')

    def _check_host(self, evidence):
        self._check_journal()
        require(evidence.kind == 'local-simulation', 'local-transition-simulated-evidence-required')
        if self.host is None:
            require(evidence.host_digest is None, 'local-host-evidence-unbound')
        else:
            receipt = self.host.assert_contained()
            require(receipt.get('mode') == 'local-simulation' and receipt.get('host_verified') is False
                    and evidence.host_digest == receipt['fingerprint'], 'local-host-evidence-mismatch')

    def run(self, evidence: LocalEvidence, *, retry=False):
        self._check_host(evidence)
        init = self.j.last('adapter-init')
        if init:
            require(init['plan_digest'] == self.plan.digest, 'plan-changed')
            require(init['database_identity'] == self.db.identity, 'database-changed')
        else:
            self.j.append('adapter-init', plan_digest=self.plan.digest,
                          database_identity=self.db.identity, adapter_sources=dict(self.plan.adapter_sources),
                          production_ready=False)
        observed = self.db.observe()
        step_invariants(observed)
        marker = self.j.last('adapter-ddl-marker')
        previous = self.j.last('adapter-run-start')
        complete = self.j.last('adapter-run-complete')
        interrupted = previous and (complete is None or complete.get('start_seq') != previous['seq'])
        unreceipted = any(not self.j.last('done', event['step']) for event in self.j.find('intent')
                          if str(event.get('step', '')).startswith('adapter-migration:'))
        needs_retry = marker is not None and bool(interrupted or unreceipted)
        if needs_retry:
            require(retry is True, 'explicit-local-retry-required')
            self.j.append('adapter-retry', previous_start=previous['seq'] if previous else None)
        run_start = self.j.append('adapter-run-start')['seq']
        if marker is None:
            pre_ddl_findings(observed)
            pending_indexes = {name for migration in self.plan.pending for name in migration.indexes}
            require(not pending_indexes.intersection(observed['relations']), 'concurrent-index-without-ledger')
            require(observed['ledger'] == self.plan.baseline, 'baseline-ledger')
            evidence.validate(self.plan.digest, baseline_digest(observed))
            preflight = self.db.full_preflight(self.plan, len(observed['ledger']))
            require_clean_preflight(preflight, complete=False)
            self.j.append('adapter-preflight', phase='before-ddl', **preflight)
            backup = self.db.rehearse_backup(self.plan)
            validate_clone_receipt(backup, self.plan, self.db.identity, baseline_digest(observed))
            backup_event = self.j.append('adapter-local-restore', **backup)
            self._check_host(evidence)
            # Re-observe immediately before the irrevocable marker; no row hashes.
            fresh = self.db.observe()
            pre_ddl_findings(fresh)
            require(not pending_indexes.intersection(fresh['relations']), 'concurrent-index-without-ledger')
            require(baseline_digest(fresh) == baseline_digest(observed), 'baseline-changed')
            self.j.append('adapter-ddl-marker', baseline_digest=baseline_digest(fresh),
                          evidence_kind=evidence.kind, pending=len(self.plan.pending), irrevocable=True,
                          restore_seq=backup_event['seq'], restore_digest=digest(backup))
        else:
            evidence.validate(self.plan.digest, marker['baseline_digest'])
            restored = next((event for event in self.j.find('adapter-local-restore')
                             if event['seq'] == marker.get('restore_seq')), None)
            require(restored is not None and digest({k: v for k, v in restored.items()
                    if k not in ('seq', 'at', 'kind')}) == marker.get('restore_digest'), 'restore-receipt-changed')
            backup = {k: v for k, v in restored.items() if k not in ('seq', 'at', 'kind')}
            validate_clone_receipt(backup, self.plan, self.db.identity, marker['baseline_digest'])
            preflight = self.db.full_preflight(self.plan, len(observed['ledger']))
            require_clean_preflight(preflight, complete=len(observed['ledger']) == len(self.plan.migrations))
        ledger = list(observed['ledger'])
        completed = [m.name for m in self.plan.pending if m.name in ledger]
        require(set(ledger) == set(self.plan.baseline) | set(completed)
                and completed == [m.name for m in self.plan.pending[:len(completed)]], 'ledger-not-prefix')
        require(all(e['step'].removeprefix('adapter-migration:') in ledger
                    for e in self.j.find('done') if e['step'].startswith('adapter-migration:')),
                'ledger-regressed')
        try:
            for migration in self.plan.pending:
                self._check_host(evidence)
                step = 'adapter-migration:' + migration.name
                require(all(e.get('sql_sha256') == migration.sha256 for e in self.j.find('intent', step)),
                        'migration-intent-changed')
                if migration.name in ledger:
                    require(self.j.last('intent', step) is not None, 'unjournaled-migration')
                    index_receipt = reviewed_indexes(migration, observed)
                    done = self.j.last('done', step)
                    if done:
                        require(done.get('indexes') == index_receipt, 'reviewed-index-changed')
                    else:
                        require(not migration.indexes, 'reviewed-index-receipt-missing')
                        self.j.append('done', step=step, recovered=True, indexes=index_receipt)
                    continue
                current = self.db.observe()
                step_invariants(current)
                remaining_pre_ddl_gates(current)
                require(set(current['ledger']) == set(ledger), 'ledger-changed')
                require(not (set(migration.indexes) & set(current['relations'])), 'concurrent-index-without-ledger')
                self.j.append('intent', step=step, sql_sha256=migration.sha256)
                self.db.apply(self.plan, migration)
                self._check_host(evidence)
                after = self.db.observe()
                step_invariants(after)
                require(set(after['ledger']) == set(ledger) | {migration.name}, 'migration-ledger-mismatch')
                self.j.append('done', step=step, indexes=reviewed_indexes(migration, after))
                ledger.append(migration.name)
            require(set(ledger) == {m.name for m in self.plan.migrations}, 'final-ledger')
            preflight = self.db.full_preflight(self.plan, len(ledger))
            require_clean_preflight(preflight, complete=True)
            from first_transition_local_backup import snapshot
            try:
                source_schema = snapshot(self.db.conn)['catalog']
            except Exception:
                raise Refused('clone-source-schema-check-failed') from None
            require(source_schema == backup['clone_rehearsal']['final_schema_digest'],
                    'clone-source-schema-divergence')
            self._check_host(evidence)
            final = self.db.observe()
            step_invariants(final)
            require(set(final['ledger']) == set(ledger), 'ledger-changed')
            for migration in self.plan.pending:
                done = self.j.last('done', 'adapter-migration:' + migration.name)
                require(done is not None and done.get('indexes') == reviewed_indexes(migration, final),
                        'reviewed-index-changed')
            self.j.append('adapter-preflight', phase='after-ddl', **preflight)
            if self.j.last('adapter-database-verified') is None:
                self.j.append('adapter-database-verified', ledger=len(ledger), production_ready=False)
            self.j.append('adapter-run-complete', start_seq=run_start)
            return dict(status='database-verified', ledger=len(ledger), production_ready=False,
                        services='simulated-held', host_verified=False, legacy_resume_allowed=False)
        except BaseException as exc:
            self.j.append('adapter-failed', code=str(exc) if isinstance(exc, Refused) else 'interrupted',
                          legacy_resume_allowed=False)
            raise


def queue_metadata(read, *, processing_keys=()):
    """Metadata only, over an explicitly supplied command port (no Redis client).

    Callers must already know the scoped processing lists; no KEYS/SCAN, value
    reads or row hashes. Equal lengths cannot prove equal contents, and the
    result expressly does not certify preservation or quiescence. Tests use a
    simulator; binding a real transport requires the separate host review.
    """
    require(isinstance(processing_keys, (tuple, list)) and len(processing_keys) <= 64,
            'queue-scope')
    require(all(isinstance(key, str) and re.fullmatch(
        r'pastorai:webhooks:processing:[A-Za-z0-9_-]{1,80}', key) for key in processing_keys),
        'queue-scope')
    require(len(set(processing_keys)) == len(processing_keys), 'queue-scope')
    kinds = {'pastorai:webhooks': 'list', 'pastorai:webhooks:processing': 'list',
             'pastorai:webhooks:dead': 'list', 'pastorai:webhooks:retry-scheduled': 'zset',
             **dict.fromkeys(processing_keys, 'list')}
    counts = {}
    def command(name, key):
        try:
            return read(name, key)
        except Exception:
            raise Refused('queue-observation-failed') from None
    for key, expected in sorted(kinds.items()):
        kind = command('TYPE', key)
        require(kind in (expected, 'none'), 'queue-type')
        ttl = command('PTTL', key)
        require(type(ttl) is int and (ttl == -1 if kind != 'none' else ttl == -2),
                'queue-not-persistent')
        count = command('LLEN' if expected == 'list' else 'ZCARD', key)
        require(type(count) is int and 0 <= count <= 2**63 - 1, 'queue-count')
        require(kind != 'none' or count == 0, 'queue-count')
        counts[key] = count
    return dict(counts=counts, metadata_digest=digest(counts), content_verified=False)

