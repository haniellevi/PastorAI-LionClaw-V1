{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igreja12.local/schemas/consent-catalog-design-v1.json",
  "title": "Consent catalog design v1 — synthetic examples only",
  "$comment": "Structural design artifact, not approval. Semantic digest/ref/supersedes/anchor validation in documentary tests is mandatory. Payload objects are separately validated against the unmodified decision-payload/v1 schema. No external schema retrieval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entry_id",
    "purpose",
    "tenant_binding",
    "package_id",
    "package_version",
    "status",
    "synthetic_only",
    "controller_approved",
    "human_packet_complete",
    "catalog_ready",
    "writer_eligible",
    "operational_authorization",
    "next_stage_authorized",
    "source_payload",
    "decision_payload",
    "resolved_refs",
    "content_digest",
    "entry_digest",
    "supersedes"
  ],
  "properties": {
    "schema_version": {
      "const": "consent-catalog/design-v1"
    },
    "entry_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "purpose": {
      "enum": [
        "atendimento_solicitado",
        "cuidado_pastoral",
        "tarefas_operacionais",
        "comunicados"
      ]
    },
    "tenant_binding": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "package_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "SYNTHETIC_FROZEN",
        "DRAFT_PENDING_EXTERNAL"
      ]
    },
    "synthetic_only": {
      "type": "boolean",
      "const": true
    },
    "controller_approved": {
      "type": "boolean",
      "const": false
    },
    "human_packet_complete": {
      "type": "boolean",
      "const": false
    },
    "catalog_ready": {
      "type": "boolean",
      "const": false
    },
    "writer_eligible": {
      "type": "boolean",
      "const": false
    },
    "operational_authorization": {
      "type": "boolean",
      "const": false
    },
    "next_stage_authorized": {
      "type": "boolean",
      "const": false
    },
    "source_payload": {
      "type": "object"
    },
    "decision_payload": {
      "type": "object"
    },
    "resolved_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_ref",
              "state",
              "bound_ref",
              "content_sha256",
              "content",
              "pending_reason"
            ],
            "properties": {
              "source_ref": {
                "type": "string",
                "pattern": "^ref:[a-z0-9][a-z0-9:-]*$"
              },
              "state": {
                "const": "RESOLVED_SYNTHETIC"
              },
              "bound_ref": {
                "type": "string",
                "pattern": "^ref:catalog:sha256:[0-9a-f]{64}$"
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "content": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "synthetic_only",
                  "kind",
                  "text"
                ],
                "properties": {
                  "synthetic_only": {
                    "type": "boolean",
                    "const": true
                  },
                  "kind": {
                    "const": "synthetic_governance_text"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "pending_reason": {
                "type": "null"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_ref",
              "state",
              "bound_ref",
              "content_sha256",
              "content",
              "pending_reason"
            ],
            "properties": {
              "source_ref": {
                "type": "string",
                "pattern": "^ref:[a-z0-9][a-z0-9:-]*$"
              },
              "state": {
                "const": "PENDING_EXTERNAL"
              },
              "bound_ref": {
                "type": "null"
              },
              "content_sha256": {
                "type": "null"
              },
              "content": {
                "type": "null"
              },
              "pending_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "content_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "entry_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entry_id",
            "entry_digest",
            "content_digest"
          ],
          "properties": {
            "entry_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "entry_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "content_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    }
  }
}
