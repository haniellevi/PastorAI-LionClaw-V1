{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igreja12.local/schemas/consent-catalog.json",
  "title": "Consent catalog: synthetic v1, frozen payload v2, append-only evidence succession",
  "anyOf": [
    {
      "$ref": "#/$defs/synthetic_v1"
    },
    {
      "$ref": "#/$defs/frozen_payload_v2"
    },
    {
      "$ref": "#/$defs/evidence_succession_v1"
    }
  ],
  "$defs": {
    "synthetic_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "entry_id",
        "purpose",
        "tenant_binding",
        "package_id",
        "package_version",
        "status",
        "synthetic_only",
        "controller_approved",
        "human_packet_complete",
        "catalog_ready",
        "writer_eligible",
        "operational_authorization",
        "next_stage_authorized",
        "source_payload",
        "decision_payload",
        "resolved_refs",
        "content_digest",
        "entry_digest",
        "supersedes"
      ],
      "properties": {
        "schema_version": {
          "const": "consent-catalog/design-v1"
        },
        "entry_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "purpose": {
          "enum": [
            "atendimento_solicitado",
            "cuidado_pastoral",
            "tarefas_operacionais",
            "comunicados"
          ]
        },
        "tenant_binding": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "package_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "package_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": {
          "enum": [
            "SYNTHETIC_FROZEN",
            "DRAFT_PENDING_EXTERNAL"
          ]
        },
        "synthetic_only": {
          "type": "boolean",
          "const": true
        },
        "controller_approved": {
          "type": "boolean",
          "const": false
        },
        "human_packet_complete": {
          "type": "boolean",
          "const": false
        },
        "catalog_ready": {
          "type": "boolean",
          "const": false
        },
        "writer_eligible": {
          "type": "boolean",
          "const": false
        },
        "operational_authorization": {
          "type": "boolean",
          "const": false
        },
        "next_stage_authorized": {
          "type": "boolean",
          "const": false
        },
        "source_payload": {
          "type": "object"
        },
        "decision_payload": {
          "type": "object"
        },
        "resolved_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_ref",
                  "state",
                  "bound_ref",
                  "content_sha256",
                  "content",
                  "pending_reason"
                ],
                "properties": {
                  "source_ref": {
                    "type": "string",
                    "pattern": "^ref:[a-z0-9][a-z0-9:-]*$"
                  },
                  "state": {
                    "const": "RESOLVED_SYNTHETIC"
                  },
                  "bound_ref": {
                    "type": "string",
                    "pattern": "^ref:catalog:sha256:[0-9a-f]{64}$"
                  },
                  "content_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "content": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "synthetic_only",
                      "kind",
                      "text"
                    ],
                    "properties": {
                      "synthetic_only": {
                        "type": "boolean",
                        "const": true
                      },
                      "kind": {
                        "const": "synthetic_governance_text"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "pending_reason": {
                    "type": "null"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_ref",
                  "state",
                  "bound_ref",
                  "content_sha256",
                  "content",
                  "pending_reason"
                ],
                "properties": {
                  "source_ref": {
                    "type": "string",
                    "pattern": "^ref:[a-z0-9][a-z0-9:-]*$"
                  },
                  "state": {
                    "const": "PENDING_EXTERNAL"
                  },
                  "bound_ref": {
                    "type": "null"
                  },
                  "content_sha256": {
                    "type": "null"
                  },
                  "content": {
                    "type": "null"
                  },
                  "pending_reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        },
        "content_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "entry_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "entry_id",
                "entry_digest",
                "content_digest"
              ],
              "properties": {
                "entry_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "entry_digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "content_digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ]
        }
      }
    },
    "frozen_payload_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "entry_id",
        "purpose",
        "tenant_binding",
        "package_id",
        "package_version",
        "status",
        "synthetic_only",
        "controller_approved",
        "human_packet_complete",
        "catalog_ready",
        "writer_eligible",
        "operational_authorization",
        "next_stage_authorized",
        "source_payload",
        "decision_payload",
        "resolved_refs",
        "content_digest",
        "entry_digest",
        "supersedes",
        "approval_custody_ref"
      ],
      "properties": {
        "schema_version": {
          "const": "consent-catalog/frozen-payload-v2"
        },
        "entry_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "purpose": {
          "enum": [
            "atendimento_solicitado",
            "cuidado_pastoral",
            "tarefas_operacionais",
            "comunicados"
          ]
        },
        "tenant_binding": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "package_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "package_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": {
          "enum": [
            "APPROVED_PAYLOAD_PENDING_EXTERNAL",
            "APPROVED_PAYLOAD_REFERENCES_BOUND"
          ]
        },
        "synthetic_only": {
          "type": "boolean",
          "const": false
        },
        "controller_approved": {
          "type": "boolean",
          "const": true
        },
        "human_packet_complete": {
          "type": "boolean",
          "const": false
        },
        "catalog_ready": {
          "type": "boolean",
          "const": false
        },
        "writer_eligible": {
          "type": "boolean",
          "const": false
        },
        "operational_authorization": {
          "type": "boolean",
          "const": false
        },
        "next_stage_authorized": {
          "type": "boolean",
          "const": false
        },
        "source_payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "custody_ref",
            "content_digest"
          ],
          "properties": {
            "custody_ref": {
              "type": "string",
              "pattern": "^ref:sha256:[0-9a-f]{64}$"
            },
            "content_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "decision_payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "custody_ref",
            "content_digest"
          ],
          "properties": {
            "custody_ref": {
              "type": "string",
              "pattern": "^ref:sha256:[0-9a-f]{64}$"
            },
            "content_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "resolved_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_ref",
                  "state",
                  "bound_ref",
                  "content_sha256",
                  "content",
                  "pending_reason"
                ],
                "properties": {
                  "source_ref": {
                    "type": "string",
                    "pattern": "^ref:[a-z0-9][a-z0-9:-]*$"
                  },
                  "state": {
                    "const": "PENDING_EXTERNAL"
                  },
                  "bound_ref": {
                    "type": "null"
                  },
                  "content_sha256": {
                    "type": "null"
                  },
                  "content": {
                    "type": "null"
                  },
                  "pending_reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_ref",
                  "state",
                  "content_ref",
                  "content_sha256",
                  "pending_reason"
                ],
                "properties": {
                  "source_ref": {
                    "type": "string",
                    "pattern": "^ref:[a-z0-9][a-z0-9:-]*$"
                  },
                  "state": {
                    "const": "RESOLVED_FROZEN"
                  },
                  "content_ref": {
                    "type": "string",
                    "pattern": "^ref:sha256:[0-9a-f]{64}$"
                  },
                  "content_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "pending_reason": {
                    "type": "null"
                  }
                }
              }
            ]
          }
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "entry_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "entry_id",
                "entry_digest",
                "content_digest"
              ],
              "properties": {
                "entry_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "entry_digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "content_digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ]
        },
        "approval_custody_ref": {
          "type": "string",
          "pattern": "^ref:sha256:[0-9a-f]{64}$"
        }
      }
    },
    "evidence_succession_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "entry_id",
        "purpose",
        "tenant_binding",
        "package_id",
        "package_version",
        "status",
        "synthetic_only",
        "controller_approved",
        "human_packet_complete",
        "catalog_ready",
        "writer_eligible",
        "operational_authorization",
        "next_stage_authorized",
        "source_payload",
        "decision_payload",
        "resolved_refs",
        "content_digest",
        "entry_digest",
        "supersedes",
        "approval_custody_ref",
        "catalog_revision",
        "evidence_only_refs",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": "consent-catalog/evidence-succession-v1"
        },
        "entry_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "purpose": {
          "enum": [
            "atendimento_solicitado",
            "cuidado_pastoral",
            "tarefas_operacionais",
            "comunicados"
          ]
        },
        "tenant_binding": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "package_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "package_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": {
          "const": "APPROVED_PAYLOAD_REFERENCES_BOUND"
        },
        "synthetic_only": {
          "type": "boolean",
          "const": false
        },
        "controller_approved": {
          "type": "boolean",
          "const": true
        },
        "human_packet_complete": {
          "type": "boolean",
          "const": false
        },
        "catalog_ready": {
          "type": "boolean",
          "const": false
        },
        "writer_eligible": {
          "type": "boolean",
          "const": false
        },
        "operational_authorization": {
          "type": "boolean",
          "const": false
        },
        "next_stage_authorized": {
          "type": "boolean",
          "const": false
        },
        "source_payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "custody_ref",
            "content_digest"
          ],
          "properties": {
            "custody_ref": {
              "type": "string",
              "pattern": "^ref:sha256:[0-9a-f]{64}$"
            },
            "content_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "decision_payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "custody_ref",
            "content_digest"
          ],
          "properties": {
            "custody_ref": {
              "type": "string",
              "pattern": "^ref:sha256:[0-9a-f]{64}$"
            },
            "content_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "resolved_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_ref",
              "state",
              "content_ref",
              "content_sha256",
              "pending_reason"
            ],
            "properties": {
              "source_ref": {
                "type": "string",
                "pattern": "^ref:[a-z0-9][a-z0-9:-]*$"
              },
              "state": {
                "const": "RESOLVED_FROZEN"
              },
              "content_ref": {
                "type": "string",
                "pattern": "^ref:sha256:[0-9a-f]{64}$"
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "pending_reason": {
                "type": "null"
              }
            }
          }
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "entry_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "supersedes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entry_id",
            "entry_digest",
            "content_digest"
          ],
          "properties": {
            "entry_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "entry_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "content_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "approval_custody_ref": {
          "type": "string",
          "pattern": "^ref:sha256:[0-9a-f]{64}$"
        },
        "catalog_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "evidence_only_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^ref:[a-z0-9][a-z0-9:-]*$"
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 3,
          "items": {
            "enum": [
              "APPROVED_PAYLOAD_MINOR_REFS_UNCHANGED_NULL",
              "SUPPLEMENTAL_EVIDENCE_OUTSIDE_APPROVED_PAYLOAD",
              "NO_TECHNICAL_OR_OPERATIONAL_AUTHORITY"
            ]
          }
        }
      }
    }
  }
}
