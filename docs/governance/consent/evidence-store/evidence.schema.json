{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igreja12.local/schemas/consent-evidence-design-v1.json",
  "title": "Evidence store design: synthetic adult-only proof",
  "$comment": "Documentary synthetic profile only, no writer. Semantic catalog/challenge/context/time/integrity validation is mandatory in the documentary test. No network schema resolution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_state",
    "synthetic_only",
    "evidence_id",
    "tenant_ref",
    "controller_ref",
    "person_ref",
    "purpose",
    "package_id",
    "package_version",
    "content_digest",
    "catalog_entry_digest",
    "notice_version",
    "notice_text_digest",
    "language",
    "channel",
    "presentation",
    "challenge",
    "manifestation",
    "subject",
    "idempotency_key",
    "durable_receipt_ref",
    "previous_event_ref",
    "withdrawn_event_ref",
    "immutable_storage_ref",
    "integrity_algorithm",
    "evidence_digest",
    "receipt_delivery_state",
    "controller_approved",
    "catalog_ready",
    "writer_eligible",
    "operational_authorization",
    "next_stage_authorized"
  ],
  "properties": {
    "schema_version": {
      "const": "consent-evidence/design-v1"
    },
    "artifact_state": {
      "const": "SYNTHETIC_EXAMPLE_NOT_OPERATIONAL"
    },
    "synthetic_only": {
      "type": "boolean",
      "const": true
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "controller_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "person_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "purpose": {
      "enum": [
        "atendimento_solicitado",
        "cuidado_pastoral",
        "tarefas_operacionais",
        "comunicados"
      ]
    },
    "package_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "package_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "catalog_entry_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "notice_version": {
      "const": "synthetic-notice-v1"
    },
    "notice_text_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "language": {
      "const": "pt-BR"
    },
    "channel": {
      "enum": [
        "whatsapp",
        "painel_autenticado"
      ]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presented_at",
        "timezone",
        "renderer_version",
        "delivery_state",
        "correlation_id"
      ],
      "properties": {
        "presented_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "timezone": {
          "const": "UTC"
        },
        "renderer_version": {
          "const": "synthetic-renderer/v1"
        },
        "delivery_state": {
          "enum": [
            "PRESENTED",
            "DELIVERED",
            "UNKNOWN",
            "FAILED"
          ]
        },
        "correlation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_ref",
        "created_at",
        "expires_at",
        "single_use_state"
      ],
      "properties": {
        "challenge_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "expires_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "single_use_state": {
          "const": "CONSUMED"
        }
      }
    },
    "manifestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_action",
        "manifested_at",
        "actor_ref",
        "authentication_method_ref",
        "interaction_ref"
      ],
      "properties": {
        "selected_action": {
          "enum": [
            "ACCEPT",
            "REFUSE_INITIAL",
            "WITHDRAW"
          ]
        },
        "manifested_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "actor_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "authentication_method_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "interaction_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "age_band",
        "guardian_ref",
        "guardian_relation_evidence_ref",
        "minor_notice_version",
        "minor_view_state"
      ],
      "properties": {
        "age_band": {
          "const": "ADULT"
        },
        "guardian_ref": {
          "type": "null"
        },
        "guardian_relation_evidence_ref": {
          "type": "null"
        },
        "minor_notice_version": {
          "type": "null"
        },
        "minor_view_state": {
          "const": "NOT_APPLICABLE"
        }
      }
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "durable_receipt_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "previous_event_ref": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      ]
    },
    "withdrawn_event_ref": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      ]
    },
    "immutable_storage_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "integrity_algorithm": {
      "const": "sha256-jcs-subset-v1"
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "receipt_delivery_state": {
      "const": "NOT_SENT"
    },
    "controller_approved": {
      "type": "boolean",
      "const": false
    },
    "catalog_ready": {
      "type": "boolean",
      "const": false
    },
    "writer_eligible": {
      "type": "boolean",
      "const": false
    },
    "operational_authorization": {
      "type": "boolean",
      "const": false
    },
    "next_stage_authorized": {
      "type": "boolean",
      "const": false
    }
  }
}
