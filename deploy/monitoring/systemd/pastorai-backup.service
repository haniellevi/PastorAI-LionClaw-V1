[Unit]
Description=PastorAI verified production backup
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/opt/pastorai-current/deploy
ExecStart=/bin/bash /opt/pastorai-current/deploy/backup-production.sh
TimeoutStartSec=3h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/backups/pastorai
