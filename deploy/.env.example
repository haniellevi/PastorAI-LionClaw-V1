# Ambiente local seguro para validar o Compose.
# Nunca use este arquivo em producao e nunca adicione chaves reais ao Git.

APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:3000
ALLOW_REAL_SENDS=false
AGENDA_NOTIFY_ENABLED=false
CELULAS_REQUESTS_ENABLED=false
PURPOSE_CONSENT_GOVERNANCE_DRAFTS_ENABLED=false
BROADCAST_ASYNC_ENABLED=false

# Auth e banco: preencha somente em deploy local controlado.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=
CLERK_JWKS_URL=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SECRETS_ENCRYPTION_KEY=
SESSION_JWT_SECRET=

# O Compose sobrescreve estes hosts com a rede interna dos containers.
REDIS_URL=redis://redis:6379/0
EVOLUTION_SERVER_URL=http://127.0.0.1:8080
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=
EVOLUTION_POSTGRES_PASSWORD=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_WEBHOOK_CALLBACK_URL=http://127.0.0.1:8000/whatsapp/webhook

# Integracoes externas ficam sem credenciais e apontam para ambientes seguros.
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_BILLING_ENABLED=false
BREVO_API_URL=https://api.brevo.com/v3
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@igreja12.com.br
BREVO_FROM_NAME="Igreja 12"
BREVO_SEND_MODE=off
BREVO_CANARY_RECIPIENTS=
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/calendar/callback
