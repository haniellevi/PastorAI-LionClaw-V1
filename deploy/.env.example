# ============================================================================
# PastorAI — variáveis da stack de produção (VPS)
# Copie para `deploy/.env` (gitignored) e preencha. NUNCA commite o .env real.
# Este mesmo arquivo serve para: (1) substituição no docker-compose
# (${...}) e (2) variáveis injetadas no backend/workers (env_file).
# ============================================================================

# ===== Evolution API (WhatsApp) =====
# Chave de acesso da Evolution (gere uma forte, ex.: openssl rand -hex 16)
EVOLUTION_API_KEY=<<gere: openssl rand -hex 16>>
# Senha do Postgres interno da Evolution (gere uma forte)
EVOLUTION_POSTGRES_PASSWORD=<<gere: openssl rand -hex 16>>
# URL pública da Evolution. 1º teste: http://<IP_DA_VPS>:8080
EVOLUTION_SERVER_URL=http://2.25.167.107:8080

# ===== App / Backend =====
# Em produção o backend EXIGE todos os secrets abaixo (assert_production_ready).
# Para o 1º teste você pode usar APP_ENV=development p/ relaxar essa exigência.
APP_ENV=production
APP_BASE_URL=http://2.25.167.107:8000
# URL do frontend na Vercel (entra no CORS). Ajuste após o deploy do front.
FRONTEND_URL=https://pastorai.vercel.app

# ===== Clerk (auth) =====
CLERK_PUBLISHABLE_KEY=pk_test_bGVuaWVudC1iYXQtNTkuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=<<sk_... do Clerk Dashboard>>
CLERK_JWT_ISSUER=https://lenient-bat-59.clerk.accounts.dev
CLERK_JWKS_URL=

# ===== Supabase (banco do app — externo) =====
SUPABASE_URL=https://pffafnchtxbimpwyaczq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<<service_role key — Project Settings > API>>
# Session pooler (IPv4). Percent-encode os símbolos da senha.
DATABASE_URL=postgresql://postgres.pffafnchtxbimpwyaczq:<<SENHA%enc>>@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# ===== Criptografia de segredos (BYO-LLM) — gere uma Fernet =====
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=<<chave Fernet>>

# ===== Evolution ↔ backend (em rede interna do compose) =====
EVOLUTION_API_URL=http://evolution-api:8080
# Segredo p/ validar a assinatura dos webhooks da Evolution
EVOLUTION_WEBHOOK_SECRET=<<gere: openssl rand -hex 16>>

# ===== Worker / filas =====
REDIS_URL=redis://redis:6379/0

# ===== Agente / LLM (BYO por igreja; default opcional) =====
OPENAI_API_KEY=
AGENT_GRAPH_CHECKPOINT_URL=
AGENT_DEFAULT_MODEL=gpt-4o-mini
AGENT_TERM_VERSION=v1
CRON_TICK_SECONDS=300
ASSISTANT_DEFAULT_MODEL=gpt-4o-mini

# ===== Integrações opcionais (deixe vazio p/ o MVP) =====
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_SETUP_FEE=1000
RESEND_API_URL=https://api.resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@pastorai.com.br
GOOGLE_CALENDAR_API_URL=https://www.googleapis.com/calendar/v3
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
