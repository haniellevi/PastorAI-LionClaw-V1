# ============================================================================
# PastorAI — ambiente LOCAL de desenvolvimento (./dev.sh)
# ----------------------------------------------------------------------------
# O dev.sh copia este modelo para .env.dev na raiz do checkout principal (vale
# para todos os worktrees) e gera os segredos locais na primeira execução.
# O .env.dev é ignorado pelo Git. Nunca coloque aqui chave de produção.
# ============================================================================

APP_ENV=development
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3012
CALENDAR_OAUTH_RETURN_ORIGINS=http://localhost:3012

# Portas locais, todas em 127.0.0.1 (a 3000 costuma estar ocupada).
DEV_BACKEND_PORT=8000
DEV_FRONTEND_PORT=3012
DEV_REDIS_PORT=6380
DEV_EVOLUTION_PORT=8080

# ---- Clerk: instância de DESENVOLVIMENTO (pk_test_/sk_test_) ----------------
# Sem CLERK_SECRET_KEY o painel abre, mas o login não funciona.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=
CLERK_JWKS_URL=

# ---- Contas de teste que o seed liga à igreja local --------------------------
# E-mails de contas que já existem no Clerk de desenvolvimento (nunca a senha).
# Depois de preencher, rode ./dev.sh seed. Vazio = papel sem login.
DEV_SEED_EMAIL_PASTOR=
DEV_SEED_EMAIL_ADMIN=
DEV_SEED_EMAIL_LIDER=
DEV_SEED_EMAIL_CONSOLIDACAO=
DEV_SEED_EMAIL_MEMBRO=
DEV_SEED_EMAIL_PLATAFORMA=

# ---- Segredos locais: o dev.sh gera na primeira execução --------------------
SECRETS_ENCRYPTION_KEY=
SESSION_JWT_SECRET=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=

# ---- Travas de envio ---------------------------------------------------------
# Fechadas por padrão. ALLOW_REAL_SENDS também libera o LLM; abra só com o
# WhatsApp local apontando para o simulador ou para o chip de teste.
ALLOW_REAL_SENDS=false
WHATSAPP_PILOTO_IGREJA_IDS=00000000-0000-0000-0000-000000000001
WHATSAPP_SLA_ENABLED=false
AGENDA_NOTIFY_ENABLED=false
BROADCAST_ASYNC_ENABLED=false
CELULAS_REQUESTS_ENABLED=false
PURPOSE_CONSENT_GOVERNANCE_DRAFTS_ENABLED=false

# ---- Serviços externos: desligados no local ---------------------------------
OPENAI_API_KEY=
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_BILLING_ENABLED=false
BREVO_API_KEY=
BREVO_SEND_MODE=off
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/calendar/callback
JEV_SHADOW_TRIAGE_IGREJA_IDS=
TYPESAFE_API_KEY=
