# Runtime build context is an explicit allowlist. Administrative scripts,
# credentials, test data, virtualenvs and backups never reach the builder.
**
!app/
!app/**
!migrations/
!migrations/**
!requirements.lock
!scripts/
!scripts/migrate.py
!scripts/dev_online.py
!scripts/dev_local.py
!devtools/
!devtools/**
!Dockerfile
!.dockerignore

# Defense in depth for nested runtime paths.
**/.env
**/.env.*
**/*.pem
**/*.key
**/id_rsa*
**/id_ed25519*
**/secrets/
**/__pycache__/
**/*.pyc
