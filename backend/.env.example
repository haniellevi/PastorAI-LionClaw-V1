# PastorAI backend — example environment (SPEC 5.3)
# Copy to .env and fill real values. NEVER commit real secrets.

# App
# APP_BASE_URL e FRONTEND_URL definem as ORIGENS de CORS. Em PRODUCAO precisam
# ser URLs https explicitas (nunca localhost) — o boot FALHA RAPIDO caso
# contrario (MEDIO-001). O host app.<dominio> libera automaticamente
# admin.<dominio> e painel.<dominio> (mesma app na Vercel): as 3 superficies
# ficam cobertas por FRONTEND_URL=https://app.<dominio>.
# Producao (exemplo):
#   APP_BASE_URL=https://api.igreja12.com.br
#   FRONTEND_URL=https://app.igreja12.com.br   # cobre app/admin/painel.igreja12.com.br
APP_ENV=development
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Guard de envios externos (B2): efeitos REAIS (WhatsApp, cobranca, e-mail,
# LLM, agenda) ficam DESLIGADOS por padrao em TODOS os ambientes, inclusive
# producao. Ligue (=true) somente depois dos smokes de login/saude e da
# validacao das credenciais/canais.
ALLOW_REAL_SENDS=false
PURPOSE_CONSENT_GOVERNANCE_DRAFTS_ENABLED=false

# Agenda: aviso de confirmacao (EVT-7 PR1). Liga o aviso sincrono a equipe interna
# quando um evento e confirmado (POST /events/{id}/confirm). Default OFF, inclusive
# em producao, ate ligar aqui. Ortogonal ao guard B2: mesmo ligado, o envio real so
# sai se ALLOW_REAL_SENDS=true.
AGENDA_NOTIFY_ENABLED=false

# Clerk (Auth - US-01 / RNF-01)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=
# Optional: explicit JWKS endpoint (derived from issuer when empty)
CLERK_JWKS_URL=

# Sessao do painel (JWT emitido pelo backend)
# SESSION_JWT_SECRET assina o JWT de sessao do painel. OBRIGATORIO em producao:
# dedicado, forte (>=32 bytes aleatorios) e DIFERENTE de CLERK_SECRET_KEY
# (BAIXO-001). Fora de producao pode ficar vazio — cai em CLERK_SECRET_KEY apenas
# para dev/test bootarem sem env extra. Gere um valor com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_JWT_SECRET=
# TTL da sessao do painel (horas) e do link de redefinicao de senha (minutos).
SESSION_TTL_HOURS=8
PASSWORD_RESET_TTL_MINUTES=30

# Supabase (Postgres + RLS - US-02 / RNF-02)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Criptografia de segredos (RNF-03)
SECRETS_ENCRYPTION_KEY=

# Evolution API (WhatsApp - US-05..US-08)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=

# Worker / Filas (RNF-17)
REDIS_URL=redis://localhost:6379/0

# Broadcast persistente (BROADCAST-DELIVERY-1)
# Mantenha false no primeiro deploy. Para ativar: migration aplicada, backend e
# worker no MESMO valor true, worker saudavel e canario controlado. A flag e
# lida no boot; recrie os containers depois de altera-la.
BROADCAST_ASYNC_ENABLED=false
BROADCAST_WORKER_TICK_SECONDS=10
BROADCAST_MAX_BROADCASTS_POR_CICLO=20
BROADCAST_MAX_ENTREGAS_POR_CICLO=200
BROADCAST_MAX_TENTATIVAS=3
BROADCAST_CLAIM_SECONDS=60
BROADCAST_ENTREGA_LEASE_SECONDS=120
BROADCAST_SEND_INTERVAL_MS=1000

# Rate limiting nos endpoints de autenticacao (ALTO-002)
# Kill switch de emergencia: desliga TODO o rate limiting de auth sem
# precisar reverter deploy (ex.: se o Redis estiver instavel e o fail-open
# nao bastar). Contadores de janela fixa reusam o REDIS_URL acima.
RATE_LIMIT_AUTH_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
# Bloqueio temporario da CONTA (nao do IP) ao estourar o limite.
RATE_LIMIT_BLOCK_SECONDS=300
RATE_LIMIT_LOGIN_IP_LIMIT=10
RATE_LIMIT_LOGIN_ACCOUNT_LIMIT=5
RATE_LIMIT_FORGOT_PASSWORD_IP_LIMIT=5
RATE_LIMIT_FORGOT_PASSWORD_ACCOUNT_LIMIT=3
RATE_LIMIT_RESET_PASSWORD_IP_LIMIT=10
RATE_LIMIT_ACTIVATE_IP_LIMIT=10
RATE_LIMIT_CHANGE_PASSWORD_IP_LIMIT=10
RATE_LIMIT_CHANGE_PASSWORD_ACCOUNT_LIMIT=5

# Agente Orquestrador / LLM BYO (US-08/US-27 - delta-034)
# Chave default opcional; cada igreja usa a propria cifrada no banco (RNF-03/20)
OPENAI_API_KEY=
# Conexao exclusiva da role agent_runtime. Permanece vazia enquanto a fundacao
# D2A estiver inativa; nunca reutilize DATABASE_URL, postgres ou service_role.
AGENT_RUNTIME_DATABASE_URL=
# Reservado ao checkpointer duravel futuro. Vazio ou preenchido nao ativa
# persistencia na baseline atual, que continua stateless.
AGENT_GRAPH_CHECKPOINT_URL=
# Modelo default do orquestrador quando a igreja nao sobrescreve
AGENT_DEFAULT_MODEL=gpt-5.6-luna
# Versao atual do termo LGPD; alterar forca re-aceite (delta-040)
AGENT_TERM_VERSION=v1

# SLA engine + cron worker (O5)
# Intervalo (segundos) entre ciclos do cron_worker (varredura SLA + crons)
CRON_TICK_SECONDS=300
# Modelo default do assistente do painel (api-assistant); reusa a credencial BYO
ASSISTANT_DEFAULT_MODEL=gpt-5.6-luna

# Asaas (assinatura/billing - US-36/RF-42)
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
# Token compartilhado para validar webhooks Asaas (header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=
# Escrita financeira exige ALLOW_REAL_SENDS=true E este opt-in. Default seguro.
ASAAS_BILLING_ENABLED=false
# Taxa de setup cobrada no primeiro checkout (BRL)
ASAAS_SETUP_FEE=0

# Brevo / ex-Sendinblue (convites e recuperação de senha)
# Gate independente de ALLOW_REAL_SENDS: `off` não envia, `canary` só envia
# para os e-mails CSV abaixo, e `live` é uma promoção operacional separada.
# Chave em https://app.brevo.com/settings/keys/api ; remetente precisa de
# domínio/sender verificado em https://app.brevo.com/senders.
BREVO_API_URL=https://api.brevo.com/v3
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@igreja12.com.br
BREVO_FROM_NAME=Igreja 12
BREVO_SEND_MODE=off
BREVO_CANARY_RECIPIENTS=

# Google Calendar (sync de eventos - RF-39)
GOOGLE_CALENDAR_API_URL=https://www.googleapis.com/calendar/v3
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Google OAuth 2.0 - conectar a agenda de cada igreja (eventos F1).
# Sem estas tres, POST /calendar/connect responde 503 e nenhum fluxo comeca
# (kill switch operacional; assert_production_ready NAO as exige).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Endpoint OIDC que diz QUAL conta Google consentiu. O finish compara o e-mail
# verificado aqui com o que o admin declarou antes do redirect; sem isso,
# "conectado" significaria apenas "alguem autorizou alguma conta". O default do
# codigo ja e este valor - so preencha para apontar para outro host.
GOOGLE_OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# OAUTH-CALENDAR-V1 - origens que hospedam o card "Conectar Google Agenda"
# (tela de Integracoes). Conceito SEPARADO de CORS: esta lista e' a UNICA fonte
# do destino do redirect do callback, validada por igualdade EXATA.
# CSV. Espacos em volta e barra final sao ignorados.
# NUNCA incluir api.* (nao e' UI) nem painel.* (console master).
# Producao: CALENDAR_OAUTH_RETURN_ORIGINS=https://admin.igreja12.com.br
# Em producao a lista NAO pode ficar vazia (assert_production_ready falha o boot).
CALENDAR_OAUTH_RETURN_ORIGINS=http://localhost:3000
# TTL de um fluxo OAuth em voo, em minutos.
CALENDAR_OAUTH_FLOW_TTL_MINUTES=10

# Testes de integracao RLS (opt-in - D5 / PR1)
# Liga a suite `pytest -m rls_integration` que prova o isolamento por tenant
# contra um Postgres REAL. DEVE apontar para um Postgres DESCARTAVEL/efemero
# (ex.: servico do CI ou container local), NUNCA para DEV/PROD do Supabase — um
# guard obrigatorio ABORTA a suite (fail, nao skip) se a URL parecer DEV/PROD.
# Ausente (vazio) => a suite da SKIP LIMPO, sem falhar (dev/CI offline seguem
# verdes). Exemplo: postgresql+psycopg2://postgres:postgres@localhost:5432/rls_disposable
RLS_TEST_DATABASE_URL=
