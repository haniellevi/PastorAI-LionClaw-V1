# PastorAI — modelo único de configuração
#
# As atribuições têm defaults seguros e nenhum segredo real. Copie somente as
# seções necessárias para o arquivo local de destino e preencha credenciais por
# um canal seguro. Os endereços de produção usam example.invalid como marcador.
# dev.sh parte deste arquivo e troca, no .env.dev, apenas os valores locais.
#
# Capacidades novas de WhatsApp permanecem inertes: *_APPROVED_RELEASE_ID=None
# no código e allowlists por igreja vazias. AgentConfig.ativo é estado por igreja
# no banco e não é alterado por este arquivo.

# ============================================================================
# Comum/servidor
# Backend FastAPI, workers, autenticação, integrações e segurança.
# ============================================================================

# Trava global de efeitos externos. Mantenha desligada até release e autorização.
ALLOW_REAL_SENDS=false

# Consentimento: libera somente a preparação de rascunhos por igreja; não
# autoriza aprovação humana, catálogo, writer, agente ou efeito externo.
PURPOSE_CONSENT_GOVERNANCE_DRAFTS_ENABLED=false
# Agenda EVT-7 PR1: aviso síncrono à equipe interna após confirmar um evento.
# Continua sujeito ao gate global de envios reais.
AGENDA_NOTIFY_ENABLED=false
# Escritas de solicitações/células. Default OFF; leituras de célula não dependem
# deste gate e a ativação requer validação ponta a ponta.
CELULAS_REQUESTS_ENABLED=false

# Clerk (autenticação do painel, validada pelo backend).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=
# Opcional: JWKS explícito; vazio deriva a URL do issuer.
CLERK_JWKS_URL=

# Sessão do painel emitida pelo backend. Em produção, use chave dedicada,
# forte (>=32 bytes aleatórios) e diferente de CLERK_SECRET_KEY. Fora de
# produção pode ficar vazia, pois o backend recorre à chave Clerk.
SESSION_JWT_SECRET=
SESSION_TTL_HOURS=8
# Validade do link de redefinição de senha.
PASSWORD_RESET_TTL_MINUTES=30
# Gere SESSION_JWT_SECRET com: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Banco e RLS por igreja_id. Credenciais ficam vazias no modelo.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Ping SELECT 1 para conexões do pool paradas por pelo menos N segundos; 0 testa
# toda conexão. Conexões usadas recentemente evitam essa ida extra ao banco.
DB_POOL_PING_IDLE_SECONDS=60

# Criptografia de credenciais armazenadas pelo backend. dev.sh gera uma chave
# local na primeira criação do .env.dev.
SECRETS_ENCRYPTION_KEY=

# Evolution API e webhook recebido pelo backend. A chave autentica a Evolution;
# o segredo valida o callback de entrada.
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=

# Broadcast persistente. Deixe false no primeiro deploy; backend e worker leem
# esta flag no boot e precisam ser recriados juntos após uma ativação aprovada.
BROADCAST_ASYNC_ENABLED=false
BROADCAST_WORKER_TICK_SECONDS=10
BROADCAST_MAX_BROADCASTS_POR_CICLO=20
BROADCAST_MAX_ENTREGAS_POR_CICLO=200
BROADCAST_MAX_TENTATIVAS=3
BROADCAST_CLAIM_SECONDS=60
BROADCAST_ENTREGA_LEASE_SECONDS=120
BROADCAST_SEND_INTERVAL_MS=1000

# Rate limit dos endpoints de autenticação; contadores usam REDIS_URL.
# RATE_LIMIT_AUTH_ENABLED é o kill switch global do rate limit de auth.
RATE_LIMIT_AUTH_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
# Bloqueio temporário da conta, não do IP.
RATE_LIMIT_BLOCK_SECONDS=300
RATE_LIMIT_LOGIN_IP_LIMIT=10
RATE_LIMIT_LOGIN_ACCOUNT_LIMIT=5
RATE_LIMIT_FORGOT_PASSWORD_IP_LIMIT=5
RATE_LIMIT_FORGOT_PASSWORD_ACCOUNT_LIMIT=3
RATE_LIMIT_RESET_PASSWORD_IP_LIMIT=10
RATE_LIMIT_ACTIVATE_IP_LIMIT=10
RATE_LIMIT_CHANGE_PASSWORD_IP_LIMIT=10
RATE_LIMIT_CHANGE_PASSWORD_ACCOUNT_LIMIT=5

# Agente e assistente do painel. A chave default é opcional; cada igreja pode
# usar sua credencial BYO cifrada no banco.
OPENAI_API_KEY=
# Credencial dedicada de menor privilégio para runtime do agente. Até provisionar
# o gate D2A, mantenha vazia; o runtime falha fechado e não usa DATABASE_URL.
AGENT_RUNTIME_DATABASE_URL=
# Reservado para checkpoint durável futuro; preencher não ativa persistência.
AGENT_GRAPH_CHECKPOINT_URL=
# Modelo padrão do orquestrador quando a igreja não sobrescreve.
AGENT_DEFAULT_MODEL=gpt-5.6-luna
# Versão do termo LGPD; alterar exige novo aceite.
AGENT_TERM_VERSION=v1
# Modelo padrão do assistente da API do painel.
ASSISTANT_DEFAULT_MODEL=gpt-5.6-luna

# Allowlist de igrejas com resposta automática e avisos WhatsApp. Vazia = nenhuma.
# Envio real ainda exige ALLOW_REAL_SENDS=true; envio manual pelo painel não usa
# esta lista. AgentConfig.ativo e os gates de finalidade continuam separados.
WHATSAPP_PILOTO_IGREJA_IDS=
# SLA WhatsApp: ao ativar, a fila acumulada pode sair de uma vez; limpe-a antes.
WHATSAPP_SLA_ENABLED=false

# Jev/TypeSafe em modo sombra. Exige DPA antes de listar qualquer igreja; a
# mensagem pastoral é enviada em claro ao terceiro. Vazio e sem chave = desligado.
# A URL deve ser HTTPS; o modo sombra também depende de ALLOW_REAL_SENDS=true.
JEV_SHADOW_TRIAGE_IGREJA_IDS=
TYPESAFE_API_KEY=
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_SECONDS=2.0

# Ciclo do motor de SLA e crons; o assistente usa a credencial BYO da igreja.
CRON_TICK_SECONDS=300

# Asaas (assinatura e cobrança). O padrão aponta à API de produção; para dev,
# dev.sh troca por Sandbox. Escritas exigem ALLOW_REAL_SENDS=true e este opt-in;
# mantenha ambos desligados no modelo.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_BILLING_ENABLED=false
# Taxa de setup em BRL; 0 não cobra valor de setup.
ASAAS_SETUP_FEE=0

# Brevo (convites e recuperação de senha). Gate independente: off não envia,
# canary limita aos destinatários abaixo, live exige promoção operacional.
# O remetente real precisa de domínio verificado. A chave fica em
# https://app.brevo.com/settings/keys/api.
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@example.invalid
BREVO_FROM_NAME="Igreja 12"
BREVO_SEND_MODE=off
BREVO_CANARY_RECIPIENTS=

# Google Calendar e OAuth por igreja. O token de acesso legado pode ficar vazio;
# o fluxo novo obtém OAuth por igreja.
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# O endpoint confirma qual conta consentiu; o backend compara o e-mail
# verificado. Troque-o apenas para apontar a outro host oficial.
GOOGLE_OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
# Validade, em minutos, de um fluxo OAuth iniciado.
CALENDAR_OAUTH_FLOW_TTL_MINUTES=10

# Testes RLS opt-in contra PostgreSQL descartável. Vazio mantém a suite fora;
# nunca configure DEV/PROD do Supabase. A suite falha, sem skip, se a URL não
# comprovar uma instância descartável.
RLS_TEST_DATABASE_URL=

# ============================================================================
# Produção/deploy
# Defaults de produção para backend, workers e Compose da VPS.
# Para desenvolvimento, dev.sh aplica os endereços locais documentados abaixo.
# ============================================================================

# Em produção, o boot exige URLs https explícitas, sem localhost. O host app
# libera também admin e painel como superfícies do mesmo frontend.
APP_ENV=production
APP_BASE_URL=https://api.example.invalid
FRONTEND_URL=https://app.example.invalid

# Supabase/Postgres externo. DATABASE_URL e chaves são preenchidas no arquivo
# privado de destino, nunca neste modelo.
SUPABASE_URL=https://projeto.example.invalid

# Valores internos da rede do Compose de produção.
REDIS_URL=redis://redis:6379/0
EVOLUTION_SERVER_URL=https://evolution.example.invalid
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_WEBHOOK_CALLBACK_URL=http://backend:8000/whatsapp/webhook
# Banco interno exclusivo da Evolution; defina senha forte no arquivo privado.
EVOLUTION_POSTGRES_PASSWORD=

# Endpoints públicos de integração usados pelo backend/Compose. O deploy de
# desenvolvimento substitui Asaas pela Sandbox; gates e credenciais seguem
# desligados/vazios.
ASAAS_API_URL=https://api.asaas.com/v3
BREVO_API_URL=https://api.brevo.com/v3
GOOGLE_CALENDAR_API_URL=https://www.googleapis.com/calendar/v3
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.invalid/calendar/callback

# Origens que hospedam o card Conectar Google Agenda. Lista CSV, comparação
# exata, espaços e barra final ignorados, sem api.* nem painel.*. Em produção
# não pode ficar vazia; troque example.invalid pelo domínio aprovado do frontend.
CALENDAR_OAUTH_RETURN_ORIGINS=https://admin.example.invalid

# ============================================================================
# Ambiente de teste Docker
# Valores consumidos por ./dev.sh e deploy/docker-compose.dev.yml.
# O script substitui os defaults de produção acima somente ao criar .env.dev.
# ============================================================================

# Portas locais; serviços ficam presos a loopback. A porta 3000 costuma estar
# ocupada, por isso o frontend local usa 3012.
DEV_BACKEND_PORT=8000
DEV_FRONTEND_PORT=3012
DEV_REDIS_PORT=6380
DEV_EVOLUTION_PORT=8080
DEV_SIMULADOR_PORT=8090

# Clerk deve ser uma instância de desenvolvimento (pk_test_/sk_test_). As
# senhas nunca entram no arquivo; seed usa somente os e-mails de contas de teste.
DEV_SEED_EMAIL_PASTOR=
DEV_SEED_EMAIL_ADMIN=
DEV_SEED_EMAIL_LIDER=
DEV_SEED_EMAIL_CONSOLIDACAO=
DEV_SEED_EMAIL_MEMBRO=
DEV_SEED_EMAIL_PLATAFORMA=

# O simulador é o transporte local padrão. WhatsApp, LLM, agenda, Asaas e Brevo
# ficam desligados no .env.dev gerado. Para testes de envio simulados, use só
# dados sintéticos e mantenha os gates globais fechados.
DEV_WHATSAPP_TRANSPORTE=simulado
DEV_BREVO_SEND_MODE=off
DEV_ASAAS_BILLING_ENABLED=false

# ============================================================================
# Tela/frontend NEXT_PUBLIC_*
# Next.js expõe estes valores no bundle; não coloque segredos nesta seção.
# ============================================================================

# Backend FastAPI consumido por api-login e /auth/me. dev.sh substitui para
# localhost:8000. Sem a publishable key, o frontend usa login backend-only.
NEXT_PUBLIC_API_URL=https://api.example.invalid
# Chave publicável do Clerk, não é segredo, mas deve pertencer ao ambiente certo.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
